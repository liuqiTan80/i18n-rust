//! 纯函数样例：判色 / 拆分词表 / 播报解析
//!
//! 三个函数都是「输入 → 输出」的纯函数：不读文件、不联网、不读环境变量、
//! 不使用全局状态。配套的方言测试写在 `tests-zh/纯函数.zh`（`#[测试]`），
//! 由 `build.zh` 转译后随 `cargo test` 自动执行。

/// 词形冻结：引擎 `转译输出` 的公开字段 `输出` 必须保持中文。
///
/// `build.zh` 跨包读取该字段；转译器按「同目录声明冻结」规则，
/// 需要本包也出现一次同名声明，否则会把 `输出` 按标准库词形译成英文。
#[派生(调试)]
公开 结构体 转译输出契约 {
    公开 输出: 字符串,
}

/// 可判定的颜色
#[派生(调试, 克隆, 复制, 部分相等特征, 全等)]
公开 枚举 颜色 {
    红,
    绿,
    蓝,
    黄,
}

/// 判色失败原因
#[派生(调试, 克隆, 复制, 部分相等特征, 全等)]
公开 枚举 判色故障 {
    /// 输入为空或仅含空白
    空输入,
    /// 不在可判定范围内的颜色名
    未知颜色,
}

/// 判色：颜色名（中/英，大小写不敏感，忽略前后空白）→ 颜色
公开 函数 判色(颜色名: &文本) -> 结果<颜色, 判色故障> {
    让 颜色名 = 颜色名.裁剪();
    如果 颜色名.为空() {
        返回 错误(判色故障::空输入);
    }
    让 判定值 = 匹配 颜色名.转小写().作为字符串() {
        "红" | "red" => 颜色::红,
        "绿" | "green" => 颜色::绿,
        "蓝" | "blue" => 颜色::蓝,
        "黄" | "yellow" => 颜色::黄,
        _ => 返回 错误(判色故障::未知颜色),
    };
    成功(判定值)
}

/// 拆分词表：按中英文逗号/顿号/分号/竖线/空白切分，丢弃空项
///
/// 空项一律丢弃（连续分隔符、首尾分隔符都不会产生空词条），
/// 因此空串与纯分隔符输入返回空表而不是报错。
公开 函数 拆分词表(词表文本: &文本) -> 向量<字符串> {
    让 可变 词条们 = 向量::新建();
    对于 片段值 在 词表文本.分割(|单个字符: 字符| {
        匹配 单个字符 {
            ',' | '，' | '、' | ';' | '；' | '|' | '\t' | '\n' | '\r' => 真,
            _ => 单个字符.是否为空白(),
        }
    }) {
        让 词条 = 片段值.裁剪();
        如果 !词条.为空() {
            词条们.推入(词条.转字符串());
        }
    }
    词条们
}

/// 播报级别
///
/// 变体名刻意避开 `信息`/`警告`：词库中它们已被日志库映射为日志级别，
/// 用作标识符会在转译时被改写。
#[派生(调试, 克隆, 复制, 部分相等特征, 全等)]
公开 枚举 播报级别 {
    提示,
    警示,
    故障,
}

/// 一条播报（级别 + 内容）
#[派生(调试, 克隆, 部分相等特征, 全等)]
公开 结构体 播报 {
    公开 级别: 播报级别,
    公开 内容: 字符串,
}

/// 播报解析失败原因
#[派生(调试, 克隆, 复制, 部分相等特征, 全等)]
公开 枚举 播报故障 {
    /// 输入为空或仅含空白
    空输入,
    /// 缺少 `级别|内容` 的竖线分隔符
    缺少分隔符,
    /// 级别不是 信息/警告/故障（或 info/warn/error）
    未知级别,
    /// 竖线之后的内容为空
    内容为空,
}

/// 播报解析：`级别|内容` → 播报
///
/// 只按**首个**竖线切分，内容中的竖线原样保留；级别与内容都忽略前后空白。
公开 函数 播报解析(播报文本: &文本) -> 结果<播报, 播报故障> {
    让 播报文本 = 播报文本.裁剪();
    如果 播报文本.为空() {
        返回 错误(播报故障::空输入);
    }
    让 有值((级别值, 内容值)) = 播报文本.分割一次('|') 否则 {
        返回 错误(播报故障::缺少分隔符);
    };
    // 入参接受最自然的 信息/警告 写法，也接受与变体同名的 提示/警示；
    // 变体名避开 信息/警告，是为了不被词库改写（见枚举定义处的注释）
    让 级别值 = 匹配 级别值.裁剪().转小写().作为字符串() {
        "信息" | "提示" | "info" => 播报级别::提示,
        "警告" | "警示" | "warn" | "warning" => 播报级别::警示,
        "故障" | "error" => 播报级别::故障,
        _ => 返回 错误(播报故障::未知级别),
    };
    让 内容值 = 内容值.裁剪();
    如果 内容值.为空() {
        返回 错误(播报故障::内容为空);
    }
    成功(播报 {
        级别: 级别值,
        内容: 内容值.转字符串(),
    })
}
