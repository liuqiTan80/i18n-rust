// 纯函数方言测试（项目方言写法）
//
// 覆盖 `判色` / `拆分词表` / `播报解析` 三类无 IO 纯函数：
// 每个函数都包含正常场景、边界场景、错误或异常输入场景。
//
// 用例只用字面量作输入，不读文件、不联网、不读环境变量、不依赖全局状态。
// `#[测试]` 由 `build.rs` 转译为 `#[test]`，`cargo test` 自动发现并执行。

使用 zh_pure::*;

// ============================================================
// 判色：颜色名 → 颜色
// ============================================================

#[测试]
函数 判色_正常_中文颜色名() {
    断言相等!(判色("红"), 成功(颜色::红));
    断言相等!(判色("绿"), 成功(颜色::绿));
    断言相等!(判色("蓝"), 成功(颜色::蓝));
    断言相等!(判色("黄"), 成功(颜色::黄));
}

#[测试]
函数 判色_正常_英文名大小写不敏感() {
    断言相等!(判色("RED"), 成功(颜色::红));
    断言相等!(判色("Green"), 成功(颜色::绿));
    断言相等!(判色("bLuE"), 成功(颜色::蓝));
    断言相等!(判色("yellow"), 成功(颜色::黄));
}

#[测试]
函数 判色_边界_前后空白被忽略() {
    断言相等!(判色("  红  "), 成功(颜色::红));
    断言相等!(判色("\t绿\n"), 成功(颜色::绿));
    // 中文与英文混排的空白同样被裁剪
    断言相等!(判色(" \u{3000}蓝\u{3000} "), 成功(颜色::蓝));
}

#[测试]
函数 判色_异常_空白输入与未知颜色() {
    断言相等!(判色(""), 错误(判色故障::空输入));
    断言相等!(判色("   "), 错误(判色故障::空输入));
    断言相等!(判色("紫"), 错误(判色故障::未知颜色));
    断言相等!(判色("black"), 错误(判色故障::未知颜色));
    // 只裁剪首尾空白，颜色名内部有空白即视为未知
    断言相等!(判色("红 色"), 错误(判色故障::未知颜色));
}

// ============================================================
// 拆分词表：文本 → 词条列表
// ============================================================

#[测试]
函数 拆分词表_正常_混合分隔符() {
    断言相等!(
        拆分词表("甲,乙，丙、丁;戊；己|庚"),
        向量![
            字符串::从("甲"),
            字符串::从("乙"),
            字符串::从("丙"),
            字符串::从("丁"),
            字符串::从("戊"),
            字符串::从("己"),
            字符串::从("庚"),
        ]
    );
}

#[测试]
函数 拆分词表_正常_空白也是分隔符() {
    断言相等!(
        拆分词表("甲 乙\t丙\n丁\r戊"),
        向量![
            字符串::从("甲"),
            字符串::从("乙"),
            字符串::从("丙"),
            字符串::从("丁"),
            字符串::从("戊"),
        ]
    );
}

#[测试]
函数 拆分词表_边界_单项与首尾分隔符() {
    断言相等!(拆分词表("单个"), 向量![字符串::从("单个")]);
    断言相等!(拆分词表("  单个  "), 向量![字符串::从("单个")]);
    // 首尾分隔符与连续分隔符都不产生空词条
    断言相等!(拆分词表(",甲,,乙,"), 向量![字符串::从("甲"), 字符串::从("乙")]);
    断言相等!(拆分词表(" 、甲；；乙| "), 向量![字符串::从("甲"), 字符串::从("乙")]);
}

#[测试]
函数 拆分词表_异常_空输入与纯分隔符() {
    断言!(拆分词表("").是否为空());
    断言!(拆分词表("   ").是否为空());
    断言!(拆分词表("，、;；|").是否为空());
    断言相等!(拆分词表("").长度(), 0);
}

// ============================================================
// 播报解析：`级别|内容` → 播报
// ============================================================

#[测试]
函数 播报解析_正常_三种级别() {
    断言相等!(
        播报解析("信息|构建开始"),
        成功(播报 {
            级别: 播报级别::提示,
            内容: 字符串::从("构建开始"),
        })
    );
    断言相等!(
        播报解析("警告|磁盘将满"),
        成功(播报 {
            级别: 播报级别::警示,
            内容: 字符串::从("磁盘将满"),
        })
    );
    断言相等!(
        播报解析("故障|链接失败"),
        成功(播报 {
            级别: 播报级别::故障,
            内容: 字符串::从("链接失败"),
        })
    );
}

#[测试]
函数 播报解析_正常_英文级别别名与修剪() {
    断言相等!(
        播报解析(" INFO | 你好 "),
        成功(播报 {
            级别: 播报级别::提示,
            内容: 字符串::从("你好"),
        })
    );
    断言相等!(
        播报解析("warn|注意"),
        成功(播报 {
            级别: 播报级别::警示,
            内容: 字符串::从("注意"),
        })
    );
    断言相等!(
        播报解析("warning|注意"),
        成功(播报 {
            级别: 播报级别::警示,
            内容: 字符串::从("注意"),
        })
    );
    断言相等!(
        播报解析("error|出错"),
        成功(播报 {
            级别: 播报级别::故障,
            内容: 字符串::从("出错"),
        })
    );
}

#[测试]
函数 播报解析_边界_内容可含分隔符与首尾空白() {
    // 只按首个竖线切分，内容中的竖线原样保留
    断言相等!(
        播报解析("信息|甲|乙"),
        成功(播报 {
            级别: 播报级别::提示,
            内容: 字符串::从("甲|乙"),
        })
    );
    // 外层空白与内容前后空白都被裁剪
    断言相等!(
        播报解析("  警告 |  甲 | 乙  "),
        成功(播报 {
            级别: 播报级别::警示,
            内容: 字符串::从("甲 | 乙"),
        })
    );
}

#[测试]
函数 播报解析_异常_四类输入() {
    断言相等!(播报解析(""), 错误(播报故障::空输入));
    断言相等!(播报解析("   "), 错误(播报故障::空输入));
    断言相等!(播报解析("只有内容没有分隔符"), 错误(播报故障::缺少分隔符));
    断言相等!(播报解析("调试|内容"), 错误(播报故障::未知级别));
    断言相等!(播报解析("信息|"), 错误(播报故障::内容为空));
    断言相等!(播报解析("信息|   "), 错误(播报故障::内容为空));
}
