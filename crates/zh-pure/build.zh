//! 构建脚本：把 `tests-zh/*.zh` 方言测试转译为标准 Rust，写入 `$OUT_DIR`
//!
//! cargo 只识别 `.rs` 测试文件，因此这里用项目自身引擎做一次转译，
//! 生成物由 `tests/方言测试.zh` 转译出的测试入口以 `include!` 引入——方言里的
//! `#[测试]` 转译后成为 `#[test]`，`cargo test` 自动发现并执行。
//!
//! 映射只取自**编译期嵌入**的内置 zh 语言包（不读磁盘语言包、不联网、
//! 不读环境变量），保证测试结果与运行环境无关。

使用 标准库::环境;
使用 标准库::格式化方法::写入特征 作为 _;
使用 标准库::文件系统;
使用 标准库::路径::{路径类型, 路径缓冲};

/// 存放方言测试的目录（与 `.rs` 测试入口分离，专放纯函数用例）
常量 源目录: &文本 = "tests-zh";

函数 主函数() {
    打印行!("cargo:rerun-if-changed=build.rs");
    打印行!("cargo:rerun-if-changed={源目录}");

    让 管理器值 = 加载映射();
    让 可变 产物文本 = 字符串::从("// 由 build.rs 从 tests-zh/ 转译生成，请勿手改\n");

    让 可变 源文件列表: 向量<路径缓冲> = 向量::新建();
    对于 目录条目 在 文件系统::读取目录(源目录)
        .取值或_else(|故障值| 恐慌!("读取 {源目录} 目录失败: {故障值}"))
        .展平()
    {
        让 路径值 = 目录条目.路径属性();
        如果 路径值.取扩展名().和_then(|后缀值| 后缀值.取字符串引用()) == 有值("zh") {
            源文件列表.推入(路径值);
        }
    }
    源文件列表.排序();
    如果 源文件列表.为空() {
        恐慌!("{源目录}/ 下没有 .zh 测试文件");
    }

    对于 路径值 在 &源文件列表 {
        让 源码文本 = 文件系统::读取全部字符串(路径值)
            .取值或_else(|故障值| 恐慌!("读取 {} 失败: {故障值}", 路径值.展示()));
        让 转译结果 = 引擎库::静默转译管线(&源码文本, &管理器值);
        // 产物必须是标准 Rust：方言测试标记没被替换说明语言包没生效，
        // 此时产出的 #[测试] 会被 rustc 当成未知属性丢弃、测试静默消失，
        // 故直接让构建失败（构建期恐慌是 cargo 的既定失败方式）。
        // 注释里提到标记的说明文字不算残留，故按行跳过注释行。
        让 残留标记 = 转译结果.输出.逐行().任意(|代码行| {
            让 去空白 = 代码行.裁剪左侧();
            !去空白.以开头("//") && 去空白.包含("#[测试]")
        });
        断言!(!残留标记, "{} 未被转译（语言包映射未生效）", 路径值.展示());
        // 反向保险：转译后的用例必须真的带上 `#[test]`，否则 cargo 永远发现不到
        断言!(
            转译结果.输出.包含("#[test]"),
            "{} 没有产出任何 #[test] 用例",
            路径值.展示()
        );
        写入格式化行!(产物文本, "// ===== 源文件：{} =====", 路径值.展示()).期望("写入产物失败");
        产物文本.推入字符串(&转译结果.输出);
        产物文本.推入('\n');
    }

    让 输出路径 = 路径类型::新建(&环境::环境变量("OUT_DIR").期望("缺少 OUT_DIR")).连接("zh_tests.rs");
    文件系统::写入(&输出路径, 产物文本)
        .取值或_else(|故障值| 恐慌!("写入 {} 失败: {故障值}", 输出路径.展示()));
}

/// 从编译期嵌入的 zh 语言包构造映射管理器（与 CLI 内置包同源）
函数 加载映射() -> 引擎库::映射管理器::映射管理器 {
    让 文件列表 = 引擎库::语言::内置语言包文件("zh");
    让 取内容 = |名称值: &文本| {
        文件列表
            .迭代()
            .查找(|(路径名, _)| *路径名 == 名称值)
            .变换(|(_, 内容值)| *内容值)
            .取值或("")
    };
    让 可变 第三方: 向量<(&文本, &文本)> = 向量::新建();
    对于 (路径名, 内容值) 在 文件列表.迭代() {
        如果 路径名.以开头("crates/") {
            第三方.推入((*路径名, *内容值));
        }
    }
    引擎库::映射管理器::映射管理器::从内置载入(
        取内容("keywords.toml"),
        取内容("module_paths.toml"),
        取内容("stdlib.toml"),
        &第三方,
    )
    .期望("内置 zh 语言包应可加载")
}
