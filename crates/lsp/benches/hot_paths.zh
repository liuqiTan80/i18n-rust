//! LSP 热路径性能基准（criterion）
//!
//! 覆盖代理服务器最频繁的两条路径：
//! - `update_document`：编辑器打开/每次按键触发的文档同步（全量转译 +
//!   列映射回放 + 教学检查 + 虚拟文件写盘）。分「打开文件」（首次打开，
//!   模块集合变化 → 全量重写 + 虚拟项目刷新）与「连续编辑」（集合不变 →
//!   仅重写当前条目）两个场景；
//! - `reverse_transpile`：rust-analyzer 响应映射热路径（英文文本 → 母语）。
//!   分「补全片段」（无文档上下文的短片段）与「整文档还原」（格式化响应）。
//!
//! 运行：`cargo bench -p i18n-rust-lsp`
//! CI 快速模式：`cargo bench -p i18n-rust-lsp -- --quick`

使用 std::hint::black_box;
使用 std::path::{Path, PathBuf};

使用 criterion::{BatchSize, Criterion, criterion_group, criterion_main};
使用 i18n_rust_engine::映射管理::映射管理器;
使用 i18n_rust_lsp::翻译缓存::转译缓存;

/// 构造内置 zh 语言包映射管理器（与 CLI / LSP 默认一致）
函数 内置管理器() -> 映射管理器 {
    让 目录 = Path::new(env!("CARGO_MANIFEST_DIR")).join("../engine/lang-packs/zh");
    映射管理器::自目录加载(&目录).expect("加载 zh 语言包失败")
}

/// 教学场景中等规模源码：约 250 行混合结构
/// （函数/类型注解/字符串/宏/use 路径/for 循环/向量，与 engine 基准同语料）
函数 教学语料() -> 字符串 {
    让 可变 语料文本 = 字符串::new();
    语料文本.push_str("使用 标准库::集合::映射;\n\n");
    对于 序号 in 0..50 {
        语料文本.push_str(&格式化!(
            "函数 函数_{序号}(数量: 整数, 名称: 字符串) -> 整数 {{\n\
             \x20   让 结果 = 数量 * 2;\n\
             \x20   // 计算注释：{序号}\n\
             \x20   打印行!(\"处理第 {序号} 个：{{}}\", 名称);\n\
             \x20   返回 结果;\n\
             }}\n\n",
        ));
    }
    语料文本.push_str(
        "函数 主函数() {\n\
         \x20   让 全部 = 向量::新建();\n\
         \x20   for i in 0..50 {\n\
         \x20       全部.推送(函数_i(i, \"测试\"));\n\
         \x20   }\n\
         \x20   打印行!(\"总计：{{:?}}\", 全部);\n\
         }\n",
    );
    语料文本
}

/// 在演示目录中写入真实源文件（sync_sibling_modules / disk_meta 走真实磁盘分支），
/// 返回源文件路径与其 file:// URI
函数 搭建工程(工程根: &Path, 子目录名: &文本, 文件内容: &文本) -> (PathBuf, 字符串) {
    让 源码目录 = 工程根.join(子目录名).join("src");
    std::fs::create_dir_all(&源码目录).expect("创建演示项目目录失败");
    让 文件路径 = 源码目录.join("main.zh");
    std::fs::write(&文件路径, 文件内容).expect("写入演示源码失败");
    让 资源定位 = 格式化!("file://{}", 文件路径.display());
    (文件路径, 资源定位)
}

/// update_document：打开文件（全量路径）与连续编辑（增量路径）
函数 文档更新基准(基准目标: &可变 Criterion) {
    // 基准中抑制引擎教学日志（默认警告级会因教学 lint 刷屏并引入
    // 终端 I/O 抖动；与 engine 基准的静默口径一致）
    i18n_rust_engine::日志::静默日志();
    让 管理器 = 内置管理器();
    让 语料 = 教学语料();
    让 可变 基准组 = 基准目标.benchmark_group("lsp_update_document");
    基准组.sample_size(50);

    // ① 打开文件：冷缓存首次打开（模块集合空 → 全量重写 + 虚拟项目刷新）。
    //    每次迭代完整重建缓存与项目目录，量的是"打开一个文件"的端到端成本
    基准组.bench_function("update_document_open", |基准器| {
        基准器.iter_batched(
            || {
                让 临时目录 = tempfile::tempdir().expect("创建临时目录失败");
                让 (_占位, 资源定位) = 搭建工程(临时目录.path(), "proj", &语料);
                让 增量缓存 = 转译缓存::新建缓存(管理器.clone(), 临时目录.path().join("virtual"));
                (临时目录, 增量缓存, 资源定位)
            },
            |(_临时, 增量缓存, 资源定位)| {
                增量缓存
                    .更新文档(black_box(&资源定位), black_box(&语料), 1)
                    .expect("打开文件失败")
            },
            BatchSize::SmallInput,
        )
    });

    // ② 连续编辑：预热打开后反复修改同一文件（内容每次不同，模拟真实打字：
    //    模块集合不变 → 仅重写当前条目，声明名缓存按内容哈希逐次失效）
    让 临时目录 = tempfile::tempdir().expect("创建临时目录失败");
    让 (_占位, 资源定位) = 搭建工程(临时目录.path(), "proj_typing", &语料);
    让 增量缓存 = 转译缓存::新建缓存(管理器.clone(), 临时目录.path().join("virtual"));
    增量缓存
        .更新文档(&资源定位, &语料, 1)
        .expect("预热打开失败");
    让 可变 版本号 = 1i32;
    基准组.bench_function("update_document_typing", |基准器| {
        让 可变 计数器 = 0usize;
        基准器.iter(|| {
            计数器 += 1;
            版本号 += 1;
            让 编辑后文本 = 格式化!("{语料}\n// 连续编辑 {计数器}");
            增量缓存
                .更新文档(black_box(&资源定位), black_box(&编辑后文本), 版本号)
                .expect("编辑失败")
        })
    });

    基准组.finish();
}

/// reverse_transpile：补全片段（无上下文）与整文档还原（格式化响应）
函数 逆向转译基准(基准目标: &可变 Criterion) {
    // 同上：静默引擎教学日志
    i18n_rust_engine::日志::静默日志();
    让 管理器 = 内置管理器();
    让 语料 = 教学语料();
    让 临时目录 = tempfile::tempdir().expect("创建临时目录失败");
    让 (_占位, 资源定位) = 搭建工程(临时目录.path(), "proj_reverse", &语料);
    让 增量缓存 = 转译缓存::新建缓存(管理器.clone(), 临时目录.path().join("virtual"));
    让 (条目项, _) = 增量缓存
        .更新文档(&资源定位, &语料, 1)
        .expect("预热打开失败");
    // 转译产物即"经 rustfmt 格式化后的英文文本"的典型素材
    让 英文产物 = 条目项.英文源码.clone();

    让 可变 基准组 = 基准目标.benchmark_group("lsp_reverse_transpile");
    基准组.sample_size(50);

    // ① 补全片段：uri=None 的无文档上下文场景（补全/代码操作每个片段都走这里）
    让 补全片段 = "let mut 总数 = String::new();";
    基准组.bench_function("reverse_transpile_completion", |基准器| {
        基准器.iter(|| 增量缓存.逆向转译(无, black_box(补全片段)))
    });

    // ② 整文档还原：textDocument/formatting 响应（传入 uri 以精确处理
    //    代理添加的 crate:: 前缀，避免误删用户手写前缀）
    基准组.bench_function("reverse_transpile_formatting", |基准器| {
        基准器.iter(|| 增量缓存.逆向转译(有值(black_box(资源定位.as_str())), black_box(英文产物.as_str())))
    });

    基准组.finish();
}

criterion_group!(基准集合, 文档更新基准, 逆向转译基准);
criterion_main!(基准集合);
