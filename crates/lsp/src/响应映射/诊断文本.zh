//! 诊断消息翻译与所有权详情提取（CLI 同源消息表）。
//!
//! 由服务器启动时初始化错误消息翻译器（语言包 errors.toml，缺失时
//! 回退引擎内嵌 zh），为诊断发布提供消息中文化与
//! 所有权错误的叙事化详情。

使用 标准库::集合::{哈希映射, 哈希集合};
使用 标准库::路径::{路径类型, 路径缓冲};
使用 标准库::同步::{原子引用计数, 互斥锁, 一次性锁, 懒静态};
使用 标准库::时间模块::系统时间;

使用 引擎库::诊断::{借用冲突, 诊断位置, 所有权详情};
使用 JSON序列化::JSON值;

使用 包::翻译缓存::{翻译条目, 英文列转母语列};

/// 诊断翻译器（errors.toml 消息表 + 错误码表 + 类型映射）：与 CLI 完全同源，
/// 走引擎 `渲染主消息` 统一口径，覆盖 rustc/rust-analyzer 的常见消息。
/// 由服务器启动时初始化（语言包目录 errors.toml + 映射管理器，缺失时回退内置
/// zh）；未初始化时为 无，翻译退化为下方轻量短语替换。
静态 诊断翻译器槽: 一次性锁<
    选项<引擎库::诊断::诊断翻译器>,
> = 一次性锁::新建();

/// 初始化诊断翻译器（errors.toml 消息表 + 由映射管理器构建的类型映射；
/// 失败/缺失时回退内置 zh），使 LSP 主消息与 CLI 对同一错误码与消息得到同一译文。
公开 函数 初始化诊断翻译器(
    语言包路径: &标准库::路径模块::路径类型,
    管理器: &引擎库::映射管理器::映射管理器,
) {
    让 类型映射 = 引擎库::诊断::构建类型映射(管理器);
    让 翻译管理器 =
        引擎库::诊断::错误消息管理器::从文件载入(
            &语言包路径.连接("errors.toml"),
        )
        .转选项()
        .或用否则(内置中文错误翻译器);
    让 翻译器 = 翻译管理器
        .变换(|管理器值| 引擎库::诊断::诊断翻译器::新建诊断翻译器(管理器值, 类型映射));
    让 _ = 诊断翻译器槽.设置(翻译器);
}

/// 物化引擎内嵌的中文 errors.toml 并加载翻译器（语言包目录缺失时兜底）
函数 内置中文错误翻译器() -> 选项<引擎库::诊断::错误消息管理器> {
    让 目录 = 临时文件::建临时目录().转选项()?;
    让 内容 = 引擎库::语言::内置语言包文件("zh")
        .迭代()
        .查找(|(文件名, _)| *文件名 == "errors.toml")?
        .1;
    标准库::文件系统::写入(目录.条目路径().连接("errors.toml"), 内容).转选项()?;
    引擎库::诊断::错误消息管理器::从文件载入(
        &目录.条目路径().连接("errors.toml"),
    )
    .转选项()
}

/// 翻译诊断主消息为当前界面语言（与 CLI 同口径）
///
/// 错误码参数（若有）供错误码表优先命中；主标签参数为 rustc 主
/// 跨度标签（镜像检查从真实 rustc JSON 可得，供提取期望/实际类型）。
/// 优先走引擎 `渲染主消息`（错误码表→消息表→占位符回填→类型中文化）；
/// 未命中时退化为轻量短语替换。多行消息按行逐条翻译后拼接（仅首行适用
/// 错误码/标签与教学提示）。仅反引号外文本参与兜底替换，避免误伤标识符。
///
/// 公开(包)：镜像检查（真实项目 rustc 诊断）与诊断发布共用同一渲染。
公开(包) 函数 翻译诊断消息(
    错误码: 选项<&文本>,
    消息: &文本,
    主标签: 选项<&文本>,
) -> 字符串 {
    // 多行消息（rust-analyzer 的 E0004 等）逐行翻译；错误码/标签只属于首行
    如果 消息.包含('\n') {
        让 可变 是首行 = 真;
        让 行列表: 向量<字符串> = 消息
            .分割('\n')
            .变换(|行文本| {
                让 已翻译 = 如果 是首行 {
                    翻译诊断消息单行(错误码, 行文本, 主标签, 真)
                } 否则 {
                    翻译诊断消息单行(无, 行文本, 无, 假)
                };
                是首行 = 假;
                已翻译
            })
            .收集();
        返回 行列表.连接("\n");
    }
    翻译诊断消息单行(错误码, 消息, 主标签, 真)
}

/// 从 rust-analyzer 诊断里归集含期望与实际字样的候选标签文本。
///
/// rust-analyzer 把类型不匹配的期望/实际放在关联信息而非主
/// 跨度标签（CLI 的 rustc JSON 则带在主跨度标签）。本函数从关联
/// 消息中取首个命中者，作为 `渲染主消息` 的主标签，使分析器
/// 直连路径也能回填 `{期望}`/`{实际}`，与 CLI/镜像检查同一完整译文。
/// 无命中时返回 无（渲染器自动回退消息表，不劣于旧行为）。
公开(包) 函数 查找期望实得标签(诊断值: &JSON值) -> 选项<字符串> {
    诊断值.读取条目("relatedInformation")
        .而后映射(|值| 值.作为数组())?
        .迭代()
        .过滤映射(|项| 项.读取条目("message").而后映射(|值| 值.作为字符串()))
        .查找(|消息| 消息.包含("expected ") && 消息.包含(", found "))
        .变换(|文本串| 文本串.转字符串())
}

/// 轻量短语替换表（诊断翻译兜底）：界面全局语言固定，首次构建后缓存。
/// 诊断每次按键都会发布，若每次翻译都重新构建约 30 对字符串是纯浪费。
静态 诊断短语替换表: 懒静态<向量<(字符串, 字符串)>> =
    懒静态::新建(|| {
        让 界面 = 包::界面消息::全局界面();
        让 可变 替换项: 向量<(字符串, 字符串)> = 向量![
            ("{integer}".转字符串(), 界面.取消息("diag_rustc_integer")),
            ("{float}".转字符串(), 界面.取消息("diag_rustc_float")),
            (
                "floating-point number".转字符串(),
                界面.取消息("diag_rustc_float"),
            ),
            ("integer".转字符串(), 界面.取消息("diag_rustc_integer")),
        ];

        // 常见错误模式翻译
        让 替换表 = [
            ("cannot find value", 界面.取消息("lsp_phrase_cannot_find_value")),
            ("cannot find type", 界面.取消息("lsp_phrase_cannot_find_type")),
            (
                "cannot find function",
                界面.取消息("lsp_phrase_cannot_find_function"),
            ),
            ("cannot find module", 界面.取消息("lsp_phrase_cannot_find_module")),
            ("mismatched types", 界面.取消息("lsp_phrase_mismatched_types")),
            ("type mismatch", 界面.取消息("lsp_phrase_type_mismatch")),
            ("expected", 界面.取消息("lsp_phrase_expected")),
            // “实得”仅在类型不匹配场景译为
            // 「实际为」：以带逗号的长键限定语境——裸词“实得”会把 E0599 的
            // 未找到方法的消息误译为「实际为」
            //（“找到”义），也会与“方法未找到”变体相互干扰
            (", found ", 格式化!("，{} ", 界面.取消息("lsp_phrase_found"))),
            ("unused variable", 界面.取消息("lsp_phrase_unused_variable")),
            ("unused import", 界面.取消息("lsp_phrase_unused_import")),
            ("cannot borrow", 界面.取消息("lsp_phrase_cannot_borrow")),
            (
                "borrowed as immutable",
                界面.取消息("lsp_phrase_borrowed_immutable"),
            ),
            ("borrowed as mutable", 界面.取消息("lsp_phrase_borrowed_mutable")),
            ("no method named", 界面.取消息("lsp_phrase_no_method_named")),
            ("method not found", 界面.取消息("lsp_phrase_method_not_found")),
            ("field", 界面.取消息("lsp_phrase_field")),
            ("does not implement", 界面.取消息("lsp_phrase_does_not_implement")),
            ("the trait", 界面.取消息("lsp_phrase_the_trait")),
            ("is not satisfied", 界面.取消息("lsp_phrase_is_not_satisfied")),
            ("unresolved import", 界面.取消息("lsp_phrase_unresolved_import")),
            ("file not found", 界面.取消息("lsp_phrase_file_not_found")),
            ("aborting due to", 界面.取消息("lsp_phrase_aborting_due_to")),
            ("previous error", 界面.取消息("lsp_phrase_previous_error")),
        ];

        对于 (英文词, 本地词) 在 替换表 {
            替换项.推入((英文词.转字符串(), 本地词));
        }
        // 长键优先：按键长降序应用，避免短串先替换打碎长短语
        //（如短键先于“文件未找到”会把后者拆坏）。
        // 语境冲突已从源头消解（裸词“实得”改为带逗号的语境键），
        // 排序仍作为一般性防御保留。
        替换项.按键排序(|项| 项.0.元素数());
        替换项.反转();
        替换项
    });

/// 单行诊断主消息渲染：引擎同口径优先，轻量短语表兜底
函数 翻译诊断消息单行(
    错误码: 选项<&文本>,
    消息: &文本,
    主标签: 选项<&文本>,
    带提示: 布尔,
) -> 字符串 {
    让 界面 = 包::界面消息::全局界面();

    // 1. 引擎同口径渲染（与 CLI 完全同源）：错误码表优先→消息表（精确/前缀/
    //    后缀/通配段）→ 占位符回填，回填进来的值走类型映射中的类型中文化
    //（模板字面里作者手写的入口名或类型名不参与改写）。命中任一表即返回。
    如果让 有值(翻译器) = 诊断翻译器槽.读取条目().而后映射(|选项值| 选项值.作为引用方法())
        && 让 有值(已渲染) = 翻译器.渲染主消息(错误码, 消息, 主标签)
    {
        让 可变 文本串 = 已渲染.文字;
        如果 带提示 && 让 有值(提示) = &已渲染.提示 {
            文本串.推入('\n');
            文本串.推入字符串(提示);
        }
        返回 文本串;
    }

    // 2. 轻量短语替换（兜底）：静态表首次构建后缓存，避免每次分配
    让 替换项 = &*诊断短语替换表;
    让 可变 结果值 = 反引号外替换(消息, 替换项);

    // 添加教学提示
    如果 消息.包含("mismatched types") || 消息.包含("type mismatch") {
        结果值.推入字符串(&界面.取消息("lsp_hint_mismatched_types"));
    } 否则 如果 消息.包含("cannot find") {
        结果值.推入字符串(&界面.取消息("lsp_hint_cannot_find"));
    } 否则 如果 消息.包含("unused") {
        结果值.推入字符串(&界面.取消息("lsp_hint_unused"));
    } 否则 如果 引擎库::诊断::是否未解析导入消息(消息) {
        // 未解析导入：提示通过 `rzc add <crate>` 添加缺失依赖
        如果让 有值(包名) =
            引擎库::诊断::未解析包候选(消息).第一个()
        {
            结果值.推入字符串(&界面.取带参消息("lsp_hint_add_dependency", &[包名]));
        }
    }

    结果值
}

/// 整词替换：仅当目标前后字符均非 ASCII 标识符字符时替换，
/// 避免裸词模式误伤标识符子串（如英文单词内部的相同子串）
函数 整词替换(文本串: &文本, 原词: &文本, 新词: &文本) -> 字符串 {
    让 是标识符字符 = |字符值: 字符| 字符值.是ASCII字母数字() || 字符值 == '_';
    让 可变 结果值 = 字符串::带容量(文本串.元素数());
    让 可变 剩余 = 文本串;
    当让 有值(位置) = 剩余.查找(原词) {
        让 结束位置 = 位置 + 原词.元素数();
        让 前侧可替换 = 剩余[..位置]
            .逐字符()
            .下一个后端()
            .是否为无或(|字符值| !是标识符字符(字符值));
        让 后侧可替换 = 剩余[结束位置..].逐字符().下一个().是否为无或(|字符值| !是标识符字符(字符值));
        结果值.推入字符串(&剩余[..位置]);
        结果值.推入字符串(如果 前侧可替换 && 后侧可替换 { 新词 } 否则 { 原词 });
        剩余 = &剩余[结束位置..];
    }
    结果值.推入字符串(剩余);
    结果值
}

/// 按顺序对反引号包裹之外的文本应用替换，反引号内的内容（标识符/
/// 类型名引用）保持原样；未成对的反引号后文本仍参与替换
函数 反引号外替换(输入: &文本, 替换项: &[(字符串, 字符串)]) -> 字符串 {
    让 应用 = |片段: &文本| -> 字符串 {
        让 可变 文本串 = 片段.转字符串();
        对于 (原词, 新词) 在 替换项 {
            // 单词模式（如 integer/expected）用整词匹配，避免误伤
            // to_integer/unexpected 等标识符子串；短语模式保持子串替换
            文本串 = 如果 原词.逐字符().全部(|字符值| 字符值.是ASCII字母数字() || 字符值 == '_') {
                整词替换(&文本串, 原词, 新词)
            } 否则 {
                文本串.替换(原词.作为文本切片(), 新词.作为文本切片())
            };
        }
        文本串
    };

    让 可变 结果值 = 字符串::带容量(输入.元素数());
    让 可变 剩余 = 输入;
    当让 有值(起始位置) = 剩余.查找('`') {
        结果值.推入字符串(&应用(&剩余[..起始位置]));
        让 之后 = &剩余[起始位置 + 1..];
        匹配 之后.查找('`') {
            有值(结束位置) => {
                // 成对反引号：内部内容原样保留
                结果值.推入('`');
                结果值.推入字符串(&之后[..结束位置]);
                结果值.推入('`');
                剩余 = &之后[结束位置 + 1..];
            }
            无 => {
                // 未成对：剩余文本照常替换
                结果值.推入('`');
                结果值.推入字符串(&应用(之后));
                剩余 = "";
                中断;
            }
        }
    }
    结果值.推入字符串(&应用(剩余));
    结果值
}

/// 判断一条诊断是否为虚拟项目主程序文件中关于主函数的提示级提示
///
/// 虚拟项目将用户代码作为模块聚合到 main.rs 中，`fn main()` 在模块内
/// 并非真正的程序入口，rust-analyzer 会发出“此处是名为主函数的函数”
/// 等教学无关的提示。此函数识别并过滤这类诊断。
公开(超级) 函数 是主函数提示(诊断值: &JSON值, _虚拟资源标识: &文本) -> 布尔 {
    // 仅过滤提示级别（严重级为 4）
    让 严重级 = 诊断值.读取条目("severity").而后映射(|值| 值.作为长整数()).取值或(0);
    如果 严重级 != 4 {
        返回 假;
    }
    让 消息 = 诊断值.读取条目("message").而后映射(|值| 值.作为字符串()).取值或("");
    // 过滤“此处是名为主函数的函数”类提示
    消息.包含("here is a function named `main`")
        || (消息.包含("function `main`") && 消息.包含("never used"))
}

/// 过滤虚拟项目固有的过程宏误报（#3 症状二）
///
/// 虚拟项目禁用了过程宏（`procMacro.enable=false`）且不含第三方依赖，
/// `#[派生(解析器)]`→`#[derive(Parser)]`（命令行解析库等）无法展开，其辅助属性与
/// 派生宏的名字解析必然失败：
/// - 找不到属性名（辅助属性，如属性的长参数写法）
/// - 找不到派生宏
///
/// 这两类诊断在虚拟项目语境下恒为误报（用户项目中 `rzc check` 正常通过），
/// 直接过滤；`unresolved import` 不过滤——它是“添加依赖”快速修复的输入，
/// 且用户项目真实缺依赖时同样出现。
公开(超级) 函数 是缺依赖噪音(诊断值: &JSON值) -> 布尔 {
    让 消息 = 诊断值.读取条目("message").而后映射(|值| 值.作为字符串()).取值或("");
    消息.包含("cannot find attribute") || 消息.包含("cannot find derive macro")
}

/// 过滤“引用未打开模块文件”的 E0433/E0432 误报
///
/// LSP 虚拟项目只聚合当前打开的文件：`crate::日志设置` 引用的
/// `日志设置.zh` 未打开时，聚合 main.rs 中没有对应模块声明，
/// rust-analyzer 会报 E0433/E0432。该引用在本项目中实际有效
/// （同名文件存在于同目录，打开后即可解析），属于虚拟项目固有误报；
/// 条目同目录存在同名方言文件时过滤。文件确实不存在（如拼写错误）时
/// 诊断保留，供用户修正。
///
/// 覆盖的 rust-analyzer 消息格式（0.3.3025 起为 rustc 1.98 风格）：
/// - `cannot find module or crate `X` in this scope`（旧 E0433）
/// - 在包内找不到 X（新 E0433）
/// - 未解析导入包内路径 X（新 E0432，可含尾段）
/// - `unresolved import `X``（裸路径）
/// - 根作用域无 X（严重级 4 的同伴提示）
公开(超级) 函数 是未打开模块引用(
    诊断值: &JSON值,
    条目值: 选项<&包::翻译缓存::翻译条目>,
) -> 布尔 {
    让 有值(条目) = 条目值 否则 {
        返回 假;
    };
    让 消息 = 诊断值.读取条目("message").而后映射(|值| 值.作为字符串()).取值或("");
    让 有值(名称) = 未打开模块名(消息) 否则 {
        返回 假;
    };
    // 同目录存在 `名字.<原扩展名>` 时视为“模块文件未打开”的误报
    让 (有值(目录), 有值(扩展)) = (
        条目.原始路径.父目录(),
        条目.原始路径.扩展名().而后映射(|串| 串.取字符串引用()),
    ) 否则 {
        返回 假;
    };
    目录.连接(格式化!("{名称}.{扩展}")).是否为文件()
}

/// 从诊断消息中提取“未打开模块”候选名（仅识别已知消息格式）
函数 未打开模块名(消息: &文本) -> 选项<&文本> {
    常量 保留字: &[&文本] = &["crate", "self", "super", "std", "core", "alloc"];
    让 路径文本 = 如果让 有值(剩余) = 消息.去前缀("cannot find module or crate `") {
        剩余.分割一次('`')?.0
    } 否则 如果让 有值(剩余) = 消息.去前缀("cannot find `") {
        让 (名称, 尾部) = 剩余.分割一次('`')?;
        如果 !尾部.以开头(" in `crate`") {
            返回 无;
        }
        名称
    } 否则 如果让 有值(剩余) = 消息.去前缀("unresolved import `") {
        剩余.分割一次('`')?.0
    } 否则 {
        让 剩余 = 消息.去前缀("no `")?;
        让 (名称, 尾部) = 剩余.分割一次('`')?;
        如果 !尾部.以开头(" in the root") {
            返回 无;
        }
        名称
    };
    // 去掉 `crate::` 前缀后取首段（`crate::X::Y` → X）
    让 路径文本 = 路径文本.去前缀("crate::").取值或(路径文本);
    让 首段 = 路径文本.分割("::").下一个().取值或(路径文本);
    // 模块名必须是单个安全路径段（防御恶意构造的路径穿越，如 `..`/`/`），
    // 且不能是保留字路径段（std/core/alloc 等系统包不可能是本地模块）
    如果 首段.为空()
        || 首段.包含('/')
        || 首段.包含('\\')
        || 首段.包含("..")
        || 首段.以开头('.')
        || 保留字.包含(&首段)
    {
        返回 无;
    }
    有值(首段)
}

/// 过滤“第三方依赖在 LSP 虚拟项目缺失”的误报
///
/// 虚拟项目 Cargo.toml 不含用户项目依赖，序列化库等已声明
/// 依赖的导入与引用在虚拟项目中必然无法解析。当消息中的候选包名
/// 出现在用户项目最近 Cargo.toml 的依赖表（dependencies/dev/build、
/// 工作区、目标平台各节；`-`/`_` 与大小写归一化，另含去全部
/// 分隔符的紧致形式——连字符包名的库名为去分隔符形式）中时，判定为虚拟项目
/// 固有误报并过滤；未列入依赖表的名字（拼写错误、真正缺失的库）保留
/// 诊断，继续提供 `rzc add` 教学提示。
公开(超级) 函数 是缺项目依赖(
    诊断值: &JSON值,
    条目值: 选项<&包::翻译缓存::翻译条目>,
) -> 布尔 {
    让 有值(条目) = 条目值 否则 {
        返回 假;
    };
    让 消息 = 诊断值.读取条目("message").而后映射(|值| 值.作为字符串()).取值或("");
    // 仅处理“导入/引用未声明包”类消息，避免误伤同名变量/函数的诊断
    让 是导入类 = 消息.以开头("unresolved import `")
        || 消息.以开头("cannot find module or crate `")
        || 消息.包含("use of undeclared crate or module `");
    如果 !是导入类 {
        返回 假;
    }
    让 有值(依赖集) = 项目依赖名(&条目.原始路径) 否则 {
        返回 假;
    };
    引擎库::诊断::取反引号首段(消息)
        .迭代()
        .任意(|段| 段.是否为ASCII() && 包名形式(段).迭代().任意(|形式| 依赖集.包含(形式)))
}

/// 过滤“内嵌字符串与内嵌字节资源在虚拟项目中缺失”的误报
///
/// 虚拟 .rs 位于 `/tmp/i18n_lsp_virtual_*/src/` 下，`include_str!("界面.html")`
/// 相对虚拟目录解析必然失败（rust-analyzer 报无法读取源目录下的界面文件，
/// 路径按虚拟项目根显示）。去掉源目录前缀后能在原方言文件同目录找到该
/// 文件时判定为误报；原项目真实缺失该资源时诊断保留。
公开(超级) 函数 是缺内嵌资源(
    诊断值: &JSON值,
    条目值: 选项<&包::翻译缓存::翻译条目>,
) -> 布尔 {
    让 有值(条目) = 条目值 否则 {
        返回 假;
    };
    让 消息 = 诊断值.读取条目("message").而后映射(|值| 值.作为字符串()).取值或("");
    让 有值((路径文本, _)) = 消息
        .分割("couldn't read `")
        .取第项(1)
        .而后映射(|剩余| 剩余.分割一次('`'))
    否则 {
        返回 假;
    };
    如果 路径文本.为空() || 路径文本.包含("..") {
        返回 假;
    }
    让 有值(目录) = 条目.原始路径.父目录() 否则 {
        返回 假;
    };
    让 路径值 = 路径类型::新建(路径文本);
    // 虚拟项目根相对路径（如源目录下的界面文件）：去源目录前缀后按原目录解析
    让 相对路径 = 路径值.去前缀("src").取值或(路径值);
    目录.连接(相对路径).是否为文件()
}

/// rust-analyzer 编译级诊断抑制判定：文件位于 cargo 项目时，分析器的
/// E 系列错误（严重级 1）与提示（严重级 4）不转发给客户端，
/// 编译级诊断以代理自跑的镜像/虚拟项目 cargo 检查（rustc 口径）为权威来源
///
/// 分析器在虚拟项目上对第三方依赖与过程宏的类型推断恒为假红（依赖缺失的
/// E0432/E0599、派生不展开的 E0277 显示特征级联等），且其原生诊断与
/// 真错无法从消息文本可靠区分；镜像检查（或不可用时的虚拟检查）在
/// didOpen/didSave 时提供与 rzc 构建同口径的权威结果。E 系列提示是
/// 编译错误的伴生信息拆分发布（“找不到外部包”、“由格式化
/// 参数”等），同为编译级判定的产物，一并抑制。非 cargo 项目
/// （单文件教学场景）不受影响，分析器诊断全量保留；非 E 系列（语法错误、
/// 分析器内部错误等）与警告（严重级 2，可能有价值）一律保留。
公开(包) 函数 抑制分析器编译错误(诊断值: &JSON值, 原始路径: &路径类型) -> 布尔 {
    让 严重级 = 诊断值.读取条目("severity").而后映射(|值| 值.作为长整数()).取值或(0);
    如果 严重级 != 1 && 严重级 != 4 {
        返回 假;
    }
    让 有值(错误码) = 诊断值.读取条目("code").而后映射(|值| 值.作为字符串()) 否则 {
        返回 假;
    };
    如果 !是编译器错误码(错误码) {
        返回 假;
    }
    在货物项目(原始路径)
}

/// E 系列 rustc 错误码（E0432/E0277 等；分析器自带诊断沿用该格式）
函数 是编译器错误码(错误码: &文本) -> 布尔 {
    让 有值(数字串) = 错误码.去前缀('E') 否则 {
        返回 假;
    };
    !数字串.为空() && 数字串.元素数() <= 4 && 数字串.逐字符().全部(|字符值| 字符值.是数字字符())
}

/// 文件路径 → 是否位于 cargo 项目（最近上层存在 Cargo.toml）的进程级缓存
静态 在货物项目缓存: 一次性锁<互斥锁<哈希映射<路径缓冲, 布尔>>> = 一次性锁::新建();

/// 判断文件是否位于 cargo 项目（向上查找最近 Cargo.toml），按路径缓存
函数 在货物项目(文件路径: &路径类型) -> 布尔 {
    让 缓存值 = 在货物项目缓存.取得或初始化(|| 互斥锁::新建(哈希映射::新建()));
    如果让 有值(值) = 缓存值
        .加锁()
        .解包或用否则(|错误值| 错误值.取内层())
        .读取条目(文件路径)
    {
        返回 *值;
    }
    让 可变 目录 = 文件路径.父目录();
    让 可变 已有清单 = 假;
    当让 有值(目录值) = 目录 {
        如果 目录值.连接("Cargo.toml").是否为文件() {
            已有清单 = 真;
            中断;
        }
        目录 = 目录值.父目录();
    }
    缓存值
        .加锁()
        .解包或用否则(|错误值| 错误值.取内层())
        .置入(文件路径.转路径缓冲(), 已有清单);
    已有清单
}

/// 依赖清单解析结果缓存（Cargo.toml 路径 → (修改时间, 归一化依赖名集合)）
类型 项目依赖缓存 = 互斥锁<哈希映射<路径缓冲, (系统时间, 原子引用计数<哈希集合<字符串>>)>>;

/// 项目依赖清单修改时间缓存（键为 Cargo.toml 路径）
静态 项目依赖缓存槽: 一次性锁<项目依赖缓存> = 一次性锁::新建();

/// 向上查找最近的 Cargo.toml 并解析依赖名集合（归一化），按修改时间缓存；
/// 未找到清单时返回 无（调用方保持原诊断行为）
函数 项目依赖名(文件路径: &路径类型) -> 选项<原子引用计数<哈希集合<字符串>>> {
    让 可变 目录 = 文件路径.父目录();
    让 清单路径 = 循环 {
        让 目录值 = 目录?;
        让 候选路径 = 目录值.连接("Cargo.toml");
        如果 候选路径.是否为文件() {
            中断 候选路径;
        }
        目录 = 目录值.父目录();
    };
    让 修改时间值 = 标准库::文件系统::取元数据(&清单路径).转选项()?.修改时间().转选项()?;
    让 缓存值 = 项目依赖缓存槽.取得或初始化(|| 互斥锁::新建(哈希映射::新建()));
    让 可变 守卫 = 缓存值.加锁().解包或用否则(|错误值| 错误值.取内层());
    如果让 有值((缓存时间, 依赖集)) = 守卫.读取条目(&清单路径)
        && *缓存时间 == 修改时间值
    {
        返回 有值(依赖集.克隆值());
    }
    让 文本串 = 标准库::文件系统::读取字符串(&清单路径).转选项()?;
    让 依赖集 = 原子引用计数::新建(解析依赖名(&文本串));
    守卫.置入(清单路径, (修改时间值, 依赖集.克隆值()));
    有值(依赖集)
}

/// 解析 Cargo.toml 中的全部依赖名（含 dev/build、工作区、目标平台各节）
函数 解析依赖名(文本串: &文本) -> 哈希集合<字符串> {
    让 可变 名称集 = 哈希集合::新建();
    // toml 1.x 的 `Value::from_str` 解析的是「单个值」而非「整个文档」
    让 成功(文档值) = TOML处理::解析字符串::<TOML处理::TOML值>(文本串) 否则 {
        返回 名称集;
    };
    让 可变 收集 = |表格选项: 选项<&TOML处理::TOML值>| {
        如果让 有值(表格值) = 表格选项.而后映射(|值| 值.作为表格()) {
            名称集.扩展(表格值.键().平铺(|键名| 包名形式(键名)));
        }
    };
    对于 节名 在 ["dependencies", "dev-dependencies", "build-dependencies"] {
        收集(文档值.读取条目(节名));
    }
    收集(文档值.读取条目("workspace").而后映射(|工作区| 工作区.读取条目("dependencies")));
    如果让 有值(目标表) = 文档值.读取条目("target").而后映射(|目标| 目标.作为表格()) {
        对于 (_, 配置表) 在 目标表 {
            对于 节名 在 ["dependencies", "dev-dependencies", "build-dependencies"] {
                收集(配置表.读取条目(节名));
            }
        }
    }
    名称集
}

/// 依赖名归一化：Cargo 视 `-`/`_` 等价，包名统一小写比较
函数 归一包名(名称: &文本) -> 字符串 {
    名称.转ASCII小写().替换('-', "_")
}

/// 包名比对候选集：归一形式外另收录去全部分隔符的紧致形式——
/// 包名与实际库名可能只在紧致意义上对应（连字符包名的库名为去分隔符形式，
/// 代码中 `使用 md5::...` 而清单声明 `md-5 = "0.10"`）
函数 包名形式(名称: &文本) -> 向量<字符串> {
    让 下划线形式 = 归一包名(名称);
    让 紧致形式: 字符串 = 下划线形式.逐字符().过滤(|字符值| *字符值 != '_').收集();
    如果 紧致形式 == 下划线形式 {
        向量![下划线形式]
    } 否则 {
        向量![下划线形式, 紧致形式]
    }
}

/// 从 LSP 诊断（rust-analyzer 格式）中提取所有权错误详情
///
/// 变量名取自原始消息中的反引号（如“移动值的使用”消息中的变量名）；
/// 移动/借用/再次使用位置取自已还原到母语文件的范围与关联信息，
/// LSP 的 0 起行号统一转为 1 起（与 rustc 诊断一致）。
/// 仅处理 E0382/E0502/E0507 及消息模式匹配的所有权错误。
公开(包) 函数 提取所有权详情(
    原始诊断: &JSON值,
    已还原: &JSON值,
    原始资源标识: &文本,
) -> 选项<所有权详情> {
    让 消息 = 原始诊断["message"].作为字符串()?;
    让 错误码 = 原始诊断["code"].作为字符串().取值或("");
    让 是所有权错误 = 模式匹配!(错误码, "E0382" | "E0502" | "E0507")
        || 消息.包含("use of moved value")
        || 消息.包含("moved value")
        || 消息.包含("cannot borrow")
        || 消息.包含("cannot move out of");
    如果 !是所有权错误 {
        返回 无;
    }

    让 变量名 = 提取反引号变量名(消息)?;
    让 主位置 = 从范围构造位置(原始资源标识, &已还原["range"]);

    让 可变 移动位置 = 无;
    让 可变 借用位置 = 无;
    让 可变 再次使用位置 = 无;
    // E0502 的双方按标签专门认（见 借用冲突）：后方粗分类会把被拒的
    // 可变借用当成「借用发生」，与「仍在用」行号读反
    让 可变 带标签: 向量<(&文本, 诊断位置)> = 向量::新建();

    如果让 有值(关联信息) = 已还原["relatedInformation"].作为数组() {
        对于 项 在 关联信息 {
            让 标签 = 项["message"].作为字符串().取值或("");
            让 有值(位置值) =
                从范围构造位置(原始资源标识, &项["location"]["range"])
            否则 {
                继续;
            };
            带标签.推入((标签, 位置值.克隆值()));
            // 注意顺序：“后续使用借用”同时含借用与再次使用，应归为再次使用
            如果 标签.包含("used here")
                || 标签.包含("later used")
                || 标签.包含("after move")
            {
                再次使用位置.插入或(位置值);
            } 否则 如果 标签.包含("move") {
                移动位置.插入或(位置值);
            } 否则 如果 标签.包含("borrow") {
                借用位置.插入或(位置值);
            }
        }
    }
    // 与引擎同口径：只对 E0502（或消息形态命中）认冲突双方；
    // rust-analyzer 的主范围不带标签，而它就是被拒绝的可变借用——兜底补上
    让 借用冲突值 = 如果 模式匹配!(错误码, "E0502") || 消息.包含("cannot borrow") {
        让 (可变方, 不可变方) = 借用冲突::归类带标签跨度(带标签);
        借用冲突::自两端(可变方.或用否则(|| 主位置.克隆值()), 不可变方)
    } 否则 {
        无
    };

    // 主范围兜底：E0382 → 再次使用；E0502 → 借用发生；E0507 → 移动发生
    如果让 有值(位置值) = 主位置 {
        如果 模式匹配!(错误码, "E0382") || 消息.包含("moved value") {
            再次使用位置.插入或(位置值);
        } 否则 如果 模式匹配!(错误码, "E0502") || 消息.包含("cannot borrow") {
            借用位置.插入或(位置值);
        } 否则 如果 模式匹配!(错误码, "E0507") || 消息.包含("cannot move out of") {
            移动位置.插入或(位置值);
        }
    }

    如果 移动位置.是否为无() && 借用位置.是否为无() && 再次使用位置.是否为无() {
        返回 无;
    }
    有值(所有权详情 {
        变量名,
        移动发生: 移动位置,
        借用发生: 借用位置,
        再次使用: 再次使用位置,
        借用冲突: 借用冲突值,
    })
}

/// 提取消息中反引号包裹的变量名
///
/// 示例："use of moved value: `数据`" → "数据"。
函数 提取反引号变量名(消息: &文本) -> 选项<字符串> {
    让 起始位置 = 消息.查找('`')?;
    让 剩余 = &消息[起始位置 + 1..];
    让 结束位置 = 剩余.查找('`')?;
    有值(剩余[..结束位置].转字符串())
}

/// 从 LSP 范围构造诊断位置（0 起行号转为 1 起）
函数 从范围构造位置(文件名称: &文本, 范围值: &JSON值) -> 选项<诊断位置> {
    让 起始行 = 范围值["start"]["line"].作为长整数()? 作为 无符号整数;
    让 起始列 = 范围值["start"]["character"].作为长整数()? 作为 无符号整数;
    让 结束行 = 范围值["end"]["line"].作为长整数()? 作为 无符号整数;
    让 结束列 = 范围值["end"]["character"].作为长整数()? 作为 无符号整数;
    有值(诊断位置 {
        文件名称: 文件名称.转字符串(),
        起始行号: 起始行 + 1,
        起始列号: 起始列 + 1,
        结束行号: 结束行 + 1,
        结束列号: 结束列 + 1,
        源码文本: 无,
        标签文本: 无,
        是否主因: 假,
    })
}

/// 计算文档的全角标点教学诊断（方言坐标，严重级为提示）
///
/// 在转译后的虚拟文本上扫描：代码位置的全角标点在转译中保留（映射表
/// 不含全角字符），字符串/注释内的全角标点是合法内容且被扫描器跳过；
/// 扫描得到虚拟坐标（转译不改变行结构，代码位置为 ASCII，字符列即
/// UTF-16 列），再经列映射还原为方言坐标，与 RA/内置诊断坐标系一致。
公开(包) 函数 全角诊断(条目值: &翻译条目) -> 向量<JSON值> {
    引擎库::全角标点::检测全角标点(&条目值.英文内容)
        .迭代()
        .变换(|警告项| {
            让 行号 = (警告项.行号 - 1) 作为 无符号整数;
            让 英文列 = (警告项.列序 - 1) 作为 无符号整数;
            让 母语列 = 英文列转母语列(条目值, 行号, 英文列);
            JSON序列化::JSON格式!({
                "range": {
                    "start": { "line": 行号, "character": 母语列 },
                    "end": { "line": 行号, "character": 母语列 + 1 }
                },
                "severity": 3,
                "code": "fullwidth",
                "source": "i18n-rust",
                "message": 警告项.展示行(),
                // 修复动作数据：全角字符与建议的半角字符（供代码操作注入）
                "data": {
                    "character": 警告项.涉事字符.转字符串(),
                    "replacement": 警告项.替代字符.变换(|字符值| 字符值.转字符串())
                }
            })
        })
        .收集()
}

/// 计算文档的教学检查诊断（方言坐标，严重级为提示）
///
/// 直接在母语原文上扫描（`让` 等关键字在转译后已不存在）：行列均为
/// 字符计数，中文代码在基本平面内字符列即 UTF-16 列，直接转换即可。
/// 分桶索引参数为易混方法名的索引（管理器缓存一次，含精确命中表），
/// 供易混方法名提示判定（#14）；歧义构造器参数为推导歧义构造器
/// 被调名集（新建/缺省及其方言词），仅类型无法自行推导的初始化式才提示
/// 未标注类型；关键字映射参数供保留字撞名提示（声明名字转译后是否为 Rust 保留字）。
///
/// 三组警告由一次扫描产出（顺序：教学 / 英文回落 / 保留字撞名，与早先
/// 三个独立入口依次扩展的顺序一致），与 CLI 同源。
公开(包) 函数 教学检查诊断(
    条目值: &翻译条目,
    分桶: &引擎库::校验::词形分桶,
    歧义构造器: &哈希集合<字符串>,
    回落映射: &哈希映射<字符串, 字符串>,
    关键词表: &哈希映射<字符串, 字符串>,
) -> 向量<JSON值> {
    让 字符们: 向量<字符> = 条目值.母语内容.逐字符().收集();
    引擎库::校验::按词形桶检查全部教学字符(
        &字符们,
        分桶,
        歧义构造器,
        回落映射,
        关键词表,
    )
    .迭代()
    .变换(|警告项| {
        让 行号 = (警告项.行号 - 1) 作为 无符号整数;
        让 列号 = (警告项.列号 - 1) 作为 无符号整数;
        JSON序列化::JSON格式!({
            "range": {
                "start": { "line": 行号, "character": 列号 },
                "end": { "line": 行号, "character": 列号 + 1 }
            },
            "severity": 3,
            "code": 匹配 警告项.告警种类 {
                引擎库::校验::告警类别::未标注类型 => "lint-untyped-let",
                引擎库::校验::告警类别::魔法数字 => "lint-magic-number",
                引擎库::校验::告警类别::嵌套过深 => "lint-deep-indent",
                引擎库::校验::告警类别::易混标识符 => "lint-confusable-method",
                引擎库::校验::告警类别::英文回退 => "lint-english-fallback",
                引擎库::校验::告警类别::保留名撞词 => "lint-reserved-name-collision",
            },
            "source": "i18n-rust",
            "message": 警告项.生成说明()
        })
    })
    .收集()
}

/// 注入教学诊断（全角标点 + 教学检查）到方言坐标的诊断列表
///
/// 三条发布路径共用：rust-analyzer 诊断链（诊断发布处理）、
/// 虚拟项目检查、真实项目镜像检查。教学诊断由条目内容直接计算，
/// 不依赖内置缓存（缓存有时序窗口：代理自跑检查先于分析器首批发布
/// 时缓存为空，教学诊断会丢失）。注入前先移除旧的教学诊断（按
/// 诊断码与来源识别），保证与文档最新内容一致。
公开(包) 函数 注入教学诊断(
    诊断们: &可变 向量<JSON值>,
    条目值: &翻译条目,
    分桶: &引擎库::校验::词形分桶,
    歧义构造器: &哈希集合<字符串>,
    回落映射: &哈希映射<字符串, 字符串>,
    关键词表: &哈希映射<字符串, 字符串>,
) {
    诊断们.保留项(|诊断值| !(是教学诊断(诊断值) && 诊断值["source"].作为字符串() == 有值("i18n-rust")));
    诊断们.扩展(全角诊断(条目值));
    如果 教学检查已启用() {
        诊断们.扩展(教学检查诊断(
            条目值,
            分桶,
            歧义构造器,
            回落映射,
            关键词表,
        ));
    }
}

/// 教学诊断开关：默认开启；`RZ_LSP_TEACHING_LINT=off` 关闭
///（重度开发者不需要教学提示时避免诊断噪音）
公开(包) 函数 教学检查已启用() -> 布尔 {
    标准库::环境::环境变量("RZ_LSP_TEACHING_LINT")
        .变换(|值| 值 != "off" && 值 != "0")
        .取值或(真)
}

/// 判断诊断是否为我方注入的教学诊断（全角标点/教学检查）
公开(包) 函数 是教学诊断(诊断值: &JSON值) -> 布尔 {
    诊断值["code"]
        .作为字符串()
        .有值且(|代码| 代码 == "fullwidth" || 代码.以开头("lint-"))
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::{
        包名形式, 查找期望实得标签, 是编译器错误码, 解析依赖名,
        抑制分析器编译错误,
    };

    /// 分析器把期望与实际放在关联信息，应被归集为主消息标签
    #[测试]
    函数 从关联信息查找期望实得标签() {
        让 诊断值 = JSON序列化::JSON格式!({
            "message": "mismatched types",
            "code": "E0308",
            "relatedInformation": [
                { "message": "expected `i32`, found `String`" },
            ]
        });
        断言相等!(
            查找期望实得标签(&诊断值).作为解引用(),
            有值("expected `i32`, found `String`")
        );
        // 无 expected/found 类标签时返回 无（渲染器自动回退消息表）
        让 普通值 = JSON序列化::JSON格式!({
            "message": "use of moved value: `x`",
            "relatedInformation": [ { "message": "moved value used here after move" } ]
        });
        断言相等!(查找期望实得标签(&普通值), 无);
        // 无关联信息也不崩
        断言相等!(
            查找期望实得标签(&JSON序列化::JSON格式!({ "message": "x" })),
            无
        );
    }

    /// 紧致形式：连字符包名 → 下划线形式与去分隔符形式
    #[测试]
    函数 包名形式紧致() {
        让 形式集 = 包名形式("md-5");
        断言!(形式集.包含(&"md_5".转字符串()));
        断言!(形式集.包含(&"md5".转字符串()));
        // 无分隔符的名字保持单一形式
        断言相等!(包名形式("rayon"), 向量!["rayon".转字符串()]);
    }

    /// 依赖清单解析收录紧致形式，供 md-5 风格的包名匹配
    #[测试]
    函数 解析依赖名紧致() {
        让 依赖集 = 解析依赖名("[dependencies]\nmd-5 = \"0.10\"\n");
        断言!(依赖集.包含("md_5"));
        断言!(依赖集.包含("md5"));
        断言!(!依赖集.包含("serde"));
    }

    /// E 系列错误码识别（E + 至多 4 位数字）
    #[测试]
    函数 编译器错误码识别() {
        断言!(是编译器错误码("E0432"));
        断言!(是编译器错误码("E0277"));
        断言!(!是编译器错误码("e0432"));
        断言!(!是编译器错误码("E"));
        断言!(!是编译器错误码("E04a2"));
        断言!(!是编译器错误码("unused_imports"));
    }

    /// cargo 项目内的 E 系列错误抑制；项目外/非 E 码/非错误级不抑制
    #[测试]
    函数 抑制分析器编译错误用例() {
        让 进程号值 = 标准库::进程::进程号();
        让 目录 = 标准库::环境::临时目录().连接(格式化!("diag_text_suppress_{进程号值}"));
        让 源目录 = 目录.连接("src");
        标准库::文件系统::创建所有目录(&源目录).解包();
        标准库::文件系统::写入(目录.连接("Cargo.toml"), "[package]\nname = \"t\"\n").解包();
        让 文件路径 = 源目录.连接("main.zh");
        标准库::文件系统::写入(&文件路径, "").解包();

        让 错误值 = JSON序列化::JSON格式!({ "severity": 1, "code": "E0432", "message": "unresolved import `md5`" });
        断言!(抑制分析器编译错误(&错误值, &文件路径));
        // E 系列提示（编译错误的伴生信息拆分发布）同样抑制
        让 提示值 = JSON序列化::JSON格式!({ "severity": 4, "code": "E0432", "message": "no external crate `toml`" });
        断言!(抑制分析器编译错误(&提示值, &文件路径));
        // 警告不抑制（可能有价值）
        让 警告值 = JSON序列化::JSON格式!({ "severity": 2, "code": "E0432" });
        断言!(!抑制分析器编译错误(&警告值, &文件路径));
        // 非 E 系列（语法错误等）不抑制
        让 语法值 = JSON序列化::JSON格式!({ "severity": 1, "code": "syntax" });
        断言!(!抑制分析器编译错误(&语法值, &文件路径));
        // 非 E 系列提示不抑制（如主函数提示）
        让 普通提示 = JSON序列化::JSON格式!({ "severity": 4, "code": "unused" });
        断言!(!抑制分析器编译错误(&普通提示, &文件路径));
        // 非 cargo 项目（单文件教学场景）不抑制
        让 外部路径 = 标准库::环境::临时目录().连接(格式化!("diag_text_suppress_out_{进程号值}.zh"));
        标准库::文件系统::写入(&外部路径, "").解包();
        断言!(!抑制分析器编译错误(&错误值, &外部路径));
        断言!(!抑制分析器编译错误(&提示值, &外部路径));

        让 _ = 标准库::文件系统::删除所有目录(&目录);
        让 _ = 标准库::文件系统::删除文件(&外部路径);
    }

    // ==================== 噪声过滤器对偶测试 ====================
    //
    // 虚拟项目的 5 个过滤函数按消息文本判定"恒为误报"，两个失败方向
    // 都有真实代价：漏过滤 → 噪声淹没用户；误杀 → 真错被静默吞掉且用户
    // 无从知晓。本组测试钉住每条正例（固有误报应滤）与反例（真错应留），
    // rustc/RA 消息格式漂移时在这里第一时间暴露（文本模式匹配的回归面）。

    使用 超级::{
        翻译条目, 是主函数提示, 是缺依赖噪音, 是缺内嵌资源,
        是缺项目依赖, 是未打开模块引用, 未打开模块名,
    };
    使用 标准库::集合::哈希集合;
    使用 标准库::路径::路径缓冲;

    /// 构造指向临时目录方言文件的缓存条目（仅原始路径参与判定）
    函数 构造条目(原始路径: 路径缓冲) -> 翻译条目 {
        翻译条目 {
            原始资源标识: 格式化!("file://{}", 原始路径.展示()),
            原始路径,
            母语内容: 字符串::新建(),
            英文内容: 字符串::新建(),
            分析器内容: 字符串::新建(),
            虚拟资源标识: 字符串::新建(),
            虚拟路径: 路径缓冲::从("virtual_main.rs"),
            行映射: 向量::新建(),
            列位映射: 包::翻译缓存::列位映射::缺省(),
            新增包前缀词汇: 哈希集合::新建(),
            文档版本: 1,
            已打开: 真,
            源元数据: 无,
            已声明: 无,
        }
    }

    /// 正例：主函数伴生提示被过滤；反例：非提示级/无关消息一律保留
    #[测试]
    函数 主函数提示对偶() {
        让 提示值 = JSON序列化::JSON格式!({
            "severity": 4,
            "message": "here is a function named `main`, but it is not the real entrypoint"
        });
        断言!(是主函数提示(&提示值, "file:///v/main.rs"));
        让 从未使用 = JSON序列化::JSON格式!({
            "severity": 4,
            "message": "function `main` is never used"
        });
        断言!(是主函数提示(&从未使用, "file:///v/main.rs"));
        // 反例 1：同文案但错误级——严重级闸必须拦住，不得静默吞掉真错
        让 作为错误 = JSON序列化::JSON格式!({
            "severity": 1,
            "message": "function `main` is never used"
        });
        断言!(!是主函数提示(&作为错误, "file:///v/main.rs"));
        // 反例 2：无关的 never-used 提示（其它函数）必须保留
        让 其它值 = JSON序列化::JSON格式!({
            "severity": 4,
            "message": "function `helper` is never used"
        });
        断言!(!是主函数提示(&其它值, "file:///v/main.rs"));
        // 反例 3：无严重级字段不视为提示
        断言!(!是主函数提示(
            &JSON序列化::JSON格式!({ "message": "function `main` is never used" }),
            ""
        ));
    }

    /// 正例：过程宏未展开的辅助属性与派生宏缺失被过滤；
    /// 反例：未解析导入与找不到模块不过滤（"添加依赖"快速修复
    /// 的输入，且真实缺依赖时同样出现）
    #[测试]
    函数 缺依赖噪音对偶() {
        断言!(是缺依赖噪音(
            &JSON序列化::JSON格式!({ "message": "cannot find attribute `arg` in this scope" })
        ));
        断言!(是缺依赖噪音(
            &JSON序列化::JSON格式!({ "message": "cannot find derive macro `Parser` in this scope" })
        ));
        // 反例：用户真写错了宏名——必须保留
        断言!(!是缺依赖噪音(
            &JSON序列化::JSON格式!({ "message": "cannot find macro `prinln` in this scope" })
        ));
        // 反例：未解析导入走缺项目依赖精细判定，
        // 不在本过滤器一刀切（行为钉住，防将来误扩此处的匹配面）
        断言!(!是缺依赖噪音(
            &JSON序列化::JSON格式!({ "message": "unresolved import `serde`" })
        ));
    }

    /// 候选名提取：四种消息格式 × 防御性拒绝（保留字/路径穿越/畸形段）
    #[测试]
    函数 未打开模块名解析() {
        // 四种已知 RA/rustc 消息格式（0.3.3025 前后两代）
        断言相等!(
            未打开模块名("cannot find module or crate `日志设置` in this scope"),
            有值("日志设置")
        );
        断言相等!(
            未打开模块名("cannot find `日志设置` in `crate`"),
            有值("日志设置")
        );
        断言相等!(
            未打开模块名("unresolved import `crate::日志设置::初始化`"),
            有值("日志设置")
        );
        断言相等!(
            未打开模块名("no `日志设置` in the root"),
            有值("日志设置")
        );
        // 保留字/系统包不可能是本地模块
        断言相等!(未打开模块名("cannot find `std` in `crate`"), 无);
        断言相等!(未打开模块名("no `core` in the root"), 无);
        // 路径穿越防御：含 / \ .. 的段一律拒绝
        断言相等!(
            未打开模块名("unresolved import `crate/../秘密`"),
            无
        );
        断言相等!(未打开模块名("cannot find `a/b` in `crate`"), 无);
        // 未知消息格式不强行解释（宁漏滤不误杀）
        断言相等!(
            未打开模块名("expected one of `::`, found keyword`fn`"),
            无
        );
        // 非包后缀的“在……找不到 X”不命中
        断言相等!(未打开模块名("cannot find `foo` in `self`"), 无);
    }

    /// 正例：同目录存在同名方言文件 → "模块未打开"误报被滤；
    /// 反例：文件确实不存在（真拼错）→ 诊断保留供用户修正
    #[测试]
    函数 未打开模块引用对偶() {
        让 临时目录 = 临时文件::建临时目录().解包();
        让 主程序路径 = 临时目录.条目路径().连接("主程序.zh");
        标准库::文件系统::写入(&主程序路径, "").解包();
        标准库::文件系统::写入(临时目录.条目路径().连接("日志设置.zh"), "").解包();
        让 条目值 = 构造条目(主程序路径.克隆值());
        让 构造诊断 = |消息: &文本| JSON序列化::JSON格式!({ "message": 消息, "severity": 1 });

        // 正例：模块文件存在但未打开
        断言!(是未打开模块引用(
            &构造诊断("cannot find module or crate `日志设置` in this scope"),
            有值(&条目值)
        ));
        断言!(是未打开模块引用(
            &构造诊断("unresolved import `crate::日志设置`"),
            有值(&条目值)
        ));
        // 反例 1：目标文件不存在（真错误）——必须保留
        断言!(!是未打开模块引用(
            &构造诊断("cannot find module or crate `日志设置2` in this scope"),
            有值(&条目值)
        ));
        // 反例 2：同名词是 .rs 而非 .zh（扩展名隔离，不以其它类型文件为准）
        标准库::文件系统::写入(临时目录.条目路径().连接("工具.rs"), "").解包();
        断言!(!是未打开模块引用(
            &构造诊断("cannot find module or crate `工具` in this scope"),
            有值(&条目值)
        ));
        // 反例 3：无缓存条目（非代理托管文件）不过滤
        断言!(!是未打开模块引用(
            &构造诊断("cannot find module or crate `日志设置` in this scope"),
            无
        ));
    }

    /// 正例：候选包名在用户 Cargo.toml 依赖表 → 虚拟项目缺失误报被滤；
    /// 反例：不在依赖表（真拼错/真没加依赖）→ 保留并继续给 rzc 添加依赖提示
    #[测试]
    函数 缺项目依赖对偶() {
        让 临时目录 = 临时文件::建临时目录().解包();
        标准库::文件系统::写入(
            临时目录.条目路径().连接("Cargo.toml"),
            "[dependencies]\nserde = \"1\"\nserde_json = \"1\"\n",
        )
        .解包();
        让 主程序路径 = 临时目录.条目路径().连接("主程序.zh");
        标准库::文件系统::写入(&主程序路径, "").解包();
        让 条目值 = 构造条目(主程序路径.克隆值());
        让 构造诊断 = |消息: &文本| JSON序列化::JSON格式!({ "message": 消息, "severity": 1 });

        // 正例：已声明依赖在虚拟项目缺失
        断言!(是缺项目依赖(
            &构造诊断("unresolved import `serde`"),
            有值(&条目值)
        ));
        断言!(是缺项目依赖(
            &构造诊断("use of undeclared crate or module `serde_json`"),
            有值(&条目值)
        ));
        // 反例 1：不在依赖表的名字是真错误，必须保留
        断言!(!是缺项目依赖(
            &构造诊断("unresolved import `serde_mistyped`"),
            有值(&条目值)
        ));
        // 反例 2：非导入类消息不碰（即使含同名反引号段）
        断言!(!是缺项目依赖(
            &构造诊断("no function or associated item named `serde` found"),
            有值(&条目值)
        ));
        // 反例 3：无 Cargo.toml 可寻（隔离目录上层无清单）时保持原样不过滤；
        // 注：本断言依赖临时目录祖先链无 Cargo.toml，系统临时区成立
        让 孤立目录 = 临时文件::建临时目录().解包();
        让 孤立路径 = 孤立目录.条目路径().连接("x.zh");
        标准库::文件系统::写入(&孤立路径, "").解包();
        让 孤立条目 = 构造条目(孤立路径);
        断言!(!是缺项目依赖(
            &构造诊断("unresolved import `serde`"),
            有值(&孤立条目)
        ));
    }

    /// 正例：资源文件在原目录存在（虚拟目录相对路径解析失败）被滤；
    /// 反例：原项目真实缺资源 → 诊断必须保留
    #[测试]
    函数 缺内嵌资源对偶() {
        让 临时目录 = 临时文件::建临时目录().解包();
        让 主程序路径 = 临时目录.条目路径().连接("主程序.zh");
        标准库::文件系统::写入(&主程序路径, "").解包();
        标准库::文件系统::写入(临时目录.条目路径().连接("界面.html"), "<html>").解包();
        让 条目值 = 构造条目(主程序路径);
        让 构造诊断 = |消息: &文本| JSON序列化::JSON格式!({ "message": 消息, "severity": 1 });

        // 正例：虚拟根源目录前缀与无前缀两种形态
        断言!(是缺内嵌资源(
            &构造诊断("couldn't read `src/界面.html`: 系统找不到指定的文件。 (os error 2)"),
            有值(&条目值)
        ));
        断言!(是缺内嵌资源(
            &构造诊断("couldn't read `界面.html`: No such file or directory (os error 2)"),
            有值(&条目值)
        ));
        // 反例 1：原目录也没有该资源——真错误，必须保留
        断言!(!是缺内嵌资源(
            &构造诊断("couldn't read `src/不存在.html`: No such file or directory"),
            有值(&条目值)
        ));
        // 反例 2：路径穿越防御
        断言!(!是缺内嵌资源(
            &构造诊断("couldn't read `../界面.html`"),
            有值(&条目值)
        ));
        // 反例 3：非“无法读取”格式不命中
        断言!(!是缺内嵌资源(
            &构造诊断("file not found: 界面.html"),
            有值(&条目值)
        ));
    }
}
