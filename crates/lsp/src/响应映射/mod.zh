//! 响应映射模块
//!
//! 将 rust-analyzer 响应中的位置信息（指向虚拟 .rs 文件）
//! 还原为原始 .zh 文件的位置。同时处理诊断信息的中文翻译。
//!
//! 子模块划分：
//! - [`响应`]：各 LSP 请求类型的响应映射（悬停/补全/符号/编辑等）
//! - [`诊断文本`]：诊断消息翻译与所有权详情提取（CLI 同源消息表）
//!
//! 本文件保留映射基础设施：资源标识/行/列还原、编辑映射与反向转译。

#[路径属性 = "诊断文本.rs"]
公开(包) 模块 诊断文本;
模块 响应;

#[配置(测试)]
#[路径属性 = "测试.rs"]
模块 母语测试;

公开 使用 诊断文本::初始化诊断翻译器;

使用 标准库::同步::原子引用计数;

使用 JSON序列化::JSON值;

使用 包::翻译缓存::{翻译条目, 英文列转母语列, 转译缓存};

/// 响应映射器
///
/// 持有翻译缓存的引用，负责将 rust-analyzer 的各种响应
/// 中的位置/资源标识从虚拟文件还原到原始中文文件。
公开 结构体 响应映射器 {
    缓存: 原子引用计数<转译缓存>,
    /// 预构建的反向映射表（英文 → 母语），常数时间查找且结果确定
    反向映射: 标准库::集合::哈希映射<字符串, 字符串>,
    /// 是否启用补全语言过滤（禁止串语言）
    ///
    /// 方言关键字与英文存在差异时启用（zh/ja/ru 等）；
    /// 英文包为恒等映射（关键字与英文相同），不过滤。
    严格母语过滤: 布尔,
}

实现 响应映射器 {
    /// 创建新的响应映射器
    ///
    /// 反向表直接复用 转译缓存 构造时预构建的合并表
    /// （关键字反转后合并别名反转，多对一冲突保留排序最小者，
    /// 结果确定），避免每次构造映射器重复构建。
    公开 函数 新建(缓存: 原子引用计数<转译缓存>) -> 自身 {
        // 英文语言包为恒等映射（键等于值），无需也无法做语言过滤
        让 严格母语过滤 = 缓存
            .关键词映射()
            .迭代()
            .任意(|(母语词形, 英文词形)| 母语词形 != 英文词形);
        自身 {
            反向映射: 缓存.反向映射引用().克隆值(),
            缓存,
            严格母语过滤,
        }
    }

    /// 判断一个资源标识是否指向我们的虚拟文件
    公开 函数 是虚拟资源标识(&自我, 资源标识: &文本) -> 布尔 {
        自我.缓存.按虚拟资源标识查询(资源标识).是否为有值()
    }

    /// 按方言资源标识查询翻译条目（全角标点教学诊断合并等场景）
    公开 函数 原始条目(&自我, 资源标识: &文本) -> 选项<原子引用计数<翻译条目>> {
        自我.缓存.查询原始(资源标识)
    }

    /// 获取教学检查已知词表（转发 转译缓存，易混方法名提示用）
    公开 函数 教学词表(&自我) -> &标准库::集合::哈希集合<字符串> {
        自我.缓存.校验词表()
    }

    /// 获取教学检查的分桶索引（转发 转译缓存，
    /// 教学诊断发布路径的一次扫描入口用，索引随语言包缓存一次）
    公开 函数 教学词分桶(&自我) -> &引擎库::校验::词形分桶 {
        自我.缓存.校验词分桶()
    }

    /// 获取映射管理器的共享句柄（cargo 检查线程跨线程取词表用）
    公开 函数 管理器共享(&自我) -> 原子引用计数<引擎库::映射管理器::映射管理器> {
        自我.缓存.管理器共享句柄()
    }

    /// 获取教学检查歧义构造器词集（转发 转译缓存，
    /// 「未标注类型」仅提示无法自行推导的新建/缺省/收集形态）
    公开 函数 歧义构造器词集(&自我) -> &标准库::集合::哈希集合<字符串> {
        自我.缓存.歧义构造器词()
    }

    /// 获取英文回落检查反向索引（转发 转译缓存，
    /// 方言源码里写成英文且有母语词条的结构词提示用）
    公开 函数 英文回落映射(&自我) -> &标准库::集合::哈希映射<字符串, 字符串> {
        自我.缓存.英文回落映射()
    }

    /// 获取关键字映射表（转发 转译缓存，
    /// 保留字撞名提示：声明名字转译后是否为 Rust 保留字）
    公开 函数 关键词映射(&自我) -> &标准库::集合::哈希映射<字符串, 字符串> {
        自我.缓存.关键词映射()
    }

    /// 将虚拟资源标识替换为原始资源标识
    公开 函数 还原资源标识(&自我, 资源标识: &文本) -> 字符串 {
        如果让 有值(条目值) = 自我.缓存.按虚拟资源标识查询(资源标识) {
            条目值.原始资源标识.克隆值()
        } 否则 {
            资源标识.转字符串()
        }
    }

    /// 预取条目后映射一个 LSP 范围值（无锁纯函数）
    ///
    /// 循环场景（诊断/定义/引用等批量映射）由调用方预取条目一次，
    /// 复用同一文档的列映射，避免每条范围值重复加锁查询缓存。
    公开(超级) 函数 带条目还原范围(
        条目值: 选项<&翻译条目>,
        范围值: &JSON值,
    ) -> JSON值 {
        让 映射位置 = |行号: 无符号整数, 列号: 无符号整数| -> (无符号整数, 无符号整数) {
            匹配 条目值 {
                有值(条目) => (
                    还原单行(条目, 行号),
                    英文列转母语列(条目, 行号, 列号),
                ),
                无 => (行号, 列号),
            }
        };
        让 起始行 = 范围值["start"]["line"].作为长整数().取值或(0) 作为 无符号整数;
        让 起始列 = 范围值["start"]["character"].作为长整数().取值或(0) 作为 无符号整数;
        让 结束行 = 范围值["end"]["line"].作为长整数().取值或(0) 作为 无符号整数;
        让 结束列 = 范围值["end"]["character"].作为长整数().取值或(0) 作为 无符号整数;

        让 (母语起始行, 母语起始列) = 映射位置(起始行, 起始列);
        让 (母语结束行, 母语结束列) = 映射位置(结束行, 结束列);

        JSON序列化::JSON格式!({
            "start": { "line": 母语起始行, "character": 母语起始列 },
            "end": { "line": 母语结束行, "character": 母语结束列 }
        })
    }

    /// 映射一个 LSP 范围值
    公开 函数 还原范围(&自我, 资源标识: &文本, 范围值: &JSON值) -> JSON值 {
        // 预取翻译条目一次：起点/终点列映射基于同一文档，一次查询后
        // 走无锁纯函数，避免每处范围值重复锁（诊断/高亮/符号/编辑
        // 每处 2 次还原位置，每次内部 2-4 次锁获取）
        让 条目值 = 自我
            .缓存
            .按虚拟资源标识查询(资源标识)
            .或用否则(|| 自我.缓存.查询原始(资源标识));
        自身::带条目还原范围(条目值.作为解引用(), 范围值)
    }

    /// 预取条目后映射一个 LSP 位置值（无锁纯函数）
    ///
    /// 资源标识还原与范围值映射共用同一预取条目；循环场景（诊断的
    /// 关联信息、定义/引用批量映射）由调用方预取避免重复加锁。
    公开(超级) 函数 带条目还原位置(
        条目值: 选项<&翻译条目>,
        虚拟资源标识: &文本,
        位置值: &JSON值,
    ) -> JSON值 {
        让 原始资源标识 = 匹配 条目值 {
            有值(条目) => 条目.原始资源标识.克隆值(),
            无 => 虚拟资源标识.转字符串(),
        };
        让 原始范围 = 自身::带条目还原范围(条目值, &位置值["range"]);

        JSON序列化::JSON格式!({
            "uri": 原始资源标识,
            "range": 原始范围
        })
    }

    /// 映射一个 LSP 位置值（资源标识 + 范围值）
    公开 函数 还原位置(&自我, 位置值: &JSON值) -> JSON值 {
        让 虚拟资源标识 = 位置值["uri"].作为字符串().取值或("");
        让 条目值 = 自我
            .缓存
            .按虚拟资源标识查询(虚拟资源标识)
            .或用否则(|| 自我.缓存.查询原始(虚拟资源标识));
        自身::带条目还原位置(条目值.作为解引用(), 虚拟资源标识, 位置值)
    }

    /// 从关键字映射中反向查找：英文 → 中文（预构建表，常数时间）
    公开(超级) 函数 反向查找(&自我, 英文名: &文本) -> 选项<字符串> {
        自我.反向映射.读取条目(英文名).克隆副本()
    }

    /// 将英文代码片段反向翻译为母语
    ///
    /// 精确命中关键字时直接替换；含代码片段占位符（`${}`）的片段
    /// 保持原样（避免破坏占位符结构）；其余交给引擎词法级反向转译。
    公开(超级) 函数 翻译代码(&自我, 文本串: &文本) -> 字符串 {
        如果让 有值(母语词形) = 自我.反向查找(文本串) {
            返回 母语词形;
        }
        如果 文本串.包含("${") {
            返回 文本串.转字符串();
        }
        // 补全片段无文档上下文：不删除任何包路径前缀（宁可保留代理
        // 前缀，也不误删用户手写的前缀——见 转译缓存::反向转译）
        自我.缓存.反向转译(无, 文本串)
    }

    /// 映射一个工作区编辑（变更表与文档变更）
    ///
    /// 编辑目标不是已打开 .zh 的虚拟文件时直接丢弃。
    公开(超级) 函数 映射编辑(&自我, 编辑值: &JSON值, 翻译新文本: 布尔) -> JSON值 {
        让 可变 映射结果 = 编辑值.克隆值();

        // 变更表：{ 资源标识 → [文本编辑] }
        如果让 有值(变更表) = 编辑值.读取条目("changes").而后映射(|值| 值.作为对象()) {
            让 可变 映射后变更 = JSON序列化::JSON映射::新建();
            对于 (资源标识, 编辑列表) 在 变更表 {
                如果 !自我.是虚拟资源标识(资源标识) {
                    继续;
                }
                让 目标资源标识 = 自我.还原资源标识(资源标识);
                让 映射后编辑 = 自我.映射编辑列表(编辑列表, 资源标识, 翻译新文本);
                映射后变更.置入(目标资源标识, 映射后编辑);
            }
            映射结果["changes"] = JSON值::JSON对象(映射后变更);
        }

        // 文档变更： [文本编辑]
        如果让 有值(文档变更) = 编辑值.读取条目("documentChanges").而后映射(|值| 值.作为数组()) {
            让 映射后文档变更: 向量<JSON值> = 文档变更
                .迭代()
                .过滤映射(|项| {
                    让 资源标识 = 项
                        .读取条目("textDocument")
                        .而后映射(|文档| 文档.读取条目("uri"))
                        .而后映射(|值| 值.作为字符串())
                        .取值或("");
                    如果 !自我.是虚拟资源标识(资源标识) {
                        返回 无;
                    }
                    让 可变 映射项 = 项.克隆值();
                    映射项["textDocument"]["uri"] =
                        JSON值::字符串值(自我.还原资源标识(资源标识));
                    如果让 有值(编辑) = 项.读取条目("edits") {
                        映射项["edits"] = 自我.映射编辑列表(编辑, 资源标识, 翻译新文本);
                    }
                    有值(映射项)
                })
                .收集();
            映射结果["documentChanges"] = JSON值::JSON数组(映射后文档变更);
        }

        映射结果
    }

    /// 映射一组文本编辑的位置
    ///
    /// 当 `翻译新文本` 为真时（重命名/代码操作/补全），
    /// 将新文本反向翻译为母语；为假时新文本保持英文。
    公开(超级) 函数 映射编辑列表(
        &自我,
        编辑列表: &JSON值,
        虚拟资源标识: &文本,
        翻译新文本: 布尔,
    ) -> JSON值 {
        让 映射结果: 向量<JSON值> = 编辑列表
            .作为数组()
            .变换(|数组| {
                数组
                    .迭代()
                    .变换(|编辑| {
                        让 可变 映射项 = 编辑.克隆值();
                        如果让 有值(范围值) = 编辑.读取条目("range") {
                            映射项["range"] = 自我.还原范围(虚拟资源标识, 范围值);
                        }
                        如果 翻译新文本
                            && 让 有值(新文本) = 编辑.读取条目("newText").而后映射(|值| 值.作为字符串())
                        {
                            映射项["newText"] = JSON值::字符串值(自我.翻译代码(新文本));
                        }
                        映射项
                    })
                    .收集()
            })
            .取值或默认();
        JSON值::JSON数组(映射结果)
    }
}

/// 根据翻译条目的行映射还原行号
公开(超级) 函数 还原单行(条目值: &翻译条目, 英文行号: 无符号整数) -> 无符号整数 {
    让 下标 = 英文行号 作为 无符号机器整数;
    如果 下标 < 条目值.行映射.元素数() {
        条目值.行映射[下标]
    } 否则 如果让 有值(&末行) = 条目值.行映射.末尾项() {
        末行
    } 否则 {
        英文行号
    }
}
