//! 各 LSP 请求类型的响应映射：诊断、补全、悬停、签名帮助、
//! 引用/定义、重命名、代码操作、文档符号与教学动作注入。

使用 serde_json::{Value, json};

使用 超级::诊断文本::{
    提取所有权详情, 是主函数提示, 是未打开模块引用, 是缺失依赖噪声, 是缺失包含资源, 是缺失项目依赖,
    查找期望实际标签, 翻译诊断消息,
};
使用 超级::响应映射器;
使用 超级::还原单行;
使用 crate::翻译缓存::英文列转中文列;

实现 响应映射器 {
    /// 映射 rust-analyzer 的 publishDiagnostics 通知
    ///
    /// 将诊断信息中的 URI 和位置还原为原始 .zh 文件，
    /// 并尝试翻译诊断消息为中文。
    公开 函数 映射诊断(&自我, 参数集: &Value) -> Value {
        让 虚拟资源定位 = 参数集["uri"].as_str().unwrap_or("");
        // 预取条目一次：所有诊断的 range/relatedInformation 映射基于同一
        // 文档，循环内复用条目走无锁纯函数（诊断通常 10-50 条，避免每条
        // range × 2 锁、每条 relatedInformation × 4 锁）
        让 翻译条目 = 自我
            .缓存
            .按虚拟资源定位查询(虚拟资源定位)
            .or_else(|| 自我.缓存.查询原文(虚拟资源定位));
        让 原始资源定位 = 匹配 &翻译条目 {
            有值(条目项) => 条目项.原始资源定位.clone(),
            无 => 虚拟资源定位.to_string(),
        };
        让 诊断列表 = 参数集["diagnostics"].as_array();

        让 可变 映射诊断列表 = Vec::new();

        如果 让 有值(诊断数组) = 诊断列表 {
            对于 诊断 in 诊断数组 {
                // 过滤虚拟项目 main.rs 中关于 main 函数的 Hint 级提示
                // （fn main() 在模块内不是真正的入口，rust-analyzer 会发出
                // "here is a function named `main`" 等教学无关的提示）
                如果 是主函数提示(诊断, 虚拟资源定位) {
                    继续;
                }
                // 过滤虚拟项目固有的过程宏误报（#3 症状二）：虚拟项目无第三方
                // 依赖且禁用过程宏，clap 等 derive 未展开时的辅助属性
                // （`#[arg(...)]`）与派生宏名字解析必然失败——用户在项目中
                // 构建正常（rzc check 通过），此类诊断恒为误报
                如果 是缺失依赖噪声(诊断) {
                    继续;
                }
                // 过滤“引用未打开模块文件”的 E0433/E0432 误报：虚拟项目只
                // 聚合已打开文件，被引用模块未打开时无法解析（打开后即恢复）；
                // 同名方言文件存在于同目录时判定为误报（覆盖 RA 新旧消息格式）
                如果 是未打开模块引用(诊断, 翻译条目.as_deref()) {
                    继续;
                }
                // 过滤“真实依赖在虚拟项目缺失”的误报：虚拟项目 Cargo.toml
                // 不含用户依赖，serde/serde_json 等已声明依赖的导入必然无法
                // 解析（用户项目中 rzc check 正常通过）
                如果 是缺失项目依赖(诊断, 翻译条目.as_deref()) {
                    继续;
                }
                // 过滤 include_str!/include_bytes! 资源在虚拟项目中缺失的
                // 误报：资源文件在原方言文件同目录存在时，虚拟 .rs 的相对
                // 路径解析失败属虚拟项目固有现象
                如果 是缺失包含资源(诊断, 翻译条目.as_deref()) {
                    继续;
                }

                让 可变 映射结果 = 诊断.clone();

                // 映射范围（使用列映射）
                如果 诊断.get("range").is_some() {
                    映射结果["range"] = 自身::带条目还原范围(翻译条目.as_deref(), &诊断["range"]);
                }

                // 映射 relatedInformation 中的位置
                如果 让 有值(关联信息) =
                    诊断.get("relatedInformation").and_then(|值项| 值项.as_array())
                {
                    让 可变 映射关联 = Vec::new();
                    对于 项 in 关联信息 {
                        让 可变 映射项 = 项.clone();
                        如果 让 有值(位置项) = 项.get("location") {
                            // 同文件位置复用主条目（跨文件才按需查询）
                            让 位置uri = 位置项["uri"].as_str().unwrap_or("");
                            让 位置条目 = 如果 位置uri == 虚拟资源定位 {
                                翻译条目.clone()
                            } 否则 {
                                自我.缓存
                                    .按虚拟资源定位查询(位置uri)
                                    .or_else(|| 自我.缓存.查询原文(位置uri))
                            };
                            映射项["location"] = 自身::带条目还原位置(
                                位置条目.as_deref(),
                                位置uri,
                                位置项,
                            );
                        }
                        // 子消息（help/note）同样翻译——悬停查看诊断详情时
                        // 不泄漏英文（如 "value moved here"、"consider ..."）；
                        // 子消息无独立错误码/标签，走消息表/短语兜底
                        如果 让 有值(消息) = 项.get("message").and_then(|值项| 值项.as_str()) {
                            映射项["message"] =
                                Value::String(翻译诊断消息(无, 消息, 无));
                        }
                        映射关联.push(映射项);
                    }
                    映射结果["relatedInformation"] = Value::Array(映射关联);
                }

                // 翻译诊断主消息（与 CLI 同口径）：传入错误码供码表优先命中；
                // rust-analyzer 把 expected/found 放在 relatedInformation 而非主
                // span 标签，故从 related 归集候选标签回填 {期望}/{实际}（无则自动
                // 回退消息表）
                让 码文本 = 诊断.get("code").and_then(|值项| 值项.as_str());
                让 主标签 = 查找期望实际标签(诊断);
                映射结果["message"] = Value::String(翻译诊断消息(
                    码文本,
                    诊断["message"].as_str().unwrap_or(""),
                    主标签.as_deref(),
                ));

                // 所有权错误：提取叙事化详情并存入 data 字段（供 VS Code 扩展可视化）
                如果 让 有值(详情) = 提取所有权详情(诊断, &映射结果, &原始资源定位)
                    && 让 成功(详情值) = serde_json::to_value(&详情)
                {
                    // 保留 rust-analyzer 已有的 data（如代码操作数据），嵌套存入
                    匹配 映射结果.get_mut("data") {
                        有值(现有值) if 现有值.is_object() => {
                            现有值["所有权详情"] = 详情值;
                        }
                        _ => {
                            映射结果["data"] = 详情值;
                        }
                    }
                }

                // 添加教学提示标记
                映射结果["source"] = Value::String("i18n-rust".to_string());

                映射诊断列表.push(映射结果);
            }
        }

        json!({
            "uri": 原始资源定位,
            "diagnostics": 映射诊断列表,
            "version": 参数集.get("version").cloned().unwrap_or(Value::Null)
        })
    }

    /// 映射补全响应中的位置信息
    ///
    /// 将 textEdit/additionalTextEdits 中的 range 映射回原始文件，
    /// 并将英文标识符/代码反向翻译为母语（否则接受补全会把
    /// 英文关键字插入母语源文件，或自动导入编辑落在错误位置）。
    公开 函数 映射补全响应(&自我, 响应: &Value, 原始资源定位: &文本) -> Value {
        让 可变 响应集 = 响应.clone();

        如果 让 有值(项集合) = 响应集.get("items").and_then(|值项| 值项.as_array()) {
            让 可变 映射项集合 = Vec::new();
            // 语言过滤白名单（用户源码中出现过的标识符）懒加载，
            // 仅在确实遇到未翻译的纯英文项时才扫描一次；
            // Arc 共享避免每次补全请求克隆整个集合
            让 可变 用户词集: 选项<std::sync::Arc<std::collections::HashSet<字符串>>> = 无;
            对于 项 in 项集合 {
                让 可变 映射结果 = 项.clone();

                // 1. 映射 textEdit 的 range 并反向翻译 newText
                如果 让 有值(文本编辑) = 项.get("textEdit") {
                    如果 让 有值(跨度) = 文本编辑.get("range") {
                        映射结果["textEdit"]["range"] = 自我.还原范围(原始资源定位, 跨度);
                    }
                    如果 让 有值(新文本) = 文本编辑.get("newText").and_then(|值项| 值项.as_str()) {
                        映射结果["textEdit"]["newText"] = Value::String(自我.翻译代码(新文本));
                    }
                }

                // 2. additionalTextEdits（如自动导入）：位置与内容同样需要还原
                如果 让 有值(额外编辑) = 项.get("additionalTextEdits") {
                    映射结果["additionalTextEdits"] =
                        自我.映射编辑列表(额外编辑, 原始资源定位, 真);
                }

                // 3. label：先精确反查（关键字等），未命中则词法级转译
                //    （标准库 API 如 Vec::new / println! 也能还原为母语）
                如果 让 有值(标签) = 项.get("label").and_then(|值项| 值项.as_str()) {
                    让 映射标签 =
                        自我.反向查词(标签).unwrap_or_else(|| 自我.翻译代码(标签));

                    // 3.5 语言过滤（禁止串语言）：非英文方言下，补全列表
                    //     只保留母语项，过滤未翻译的外部英文项（第三方库、
                    //     未收录的标准库 API 等）。保留条件（满足其一）：
                    //     a. 翻译命中（mapped_label 与原文不同）；
                    //     b. label 含母语字符（用户定义的母语标识符）；
                    //     c. label 的末段标识符在用户源码中出现过
                    //        （用户自己定义的项，含英文命名）。
                    如果 自我.严格母语过滤 {
                        让 母语字符 = !映射标签.is_ascii();
                        让 已翻译 = 映射标签 != 标签;
                        让 用户自定义 = 如果 母语字符 || 已翻译 {
                            真
                        } 否则 {
                            让 记号集 =
                                用户词集.get_or_insert_with(|| 自我.缓存.用户自定义词元());
                            取标签末段(标签).is_some_and(|名字| 记号集.contains(名字))
                        };
                        如果 !(母语字符 || 已翻译 || 用户自定义) {
                            继续;
                        }
                    }

                    映射结果["label"] = Value::String(映射标签);
                }

                // 4. detail（类型签名）：词法级转译，如 fn push(...) → 函数 推入(...)
                如果 让 有值(详情) = 项.get("detail").and_then(|值项| 值项.as_str()) {
                    映射结果["detail"] = Value::String(自我.翻译代码(详情));
                }

                // 4.5 labelDetails：VS Code 提示框右侧优先显示此字段
                //     （description 为签名如 fn()、detail 为 crate/模块路径），
                //     不还原会把英文 fn() 泄漏给母语用户
                如果 让 有值(标签详情) = 项.get("labelDetails").and_then(|值项| 值项.as_object()) {
                    让 可变 映射详情 = 标签详情.clone();
                    如果 让 有值(描述文本) = 标签详情.get("description").and_then(|值项| 值项.as_str()) {
                        映射详情.insert(
                            "description".to_string(),
                            Value::String(自我.翻译代码(描述文本)),
                        );
                    }
                    如果 让 有值(详情) = 标签详情.get("detail").and_then(|值项| 值项.as_str()) {
                        映射详情
                            .insert("detail".to_string(), Value::String(自我.翻译代码(详情)));
                    }
                    映射结果["labelDetails"] = Value::Object(映射详情);
                }

                // 5. documentation：命中解释表（大白话）时替换为中文，
                //    未命中保留英文原文（避免丢失签名等关键信息）
                如果 让 有值(文档) = 项.get("documentation") {
                    映射结果["documentation"] = 自我.翻译补全文档(项, 文档);
                }

                // 6. 反向映射 insertText（可能含 snippet 占位符，仅精确匹配时替换）
                如果 让 有值(插入文本) = 项.get("insertText").and_then(|值项| 值项.as_str())
                    && 让 有值(中文名) = 自我.反向查词(插入文本)
                {
                    映射结果["insertText"] = Value::String(中文名);
                }

                // 7. 方法/函数补全补括号：rust-analyzer 的 snippet 配置在代理
                //    环境不可靠（方法补全默认不带括号），这里对方法/函数类
                //    补全项在 textEdit 末尾补 snippet 括号，光标自动落在括号内
                //    （教学常用场景如 `长度()`）；已带括号（含参数占位）跳过。
                让 项类型 = 项.get("kind").and_then(|值项| 值项.as_i64()).unwrap_or(0);
                如果 matches!(项类型, 2 | 3)
                    && 让 有值(文本内容) = 映射结果["textEdit"]["newText"].as_str()
                    && !文本内容.contains('(')
                {
                    映射结果["textEdit"]["newText"] = Value::String(格式化!("{}(${{1:}})", 文本内容));
                    // 2 = Snippet 格式：占位符由客户端解析，光标落在括号内
                    映射结果["insertTextFormat"] = Value::Number(2.into());
                }

                // 8. 关键字补全前导空格：rust-analyzer 的 "let mut" 组合 snippet
                //    在代理环境不可用，散落的关键字项（如 `可变`）直接插入会与
                //    前一标识符粘连（`让可变`）。判断 newText 的首个标识符是否
                //    为关键字映射表中的词（不依赖 kind，rust-analyzer 的关键字
                //    补全 kind 不可靠），且前一字符是标识符时在 textEdit 前补空格。
                如果 让 有值(文本内容) = 映射结果["textEdit"]["newText"].as_str() {
                    让 首词 = 文本内容
                        .split(|字符项: 字符| 字符项.is_whitespace() || 字符项 == '$')
                        .next()
                        .unwrap_or("");
                    如果 !首词.is_empty() && 自我.缓存.关键词映射表().contains_key(首词)
                    {
                        让 起点 = 映射结果["textEdit"]["range"]["start"].clone();
                        如果 让 (有值(行号), 有值(列号)) = (
                            起点["line"].as_u64().map(|值项| 值项 as usize),
                            起点["character"].as_u64().map(|值项| 值项 as usize),
                        ) && 列号 > 0
                            && 让 有值(翻译条目) = 自我.缓存.查询原文(原始资源定位)
                            && 让 有值(行文本) = 翻译条目.中文原文.lines().nth(行号)
                        {
                            让 前一字符 = 行文本.chars().nth(列号 - 1);
                            让 需要空格 = 前一字符.is_some_and(|字符项| {
                                !字符项.is_whitespace()
                                    && !matches!(字符项, '(' | '.' | ':' | ',' | ';' | '{' | '[' | '!')
                            });
                            如果 需要空格 && !文本内容.starts_with(字符::is_whitespace) {
                                映射结果["textEdit"]["newText"] = Value::String(格式化!(" {文本内容}"));
                            }
                        }
                    }
                }

                映射项集合.push(映射结果);
            }
            响应集["items"] = Value::Array(映射项集合);
        }

        响应集
    }

    /// 补全文档（documentation）：优先用中文解释表替换英文文档
    ///
    /// 查键顺序：从文档解析类型::方法（如 Option::unwrap）→ label 直查
    /// → 方法名兜底；全部未命中时保留英文原文。
    函数 翻译补全文档(&自我, 项: &Value, 文档: &Value) -> Value {
        让 文档文本 = 匹配 文档 {
            Value::String(文本项) => 有值(文本项.as_str()),
            Value::Object(对象体) => 对象体.get("value").and_then(|值项| 值项.as_str()),
            _ => 无,
        };
        如果 让 有值(文本内容) = 文档文本
            && 让 有值(解释) = 自我.查解释(文本内容)
        {
            返回 Value::String(解释);
        }
        // label 直查 + 方法名兜底
        让 界面 = crate::本地化::全局();
        如果 让 有值(标签) = 项.get("label").and_then(|值项| 值项.as_str())
            && 让 有值(解释) = 界面.取解释(标签)
        {
            返回 Value::String(解释.to_string());
        }
        如果 让 有值(文本内容) = 文档文本
            && 让 有值(名字) = 提取函数名(文本内容)
            && 让 有值(解释) = 界面.取解释(&名字)
        {
            返回 Value::String(解释.to_string());
        }
        文档.clone()
    }

    /// 映射文档高亮响应（documentHighlight）
    公开 函数 映射文档高亮响应(&自我, 响应: &Value, 原始资源定位: &文本) -> Value {
        匹配 响应 {
            Value::Array(项集合) => {
                让 映射集合 = 项集合
                    .iter()
                    .map(|项| {
                        让 可变 映射项 = 项.clone();
                        如果 让 有值(跨度) = 项.get("range") {
                            映射项["range"] = 自我.还原范围(原始资源定位, 跨度);
                        }
                        映射项
                    })
                    .collect();
                Value::Array(映射集合)
            }
            Value::Null => Value::Array(Vec::new()),
            _ => 响应.clone(),
        }
    }

    /// 映射语义着色响应（semanticTokens/full、semanticTokens/range）
    ///
    /// rust-analyzer 返回的 token 坐标基于虚拟 .rs（转译产物），
    /// 必须还原到方言文件坐标，否则变量/参数等颜色落在错误位置
    /// 或完全不显示。data 为 LSP delta 编码（每 5 项一组）：
    /// `[deltaLine, deltaStart, length, tokenType, tokenModifiers]`——
    /// 先还原为绝对坐标，逐 token 映射起点与终点列，再重新 delta 编码。
    /// resultId 原样透传（客户端依赖它做增量请求）。
    公开 函数 映射语义记号响应(&自我, 响应: &Value, 原始资源定位: &文本) -> Value {
        让 可变 映射结果 = 响应.clone();
        让 有值(记号数据) = 映射结果.get("data").and_then(|值项| 值项.as_array()) 否则 {
            返回 映射结果;
        };

        // 预取翻译条目：每个 token 的列映射都基于同一文档，
        // 只查一次（O(1) 索引），避免每个 token 重复锁与表扫描
        让 翻译条目 = 自我
            .缓存
            .按虚拟资源定位查询(原始资源定位)
            .or_else(|| 自我.缓存.查询原文(原始资源定位));
        // 无条目（异常 URI）时位置原样透传
        让 映射位置 = |行号: u32, 列号: u32| -> (u32, u32) {
            匹配 &翻译条目 {
                有值(条目项) => {
                    让 中文行 = 还原单行(条目项, 行号);
                    让 中文列 = 英文列转中文列(条目项, 行号, 列号);
                    (中文行, 中文列)
                }
                无 => (行号, 列号),
            }
        };

        // 1. delta 编码 → 绝对坐标（跨行时列归零重置，同行时列累加）
        让 可变 记号列表: Vec<(u32, u32, u32, u32, u32)> = Vec::new();
        让 可变 行号 = 0u32;
        让 可变 列号 = 0u32;
        对于 记号组 in 记号数据.chunks(5) {
            如果 记号组.len() < 5 {
                中断;
            }
            让 增量行 = 记号组[0].as_u64().unwrap_or(0) as u32;
            让 增量列 = 记号组[1].as_u64().unwrap_or(0) as u32;
            让 记号长 = 记号组[2].as_u64().unwrap_or(0) as u32;
            让 记号类型 = 记号组[3].as_u64().unwrap_or(0) as u32;
            让 修饰符 = 记号组[4].as_u64().unwrap_or(0) as u32;
            行号 = 行号.saturating_add(增量行);
            列号 = 如果 增量行 == 0 {
                列号.saturating_add(增量列)
            } 否则 {
                增量列
            };
            记号列表.push((行号, 列号, 记号长, 记号类型, 修饰符));
        }

        // 2. 起点/终点列分别还原到方言坐标，长度取映射后的差值
        //（关键字替换改变了列宽，如 `让`(1) → `let`(3)，长度必须重算）
        // 修饰符强制清零：教学场景以类型色为准，修饰符信息放弃。
        让 可变 映射记号: Vec<(u32, u32, u32, u32, u32)> = Vec::new();
        对于 (原始行, 原始列, 原始长, 原始类型, _) in 记号列表 {
            让 (中文行, 中文起始) = 映射位置(原始行, 原始列);
            让 (_, 中文结束) = 映射位置(原始行, 原始列.saturating_add(原始长));
            让 中文长 = 中文结束.saturating_sub(中文起始).max(1);
            映射记号.push((中文行, 中文起始, 中文长, 原始类型, 0));
        }

        // 3. 重新 delta 编码
        让 可变 新记号数据 = Vec::with_capacity(映射记号.len() * 5);
        让 可变 前行 = 0u32;
        让 可变 前列 = 0u32;
        对于 (记号行, 记号列, 记号长, 记号类型, 记号修饰) in 映射记号 {
            让 增量行 = 记号行.saturating_sub(前行);
            让 增量列 = 如果 增量行 == 0 {
                记号列.saturating_sub(前列)
            } 否则 {
                记号列
            };
            新记号数据.push(json!(增量行));
            新记号数据.push(json!(增量列));
            新记号数据.push(json!(记号长));
            新记号数据.push(json!(记号类型));
            新记号数据.push(json!(记号修饰));
            前行 = 记号行;
            前列 = 记号列;
        }
        映射结果["data"] = Value::Array(新记号数据);
        映射结果
    }

    /// 映射定义跳转响应（Location 或 Location[]）
    公开 函数 映射定义响应(&自我, 响应: &Value) -> Value {
        匹配 响应 {
            Value::Null => Value::Null,
            Value::Array(列表) => {
                让 映射集合 = 列表.iter().map(|项| 自我.还原位置(项)).collect();
                Value::Array(映射集合)
            }
            Value::Object(_) => {
                // 单个 Location
                自我.还原位置(响应)
            }
            _ => 响应.clone(),
        }
    }

    /// 映射悬停响应中的位置信息
    ///
    /// range 字段映射回原始文件位置；contents 命中语言包 ["解释"] 表时
    /// 在文档上方插入一行加粗大白话提示（未命中保持原样透传）。
    公开 函数 映射悬停响应(&自我, 响应: &Value, 原始资源定位: &文本) -> Value {
        让 可变 映射结果 = 响应.clone();
        如果 让 有值(跨度) = 响应.get("range") {
            映射结果["range"] = 自我.还原范围(原始资源定位, 跨度);
        }
        如果 让 有值(正文) = 响应.get("contents") {
            映射结果["contents"] = 自我.丰富悬停内容(正文);
        }
        映射结果
    }

    /// 映射签名帮助响应
    ///
    /// 签名 label（如 `fn push(&mut self, value: T)`）与参数 label 做词法级
    /// 中文化（`fn` → `函数` 等）；参数 label 为 [start, end] 索引形式时按
    /// 原 label 提取文本翻译后转为字符串形式。
    公开 函数 映射签名帮助响应(&自我, 响应: &Value) -> Value {
        让 可变 映射结果 = 响应.clone();
        让 有值(签名列表) = 映射结果.get("signatures").and_then(|值项| 值项.as_array()) 否则 {
            返回 映射结果;
        };
        让 映射集合 = 签名列表
            .iter()
            .map(|签名项| {
                让 可变 映射签名项 = 签名项.clone();
                让 有值(标签) = 签名项.get("label").and_then(|值项| 值项.as_str()) 否则 {
                    返回 映射签名项;
                };
                让 映射标签 = 自我.翻译代码(标签);
                如果 让 有值(参数列表) = 签名项.get("parameters").and_then(|值项| 值项.as_array()) {
                    让 映射参数集 = 参数列表
                        .iter()
                        .map(|参数项| {
                            让 可变 映射参数项 = 参数项.clone();
                            如果 让 有值(跨度) = 参数项.get("label").and_then(|值项| 值项.as_array()) {
                                // [start, end] 索引：原 label 为英文（ASCII），
                                // UTF-16 索引 == 字节索引，可直接切片
                                如果 让 (有值(起始), 有值(结束)) = (跨度[0].as_i64(), 跨度[1].as_i64())
                                    && 让 有值(参数文本) = 标签.get(起始 as usize..结束 as usize)
                                {
                                    映射参数项["label"] =
                                        Value::String(自我.翻译代码(参数文本));
                                }
                            } 否则 如果 让 有值(参数标签) =
                                参数项.get("label").and_then(|值项| 值项.as_str())
                            {
                                映射参数项["label"] = Value::String(自我.翻译代码(参数标签));
                            }
                            映射参数项
                        })
                        .collect();
                    映射签名项["parameters"] = Value::Array(映射参数集);
                }
                映射签名项["label"] = Value::String(映射标签);
                映射签名项
            })
            .collect();
        映射结果["signatures"] = Value::Array(映射集合);
        映射结果
    }

    /// 给 hover contents 前置大白话提示（MarkupContent / MarkedString / 数组）
    函数 丰富悬停内容(&自我, 正文: &Value) -> Value {
        匹配 正文 {
            // MarkupContent：{"kind": "markdown", "value": ...}
            Value::Object(对象体)
                if 对象体.get("kind").and_then(|值项| 值项.as_str()) == 有值("markdown")
                    && 对象体.get("value").and_then(|值项| 值项.as_str()).is_some() =>
            {
                让 可变 映射对象 = 对象体.clone();
                让 值文本 = 对象体.get("value").and_then(|值项| 值项.as_str()).unwrap_or("");
                映射对象["value"] = Value::String(自我.命中则前置(值文本));
                Value::Object(映射对象)
            }
            // MarkedString：{"language": "rust", "value": 代码签名}
            Value::Object(对象体)
                if 对象体.get("language").is_some()
                    && 对象体.get("value").and_then(|值项| 值项.as_str()).is_some() =>
            {
                让 可变 映射对象 = 对象体.clone();
                让 值文本 = 对象体.get("value").and_then(|值项| 值项.as_str()).unwrap_or("");
                让 加提示后 = 自我.命中则前置(值文本);
                映射对象["value"] = Value::String(自我.翻译代码(&加提示后));
                Value::Object(映射对象)
            }
            Value::String(文档文本) => Value::String(自我.命中则前置(文档文本)),
            Value::Array(项集合) => Value::Array(
                项集合
                    .iter()
                    .map(|项| 自我.丰富悬停内容(项))
                    .collect(),
            ),
            _ => 正文.clone(),
        }
    }

    /// 命中解释表时在文档上方插入加粗大白话行，否则原样返回
    函数 命中则前置(&自我, 文档: &文本) -> 字符串 {
        匹配 自我.查解释(文档) {
            有值(提示) => 格式化!("**大白话：{}**\n\n{}", 提示, 文档),
            无 => 文档.to_string(),
        }
    }

    /// 从 hover 文档提取候选解释键并查表（完整路径 → 类型::方法 → 方法名）
    函数 查解释(&自我, 文档: &文本) -> 选项<字符串> {
        让 (类型名, 代码行) = 提取悬停部分(文档);
        让 可变 键列表: Vec<字符串> = Vec::new();
        如果 让 有值(行文本) = 代码行 {
            // 1. 完整路径形式（如 std::option::Option<T>::unwrap），清洗泛型参数
            如果 行文本.contains("::") && !行文本.contains("fn ") {
                让 净路径 = 清理路径段(&行文本);
                如果 净路径.len() >= 2 {
                    键列表.push(净路径.join("::"));
                    // 降级匹配末两段（如 Option::unwrap），兼容短路径键数据
                    如果 净路径.len() > 2 {
                        键列表.push(净路径[净路径.len() - 2..].join("::"));
                    }
                }
            }
            // 2. 类型::方法（短路径，如 Option::unwrap）+ 3. 方法名兜底
            如果 让 有值(名字) = 提取函数名(&行文本) {
                如果 让 有值(类型捕获) = &类型名 {
                    键列表.push(格式化!("{}::{}", 类型捕获, 名字));
                }
                如果 !键列表.iter().any(|键名项| 键名项 == &名字) {
                    键列表.push(名字);
                }
            }
        }
        让 界面 = crate::本地化::全局();
        键列表.iter().find_map(|键名项| 界面.取解释(键名项).map(str::to_string))
    }

    /// 映射引用响应
    ///
    /// 引用响应是 Location[]；无结果时为 null，统一转为空数组。
    公开 函数 映射引用响应(&自我, 响应: &Value) -> Value {
        匹配 响应 {
            Value::Null => Value::Array(Vec::new()),
            _ => 自我.映射定义响应(响应), // 与定义跳转格式相同
        }
    }

    /// 映射重命名响应
    ///
    /// 处理跨文件重命名：changes（uri → [TextEdit]）与 documentChanges；
    /// 将每个编辑的 range 映射回原始文件，并将 newText 反向翻译为母语。
    /// 编辑目标不是已打开 .zh 的虚拟文件时直接丢弃。
    公开 函数 映射重命名响应(&自我, 响应: &Value) -> Value {
        让 可变 映射结果 = 响应.clone();

        // 1. 处理 changes 形式
        如果 让 有值(变更表) = 响应.get("changes").and_then(|值项| 值项.as_object()) {
            让 可变 映射变更 = serde_json::Map::new();
            对于 (资源定位, 编辑列表) in 变更表 {
                如果 !自我.是虚拟资源定位(资源定位) {
                    继续;
                }
                让 目标资源定位 = 自我.还原资源定位(资源定位);
                让 映射后编辑 = 自我.映射编辑列表(编辑列表, 资源定位, 真);
                映射变更.insert(目标资源定位, 映射后编辑);
            }
            映射结果["changes"] = Value::Object(映射变更);
        }

        // 2. 处理 documentChanges 形式
        如果 让 有值(文档变更列表) = 响应.get("documentChanges").and_then(|值项| 值项.as_array()) {
            让 映射文档变更 = 文档变更列表
                .iter()
                .filter_map(|项| {
                    让 资源定位 = 项
                        .get("textDocument")
                        .and_then(|文本文档| 文本文档.get("uri"))
                        .and_then(|值项| 值项.as_str())
                        .unwrap_or("");
                    如果 !自我.是虚拟资源定位(资源定位) {
                        返回 无;
                    }
                    让 可变 映射项 = 项.clone();
                    映射项["textDocument"]["uri"] = Value::String(自我.还原资源定位(资源定位));
                    如果 让 有值(编辑列表) = 项.get("edits") {
                        映射项["edits"] = 自我.映射编辑列表(编辑列表, 资源定位, 真);
                    }
                    有值(映射项)
                })
                .collect();
            映射结果["documentChanges"] = Value::Array(映射文档变更);
        }

        映射结果
    }

    /// 映射代码操作响应
    ///
    /// 将编辑位置映射回原始文件，插入的英文代码反向翻译为母语。
    公开 函数 映射代码操作响应(&自我, 响应: &Value, _原始uri: &文本) -> Value {
        匹配 响应 {
            Value::Array(动作列表) => {
                让 映射动作列表 = 动作列表
                    .iter()
                    .map(|动作| {
                        让 可变 映射项 = 动作.clone();
                        如果 让 有值(编辑) = 动作.get("edit") {
                            映射项["edit"] = 自我.映射编辑(编辑, 真);
                        }
                        映射项
                    })
                    .collect();
                Value::Array(映射动作列表)
            }
            Value::Null => Value::Array(Vec::new()),
            _ => 响应.clone(),
        }
    }

    /// 映射代码操作解析（codeAction/resolve）响应
    ///
    /// resolve 响应是单个 CodeAction 对象（非数组）。
    公开 函数 映射代码操作解析响应(&自我, 响应: &Value) -> Value {
        匹配 响应 {
            Value::Object(_) => {
                让 可变 映射项 = 响应.clone();
                如果 让 有值(编辑) = 响应.get("edit") {
                    映射项["edit"] = 自我.映射编辑(编辑, 真);
                }
                映射项
            }
            _ => 响应.clone(),
        }
    }

    /// 注入“添加依赖”快捷修复：未解析导入错误时提供一键 cargo add
    公开 函数 注入添加依赖动作(&自我, 响应: &Value, 依赖集: &[字符串]) -> Value {
        如果 依赖集.is_empty() {
            返回 响应.clone();
        }
        让 可变 动作列表 = 匹配 响应 {
            Value::Array(列表) => 列表.clone(),
            _ => Vec::new(),
        };
        对于 依赖名 in 依赖集 {
            // 英文 crate 名反查母语别名（关键字/别名表），未命中保持原名
            让 显示名 = 自我
                .反向查词(依赖名)
                .unwrap_or_else(|| 依赖名.clone());
            让 标题 = crate::本地化::全局().取文带参("lsp_action_add_dependency", &[&显示名]);
            动作列表.push(json!({
                "title": 标题,
                "kind": "quickfix",
                "command": {
                    "title": 标题,
                    "command": "i18n-rust.cargoAdd",
                    "arguments": [依赖名]
                }
            }));
        }
        Value::Array(动作列表)
    }

    /// 注入教学诊断的快捷修复：全角标点一键替换半角、教学 lint 忽略此行
    公开 函数 注入教学动作(
        &自我,
        响应: &Value,
        教学诊断集: &[Value],
        原始资源定位: &文本,
    ) -> Value {
        如果 教学诊断集.is_empty() {
            返回 响应.clone();
        }
        让 可变 动作列表 = 匹配 响应 {
            Value::Array(列表) => 列表.clone(),
            _ => Vec::new(),
        };
        让 界面 = crate::本地化::全局();
        对于 诊断 in 教学诊断集 {
            让 诊断码 = 诊断["code"].as_str().unwrap_or("");
            如果 诊断码 == "fullwidth" {
                // 全角标点：可修复时提供替换动作；仅提示字符（顿号等）无动作
                让 有值(替换文本) = 诊断["data"]["replacement"].as_str().map(|文本项| 文本项.to_string()) 否则 {
                    继续;
                };
                让 标点字符 = 诊断["data"]["character"].as_str().unwrap_or("").to_string();
                让 跨度 = 诊断["range"].clone();
                让 标题 =
                    界面.取文带参("lsp_action_fix_fullwidth", &[&标点字符, &替换文本]);
                动作列表.push(json!({
                    "title": 标题,
                    "kind": "quickfix",
                    "diagnostics": [诊断],
                    "edit": {
                        "changes": {
                            原始资源定位: [{
                                "range": 跨度,
                                "newText": 替换文本
                            }]
                        }
                    }
                }));
            } 否则 如果 诊断码.starts_with("lint-") {
                // 教学 lint：行尾插入忽略标记（教师标注故意不修的示例）
                让 有值(行号) = 诊断["range"]["start"]["line"].as_u64() 否则 {
                    继续;
                };
                让 有值(翻译条目) = 自我.按原始取条目(原始资源定位) 否则 {
                    继续;
                };
                让 行尾 = 自身::行尾utf16(&翻译条目.中文原文, 行号 as usize);
                让 跨度 = json!({
                    "start": { "line": 行号, "character": 行尾 },
                    "end": { "line": 行号, "character": 行尾 }
                });
                让 标题 = 界面.取文("lsp_action_ignore_lint");
                动作列表.push(json!({
                    "title": 标题,
                    "kind": "quickfix",
                    "diagnostics": [诊断],
                    "edit": {
                        "changes": {
                            原始资源定位: [{
                                "range": 跨度,
                                "newText": 格式化!("  // {}", i18n_rust_engine::教学检查::教学忽略标记)
                            }]
                        }
                    }
                }));
            }
        }
        Value::Array(动作列表)
    }

    /// 计算指定行（0 起）行尾的 UTF-16 字符偏移；行不存在时回退 0
    函数 行尾utf16(内容: &文本, 行号: usize) -> u32 {
        内容
            .lines()
            .nth(行号)
            .map(|行文本| 行文本.encode_utf16().count() as u32)
            .unwrap_or(0)
    }

    /// 映射文档符号响应
    ///
    /// 将每个符号的 range 和 selectionRange 映射回原始文件，
    /// 并递归处理子符号。
    公开 函数 映射文档符号响应(&自我, 响应: &Value, 原始资源定位: &文本) -> Value {
        匹配 响应 {
            Value::Array(列表) => {
                让 映射集合 = 列表
                    .iter()
                    .map(|符号项| 自我.映射单个符号(符号项, 原始资源定位))
                    .collect();
                Value::Array(映射集合)
            }
            Value::Null => Value::Array(Vec::new()),
            _ => 响应.clone(),
        }
    }

    /// 递归映射单个文档符号
    函数 映射单个符号(&自我, 符号项: &Value, 原始资源定位: &文本) -> Value {
        让 可变 映射项 = 符号项.clone();

        // 将符号名反向恢复为中文（如 main → 主函数）
        如果 让 有值(名字) = 符号项.get("name").and_then(|值项| 值项.as_str())
            && 让 有值(中文名) = 自我.反向查词(名字)
        {
            映射项["name"] = Value::String(中文名);
        }

        如果 让 有值(跨度) = 符号项.get("range") {
            映射项["range"] = 自我.还原范围(原始资源定位, 跨度);
        }
        如果 让 有值(选中范围) = 符号项.get("selectionRange") {
            映射项["selectionRange"] = 自我.还原范围(原始资源定位, 选中范围);
        }
        如果 让 有值(子符号) = 符号项.get("children").and_then(|值项| 值项.as_array()) {
            让 映射子符号 = 子符号
                .iter()
                .map(|符号数据项| 自我.映射单个符号(符号数据项, 原始资源定位))
                .collect();
            映射项["children"] = Value::Array(映射子符号);
        }
        映射项
    }
}

/// 判断字符串是否为合法 Rust 标识符片段（方法名/类型名，不含泛型）
函数 是标识符(名字: &文本) -> 布尔 {
    让 可变 字符集 = 名字.chars();
    matches!(字符集.next(), 有值(字符项) if 字符项 == '_' || 字符项.is_alphabetic())
        && 字符集.all(|字符项| 字符项 == '_' || 字符项.is_alphanumeric())
}

/// 从 hover 文档提取标题类型名与代码块首行
函数 提取悬停部分(文档: &文本) -> (选项<字符串>, 选项<字符串>) {
    让 可变 类型名 = 无;
    让 可变 代码行 = 无;
    让 行集合: Vec<&文本> = 文档.lines().collect();
    对于 (序号, 行文本) in 行集合.iter().enumerate() {
        让 文本项 = 行文本.trim();
        // len >= 4 是切片 `文本项[2..文本项.len() - 2]` 的前置条件（避免 start > end panic）
        如果 类型名.is_none() && 文本项.len() >= 4 && 文本项.starts_with("**") && 文本项.ends_with("**") {
            让 可变 内部文本 = 文本项[2..文本项.len() - 2].replace('`', "");
            内部文本 = 内部文本.trim().to_string();
            让 名字 = 如果 让 有值(剩余) = 内部文本.strip_prefix("impl") {
                // impl<...> X<...> for Y / impl str：跳过泛型段后取第一个标识符
                让 可变 剩余 = 剩余.trim();
                当 剩余.starts_with('<') {
                    让 结束点 = 剩余.find('>').map(|偏移项| 偏移项 + 1).unwrap_or(剩余.len());
                    剩余 = &剩余[结束点..];
                }
                剩余.split('<').next().unwrap_or("").trim().to_string()
            } 否则 {
                // **`Option<T>`** → Option
                内部文本.split('<').next().unwrap_or("").trim().to_string()
            };
            如果 是标识符(&名字) {
                类型名 = 有值(名字);
            }
        }
        如果 代码行.is_none() && 文本项.starts_with("```") {
            对于 子行 in 行集合.iter().skip(序号 + 1) {
                让 净子行 = 子行.trim();
                如果 净子行.is_empty() {
                    继续;
                }
                如果 净子行.starts_with("```") {
                    中断;
                }
                代码行 = 有值(净子行.to_string());
                中断;
            }
        }
        如果 代码行.is_some() {
            中断;
        }
    }
    // MarkedString 纯代码形态（无 ``` 围栏）：整段文本当作代码行
    如果 代码行.is_none() && !文档.lines().any(|行文本| 行文本.trim().starts_with("```")) {
        让 文本项 = 文档.trim();
        如果 !文本项.is_empty() {
            代码行 = 有值(文本项.to_string());
        }
    }
    (类型名, 代码行)
}

/// 把完整路径行清洗为段列表（去掉泛型参数与空白）
函数 清理路径段(路径行: &文本) -> Vec<字符串> {
    路径行
        .split("::")
        .map(|段| 段.split('<').next().unwrap_or("").trim())
        .filter(|文本项| !文本项.is_empty())
        .filter(|文本项| 是标识符(文本项))
        .map(str::to_string)
        .collect()
}

/// 从代码行提取方法名：路径末段、签名或宏
函数 提取函数名(代码行: &文本) -> 选项<字符串> {
    让 行文本 = 代码行.trim();
    如果 行文本.contains("::") {
        如果 让 有值(末段) = 行文本.rsplit("::").next() {
            让 名字 = 末段.split(['(', '<', ' ']).next().unwrap_or("").trim();
            如果 是标识符(名字) {
                返回 有值(名字.to_string());
            }
        }
        返回 无;
    }
    如果 让 有值(索引) = 行文本.find("fn ") {
        让 后段 = &行文本[索引 + 3..];
        让 名字 = 后段.split(['(', '<', ' ']).next().unwrap_or("").trim();
        如果 是标识符(名字) {
            返回 有值(名字.to_string());
        }
    }
    // 宏形式：macro_rules! select
    如果 让 有值(索引) = 行文本.find("macro_rules!") {
        让 后段 = &行文本[索引 + 12..];
        让 名字 = 后段
            .split(['(', '<', ' ', '!'])
            .next()
            .unwrap_or("")
            .trim();
        如果 是标识符(名字) {
            返回 有值(名字.to_string());
        }
    }
    无
}

/// 提取补全 label 的末段标识符
///
/// rust-analyzer 的 label 可能带后缀/路径前缀，此处提取末段标识符
/// 用于用户词汇白名单匹配；label 无标识符段时返回 None。
公开(super) 函数 取标签末段(标签: &文本) -> 选项<&文本> {
    // 去掉形如 `(…)`、`{…}` 的参数/字段后缀
    让 头部 = 标签.split(['(', '{']).next().unwrap_or(标签);
    // 去掉宏感叹号与模块补全的尾部 `::`（如 `m::`）
    让 头部 = 头部.trim().trim_end_matches('!').trim_end_matches("::");
    让 末段 = 头部.rsplit("::").next().unwrap_or("").trim();
    如果 末段.is_empty() { 无 } 否则 { 有值(末段) }
}

#[配置(测试)]
模块 单元测试 {
    使用 超级::*;

    /// 回归：标题行仅为 `**` / `***` 时不得越界切片 panic
    #[测试]
    函数 测试悬停纯星号行不panic() {
        对于 文档 in ["**", "***", "**\n**", "a\n***\nb"] {
            让 (类型名, _) = 提取悬停部分(文档);
            断言!(类型名.is_none(), "纯星号行不应解析出类型名");
        }
    }

    /// 正常标题行仍能提取类型名（含 `impl` 前缀与泛型两种形态）
    #[测试]
    函数 测试悬停类型名提取() {
        让 (类型名, _) = 提取悬停部分("**`Option<T>`**");
        断言相等!(类型名.as_deref(), 有值("Option"));
        让 (类型名, _) = 提取悬停部分("**impl<T> Option<T>**");
        断言相等!(类型名.as_deref(), 有值("Option"));
    }

    /// 构造带缓存文档的 mapper（关键字 + 别名最小集）
    函数 带文档映射器(
        源码: &文本,
    ) -> (
        响应映射器,
        tempfile::TempDir,
        std::sync::Arc<crate::翻译缓存::转译缓存>,
    ) {
        使用 std::collections::HashMap;
        使用 std::sync::Arc;
        让 管理器 = i18n_rust_engine::映射管理::映射管理器::自扁平映射新建(
            HashMap::from([
                ("函数".into(), "fn".into()),
                ("让".into(), "let".into()),
                ("可变".into(), "mut".into()),
            ]),
            HashMap::new(),
            HashMap::from([("长度".into(), "len".into()), ("向量".into(), "Vec".into())]),
        );
        让 临时路径 = tempfile::tempdir().unwrap();
        让 缓存: Arc<crate::翻译缓存::转译缓存> =
            crate::翻译缓存::转译缓存::新建缓存(
                管理器,
                临时路径.path().to_path_buf(),
            );
        缓存
            .更新文档("file:///t/main.zh", 源码, 1)
            .unwrap();
        (响应映射器::新建映射器(缓存.clone()), 临时路径, 缓存)
    }

    /// 补全响应：关键字/方法项母语化；未翻译的第三方英文项被母语过滤丢弃；
    /// 用户自定义英文标识项保留
    #[测试]
    函数 测试映射补全响应完整() {
        让 源码 = "函数 my_func() {\n    unwrap();\n}\n";
        让 (映射器, _临时, _缓存) = 带文档映射器(源码);
        让 虚拟跨度 = json!({
            "start": { "line": 0, "character": 0 },
            "end": { "line": 0, "character": 2 }
        });
        让 关键字项 = json!({
            "label": "fn", "kind": 14,
            "textEdit": { "range": 虚拟跨度, "newText": "fn" },
            "insertText": "fn",
            "detail": "fn item",
            "labelDetails": { "description": "fn()", "detail": "keyword" },
            "documentation": "plain english keyword doc",
            "additionalTextEdits": [{ "range": 虚拟跨度, "newText": "use std::io;" }]
        });
        让 方法项 = json!({
            "label": "len", "kind": 2,
            "textEdit": { "range": 虚拟跨度, "newText": "len" }
        });
        让 外部项 = json!({
            "label": "tokio::spawn", "kind": 3,
            "textEdit": { "range": 虚拟跨度, "newText": "tokio::spawn" }
        });
        让 用户项 = json!({
            "label": "my_func", "kind": 3,
            "textEdit": { "range": 虚拟跨度, "newText": "my_func" }
        });
        让 文档项 = json!({
            "label": "unwrap", "kind": 2,
            "textEdit": { "range": 虚拟跨度, "newText": "unwrap" },
            "documentation": {
                "kind": "markdown",
                "value": "**`Option<T>`**\n\n`Option::unwrap()` 直接取值"
            }
        });
        让 响应 = json!({
            "isIncomplete": false,
            "items": [关键字项, 方法项, 外部项, 用户项, 文档项]
        });
        让 映射结果 = 映射器.映射补全响应(&响应, "file:///t/main.zh");
        让 项集合 = 映射结果["items"].as_array().expect("应有 items 数组");
        断言相等!(项集合.len(), 4, "应过滤未翻译第三方项：{项集合:?}");
        让 按键: std::collections::HashMap<_, _> = 项集合
            .iter()
            .map(|候选项| (候选项["label"].as_str().unwrap_or("").to_string(), 候选项.clone()))
            .collect();

        // 关键字项
        让 关键字映射 = 按键.get("函数").expect("fn 应反查为 函数");
        断言相等!(关键字映射["insertText"].as_str(), 有值("函数"));
        断言相等!(关键字映射["textEdit"]["newText"].as_str(), 有值("函数"));
        断言相等!(关键字映射["labelDetails"]["description"].as_str(), 有值("函数()"));
        断言!(关键字映射.get("additionalTextEdits").is_some());

        // 方法项：别名反查 + 无括号补 snippet 括号
        让 长度项 = 按键.get("长度").expect("len 应反查为 长度");
        让 新文本 = 长度项["textEdit"]["newText"].as_str().unwrap();
        断言!(
            新文本.starts_with("长度("),
            "方法补全应补括号：{新文本}"
        );
        断言相等!(长度项["insertTextFormat"].as_i64(), 有值(2));

        // 用户自定义项保留
        断言!(按键.contains_key("my_func"), "用户英文标识应保留");

        // 文档解释命中大白话表
        让 取出项 = 按键
            .values()
            .find(|候选项| {
                候选项["textEdit"]["newText"]
                    .as_str()
                    .is_some_and(|文本项| 文本项.contains("unwrap"))
            })
            .or_else(|| 按键.get("unwrap"))
            .expect("unwrap 项应保留（源码出现过该标识）");
        让 文档 = 取出项["documentation"].as_str().unwrap_or("");
        断言!(
            文档.contains("直接取出里面的值"),
            "应替换为大白话解释：{文档}"
        );
    }

    /// 文档字符串形态 + 无 items 的响应不 panic，原样可处理
    #[测试]
    函数 测试翻译补全文档形态() {
        让 源码 = "函数 主() {}\n";
        让 (映射器, _临时, _缓存) = 带文档映射器(源码);
        断言!(
            映射器
                .映射补全响应(&Value::Null, "file:///t/main.zh")
                .is_null()
        );
        让 列表结果 = 映射器.映射补全响应(&json!({ "items": [] }), "file:///t/main.zh");
        断言相等!(列表结果["items"].as_array().unwrap().len(), 0);
    }
}
