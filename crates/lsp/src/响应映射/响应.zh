//! 各 LSP 请求类型的响应映射：诊断、补全、悬停、签名帮助、
//! 引用/定义、重命名、代码操作、文档符号与教学动作注入。

使用 标准库::同步::原子引用计数;

使用 JSON序列化::JSON值;

使用 超级::响应映射器;
使用 超级::诊断文本::{
    提取所有权详情, 查找期望实得标签, 是主函数提示,
    是缺依赖噪音, 是缺内嵌资源, 是缺项目依赖,
    是未打开模块引用, 翻译诊断消息,
};
使用 超级::还原单行;
使用 包::翻译缓存::英文列转母语列;

实现 响应映射器 {
    /// 映射 rust-analyzer 的 发布诊断通知
    ///
    /// 将诊断信息中的资源标识和位置还原为原始 .zh 文件，
    /// 并尝试翻译诊断消息为中文。
    公开 函数 映射诊断(&自我, 参数值: &JSON值) -> JSON值 {
        让 虚拟资源标识 = 参数值["uri"].作为字符串().取值或("");
        // 预取条目一次：所有诊断的范围值/关联信息映射基于同一
        // 文档，循环内复用条目走无锁纯函数（诊断通常 10-50 条，避免每条
        // 范围值 × 2 锁、每条关联信息 × 4 锁）
        让 条目值 = 自我
            .缓存
            .按虚拟资源标识查询(虚拟资源标识)
            .或用否则(|| 自我.缓存.查询原始(虚拟资源标识));
        让 原始资源标识 = 匹配 &条目值 {
            有值(条目) => 条目.原始资源标识.克隆值(),
            无 => 虚拟资源标识.转字符串(),
        };
        让 诊断列表 = 参数值["diagnostics"].作为数组();

        让 可变 映射后诊断 = 向量::新建();

        如果让 有值(诊断数组) = 诊断列表 {
            对于 诊断值 在 诊断数组 {
                // 过滤虚拟项目主程序文件中关于主函数的提示级提示
                // （主函数在模块内不是真正的入口，rust-analyzer 会发出
                // “此处是名为主函数的函数”等教学无关的提示）
                如果 是主函数提示(诊断值, 虚拟资源标识) {
                    继续;
                }
                // 过滤虚拟项目固有的过程宏误报（#3 症状二）：虚拟项目无第三方
                // 依赖且禁用过程宏，命令行解析库等派生未展开时的辅助属性
                // （`#[arg(...)]`）与派生宏名字解析必然失败——用户在项目中
                // 构建正常（rzc 检查通过），此类诊断恒为误报
                如果 是缺依赖噪音(诊断值) {
                    继续;
                }
                // 过滤“引用未打开模块文件”的 E0433/E0432 误报：虚拟项目只
                // 聚合已打开文件，被引用模块未打开时无法解析（打开后即恢复）；
                // 同名方言文件存在于同目录时判定为误报（覆盖分析器新旧消息格式）
                如果 是未打开模块引用(诊断值, 条目值.作为解引用()) {
                    继续;
                }
                // 过滤“真实依赖在虚拟项目缺失”的误报：虚拟项目 Cargo.toml
                // 不含用户依赖，serde/serde_json 等已声明依赖的导入必然无法
                // 解析（用户项目中 rzc 检查正常通过）
                如果 是缺项目依赖(诊断值, 条目值.作为解引用()) {
                    继续;
                }
                // 过滤 内嵌字符串与内嵌字节资源在虚拟项目中缺失的
                // 误报：资源文件在原方言文件同目录存在时，虚拟 .rs 的相对
                // 路径解析失败属虚拟项目固有现象
                如果 是缺内嵌资源(诊断值, 条目值.作为解引用()) {
                    继续;
                }

                让 可变 映射项 = 诊断值.克隆值();

                // 映射范围（使用列映射）
                如果 诊断值.读取条目("range").是否为有值() {
                    映射项["range"] =
                        自身::带条目还原范围(条目值.作为解引用(), &诊断值["range"]);
                }

                // 映射关联信息中的位置
                如果让 有值(关联信息) =
                    诊断值.读取条目("relatedInformation").而后映射(|值| 值.作为数组())
                {
                    让 可变 映射后关联 = 向量::新建();
                    对于 项 在 关联信息 {
                        让 可变 映射后项 = 项.克隆值();
                        如果让 有值(位置值) = 项.读取条目("location") {
                            // 同文件位置复用主条目（跨文件才按需查询）
                            让 位置资源标识 = 位置值["uri"].作为字符串().取值或("");
                            让 位置条目 = 如果 位置资源标识 == 虚拟资源标识 {
                                条目值.克隆值()
                            } 否则 {
                                自我
                                    .缓存
                                    .按虚拟资源标识查询(位置资源标识)
                                    .或用否则(|| 自我.缓存.查询原始(位置资源标识))
                            };
                            映射后项["location"] = 自身::带条目还原位置(
                                位置条目.作为解引用(),
                                位置资源标识,
                                位置值,
                            );
                        }
                        // 子消息（help/note）同样翻译——悬停查看诊断详情时
                        // 不泄漏英文（如 "value moved here"、"consider ..."）；
                        // 子消息无独立错误码/标签，走消息表/短语兜底
                        如果让 有值(消息) = 项.读取条目("message").而后映射(|值| 值.作为字符串()) {
                            映射后项["message"] =
                                JSON值::字符串值(翻译诊断消息(无, 消息, 无));
                        }
                        映射后关联.推入(映射后项);
                    }
                    映射项["relatedInformation"] = JSON值::JSON数组(映射后关联);
                }

                // 翻译诊断主消息（与 CLI 同口径）：传入错误码供码表优先命中；
                // rust-analyzer 把 expected/found 放在关联信息而非主
                // 跨度标签，故从关联信息归集候选标签回填 {期望}/{实际}（无则自动
                // 回退消息表）
                让 错误码串 = 诊断值.读取条目("code").而后映射(|值| 值.作为字符串());
                让 主标签 = 查找期望实得标签(诊断值);
                映射项["message"] = JSON值::字符串值(翻译诊断消息(
                    错误码串,
                    诊断值["message"].作为字符串().取值或(""),
                    主标签.作为解引用(),
                ));

                // 所有权错误：提取叙事化详情并存入数据字段（供 VS Code 扩展可视化）
                如果让 有值(详情) = 提取所有权详情(诊断值, &映射项, &原始资源标识)
                    && 让 成功(详情值) = JSON序列化::序列化为值(&详情)
                {
                    // 保留 rust-analyzer 已有的数据（如代码操作数据），嵌套存入
                    匹配 映射项.获取可变("data") {
                        有值(既有值) 如果 既有值.是对象() => {
                            既有值["所有权详情"] = 详情值;
                        }
                        _ => {
                            映射项["data"] = 详情值;
                        }
                    }
                }

                // 添加教学提示标记
                映射项["source"] = JSON值::字符串值("i18n-rust".转字符串());

                映射后诊断.推入(映射项);
            }
        }

        JSON序列化::JSON格式!({
            "uri": 原始资源标识,
            "diagnostics": 映射后诊断,
            "version": 参数值.读取条目("version").克隆副本().取值或(JSON值::空值节点)
        })
    }

    /// 映射补全响应中的位置信息
    ///
    /// 将文本编辑/附加文本编辑中的范围映射回原始文件，
    /// 并将英文标识符/代码反向翻译为母语（否则接受补全会把
    /// 英文关键字插入母语源文件，或自动导入编辑落在错误位置）。
    公开 函数 映射补全响应(&自我, 响应值: &JSON值, 原始资源标识: &文本) -> JSON值 {
        让 可变 结果值 = 响应值.克隆值();

        如果让 有值(项列表) = 结果值.读取条目("items").而后映射(|值| 值.作为数组()) {
            让 可变 映射后项 = 向量::新建();
            // 语言过滤白名单（用户源码中出现过的标识符）懒加载，
            // 仅在确实遇到未翻译的纯英文项时才扫描一次；
            // 引用计数共享避免每次补全请求克隆整个集合
            让 可变 用户词汇: 选项<原子引用计数<标准库::集合::哈希集合<字符串>>> = 无;
            对于 项 在 项列表 {
                让 可变 映射项 = 项.克隆值();

                // 1. 映射文本编辑的范围并反向翻译新文本
                如果让 有值(文本编辑) = 项.读取条目("textEdit") {
                    如果让 有值(范围值) = 文本编辑.读取条目("range") {
                        映射项["textEdit"]["range"] = 自我.还原范围(原始资源标识, 范围值);
                    }
                    如果让 有值(新文本) = 文本编辑.读取条目("newText").而后映射(|值| 值.作为字符串()) {
                        映射项["textEdit"]["newText"] =
                            JSON值::字符串值(自我.翻译代码(新文本));
                    }
                }

                // 2. 附加文本编辑（如自动导入）：位置与内容同样需要还原
                如果让 有值(附加编辑) = 项.读取条目("additionalTextEdits") {
                    映射项["additionalTextEdits"] =
                        自我.映射编辑列表(附加编辑, 原始资源标识, 真);
                }

                // 3. 标签：先精确反查（关键字等），未命中则词法级转译
                //    （标准库接口如向量新建、打印宏也能还原为母语）
                如果让 有值(标签) = 项.读取条目("label").而后映射(|值| 值.作为字符串()) {
                    让 映射后标签 = 自我
                        .反向查找(标签)
                        .解包或用否则(|| 自我.翻译代码(标签));

                    // 3.5 语言过滤（禁止串语言）：非英文方言下，补全列表
                    //     只保留母语项，过滤未翻译的外部英文项（第三方库、
                    //     未收录的标准库 API 等）。保留条件（满足其一）：
                    //     a. 翻译命中（映射后标签与原文不同）；
                    //     b. 标签含母语字符（用户定义的母语标识符）；
                    //     c. 标签的末段标识符在用户源码中出现过
                    //        （用户自己定义的项，含英文命名）。
                    如果 自我.严格母语过滤 {
                        让 含母语字符 = !映射后标签.是否为ASCII();
                        让 已翻译 = 映射后标签 != 标签;
                        让 用户定义 = 如果 含母语字符 || 已翻译 {
                            真
                        } 否则 {
                            让 词汇集 =
                                用户词汇.插入或用(|| 自我.缓存.用户定义词汇());
                            标签标识后缀(标签).有值且(|名称| 词汇集.包含(名称))
                        };
                        如果 !(含母语字符 || 已翻译 || 用户定义) {
                            继续;
                        }
                    }

                    映射项["label"] = JSON值::字符串值(映射后标签);
                }

                // 4. 详情（类型签名）：词法级转译，如英文签名转成中文签名
                如果让 有值(详情) = 项.读取条目("detail").而后映射(|值| 值.作为字符串()) {
                    映射项["detail"] = JSON值::字符串值(自我.翻译代码(详情));
                }

                // 4.5 标签详情：VS Code 提示框右侧优先显示此字段
                //     （描述为签名、详情为包/模块路径），
                //     不还原会把英文签名泄漏给母语用户
                如果让 有值(标签详情) = 项.读取条目("labelDetails").而后映射(|值| 值.作为对象()) {
                    让 可变 映射后详情 = 标签详情.克隆值();
                    如果让 有值(描述) = 标签详情.读取条目("description").而后映射(|值| 值.作为字符串()) {
                        映射后详情.置入(
                            "description".转字符串(),
                            JSON值::字符串值(自我.翻译代码(描述)),
                        );
                    }
                    如果让 有值(详情) = 标签详情.读取条目("detail").而后映射(|值| 值.作为字符串()) {
                        映射后详情.置入(
                            "detail".转字符串(),
                            JSON值::字符串值(自我.翻译代码(详情)),
                        );
                    }
                    映射项["labelDetails"] = JSON值::JSON对象(映射后详情);
                }

                // 5. 文档：命中解释表（大白话）时替换为中文，
                //    未命中保留英文原文（避免丢失签名等关键信息）
                如果让 有值(文档值) = 项.读取条目("documentation") {
                    映射项["documentation"] = 自我.翻译补全文档(项, 文档值);
                }

                // 6. 反向映射插入文本（可能含代码片段占位符，仅精确匹配时替换）
                如果让 有值(插入文本) = 项.读取条目("insertText").而后映射(|值| 值.作为字符串())
                    && 让 有值(母语名) = 自我.反向查找(插入文本)
                {
                    映射项["insertText"] = JSON值::字符串值(母语名);
                }

                // 7. 方法/函数补全补括号：rust-analyzer 的代码片段配置在代理
                //    环境不可靠（方法补全默认不带括号），这里对方法/函数类
                //    补全项在文本编辑末尾补代码片段括号，光标自动落在括号内
                //    （教学常用场景如 `长度()`）；已带括号（含参数占位）跳过。
                让 种类 = 项.读取条目("kind").而后映射(|值| 值.转长整数()).取值或(0);
                如果 模式匹配!(种类, 2 | 3)
                    && 让 有值(文本串) = 映射项["textEdit"]["newText"].作为字符串()
                    && !文本串.包含('(')
                {
                    映射项["textEdit"]["newText"] = JSON值::字符串值(格式化!("{}(${{1:}})", 文本串));
                    // 2 = 代码片段格式：占位符由客户端解析，光标落在括号内
                    映射项["insertTextFormat"] = JSON值::数字值(2.转为());
                }

                // 8. 关键字补全前导空格：rust-analyzer 的“让 可变”组合代码片段
                //    在代理环境不可用，散落的关键字项（如 `可变`）直接插入会与
                //    前一标识符粘连（`让可变`）。判断新文本的首个标识符是否
                //    为关键字映射表中的词（不依赖种类，rust-analyzer 的关键字
                //    补全种类不可靠），且前一字符是标识符时在文本编辑前补空格。
                如果让 有值(文本串) = 映射项["textEdit"]["newText"].作为字符串() {
                    让 首个词 = 文本串
                        .分割(|字符值: 字符| 字符值.是否为空白() || 字符值 == '$')
                        .下一个()
                        .取值或("");
                    如果 !首个词.为空() && 自我.缓存.关键词映射().包含键(首个词) {
                        让 起始位置 = 映射项["textEdit"]["range"]["start"].克隆值();
                        如果让 (有值(行号), 有值(列号)) = (
                            起始位置["line"].作为长整数().变换(|值| 值 作为 无符号机器整数),
                            起始位置["character"].作为长整数().变换(|值| 值 作为 无符号机器整数),
                        ) && 列号 > 0
                            && 让 有值(条目) = 自我.缓存.查询原始(原始资源标识)
                            && 让 有值(行文本) = 条目.母语内容.逐行().取第项(行号)
                        {
                            让 前字符 = 行文本.逐字符().取第项(列号 - 1);
                            让 需要空格 = 前字符.有值且(|字符值| {
                                !字符值.是否为空白()
                                    && !模式匹配!(字符值, '(' | '.' | ':' | ',' | ';' | '{' | '[' | '!')
                            });
                            如果 需要空格 && !文本串.以开头(字符::是否为空白) {
                                映射项["textEdit"]["newText"] = JSON值::字符串值(格式化!(" {文本串}"));
                            }
                        }
                    }
                }

                映射后项.推入(映射项);
            }
            结果值["items"] = JSON值::JSON数组(映射后项);
        }

        结果值
    }

    /// 补全文档：优先用中文解释表替换英文文档
    ///
    /// 查键顺序：从文档解析类型::方法（如选项的解包）→ 标签直查
    /// → 方法名兜底；全部未命中时保留英文原文。
    函数 翻译补全文档(&自我, 项: &JSON值, 文档值: &JSON值) -> JSON值 {
        让 文档文本 = 匹配 文档值 {
            JSON值::字符串值(串) => 有值(串.作为文本切片()),
            JSON值::JSON对象(对象) => 对象.读取条目("value").而后映射(|值| 值.作为字符串()),
            _ => 无,
        };
        如果让 有值(文本串) = 文档文本
            && 让 有值(解释) = 自我.查找解释(文本串)
        {
            返回 JSON值::字符串值(解释);
        }
        // 标签直查 + 方法名兜底
        让 界面 = 包::界面消息::全局界面();
        如果让 有值(标签) = 项.读取条目("label").而后映射(|值| 值.作为字符串())
            && 让 有值(解释) = 界面.取解释(标签)
        {
            返回 JSON值::字符串值(解释.转字符串());
        }
        如果让 有值(文本串) = 文档文本
            && 让 有值(名称) = 提取函数名(文本串)
            && 让 有值(解释) = 界面.取解释(&名称)
        {
            返回 JSON值::字符串值(解释.转字符串());
        }
        文档值.克隆值()
    }

    /// 映射文档高亮响应（文档高亮数组：范围值 + 种类）
    ///
    /// 请求方向已把位置转为虚拟文件坐标，响应必须还原，
    /// 否则高亮位置以虚拟文件坐标泄漏给客户端。
    公开 函数 映射文档高亮响应(&自我, 响应值: &JSON值, 原始资源标识: &文本) -> JSON值 {
        匹配 响应值 {
            JSON值::JSON数组(项集) => {
                让 映射后: 向量<JSON值> = 项集
                    .迭代()
                    .变换(|项| {
                        让 可变 映射项 = 项.克隆值();
                        如果让 有值(范围值) = 项.读取条目("range") {
                            映射项["range"] = 自我.还原范围(原始资源标识, 范围值);
                        }
                        映射项
                    })
                    .收集();
                JSON值::JSON数组(映射后)
            }
            JSON值::空值节点 => JSON值::JSON数组(向量::新建()),
            _ => 响应值.克隆值(),
        }
    }

    /// 映射语义着色响应（semanticTokens/full、semanticTokens/range）
    ///
    /// rust-analyzer 返回的词法记号坐标基于虚拟 .rs（转译产物），
    /// 必须还原到方言文件坐标，否则变量/参数等颜色落在错误位置
    /// 或完全不显示。数据字段为 LSP 增量编码（每 5 项一组）：
    /// `[deltaLine, deltaStart, length, tokenType, tokenModifiers]`——
    /// 先还原为绝对坐标，逐词法记号映射起点与终点列，再重新增量编码。
    /// 结果标识原样透传（客户端依赖它做增量请求）。
    公开 函数 映射语义记号响应(&自我, 响应值: &JSON值, 原始资源标识: &文本) -> JSON值 {
        让 可变 结果值 = 响应值.克隆值();
        让 有值(数据) = 结果值.读取条目("data").而后映射(|值| 值.作为数组()) 否则 {
            返回 结果值;
        };

        // 预取翻译条目：每个词法记号的列映射都基于同一文档，
        // 只查一次（常数时间索引），避免每个词法记号重复锁与表扫描
        让 条目值 = 自我
            .缓存
            .按虚拟资源标识查询(原始资源标识)
            .或用否则(|| 自我.缓存.查询原始(原始资源标识));
        // 无条目（异常资源标识）时位置原样透传
        让 映射位置 = |行号: 无符号整数, 列号: 无符号整数| -> (无符号整数, 无符号整数) {
            匹配 &条目值 {
                有值(条目) => {
                    让 母语行 = 还原单行(条目, 行号);
                    让 母语列 = 英文列转母语列(条目, 行号, 列号);
                    (母语行, 母语列)
                }
                无 => (行号, 列号),
            }
        };

        // 1. 增量编码 → 绝对坐标（跨行时列归零重置，同行时列累加）
        让 可变 记号集: 向量<(无符号整数, 无符号整数, 无符号整数, 无符号整数, 无符号整数)> = 向量::新建();
        让 可变 行号 = 0u32;
        让 可变 列号 = 0u32;
        对于 分块值 在 数据.分块(5) {
            如果 分块值.元素数() < 5 {
                中断;
            }
            让 增量行 = 分块值[0].作为长整数().取值或(0) 作为 无符号整数;
            让 增量起列 = 分块值[1].作为长整数().取值或(0) 作为 无符号整数;
            让 词法长 = 分块值[2].作为长整数().取值或(0) 作为 无符号整数;
            让 词法类型 = 分块值[3].作为长整数().取值或(0) 作为 无符号整数;
            让 修饰值 = 分块值[4].作为长整数().取值或(0) 作为 无符号整数;
            行号 = 行号.饱和加(增量行);
            列号 = 如果 增量行 == 0 {
                列号.饱和加(增量起列)
            } 否则 {
                增量起列
            };
            记号集.推入((行号, 列号, 词法长, 词法类型, 修饰值));
        }

        // 2. 起点/终点列分别还原到方言坐标，长度取映射后的差值
        //（关键字替换改变了列宽，长度必须重算）
        // 修饰符强制清零：rust-analyzer 对同一标识符在不同位置打不同修饰符
        //（声明处、宏参数内等），VS Code 对修饰符有独立
        // 颜色/样式（如宏参数蓝色、声明加粗），导致同一变量不同行颜色不一，
        // 干扰用户按颜色查找标识符。教学场景以类型色为准，修饰符信息放弃。
        让 可变 映射后: 向量<(无符号整数, 无符号整数, 无符号整数, 无符号整数, 无符号整数)> = 向量::新建();
        对于 (词法行, 词法列, 词法长, 词法类型, _词法修饰) 在 记号集 {
            让 (母语行, 母语起始列) = 映射位置(词法行, 词法列);
            让 (_, 母语结束列) = 映射位置(词法行, 词法列.饱和加(词法长));
            让 母语长 = 母语结束列.饱和减(母语起始列).最大(1);
            映射后.推入((母语行, 母语起始列, 母语长, 词法类型, 0));
        }

        // 3. 重新增量编码
        让 可变 新数据 = 向量::带容量(映射后.元素数() * 5);
        让 可变 前行 = 0u32;
        让 可变 前列 = 0u32;
        对于 (词法行, 词法列, 词法长, 词法类型, 词法修饰) 在 映射后 {
            让 增量行 = 词法行.饱和减(前行);
            让 增量起列 = 如果 增量行 == 0 {
                词法列.饱和减(前列)
            } 否则 {
                词法列
            };
            新数据.推入(JSON序列化::JSON格式!(增量行));
            新数据.推入(JSON序列化::JSON格式!(增量起列));
            新数据.推入(JSON序列化::JSON格式!(词法长));
            新数据.推入(JSON序列化::JSON格式!(词法类型));
            新数据.推入(JSON序列化::JSON格式!(词法修饰));
            前行 = 词法行;
            前列 = 词法列;
        }
        结果值["data"] = JSON值::JSON数组(新数据);
        结果值
    }

    /// 映射定义跳转响应（位置值 或 位置值数组）
    公开 函数 映射定义响应(&自我, 响应值: &JSON值) -> JSON值 {
        匹配 响应值 {
            JSON值::空值节点 => JSON值::空值节点,
            JSON值::JSON数组(数组) => {
                让 映射后: 向量<JSON值> = 数组
                    .迭代()
                    .变换(|项| 自我.还原位置(项))
                    .收集();
                JSON值::JSON数组(映射后)
            }
            JSON值::JSON对象(_) => {
                // 单个位置值
                自我.还原位置(响应值)
            }
            _ => 响应值.克隆值(),
        }
    }

    /// 映射悬停响应中的位置信息
    ///
    /// 范围字段映射回原始文件位置；内容命中语言包 ["解释"] 表时
    /// 在文档上方插入一行加粗大白话提示（未命中保持原样透传）。
    公开 函数 映射悬停响应(&自我, 响应值: &JSON值, 原始资源标识: &文本) -> JSON值 {
        让 可变 结果值 = 响应值.克隆值();
        如果让 有值(范围值) = 响应值.读取条目("range") {
            结果值["range"] = 自我.还原范围(原始资源标识, 范围值);
        }
        如果让 有值(内容值) = 响应值.读取条目("contents") {
            结果值["contents"] = 自我.充实悬停内容(内容值);
        }
        结果值
    }

    /// 映射签名帮助响应
    ///
    /// 签名标签（如 `fn push(&mut self, value: T)`）与参数标签做词法级
    /// 中文化（英文关键字转中文等）；参数标签为 [起, 止] 索引形式时按
    /// 原标签提取文本翻译后转为字符串形式（VS Code 不再高亮参数，但
    /// 母语用户可读性优先——翻译前后长度变化无法保持索引）。
    公开 函数 映射签名帮助响应(&自我, 响应值: &JSON值) -> JSON值 {
        让 可变 结果值 = 响应值.克隆值();
        让 有值(签名集) = 结果值.读取条目("signatures").而后映射(|值| 值.作为数组()) 否则 {
            返回 结果值;
        };
        让 映射后: 向量<JSON值> = 签名集
            .迭代()
            .变换(|签名值| {
                让 可变 映射后签名 = 签名值.克隆值();
                让 有值(标签) = 签名值.读取条目("label").而后映射(|值| 值.作为字符串()) 否则 {
                    返回 映射后签名;
                };
                让 翻译后标签 = 自我.翻译代码(标签);
                如果让 有值(参数集) = 签名值.读取条目("parameters").而后映射(|值| 值.作为数组()) {
                    让 翻译后参数: 向量<JSON值> = 参数集
                        .迭代()
                        .变换(|参数值| {
                            让 可变 映射后参数 = 参数值.克隆值();
                            如果让 有值(范围值) = 参数值.读取条目("label").而后映射(|值| 值.作为数组()) {
                                // [起, 止] 索引：原标签为英文（ASCII），
                                // UTF-16 索引等于字节索引，可直接切片
                                如果让 (有值(起始), 有值(结束)) = (范围值[0].转长整数(), 范围值[1].转长整数())
                                    && 让 有值(参数文本) = 标签.截取(起始 作为 无符号机器整数..结束 作为 无符号机器整数)
                                {
                                    映射后参数["label"] =
                                        JSON值::字符串值(自我.翻译代码(参数文本));
                                }
                            } 否则 如果让 有值(参数标签) =
                                参数值.读取条目("label").而后映射(|值| 值.作为字符串())
                            {
                                映射后参数["label"] =
                                    JSON值::字符串值(自我.翻译代码(参数标签));
                            }
                            映射后参数
                        })
                        .收集();
                    映射后签名["parameters"] = JSON值::JSON数组(翻译后参数);
                }
                映射后签名["label"] = JSON值::字符串值(翻译后标签);
                映射后签名
            })
            .收集();
        结果值["signatures"] = JSON值::JSON数组(映射后);
        结果值
    }

    /// 给悬停内容前置大白话提示并中文化代码片段
    ///
    /// 标记文本（语言字段存在）是纯代码签名行：先按英文原文查
    /// 解释表加“大白话”前缀，再对整个文本做词法级中文化（英文关键字转中文）。
    /// markdown 文本只对代码块与行内代码做词法级中文化，正文保持原样
    /// （正文是 rust-analyzer 的英文文档，也是教学性说明，不能按词表乱换）。
    /// 关键字悬停（如英文关键字）整段替换为语言包里的中文说明。
    函数 充实悬停内容(&自我, 内容值: &JSON值) -> JSON值 {
        匹配 内容值 {
            // 标记内容：类型为 markdown、值为文本
            JSON值::JSON对象(对象)
                如果 对象.读取条目("kind").而后映射(|值| 值.作为字符串()) == 有值("markdown")
                    && 对象.读取条目("value").而后映射(|值| 值.作为字符串()).是否为有值() =>
            {
                让 可变 映射项 = 对象.克隆值();
                // 守卫已确认值字段为字符串，读取条目回退空串仅为满足类型
                让 文本串 = 对象.读取条目("value").而后映射(|值| 值.作为字符串()).取值或("");
                如果让 有值(翻译后) = 自我.关键词悬停文本(文本串) {
                    映射项["value"] = JSON值::字符串值(翻译后);
                    返回 JSON值::JSON对象(映射项);
                }
                // 查解释依赖英文原词（`fn name` 等），先查再中文化代码
                让 已提示 = 自我.命中则前置(文本串);
                映射项["value"] = JSON值::字符串值(自我.本地化悬停标记文本(&已提示));
                JSON值::JSON对象(映射项)
            }
            // 标记文本：语言为 rust、值为代码签名
            JSON值::JSON对象(对象)
                如果 对象.读取条目("language").是否为有值()
                    && 对象.读取条目("value").而后映射(|值| 值.作为字符串()).是否为有值() =>
            {
                让 可变 映射项 = 对象.克隆值();
                // 守卫已确认值字段为字符串，读取条目回退空串仅为满足类型
                让 文本串 = 对象.读取条目("value").而后映射(|值| 值.作为字符串()).取值或("");
                如果让 有值(翻译后) = 自我.关键词悬停文本(文本串) {
                    返回 JSON序列化::JSON格式!({ "kind": "markdown", "value": 翻译后 });
                }
                让 已提示 = 自我.命中则前置(文本串);
                映射项["value"] = JSON值::字符串值(自我.翻译代码(&已提示));
                JSON值::JSON对象(映射项)
            }
            JSON值::字符串值(文本串) => {
                如果让 有值(翻译后) = 自我.关键词悬停文本(文本串) {
                    返回 JSON序列化::JSON格式!({ "kind": "markdown", "value": 翻译后 });
                }
                JSON值::字符串值(自我.命中则前置(文本串))
            }
            // 数组形态（标记文本数组）：任一元素是关键字文档时整段换成
            // 中文说明，避免同一条提示里残留英文正文元素（中英混杂）
            JSON值::JSON数组(项集) => {
                对于 项 在 项集 {
                    让 文档文本 = 匹配 项 {
                        JSON值::JSON对象(对象) => 对象.读取条目("value").而后映射(|值| 值.作为字符串()),
                        JSON值::字符串值(文本串) => 有值(文本串.作为文本切片()),
                        _ => 无,
                    };
                    如果让 有值(文本串) = 文档文本
                        && 让 有值(翻译后) = 自我.关键词悬停文本(文本串)
                    {
                        返回 JSON序列化::JSON格式!({ "kind": "markdown", "value": 翻译后 });
                    }
                }
                JSON值::JSON数组(
                    项集
                        .迭代()
                        .变换(|项| 自我.充实悬停内容(项))
                        .收集(),
                )
            }
            _ => 内容值.克隆值(),
        }
    }

    /// 关键字悬停：把 rust-analyzer 的英文关键字文档整段换成中文说明
    ///
    /// rust-analyzer 对关键字（英文关键字）返回英文原文；不同版本
    /// 的形态不同（代码块首行、加粗/反引号标题行、纯文本标识符），逐一
    /// 识别。命中语言包 `["解释"]` 中的关键字条目时整段替换；未配置说明
    /// 时返回 `无`，调用方回退到常规“大白话 + 代码中文化”路径。
    函数 关键词悬停文本(&自我, 文档串: &文本) -> 选项<字符串> {
        让 界面 = 包::界面消息::全局界面();
        让 解释 = |词: &文本| -> 选项<字符串> {
            // `macro_rules!` 这类关键字文档可能带感叹号，去掉后再识别
            让 词 = 词.去后缀('!').取值或(词);
            如果 !是标识符(词) {
                返回 无;
            }
            让 母语词形 = 自我.反向查找(词)?;
            让 说明 = 界面.取解释(词)?;
            有值(格式化!("**{}**\n\n{}", 母语词形, 说明))
        };
        // 形态一：代码块首行是单个标识符（关键字）；含空白的签名不会命中
        对于 代码块 在 提取悬停代码块(文档串) {
            让 有值(首行) = 代码块.逐行().变换(文本::裁剪).查找(|行文本| !行文本.为空()) 否则 {
                继续;
            };
            如果让 有值(文本串) = 解释(首行) {
                返回 有值(文本串);
            }
        }
        // 形态二：加粗标题行（加粗标题或反引号标题）或反引号标题行
        对于 行文本 在 文档串.逐行() {
            让 裁剪后 = 行文本.裁剪();
            让 词 = 如果 裁剪后.元素数() >= 4
                && 裁剪后.以开头("**")
                && 裁剪后.以结尾("**")
            {
                裁剪后[2..裁剪后.元素数() - 2].裁剪匹配('`').裁剪()
            } 否则 如果 裁剪后.元素数() >= 2 && 裁剪后.以开头('`') && 裁剪后.以结尾('`') {
                裁剪后.裁剪匹配('`').裁剪()
            } 否则 {
                继续;
            };
            如果让 有值(文本串) = 解释(词) {
                返回 有值(文本串);
            }
        }
        // 形态三：整段只有一个（可带反引号/加粗）标识符
        解释(文档串.裁剪().裁剪匹配(|字符值| 字符值 == '*' || 字符值 == '`').裁剪())
    }

    /// 中文化 markdown 悬停中的代码块与行内代码，正文保持原样
    ///
    /// rust-analyzer 的函数/类型悬停形如 ```` ```rust\nfn 名字()\n``` ````
    /// 加英文文档；只翻代码片段既能消除英文关键字残留，又不会把英文正文
    /// 按词表误换（正文里的 match/for 等英文单词是说明文字，不是代码）。
    /// 只含内部路径（`i18n_virtual::main`、`alloc::vec::Vec`）且后面还有
    /// 签名块的代码块整体丢弃：那是语言服务器内部结构，泄露给学习者
    /// 只会制造“多余前缀”。签名里的内部注释（`// matched arm #1`、
    /// `// Bounds from impl:`）同样清理，避免中英混杂。
    函数 本地化悬停标记文本(&自我, 文档串: &文本) -> 字符串 {
        让 行集: 向量<&文本> = 文档串.拆分包含('\n').收集();
        让 总块数 = 提取悬停代码块(文档串).元素数();
        让 可变 输出 = 字符串::带容量(文档串.元素数());
        让 可变 序号 = 0;
        当 序号 < 行集.元素数() {
            让 (主体, 换行) = 拆分行尾(行集[序号]);
            如果 主体.裁剪左侧().以开头("```") {
                // 找闭合围栏；未闭合时按到文末处理（不恐慌）
                让 可变 闭合 = 序号 + 1;
                当 闭合 < 行集.元素数()
                    && !拆分行尾(行集[闭合]).0.裁剪左侧().以开头("```")
                {
                    闭合 += 1;
                }
                让 内部: 向量<&文本> = 行集[序号 + 1..闭合]
                    .迭代()
                    .变换(|行文本| 拆分行尾(行文本).0)
                    .收集();
                如果 是虚拟路径块(&内部)
                    || (总块数 > 1 && 是纯路径块(&内部))
                {
                    // 跳过整块，并吃掉紧随其后的一个空行，避免留下双空行
                    序号 = 如果 闭合 < 行集.元素数() { 闭合 + 1 } 否则 { 闭合 };
                    如果 序号 < 行集.元素数() && 拆分行尾(行集[序号]).0.裁剪().为空() {
                        序号 += 1;
                    }
                    继续;
                }
                输出.推入字符串(主体);
                输出.推入字符串(换行);
                对于 行文本 在 &行集[序号 + 1..闭合] {
                    让 (内部主体, 内部换行) = 拆分行尾(行文本);
                    让 有值(代码) = 去除悬停标注(内部主体) 否则 {
                        继续;
                    };
                    输出.推入字符串(&自我.翻译代码(代码));
                    输出.推入字符串(内部换行);
                }
                如果 闭合 < 行集.元素数() {
                    让 (闭合主体, 闭合换行) = 拆分行尾(行集[闭合]);
                    输出.推入字符串(闭合主体);
                    输出.推入字符串(闭合换行);
                    序号 = 闭合 + 1;
                } 否则 {
                    序号 = 闭合;
                }
                继续;
            }
            输出.推入字符串(&自我.翻译行内代码(主体));
            输出.推入字符串(换行);
            序号 += 1;
        }
        输出
    }

    /// 中文化一行正文里的行内代码（`…` 包裹的片段）
    ///
    /// 按反引号切分，奇数段是代码；未闭合的尾段保持原样（按正文处理）。
    函数 翻译行内代码(&自我, 行文本: &文本) -> 字符串 {
        让 片段集: 向量<&文本> = 行文本.分割('`').收集();
        让 可变 输出 = 字符串::带容量(行文本.元素数());
        对于 (序号, 片段) 在 片段集.迭代().枚举() {
            如果 序号 > 0 {
                输出.推入('`');
            }
            如果 序号 % 2 == 1 && !片段.为空() {
                输出.推入字符串(&自我.翻译代码(片段));
            } 否则 {
                输出.推入字符串(片段);
            }
        }
        输出
    }

    /// 命中解释表时在文档上方插入加粗大白话行，否则原样返回
    函数 命中则前置(&自我, 文档串: &文本) -> 字符串 {
        匹配 自我.查找解释(文档串) {
            有值(提示) => 格式化!("**大白话：{}**\n\n{}", 提示, 文档串),
            无 => 文档串.转字符串(),
        }
    }

    /// 从悬停文档提取候选解释键并查表（完整路径 → 类型::方法 → 方法名）
    ///
    /// 只在“签名块”上取键：rust-analyzer 的悬停常含两个代码块，首块是内部
    /// 模块路径（如 `i18n_virtual::main`），拿它取键会把入口函数说明
    /// （主函数）误挂到任意自定义函数/类型上。
    函数 查找解释(&自我, 文档串: &文本) -> 选项<字符串> {
        让 (类型名, _) = 提取悬停部分(文档串);
        让 代码块集 = 提取悬停代码块(文档串);
        让 签名行 = 选取悬停签名(&代码块集)?;
        让 可变 键集: 向量<字符串> = 向量::新建();
        // 1. 完整路径形式（如完整标准库路径），清洗泛型参数
        如果 签名行.包含("::") && !签名行.包含("fn ") && !签名行.包含(字符::是否为空白) {
            让 清洗后 = 清洗路径段(&签名行);
            如果 清洗后.元素数() >= 2 {
                键集.推入(清洗后.连接("::"));
                // 降级匹配末两段（如选项的解包），兼容短路径键数据
                如果 清洗后.元素数() > 2 {
                    键集.推入(清洗后[清洗后.元素数() - 2..].连接("::"));
                }
            }
        }
        // 2. 类型::方法（短路径，如选项的解包）+ 3. 方法名兜底
        如果让 有值(名称) = 提取函数名(&签名行) {
            让 类型值 = 类型名.或用否则(|| 提取实现类型(&签名行));
            如果让 有值(类型值) = 类型值 {
                键集.推入(格式化!("{}::{}", 类型值, 名称));
            }
            如果 !键集.迭代().任意(|键| 键 == &名称) {
                键集.推入(名称);
            }
        }
        让 界面 = 包::界面消息::全局界面();
        键集.迭代()
            .查找映射(|键| 界面.取解释(键).变换(文本::转字符串))
    }

    /// 映射引用响应
    ///
    /// 引用响应是位置值数组；无结果时为 空值，统一转为空数组。
    公开 函数 映射引用响应(&自我, 响应值: &JSON值) -> JSON值 {
        匹配 响应值 {
            JSON值::空值节点 => JSON值::JSON数组(向量::新建()),
            _ => 自我.映射定义响应(响应值), // 与定义跳转格式相同
        }
    }

    /// 映射重命名响应
    ///
    /// 处理跨文件重命名：
    /// - 变更表：{ 资源标识 → [文本编辑] }
    /// - 文档变更：[文本编辑]
    ///
    /// 将每个编辑的范围映射回原始文件，并将新文本反向翻译为母语。
    ///
    /// 编辑目标不是已打开 .zh 的虚拟文件时（如聚合模块的 main.rs、
    /// Cargo.toml）直接丢弃，避免客户端被引导编辑虚拟项目内部文件。
    公开 函数 映射重命名响应(&自我, 响应值: &JSON值) -> JSON值 {
        让 可变 结果值 = 响应值.克隆值();

        // 1. 处理变更表形式
        如果让 有值(变更表) = 响应值.读取条目("changes").而后映射(|值| 值.作为对象()) {
            让 可变 映射后变更 = JSON序列化::JSON映射::新建();
            对于 (资源标识, 编辑列表) 在 变更表 {
                如果 !自我.是虚拟资源标识(资源标识) {
                    继续;
                }
                让 目标资源标识 = 自我.还原资源标识(资源标识);
                让 映射后编辑 = 自我.映射编辑列表(编辑列表, 资源标识, 真);
                映射后变更.置入(目标资源标识, 映射后编辑);
            }
            结果值["changes"] = JSON值::JSON对象(映射后变更);
        }

        // 2. 处理文档变更形式
        如果让 有值(文档变更) = 响应值.读取条目("documentChanges").而后映射(|值| 值.作为数组()) {
            让 映射后文档变更: 向量<JSON值> = 文档变更
                .迭代()
                .过滤映射(|项| {
                    让 资源标识 = 项
                        .读取条目("textDocument")
                        .而后映射(|文档| 文档.读取条目("uri"))
                        .而后映射(|值| 值.作为字符串())
                        .取值或("");
                    如果 !自我.是虚拟资源标识(资源标识) {
                        返回 无;
                    }
                    让 可变 映射项 = 项.克隆值();
                    映射项["textDocument"]["uri"] = JSON值::字符串值(自我.还原资源标识(资源标识));
                    如果让 有值(编辑) = 项.读取条目("edits") {
                        映射项["edits"] = 自我.映射编辑列表(编辑, 资源标识, 真);
                    }
                    有值(映射项)
                })
                .收集();
            结果值["documentChanges"] = JSON值::JSON数组(映射后文档变更);
        }

        结果值
    }

    /// 映射代码操作响应
    ///
    /// LSP 规范中 `textDocument/codeAction` 响应是 `CodeAction[]` 数组，
    /// 每个操作可能携带编辑字段（工作区编辑）。将编辑位置映射回原始文件，
    /// 插入的英文代码反向翻译为母语（与源文件语言保持一致）。
    公开 函数 映射代码操作响应(&自我, 响应值: &JSON值, _原始资源标识: &文本) -> JSON值 {
        匹配 响应值 {
            JSON值::JSON数组(操作集) => {
                让 映射后操作: 向量<JSON值> = 操作集
                    .迭代()
                    .变换(|操作值| {
                        让 可变 映射项 = 操作值.克隆值();
                        如果让 有值(编辑) = 操作值.读取条目("edit") {
                            映射项["edit"] = 自我.映射编辑(编辑, 真);
                        }
                        映射项
                    })
                    .收集();
                JSON值::JSON数组(映射后操作)
            }
            JSON值::空值节点 => JSON值::JSON数组(向量::新建()),
            _ => 响应值.克隆值(),
        }
    }

    /// 映射代码操作解析（codeAction/resolve）响应
    ///
    /// 解析响应是单个代码操作对象（非数组）：VS Code 点击操作后
    /// 解析懒加载的编辑。若不映射，编辑的资源标识是虚拟路径，
    /// VS Code 无法应用编辑（报请求失败）。
    公开 函数 映射代码操作解析响应(&自我, 响应值: &JSON值) -> JSON值 {
        匹配 响应值 {
            JSON值::JSON对象(_) => {
                让 可变 映射项 = 响应值.克隆值();
                如果让 有值(编辑) = 响应值.读取条目("edit") {
                    映射项["edit"] = 自我.映射编辑(编辑, 真);
                }
                映射项
            }
            _ => 响应值.克隆值(),
        }
    }

    /// 注入“添加依赖”快捷修复：未解析导入错误时提供一键 `cargo add`
    ///
    /// 命令由 VS Code 扩展注册（添加依赖命令）在工作区终端执行；
    /// 动作标题中的包名反查母语别名（如网络库 → HTTP客户端），
    /// 与母语源码的阅读体验保持一致。
    公开 函数 注入添加依赖动作(&自我, 响应值: &JSON值, 包名列表: &[字符串]) -> JSON值 {
        如果 包名列表.为空() {
            返回 响应值.克隆值();
        }
        让 可变 操作集 = 匹配 响应值 {
            JSON值::JSON数组(列表) => 列表.克隆值(),
            _ => 向量::新建(),
        };
        对于 包名 在 包名列表 {
            // 英文包名反查母语别名（关键字/别名表），未命中保持原名
            让 显示名 = 自我
                .反向查找(包名)
                .解包或用否则(|| 包名.克隆值());
            让 标题 = 包::界面消息::全局界面().取带参消息("lsp_action_add_dependency", &[&显示名]);
            操作集.推入(JSON序列化::JSON格式!({
                "title": 标题,
                "kind": "quickfix",
                "command": {
                    "title": 标题,
                    "command": "i18n-rust.cargoAdd",
                    "arguments": [包名]
                }
            }));
        }
        JSON值::JSON数组(操作集)
    }

    /// 注入教学诊断的快捷修复：全角标点一键替换半角、教学检查忽略此行
    ///
    /// 教学诊断由代理自身发布（方言坐标），rust-analyzer 不会为其生成
    /// 修复动作，故在响应时按上下文诊断注入。编辑坐标直接使用诊断携带的
    /// 方言坐标（客户端应用编辑的文件即方言源文件）。
    公开 函数 注入教学动作(
        &自我,
        响应值: &JSON值,
        教学诊断列表: &[JSON值],
        原始资源标识: &文本,
    ) -> JSON值 {
        如果 教学诊断列表.为空() {
            返回 响应值.克隆值();
        }
        让 可变 操作集 = 匹配 响应值 {
            JSON值::JSON数组(列表) => 列表.克隆值(),
            _ => 向量::新建(),
        };
        让 界面 = 包::界面消息::全局界面();
        对于 诊断值 在 教学诊断列表 {
            让 代码 = 诊断值["code"].作为字符串().取值或("");
            如果 代码 == "fullwidth" {
                // 全角标点：可修复时提供替换动作；仅提示字符（顿号等）无动作
                让 有值(替换值) = 诊断值["data"]["replacement"].作为字符串().变换(|串| 串.转字符串())
                否则 {
                    继续;
                };
                让 字符值 = 诊断值["data"]["character"].作为字符串().取值或("").转字符串();
                让 范围值 = 诊断值["range"].克隆值();
                让 标题 = 界面.取带参消息("lsp_action_fix_fullwidth", &[&字符值, &替换值]);
                操作集.推入(JSON序列化::JSON格式!({
                    "title": 标题,
                    "kind": "quickfix",
                    "diagnostics": [诊断值],
                    "edit": {
                        "changes": {
                            原始资源标识: [{
                                "range": 范围值,
                                "newText": 替换值
                            }]
                        }
                    }
                }));
            } 否则 如果 代码.以开头("lint-") {
                // 教学检查：行尾插入忽略标记（教师标注故意不修的示例）
                让 有值(行号) = 诊断值["range"]["start"]["line"].作为长整数() 否则 {
                    继续;
                };
                让 有值(条目) = 自我.原始条目(原始资源标识) 否则 {
                    继续;
                };
                让 行尾 = 自身::行尾偏移(&条目.母语内容, 行号 作为 无符号机器整数);
                让 范围值 = JSON序列化::JSON格式!({
                    "start": { "line": 行号, "character": 行尾 },
                    "end": { "line": 行号, "character": 行尾 }
                });
                让 标题 = 界面.取消息("lsp_action_ignore_lint");
                操作集.推入(JSON序列化::JSON格式!({
                    "title": 标题,
                    "kind": "quickfix",
                    "diagnostics": [诊断值],
                    "edit": {
                        "changes": {
                            原始资源标识: [{
                                "range": 范围值,
                                "newText": 格式化!("  // {}", 引擎库::校验::忽略标记)
                            }]
                        }
                    }
                }));
            }
        }
        JSON值::JSON数组(操作集)
    }

    /// 计算指定行（0 起）行尾的 UTF-16 字符偏移；行不存在时回退 0
    函数 行尾偏移(内容: &文本, 行号: 无符号机器整数) -> 无符号整数 {
        内容
            .逐行()
            .取第项(行号)
            .变换(|行文本| 行文本.编码UTF16().计数() 作为 无符号整数)
            .取值或(0)
    }

    /// 映射文档符号响应
    ///
    /// 将每个符号的范围和选择范围映射回原始文件，
    /// 并递归处理子符号。
    公开 函数 映射文档符号响应(&自我, 响应值: &JSON值, 原始资源标识: &文本) -> JSON值 {
        匹配 响应值 {
            JSON值::JSON数组(数组) => {
                让 映射后: 向量<JSON值> = 数组
                    .迭代()
                    .变换(|符号值| 自我.映射单个符号(符号值, 原始资源标识))
                    .收集();
                JSON值::JSON数组(映射后)
            }
            JSON值::空值节点 => JSON值::JSON数组(向量::新建()),
            _ => 响应值.克隆值(),
        }
    }

    /// 递归映射单个文档符号
    函数 映射单个符号(&自我, 符号值: &JSON值, 原始资源标识: &文本) -> JSON值 {
        让 可变 映射项 = 符号值.克隆值();

        // 将符号名反向恢复为中文（如英文入口名 → 主函数）
        如果让 有值(名称) = 符号值.读取条目("name").而后映射(|值| 值.作为字符串())
            && 让 有值(母语名) = 自我.反向查找(名称)
        {
            映射项["name"] = JSON值::字符串值(母语名);
        }

        如果让 有值(范围值) = 符号值.读取条目("range") {
            映射项["range"] = 自我.还原范围(原始资源标识, 范围值);
        }
        如果让 有值(选择范围) = 符号值.读取条目("selectionRange") {
            映射项["selectionRange"] = 自我.还原范围(原始资源标识, 选择范围);
        }
        如果让 有值(子项) = 符号值.读取条目("children").而后映射(|值| 值.作为数组()) {
            让 映射后子项: 向量<JSON值> = 子项
                .迭代()
                .变换(|子值| 自我.映射单个符号(子值, 原始资源标识))
                .收集();
            映射项["children"] = JSON值::JSON数组(映射后子项);
        }
        映射项
    }
}

/// 判断字符串是否为合法 Rust 标识符片段（方法名/类型名，不含泛型）
函数 是标识符(名称: &文本) -> 布尔 {
    让 可变 字符们 = 名称.逐字符();
    模式匹配!(字符们.下一个(), 有值(字符值) 如果 字符值 == '_' || 字符值.是否为字母())
        && 字符们.全部(|字符值| 字符值 == '_' || 字符值.是否为字母数字())
}

/// 从悬停文档提取标题类型名与代码块首行
///
/// - 标题行：加粗的实现标题或类型标题 → 类型名
/// - 代码行：第一个 ``` 代码块内的首个非空行（通常为签名或完整路径）
函数 提取悬停部分(文档串: &文本) -> (选项<字符串>, 选项<字符串>) {
    让 可变 类型名 = 无;
    让 可变 代码行 = 无;
    让 行集: 向量<&文本> = 文档串.逐行().收集();
    对于 (序号, 行文本) 在 行集.迭代().枚举() {
        让 裁剪后 = 行文本.裁剪();
        // 元素数 >= 4 是切片 `t[2..t.元素数() - 2]` 的前置条件：
        // `**`（长度 2）与 `***`（长度 3）同样以 `**` 开头并以 `**` 结尾，
        // 但会得到起点大于终点的越界切片而恐慌（客户端源码文档注释可构造）。
        如果 类型名.是否为无() && 裁剪后.元素数() >= 4 && 裁剪后.以开头("**") && 裁剪后.以结尾("**") {
            让 可变 内部 = 裁剪后[2..裁剪后.元素数() - 2].替换('`', "");
            内部 = 内部.裁剪().转字符串();
            让 名称 = 如果让 有值(剩余) = 内部.去前缀("impl") {
                // 实现头的泛型段之后取第一个标识符
                让 可变 剩余 = 剩余.裁剪();
                当 剩余.以开头('<') {
                    让 结束位置 = 剩余.查找('>').变换(|位置| 位置 + 1).取值或(剩余.元素数());
                    剩余 = &剩余[结束位置..];
                }
                剩余.分割('<').下一个().取值或("").裁剪().转字符串()
            } 否则 {
                // 加粗类型标题 → 类型名
                内部.分割('<').下一个().取值或("").裁剪().转字符串()
            };
            如果 是标识符(&名称) {
                类型名 = 有值(名称);
            }
        }
        如果 代码行.是否为无() && 裁剪后.以开头("```") {
            对于 行值 在 行集.迭代().跳过(序号 + 1) {
                让 行裁剪 = 行值.裁剪();
                如果 行裁剪.为空() {
                    继续;
                }
                如果 行裁剪.以开头("```") {
                    中断;
                }
                代码行 = 有值(行裁剪.转字符串());
                中断;
            }
        }
        如果 代码行.是否为有值() {
            中断;
        }
    }
    // 标记文本纯代码形态（无 ``` 围栏）：整段文本当作代码行
    如果 代码行.是否为无() && !文档串.逐行().任意(|行文本| 行文本.裁剪().以开头("```")) {
        让 裁剪后 = 文档串.裁剪();
        如果 !裁剪后.为空() {
            代码行 = 有值(裁剪后.转字符串());
        }
    }
    (类型名, 代码行)
}

/// 按行拆出内容与行尾换行（兼容 `\n` 与 `\r\n`）
函数 拆分行尾(行文本: &文本) -> (&文本, &文本) {
    如果让 有值(剩余) = 行文本.去后缀("\r\n") {
        (剩余, "\r\n")
    } 否则 如果让 有值(剩余) = 行文本.去后缀('\n') {
        (剩余, "\n")
    } 否则 {
        (行文本, "")
    }
}

/// 提取悬停文档中的所有代码块（块内非空行按 `\n` 连接，保留缩进）
///
/// 无围栏的标记文本把整段视为一个代码块。签名块与内部路径块分开
/// 返回，调用方才不会把路径块当成函数签名去查解释表。
函数 提取悬停代码块(文档串: &文本) -> 向量<字符串> {
    让 行集: 向量<&文本> = 文档串.逐行().收集();
    让 可变 代码块集 = 向量::新建();
    让 可变 序号 = 0;
    当 序号 < 行集.元素数() {
        如果 行集[序号].裁剪左侧().以开头("```") {
            让 可变 闭合 = 序号 + 1;
            当 闭合 < 行集.元素数() && !行集[闭合].裁剪左侧().以开头("```") {
                闭合 += 1;
            }
            让 代码块 = 行集[序号 + 1..闭合]
                .迭代()
                .过滤(|行文本| !行文本.裁剪().为空())
                .复制值()
                .收集::<向量<_>>()
                .连接("\n");
            如果 !代码块.为空() {
                代码块集.推入(代码块);
            }
            序号 = 如果 闭合 < 行集.元素数() { 闭合 + 1 } 否则 { 闭合 };
            继续;
        }
        序号 += 1;
    }
    如果 代码块集.为空() {
        让 整体 = 文档串.裁剪();
        如果 !整体.为空() {
            代码块集.推入(整体.转字符串());
        }
    }
    代码块集
}

/// 选签名块：优先含 `fn `/`macro_rules!` 的块，其次含空白的定义块，
/// 最后退回首块（纯路径或关键字）
函数 选取悬停签名(代码块集: &[字符串]) -> 选项<字符串> {
    让 像函数 = |代码块: &字符串| {
        代码块
            .逐行()
            .任意(|行文本| 行文本.包含("fn ") || 行文本.包含("macro_rules!"))
    };
    让 含空白 = |代码块: &字符串| 代码块.逐行().任意(|行文本| 行文本.分割空白().计数() >= 2);
    如果让 有值(代码块) = 代码块集.迭代().查找(|代码块| 像函数(代码块)) {
        返回 有值(代码块.克隆值());
    }
    如果让 有值(代码块) = 代码块集.迭代().查找(|代码块| 含空白(代码块)) {
        返回 有值(代码块.克隆值());
    }
    代码块集.第一个().克隆副本()
}

/// 从 `impl<T, A> Vec<T, A>` 首行取实现类型名（给 `Vec::push` 之类键用）
函数 提取实现类型(代码块: &文本) -> 选项<字符串> {
    对于 行文本 在 代码块.逐行() {
        让 裁剪后 = 行文本.裁剪();
        让 有值(剩余) = 裁剪后.去前缀("impl") 否则 {
            继续;
        };
        让 可变 剩余 = 剩余.裁剪左侧();
        // 跳过实现关键字后的泛型段（按尖括号深度，兼容嵌套约束）
        如果 剩余.以开头('<') {
            让 可变 深度 = 0usize;
            让 可变 结束位置 = 无;
            对于 (偏移, 字符值) 在 剩余.逐字符枚举() {
                匹配 字符值 {
                    '<' => 深度 += 1,
                    '>' => {
                        深度 -= 1;
                        如果 深度 == 0 {
                            结束位置 = 有值(偏移 + 1);
                            中断;
                        }
                    }
                    _ => {}
                }
            }
            让 结束位置 = 结束位置?;
            剩余 = 剩余.截取(结束位置..)?.裁剪左侧();
        }
        让 名称 = 剩余.分割(['<', ' ', '{', ':']).下一个().取值或("");
        如果 是标识符(名称) {
            返回 有值(名称.转字符串());
        }
    }
    无
}

/// 是否为单行完整路径的代码块（如 `alloc::vec::Vec`、`i18n_virtual::main`）
///
/// 这类块只是语言服务器的内部结构路径，不含空白与签名信息。
函数 是纯路径块(行集: &[&文本]) -> 布尔 {
    让 内容: 向量<&文本> = 行集
        .迭代()
        .变换(|行文本| 行文本.裁剪())
        .过滤(|行文本| !行文本.为空())
        .收集();
    内容.元素数() == 1
        && 内容[0].包含("::")
        && !内容[0].包含(字符::是否为空白)
}

/// 是否为只含虚拟项目内部路径的代码块（如 `i18n_virtual::main`）
///
/// 虚拟项目包路径（Cargo 名 i18n-virtual）不属于学习者世界；
/// 它不属于学习者世界，中文化时整块丢弃（即使它是唯一的代码块）。
函数 是虚拟路径块(行集: &[&文本]) -> 布尔 {
    让 内容: 向量<&文本> = 行集
        .迭代()
        .变换(|行文本| 行文本.裁剪())
        .过滤(|行文本| !行文本.为空())
        .收集();
    内容.元素数() == 1
        && 内容[0].以开头("i18n_virtual::")
        && 是纯路径块(行集)
}

/// 清理 rust-analyzer 悬停签名里的内部注释
///
/// `// matched arm #1`（宏匹配到的分支）与 `// Bounds from impl:`
/// （实现带来的约束）是分析器的内部标注，不属于语言语义；
/// 整行注释返回 `无`（丢弃该行），行尾注释截掉注释部分。
函数 去除悬停标注(行文本: &文本) -> 选项<&文本> {
    如果 行文本.裁剪左侧().以开头("// Bounds from impl") {
        返回 无;
    }
    如果让 有值(位置) = 行文本.查找("// matched arm") {
        让 代码 = 行文本[..位置].裁剪右侧();
        返回 如果 代码.裁剪().为空() {
            无
        } 否则 {
            有值(代码)
        };
    }
    有值(行文本)
}

/// 把完整路径行清洗为段列表（去掉泛型参数与空白）
///
/// 完整标准库路径 → 路径段列表
函数 清洗路径段(行文本: &文本) -> 向量<字符串> {
    行文本.分割("::")
        .变换(|段| 段.分割('<').下一个().取值或("").裁剪())
        .过滤(|段| !段.为空())
        .过滤(|段| 是标识符(段))
        .变换(文本::转字符串)
        .收集()
}

/// 从代码行提取方法名：路径末段（`a::b::c`）、签名（`fn name<...>(`）或宏（`macro_rules! name`）
函数 提取函数名(代码行: &文本) -> 选项<字符串> {
    让 行文本 = 代码行.裁剪();
    如果 行文本.包含("::") {
        如果让 有值(末段) = 行文本.逆分割("::").下一个() {
            让 名称 = 末段.分割(['(', '<', ' ']).下一个().取值或("").裁剪();
            如果 是标识符(名称) {
                返回 有值(名称.转字符串());
            }
        }
        返回 无;
    }
    如果让 有值(位置) = 行文本.查找("fn ") {
        让 之后 = 行文本[位置 + 3..].裁剪左侧();
        让 名称 = 之后.分割(['(', '<', ' ']).下一个().取值或("").裁剪();
        如果 是标识符(名称) {
            返回 有值(名称.转字符串());
        }
    }
    // 宏形式：宏规则声明
    如果让 有值(位置) = 行文本.查找("macro_rules!") {
        让 之后 = 行文本[位置 + 12..].裁剪左侧();
        让 名称 = 之后
            .分割(['(', '<', ' ', '!'])
            .下一个()
            .取值或("")
            .裁剪();
        如果 是标识符(名称) {
            返回 有值(名称.转字符串());
        }
    }
    无
}

/// 提取补全标签的末段标识符
///
/// rust-analyzer 的标签可能带后缀/路径前缀，如
/// `foo(…)`、`Foo {…}`、`m::Spam::Bar(…)`、`m::`；
/// 此处提取末段标识符（如路径末段）用于用户词汇白名单匹配。
/// 标签无标识符段（如纯符号）时返回 无。
公开(超级) 函数 标签标识后缀(标签: &文本) -> 选项<&文本> {
    // 去掉形如 `(…)`、`{…}` 的参数/字段后缀
    让 头部 = 标签.分割(['(', '{']).下一个().取值或(标签);
    // 去掉宏感叹号与模块补全的尾部 `::`（如 `m::`）
    让 头部 = 头部.裁剪().裁剪右侧匹配('!').裁剪右侧匹配("::");
    让 末段 = 头部.逆分割("::").下一个().取值或("").裁剪();
    如果 末段.为空() { 无 } 否则 { 有值(末段) }
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    /// 回归：标题行仅为 `**` / `***` 时不得越界切片恐慌
    ///
    /// 此前判定条件只看前后缀，`t[2..t.元素数() - 2]` 在长度小于 4 时起点大于终点
    /// 直接恐慌；客户端源码的文档注释可构造该悬停内容。
    #[测试]
    函数 悬停仅加粗行不恐慌() {
        对于 文档串 在 ["**", "***", "**\n**", "a\n***\nb"] {
            让 (类型名, _) = 提取悬停部分(文档串);
            断言!(类型名.是否为无(), "纯星号行不应解析出类型名");
        }
    }

    /// 正常标题行仍能提取类型名（含实现前缀与泛型两种形态）
    #[测试]
    函数 悬停类型名提取() {
        让 (类型名, _) = 提取悬停部分("**`Option<T>`**");
        断言相等!(类型名.作为解引用(), 有值("Option"));
        让 (类型名, _) = 提取悬停部分("**impl<T> Option<T>**");
        断言相等!(类型名.作为解引用(), 有值("Option"));
    }

    /// 构造带缓存文档的映射器（关键字 + 别名最小集）
    函数 带文档映射器(
        来源: &文本,
    ) -> (
        响应映射器,
        临时文件::临时目录句柄,
        原子引用计数<包::翻译缓存::转译缓存>,
    ) {
        使用 标准库::集合::哈希映射;
        使用 标准库::同步::原子引用计数;
        让 管理器 = 引擎库::映射管理器::映射管理器::从扁表构造(
            哈希映射::从([
                ("函数".转为(), "fn".转为()),
                ("让".转为(), "let".转为()),
                ("可变".转为(), "mut".转为()),
            ]),
            哈希映射::新建(),
            哈希映射::从([("长度".转为(), "len".转为()), ("向量".转为(), "Vec".转为())]),
        );
        让 临时 = 临时文件::建临时目录().解包();
        让 缓存值: 原子引用计数<包::翻译缓存::转译缓存> =
            包::翻译缓存::转译缓存::新建(管理器, 临时.条目路径().转路径缓冲());
        缓存值
            .更新文档("file:///t/main.zh", 来源, 1)
            .解包();
        (响应映射器::新建(缓存值.克隆值()), 临时, 缓存值)
    }

    /// 补全响应：关键字/方法项母语化（标签/新文本/插入文本/详情/
    /// 标签详情/文档/文本编辑括号补全）；未翻译的第三方英文项
    /// 被母语过滤丢弃；用户自定义英文标识项保留
    #[测试]
    函数 补全响应完整用例() {
        // 源码含用户自定义英文标识：用户函数名与解包（后者用于保留文档项）
        让 来源 = "函数 my_func() {\n    unwrap();\n}\n";
        让 (映射器, _临时, _缓存) = 带文档映射器(来源);
        让 虚拟范围 = JSON序列化::JSON格式!({
            "start": { "line": 0, "character": 0 },
            "end": { "line": 0, "character": 2 }
        });
        让 关键字项 = JSON序列化::JSON格式!({
            "label": "fn", "kind": 14,
            "textEdit": { "range": 虚拟范围, "newText": "fn" },
            "insertText": "fn",
            "detail": "fn item",
            "labelDetails": { "description": "fn()", "detail": "keyword" },
            "documentation": "plain english keyword doc",
            "additionalTextEdits": [{ "range": 虚拟范围, "newText": "use std::io;" }]
        });
        让 方法项 = JSON序列化::JSON格式!({
            "label": "len", "kind": 2,
            "textEdit": { "range": 虚拟范围, "newText": "len" }
        });
        // 未收录第三方英文项：严格母语过滤下必须丢弃
        让 外部项 = JSON序列化::JSON格式!({
            "label": "tokio::spawn", "kind": 3,
            "textEdit": { "range": 虚拟范围, "newText": "tokio::spawn" }
        });
        // 用户自定义英文标识：保留
        让 用户项 = JSON序列化::JSON格式!({
            "label": "my_func", "kind": 3,
            "textEdit": { "range": 虚拟范围, "newText": "my_func" }
        });
        // 文档大白话：markdown 对象形态，选项解包命中解释表
        让 文档项 = JSON序列化::JSON格式!({
            "label": "unwrap", "kind": 2,
            "textEdit": { "range": 虚拟范围, "newText": "unwrap" },
            "documentation": {
                "kind": "markdown",
                "value": "**`Option<T>`**\n\n`Option::unwrap()` 直接取值"
            }
        });
        让 响应值 = JSON序列化::JSON格式!({
            "isIncomplete": 假,
            "items": [关键字项, 方法项, 外部项, 用户项, 文档项]
        });
        让 映射后 = 映射器.映射补全响应(&响应值, "file:///t/main.zh");
        让 项集 = 映射后["items"].作为数组().期望("应有 items 数组");
        // 第三方项被过滤，其余 4 项保留
        断言相等!(项集.元素数(), 4, "应过滤未翻译第三方项：{项集:?}");
        让 按标签: 标准库::集合::哈希映射<_, _> = 项集
            .迭代()
            .变换(|项| (项["label"].作为字符串().取值或("").转字符串(), 项.克隆值()))
            .收集();

        // 关键字项
        让 关键字 = 按标签.读取条目("函数").期望("fn 应反查为 函数");
        断言相等!(关键字["insertText"].作为字符串(), 有值("函数"));
        断言相等!(关键字["textEdit"]["newText"].作为字符串(), 有值("函数"));
        断言相等!(关键字["labelDetails"]["description"].作为字符串(), 有值("函数()"));
        断言!(关键字.读取条目("additionalTextEdits").是否为有值());

        // 方法项：别名反查 + 无括号补代码片段括号
        让 长度项 = 按标签.读取条目("长度").期望("len 应反查为 长度");
        让 新文本 = 长度项["textEdit"]["newText"].作为字符串().解包();
        断言!(
            新文本.以开头("长度("),
            "方法补全应补括号：{新文本}"
        );
        断言相等!(长度项["insertTextFormat"].转长整数(), 有值(2));

        // 用户自定义项保留
        断言!(按标签.包含键("my_func"), "用户英文标识应保留");

        // 文档解释命中大白话表
        让 解包项 = 按标签
            .值()
            .查找(|项| {
                项["textEdit"]["newText"]
                    .作为字符串()
                    .有值且(|文本串| 文本串.包含("unwrap"))
            })
            .或用否则(|| 按标签.读取条目("unwrap"))
            .期望("unwrap 项应保留（源码出现过该标识）");
        让 文档 = 解包项["documentation"].作为字符串().取值或("");
        断言!(
            文档.包含("直接取出里面的值"),
            "应替换为大白话解释：{文档}"
        );
    }

    /// 文档字符串形态 + 无条目数组的响应不恐慌，原样可处理
    #[测试]
    函数 翻译补全文档形态() {
        让 来源 = "函数 主() {}\n";
        让 (映射器, _临时, _缓存) = 带文档映射器(来源);
        // 空值 / 空数组 / 非对象响应均安全
        断言!(
            映射器
                .映射补全响应(&JSON值::空值节点, "file:///t/main.zh")
                .是空值()
        );
        让 数组值 = 映射器.映射补全响应(&JSON序列化::JSON格式!({ "items": [] }), "file:///t/main.zh");
        断言相等!(数组值["items"].作为数组().解包().元素数(), 0);
    }
}
