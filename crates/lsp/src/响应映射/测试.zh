        项["labelDetails"]["detail"].作为字符串().解包(),
        "crate::辅助"
    );
    让 _ = 条目值;
}

/// 语言过滤：非英文方言下补全列表不得串语言。
/// 保留：翻译命中项、母语字符项、用户自定义项（含英文命名）；
/// 过滤：未翻译的外部英文项。
#[测试]
函数 映射补全语言过滤() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    // 用户源码同时含母语定义（自定义函数）与英文命名（辅助函数）
    让 (条目值, _) = 缓存值
        .更新文档(
            "file:///test/main.zh",
            "函数 自定义函数() {} 函数 helper() {}",
            1,
        )
        .解包();

    让 响应值 = JSON序列化::JSON格式!({
        "items": [
            { "label": "let" },
            { "label": "自定义函数" },
            { "label": "helper(…)" },
            { "label": "serde_json" },
            { "label": "BTreeMap" }
        ]
    });
    让 映射后 = 映射器.映射补全响应(&响应值, "file:///test/main.zh");
    让 标签集: 向量<&文本> = 映射后["items"]
        .作为数组()
        .解包()
        .迭代()
        .变换(|项| 项["label"].作为字符串().解包())
        .收集();
    // 翻译命中（英文关键字 → 母语）、母语标识符、用户定义的英文名保留
    断言相等!(标签集, 向量!["让", "自定义函数", "helper(…)"]);
    // 未翻译的外部英文项（serde_json/BTreeMap）被过滤
    断言!(!标签集.包含(&"serde_json"));
    断言!(!标签集.包含(&"BTreeMap"));
    让 _ = 条目值;
}

/// 英文语言包（恒等映射）不启用语言过滤，所有项保留
#[测试]
函数 映射补全恒等包不过滤() {
    让 管理器 = 引擎库::映射管理器::映射管理器::从扁表构造(
        哈希映射::从([("fn".转为(), "fn".转为()), ("let".转为(), "let".转为())]),
        哈希映射::新建(),
        哈希映射::新建(),
    );
    让 临时 = 临时文件::建临时目录().解包();
    让 缓存值 = 转译缓存::新建(管理器, 临时.条目路径().转路径缓冲());
    让 映射器 = 响应映射器::新建(缓存值);

    让 响应值 = JSON序列化::JSON格式!({
        "items": [
            { "label": "let" },
            { "label": "BTreeMap" },
            { "label": "serde_json" }
        ]
    });
    让 映射后 = 映射器.映射补全响应(&响应值, "file:///test/main.zh");
    断言相等!(映射后["items"].作为数组().解包().元素数(), 3);
}

/// 标签末段标识符提取：后缀、路径前缀、模块补全形式
#[测试]
函数 标签标识后缀提取() {
    断言相等!(标签标识后缀("foo(…)"), 有值("foo"));
    断言相等!(标签标识后缀("Foo {…}"), 有值("Foo"));
    断言相等!(标签标识后缀("m::Spam::Bar(…)"), 有值("Bar"));
    断言相等!(标签标识后缀("m::"), 有值("m"));
    断言相等!(标签标识后缀("println!"), 有值("println"));
    断言相等!(标签标识后缀("(…)"), 无);
}

/// 注入添加依赖动作：空候选列表原样返回，非空追加快捷修复动作
#[测试]
函数 注入添加依赖动作测试() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());

    // 空包名：原响应原样返回
    让 原始值 = JSON序列化::JSON格式!([{"title": "既有动作", "kind": "quickfix"}]);
    断言相等!(
        映射器.注入添加依赖动作(&原始值, &[]),
        原始值
    );

    // 非空包名：追加动作，命令字段指向扩展注册的添加依赖命令
    让 注入后 = 映射器.注入添加依赖动作(&原始值, &["serde_json".转字符串()]);
    让 操作集 = 注入后.作为数组().解包();
    断言相等!(操作集.元素数(), 2);
    让 新增项 = &操作集[1];
    断言相等!(新增项["kind"], "quickfix");
    断言相等!(新增项["command"]["command"], "i18n-rust.cargoAdd");
    断言相等!(新增项["command"]["arguments"][0], "serde_json");

    // 非数组响应（如 空值）也能注入
    让 注入后 = 映射器.注入添加依赖动作(&JSON值::空值节点, &["tokio".转字符串()]);
    断言相等!(注入后.作为数组().解包().元素数(), 1);
}

/// 教学诊断注入：全角标点替换动作 + 教学检查忽略动作（方言坐标直用）
#[测试]
函数 注入教学动作测试() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 资源标识 = "file:///test/main.zh";
    缓存值
        .更新文档(资源标识, "函数 主函数() {\n    让 x = 1;\n}", 1)
        .解包();

    让 原始值 = JSON序列化::JSON格式!([{"title": "既有动作", "kind": "quickfix"}]);
    // 无教学诊断：原样返回
    断言相等!(
        映射器.注入教学动作(&原始值, &[], 资源标识),
        原始值
    );

    让 全角诊断值 = JSON序列化::JSON格式!({
        "range": {
            "start": { "line": 0, "character": 8 },
            "end": { "line": 0, "character": 9 }
        },
        "code": "fullwidth",
        "source": "i18n-rust",
        "message": "第 1 行第 9 列：检测到全角标点「，」，应改为半角「,」",
        "data": { "character": "，", "replacement": "," }
    });
    让 检查诊断值 = JSON序列化::JSON格式!({
        "range": {
            "start": { "line": 1, "character": 4 },
            "end": { "line": 1, "character": 5 }
        },
        "code": "lint-untyped-let",
        "source": "i18n-rust",
        "message": "第 2 行第 5 列：`让` 未标注类型"
    });
    让 注入后 = 映射器.注入教学动作(&原始值, &[全角诊断值, 检查诊断值], 资源标识);
    让 操作集 = 注入后.作为数组().解包();
    断言相等!(操作集.元素数(), 3, "既有 1 + 教学 2");

    // 全角标点：同坐标替换为半角
    让 修复动作 = &操作集[1];
    断言相等!(修复动作["kind"], "quickfix");
    断言相等!(修复动作["edit"]["changes"][资源标识][0]["newText"], ",");
    断言相等!(修复动作["edit"]["changes"][资源标识][0]["range"]["start"]["line"], 0);

    // 教学检查：行尾插入忽略标记（第 2 行 0 起行号 1，行尾插入注释）
    让 忽略动作 = &操作集[2];
    断言相等!(忽略动作["kind"], "quickfix");
    让 编辑值 = &忽略动作["edit"]["changes"][资源标识][0];
    断言相等!(编辑值["range"]["start"]["line"], 1);
    断言相等!(
        编辑值["range"]["start"]["character"],
        编辑值["range"]["end"]["character"]
    );
    断言!(
        编辑值["newText"]
            .作为字符串()
            .解包()
            .包含(引擎库::校验::忽略标记)
    );

    // 无可修复字符的全角标点（顿号等）：不产生动作
    让 仅提示值 = JSON序列化::JSON格式!({
        "range": { "start": { "line": 0, "character": 0 }, "end": { "line": 0, "character": 1 } },
        "code": "fullwidth",
        "source": "i18n-rust",
        "message": "仅提示",
        "data": { "character": "、", "replacement": JSON值::空值节点 }
    });
    让 注入后 = 映射器.注入教学动作(&JSON值::空值节点, &[仅提示值], 资源标识);
    断言相等!(注入后.作为数组().解包().元素数(), 0);
}

/// 保留字撞名：声明名字转译后是 Rust 保留字时出提示级诊断
/// （诊断码为 `lint-reserved-name-collision`，与其它教学检查同一发布链）
#[测试]
函数 教学检查诊断保留名撞词() {
    让 管理器 = 引擎库::映射管理器::映射管理器::从扁表构造(
        哈希映射::从([
            ("函数".转为(), "fn".转为()),
            ("让".转为(), "let".转为()),
            ("匹配".转为(), "match".转为()),
        ]),
        哈希映射::新建(),
        哈希映射::新建(),
    );
    让 临时 = 临时文件::建临时目录().解包();
    让 缓存值 = 转译缓存::新建(管理器, 临时.条目路径().转路径缓冲());
    让 (条目值, _) = 缓存值
        .更新文档("file:///test/main.zh", "函数 匹配(数量: 整数) {}", 1)
        .解包();

    让 诊断们 = 超级::诊断文本::教学检查诊断(
        &条目值,
        缓存值.校验词分桶(),
        缓存值.歧义构造器词(),
        缓存值.英文回落映射(),
        缓存值.关键词映射(),
    );
    让 命中项 = 诊断们
        .迭代()
        .查找(|诊断值| 诊断值["code"] == "lint-reserved-name-collision")
        .解包或用否则(|| 恐慌!("应产生保留字撞名诊断：{诊断们:?}"));
    断言相等!(命中项["severity"], 3);
    断言!(命中项["message"].作为字符串().解包().包含("match"));
    // 行列指向声明名字（第 1 行第 4 列，LSP 0 起 → 字符列 3）
    断言相等!(命中项["range"]["start"]["line"], 0);
    断言相等!(命中项["range"]["start"]["character"], 3);
}

/// 未解析导入诊断追加依赖提示（内置中文回退含添加依赖提示键）
#[测试]
函数 翻译诊断未解析导入提示() {
    让 翻译后 = 翻译诊断消息(无, "unresolved import `serde_json`", 无);
    // 反引号内容保留（提取依赖原名），且追加了 rzc 添加依赖提示
    断言!(翻译后.包含("`serde_json`"));
    断言!(翻译后.包含("rzc add serde_json"));
}

/// 诊断翻译不替换反引号内的标识符（避免误伤变量名中的子串）
#[测试]
函数 翻译诊断跳过反引号内容() {
    让 翻译后 = 翻译诊断消息(
        无,
        "cannot find value `expected_value` in this scope",
        无,
    );
    // 反引号内的标识符保持原样
    断言!(翻译后.包含("`expected_value`"));
    // 反引号外的短语已被翻译（不再含英文原短语）
    断言!(!翻译后.包含("cannot find value"));
}

/// E0599（未找到方法）不得把“找到”误译为「实际为」
///
/// 回归：裸词“找到”替换会把未找到方法的消息
/// 产出“没有名为 X 实际为……”（“找到”义被误译），
/// 并与“方法未找到”变体相互干扰。现改为语境键“，实际为 ”。
/// 本测试在所有路径（消息表命中/轻量兜底）下均不得出现「实际为」。
#[测试]
函数 翻译诊断方法未找到不误导() {
    让 翻译后 = 翻译诊断消息(
        无,
        "no method named `拉平` found for struct `Vec<i32>` in the current scope",
        无,
    );
    断言!(!翻译后.包含("实际为"), "{翻译后}");
    让 翻译后二 = 翻译诊断消息(无, "method not found in `Vec<i32>`", 无);
    断言!(!翻译后二.包含("实际为"), "{翻译后二}");
}

/// E0308（期望与实际字样）保留「实际为」翻译（语境键“，实得 ”生效）
///
/// 轻量兜底路径（测试环境未初始化消息表）：英文期望词转中文、
/// 语境键“，实得 ”→“，实际为 ”。
#[测试]
函数 翻译诊断类型不匹配保留实得短语() {
    让 翻译后 = 翻译诊断消息(
        无,
        "mismatched types: expected `char`, found `&str`",
        无,
    );
    断言!(翻译后.包含("实际为"), "{翻译后}");
    // 反引号内类型名保留
    断言!(翻译后.包含("`char`") && 翻译后.包含("`&str`"), "{翻译后}");
}
