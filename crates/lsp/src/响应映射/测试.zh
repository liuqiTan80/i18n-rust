/// 签名帮助：标签与参数标签词法级中文化
#[测试]
函数 映射签名帮助响应翻译() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 响应值 = JSON序列化::JSON格式!({
        "signatures": [{
            "label": "fn push(&mut self, value: T)",
            "parameters": [
                {"label": [0, 2]},
                {"label": "value: T"}
            ]
        }],
        "activeSignature": 0,
        "activeParameter": 1
    });
    让 映射后 = 映射器.映射签名帮助响应(&响应值);
    让 标签 = 映射后["signatures"][0]["label"].作为字符串().解包();
    断言!(标签.以开头("函数 push"), "fn 应译为函数：{标签}");
    断言!(标签.包含("&mut self"), "self 无映射应保留：{标签}");
    // 参数 [起,止] 索引按原标签切片（索引区间对应英文关键字）翻译后转为字符串
    让 参数零 = 映射后["signatures"][0]["parameters"][0]["label"]
        .作为字符串()
        .解包();
    断言相等!(参数零, "函数", "索引形式参数应翻译：{参数零}");
    // 字符串形式参数同样翻译
    让 参数一 = 映射后["signatures"][0]["parameters"][1]["label"]
        .作为字符串()
        .解包();
    断言!(参数一.包含("value: T"), "泛型参数保留：{参数一}");
    断言相等!(映射后["activeParameter"], 1);
}

