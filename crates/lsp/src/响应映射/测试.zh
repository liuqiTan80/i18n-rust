/// 补全响应的文本编辑新文本反向翻译、附加文本编辑位置还原
#[测试]
函数 映射补全文本编辑反向翻译() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 (条目值, _) = 缓存值
        .更新文档("file:///test/main.zh", "让 x = 1;", 1)
        .解包();

    让 响应值 = JSON序列化::JSON格式!({
        "items": [{
            "label": "let",
            "textEdit": {
                "range": { "start": { "line": 0, "character": 0 }, "end": { "line": 0, "character": 3 } },
                "newText": "let"
            },
            "additionalTextEdits": [{
                "range": { "start": { "line": 0, "character": 0 }, "end": { "line": 0, "character": 0 } },
                "newText": "fn 辅助() {}"
            }]
        }]
    });
    让 映射后 = 映射器.映射补全响应(&响应值, "file:///test/main.zh");
    让 项 = &映射后["items"][0];
    // 标签与新文本均还原为母语关键字
    断言相等!(项["label"].作为字符串().解包(), "让");
    断言相等!(项["textEdit"]["newText"].作为字符串().解包(), "让");
    // 代码片段占位符保持原样
    让 片段项 = JSON序列化::JSON格式!({
        "items": [{ "label": "x", "textEdit": {
            "range": { "start": { "line": 0, "character": 0 }, "end": { "line": 0, "character": 0 } },
            "newText": "fn ${1:name}() {}" } }]
    });
    让 片段映射后 = 映射器.映射补全响应(&片段项, "file:///test/main.zh");
    断言相等!(
        片段映射后["items"][0]["textEdit"]["newText"]
            .作为字符串()
            .解包(),
        "fn ${1:name}() {}"
    );
    // 附加文本编辑中的英文关键字被反向翻译
    断言相等!(
        项["additionalTextEdits"][0]["newText"].作为字符串().解包(),
        "函数 辅助() {}"
    );
    让 _ = 条目值;
}

/// 标签详情反向翻译：VS Code 提示框右侧优先显示此字段，
/// 英文签名必须还原为母语（如 函数()）
#[测试]
函数 映射补全标签详情翻译() {
