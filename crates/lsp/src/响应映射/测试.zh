    断言!(
        诊断们[0]["message"].作为字符串().解包().包含("缺失.html"),
        "保留的诊断应为真实缺失的资源：{映射后}"
    );
}

/// 文档高亮响应的范围必须还原为母语坐标
#[测试]
函数 映射文档高亮响应测试() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 (_条目值, _) = 缓存值
        .更新文档("file:///test/main.zh", "让 x = 1;\n让 y = x;", 1)
        .解包();

    // 英文坐标（英文关键字占 3 列；第 0 行的 x 在英文列 4，第 1 行赋值后的 x 在英文列 8）
    让 响应值 = JSON序列化::JSON格式!([
        { "range": { "start": { "line": 0, "character": 4 }, "end": { "line": 0, "character": 5 } }, "kind": 2 },
        { "range": { "start": { "line": 1, "character": 8 }, "end": { "line": 1, "character": 9 } }, "kind": 2 }
    ]);
    让 映射后 = 映射器.映射文档高亮响应(&响应值, "file:///test/main.zh");
    // 中文列："让 x" 中 x 在列 2（"让" 占 1 个 UTF-16 单元）；"让 y = x" 中 x 在列 6
    断言相等!(映射后[0]["range"]["start"]["character"], 2);
    断言相等!(映射后[1]["range"]["start"]["character"], 6);
    断言相等!(映射后[0]["kind"], 2);

    // 空响应 → 空数组
    断言相等!(
        映射器.映射文档高亮响应(&JSON值::空值节点, ""),
        JSON值::JSON数组(向量::新建())
    );
}

/// 语义着色响应的增量编码必须还原为母语坐标，
/// 且长度按映射后的列差重算（关键字替换改变列宽）
#[测试]
函数 映射语义记号响应测试() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 (_条目值, _) = 缓存值
        .更新文档("file:///test/main.zh", "让 x = 1;\n让 y = x;", 1)
        .解包();

    // 英文坐标（英文关键字占 3 列，变量 x/y 在列 4/8）；
    // 增量编码：[增量行, 增量起列, 长度, 记号类型, 记号修饰]
    让 响应值 = JSON序列化::JSON格式!({
        "resultId": "abc",
        "data": [
            0, 0, 3, 14, 0,   // 关键字 第0行 第0列
            0, 4, 1, 6, 0,    // x     行0 列4
            1, 4, 1, 6, 0,    // y     行1 列4（跨行，列重置为绝对）
            0, 4, 1, 6, 0     // x     行1 列8
        ]
    });
    让 映射后 = 映射器.映射语义记号响应(&响应值, "file:///test/main.zh");
    // 结果标识透传；重新增量编码后的中文坐标：
    // 让(0,0,长度1)、x(0,2)、y(1,2)、x(1,6)
    断言相等!(映射后["resultId"], "abc");
    断言相等!(
        映射后["data"],
        JSON序列化::JSON格式!([0, 0, 1, 14, 0, 0, 2, 1, 6, 0, 1, 2, 1, 6, 0, 0, 4, 1, 6, 0])
    );
}

/// 悬停命中解释表：完整路径降级匹配短路径键（完整标准库路径）
#[测试]
函数 映射悬停响应完整路径命中() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 文档串 =
        "```rust\nstd::option::Option<T>::unwrap\n```\n\nPanics if the value is a [`None`]...";
    让 响应值 = JSON序列化::JSON格式!({"contents": {"kind": "markdown", "value": 文档串}});
    让 映射后 = 映射器.映射悬停响应(&响应值, "file:///test/main.zh");
    让 文本串 = 映射后["contents"]["value"].作为字符串().解包();
    断言!(文本串.以开头("**大白话："), "应插入加粗提示: {文本串}");
    断言!(
        文本串.包含("直接取出"),
        "解释应为 unwrap 的大白话: {文本串}"
    );
    断言!(文本串.以结尾(文档串), "原文应保留在提示之后: {文本串}");
}

/// 悬停命中解释表：实现标题 + 签名行 → 短路径键（选项的解包）
/// 代码块中文化后正文原样保留（正文是英文文档，只翻代码片段）
#[测试]
函数 映射悬停响应实现标题命中() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 文档串 = "**`impl<T> Option<T>`**\n\n```rust\npub fn unwrap(self) -> T\n```\n\nPanics if the value is a None...";
    让 响应值 = JSON序列化::JSON格式!({"contents": {"kind": "markdown", "value": 文档串}});
    让 映射后 = 映射器.映射悬停响应(&响应值, "file:///test/main.zh");
    让 文本串 = 映射后["contents"]["value"].作为字符串().解包();
    断言!(文本串.以开头("**大白话："), "应插入加粗提示: {文本串}");
    // 代码块内的英文关键字译成中文，正文英文说明不按词表乱换
    断言!(文本串.包含("pub 函数 unwrap(self) -> T"), "{文本串}");
    断言!(文本串.以结尾("Panics if the value is a None..."), "{文本串}");
}

/// 悬停未命中解释表：不加提示，但代码块仍要中文化（正文原样）
