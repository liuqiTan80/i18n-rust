            "label": "my_func",
            "detail": "fn my_func()",
            "labelDetails": {
                "description": "fn()",
                "detail": "crate::辅助"
            }
        }]
    });
    让 映射后 = 映射器.映射补全响应(&响应值, "file:///test/main.zh");
    让 项 = &映射后["items"][0];
    断言相等!(项["detail"].作为字符串().解包(), "函数 my_func()");
    断言相等!(
        项["labelDetails"]["description"].作为字符串().解包(),
