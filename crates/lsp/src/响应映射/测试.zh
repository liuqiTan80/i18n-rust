/// 自定义符号悬停：丢弃虚拟项目内部路径块，不挂入口函数说明
///
/// rust-analyzer 对用户符号会先返回内部路径块（`i18n_virtual::main`），
/// 再返回真实签名块。路径块对学习者无意义，且拿它查解释表会把主函数
/// 的「程序入口函数」误挂到任意自定义函数上。
#[测试]
函数 映射悬停响应用户符号跳过虚拟路径() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 文档串 = "```rust\ni18n_virtual::main\n```\n\n```rust\nfn 缺失键逐级回退(表: 向量<整数>)\n```\n\nReturns the match.";
    让 响应值 = JSON序列化::JSON格式!({"contents": {"kind": "markdown", "value": 文档串}});
    让 映射后 = 映射器.映射悬停响应(&响应值, "file:///test/main.zh");
    让 文本串 = 映射后["contents"]["value"].作为字符串().解包();
    断言!(!文本串.包含("i18n_virtual"), "不应泄露虚拟路径: {文本串}");
    断言!(!文本串.包含("程序入口函数"), "不应误挂 main 说明: {文本串}");
    断言!(
        文本串.包含("函数 缺失键逐级回退(表: 向量<整数>)"),
        "签名应完整中文化: {文本串}"
    );
}

