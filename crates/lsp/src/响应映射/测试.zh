    让 文档串 = "```rust\nfn\n```\n\nFunction keyword";
    让 响应值 = JSON序列化::JSON格式!({"contents": {"kind": "markdown", "value": 文档串}});
    让 映射后 = 映射器.映射悬停响应(&响应值, "file:///test/main.zh");
    让 文本串 = 映射后["contents"]["value"].作为字符串().解包();
    断言!(文本串.以开头("**函数**"), "标题应为中文关键字: {文本串}");
    断言!(
        文本串.包含("声明函数的关键字"),
