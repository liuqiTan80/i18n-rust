//! 响应映射单元测试（自原单文件测试模块原样迁移）。

使用 超级::诊断文本::翻译诊断消息;
使用 超级::响应::标签标识后缀;
使用 超级::*;
使用 包::翻译缓存::转译缓存;
使用 标准库::集合::哈希映射;
使用 标准库::同步::原子引用计数;

函数 构造测试缓存() -> (原子引用计数<转译缓存>, 临时文件::临时目录句柄) {
    让 管理器 = 引擎库::映射管理器::映射管理器::从扁表构造(
        哈希映射::从([("函数".转为(), "fn".转为()), ("让".转为(), "let".转为())]),
        哈希映射::新建(),
        哈希映射::新建(),
    );
    让 临时 = 临时文件::建临时目录().解包();
    让 缓存值 = 转译缓存::新建(管理器, 临时.条目路径().转路径缓冲());
    (缓存值, 临时)
}

#[测试]
函数 还原资源标识测试() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());

    让 (条目值, _) = 缓存值
        .更新文档("file:///test/main.zh", "让 x = 1;", 1)
        .解包();

    断言相等!(
        映射器.还原资源标识(&条目值.虚拟资源标识),
        "file:///test/main.zh"
    );
}

#[测试]
函数 还原范围测试() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());

    让 (条目值, _) = 缓存值
        .更新文档("file:///test/main.zh", "让 x = 1;\n让 y = 2;", 1)
        .解包();

    // 行映射：虚拟行号还原为中文行号（1:1）
    // 列映射：让 → 英文关键字 每行偏移 +2，英文列 4-5（y）对应中文列 2-3
    让 范围值 = 映射器.还原范围(
        &条目值.虚拟资源标识,
        &JSON序列化::JSON格式!({ "start": { "line": 1, "character": 4 }, "end": { "line": 1, "character": 5 } }),
    );
    断言相等!(范围值["start"]["line"], 1);
    断言相等!(范围值["start"]["character"], 2);
    断言相等!(范围值["end"]["line"], 1);
    断言相等!(范围值["end"]["character"], 3);
}

#[测试]
函数 映射引用响应测试() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 (条目值, _) = 缓存值
        .更新文档("file:///test/main.zh", "让 x = 1;\n函数 主() {}", 1)
        .解包();

    让 响应值 = JSON序列化::JSON格式!([
        {
            "uri": 条目值.虚拟资源标识,
            "range": {
                "start": { "line": 1, "character": 0 },
                "end": { "line": 1, "character": 2 }
            }
        }
    ]);

    让 映射后 = 映射器.映射引用响应(&响应值);
    断言相等!(映射后[0]["uri"].作为字符串().解包(), "file:///test/main.zh");
    断言相等!(映射后[0]["range"]["start"]["line"], 1);
    断言相等!(映射后[0]["range"]["start"]["character"], 0);

    // 无结果（空值）时应返回空数组而不是 空值
    断言相等!(
        映射器.映射引用响应(&JSON值::空值节点),
        JSON值::JSON数组(向量::新建())
    );
}

#[测试]
函数 映射重命名响应跨文件() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 (条目甲, _) = 缓存值
        .更新文档("file:///test/main.zh", "让 x = 1;\n函数 主() {}", 1)
        .解包();
    让 (条目乙, _) = 缓存值
        .更新文档("file:///test/lib.zh", "函数 主() {}", 1)
        .解包();

    // rust-analyzer 返回跨文件编辑（变更表形式）
    让 响应值 = JSON序列化::JSON格式!({
        "changes": {
            条目甲.虚拟资源标识.克隆值(): [{
                "range": {
                    "start": { "line": 0, "character": 0 },
                    "end": { "line": 0, "character": 2 }
                },
                "newText": "fn"
            }],
            条目乙.虚拟资源标识.克隆值(): [{
                "range": {
                    "start": { "line": 0, "character": 0 },
                    "end": { "line": 0, "character": 2 }
                },
                "newText": "fn"
            }]
        }
    });

    让 映射后 = 映射器.映射重命名响应(&响应值);
    让 变更表 = 映射后["changes"].作为对象().解包();

    // 两个文件的资源标识都还原为 .zh 源文件
    断言!(变更表.包含键("file:///test/main.zh"));
    断言!(变更表.包含键("file:///test/lib.zh"));

    // 新文本反向翻译：英文关键字 → 母语
    断言相等!(
        变更表["file:///test/main.zh"][0]["newText"]
            .作为字符串()
            .解包(),
        "函数"
    );
    断言相等!(
        变更表["file:///test/lib.zh"][0]["newText"]
            .作为字符串()
            .解包(),
        "函数"
    );

    // 文档变更形式也应正确处理
    让 响应值二 = JSON序列化::JSON格式!({
        "documentChanges": [{
            "textDocument": { "uri": 条目甲.虚拟资源标识.克隆值(), "version": JSON值::空值节点 },
            "edits": [{
                "range": {
                    "start": { "line": 0, "character": 0 },
                    "end": { "line": 0, "character": 2 }
                },
                "newText": "fn"
            }]
        }]
    });
    让 映射后二 = 映射器.映射重命名响应(&响应值二);
    断言相等!(
        映射后二["documentChanges"][0]["textDocument"]["uri"]
            .作为字符串()
            .解包(),
        "file:///test/main.zh"
    );
    断言相等!(
        映射后二["documentChanges"][0]["edits"][0]["newText"]
            .作为字符串()
            .解包(),
        "函数"
    );
}

#[测试]
函数 映射代码操作响应测试() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 (条目值, _) = 缓存值
        .更新文档("file:///test/main.zh", "让 x = 1;", 1)
        .解包();

    让 响应值 = JSON序列化::JSON格式!([
        {
            "title": "导入 std::io",
            "kind": "quickfix",
            "edit": {
                "changes": {
                    条目值.虚拟资源标识.克隆值(): [{
                        "range": {
                            "start": { "line": 0, "character": 0 },
                            "end": { "line": 0, "character": 2 }
                        },
                        "newText": "use std::io;"
                    }]
                }
            }
        }
    ]);

    让 映射后 = 映射器.映射代码操作响应(&响应值, "file:///test/main.zh");
    让 变更表 = 映射后[0]["edit"]["changes"].作为对象().解包();
    断言!(变更表.包含键("file:///test/main.zh"));

    // 代码操作插入的英文代码经反向翻译：测试映射表中无“使用”关键字，
    // 故保持英文原样（若语言包含母语“使用”与英文的映射，则会被还原为母语）
    断言相等!(
        变更表["file:///test/main.zh"][0]["newText"]
            .作为字符串()
            .解包(),
        "use std::io;"
    );

    // 空响应 → 空数组
    断言相等!(
        映射器.映射代码操作响应(&JSON值::空值节点, ""),
        JSON值::JSON数组(向量::新建())
    );
}

#[测试]
函数 映射代码操作解析响应测试() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 (条目值, _) = 缓存值
        .更新文档("file:///test/main.zh", "让 x = 1;", 1)
        .解包();

    // 解析响应是单个代码操作对象（非数组），编辑走文档变更
    让 响应值 = JSON序列化::JSON格式!({
        "title": "改为 pub(crate)",
        "kind": "refactor.rewrite",
        "data": { "id": 1 },
        "edit": {
            "documentChanges": [{
                "textDocument": { "uri": 条目值.虚拟资源标识, "version": 1 },
                "edits": [{
                    "range": {
                        "start": { "line": 0, "character": 0 },
                        "end": { "line": 0, "character": 0 }
                    },
                    "newText": "pub(crate) "
                }]
            }]
        }
    });

    让 映射后 = 映射器.映射代码操作解析响应(&响应值);
    // 虚拟资源标识必须还原为原始文件资源标识（否则 VS Code 无法应用编辑）
    断言相等!(
        映射后["edit"]["documentChanges"][0]["textDocument"]["uri"]
            .作为字符串()
            .解包(),
        "file:///test/main.zh"
    );
    // 位置从虚拟坐标映射回母语坐标
    让 范围值 = &映射后["edit"]["documentChanges"][0]["edits"][0]["range"];
    断言相等!(范围值["start"]["line"], 0);
    断言相等!(范围值["start"]["character"], 0);
    // 数据与标题字段原样保留
    断言相等!(映射后["data"]["id"], 1);
    断言相等!(映射后["title"].作为字符串().解包(), "改为 pub(crate)");

    // 无编辑字段时原样返回
    让 普通值 = JSON序列化::JSON格式!({"title": "仅命令", "command": {"title": "c", "command": "x"}});
    断言相等!(映射器.映射代码操作解析响应(&普通值), 普通值);
    // 空响应原样返回
    断言相等!(
        映射器.映射代码操作解析响应(&JSON值::空值节点),
        JSON值::空值节点
    );
}

#[测试]
函数 映射文档符号响应测试() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 (条目值, _) = 缓存值
        .更新文档("file:///test/main.zh", "函数 主() {\n    让 x = 1;\n}", 1)
        .解包();
    断言相等!(条目值.英文内容, "fn 主() {\n    let x = 1;\n}");

    让 响应值 = JSON序列化::JSON格式!([
        {
            "name": "fn",
            "kind": 12,
            "range": {
                "start": { "line": 0, "character": 0 },
                "end": { "line": 2, "character": 1 }
            },
            "selectionRange": {
                "start": { "line": 0, "character": 0 },
                "end": { "line": 0, "character": 2 }
            },
            "children": [{
                "name": "let",
                "kind": 13,
                "range": {
                    "start": { "line": 1, "character": 0 },
                    "end": { "line": 1, "character": 3 }
                },
                "selectionRange": {
                    "start": { "line": 1, "character": 0 },
                    "end": { "line": 1, "character": 3 }
                }
            }]
        }
    ]);

    让 映射后 = 映射器.映射文档符号响应(&响应值, "file:///test/main.zh");

    // 符号名恢复为中文
    断言相等!(映射后[0]["name"].作为字符串().解包(), "函数");
    断言相等!(映射后[0]["children"][0]["name"].作为字符串().解包(), "让");

    // 位置映射回母语文件（行 1:1、列按偏移转换）
    断言相等!(映射后[0]["range"]["start"]["line"], 0);
    断言相等!(映射后[0]["selectionRange"]["start"]["character"], 0);
    断言相等!(映射后[0]["children"][0]["range"]["start"]["line"], 1);

    // 空响应 → 空数组
    断言相等!(
        映射器.映射文档符号响应(&JSON值::空值节点, ""),
        JSON值::JSON数组(向量::新建())
    );
}

#[测试]
函数 映射诊断所有权详情入数据() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    // 多行文档，保证行映射存在（诊断行号 2/4 可还原）
    让 (条目值, _) = 缓存值
        .更新文档(
            "file:///test/main.zh",
            "让 数据 = 1;\n让 a = 1;\n让 b = 1;\n让 c = 1;\n让 d = 1;",
            1,
        )
        .解包();

    // rust-analyzer 风格的 E0382 诊断：主范围是再次使用处，关联信息标记移动
    让 诊断值 = JSON序列化::JSON格式!({
        "range": {
            "start": { "line": 4, "character": 4 },
            "end": { "line": 4, "character": 8 }
        },
        "severity": 1,
        "code": "E0382",
        "source": "rust-analyzer",
        "message": "use of moved value: `数据`",
        "relatedInformation": [{
            "location": {
                "uri": 条目值.虚拟资源标识.克隆值(),
                "range": {
                    "start": { "line": 2, "character": 8 },
                    "end": { "line": 2, "character": 10 }
                }
            },
            "message": "value moved here"
        }]
    });
    让 参数值 = JSON序列化::JSON格式!({
        "uri": 条目值.虚拟资源标识,
        "version": 1,
        "diagnostics": [诊断值]
    });

    让 映射后 = 映射器.映射诊断(&参数值);
    让 数据值 = 映射后["diagnostics"][0]["data"]
        .作为对象()
        .期望("所有权诊断的 data 字段应为 JSON 对象");

    // 变量名与位置（LSP 0 起行号 +1 → 1 起）
    断言相等!(数据值["变量名"], "数据");
    断言相等!(数据值["移动发生"]["起始行"], 3);
    断言相等!(数据值["再次使用"]["起始行"], 5);
    断言!(数据值["借用发生"] == JSON值::空值节点);
}

#[测试]
函数 映射诊断借用冲突两侧不互换() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 (条目值, _) = 缓存值
        .更新文档(
            "file:///test/main.zh",
            "让 a = 1;\n让 b = 1;\n让 c = 1;\n让 d = 1;\n让 e = 1;\n让 f = 1;\n让 g = 1;\n让 h = 1;",
            1,
        )
        .解包();

    // rust-analyzer 风格的 E0502：主范围是被拒的可变借用（1 起第 7 行），
    // 关联信息里是不可变借用（第 5 行，与 later-used 同行，与实机一致）
    让 关联信息 = |行号: 无符号整数, 消息: &文本| {
        JSON序列化::JSON格式!({
            "location": {
                "uri": 条目值.虚拟资源标识.克隆值(),
                "range": {
                    "start": { "line": 行号, "character": 8 },
                    "end": { "line": 行号, "character": 12 }
                }
            },
            "message": 消息
        })
    };
    让 诊断值 = JSON序列化::JSON格式!({
        "range": {
            "start": { "line": 6, "character": 8 },
            "end": { "line": 6, "character": 18 }
        },
        "severity": 1,
        "code": "E0502",
        "source": "rust-analyzer",
        "message": "cannot borrow `分数` as mutable because it is also borrowed as immutable",
        "relatedInformation": [
            关联信息(4, "immutable borrow occurs here"),
            关联信息(4, "immutable borrow later used here"),
        ]
    });
    让 参数值 = JSON序列化::JSON格式!({
        "uri": 条目值.虚拟资源标识,
        "version": 1,
        "diagnostics": [诊断值]
    });

    让 映射后 = 映射器.映射诊断(&参数值);
    让 数据值 = 映射后["diagnostics"][0]["data"]
        .作为对象()
        .期望("所有权诊断的 data 字段应为 JSON 对象");
    断言相等!(数据值["变量名"], "分数");
    // 可变借用取主范围（第 7 行），不可变借用取关联信息（第 5 行），
    // 两侧不得互换（否则叙事又把行号读反）
    断言相等!(数据值["借用冲突"]["可变借用"]["起始行"], 7);
    断言相等!(数据值["借用冲突"]["不可变借用"]["起始行"], 5);
}

#[测试]
函数 映射诊断非所有权无详情() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 (条目值, _) = 缓存值
        .更新文档("file:///test/main.zh", "让 x = 1;", 1)
        .解包();

    // 类型不匹配错误不应附带所有权详情
    让 诊断值 = JSON序列化::JSON格式!({
        "range": {
            "start": { "line": 0, "character": 4 },
            "end": { "line": 0, "character": 8 }
        },
        "severity": 1,
        "message": "mismatched types",
        "relatedInformation": []
    });
    让 参数值 = JSON序列化::JSON格式!({
        "uri": 条目值.虚拟资源标识,
        "version": 1,
        "diagnostics": [诊断值]
    });

    让 映射后 = 映射器.映射诊断(&参数值);
    断言!(映射后["diagnostics"][0].读取条目("data").是否为无());
}

/// 虚拟项目固有的过程宏误报被过滤（#3 症状二）：命令行解析库辅助属性
/// `cannot find attribute` 与 `cannot find derive macro` 不发布；
/// 普通诊断（类型错误、未解析导入）照常保留
#[测试]
函数 映射诊断过滤过程宏噪音() {
    让 (缓存值, _临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    让 (条目值, _) = 缓存值
        .更新文档("file:///test/main.zh", "让 x = 1;", 1)
        .解包();

    让 属性噪音 = JSON序列化::JSON格式!({
        "range": {
            "start": { "line": 0, "character": 0 },
            "end": { "line": 0, "character": 4 }
        },
        "severity": 1,
        "message": "cannot find attribute `arg` in this scope"
    });
    让 派生噪音 = JSON序列化::JSON格式!({
        "range": {
            "start": { "line": 0, "character": 0 },
            "end": { "line": 0, "character": 4 }
        },
        "severity": 1,
        "message": "cannot find derive macro `Parser` in this scope"
    });
    让 未解析 = JSON序列化::JSON格式!({
        "range": {
            "start": { "line": 0, "character": 0 },
            "end": { "line": 0, "character": 4 }
        },
        "severity": 1,
        "message": "unresolved import `clap`"
    });
    让 参数值 = JSON序列化::JSON格式!({
        "uri": 条目值.虚拟资源标识,
        "version": 1,
        "diagnostics": [属性噪音, 派生噪音, 未解析]
    });

    让 映射后 = 映射器.映射诊断(&参数值);
    让 诊断们 = 映射后["diagnostics"].作为数组().解包();
    // 两类过程宏误报被过滤，未解析导入保留（快速修复输入；
    // 消息可能已被汉化，按反引号内的包名断言）
    断言相等!(诊断们.元素数(), 1, "仅保留 unresolved import：{映射后}");
    断言!(
        诊断们[0]["message"].作为字符串().解包().包含("clap"),
        "保留的诊断应为 unresolved import：{映射后}"
    );
}

/// 虚拟项目“引用未打开模块文件”的 E0433 误报被过滤：
/// 同名方言文件存在于条目同目录时过滤（打开后即可解析）；
/// 文件不存在（拼写错误）时诊断保留供用户修正
#[测试]
函数 映射诊断过滤未打开模块引用() {
    让 (缓存值, 临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    // 同目录存在被引用但未打开的模块文件
    标准库::文件系统::写入(临时.条目路径().连接("日志设置.zh"), "公开 函数 初始化() {}").解包();
    让 主资源标识 = 格式化!("file://{}", 临时.条目路径().连接("main.zh").展示());
    让 (条目值, _) = 缓存值.更新文档(&主资源标识, "让 x = 1;", 1).解包();

    让 构造诊断 = |消息: &文本| {
        JSON序列化::JSON格式!({
            "range": {
                "start": { "line": 0, "character": 0 },
                "end": { "line": 0, "character": 1 }
            },
            "severity": 1,
            "code": "E0433",
            "message": 消息
        })
    };
    让 未打开 = 构造诊断("cannot find module or crate `日志设置` in this scope");
    让 拼写错误 = 构造诊断("cannot find module or crate `日志设值` in this scope");
    让 参数值 = JSON序列化::JSON格式!({
        "uri": 条目值.虚拟资源标识,
        "version": 1,
        "diagnostics": [未打开, 拼写错误]
    });

    让 映射后 = 映射器.映射诊断(&参数值);
    让 诊断们 = 映射后["diagnostics"].作为数组().解包();
    // 未打开模块（文件存在）的误报被过滤，拼写错误保留
    断言相等!(诊断们.元素数(), 1, "仅保留拼写错误诊断：{映射后}");
    断言!(
        诊断们[0]["message"].作为字符串().解包().包含("日志设值"),
        "保留的诊断应为拼写错误：{映射后}"
    );
}

/// 虚拟项目“引用未打开模块文件”误报的新消息格式（rust-analyzer 0.3.3025）：
/// 新 E0432（未解析导入包路径 X）、新 E0433（在包内找不到 X
/// ）与同伴提示（根作用域无 X）在同名方言文件存在时过滤；
/// 文件不存在的拼写错误保留
#[测试]
函数 映射诊断过滤未打开模块引用新格式() {
    让 (缓存值, 临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    // 同目录存在被引用但未打开的模块文件
    标准库::文件系统::写入(临时.条目路径().连接("日志设置.zh"), "公开 函数 初始化() {}").解包();
    让 主资源标识 = 格式化!("file://{}", 临时.条目路径().连接("main.zh").展示());
    让 (条目值, _) = 缓存值.更新文档(&主资源标识, "让 x = 1;", 1).解包();

    让 构造诊断 = |代码: &文本, 严重级: 无符号整数, 消息: &文本| {
        JSON序列化::JSON格式!({
            "range": {
                "start": { "line": 0, "character": 0 },
                "end": { "line": 0, "character": 1 }
            },
            "severity": 严重级,
            "code": 代码,
            "message": 消息
        })
    };
    让 旧四三二 = 构造诊断(
        "E0432",
        1,
        "unresolved import `crate::日志设置`\ncould not find `日志设置` in the crate root",
    );
    让 旧四三三 = 构造诊断("E0433", 1, "cannot find `日志设置` in `crate`");
    让 提示值 = 构造诊断("E0432", 4, "no `日志设置` in the root");
    让 四三二拼错 = 构造诊断(
        "E0432",
        1,
        "unresolved import `crate::日志设值`\ncould not find `日志设值` in the crate root",
    );
    让 四三三拼错 = 构造诊断("E0433", 1, "cannot find `日志设值` in `crate`");
    让 参数值 = JSON序列化::JSON格式!({
        "uri": 条目值.虚拟资源标识,
        "version": 1,
        "diagnostics": [旧四三二, 旧四三三, 提示值, 四三二拼错, 四三三拼错]
    });

    让 映射后 = 映射器.映射诊断(&参数值);
    让 诊断们 = 映射后["diagnostics"].作为数组().解包();
    // 三处“文件存在”的误报被过滤，两处拼写错误保留
    断言相等!(诊断们.元素数(), 2, "仅保留拼写错误诊断：{映射后}");
    对于 诊断值 在 诊断们 {
        断言!(
            诊断值["message"].作为字符串().解包().包含("日志设值"),
            "保留的诊断应为拼写错误：{映射后}"
        );
    }
}

/// 虚拟项目“第三方依赖缺失”的误报被过滤：
/// 候选包名出现在项目最近 Cargo.toml 依赖表中（含目标平台节与
/// `-`/`_` 归一化）时过滤；未声明的库（拼写错误/待添加）保留
#[测试]
函数 映射诊断过滤项目依赖() {
    让 (缓存值, 临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    // 用户项目置于子目录：与虚拟项目根（临时）隔离，避免虚拟项目生成的
    // Cargo.toml 覆盖测试清单（真实场景中两者天然分离）
    让 项目目录 = 临时.条目路径().连接("proj");
    标准库::文件系统::创建所有目录(&项目目录).解包();
    标准库::文件系统::写入(
        项目目录.连接("Cargo.toml"),
        r#"[package]
name = "demo"
version = "0.1.0"

[dependencies]
serde = "1"
serde-json = "1"

[target.'cfg(unix)'.dependencies]
getrandom = "0.2"
"#,
    )
    .解包();
    让 主资源标识 = 格式化!("file://{}", 项目目录.连接("main.zh").展示());
    让 (条目值, _) = 缓存值.更新文档(&主资源标识, "让 x = 1;", 1).解包();

    让 构造诊断 = |消息: &文本| {
        JSON序列化::JSON格式!({
            "range": {
                "start": { "line": 0, "character": 0 },
                "end": { "line": 0, "character": 1 }
            },
            "severity": 1,
            "message": 消息
        })
    };
    让 参数值 = JSON序列化::JSON格式!({
        "uri": 条目值.虚拟资源标识,
        "version": 1,
        "diagnostics": [
            构造诊断("unresolved import `serde`"),
            构造诊断("unresolved import `serde_json::Value`"),
            构造诊断("cannot find module or crate `getrandom` in this scope"),
            构造诊断("unresolved import `clap`")
        ]
    });

    让 映射后 = 映射器.映射诊断(&参数值);
    让 诊断们 = 映射后["diagnostics"].作为数组().解包();
    // 依赖表中的名字被过滤，未声明的命令行解析库保留
    断言相等!(诊断们.元素数(), 1, "仅保留未声明依赖：{映射后}");
    断言!(
        诊断们[0]["message"].作为字符串().解包().包含("clap"),
        "保留的诊断应为未声明依赖：{映射后}"
    );
}

/// 虚拟项目“内嵌字符串资源缺失”的误报被过滤：
/// 资源文件在原方言文件同目录存在（消息路径按虚拟项目根显示，带
/// 源目录前缀）时过滤；资源真实缺失时保留
#[测试]
函数 映射诊断过滤缺失内嵌资源() {
    让 (缓存值, 临时) = 构造测试缓存();
    让 映射器 = 响应映射器::新建(缓存值.克隆值());
    标准库::文件系统::写入(临时.条目路径().连接("页面.html"), "<html></html>").解包();
    让 主资源标识 = 格式化!("file://{}", 临时.条目路径().连接("main.zh").展示());
    让 (条目值, _) = 缓存值.更新文档(&主资源标识, "让 x = 1;", 1).解包();

    让 构造诊断 = |消息: &文本| {
        JSON序列化::JSON格式!({
            "range": {
                "start": { "line": 0, "character": 0 },
                "end": { "line": 0, "character": 1 }
            },
            "severity": 1,
            "message": 消息
        })
    };
    让 参数值 = JSON序列化::JSON格式!({
        "uri": 条目值.虚拟资源标识,
        "version": 1,
        "diagnostics": [
            构造诊断("couldn't read `src/页面.html`: No such file or directory (os error 2)"),
            构造诊断("couldn't read `src/缺失.html`: No such file or directory (os error 2)")
        ]
    });

    让 映射后 = 映射器.映射诊断(&参数值);
    让 诊断们 = 映射后["diagnostics"].作为数组().解包();
    // 原目录存在的资源误报被过滤，真实缺失的保留
