//! 分析器连接模块
//!
//! 管理 rust-analyzer 子进程的生命周期：启动、消息收发、关闭。
//! 通过标准输入/标准输出以语言服务协议（内容长度字段分帧）与之通信。

使用 标准库::输入输出::{缓冲读取器, 缓冲读取特征, 写入特征};
使用 标准库::路径::路径缓冲;
使用 标准库::进程::{子进程, 子进程输入, 命令, 标准流};
使用 标准库::同步::原子::{原子布尔, 内存顺序};
使用 标准库::同步::{互斥锁, 原子引用计数};
使用 标准库::线程;

使用 JSON序列化::JSON值;

/// rust-analyzer 子进程管理器
///
/// 支持崩溃自动重启：消息出口（接收端）与崩溃标志不随进程重启而变化，
/// 转发线程无需重建；重启仅替换进程句柄与写入端，并由代理主循环
/// 重新执行初始化、初始化完成、工作区与文档同步握手。
公开 结构体 分析器连接 {
    /// 子进程句柄（重启/停止时替换）
    子进程句柄: 互斥锁<选项<子进程>>,
    /// 写入端（向 rust-analyzer 发送消息；锁内发送，重启时替换）
    写入端: 原子引用计数<互斥锁<选项<子进程输入>>>,
    /// 统一消息出口（不随重启变化，转发线程持续读取）
    消息出口: 跨梁通道::发送端<JSON值>,
    /// 消息接收通道（消息出口的接收端，可克隆）
    消息接收器: 跨梁通道::接收端<JSON值>,
    /// 读取线程检测到输出结束（进程崩溃/异常退出）置位，
    /// 供代理主循环检测并触发自动重启
    已崩溃: 原子引用计数<原子布尔>,
    /// 当前进程的主动停止抑制标志：每次生成子进程时新建并替换（停止时置位当前
    /// 标志，读取线程持各自标志），避免重启后旧进程输出结束与新标志竞态
    停止标志: 互斥锁<原子引用计数<原子布尔>>,
    /// 启动阶段失败原因（rust-analyzer 未安装/不可执行）
    ///
    /// 启动失败不能直接让进程退出：代理必须先完成语言服务协议握手才能把原因告知
    /// 客户端，否则编辑器只显示“服务端初始化失败”，用户无从
    /// 得知到底是缺 rust-analyzer 还是语言包坏了。
    启动错误: 互斥锁<选项<字符串>>,
}

实现 分析器连接 {
    /// 启动 rust-analyzer 子进程
    ///
    /// 启动失败不返回错误（见 [`自身::启动失败原因`]）：失败原因先存入
    /// `启动错误`，由代理在握手后转给客户端。
    公开 函数 启动() -> 自身 {
        让 (消息出口, 消息接收器) = 跨梁通道::无界通道();
        让 连接实例 = 自身 {
            子进程句柄: 互斥锁::新建(无),
            写入端: 原子引用计数::新建(互斥锁::新建(无)),
            消息出口,
            消息接收器,
            已崩溃: 原子引用计数::新建(原子布尔::新建(假)),
            停止标志: 互斥锁::新建(原子引用计数::新建(原子布尔::新建(假))),
            启动错误: 互斥锁::新建(无),
        };
        如果让 错误(错误值) = 连接实例.生成子进程() {
            日志::日志错误!("{错误值}");
            如果让 成功(可变 槽位) = 连接实例.启动错误.加锁() {
                *槽位 = 有值(错误值.转字符串());
            }
        }
        连接实例
    }

    /// 启动阶段是否失败（返回失败原因）
    ///
    /// 非 `无` 时子进程从未就绪，代理应立即把原因报给客户端并退出，
    /// 而不是在主循环里继续转发消息。
    公开 函数 启动失败原因(&自我) -> 选项<字符串> {
        自我.启动错误.加锁().转选项().而后映射(|槽位| 槽位.克隆值())
    }

    /// 启动（或崩溃后重新启动）rust-analyzer 子进程并挂接消息管道
    函数 生成子进程(&自我) -> 错误处理::结果<()> {
        让 分析器路径 = 查找分析器()?;
        日志::信息!(
            "{}",
            包::界面消息::全局界面().取带参消息("lsp_log_ra_starting", &[&分析器路径.展示().转字符串()])
        );
        让 可变 命令实例 = 命令::新建(&分析器路径);
        // 新版 rust-analyzer 已移除 `--stdio` 参数（标准输入输出为默认模式）
        自我.生成命令(&可变 命令实例)
    }

    /// 用指定命令启动子进程（测试配置下注入假进程用）
    函数 生成命令(&自我, 命令实例: &可变 命令) -> 错误处理::结果<()> {
        让 可变 子进程实例 = 命令实例
            .标准输入(标准流::管道化())
            .标准输出(标准流::管道化())
            .标准错误(标准流::继承())
            .生成()
            .映射错误(|错误值| {
                错误处理::错误处理!(
                    "{}",
                    包::界面消息::全局界面().取带参消息("lsp_err_ra_start", &[&错误值.转字符串()])
                )
            })?;

        让 写入端实例 = 子进程实例
            .标准输入
            .取()
            .缺值转错(|| 错误处理::错误处理!("{}", 包::界面消息::全局界面().取消息("lsp_err_ra_stdin")))?;
        让 读取端实例 = 子进程实例
            .标准输出
            .取()
            .缺值转错(|| 错误处理::错误处理!("{}", 包::界面消息::全局界面().取消息("lsp_err_ra_stdout")))?;

        // 新进程的停止抑制标志：读取线程持各自标志，停止时只置位当前标志
        让 停止标志 = 原子引用计数::新建(原子布尔::新建(假));
        *自我
            .子进程句柄
            .加锁()
            .映射错误(|_| 错误处理::错误处理!("{}", 包::界面消息::全局界面().取消息("lsp_err_write_lock")))? =
            有值(子进程实例);
        *自我
            .写入端
            .加锁()
            .映射错误(|_| 错误处理::错误处理!("{}", 包::界面消息::全局界面().取消息("lsp_err_write_lock")))? =
            有值(写入端实例);
        *自我
            .停止标志
            .加锁()
            .映射错误(|_| 错误处理::错误处理!("{}", 包::界面消息::全局界面().取消息("lsp_err_write_lock")))? =
            停止标志.克隆值();

        // 后台线程：持续读取 rust-analyzer 的标准输出，转发到统一消息出口；
        // 输出结束（进程崩溃/被停止）时退出线程并报告崩溃状态
        让 消息出口 = 自我.消息出口.克隆值();
        让 已崩溃 = 自我.已崩溃.克隆值();
        线程::生成(移动 || {
            让 可变 缓冲读取器实例 = 缓冲读取器::新建(读取端实例);
            循环 {
                如果让 有值(消息) = 读取一条协议消息(&可变 缓冲读取器实例) {
                    如果 消息出口.发送(消息).是否为错误() {
                        中断;
                    }
                } 否则 {
                    日志::信息!("{}", 包::界面消息::全局界面().取消息("lsp_log_ra_output_ended"));
                    // 非主动停止视为异常退出：置崩溃标志供主循环自动重启
                    如果 !停止标志.加载(内存顺序::顺序) {
                        已崩溃.存值(真, 内存顺序::顺序);
                    }
                    中断;
                }
            }
        });

        成功(())
    }

    /// 向 rust-analyzer 发送一条 JSON-RPC 消息
    公开 函数 发送消息(&自我, 消息: &JSON值) -> 错误处理::结果<()> {
        让 文本串 = JSON序列化::转字符串(消息)?;
        让 帧文本 = 格式化!("Content-Length: {}\r\n\r\n{}", 文本串.长度(), 文本串);

        让 可变 写入端实例 = 自我
            .写入端
            .加锁()
            .映射错误(|_| 错误处理::错误处理!("{}", 包::界面消息::全局界面().取消息("lsp_err_write_lock")))?;
        让 标准输入实例 = 写入端实例.作为可变引用方法().缺值转错(|| {
            错误处理::错误处理!("{}", 包::界面消息::全局界面().取消息("lsp_err_ra_not_running"))
        })?;
        标准输入实例.写入全部(帧文本.转为字节())?;
        标准输入实例.刷新()?;

        日志::调试!("-> rust-analyzer: {}", 截短(&文本串, 200));
        成功(())
    }

    /// 获取消息接收通道的克隆（可在多线程中共享）
    公开 函数 消息通道(&自我) -> 跨梁通道::接收端<JSON值> {
        自我.消息接收器.克隆值()
    }

    /// 获取用于后台线程回发消息的发送端副本
    ///
    /// 转发线程需要应答 rust-analyzer 主动发来的请求
    /// （如 `workspace/诊断/refresh`），因此需要独立于
    /// 主线程的发送能力。
    公开 函数 取发送端副本(&自我) -> 发送端 {
        发送端 {
            写入端: 自我.写入端.克隆值(),
        }
    }

    /// 尝试非阻塞接收一条来自 rust-analyzer 的消息
    公开 函数 尝试接收(&自我) -> 选项<JSON值> {
        自我.消息接收器.试接收().转选项()
    }

    /// rust-analyzer 是否已异常退出（读取线程报告，等待自动重启）
    公开 函数 是否崩溃(&自我) -> 布尔 {
        自我.已崩溃.加载(内存顺序::顺序)
    }

    /// 清除崩溃标志（自动重启失败时调用，避免主循环忙循环）
    公开 函数 清除崩溃(&自我) {
        自我.已崩溃.存值(假, 内存顺序::顺序);
    }

    /// 重启 rust-analyzer 子进程（崩溃后由代理主循环调用）
    ///
    /// 消息出口（接收端）不重建：转发线程持续消费；
    /// 重握手由调用方（代理主循环）完成。
    公开 函数 重启(&自我) -> 错误处理::结果<()> {
        自我.停止();
        自我.已崩溃.存值(假, 内存顺序::顺序);
        自我.生成子进程()
    }

    /// 停止 rust-analyzer 子进程（置当前进程的停止标志，输出结束不再报告崩溃）
    公开 函数 停止(&自我) {
        如果让 有值(标志) = 自我.停止标志.加锁().转选项().变换(|守卫| 守卫.克隆值()) {
            标志.存值(真, 内存顺序::顺序);
        }
        如果让 有值(可变 进程实例) = 自我.子进程句柄.加锁().转选项().而后映射(|可变 槽位| 槽位.取()) {
            日志::信息!("{}", 包::界面消息::全局界面().取消息("lsp_log_ra_stopping"));
            让 _ = 进程实例.终止进程();
            让 _ = 进程实例.等待进程();
        }
    }
}

/// 独立的 rust-analyzer 消息发送端（供其他线程使用）
公开 结构体 发送端 {
    写入端: 原子引用计数<互斥锁<选项<子进程输入>>>,
}

实现 发送端 {
    /// 向 rust-analyzer 发送一条 JSON-RPC 消息
    公开 函数 发送消息(&自我, 消息: &JSON值) -> 错误处理::结果<()> {
        让 文本串 = JSON序列化::转字符串(消息)?;
        让 帧文本 = 格式化!("Content-Length: {}\r\n\r\n{}", 文本串.长度(), 文本串);

        让 可变 写入端实例 = 自我
            .写入端
            .加锁()
            .映射错误(|_| 错误处理::错误处理!("{}", 包::界面消息::全局界面().取消息("lsp_err_write_lock")))?;
        让 标准输入实例 = 写入端实例.作为可变引用方法().缺值转错(|| {
            错误处理::错误处理!("{}", 包::界面消息::全局界面().取消息("lsp_err_ra_not_running"))
        })?;
        标准输入实例.写入全部(帧文本.转为字节())?;
        标准输入实例.刷新()?;

        日志::调试!("-> rust-analyzer: {}", 截短(&文本串, 200));
        成功(())
    }
}

实现 可丢弃 对于 分析器连接 {
    函数 丢弃(&可变 自我) {
        自我.停止();
    }
}

#[配置(测试)]
实现 发送端 {
    /// 测试用空发送端：无 rust-analyzer 子进程，发送恒返回"未运行"错误。
    ///
    /// 供服务端消息分发单测构造参数——这些用例只验证
    /// 响应映射/通知路由，不需要真实 rust-analyzer 回环（回环由端到端测试覆盖）。
    公开(包) 函数 测试用空端() -> 自身 {
        自身 {
            写入端: 原子引用计数::新建(互斥锁::新建(无)),
        }
    }
}

/// 单条协议消息正文的硬上限（16 MiB）
///
/// 协议的内容长度头由对端声明，按声明值直接分配缓冲会让一条畸形帧
/// （如声明长度接近 2^64）触发 OOM/abort。
/// 正常 LSP 消息远小于此值，超限视为协议错误并终止读取。
常量 最大协议正文字节数: 无符号机器整数 = 16 * 1024 * 1024;

/// 从缓冲读取器中读取一条语言服务协议消息（内容长度字段分帧）
函数 读取一条协议消息<读源: 缓冲读取特征>(读取器: &可变 读源) -> 选项<JSON值> {
    让 可变 消息头行 = 字符串::新建();
    让 可变 正文字节数: 选项<无符号机器整数> = 无;

    循环 {
        消息头行.清空();
        匹配 读取器.读取行(&可变 消息头行) {
            成功(0) => 返回 无,
            成功(_) => {}
            错误(错误值) => {
                日志::日志错误!(
                    "{}",
                    包::界面消息::全局界面().取带参消息("lsp_err_read_output", &[&错误值.转字符串()])
                );
                返回 无;
            }
        }

        让 裁剪后行 = 消息头行.裁剪();
        如果 裁剪后行.是否为空() {
            中断;
        }

        如果让 有值(长度文本) = 裁剪后行.去前缀("Content-Length:")
            && 让 成功(字节数) = 长度文本.裁剪().解析::<无符号机器整数>()
        {
            正文字节数 = 有值(字节数);
        }
    }

    让 正文字节数 = 正文字节数?;

    如果 正文字节数 > 最大协议正文字节数 {
        日志::日志错误!(
            "rust-analyzer 声明的消息体 {} 字节超过上限 {}，拒绝读取",
            正文字节数,
            最大协议正文字节数
        );
        返回 无;
    }

    让 可变 字节缓冲 = 向量![0u8; 正文字节数];
    如果 标准库::输入输出::读取特征::读取精确(读取器, &可变 字节缓冲).是否为错误() {
        日志::日志错误!("{}", 包::界面消息::全局界面().取消息("lsp_err_read_body"));
        返回 无;
    }

    让 文本串 = 字符串::从字节(字节缓冲).转选项()?;
    日志::调试!("<- rust-analyzer: {}", 截短(&文本串, 200));

    JSON序列化::解析字符串(&文本串).转选项()
}

/// 查找 rust-analyzer 可执行文件
///
/// 优先级：
/// 0. 内置工具链（`~/.rz/toolchain/bin`，`rzc install toolchain` 安装的独立版）
/// 1. `RUST_ANALYZER_PATH` 环境变量
/// 2. `rustup which --toolchain stable`（真实路径，不受项目 `rust-toolchain.toml` 影响）
/// 3. `PATH` 扫描（跨平台，替代 Unix 专属的查找命令；Windows 追加 `PATHEXT` 后缀）
/// 4. 常见安装位置（含 `~/.cargo/bin`，Windows 回退 `USERPROFILE`）
函数 查找分析器() -> 错误处理::结果<路径缓冲> {
    // 0. 用户显式指定的环境变量（最高优先级，覆盖内置与 `PATH`）
    如果让 成功(路径文本) = 标准库::环境::环境变量("RUST_ANALYZER_PATH") {
        让 候选路径 = 路径缓冲::从(&路径文本);
        如果 候选路径.存在() {
            返回 成功(候选路径);
        }
    }

    // 1. 内置工具链（脱离 rustup 的独立版本，版本自管）
    如果让 有值(候选路径) = 引擎库::工具链::查找工具链程序("rust-analyzer") {
        返回 成功(候选路径);
    }

    // `rustup which` 返回真实二进制路径（非包装脚本），避免被项目 `rust-toolchain.toml`
    // （如 1.85 无 rust-analyzer 组件）导致 `Unknown binary` 启动失败
    如果让 成功(进程输出) = 命令::新建("rustup")
        .参数(["which", "--toolchain", "stable", "rust-analyzer"])
        .取输出()
        && 进程输出.进程状态.退出成功()
    {
        让 路径文本 = 字符串::从utf8宽松(&进程输出.标准输出).裁剪().转字符串();
        如果 !路径文本.是否为空() {
            让 候选路径 = 路径缓冲::从(&路径文本);
            如果 候选路径.存在() {
                返回 成功(候选路径);
            }
        }
    }

    // `PATH` 扫描（引擎工具链定位统一实现：含 Windows `PATHEXT` 探测）
    如果让 有值(候选路径) = 引擎库::工具链::查找工具链程序("rust-analyzer") {
        返回 成功(候选路径);
    }

    让 候选路径表 = [
        主目录路径("cargo/bin/rust-analyzer"),
        主目录路径(".cargo/bin/rust-analyzer"),
        路径缓冲::从("/usr/local/bin/rust-analyzer"),
        路径缓冲::从("/usr/bin/rust-analyzer"),
    ];
    对于 候选路径 在 候选路径表 {
        如果 候选路径.存在() {
            返回 成功(候选路径);
        }
    }

    错误处理::错误中止!("{}", 包::界面消息::全局界面().取消息("lsp_err_ra_not_found"))
}

函数 主目录路径(相对路径: &文本) -> 路径缓冲 {
    // `HOME`（Unix）优先，`USERPROFILE`（Windows）回退，保证跨平台定位到用户主目录
    让 主目录值 = 标准库::环境::环境变量("HOME")
        .或用否则(|_| 标准库::环境::环境变量("USERPROFILE"))
        .取值或默认();
    如果 主目录值.是否为空() {
        路径缓冲::从(相对路径)
    } 否则 {
        路径缓冲::从(主目录值).连接(相对路径)
    }
}

函数 截短(文本串: &文本, 最大长度: 无符号机器整数) -> 字符串 {
    如果 文本串.长度() <= 最大长度 {
        文本串.转字符串()
    } 否则 {
        // 按字符边界安全截断，避免切到多字节字符（中文）中间
        让 可变 边界位置 = 最大长度;
        当 边界位置 > 0 && !文本串.是字符边界(边界位置) {
            边界位置 -= 1;
        }
        格式化!("{}...", &文本串[..边界位置])
    }
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;
    使用 标准库::输入输出::游标;
    使用 临时文件::命名临时文件;

    /// 合法内容长度分帧消息可解析出 JSON
    #[测试]
    函数 读取合法消息成功() {
        让 数据 = "Content-Length: 17\r\n\r\n{\"method\":\"test\"}";
        让 可变 游标实例 = 游标::新建(数据);
        让 消息值 = 读取一条协议消息(&可变 游标实例).期望("应解析出消息");
        断言相等!(消息值["method"], "test");
    }

    /// 消息头中缺少内容长度字段时返回 `无`
    #[测试]
    函数 缺失长度头返回无() {
        让 数据 = "Content-Type: application/json\r\n\r\n{}";
        让 可变 游标实例 = 游标::新建(数据);
        断言!(读取一条协议消息(&可变 游标实例).是否为无());
    }

    /// 消息体长度不足（提前结束输入）时返回 `无`
    #[测试]
    函数 消息体不足返回无() {
        让 数据 = "Content-Length: 100\r\n\r\n{\"method\":\"test\"}";
        让 可变 游标实例 = 游标::新建(数据);
        断言!(读取一条协议消息(&可变 游标实例).是否为无());
    }

    /// 消息体为非 UTF-8 字节时返回 `无`
    #[测试]
    函数 非法字节返回无() {
        让 数据 = b"Content-Length: 2\r\n\r\n\xFF\xFE";
        让 可变 游标实例 = 游标::新建(数据);
        断言!(读取一条协议消息(&可变 游标实例).是否为无());
    }

    /// 输入为空（立即结束）时返回 `无`
    #[测试]
    函数 输入结束返回无() {
        让 可变 游标实例 = 游标::新建("");
        断言!(读取一条协议消息(&可变 游标实例).是否为无());
    }

    /// 短文本原样返回
    #[测试]
    函数 短文本不截短() {
        断言相等!(截短("abc", 10), "abc");
        断言相等!(截短("hello world", 5), "hello...");
    }

    /// 截断长度落在多字节字符中间时回退到字符边界
    #[测试]
    函数 截短落在字符边界() {
        断言相等!(截短("中文测试", 3), "中...");
        断言相等!(截短("中文测试", 4), "中...");
        断言相等!(截短("中文测试", 6), "中文...");
    }

    /// `RUST_ANALYZER_PATH` 环境变量优先返回
    #[测试]
    函数 分析器路径环境变量优先() {
        让 临时文件实例 = 命名临时文件::新建().期望("创建临时文件失败");
        不安全 {
            标准库::环境::设置环境变量("RUST_ANALYZER_PATH", 临时文件实例.条目路径());
        }
        让 找到路径 = 查找分析器().期望("应通过环境变量找到");
        断言相等!(找到路径, 临时文件实例.条目路径());
        不安全 {
            标准库::环境::移除环境变量("RUST_ANALYZER_PATH");
        }
    }

    /// `PATH` 扫描由引擎工具链定位统一实现
    #[测试]
    函数 工具链查找不存在程序返回无() {
        // 内置与 `PATH` 都不存在的二进制名应返回 `无`（不崩溃）
        让 名称 = 格式化!("__ra_nonexistent__{}", 标准库::进程::进程号());
        断言!(引擎库::工具链::查找工具链程序(&名称).是否为无());
    }

    /// 构造空连接（未启动任何子进程）
    函数 空白连接() -> 分析器连接 {
        让 (消息出口, 消息接收器) = 跨梁通道::无界通道();
        分析器连接 {
            子进程句柄: 互斥锁::新建(无),
            写入端: 原子引用计数::新建(互斥锁::新建(无)),
            消息出口,
            消息接收器,
            已崩溃: 原子引用计数::新建(原子布尔::新建(假)),
            停止标志: 互斥锁::新建(原子引用计数::新建(原子布尔::新建(假))),
            启动错误: 互斥锁::新建(无),
        }
    }

    /// 等待崩溃标志置位（最多 2 秒）
    ///
    /// 仅 `Unix系统` 配置的崩溃测试使用（靠 `sh -c` 起假进程），
    /// 不加门控会在 Windows 上被判为死代码。
    #[配置(Unix系统)]
    函数 等待崩溃(连接实例: &分析器连接) -> 布尔 {
        对于 _ 在 0..40 {
            如果 连接实例.是否崩溃() {
                返回 真;
            }
            标准库::线程::线程休眠(标准库::时间模块::持续时间::从毫秒(50));
        }
        假
    }

    /// 子进程异常退出（输出结束且非主动停止）时置崩溃标志
    #[配置(Unix系统)]
    #[测试]
    函数 异常退出置崩溃标志() {
        让 连接实例 = 空白连接();
        连接实例.生成命令(命令::新建("sh").单参数("-c").单参数("exit 0"))
            .期望("启动假进程失败");
        断言!(等待崩溃(&连接实例), "进程立即退出应触发崩溃标志");
        // 模拟重启：停止旧进程（其输出结束不再报崩溃）+ 复位标志 + 启动新进程
        连接实例.停止();
        连接实例.清除崩溃();
        连接实例.生成命令(命令::新建("sh").单参数("-c").单参数("exit 1"))
            .期望("二次启动失败");
        断言!(!连接实例.是否崩溃(), "重启后标志应复位");
        断言!(等待崩溃(&连接实例), "新进程退出应再次置位");
    }

    /// 主动停止后的输出结束不置崩溃标志
    #[配置(Unix系统)]
    #[测试]
    函数 主动停止不置崩溃标志() {
        让 连接实例 = 空白连接();
        连接实例.生成命令(命令::新建("sh").单参数("-c").单参数("sleep 5"))
            .期望("启动假进程失败");
        连接实例.停止();
        标准库::线程::线程休眠(标准库::时间模块::持续时间::从毫秒(200));
        断言!(!连接实例.是否崩溃(), "主动停止不应报告崩溃");
    }

    /// 未启动（重启窗口内）发送返回明确错误而非崩溃
    #[测试]
    函数 未运行时发送失败() {
        让 连接实例 = 空白连接();
        让 错误值 = 连接实例
            .发送消息(&JSON序列化::解析字符串(r#"{"method":"test"}"#).解包())
            .取错误值();
        断言!(
            错误值.转字符串().包含("不可用")
                || 错误值.转字符串().包含("lsp_err_ra_not_running")
        );
    }
}
