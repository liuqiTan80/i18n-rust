//! 真实项目镜像编译检查（权威诊断）
//!
//! 虚拟项目只聚合方言模块、无第三方依赖，与真实工程结构偏差大；
//! 本模块把整个项目树复制为「镜像」（排除 target/.git/node_modules/dist），
//! 按 rzc 的规则把源码目录下的方言文件转译为 .rs 产物：
//! - 入口方言源（入口文件，或与现有入口产物的最相似方言文件）
//!   转译后写入镜像的入口产物，非 ASCII 文件式模块声明补 `#[path]` 注解；
//! - 其余方言文件转译为同名 .rs 产物（与 rzc 的项目文件转译规则一致）。
//!
//! 镜像目录位于系统临时目录顶层（`i18n_lsp_mirror_<用户>_<进程号>_<项目哈希>`），
//! 与虚拟项目目录同层隔离：虚拟项目本身是编译包，镜像嵌入其下会被
//! 包管理器判定为“在工作区中却未被声明”而拒绝检查（父目录清单文件
//! 构成工作区根）；顶层目录同时避免分析器把镜像树当作
//! 工作区文件扫描。残留目录由下次启动的虚拟目录清理机制一并清扫。
//!
//! 在镜像中执行 `cargo check --offline --message-format=json`，
//! `--target-dir` 指向真实项目的构建目录，依赖编译产物零重复（镜像
//! 本地编译单元的指纹含项目路径，与真实项目互不干扰）。
//! 编译器诊断经行/列回译（含 `#[path]` 注解行的行号换算）还原为方言坐标，
//! 消息翻译与所有权详情提取后按文件发布；镜像不可用（无清单文件、
//! 复制失败、包管理器无法启动）时返回假，由调用方回退虚拟项目检查。
//!
//! 打开中的方言文档以编辑器缓冲区内容为准（内存最新），其余取磁盘内容。
//! 与 rzc 构建的规则唯一来源为引擎（转译管线、`#[path]` 注解、列映射）。

使用 标准库::集合::{哈希映射, 哈希集合};
使用 标准库::输入输出::读取特征;
使用 标准库::路径::{路径类型, 路径缓冲};
使用 标准库::同步::{原子引用计数, 互斥锁};

使用 JSON序列化::JSON值;

使用 包::响应映射::诊断文本::{
    提取所有权详情, 注入教学诊断, 翻译诊断消息,
};
使用 包::翻译缓存::{路径转统一资源标识, 转译缓存};

/// 镜像树复制时排除的目录名（构建产物/版本库/依赖缓存）
常量 排除目录表: [&文本; 5] = ["target", ".git", "node_modules", "dist", ".rz"];

/// 镜像检查轮询超时：600s（含真实依赖编译，首轮可能数分钟）
常量 检查超时毫秒: 无符号长整数 = 600_000;
/// 轮询间隔
常量 轮询间隔毫秒: 无符号长整数 = 200;

/// 单个镜像转译文件：方言源 ↔ 镜像产物坐标映射
结构体 镜像文件 {
    /// 镜像中的产物路径（src/main.rs 或同名 .rs；诊断归位用）
    产物路径: 路径缓冲,
    /// 真实项目中的方言源统一资源标识（发布诊断用）
    原始资源标识: 字符串,
    /// 方言源内容（打开文档取缓冲区，否则取磁盘；同行列换算用）
    母语内容: 字符串,
    /// 引擎列映射（产物字符列 → 方言字符列；本模块自行转译，与命令行同源）
    列位映射数据: 引擎库::列位映射::列位映射表,
    /// 入口产物行（磁盘行，从 0 开始的索引）→ 引擎直出行映射；
    /// 仅入口文件有 `#[path]` 注解插入行，其余为恒等（无）
    入口行映射: 选项<向量<无符号机器整数>>,
}

/// 待写盘的镜像转译产物（入口识别需全部产物就绪，故先在内存中转译）
结构体 待写产物 {
    /// 镜像中的方言源路径（产物路径由它推导）
    镜像路径: 路径缓冲,
    /// 引擎转译文本（未补 `#[path]` 注解）
    转译文本: 字符串,
    /// 引擎列映射（产物字符列 → 方言字符列）
    列位映射数据: 引擎库::列位映射::列位映射表,
    /// 方言源内容（打开文档取缓冲区，否则取磁盘）
    母语内容: 字符串,
}

/// 执行一次镜像检查并发布权威诊断
///
/// 返回真表示镜像检查确实执行（无论项目有无诊断）；
/// 假表示镜像不可用，调用方回退虚拟项目检查（原有行为）。
公开(包) 函数 运行镜像检查(
    缓存: &原子引用计数<转译缓存>,
    消息发送方: &跨梁通道::发送端<语言服务器库::消息>,
    内置诊断表: &原子引用计数<互斥锁<哈希映射<字符串, 向量<JSON值>>>>,
    扩展名表: &[字符串],
    原始资源标识: &文本,
    管理器: &引擎库::映射管理器::映射管理器,
) -> 布尔 {
    // 触发文件须在缓存中（打开/保存均已入库），据此定位项目根
    让 有值(原始路径) = 缓存
        .查询原始(原始资源标识)
        .映射(|条目值| 条目值.原始路径.克隆值())
    否则 {
        返回 假;
    };
    让 有值(项目根) = 查找项目根(&原始路径) 否则 {
        返回 假; // 非编译项目（单文件教学场景）
    };
    如果 !原始路径.以开头(&项目根) {
        返回 假;
    }

    // 镜像目录：系统临时目录顶层、按 用户+进程号+项目哈希 隔离；每次全量重建
    // （删除/改名等磁盘变化自动反映，无需增量跟踪）
    //
    // 安全：目录名可预测（用户名已知、进程号可枚举、路径哈希用确定性
    // 默认哈希器），多用户共享临时目录下可被预创建为符号链接。删除所有目录
    // 与创建所有目录都会跟随末段链接——前者删任意目录、后者写任意位置，
    // 故与服务器模块的虚拟临时目录同一水位做“创建前 + 创建后”两道
    // 符号链接校验；任一命中即回退虚拟检查（复用返回假的降级契约），
    // 正常路径（真实目录/不存在）行为不变。
    // （创建前后各查一次符号链接，任一命中即按假降级。）
    让 镜像目录值 = 镜像目录路径(&项目根);
    如果 是符号链接(&镜像目录值) {
        日志::警告!(
            "镜像目录已被符号链接占用，跳过镜像检查（回退虚拟检查）：{}",
            镜像目录值.展示()
        );
        返回 假;
    }
    让 _ = 标准库::文件系统::删除所有目录(&镜像目录值);
    如果 是符号链接(&镜像目录值) {
        日志::警告!(
            "镜像目录删除后仍为符号链接（疑似并发预占），回退虚拟检查：{}",
            镜像目录值.展示()
        );
        返回 假;
    }
    如果让 错误(错误值) = 标准库::文件系统::创建所有目录(&镜像目录值) {
        日志::警告!(
            "镜像目录创建失败（回退虚拟检查）：{}：{错误值}",
            项目根.展示()
        );
        返回 假;
    }
    如果 是符号链接(&镜像目录值) {
        日志::警告!(
            "镜像目录创建后检测到符号链接（并发竞态），回退虚拟检查：{}",
            镜像目录值.展示()
        );
        返回 假;
    }
    如果让 错误(错误值) = 复制项目树(&项目根, &镜像目录值) {
        日志::警告!(
            "镜像复制失败（回退虚拟检查）：{}：{错误值}",
            项目根.展示()
        );
        让 _ = 标准库::文件系统::删除所有目录(&镜像目录值);
        返回 假;
    }

    // 方言源转译：入口检测 → 写产物 → 返回产物坐标映射
    让 有值(文件表) = 转译进镜像(缓存, 扩展名表, &项目根, &镜像目录值) 否则 {
        让 _ = 标准库::文件系统::删除所有目录(&镜像目录值);
        返回 假;
    };

    // 编译检查：`--offline` 防索引网络访问卡死；`--target-dir` 复用真实项目
    // 的依赖编译产物（镜像仅重编本地编译单元）
    让 目标目录 = 项目根.连接("target");
    让 有值((标准输出文本, 是否成功)) = 运行编译检查(&镜像目录值, &目标目录) 否则 {
        返回 假;
    };

    让 (可归位数, 发布数) = 发布编译器诊断(
        &标准输出文本,
        &镜像目录值,
        &文件表,
        缓存,
        管理器,
        内置诊断表,
        消息发送方,
    );
    如果 !是否成功 && 可归位数 == 0 {
        // 无任何可归位诊断却异常退出：包管理器层失败（清单/离线缺依赖等），
        // 镜像结论不可信，回退虚拟检查
        日志::警告!("镜像检查异常退出且无诊断，回退虚拟检查");
        返回 假;
    }
    日志::信息!(
        "镜像检查完成：{} 个方言文件，{} 条编译消息，发布 {} 个文件",
        文件表.长度(),
        可归位数,
        发布数
    );
    真
}

/// 定位项目根：触发文件最近的上层清单文件所在目录
函数 查找项目根(起点: &路径类型) -> 选项<路径缓冲> {
    让 可变 目录值 = 起点.父目录()?;
    循环 {
        如果 目录值.连接("Cargo.toml").是否为文件() {
            返回 有值(目录值.转路径缓冲());
        }
        目录值 = 目录值.父目录()?;
    }
}

/// 项目根路径哈希（镜像目录名；同项目复用同一目录，跨会话互不串扰）
函数 路径哈希(路径值: &路径类型) -> 无符号长整数 {
    使用 标准库::集合::哈希映射模块::默认哈希器;
    使用 标准库::哈希模块::{哈希特征, 哈希器类型};
    让 可变 哈希器值 = 默认哈希器::新建();
    路径值.哈希方法(&可变 哈希器值);
    哈希器值.完成()
}

/// 镜像目录：系统临时目录下、用户名+进程号+项目哈希隔离的独立顶层目录
///
/// 不能放在虚拟项目目录之下：虚拟项目本身是编译包（含清单文件），
/// 嵌套其中的镜像包会被包管理器判定为“在工作区中却未被声明”而拒绝
/// 检查（父目录清单文件构成工作区根）；顶层独立目录同时避免
/// 分析器把镜像树当作工作区文件扫描。
函数 镜像目录路径(项目根: &路径类型) -> 路径缓冲 {
    让 用户名 = 标准库::环境::环境变量("USER")
        .或用否则(|_| 标准库::环境::环境变量("USERNAME"))
        .解包或用否则(|_| "default".转字符串());
    让 安全用户名: 字符串 = 用户名
        .逐字符()
        .映射(|本字| {
            如果 本字.是否为字母数字() || 本字 == '_' {
                本字
            } 否则 {
                '_'
            }
        })
        .收集();
    标准库::环境::临时目录().连接(格式化!(
        "i18n_lsp_mirror_{}_{}_{:x}",
        安全用户名,
        标准库::进程::进程号(),
        路径哈希(项目根)
    ))
}

/// 路径自身是否为符号链接（不跟随末段链接）——与服务器模块
/// 虚拟临时目录同一防御水位，供镜像目录预检与并发复查使用。
函数 是符号链接(路径值: &路径类型) -> 布尔 {
    路径值
        .符号链接元数据()
        .映射(|元数据值| 元数据值.文件类型().是否为符号链接())
        .取值或(假)
}

/// 递归复制项目树（排除构建产物/版本库；目录符号链接跳过防逃逸与循环，
/// 文件符号链接跟随复制单文件）
函数 复制项目树(来源: &路径类型, 目标: &路径类型) -> 标准库::输入输出::IO结果<()> {
    标准库::文件系统::创建所有目录(目标)?;
    对于 目录项 在 标准库::文件系统::读取目录(来源)?.展平() {
        让 路径值 = 目录项.条目路径();
        让 成功(条目类型) = 目录项.文件类型() 否则 {
            继续;
        };
        让 成功(元数据值) = 目录项.取元数据() 否则 {
            继续;
        };
        让 名称值 = 目录项.文件名();
        让 名称文本 = 名称值.转有损字符串();
        如果 元数据值.是否为目录() {
            如果 条目类型.是否为符号链接() || 排除目录表.包含(&名称文本.作为引用方法()) {
                继续;
            }
            复制项目树(&路径值, &目标.连接(名称文本.作为引用方法()))?;
        } 否则 如果 元数据值.是否为文件() {
            标准库::文件系统::复制文件(&路径值, 目标.连接(名称文本.作为引用方法()))?;
        }
    }
    成功(())
}

/// 收集目录下全部方言源文件（递归；路径排序保证确定性）
函数 收集方言路径(目录值: &路径类型, 扩展名表: &[字符串], 输出表: &可变 向量<路径缓冲>) {
    让 成功(条目集) = 标准库::文件系统::读取目录(目录值) 否则 {
        返回;
    };
    对于 目录项 在 条目集.展平() {
        让 路径值 = 目录项.条目路径();
        让 成功(条目类型) = 目录项.文件类型() 否则 {
            继续;
        };
        如果 条目类型.是否为目录() {
            收集方言路径(&路径值, 扩展名表, 输出表);
        } 否则 如果 条目类型.是否为文件() && 文件匹配扩展名(&路径值, 扩展名表) {
            输出表.推入(路径值);
        }
    }
}

/// 路径扩展名是否属于支持的方言扩展名（如 `.zh`）
函数 文件匹配扩展名(路径值: &路径类型, 扩展名表: &[字符串]) -> 布尔 {
    让 有值(扩展名值) = 路径值.扩展名().而后映射(|值| 值.取字符串引用()) 否则 {
        返回 假;
    };
    让 带点扩展名 = 格式化!(".{}", 扩展名值);
    扩展名表
        .迭代()
        .任意(|单项| 单项 == &带点扩展名 || 单项 == 扩展名值)
}

/// 把镜像源码目录下的方言源转译为 .rs 产物（入口 → 入口产物），返回产物映射表
///
/// 转译与 rzc 同规则：模块名集合 = 源码目录顶层方言文件词干（`crate::` 前缀
/// 限定用）、项目声明上下文来自全部方言源（跨文件声明豁免）、入口产物补
/// 非 ASCII 模块 `#[path]` 注解。打开中的文档以缓冲区内容为准。
函数 转译进镜像(
    缓存: &原子引用计数<转译缓存>,
    扩展名表: &[字符串],
    项目根: &路径类型,
    镜像目录值: &路径类型,
) -> 选项<向量<镜像文件>> {
    让 镜像源目录 = 镜像目录值.连接("src");
    如果 !镜像源目录.是否为目录() {
        返回 无;
    }
    // 方言源清单：源码目录递归（覆盖 rzc 的顶层扫描；嵌套文件经 `#[path]` 引用）
    让 可变 方言路径表: 向量<路径缓冲> = 向量::新建();
    收集方言路径(&镜像源目录, 扩展名表, &可变 方言路径表);
    方言路径表.排序();
    如果 方言路径表.是否为空() {
        返回 无;
    }

    // 模块名集合：源码目录全层级方言文件词干（与命令行收集项目上下文
    // 同规则）；嵌套模块（领域子目录下工具.zh 的「工具」）也纳入，供
    // `crate::领域::工具::成员` 多层路径链豁免
    让 可变 模块名集: 哈希集合<字符串> = 哈希集合::新建();
    // 方言源内容：打开文档取缓冲区，其余取磁盘
    让 可变 源表: 哈希映射<路径缓冲, 字符串> = 哈希映射::新建();
    对于 镜像路径 在 &方言路径表 {
        让 成功(相对路径) = 镜像路径.去前缀(镜像目录值) 否则 {
            继续;
        };
        // 打开文档取缓冲区内容：按路径查询（容忍客户端资源标识与规范化
        // 路径的表示差异——Windows 上字符串键匹配会失效）
        让 内容选项 = 缓存
            .按路径查询(&项目根.连接(相对路径))
            .过滤(|条目值| 条目值.已打开)
            .映射(|条目值| 条目值.母语内容.克隆值())
            .或用否则(|| 标准库::文件系统::读取全部字符串(镜像路径).转选项());
        让 有值(内容值) = 内容选项 否则 {
            继续;
        };
        如果让 有值(文件名干) = 镜像路径.文件名干().而后映射(|值| 值.取字符串引用()) {
            模块名集.置入(文件名干.转字符串());
        }
        源表.置入(镜像路径.克隆值(), 内容值);
    }
    如果 源表.是否为空() {
        返回 无;
    }

    让 项目上下文值 = 引擎库::别名::项目上下文::从源集合(
        模块名集.克隆值(),
        源表.值().映射(字符串::作为文本切片),
        缓存.映射管理器引用(),
    );

    // 逐文件转译（内存中）：入口识别需要全部产物先就绪
    //
    // 走**静默**入口：本模块自己把全角标点与教学检查算成诊断按文件归属
    // 发布（见 `注入教学诊断`），而非静默入口会把项目里每个文件的每
    // 条教学告警再往标准错误无归属地打一遍（`[时间] [警告] [教学检查] 第 N 行…`，
    // 看不出是哪个文件）——与问题面板完全重复。除刷屏外还有实际代价：
    // 教学诊断输出会跑一整轮 Unicode 混淆/全角/教学检查扫描并逐条
    // `格式化!()`，结果全部丢弃；而镜像检查逐项目文件循环，开销随文件数线性增长。
    // 语言服务侧转译入口早先已统一为静默（翻译缓存），此处为残留的非静默点。
    让 可变 待写表: 向量<待写产物> = 向量::新建();
    对于 镜像路径 在 &方言路径表 {
        让 有值(内容值) = 源表.读取条目(镜像路径) 否则 {
            继续;
        };
        让 转译成果 = 引擎库::静默带映射与项目转译管线(
            内容值,
            缓存.映射管理器引用(),
            有值(&模块名集),
            有值(&项目上下文值),
        );
        让 列位映射数据 = 引擎库::列位映射::列位映射表::回放生成(
            内容值,
            &转译成果.流程映射,
        );
        待写表.推入(待写产物 {
            镜像路径: 镜像路径.克隆值(),
            转译文本: 转译成果.转译产物文本,
            列位映射数据,
            母语内容: 内容值.克隆值(),
        });
    }

    // 入口识别：入口词干优先（其天然产物即入口产物）；否则取与
    // 现有入口产物最相似的方言源（rzc 允许任意入口文件名，
    // 产物统一写入入口产物；相似度不足时保留原入口产物不动）
    让 主文件内容 = 标准库::文件系统::读取全部字符串(镜像源目录.连接("main.rs")).转选项();
    让 入口路径 = 识别入口(&待写表, 主文件内容.作为解引用());

    // 写产物 + 构造映射表
    让 可变 文件表: 向量<镜像文件> = 向量::新建();
    对于 待写项 在 待写表 {
        让 成功(相对路径) = 待写项.镜像路径.去前缀(镜像目录值) 否则 {
            继续;
        };
        让 源路径 = 项目根.连接(相对路径);
        // 诊断发布资源标识复用缓存条目的客户端原样标识：与编辑器打开的
        // 文档严格一致（Windows 上规范化形式与客户端形式不同，直接用
        // 反推标识会导致诊断发布到用户不可见的文档上）；未登记条目
        // （缓存无路径匹配）回退规范化形式
        让 原始资源标识 = 缓存
            .按路径查询(&源路径)
            .映射(|条目值| 条目值.原始资源标识.克隆值())
            .解包或用否则(|| 路径转统一资源标识(&源路径));
        让 是入口 = 入口路径.作为解引用() == 有值(待写项.镜像路径.转路径());
        // 产物落点与 rzc 同规则：入口固定写镜像的 src/main.rs（包管理器只认这一
        // 默认发现位置），其余进托管目录 `.rz/gen/` 并镜像源码布局——真实
        // 项目与镜像同构，`#[path]` 解析与诊断归位才能共用一套逻辑
        让 产物路径 = 如果 是入口 {
            镜像源目录.连接("main.rs")
        } 否则 {
            引擎库::产物布局::产物路径(镜像目录值, &待写项.镜像路径)
        };
        // 子模块源文件所在目录：编译单元根与源文件同目录，非根文件位于
        // `<自身词干>/`（编译器文件式布局）
        让 子源目录 = 如果 是入口 {
            匹配 待写项.镜像路径.父目录() {
                有值(父级) => 父级.转路径缓冲(),
                无 => 路径缓冲::新建(),
            }
        } 否则 {
            匹配 待写项.镜像路径.父目录() {
                有值(父级) => 匹配 待写项
                    .镜像路径
                    .文件名干()
                    .而后映射(|值| 值.取字符串引用())
                {
                    有值(文件名干) => 父级.连接(文件名干),
                    无 => 父级.转路径缓冲(),
                },
                无 => 路径缓冲::新建(),
            }
        };
        // `#[path]` 注解按托管布局解析落点（方言子模块 → 托管产物，
        // 手写 `.rs` 子模块 → 跨出托管目录指回源码目录）；行映射供诊断行号回译
        让 (内容, 行映射) = 引擎库::产物布局::注解产物模块路径并返回行映射(
            &待写项.转译文本,
            &子源目录,
            产物路径.父目录().取值或(&镜像源目录),
            镜像目录值,
            扩展名表,
        );
        如果让 有值(父级) = 产物路径.父目录() {
            // 托管目录随首个非入口产物创建（镜像复制时已排除 `.rz`）
            让 _ = 标准库::文件系统::创建所有目录(父级);
        }
        如果让 错误(错误值) = 标准库::文件系统::写入(&产物路径, &内容) {
            日志::警告!("镜像产物写入失败：{}：{错误值}", 产物路径.展示());
            继续;
        }
        文件表.推入(镜像文件 {
            产物路径,
            原始资源标识,
            母语内容: 待写项.母语内容,
            列位映射数据: 待写项.列位映射数据,
            入口行映射: 有值(行映射),
        });
    }
    如果 文件表.是否为空() { 无 } 否则 { 有值(文件表) }
}

/// 入口识别：返回镜像中作为入口产物来源的方言源路径
///
/// 词干为入口名的方言文件优先（rzc 语义：其产物即入口产物）；
/// 否则在所有方言产物（含 `#[path]` 注解）中找与现有入口产物
/// 相似度最高者，相似度须达到阈值（初次构建即精确匹配，入口编辑后
/// 仍高度相似；其他模块与入口的相似度接近零）。
函数 识别入口(待写表: &[待写产物], 主文件: 选项<&文本>) -> 选项<路径缓冲> {
    对于 待写项 在 待写表 {
        如果 待写项.镜像路径.文件名干().而后映射(|值| 值.取字符串引用()) == 有值("main") {
            返回 有值(待写项.镜像路径.克隆值());
        }
    }
    让 主文件 = 主文件?;
    让 可变 最佳: 选项<(路径缓冲, 浮点数)> = 无;
    对于 待写项 在 待写表 {
        让 (加注解, _) =
            引擎库::模块路径::注解非母语模块并返回行映射(&待写项.转译文本);
        让 分数 = 行相似度(&加注解, 主文件);
        如果 分数 >= 0.6 && 最佳.作为引用方法().是否为无或(|(_, 旧分)| 分数 > *旧分) {
            最佳 = 有值((待写项.镜像路径.克隆值(), 分数));
        }
    }
    最佳.映射(|(路径值, _)| 路径值)
}

/// 逐行相似度：实质行（≥8 字符）命中率（命中数 / 两侧较大行数）
///
/// 分母取 候选行数与参照行数的较大者，小文件的局部巧合命中无法抬高分数。
函数 行相似度(候选: &文本, 参照: &文本) -> 浮点数 {
    让 是实质行 = |行文本: &文本| 行文本.裁剪().逐字符().计数() >= 8;
    让 参照行集: 哈希集合<&文本> = 参照
        .逐行()
        .映射(|行文本| 行文本.裁剪())
        .过滤(|行文本| 是实质行(行文本))
        .收集();
    如果 参照行集.是否为空() {
        返回 0.0;
    }
    让 可变 总数 = 0usize;
    让 可变 命中数 = 0usize;
    对于 行文本 在 候选
        .逐行()
        .映射(|行文本| 行文本.裁剪())
        .过滤(|行文本| 是实质行(行文本))
    {
        总数 += 1;
        如果 参照行集.包含(行文本) {
            命中数 += 1;
        }
    }
    如果 总数 == 0 {
        返回 0.0;
    }
    命中数 作为 浮点数 / 总数.最大值(参照行集.长度()) 作为 浮点数
}

/// 启动编译检查并等待退出（持续排空管道防写满阻塞，超时强杀）
///
/// 返回 (标准输出, 退出码是否成功)；进程无法启动/超时被强杀时返回无。
函数 运行编译检查(镜像目录值: &路径类型, 目标目录: &路径类型) -> 选项<(字符串, 布尔)> {
    让 可变 子进程实例 = 匹配 标准库::进程::命令::新建("cargo")
        .参数(["check", "--offline", "--message-format=json"])
        .单参数("--target-dir")
        .单参数(目标目录)
        .当前目录(镜像目录值)
        .标准输入(标准库::进程::标准流::空流())
        .标准输出(标准库::进程::标准流::管道化())
        .标准错误(标准库::进程::标准流::管道化())
        .生成()
    {
        成功(子进程值) => 子进程值,
        错误(错误值) => {
            日志::警告!("镜像编译检查启动失败：{错误值}");
            返回 无;
        }
    };
    让 可变 标准输出管道 = 子进程实例.标准输出.取()?;
    让 可变 标准错误管道 = 子进程实例.标准错误.取()?;
    让 标准输出线程 = 标准库::线程::生成(移动 || {
        让 可变 缓冲值 = 向量::新建();
        让 _ = 标准输出管道.读取全部(&可变 缓冲值);
        缓冲值
    });
    让 标准错误线程 = 标准库::线程::生成(移动 || {
        让 可变 缓冲值 = 向量::新建();
        让 _ = 标准错误管道.读取全部(&可变 缓冲值);
        缓冲值
    });

    让 可变 状态值 = 无;
    对于 _ 在 0..检查超时毫秒 / 轮询间隔毫秒 {
        匹配 子进程实例.尝试等待() {
            成功(有值(状态项)) => {
                状态值 = 有值(状态项);
                中断;
            }
            成功(状态选项) => {
                让 _ = 状态选项;
                标准库::线程::线程休眠(标准库::时间模块::持续时间::从毫秒(轮询间隔毫秒));
            }
            错误(_) => 中断,
        }
    }
    让 状态值 = 匹配 状态值 {
        有值(状态项) => 状态项,
        无 => {
            日志::警告!("镜像编译检查超时/异常，已终止（回退虚拟检查）");
            让 _ = 子进程实例.终止进程();
            让 _ = 子进程实例.等待进程();
            返回 无;
        }
    };
    让 标准输出文本 = 标准输出线程.等待线程().取值或默认();
    让 标准错误数据 = 标准错误线程.等待线程().取值或默认();
    如果 !状态值.退出成功() {
        // 编译错误属正常情况（诊断在标准输出）时同样以非零码退出；标准错误
        // 末尾才是包管理器层的真正错误（清单/锁/依赖解析），首行往往只是
        // `Checking ...` 进度行，取末尾若干行输出便于排查
        让 标准错误文本 = 字符串::从utf8宽松(&标准错误数据);
        如果 标准错误文本.包含("failed to") || 标准错误文本.包含("error: could not") {
            让 尾部: 向量<&文本> = 标准错误文本.逐行().逆序().取值(6).收集();
            让 尾部: 向量<&文本> = 尾部.消费迭代().逆序().收集();
            日志::警告!(
                "镜像编译检查非零退出（{:?}）：{}",
                状态值.代码(),
                尾部.连接(" / ")
            );
        }
    }
    有值((
        字符串::从utf8宽松(&标准输出文本).转字符串(),
        状态值.退出成功(),
    ))
}

/// 解析编译器 JSON 诊断流：坐标回译 → 消息翻译 → 所有权提取 → 合并发布
///
/// 返回 (可归位的编译消息数, 发布文件数)。
函数 发布编译器诊断(
    标准输出文本: &文本,
    镜像目录值: &路径类型,
    文件表: &[镜像文件],
    缓存: &原子引用计数<转译缓存>,
    管理器: &引擎库::映射管理器::映射管理器,
    内置诊断表: &原子引用计数<互斥锁<哈希映射<字符串, 向量<JSON值>>>>,
    消息发送方: &跨梁通道::发送端<语言服务器库::消息>,
) -> (无符号机器整数, 无符号机器整数) {
    // 产物路径 → 方言源映射：规范路径键归一编译器的绝对/相对路径
    让 索引表: 哈希映射<路径缓冲, &镜像文件> = 文件表
        .迭代()
        .过滤映射(|文件项| {
            标准库::文件系统::规范路径(&文件项.产物路径)
                .转选项()
                .映射(|路径值| (路径值, 文件项))
        })
        .收集();

    让 可变 按资源标识: 哈希映射<字符串, 向量<JSON值>> = 哈希映射::新建();
    让 可变 可归位数 = 0usize;
    对于 行文本 在 标准输出文本.逐行() {
        让 成功(值项) = JSON序列化::解析字符串::<JSON值>(行文本) 否则 {
            继续;
        };
        如果 值项["reason"].作为字符串() != 有值("compiler-message") {
            继续;
        }
        让 消息项 = &值项["message"];
        让 有值(跨度表) = 消息项["spans"].作为数组() 否则 {
            继续;
        };
        // 主跨度优先（编译器的跨度表可能把次级位置排在前面）
        让 有值(跨度项) = 跨度表
            .迭代()
            .查找(|单项| 单项["is_primary"] == JSON值::布尔值(真))
            .或用否则(|| 跨度表.第一个())
        否则 {
            继续;
        };
        让 有值(文件项) = 解析跨度文件(跨度项, 镜像目录值, &索引表) 否则 {
            继续; // 非方言文件（手写 .rs、标准库等）：不发布
        };
        可归位数 += 1;

        让 原始消息 = 消息项["message"].作为字符串().取值或("");
        让 错误码值 = 消息项["code"]["code"].作为字符串().取值或("").转字符串();
        让 严重级 = 匹配 消息项["level"].作为字符串() {
            有值("error") => 1,
            有值("warning") => 2,
            _ => 3,
        };
        让 有值((起行, 起列, 止行, 止列)) = 映射跨度范围(文件项, 跨度项) 否则 {
            继续;
        };
        让 范围值 = JSON序列化::JSON格式!({
            "start": { "line": 起行, "character": 起列 },
            "end": { "line": 止行, "character": 止列 }
        });

        // 次级跨度 → 关联信息（所有权可视化等）；消息先保留英文，
        // 供 提取所有权详情 关键词判定，发布前再翻译
        让 可变 原始关联: 向量<JSON值> = 向量::新建();
        对于 单项 在 跨度表 {
            如果 单项["is_primary"] == JSON值::布尔值(真) {
                继续;
            }
            让 有值(标签) = 单项["label"]
                .作为字符串()
                .过滤(|标签文本| !标签文本.是否为空())
            否则 {
                继续;
            };
            让 有值(关联文件) = 解析跨度文件(单项, 镜像目录值, &索引表) 否则 {
                继续;
            };
            让 有值((甲, 乙, 丙, 丁)) = 映射跨度范围(关联文件, 单项) 否则 {
                继续;
            };
            原始关联.推入(JSON序列化::JSON格式!({
                "location": {
                    "uri": 关联文件.原始资源标识,
                    "range": {
                        "start": { "line": 甲, "character": 乙 },
                        "end": { "line": 丙, "character": 丁 }
                    }
                },
                "message": 标签
            }));
        }

        让 原始 = JSON序列化::JSON格式!({ "message": 原始消息, "code": 错误码值 });
        让 还原后 =
            JSON序列化::JSON格式!({ "range": 范围值, "relatedInformation": 原始关联 });
        让 所有权详情值 = 提取所有权详情(&原始, &还原后, &文件项.原始资源标识);

        // 主消息与命令行同口径：传错误码 + 主跨度标签（编译器 JSON 携带
        // 期望类型与实际类型），使类型不匹配等能回填期望/实际并中文化类型名
        让 主消息 = 翻译诊断消息(
            如果 错误码值.是否为空() {
                无
            } 否则 {
                有值(&错误码值)
            },
            原始消息,
            跨度项["label"].作为字符串(),
        );
        让 可变 诊断项 = JSON序列化::JSON格式!({
            "range": 范围值,
            "severity": 严重级,
            "code": 错误码值,
            "message": 主消息,
        });
        如果 !原始关联.是否为空() {
            让 已翻译: 向量<JSON值> = 原始关联
                .迭代()
                .映射(|关联项| {
                    让 可变 单项 = 关联项.克隆值();
                    单项["message"] = JSON值::字符串值(翻译诊断消息(
                        无,
                        关联项["message"].作为字符串().取值或(""),
                        无,
                    ));
                    单项
                })
                .收集();
            诊断项["relatedInformation"] = JSON值::JSON数组(已翻译);
        }
        如果让 有值(详情值) = 所有权详情值
            && 让 成功(详情条目) = JSON序列化::序列化为值(&详情值)
        {
            诊断项["data"] = 详情条目;
        }
        按资源标识
            .取条目(文件项.原始资源标识.克隆值())
            .或用缺省()
            .推入(诊断项);
    }

    // 合并内置诊断（分析器最近一次映射后的方言坐标诊断 + 教学提示）：
    // 同错误码且同起始行视为重复（与虚拟检查的合并规则一致），
    // 避免镜像结果覆盖语法/类型实时诊断
    让 可变 发布数 = 0usize;
    对于 (资源标识, 可变 诊断表) 在 按资源标识 {
        如果让 成功(守卫) = 内置诊断表.加锁()
            && 让 有值(内置项) = 守卫.读取条目(&资源标识)
        {
            对于 内置诊断 在 内置项.克隆值() {
                让 重复 = 诊断表.迭代().任意(|诊断项| {
                    诊断项["code"] == 内置诊断["code"]
                        && 诊断项["range"]["start"]["line"]
                            == 内置诊断["range"]["start"]["line"]
                });
                如果 !重复 {
                    诊断表.推入(内置诊断);
                }
            }
        }
        // 教学诊断注入（全角标点 + 教学检查）：由条目内容直接计算，
        // 不依赖内置缓存（镜像检查先于分析器首批发布时缓存为空）
        如果让 有值(条目值) = 缓存.查询原始(&资源标识) {
            注入教学诊断(
                &可变 诊断表,
                &条目值,
                管理器.取校验分桶(),
                缓存.歧义构造器词(),
                缓存.英文回落映射(),
                缓存.关键词映射(),
            );
        }
        让 通知项 = 语言服务器库::通知消息 {
            方法: "textDocument/publishDiagnostics".转字符串(),
            请求参数: JSON序列化::JSON格式!({ "uri": 资源标识, "diagnostics": 诊断表 }),
        };
        让 _ = 消息发送方.发送(语言服务器库::消息::通知消息(通知项));
        发布数 += 1;
    }
    (可归位数, 发布数)
}

/// 解析跨度归属的方言文件（镜像产物路径 → 镜像文件）
函数 解析跨度文件<'甲>(
    跨度项: &JSON值,
    镜像目录值: &路径类型,
    索引表: &哈希映射<路径缓冲, &'甲 镜像文件>,
) -> 选项<&'甲 镜像文件> {
    让 名称值 = 跨度项["file_name"].作为字符串()?;
    让 路径值 = 路径类型::新建(名称值);
    // 编译器输出相对路径（工作目录为镜像项目根）或绝对路径，统一绝对化
    让 绝对路径 = 如果 路径值.是否绝对() {
        路径值.转路径缓冲()
    } 否则 {
        镜像目录值.连接(路径值)
    };
    让 规范值 = 标准库::文件系统::规范路径(绝对路径).转选项()?;
    索引表.读取条目(&规范值).复制值()
}

/// 跨度的起止位置回译：方言从 0 开始的行 + UTF-16 列（语言服务协议）
函数 映射跨度范围(
    文件项: &镜像文件,
    跨度项: &JSON值,
) -> 选项<(无符号整数, 无符号整数, 无符号整数, 无符号整数)> {
    让 行号 = 跨度项["line_start"].作为长整数()? 作为 无符号整数;
    让 列号 = 跨度项["column_start"].作为长整数()? 作为 无符号整数;
    让 末行号 = 跨度项["line_end"]
        .作为长整数()
        .取值或(行号 作为 无符号长整数) 作为 无符号整数;
    让 末列号 = 跨度项["column_end"]
        .作为长整数()
        .取值或(列号 作为 无符号长整数) 作为 无符号整数;
    让 (起行, 起列) = 映射位置(文件项, 行号, 列号);
    让 (止行, 止列) = 映射位置(文件项, 末行号, 末列号);
    有值((起行, 起列, 止行, 止列))
}

/// 单点回译：产物从 1 开始的行与字符列 → 方言从 0 开始的行与 UTF-16 列
///
/// 行号：入口产物含 `#[path]` 注解插入行，先经入口行映射换算回引擎直出
/// 行号（列映射以引擎直出产物为基准；注解行归属其模块声明行）。
/// 列号：引擎列映射输出方言字符列（与编译器列口径一致），再按方言文本
/// 换算为语言服务协议的 UTF-16 列。
函数 映射位置(
    文件项: &镜像文件,
    行号从1: 无符号整数,
    列号从1: 无符号整数,
) -> (无符号整数, 无符号整数) {
    让 引擎行号 = 匹配 &文件项.入口行映射 {
        有值(映射值) => 映射值
            .读取条目(行号从1.饱和减(1) 作为 无符号机器整数)
            .映射(|行值| *行值 作为 无符号整数 + 1)
            .取值或(行号从1),
        无 => 行号从1,
    };
    让 (母语行号, 母语字符列) = 文件项.列位映射数据.回译坐标(引擎行号, 列号从1);
    (
        母语行号.饱和减(1),
        母语字符列转编码单元(&文件项.母语内容, 母语行号, 母语字符列),
    )
}

/// 方言行内字符列（从 1 开始）→ UTF-16 列（从 0 开始）
///
/// 引擎列映射的列口径为字符数（与编译器 JSON 一致）；语言服务协议要求
/// UTF-16 代码单元列，非基本平面字符（表情符号等）占 2 个单元，须逐字符累加。
函数 母语字符列转编码单元(
    母语内容: &文本,
    行号从1: 无符号整数,
    字符列从1: 无符号整数,
) -> 无符号整数 {
    让 有值(行文本) = 母语内容
        .逐行()
        .取第项(行号从1.饱和减(1) 作为 无符号机器整数)
    否则 {
        返回 字符列从1.饱和减(1);
    };
    行文本
        .逐字符()
        .取值(字符列从1.饱和减(1) 作为 无符号机器整数)
        .映射(|字符值| 字符值.长度UTF16() 作为 无符号整数)
        .求和()
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    函数 构造待写项(名称值: &文本, 转译文本: &文本) -> 待写产物 {
        待写产物 {
            镜像路径: 路径缓冲::从("/mirror/src").连接(名称值),
            转译文本: 转译文本.转字符串(),
            列位映射数据: 引擎库::列位映射::列位映射表::回放生成("", &[]),
            母语内容: 字符串::新建(),
        }
    }

    /// 小于 8 字符的短行（`}`、空行等）不参与相似度，避免结构行虚高命中
    #[测试]
    函数 行相似度忽略短行() {
        断言相等!(行相似度("}\n{\n", "}\n{\n"), 0.0);
        断言相等!(行相似度("", ""), 0.0);
        // 参照侧全是短行 → 实质行为空 → 0.0
        断言相等!(行相似度("fn main() {}", "}\n)\n"), 0.0);
    }

    /// 完全相同为 1.0；无交集为 0.0
    #[测试]
    函数 行相似度边界() {
        让 样本文本 = "fn main() {\n    println!(\"hi\");\n}\n";
        断言相等!(行相似度(样本文本, 样本文本), 1.0);
        断言相等!(
            行相似度(样本文本, "fn other() {\n    let 甲 = 1;\n}\n"),
            0.0
        );
    }

    /// 分母取两侧较大者：小文件与参照的局部巧合命中无法抬高分数
    ///
    /// 候选仅 1 条实质行且命中，参照有 3 条实质行 → 1/3 而非 1.0。
    #[测试]
    函数 行相似度分母取较大侧() {
        让 参照文本 = "fn 甲() {\nfn 乙() {\nfn 丙() {\n";
        让 分数 = 行相似度("fn 甲() {\n", 参照文本);
        断言!(
            (分数 - 1.0 / 3.0).绝对值() < 1e-9,
            "分母应为 3（较大侧），实际 {分数}"
        );
    }

    /// 分词干为入口名的方言文件优先作为入口（不看相似度）
    #[测试]
    函数 识别入口优先主词干() {
        让 候选表 = 向量![
            构造待写项("甲.zh", "fn 甲() {\n    let 甲值 = 1;\n}\n"),
            构造待写项("main.zh", "fn 主函数() {\n}\n"),
            构造待写项("乙.zh", "fn 乙() {\n    let 乙值 = 2;\n}\n"),
        ];
        断言相等!(
            识别入口(&候选表, 无)
                .映射(|路径值| 路径值.文件名().解包().转有损字符串().转所有权()),
            有值("main.zh".转字符串()),
            "词干为入口名时应无视相似度直接选中"
        );
    }

    /// 无入口词干时按与现有入口产物的相似度选取（须达阈值 0.6）
    #[测试]
    函数 识别入口按相似度阈值() {
        让 入口文本 = "fn 主函数() {\n    println!(\"你好\");\n}\n";
        让 候选表 = 向量![
            构造待写项("甲.zh", "fn 甲() {\n    let 甲值 = 1;\n}\n"),
            构造待写项("入口.zh", 入口文本),
        ];
        断言相等!(
            识别入口(&候选表, 有值(入口文本))
                .映射(|路径值| 路径值.文件名().解包().转有损字符串().转所有权()),
            有值("入口.zh".转字符串()),
            "相似度达阈值者应被选为入口"
        );
        // 全部候选都与参照不相似 → 无（低于阈值宁可不识别）
        断言!(
            识别入口(
                &[构造待写项("甲.zh", "fn 甲() {\n    let 甲值 = 1;\n}\n")],
                有值("fn 乙() {\n    let 乙值 = 2;\n}\n")
            )
            .是否为无(),
            "相似度不足阈值时不应误判入口"
        );
    }

    /// 无入口词干且无参照入口产物时无法识别入口
    #[测试]
    函数 识别入口无参照() {
        让 候选表 = 向量![构造待写项("甲.zh", "fn 甲() {\n    let 甲值 = 1;\n}\n")];
        断言!(识别入口(&候选表, 无).是否为无());
        断言!(识别入口(&[], 有值("fn 主函数() {\n}\n")).是否为无());
    }

    /// 方言扩展名匹配：大小写与后缀精确性
    #[测试]
    函数 判定文件匹配扩展名() {
        让 扩展名列表 = 向量!["zh".转字符串(), "ja".转字符串()];
        断言!(文件匹配扩展名(路径类型::新建("/p/main.zh"), &扩展名列表));
        断言!(文件匹配扩展名(路径类型::新建("/p/模块.ja"), &扩展名列表));
        断言!(!文件匹配扩展名(路径类型::新建("/p/main.rs"), &扩展名列表));
        // 仅匹配完整后缀：多一个字符不算 `.zh`
        断言!(!文件匹配扩展名(路径类型::新建("/p/main.zhx"), &扩展名列表));
        // 无扩展名
        断言!(!文件匹配扩展名(路径类型::新建("/p/main"), &扩展名列表));
    }

    /// 项目根哈希：同路径稳定、不同路径不同（镜像目录隔离的依据）
    #[测试]
    函数 路径哈希稳定且不同() {
        让 甲 = 路径哈希(路径类型::新建("/a/b"));
        断言相等!(甲, 路径哈希(路径类型::新建("/a/b")), "同路径应稳定");
        断言不等!(甲, 路径哈希(路径类型::新建("/a/c")), "不同路径应不同");
    }

    /// 字符列 → UTF-16 列：非基本平面字符占 2 个单元，基本平面中文占 1
    #[测试]
    函数 母语字符列转编码单元计数() {
        // "字符😀甲"：字符列从 1 开始 → 取前 n 个字符累加编码单元
        让 样本文本 = "字符😀甲";
        断言相等!(母语字符列转编码单元(样本文本, 1, 1), 0);
        断言相等!(母语字符列转编码单元(样本文本, 1, 2), 1);
        // 含表情符号：到第 4 列时已计入表情符号的 2 个单元
        断言相等!(母语字符列转编码单元(样本文本, 1, 4), 4);
        // 越界行回退为从 0 开始的字符列
        断言相等!(母语字符列转编码单元(样本文本, 9, 3), 2);
    }

    /// 项目根定位：沿目录上行找最近的清单文件；全程没有则无
    #[测试]
    函数 查找项目根最近且缺失() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根目录 = 临时.条目路径().连接("proj");
        让 深层 = 根目录.连接("src/sub/deep");
        标准库::文件系统::创建所有目录(&深层).解包();
        标准库::文件系统::写入(根目录.连接("Cargo.toml"), "[package]\n").解包();
        让 触发文件 = 深层.连接("main.zh");
        断言相等!(
            查找项目根(&触发文件).作为解引用(),
            有值(根目录.转路径())
        );
        // 内层另有清单文件时取最近者
        标准库::文件系统::写入(深层.连接("Cargo.toml"), "[package]\n").解包();
        断言相等!(
            查找项目根(&触发文件).作为解引用(),
            有值(深层.转路径())
        );
        // 无清单文件的目录树（单文件教学场景）→ 无
        让 其他目录 = 临时.条目路径().连接("noproject/a");
        标准库::文件系统::创建所有目录(&其他目录).解包();
        断言!(查找项目根(&其他目录.连接("main.zh")).是否为无());
    }

    /// 镜像目录名：固定前缀 + 用户 + 进程号 + 项目哈希；用户名非法字符清洗为下划线
    #[测试]
    函数 镜像目录形状与用户名净化() {
        让 根路径 = 路径类型::新建("/tmp/proj-alpha");
        让 目录值 = 镜像目录路径(根路径);
        让 名称值 = 目录值.文件名().解包().转有损字符串().转所有权();
        断言!(名称值.以开头("i18n_lsp_mirror_"), "实际：{名称值}");
        断言!(
            名称值.以结尾(&格式化!("_{:x}", 路径哈希(根路径))),
            "目录名应以项目哈希结尾：{名称值}"
        );

        // 用户名含空格/斜杠等非法字符时清洗（保存/恢复用户名环境变量，避免污染其他测试）
        让 已保存 = 标准库::环境::环境变量("USER").转选项();
        不安全 {
            标准库::环境::设置环境变量("USER", "a b/c");
        }
        让 目录二 = 镜像目录路径(根路径);
        让 名称二 = 目录二.文件名().解包().转有损字符串().转所有权();
        断言!(
            名称二.包含("a_b_c"),
            "用户名非法字符应替换为下划线：{名称二}"
        );
        不安全 {
            匹配 已保存 {
                有值(值文本) => 标准库::环境::设置环境变量("USER", 值文本),
                无 => 标准库::环境::移除环境变量("USER"),
            }
        }
    }

    /// 是符号链接识别符号链接（含悬空链接），非链接路径返回假—与
    /// 服务器模块同名测试同风格，仅 Unix 跑（Windows 建符号链接需特权，避免抖动）。
    #[配置(Unix系统)]
    #[测试]
    函数 是符号链接识别链接与普通文件() {
        让 临时 = 临时文件::建临时目录().解包();
        让 文件值 = 临时.条目路径().连接("f");
        标准库::文件系统::写入(&文件值, b"x").解包();
        断言!(!是符号链接(&文件值), "普通文件不是符号链接");
        断言!(
            !是符号链接(&临时.条目路径().连接("absent")),
            "不存在路径不是符号链接"
        );
        让 链接值 = 临时.条目路径().连接("link");
        标准库::操作系统::Unix系统::文件系统::符号链接(&文件值, &链接值).解包();
        断言!(是符号链接(&链接值), "符号链接应被识别");
        让 悬空值 = 临时.条目路径().连接("dangling");
        标准库::操作系统::Unix系统::文件系统::符号链接(
            临时.条目路径().连接("gone"),
            &悬空值,
        )
        .解包();
        断言!(是符号链接(&悬空值), "悬空符号链接仍须识别为链接");
    }

    /// 项目树复制：源文件递归复制；target/.git/node_modules/dist/.rz 一律排除
    #[测试]
    函数 复制项目树过滤排除目录() {
        让 临时 = 临时文件::建临时目录().解包();
        让 来源值 = 临时.条目路径().连接("proj");
        标准库::文件系统::创建所有目录(来源值.连接("src/sub")).解包();
        标准库::文件系统::写入(来源值.连接("Cargo.toml"), "[package]\n").解包();
        标准库::文件系统::写入(来源值.连接("src/main.zh"), "函数 主函数() {}\n").解包();
        标准库::文件系统::写入(来源值.连接("src/sub/util.zh"), "公开 函数 工具() {}\n")
            .解包();
        对于 排除项 在 [
            "target/debug/x",
            ".git/config",
            "node_modules/lib/a",
            "dist/bundle",
            // 托管生成物不镜像：镜像里由转译重新产出，带上旧产物只会多余字节
            ".rz/gen/src/数学.rs",
        ] {
            让 路径值 = 来源值.连接(排除项);
            标准库::文件系统::创建所有目录(路径值.父目录().解包()).解包();
            标准库::文件系统::写入(路径值, "应被排除").解包();
        }
        让 目标值 = 临时.条目路径().连接("mirror");
        复制项目树(&来源值, &目标值).解包();
        断言!(目标值.连接("Cargo.toml").是否为文件());
        断言!(目标值.连接("src/main.zh").是否为文件());
        断言!(目标值.连接("src/sub/util.zh").是否为文件());
        断言!(!目标值.连接("target").存在());
        断言!(!目标值.连接(".git").存在());
        断言!(!目标值.连接("node_modules").存在());
        断言!(!目标值.连接("dist").存在());
        断言!(!目标值.连接(".rz").存在());
    }

    /// 方言源收集：递归、仅匹配给定扩展名
    #[测试]
    函数 收集方言路径递归() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根目录 = 临时.条目路径().连接("proj/src");
        标准库::文件系统::创建所有目录(根目录.连接("sub")).解包();
        标准库::文件系统::写入(根目录.连接("main.zh"), "").解包();
        标准库::文件系统::写入(根目录.连接("main.rs"), "").解包();
        标准库::文件系统::写入(根目录.连接("sub/util.zh"), "").解包();
        让 可变 收集表 = 向量::新建();
        收集方言路径(&根目录, &[".zh".转字符串()], &可变 收集表);
        收集表.排序();
        让 名称清单: 向量<字符串> = 收集表
            .迭代()
            .映射(|路径值| 路径值.去前缀(&根目录).解包().展示().转字符串())
            .收集();
        // 期望值按平台构造分隔符：去前缀后再展示会带上平台分隔符，
        // 硬写固定分隔符只会测到平台差异而非收集逻辑
        让 期望清单: 向量<字符串> = [
            路径缓冲::从("main.zh"),
            路径缓冲::从("sub").连接("util.zh"),
        ]
        .迭代()
        .映射(|路径值| 路径值.转有损字符串().转所有权())
        .收集();
        断言相等!(名称清单, 期望清单);
        // 目录不存在不报错（调用方依赖此容错）
        让 可变 空表 = 向量::新建();
        收集方言路径(
            &临时.条目路径().连接("absent"),
            &[".zh".转字符串()],
            &可变 空表,
        );
        断言!(空表.是否为空());
    }

    /// 构造一个带列映射的镜像文件（母语「让 x = 1;」→ 英文 `let x = 1;`）
    函数 构造映射文件(入口行映射: 选项<向量<无符号机器整数>>) -> 镜像文件 {
        让 母语源 = "让 x = 1;\n";
        让 编辑表 = [引擎库::缓存::源码映射条目::新建源码映射条目(0, 3, "让", "let")];
        镜像文件 {
            产物路径: 路径缓冲::从("/mirror/src/main.rs"),
            原始资源标识: "file:///proj/src/main.zh".转字符串(),
            母语内容: 母语源.转字符串(),
            列位映射数据: 引擎库::列位映射::列位映射表::回放生成(母语源, &编辑表),
            入口行映射,
        }
    }

    /// 跨度回译：列经列映射换算，行转从 0 开始；无 `#[path]` 行映射时行号恒等
    #[测试]
    函数 映射跨度范围列与行基础() {
        让 文件项 = 构造映射文件(无);
        // 产物 `let x = 1;` 第 1 行第 5 列（x 的首列，从 1 开始）
        // → 方言「让 x = 1;」第 3 列；输出为从 0 开始的行 + UTF-16 列
        让 跨度项 = JSON序列化::JSON格式!({"line_start": 1, "column_start": 5});
        断言相等!(映射跨度范围(&文件项, &跨度项), 有值((0, 2, 0, 2)));
        // 缺 行起点 → 无（无法回译）
        让 缺失项 = JSON序列化::JSON格式!({"column_start": 5});
        断言相等!(映射跨度范围(&文件项, &缺失项), 无);
    }

    /// 入口产物含 `#[path]` 注解插入行：产物行先经入口行映射回引擎直出行号
    #[测试]
    函数 映射位置换算入口插入行() {
        // 方言 3 行；产物在顶部插入 1 行注解：产物 1 行 ↔ 引擎 3 行（映射值 2 → 行 3）
        让 母语源 = "函数 主函数() {\n    打印行!(\"hi\");\n}\n";
        让 编辑表 = [
            引擎库::缓存::源码映射条目::新建源码映射条目(0, 6, "函数", "fn"),
            // 第 1 行 21 字节 + 4 个前导空格 → 「打印行」字节偏移 25
            引擎库::缓存::源码映射条目::新建源码映射条目(25, 9, "打印行", "println"),
        ];
        让 文件项 = 镜像文件 {
            产物路径: 路径缓冲::从("/mirror/src/main.rs"),
            原始资源标识: "file:///proj/src/main.zh".转字符串(),
            母语内容: 母语源.转字符串(),
            列位映射数据: 引擎库::列位映射::列位映射表::回放生成(母语源, &编辑表),
            入口行映射: 有值(向量![2, 0, 1]),
        };
        // 产物第 1 行 → 引擎第 3 行（"}" 行）→ 方言从 0 开始的第 2 行
        让 (起行, _起列, 止行, _止列) = 映射跨度范围(
            &文件项,
            &JSON序列化::JSON格式!({"line_start": 1, "column_start": 1}),
        )
        .解包();
        断言相等!((起行, 止行), (2, 2));
        // 产物第 2 行 → 引擎第 1 行（映射值 0）
        让 (起行二, _, _, _) = 映射跨度范围(
            &文件项,
            &JSON序列化::JSON格式!({"line_start": 2, "column_start": 1}),
        )
        .解包();
        断言相等!(起行二, 0);
    }

    /// 全链路非基本平面回译（列映射字符列 → UTF-16 列 的组合边界）：
    /// 诊断列落在非基本平面字符（表情符号）之后时，回译必须先把表情符号当作
    /// 1 个字符参与列映射、再在转 UTF-16 时计为 2 个单元——两步口径不能混用。
    /// 母语「让😀x = 1;」→ 产物 `let😀x = 1;`：x 在产物第 5 字符列，回译出
    /// 方言字符列 3（让=1、😀=2、x=3），转 UTF-16 为 3（让占 1 单元 + 😀占 2）。
    /// 与纯基本平面基线同列只给 2 形对比——若误用字符数口径会少算表情符号的额外
    /// 单元（返回 2），本测试把模块文档「混用会在非基本平面字符上产生偏移」钉死。
    #[测试]
    函数 映射跨度范围非基本平面列前() {
        让 母语源 = "让😀x = 1;\n";
        让 编辑表 = [引擎库::缓存::源码映射条目::新建源码映射条目(0, 3, "让", "let")];
        让 文件项 = 镜像文件 {
            产物路径: 路径缓冲::从("/mirror/src/main.rs"),
            原始资源标识: "file:///proj/src/main.zh".转字符串(),
            母语内容: 母语源.转字符串(),
            列位映射数据: 引擎库::列位映射::列位映射表::回放生成(母语源, &编辑表),
            入口行映射: 无,
        };
        // 产物 `let😀x = 1;` 中 x 在第 5 字符列 → 方言 UTF-16 列 3
        让 跨度项 = JSON序列化::JSON格式!({"line_start": 1, "column_start": 5});
        断言相等!(映射跨度范围(&文件项, &跨度项), 有值((0, 3, 0, 3)));
    }
}
