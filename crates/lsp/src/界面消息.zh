//! 界面消息本地化模块（LSP 自有加载链，解析与回退语义复用引擎 `界面消息` 模块）
//!
//! 每个语言包的 `ui.toml` 提供 `["界面消息"]` 节，内含 LSP 帮助与错误提示；
//! 可选提供 `["解释"]` 节，内含方法/函数的大白话使用提示（键为符号路径）。
//! 占位符 `{}` 在运行时按出现顺序替换为具体参数。
//!
//! 加载优先级：
//! 1. 显式语言包目录内的 `ui.toml`（用户自定义覆盖）
//! 2. 按语言包目录名匹配内置语言包（如 `lang-packs/de` → 德语提示语）
//! 3. `RZ_LANG` 环境变量
//! 4. 系统语言（`LC_ALL` / `LC_MESSAGES` / `LANG`）
//! 5. 中文（默认）

使用 标准库::路径::路径类型;
使用 标准库::同步::一次性锁;

使用 引擎库::界面消息::消息表;

/// 全局界面（入口启动时设定；未设定时回退内置中文，便于测试）
静态 全局界面槽: 一次性锁<界面> = 一次性锁::新建();
/// 未设定时的中文回退实例（独立于全局界面槽，避免占用全局槽位）
静态 回退界面槽: 一次性锁<界面> = 一次性锁::新建();

/// 初始化全局界面消息（用显式语言包目录加载）
///
/// 同时把命中的语言代码同步给引擎全局语言（[`引擎库::语言::设定语言`]）：
/// 引擎侧的用户可见文本按**全局语言**取模板，与 LSP 自己的 `lsp_*` 消息是两条
/// 链路。不同步会让界面消息与引擎教学文本各说各话。
公开 函数 设定全局(语言包路径: &路径类型) {
    让 (界面实例, 语言代码) = 界面::载入带语言(语言包路径);
    引擎库::语言::设定语言(&语言代码);
    让 _ = 全局界面槽.设置(界面实例);
}

/// 获取全局界面消息（未设定时回退内置中文，不占用全局槽位）
公开 函数 全局界面<'甲>() -> &'甲 界面 {
    全局界面槽.获取().解包或用否则(|| {
        回退界面槽.取得或初始化(|| 界面::自内容构造(内置界面("zh").取值或默认()))
    })
}

/// 界面消息表
///
/// 解析、`{}` 替换与缺键回退统一由引擎 [`消息表`] 实现；本模块只保留
/// LSP 自己的加载链（显式目录 → 目录名 → 环境变量 → 中文）。
公开 结构体 界面 {
    界面表: 消息表,
}

// 内置 ui.toml 由引擎包编译期嵌入（避免发布打包时路径失效），
// 经 [`内置界面`] 按语言代码获取，保证任意语言包目录名都能得到对应提示语

实现 界面 {
    /// 从 TOML 内容构造消息表（`["界面消息"]` + `["解释"]` 节）
    函数 自内容构造(内容: &文本) -> 自身 {
        自身 {
            界面表: 消息表::成表(内容),
        }
    }

    /// 按加载优先级获取界面消息
    ///
    /// 只要消息表、不要语言代码时用这个；两者需同源的场景（启动初始化）改用
    /// [`界面::载入带语言`]，别在这里再判一遍语言。
    公开 函数 载入(语言包路径: &路径类型) -> 自身 {
        自身::载入带语言(语言包路径).0
    }

    /// 按加载优先级获取界面消息，并返回实际命中的语言代码
    ///
    /// 语言代码与消息表由同一条链产出：两条链路各判一次语言，就会出现「界面消息
    /// 是德语、引擎教学文本是中文」的混合输出。第 1 档的自定义目录里的 ui.toml
    /// 没有语言身份，按目录名登记：未知代码在引擎侧逐级回退内置中文表。
    公开 函数 载入带语言(语言包路径: &路径类型) -> (自身, 字符串) {
        让 目录语言 = 语言包路径
            .文件名()
            .而后映射(|串| 串.取字符串引用())
            .取值或("zh")
            .转字符串();
        // 1. 显式语言包目录内的 ui.toml
        如果让 成功(内容) = 标准库::文件系统::读取字符串(语言包路径.连接("ui.toml")) {
            让 界面实例 = 自身::自内容构造(&内容);
            如果 !界面实例.界面表.没有消息() {
                返回 (界面实例, 目录语言);
            }
        }
        // 2. 目录名匹配内置语言包
        如果让 有值(内置文本) = 内置界面(&目录语言) {
            返回 (自身::自内容构造(内置文本), 目录语言);
        }
        // 3. RZ_LANG 环境变量
        让 环境语言 = 标准库::环境::环境变量("RZ_LANG")
            .变换(|值| 值.裁剪().转小写())
            .取值或默认();
        如果 !环境语言.是否为空() {
            如果让 有值(内置文本) = 内置界面(&环境语言) {
                返回 (自身::自内容构造(内置文本), 环境语言);
            }
        }
        // 4. 系统语言
        对于 区域变量 在 ["LC_ALL", "LC_MESSAGES", "LANG"] {
            如果让 成功(值) = 标准库::环境::环境变量(区域变量) {
                让 小写 = 值.转小写();
                让 语言标签 = 小写.分割(['_', '-', '.']).下一个().取值或("").裁剪();
                如果让 有值(内置文本) = 内置界面(语言标签) {
                    返回 (自身::自内容构造(内置文本), 语言标签.转字符串());
                }
            }
        }
        // 5. 中文（默认）
        (
            自身::自内容构造(内置界面("zh").取值或默认()),
            "zh".转字符串(),
        )
    }

    /// 取消息模板：本表 → 内置中文表 → 键名本身
    公开 函数 取消息(&自我, 键名: &文本) -> 字符串 {
        自我.界面表.取消息(键名)
    }

    /// 取消息模板并替换 `{}` 占位符（按出现顺序）
    公开 函数 取带参消息(&自我, 键名: &文本, 消息参数: &[&文本]) -> 字符串 {
        自我.界面表.取带参消息(键名, 消息参数)
    }

    /// 取大白话解释（缺失返回 `无`，调用方保持原样回退）
    公开 函数 取解释(&自我, 键名: &文本) -> 选项<&文本> {
        自我.界面表.解释(键名)
    }
}

/// 语言代码 → 内置 ui.toml（数据由引擎包编译期嵌入）
函数 内置界面(语言代码: &文本) -> 选项<静态字符串引用> {
    引擎库::语言::内置文件(语言代码, "ui.toml")
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    #[测试]
    函数 内置全部语言可用() {
        对于 语言代码 在 ["zh", "de", "ja", "ru", "es", "fr", "pt", "ko", "ar", "hi"] {
            断言(内置界面(语言代码).是否为有值(), "{语言代码} 应内置 ui.toml");
        }
    }

    #[测试]
    函数 取带参消息委托引擎() {
        // 占位符替换走引擎统一实现：顺序填充、缺参保留 `{}`
        让 界面实例 = 界面::自内容构造("[\"界面消息\"]\n\"k\" = \"{} 和 {}\"\n");
        断言相等!(界面实例.取带参消息("k", &["a"]), "a 和 {}");
        断言相等!(界面实例.取带参消息("k", &["a", "b", "c"]), "a 和 b");
    }

    #[测试]
    函数 解析解释节() {
        让 界面实例 = 界面::自内容构造(
            "[\"界面消息\"]\n\"a\" = \"b\"\n[\"解释\"]\n\"Option::unwrap\" = \"直接取出值，出错就崩溃\"\n\"tokio::spawn\" = \"后台任务\"\n",
        );
        断言相等!(
            界面实例.取解释("Option::unwrap"),
            有值("直接取出值，出错就崩溃")
        );
        断言相等!(界面实例.取解释("tokio::spawn"), 有值("后台任务"));
        断言相等!(界面实例.取解释("不存在的键"), 无);
        // 只有 ["解释"] 没有 ["界面消息"] 时也能工作
        让 仅解释 = 界面::自内容构造("[\"解释\"]\n\"Vec::push\" = \"末尾追加\"\n");
        断言相等!(仅解释.取解释("Vec::push"), 有值("末尾追加"));
        // 没有 ["界面消息"] 节：界面消息回退内置中文表（不再直接吐裸键名）
        断言相等!(仅解释.取消息("lsp_about"), "i18n-rust LSP 代理服务器");
    }

    #[测试]
    函数 按目录名加载() {
        让 界面实例 = 界面::载入(路径类型::新建("/任意路径/de"));
        断言相等!(界面实例.取消息("lsp_about"), "i18n-rust LSP-Proxy-Server");
    }

    #[测试]
    函数 默认回退中文() {
        // 加载优先级中环境变量（RZ_LANG / LC_ALL / LC_MESSAGES / LANG）先于
        // 默认中文：CI 的区域设置可能先命中其它语言包。此处临时接管清除全部
        // 语言来源，验证「无任何来源时回退中文」。本包仅此测试触碰这些变量。
        让 键集 = ["RZ_LANG", "LC_ALL", "LC_MESSAGES", "LANG"];
        让 保存值: 向量<(&文本, 选项<字符串>)> =
            键集.迭代().变换(|键| (*键, 标准库::环境::环境变量(键).转选项())).收集();
        对于 键 在 键集 {
            不安全 {
                标准库::环境::移除环境变量(键);
            }
        }
        让 关于 = 界面::载入(路径类型::新建("/不存在的目录")).取消息("lsp_about");
        // 先恢复环境变量再断言：断言失败触发恐慌也不污染并行测试
        对于 (键, 旧值) 在 保存值 {
            匹配 旧值 {
                有值(值) => 不安全 {
                    标准库::环境::设置环境变量(键, 值);
                },
                无 => 不安全 {
                    标准库::环境::移除环境变量(键);
                },
            }
        }
        断言相等!(关于, "i18n-rust LSP 代理服务器");
    }
}
