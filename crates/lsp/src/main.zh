//! i18n-rust 语言服务代理服务器（二进制入口）
//!
//! 作为语言服务器接收编辑器的连接，将方言 Rust 文件（.zh/.de 等）
//! 翻译为标准 Rust 后交给分析器处理，实现母语代码的
//! 智能补全、错误提示等功能。
//!
//! 用法：
//!   i18n-rust-lsp [语言包路径选项] [扩展名清单选项]
//!
//! 默认语言包路径：crates/engine/lang-packs/zh（主仓库单副本）；默认扩展名：全部内置语言包的扩展名
//!
//! 功能模块在库目标（[`语言服务库`]）中实现，本文件仅做
//! 命令行解析与启动；模块清单与职责见 `src/lib.rs`。

使用 标准库::路径::路径缓冲;

使用 语言服务库::{服务器, 界面消息};

/// 命令行参数
结构体 命令行参数 {
    /// 语言包目录路径
    语言包路径: 路径缓冲,
    /// 支持的方言文件扩展名列表（如 `.zh`）
    扩展名表: 向量<字符串>,
}

/// 解析逗号分隔的扩展名列表，自动补充点号前缀
///
/// 空项（如 `zh,,en`）被忽略。
/// 示例：`zh, .de,ja` → `.zh`、`.de`、`.ja`
函数 解析扩展名表(清单文本: &文本) -> 向量<字符串> {
    清单文本
        .分割(',')
        .映射(|单项| 单项.裁剪())
        .过滤(|单项| !单项.是否为空())
        .映射(|单项| {
            如果 单项.以开头('.') {
                单项.转字符串()
            } 否则 {
                格式化!(".{}", 单项)
            }
        })
        .收集()
}

/// 解析命令行参数
函数 解析参数() -> 命令行参数 {
    让 可变 语言包路径 = 路径缓冲::从("crates/engine/lang-packs/zh");
    让 可变 扩展名表: 向量<字符串> = 向量::新建();

    让 参数表: 向量<字符串> = 标准库::环境::参数们().收集();
    让 可变 下标 = 1;
    当 下标 < 参数表.长度() {
        匹配 参数表[下标].作为文本切片() {
            "--language-pack" | "-l" => {
                如果 下标 + 1 < 参数表.长度() {
                    语言包路径 = 路径缓冲::从(&参数表[下标 + 1]);
                    下标 += 2;
                } 否则 {
                    让 界面表 = 界面消息::界面::载入(&语言包路径);
                    错误打印行!("{}", 界面表.取消息("lsp_err_lang_pack"));
                    标准库::进程::退出(1);
                }
            }
            "--extensions" | "-e" => {
                如果 下标 + 1 < 参数表.长度() {
                    扩展名表 = 解析扩展名表(&参数表[下标 + 1]);
                    下标 += 2;
                } 否则 {
                    让 界面表 = 界面消息::界面::载入(&语言包路径);
                    错误打印行!("{}", 界面表.取消息("lsp_err_extensions"));
                    标准库::进程::退出(1);
                }
            }
            "--help" | "-h" => {
                让 界面表 = 界面消息::界面::载入(&语言包路径);
                打印帮助(&界面表);
                标准库::进程::退出(0);
            }
            // 输出版本号（纯版本号，供安装命令的版本校验解析）
            "--version" | "-V" => {
                打印行!("{}", 环境!("CARGO_PKG_VERSION"));
                标准库::进程::退出(0);
            }
            // 编辑器语言客户端会传递标准输入输出模式参数，本程序默认就用标准输入输出，直接忽略
            "--stdio" => {
                下标 += 1;
            }
            _ => {
                让 界面表 = 界面消息::界面::载入(&语言包路径);
                错误打印行!("{}", 界面表.取带参消息("lsp_unknown_arg", &[&参数表[下标]]));
                错误打印行!("{}", 界面表.取消息("lsp_use_help"));
                标准库::进程::退出(1);
            }
        }
    }

    命令行参数 {
        语言包路径,
        扩展名表,
    }
}

/// 打印帮助文本（提示语随语言包/系统语言本地化）
函数 打印帮助(界面表: &界面消息::界面) {
    打印行!("{}", 界面表.取消息("lsp_about"));
    打印行!();
    打印行!("{}", 界面表.取消息("lsp_usage"));
    打印行!();
    打印行!("{}", 界面表.取消息("lsp_options"));
    打印行!("{}", 界面表.取消息("lsp_lang_pack_opt"));
    打印行!("{}", 界面表.取消息("lsp_extensions_opt"));
    打印行!("{}", 界面表.取消息("lsp_version_opt"));
    打印行!("{}", 界面表.取消息("lsp_help_opt"));
}

/// 当默认语言包路径不存在时，自动搜索常见位置
///
/// 搜索顺序：
/// 1. 二进制所在目录向上搜索（最多五级）
/// 2. 当前工作目录向上搜索
/// 3. 主目录下常见项目目录
函数 查找语言包回退(默认路径: &标准库::路径模块::路径类型, 语言代码: &文本) -> 路径缓冲 {
    如果 默认路径.存在() {
        返回 默认路径.转路径缓冲();
    }
    日志::警告!("默认语言包路径 {} 不存在，正在搜索...", 默认路径.展示());
    // 1. 二进制所在目录向上搜索
    如果让 成功(程序路径) = 标准库::环境::当前可执行文件()
        && 让 有值(命中路径) = 向上搜索(&程序路径, 语言代码)
    {
        日志::信息!("在二进制目录找到语言包: {}", 命中路径.展示());
        返回 命中路径;
    }
    // 2. 当前工作目录向上搜索
    如果让 成功(工作目录) = 标准库::环境::当前目录()
        && 让 有值(命中路径) = 向上搜索(&工作目录, 语言代码)
    {
        日志::信息!("在工作目录找到语言包: {}", 命中路径.展示());
        返回 命中路径;
    }
    // 3. 主目录下常见项目目录（两种布局：主仓库单副本与用户项目约定）
    如果让 成功(主目录) = 标准库::环境::环境变量("HOME") {
        对于 项目名 在 &["code/zrRust", "zrRust"] {
            对于 布局名 在 &["crates/engine/lang-packs", "lang-packs"] {
                让 候选路径 = 路径缓冲::从(&主目录)
                    .连接(项目名)
                    .连接(布局名)
                    .连接(语言代码);
                如果 候选路径.存在() {
                    日志::信息!("在主目录找到语言包: {}", 候选路径.展示());
                    返回 候选路径;
                }
            }
        }
    }
    日志::警告!("未找到语言包目录，使用内置映射");
    默认路径.转路径缓冲()
}

/// 从指定路径向上搜索语言包目录（最多五级；两种布局均探测：
/// 主仓库单副本与用户项目约定）
函数 向上搜索(起点: &标准库::路径模块::路径类型, 语言代码: &文本) -> 选项<路径缓冲> {
    让 可变 当前目录 = 起点.父目录()?.转路径缓冲();
    对于 _ 在 0..5 {
        对于 布局名 在 &["crates/engine/lang-packs", "lang-packs"] {
            让 候选路径 = 当前目录.连接(布局名).连接(语言代码);
            如果 候选路径.存在() {
                返回 有值(候选路径);
            }
        }
        如果 !当前目录.弹出() {
            中断;
        }
    }
    无
}

函数 主函数() -> 错误处理::结果<空> {
    // 初始化日志
    环境变量日志::构建器::从环境(
        环境变量日志::日志环境::默认值().默认过滤器或("info"),
    )
    .格式时间戳毫秒()
    .初始化();

    // 解析命令行参数
    让 可变 参数 = 解析参数();

    // 如果语言包路径不存在，自动搜索（仅在未显式指定时）
    让 显式指定 =
        标准库::环境::参数们().任意(|单个参数| 单个参数 == "--language-pack" || 单个参数 == "-l");
    如果 !显式指定 && !参数.语言包路径.存在() {
        // 从默认路径推断语言代码
        让 语言代码 = 参数
            .语言包路径
            .文件名()
            .而后映射(|名称值| 名称值.取字符串引用())
            .解包或用("zh");
        参数.语言包路径 = 查找语言包回退(&参数.语言包路径, 语言代码);
    }

    // 初始化全局界面消息（随语言包/系统语言变化）
    界面消息::设定全局(&参数.语言包路径);
    日志::信息!("{}", 界面消息::全局界面().取消息("lsp_log_start"));
    日志::信息!(
        "{}",
        界面消息::全局界面().取带参消息(
            "lsp_log_lang_pack",
            &[&参数.语言包路径.展示().转字符串()]
        )
    );

    // 创建代理服务器
    让 (服务器实例, 输入输出线程) =
        服务器::代理服务器::新建(&参数.语言包路径, &参数.扩展名表)?;

    // 运行服务器（阻塞直到退出）
    服务器实例.运行(输入输出线程)?;

    日志::信息!("{}", 界面消息::全局界面().取消息("lsp_log_exit"));
    成功(())
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::{查找语言包回退, 向上搜索, 解析扩展名表};

    /// 带点与不带点的扩展名统一补点
    #[测试]
    函数 扩展名补点() {
        断言相等!(解析扩展名表(".zh,.de,.ja"), 向量![".zh", ".de", ".ja"]);
        断言相等!(解析扩展名表("zh, de,ja"), 向量![".zh", ".de", ".ja"]);
    }

    /// 空列表与单个扩展名
    #[测试]
    函数 扩展名边界情形() {
        断言!(解析扩展名表("").是否为空());
        断言!(解析扩展名表("  , ").是否为空());
        断言相等!(解析扩展名表("zh"), 向量![".zh"]);
        断言相等!(解析扩展名表("zh,,de"), 向量![".zh", ".de"]);
    }

    /// 向上搜索：命中主仓库布局与平铺布局；超过五级的祖先命中不到
    #[测试]
    函数 向上搜索布局与深度上限() {
        让 临时 = 临时文件::建临时目录().解包();

        // 布局一：主仓库单副本
        让 嵌套目录 = 临时.条目路径().连接("repo-nested");
        让 语言包 = 嵌套目录.连接("crates/engine/lang-packs/zh");
        标准库::文件系统::创建所有目录(&语言包).解包();
        让 起点 = 嵌套目录.连接("target/debug/deps/bin");
        断言相等!(向上搜索(&起点, "zh").作为解引用(), 有值(语言包.转路径()));

        // 布局二：平铺语言包目录
        让 平铺目录 = 临时.条目路径().连接("repo-flat");
        让 语言包二 = 平铺目录.连接("lang-packs/ja");
        标准库::文件系统::创建所有目录(&语言包二).解包();
        让 起点二 = 平铺目录.连接("a/b/bin");
        断言相等!(
            向上搜索(&起点二, "ja").作为解引用(),
            有值(语言包二.转路径())
        );

        // 语言代码不存在 → 空值（不误中其他语言目录）
        断言!(向上搜索(&起点, "xx").是否为无());

        // 包目录在六级祖先之外：向上最多五级，找不到
        让 深层 = 临时.条目路径().连接("d/l1/l2/l3/l4/l5/l6");
        标准库::文件系统::创建所有目录(&深层).解包();
        让 语言包三 = 临时.条目路径().连接("d/lang-packs/zh");
        标准库::文件系统::创建所有目录(&语言包三).解包();
        断言!(向上搜索(&深层.连接("bin"), "zh").是否为无());
    }

    /// 默认路径已存在时直接采用，不触发任何搜索（显式指定语言包路径）
    #[测试]
    函数 默认路径存在直接采用() {
        让 临时 = 临时文件::建临时目录().解包();
        让 默认路径 = 临时.条目路径().连接("explicit/zh");
        标准库::文件系统::创建所有目录(&默认路径).解包();
        断言相等!(查找语言包回退(&默认路径, "zh"), 默认路径);
    }
}
