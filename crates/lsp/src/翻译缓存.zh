//!
//! 维护方言源码（`.zh` 等）与翻译后英文 `.rs` 代码的对应关系。
//! 每当编辑器打开或修改方言文件时，本模块将其翻译为英文，
//! 并记录行级映射信息供后续位置还原使用。

使用 标准库::集合::{哈希映射, 哈希集合};
使用 标准库::路径::{路径类型, 路径缓冲, 路径组件};
使用 标准库::同步::{原子引用计数, 读写锁, 互斥锁};
使用 标准库::同步::原子::{原子u64, 内存顺序};
使用 标准库::时间::系统时间;

使用 引擎库::映射管理器::映射管理器;
使用 引擎库::缓存::源码映射条目;
使用 引擎库::词法器;

/// 虚拟项目磁盘操作：失败必须记录日志——虚拟项目是分析与补全的基础，
/// 写失败会导致补全/诊断静默失效且无任何线索可查
函数 记录输入输出错误(上下文: &文本, 文件路径: &路径类型, 结果值: 标准库::输入输出::IO结果<()>) {
    如果让 错误(错误值) = 结果值 {
        日志::警告!("虚拟项目输入输出失败：{上下文} {}：{错误值}", 文件路径.展示());
    }
}

/// 单个文档的翻译缓存项
#[派生(调试, 克隆)]
公开 结构体 翻译条目 {
    /// 原始方言文件的统一资源标识
    公开 原始资源标识: 字符串,
    /// 原始文件的磁盘路径
    公开 原始路径: 路径缓冲,
    /// 母语源码原文
    公开 母语内容: 字符串,
    /// 翻译后的英文源码
    公开 英文内容: 字符串,
    /// 净化后的英文源码：抹除文件式模块声明（含前置属性/可见性）
    ///
    /// LSP 虚拟项目按哈希名托管文件并以路径属性聚合，用户原文的文件式
    /// 声明指向不存在的文件，会触发 cargo 检查的 E0583/E0754 误报。净化以
    /// 1:1 字符替换实现，行号/列号与英文内容严格一致（列映射继续有效）；
    /// 发送给 rust-analyzer 的内存文档使用本字段，格式化与反向转译仍用
    /// 英文内容（用户原文的模块声明行不能丢失）。
    公开 分析器内容: 字符串,
    /// 虚拟 `.rs` 文件的统一资源标识（通知 rust-analyzer 用）
    公开 虚拟资源标识: 字符串,
    /// 虚拟 `.rs` 文件的磁盘路径
    公开 虚拟路径: 路径缓冲,
    /// 英文行号 → 母语行号的映射
    公开 行映射: 向量<无符号整数>,
    /// 列偏移映射（紧凑行表，行号 → 该行的分段边界点）
    公开 列位映射: 列位映射,
    /// 代理添加的 `crate::` 前缀在英文输出中的非空白词法项序号
    ///（仅 LSP 虚拟项目跨文件引用重写产生；供反向转译精确删除，
    /// 避免误删用户显式书写的 `crate::` 前缀）
    公开 新增包前缀词汇: 哈希集合<无符号机器整数>,
    /// 文档版本
    公开 文档版本: 整数,
    /// 是否为编辑器打开的文档（假 = 同目录自动聚合的兄弟模块）
    ///
    /// 打开文档以编辑器缓冲区内容为准，代理用打开/变更通知向
    /// rust-analyzer 同步；兄弟模块以磁盘内容为准，内容刷新用
    /// 文件变更监听通知（不得对未打开的文档发变更通知）。
    公开 已打开: 布尔,
    /// 磁盘源文件的 (修改时间, 字节数)：兄弟模块增量同步的变更判定
    公开 源元数据: 选项<(系统时间, 无符号长整数)>,
    /// 本文件声明名（项 / 变量 / 结构体字段 / 库特征方法）
    ///
    /// 转译时由词法阶段顺带产出（见引擎
    /// `延迟项目转译管线`），直接挂在缓存项上：
    /// 其他文件转译前汇总项目上下文时不必再按内容哈希重算（一次全文
    /// FNV 哈希 + 可能的一趟词法转译）。
    /// `无` 表示内容已变但尚未重译（新建项、降级为兄弟模块的初值），
    /// 取用方退回内容哈希缓存补算。
    公开 已声明: 选项<原子引用计数<引擎库::别名::已声明名集合>>,
}

/// 列偏移映射的一个分段边界点
///
/// 在 [英文列, 下一段的英文列) 区间内：
///   母语列 = 英文列 - 偏移差
/// 列号按 LSP 的 UTF-16 编码单元计数（常用中文字符在基本平面内占 1 个单元，
/// 增补平面字符如表情符号占 2 个单元），每行独立从 0 开始。
#[派生(调试, 克隆, 部分相等, 全等)]
公开 结构体 列位映射点 {
    /// 该分段起始处的英文列号
    公开 英文列: 无符号整数,
    /// 该分段起始处的母语列号
    公开 母语列: 无符号整数,
    /// 累计字符偏移差（英文列 - 母语列）
    公开 偏移差: 整数,
}

/// 列偏移映射（紧凑行表）
///
/// 第 `i` 行的分段点是 `分段点集[行表[i]..行表[i + 1]]`（最后一行到最后），
/// 每行开头必是行首点（英文列/母语列/偏移差全 0）。
///
/// 早先是「每行一个向量」：360 行文本每次按键要新建 360 个小向量
///（各自一次分配），实测占列映射回放的三分之一；改成两块连续存储后
/// 整趟只剩两次分配。
#[派生(调试, 克隆, 默认, 部分相等, 全等)]
公开 结构体 列位映射 {
    /// 全部分段点（按行顺序拼接）
    分段点集: 向量<列位映射点>,
    /// 每行在分段点集中的起始下标
    行表: 向量<无符号整数>,
}

实现 列位映射 {
    /// 预留容量：`估计行数` 行数估计、`估计编辑数` 分段点估计（每处替换至多一个）
    函数 按容量创建(估计行数: 无符号机器整数, 估计编辑数: 无符号机器整数) -> 自身 {
        让 可变 映射实例 = 自身 {
            分段点集: 向量::带容量(估计行数 + 估计编辑数),
            行表: 向量::带容量(估计行数),
        };
        映射实例.新建行();
        映射实例
    }

    /// 开新行：行首点必在（列 0、偏移差 0）
    函数 新建行(&可变 自我) {
        自我.行表.推入(自我.分段点集.长度() 作为 无符号整数);
        自我.分段点集.推入(列位映射点 {
            英文列: 0,
            母语列: 0,
            偏移差: 0,
        });
    }

    /// 当前行追加一个分段点（替换点处偏移差变化时）
    函数 推入分段点(&可变 自我, 分段点: 列位映射点) {
        自我.分段点集.推入(分段点);
    }

    /// 行数
    公开 函数 行数(&自我) -> 无符号机器整数 {
        自我.行表.长度()
    }

    /// 是否没有任何行（未转译项的初值）
    公开 函数 没有行(&自我) -> 布尔 {
        自我.行表.是否为空()
    }

    /// 第 `行索引` 行的分段点；越界返回 `无`
    公开 函数 取行(&自我, 行索引: 无符号机器整数) -> 选项<&[列位映射点]> {
        让 起点值 = *自我.行表.获取(行索引)? 作为 无符号机器整数;
        让 终点值 = 自我
            .行表
            .获取(行索引 + 1)
            .映射或默认(自我.分段点集.长度(), |下一值| *下一值 作为 无符号机器整数);
        有值(&自我.分段点集[起点值..终点值])
    }

    /// 最后一行的分段点（行号越界时的回退口径）
    公开 函数 末行(&自我) -> 选项<&[列位映射点]> {
        自我.行数().检查减(1).而后映射(|行索引| 自我.取行(行索引))
    }
}

/// 翻译缓存管理器
///
/// 持有所有已打开文档的翻译结果，并提供线程安全的读写接口。
公开 结构体 转译缓存 {
    /// 统一资源标识 → 翻译项
    ///
    /// 项以原子引用计数共享：查询返回廉价引用计数克隆，避免每次按键
    /// 都全量克隆源码与列映射等大字段。
    条目表: 读写锁<哈希映射<字符串, 原子引用计数<翻译条目>>>,
    /// 虚拟资源标识 → 翻译项索引：响应映射热路径的常数时间反查。
    /// 直存原子引用计数：命中时一次锁完成查询（存原始资源标识还需二次查条目表）；
    /// 无索引时每次语义词汇/诊断/高亮/引用映射都线性扫描全表
    ///（语义词汇每个词法项查 2 次，线性放大到平方级），
    /// 项置入/替换/移除时与条目表同步维护。
    虚拟索引: 读写锁<哈希映射<字符串, 原子引用计数<翻译条目>>>,
    /// 统一映射管理器（关键字/宏/派生/模块路径/别名，与命令行管线完全同源）。
    /// 转译与列映射统一走引擎完整管线，规则唯一来源为引擎。
    映射管理器实例: 原子引用计数<映射管理器>,
    /// 虚拟文件存放的临时目录
    临时根目录: 路径缓冲,
    /// 模块集合版本号：模块集合（已打开方言文件的文件名）变化时递增。
    /// 供代理服务端判断是否需要重载虚拟项目工作区，
    /// 避免每次打开/关闭文档都触发 rust-analyzer 全量重扫。
    模块版本: 原子u64,
    /// 合并反向表（英文 → 母语）：关键字反转后合并别名反转（关键字先入为主）。
    /// 映射表构造后不可变，构造时预构建一次，
    /// 供反向转译与响应映射器共用，避免每次调用重复构建。
    反向映射: 原子引用计数<哈希映射<字符串, 字符串>>,
    /// 文档变更代号：任何文档打开/更新/关闭时递增，用于用户词汇缓存失效
    文档代号: 原子u64,
    /// 项目声明名指纹（[`引擎库::别名::项目上下文::指纹`]）：
    /// 声明集合变化（新增/删除项、结构体字段）时触发全量重写——
    /// 跨文件声明豁免会影响其他文件的虚拟内容（#8）
    项目指纹: 原子u64,
    /// 用户词汇缓存：(代号, 结果值)。原子引用计数共享避免每次补全请求克隆整个集合，
    /// 代号匹配时直接复用，避免重复词法扫描全部已打开文档
    用户词汇缓存: 互斥锁<(无符号长整数, 选项<原子引用计数<哈希集合<字符串>>>)>,
    /// 单文件声明收集结果缓存：母语内容哈希 → 声明名（项 + 字段）。
    ///
    /// [`自身::当前项目上下文`] 每次按键都要汇总全部打开文件的
    /// 声明名，而收集需先跑一遍词法转译；按内容哈希缓存后，每次按键
    /// 只有内容真正变化的文件需要重算（其余直接复用）。
    声明名缓存: 读写锁<哈希映射<无符号长整数, 原子引用计数<引擎库::别名::已声明名集合>>>,
    /// 镜像检查整文件转译缓存：(内容哈希, 语境指纹) → 转译输出。
    ///
    /// 语境指纹已含项目上下文指纹：任一文件的声明集合变化都会使全部条目失效；
    /// 否则只有内容真正变化的文件需要重译。
    镜像翻译缓存: 读写锁<
        哈希映射<(无符号长整数, 无符号长整数), 原子引用计数<引擎库::缓存::转译输出>>,
    >,
}

/// 单文件声明收集缓存的条数上限（超出时整体清空，避免长期会话无界增长）
常量 声明缓存上限: 无符号机器整数 = 512;

实现 转译缓存 {
    /// 创建新的翻译缓存
    ///
    /// - 映射管理器：统一持有关键字/宏/派生/模块路径/别名映射（与命令行管线同源）
    /// - 临时目录：虚拟 `.rs` 文件的存放位置
    ///
    /// 安全性由调用方负责：`临时目录` 必须已经过符号链接校验与创建
    ///（生产路径见服务端虚拟临时目录构造，它先校验再创建并复核）。
    /// 此处不再重复「只记日志不拒绝」的假校验——那会让调用方误以为已防护。
    公开 函数 新建(管理器: 映射管理器, 临时目录: 路径缓冲) -> 原子引用计数<自身> {
        记录输入输出错误(
            "创建临时目录",
            &临时目录,
            标准库::文件系统::创建所有目录(&临时目录),
        );
        记录输入输出错误(
            "创建源目录",
            &临时目录.连接("src"),
            标准库::文件系统::创建所有目录(临时目录.连接("src")),
        );
        // 合并反向表预构建：关键字反转优先，别名反转仅在英文键未占用时并入
        让 可变 反向映射 = 构建反向映射(&管理器.关键词表);
        对于 (英文词, 母语词) 在 构建反向映射(&管理器.标识符别名) {
            反向映射.取条目(英文词).或插入(母语词);
        }
        让 管理器 = 原子引用计数::新建(管理器);
        让 缓存实例 = 原子引用计数::新建(自身 {
            条目表: 读写锁::新建(哈希映射::新建()),
            虚拟索引: 读写锁::新建(哈希映射::新建()),
            映射管理器实例: 管理器,
            临时根目录: 临时目录,
            模块版本: 原子u64::新建(0),
            反向映射: 原子引用计数::新建(反向映射),
            文档代号: 原子u64::新建(0),
            项目指纹: 原子u64::新建(0),
            用户词汇缓存: 互斥锁::新建((0, 无)),
            声明名缓存: 读写锁::新建(哈希映射::新建()),
            镜像翻译缓存: 读写锁::新建(哈希映射::新建()),
        });
        // 初始时生成空虚拟项目，供 rust-analyzer 工作区发现
        缓存实例.刷新虚拟项目();
        缓存实例
    }

    /// 打开或更新一个文档的翻译
    ///
    /// 将母语内容翻译为英文，写入虚拟文件，并记录行映射。
    /// 返回 (当前项, 其他因模块集合变化而被重写的项)；
    /// 项以原子引用计数共享，调用方按需廉价克隆。
    ///
    /// 模块集合 = 所有已打开方言文件的文件名（不含扩展名）。
    /// 打开新文件会新增模块，使其他文件的虚拟内容可能新增
    /// `crate::` 前缀，因此需要全量重写；纯内容更新则只重写当前项。
    公开 函数 更新文档(
        &自我,
        资源标识: &文本,
        内容: &文本,
        文档版本: 整数,
    ) -> 错误处理::结果<(原子引用计数<翻译条目>, 向量<原子引用计数<翻译条目>>)> {
        让 原始路径 = 资源标识转路径(资源标识);

        // Unicode 混淆安全检查（零宽/双向/同形字符）：仅告警不阻断翻译
        对于 警告项 在 引擎库::混淆检测::检查混淆(内容) {
            日志::警告!("{}", 警告项.展示行());
        }

        // 生成虚拟文件路径（用哈希避免同名文件冲突）。
        让 虚拟路径 = 自我.取虚拟路径(&原始路径);
        让 虚拟资源标识 = 路径转统一资源标识(&虚拟路径);

        // 同步前的旧模块集合：同步后按新旧集合差异判定变化
        让 旧名集 = 自我.当前模块名集合(无);

        // 同目录兄弟模块同步（虚拟项目高保真化）：未打开的同目录方言
        // 文件也纳入虚拟项目，使跨文件引用在兄弟文件从未
        // 打开时也能解析（E0432/E0433 误报的根治手段，过滤链仅兜底）
        让 已更新兄弟 = 自我.同步兄弟模块(&原始路径);

        // 行映射不依赖模块路径重写（重写不改变行数），先按母语行数生成
        让 行映射 = 生成行映射(内容);

        // 存入缓存（英文内容与列映射由下面的重写步骤填充）
        {
            让 可变 表 = 自我
                .条目表
                .写入()
                .映射错误(|_| 错误处理::错误处理!("{}", 包::界面消息::全局界面().取消息("lsp_err_cache_lock")))?;
            让 新项 = 原子引用计数::新建(翻译条目 {
                原始资源标识: 资源标识.转字符串(),
                原始路径: 原始路径.克隆值(),
                母语内容: 内容.转字符串(),
                英文内容: 字符串::新建(),
                分析器内容: 字符串::新建(),
                虚拟资源标识: 虚拟资源标识.克隆值(),
                虚拟路径: 虚拟路径.克隆值(),
                行映射,
                列位映射: 列位映射::缺省(),
                新增包前缀词汇: 哈希集合::新建(),
                文档版本,
                已打开: 真,
                源元数据: 磁盘元数据(&原始路径),
                已声明: 无,
            });
            表.置入(资源标识.转字符串(), 原子引用计数::克隆值(&新项));
            // 同步虚拟资源标识索引（同一资源标识的虚拟资源标识恒定，置入一次即可）
            如果让 成功(可变 索引) = 自我.虚拟索引.写入() {
                索引.置入(虚拟资源标识.克隆值(), 原子引用计数::克隆值(&新项));
            }
        }

        // 内容可能变化：递增文档变更代号，使用户词汇缓存失效
        自我.文档代号
            .获取并修改(1, 内存顺序::顺序);

        // 模块集合 = 全部项（已打开文档 + 同目录兄弟模块）的词干；
        // 新增/删除必然体现为新旧集合差异（首开文件旧集合为空必然变化）
        让 新模块名集 = 自我.当前模块名集合(无);
        让 集合已变 = 新模块名集 != 旧名集;

        // 模块集合变化：全量重写 + 刷新虚拟项目，项目上下文必须先建好
        //（兄弟文件都要按同一上下文转译）。
        // 增量路径则先重译当前项——本文件声明由词法阶段顺带产出
        //（见引擎 `延迟项目转译管线`），之后据声明名
        // 指纹决定是否全量重写其余项：纯内容编辑不必先预扫本文件声明
        //（预扫内部是一整趟词法转译，与紧随其后的转译重复）。
        让 (可变 变更集, 项目上下文值, 项目指纹值) = 如果 集合已变 {
            让 _ = 自我.递增模块版本();
            让 项目上下文值 = 自我.当前项目上下文(&新模块名集);
            让 项目指纹值 = 项目上下文值.指纹();
            // 主文件/清单只依赖模块集合：纯内容编辑不触发，
            // 每次按键省去数次磁盘写与全表遍历
            自我.刷新虚拟项目();
            让 变更集 = 自我.重写全部(&新模块名集, &项目上下文值);
            (变更集, 项目上下文值, 项目指纹值)
        } 否则 {
            匹配 自我.延迟重写条目(资源标识, &新模块名集) {
                有值((变更项, 项目)) => {
                    让 项目指纹值 = 项目.指纹();
                    (变更项.转迭代().收集(), 项目, 项目指纹值)
                }
                无 => {
                    返回 错误(错误处理::错误处理!(
                        "{}",
                        包::界面消息::全局界面().取带参消息("lsp_err_entry_missing", &[资源标识])
                    ));
                }
            }
        };

        // 项目声明名（项/结构体字段）变化会改变其他文件的豁免结果，
        // 须与模块集合变化同样触发全量重写；指纹无变化（纯函数体编辑）
        // 时只重写当前项
        让 声明名已变 = 自我
            .项目指纹
            .交换(项目指纹值, 内存顺序::顺序)
            != 项目指纹值;
        如果 !集合已变 {
            如果 声明名已变 {
                // 声明名集合变化：其余项（含磁盘内容变更的兄弟）按同一上下文重译
                对于 缓存项 在 自我.重写除指定外(有值(资源标识), &新模块名集, &项目上下文值) {
                    变更集.推入(缓存项);
                }
            } 否则 {
                // 兄弟模块磁盘内容变更（集合不变时的增量路径）：逐条重译
                对于 兄弟标识 在 &已更新兄弟 {
                    如果 兄弟标识 == 资源标识 {
                        继续;
                    }
                    如果让 有值(缓存项) =
                        自我.重写条目(兄弟标识, &新模块名集, &项目上下文值)
                    {
                        变更集.推入(缓存项);
                    }
                }
            }
        }

        让 缓存项 = 自我.查询原始(资源标识).缺值转错(|| {
            错误处理::错误处理!("{}", 包::界面消息::全局界面().取带参消息("lsp_err_entry_missing", &[资源标识]))
        })?;
        让 其他变更: 向量<原子引用计数<翻译条目>> = 变更集
            .转迭代()
            .过滤(|项值| 项值.原始资源标识 != 资源标识)
            .收集();

        日志::信息!(
            "{}",
            包::界面消息::全局界面().取带参消息(
                "lsp_log_cache_updated",
                &[资源标识, &内容.逐行().计数().转字符串()]
            )
        );
        成功((缓存项, 其他变更))
    }
    /// 计算原始路径对应的虚拟文件路径（哈希后缀避免同名文件冲突）
    ///
    /// 文件名只保留合法标识符字符，防止引号等特殊字符注入生成的主文件。
    函数 取虚拟路径(&自我, 原始路径: &路径类型) -> 路径缓冲 {
        让 文件干名 = 原始路径
            .文件名干()
            .而后映射(|片段| 片段.取字符串引用())
            .解包或用("unknown");
        让 哈希码 = {
            使用 标准库::集合::哈希映射模块::默认哈希器;
            使用 标准库::哈希模块::{哈希, 哈希器};
            让 可变 哈希器实例 = 默认哈希器::新建();
            原始路径.哈希模块(&可变 哈希器实例);
            哈希器实例.完成()
        };
        自我.临时根目录
            .连接("src")
            .连接(格式化!("{}_{:x}.rs", 净化模块名(文件干名), 哈希码))
    }

    /// 同步模块目录树中的兄弟方言模块（虚拟项目高保真化，支持多层布局）
    ///
    /// 虚拟项目只聚合已打开文件时，被引用模块未打开就无法解析
    ///（E0432/E0433 误报的根源之一，过滤链只是兜底）。本方法把当前
    /// 文档所在目录的全部兄弟方言文件（同扩展名）纳入缓存与虚拟项目，
    /// 并沿 rustc 模块树规则向下递归：`<目录>/<某方言文件词干>/` 子目录
    /// 中的方言文件作为该模块的嵌套子模块同步（如 `src/领域.zh` 存在时
    /// 递归 `src/领域/工具.zh`），支撑多层跨文件引用解析。
    /// - 新文件按磁盘内容登记为模块项（已打开=假，翻译在重写步骤）；
    /// - 磁盘内容变化的项重新登记（以修改时间与大小判定增量）；
    /// - 磁盘文件已删除的项连同虚拟文件一并移除（模块集合随之
    ///   缩小，由调用方按新旧集合差异触发刷新）。
    ///
    /// 已打开文档（已打开=真）一律跳过：其内容以编辑器缓冲区为准。
    /// 返回磁盘内容发生变化、需要重新翻译的项资源标识列表。
    函数 同步兄弟模块(&自我, 当前路径: &路径类型) -> 向量<字符串> {
        让 (有值(顶层目录), 有值(扩展名)) = (当前路径.父目录(), 当前路径.取扩展名()) 否则 {
            返回 向量::新建();
        };
        让 扩展名 = 扩展名.转拥有();
        // 已递归目录（防符号链接环）与全树在盘方言文件清单
        让 可变 已访问: 哈希集合<路径缓冲> = 哈希集合::新建();
        让 可变 在盘: 哈希集合<路径缓冲> = 哈希集合::新建();
        让 可变 已更新: 向量<字符串> = 向量::新建();
        让 可变 待办: 向量<路径缓冲> = 向量![顶层目录.转路径缓冲()];
        当让 有值(目录) = 待办.弹出() {
            如果 !已访问.置入(目录.克隆值()) {
                继续;
            }
            让 成功(目录读取器) = 标准库::文件系统::读取目录(&目录) 否则 {
                继续;
            };
            // 本目录的方言文件词干：仅同名子目录才是 rustc 模块子树，
            // 测试与资源等无关目录不会被卷入
            让 可变 词干集: 哈希集合<字符串> = 哈希集合::新建();
            对于 磁盘项 在 目录读取器.展平() {
                让 路径值 = 磁盘项.条目路径();
                让 成功(文件类型值) = 磁盘项.文件类型() 否则 {
                    继续;
                };
                如果 文件类型值.是否为文件() && 路径值.取扩展名() == 有值(扩展名.作为系统串()) {
                    如果让 有值(词干) = 路径值.文件名干().而后映射(|片段| 片段.取字符串引用()) {
                        词干集.置入(词干.转字符串());
                    }
                    如果 路径值 == 当前路径 {
                        继续; // 打开文档以缓冲区为准
                    }
                    让 有值(元信息) = 磁盘元数据(&路径值) 否则 {
                        继续;
                    };
                    在盘.置入(路径值.克隆值());
                    让 资源标识 = 路径转统一资源标识(&路径值);
                    匹配 自我.查询原始(&资源标识).作为引用方法() {
                        // 已打开：缓冲区内容为准，不参与磁盘同步
                        有值(项值) 如果 项值.已打开 => 继续,
                        // 磁盘未变化：跳过重译
                        有值(项值) 如果 项值.源元数据 == 有值(元信息) => 继续,
                        _ => {}
                    }
                    让 成功(内容) = 标准库::文件系统::读取字符串(&路径值) 否则 {
                        继续;
                    };
                    让 虚拟路径 = 自我.取虚拟路径(&路径值);
                    让 虚拟资源标识 = 路径转统一资源标识(&虚拟路径);
                    让 行映射 = 生成行映射(&内容);
                    如果让 成功(可变 表) = 自我.条目表.写入() {
                        让 缓存项 = 原子引用计数::新建(翻译条目 {
                            原始资源标识: 资源标识.克隆值(),
                            原始路径: 路径值.克隆值(),
                            母语内容: 内容,
                            英文内容: 字符串::新建(),
                            分析器内容: 字符串::新建(),
                            虚拟资源标识: 虚拟资源标识.克隆值(),
                            虚拟路径,
                            行映射,
                            列位映射: 列位映射::缺省(),
                            新增包前缀词汇: 哈希集合::新建(),
                            文档版本: 0,
                            已打开: 假,
                            源元数据: 有值(元信息),
                            已声明: 无,
                        });
                        表.置入(资源标识.克隆值(), 原子引用计数::克隆值(&缓存项));
                        如果让 成功(可变 索引) = 自我.虚拟索引.写入() {
                            索引.置入(虚拟资源标识, 缓存项);
                        }
                    }
                    自我.文档代号
                        .获取并修改(1, 内存顺序::顺序);
                    已更新.推入(资源标识);
                }
            }
            // 本目录新增的词干对应的子目录可能在词干收集之后才入队：
            // 目录读取顺序不定，统一在目录扫描后补扫一次
            对于 词干 在 &词干集 {
                让 子目录 = 目录.连接(词干);
                如果 子目录.是否为目录() {
                    待办.推入(子目录);
                }
            }
        }

        // 清理：递归树内已不在磁盘的未打开模块项（文件删除/改名）
        让 过期集: 向量<字符串> = 匹配 自我.条目表.读() {
            成功(表) => 表
                .值()
                .过滤(|项值| {
                    !项值.已打开
                        && 项值.原始路径
                            .父目录()
                            .有值且(|父路径| 已访问.包含(父路径))
                        && !在盘.包含(&项值.原始路径)
                })
                .映射(|项值| 项值.原始资源标识.克隆值())
                .收集(),
            错误(_) => 向量::新建(),
        };
        对于 资源标识 在 过期集 {
            让 已移除 = 自我
                .条目表
                .写入()
                .转选项()
                .而后映射(|可变 表| 表.移除(&资源标识));
            如果让 有值(缓存项) = 已移除 {
                记录输入输出错误(
                    "删除虚拟文件",
                    &缓存项.虚拟路径,
                    标准库::文件系统::删除文件(&缓存项.虚拟路径),
                );
                如果让 成功(可变 索引) = 自我.虚拟索引.写入() {
                    索引.移除(&缓存项.虚拟资源标识);
                }
                自我.文档代号
                    .获取并修改(1, 内存顺序::顺序);
                日志::信息!(
                    "{}",
                    包::界面消息::全局界面().取带参消息("lsp_log_cache_removed", &[&资源标识])
                );
            }
        }
        已更新
    }

    /// 关闭文档：编辑器侧关闭后缓存项仍保留为磁盘模块
    ///
    /// 虚拟项目聚合的是“同目录全部方言模块”，不因编辑器关闭而移除；
    /// 磁盘文件仍存在时把缓存项降级为兄弟模块（内容以磁盘为准，虚拟文件
    /// 保留）；磁盘文件已删除时才移除缓存项与虚拟文件。
    /// 返回其他项中因模块/声明集合变化而被重写的项列表。
    公开 函数 关闭文档(&自我, 资源标识: &文本) -> 错误处理::结果<向量<原子引用计数<翻译条目>>> {
        让 已移除项 = {
            让 可变 表 = 自我
                .条目表
                .写入()
                .映射错误(|_| 错误处理::错误处理!("{}", 包::界面消息::全局界面().取消息("lsp_err_cache_lock")))?;
            匹配 表.移除(资源标识) {
                有值(缓存项) => 缓存项,
                无 => 返回 成功(向量::新建()),
            }
        };
        // 先移除虚拟资源标识索引（降级为模块时会重新置入）
        如果让 成功(可变 索引) = 自我.虚拟索引.写入() {
            索引.移除(&已移除项.虚拟资源标识);
        }
        // 内容可能变化：递增文档变更代号，使用户词汇缓存失效
        自我.文档代号
            .获取并修改(1, 内存顺序::顺序);
        日志::信息!("{}", 包::界面消息::全局界面().取带参消息("lsp_log_cache_removed", &[资源标识]));

        // 磁盘文件仍存在：降级为兄弟模块（缓冲区 → 磁盘内容），
        // 模块集合不变（名字仍在），虚拟项目无需刷新/重载
        如果让 有值(元信息) = 磁盘元数据(&已移除项.原始路径)
            && 让 成功(内容) = 标准库::文件系统::读取字符串(&已移除项.原始路径)
        {
            让 可变 降级项 = (*已移除项).克隆值();
            降级项.已打开 = 假;
            降级项.母语内容 = 内容;
            降级项.英文内容 = 字符串::新建();
            降级项.分析器内容 = 字符串::新建();
            降级项.源元数据 = 有值(元信息);
            降级项.行映射 = 生成行映射(&降级项.母语内容);
            降级项.列位映射 = 列位映射::缺省();
            降级项.新增包前缀词汇 = 哈希集合::新建();
            // 内容已换成磁盘文本：旧声明名不再对应本项内容
            降级项.已声明 = 无;
            让 降级项 = 原子引用计数::新建(降级项);
            {
                让 可变 表 = 自我.条目表.写入().映射错误(|_| {
                    错误处理::错误处理!("{}", 包::界面消息::全局界面().取消息("lsp_err_cache_lock"))
                })?;
                表.置入(资源标识.转字符串(), 原子引用计数::克隆值(&降级项));
                如果让 成功(可变 索引) = 自我.虚拟索引.写入() {
                    索引.置入(降级项.虚拟资源标识.克隆值(), 原子引用计数::克隆值(&降级项));
                }
            }
            让 模块名集 = 自我.当前模块名集合(无);
            让 项目上下文值 = 自我.当前项目上下文(&模块名集);
            让 项目指纹值 = 项目上下文值.指纹();
            让 声明名已变 = 自我
                .项目指纹
                .交换(项目指纹值, 内存顺序::顺序)
                != 项目指纹值;
            让 重写结果 = 如果 声明名已变 {
                // 声明名集合变化（缓冲区与磁盘不一致）：全量重写
                自我.重写全部(&模块名集, &项目上下文值)
            } 否则 {
                // 仅本项内容变化（缓冲区 → 磁盘）：单条重译
                让 可变 变更集 = 向量::新建();
                如果让 有值(缓存项) = 自我.重写条目(资源标识, &模块名集, &项目上下文值) {
                    变更集.推入(缓存项);
                }
                变更集
            };
            返回 成功(重写结果);
        }

        // 磁盘文件已删除：移除虚拟文件，模块集合缩小
        记录输入输出错误(
            "删除虚拟文件",
            &已移除项.虚拟路径,
            标准库::文件系统::删除文件(&已移除项.虚拟路径),
        );
        让 _ = 自我.递增模块版本();
        让 模块名集 = 自我.当前模块名集合(无);
        让 项目上下文值 = 自我.当前项目上下文(&模块名集);
        自我.项目指纹
            .存值(项目上下文值.指纹(), 内存顺序::顺序);
        让 变更集 = 自我.重写全部(&模块名集, &项目上下文值);

        // 模块集合变化：刷新虚拟项目文件（主文件聚合）
        自我.刷新虚拟项目();
        成功(变更集)
    }

    /// 根据原始资源标识查询翻译项（原子引用计数廉价克隆，不复制内容）
    公开 函数 查询原始(&自我, 资源标识: &文本) -> 选项<原子引用计数<翻译条目>> {
        让 表 = 自我.条目表.读().转选项()?;
        表.获取(资源标识).克隆副本()
    }

    /// 根据原始文件路径查询翻译项（不限打开状态；同路径多条时优先打开中）
    ///
    /// 供「从文件路径反推」的链路使用（镜像检查的源内容与诊断发布归属）：
    /// 这些链路只有磁盘路径，而缓存键是客户端统一资源标识字符串——
    /// Windows 上两者的路径表示可能不同（客户端反斜杠形式与规范化
    /// 正斜杠形式），字符串键匹配失效。本方法先精确比较路径，再按
    /// 归一化比较键兜底（盘符/目录名大小写、分隔符、逐字前缀），
    /// 同路径多条（客户端资源标识打开 + 历史兄弟登记）时优先打开中的项
    ///（其资源标识与编辑器打开的文档严格一致，诊断才能落到用户可见文档上）。
    公开 函数 按路径查询(&自我, 文件路径: &路径类型) -> 选项<原子引用计数<翻译条目>> {
        让 表 = 自我.条目表.读().转选项()?;
        让 精确命中 = 表
            .值()
            .过滤(|项值| 项值.原始路径 == 文件路径)
            .最小_by_key(|项值| !项值.已打开);
        如果让 有值(缓存项) = 精确命中 {
            返回 有值(原子引用计数::克隆值(缓存项));
        }
        让 期望键 = 路径比较键(文件路径);
        表
            .值()
            .过滤(|项值| 路径比较键(&项值.原始路径) == 期望键)
            .最小_by_key(|项值| !项值.已打开)
            .映射(原子引用计数::克隆值)
    }

    /// 返回所有已打开文档的翻译项
    ///
    /// rust-analyzer 崩溃自动重启后，代理用它重发打开通知同步全部文档。
    公开 函数 全部条目(&自我) -> 向量<原子引用计数<翻译条目>> {
        自我.条目表
            .读()
            .映射(|表| 表.值().克隆副本().收集())
            .取值或默认()
    }

    /// 收集所有已打开方言文件中出现的标识符（用户自定义名词白名单）
    ///
    /// 词法扫描原文中的全部标识符词法项（含原始标识符，
    /// 注释与字符串字面量天然被词法器排除）。供补全语言过滤区分
    /// “用户自己定义的项”与“未翻译的外部英文项”：
    /// 用户源码中出现过的名词（无论母语还是英文）都视为其可见词汇。
    ///
    /// 结果按文档变更代号缓存：文档未变化时重复补全请求直接复用，
    /// 词法扫描只在文档变更后首次调用时发生。
    公开 函数 用户定义词汇(&自我) -> 原子引用计数<哈希集合<字符串>> {
        让 代号 = 自我
            .文档代号
            .加载(内存顺序::顺序);
        如果让 成功(守卫) = 自我.用户词汇缓存.加锁()
            && 守卫.0 == 代号
            && 让 有值(集合值) = &守卫.1
        {
            返回 原子引用计数::克隆值(集合值);
        }
        让 词汇集 = 原子引用计数::新建(自我.扫描用户词汇());
        如果让 成功(可变 守卫) = 自我.用户词汇缓存.加锁() {
            *守卫 = (代号, 有值(原子引用计数::克隆值(&词汇集)));
        }
        词汇集
    }

    /// 词法扫描所有已打开文档的原文，收集标识符（无缓存）
    函数 扫描用户词汇(&自我) -> 哈希集合<字符串> {
        使用 词法解析器::{令牌种类, 切分令牌};
        让 可变 词汇集 = 哈希集合::新建();
        让 表 = 匹配 自我.条目表.读() {
            成功(表值) => 表值,
            错误(_) => 返回 词汇集,
        };
        对于 缓存项 在 表.值() {
            让 可变 偏移 = 0usize;
            对于 词法项 在 切分令牌(&缓存项.母语内容) {
                让 词法文本 = &缓存项.母语内容[偏移..偏移 + 词法项.令牌长度];
                偏移 += 词法项.令牌长度;
                如果 模式匹配!(词法项.令牌类别, 令牌种类::标识符记号 | 令牌种类::原始标识符) {
                    词汇集.置入(词法文本.去前缀("r#").解包或用(词法文本).转字符串());
                }
            }
        }
        词汇集
    }

    /// 根据虚拟资源标识反查原始项（原子引用计数廉价克隆，不复制内容）
    ///
    /// rust-analyzer 返回的资源标识可能是百分号编码形式（如中文路径），
    /// 而缓存的虚拟资源标识是未编码的原始形式，因此先精确匹配，
    /// 失败后再解码匹配。
    公开 函数 按虚拟资源标识查询(&自我, 虚拟资源标识: &文本) -> 选项<原子引用计数<翻译条目>> {
        // 索引常数时间反查：直存原子引用计数，命中时一次锁完成
        //（响应映射热路径：语义词汇每个词法项查 2 次、
        // 诊断/高亮/引用/定义每处位置查 2-5 次；无索引时
        // 这些放大到随规模乘次数的量级）
        如果让 成功(索引) = 自我.虚拟索引.读()
            && 让 有值(缓存项) = 索引.获取(虚拟资源标识)
        {
            返回 有值(原子引用计数::克隆值(缓存项));
        }
        // 兜底：索引未命中时回退线性扫描（含资源标识解码匹配）
        让 表 = 自我.条目表.读().转选项()?;
        对于 缓存项 在 表.值() {
            如果 缓存项.虚拟资源标识 == 虚拟资源标识 {
                返回 有值(原子引用计数::克隆值(缓存项));
            }
        }
        让 已解码 = 资源标识解码(虚拟资源标识);
        对于 缓存项 在 表.值() {
            如果 缓存项.虚拟资源标识 == 已解码 {
                返回 有值(原子引用计数::克隆值(缓存项));
            }
        }
        // 兜底：资源标识表示差异（Windows 盘符大小写/分隔符、逐字前缀）
        // 导致字符串永不相等时，按归一化路径比较键匹配虚拟文件路径——
        // 同一虚拟文件的任何资源标识形式都能反查命中
        让 期望键 = 路径比较键(&资源标识转路径(虚拟资源标识));
        对于 缓存项 在 表.值() {
            如果 路径比较键(&缓存项.虚拟路径) == 期望键 {
                返回 有值(原子引用计数::克隆值(缓存项));
            }
        }
        无
    }

    /// 获取关键字映射的引用
    公开 函数 关键词映射(&自我) -> &哈希映射<字符串, 字符串> {
        &自我.映射管理器实例.关键词表
    }

    /// 获取别名映射的引用（标准库/第三方库标识符，供反向转译合并使用）
    公开 函数 标识符别名映射(&自我) -> &哈希映射<字符串, 字符串> {
        &自我.映射管理器实例.标识符别名
    }

    /// 获取教学校验已知词表的引用（全部映射表键的并集，
    /// 供易混方法名提示判定；管理器内惰性缓存一次）
    公开 函数 校验词表(&自我) -> &哈希集合<字符串> {
        自我.映射管理器实例.取校验词表()
    }

    /// 教学校验的分桶索引（带精确命中表）：管理器内缓存一次，
    /// 供 LSP 诊断发布路径复用（每份文档不再重建分桶与命中表）。
    公开 函数 校验词分桶(&自我) -> &引擎库::校验::词形分桶 {
        自我.映射管理器实例.取校验分桶()
    }

    /// 映射管理器的共享句柄：跨线程路径（cargo 检查线程）持有一份，
    /// 线程内自行取词表/分桶索引，避免整张词表逐个字符串克隆。
    公开 函数 管理器共享句柄(&自我) -> 原子引用计数<映射管理器> {
        原子引用计数::克隆值(&自我.映射管理器实例)
    }

    /// 教学校验「未标注类型」歧义构造器被调名集（新建/缺省及方言词）
    ///
    /// 转发引用（管理器内缓存一次），逐文件路径不再每份源码克隆一遍。
    公开 函数 歧义构造器词(&自我) -> &哈希集合<字符串> {
        自我.映射管理器实例.取歧义构造器()
    }

    /// 英文回落校验反向索引（英文原词 → 母语词条）：管理器内惰性缓存一次
    公开 函数 英文回落映射(&自我) -> &哈希映射<字符串, 字符串> {
        自我.映射管理器实例.取英文回落()
    }

    /// 获取合并反向表的引用（英文 → 母语，关键字优先于别名）
    ///
    /// 构造时预构建，供响应映射器共用，避免重复构建。
    公开 函数 反向映射引用(&自我) -> &哈希映射<字符串, 字符串> {
        &自我.反向映射
    }

    /// 将母语（原始文件）列号转换为英文（虚拟文件）列号
    ///
    /// 由调用方先经按虚拟资源标识查询/查询原始预取项后，
    /// 调用无锁纯函数母语列转英文列（请求方向位置转换热路径）。
    /// 将英文（虚拟文件）内容反向翻译为母语内容
    ///
    /// 供代码格式化（文本编辑格式化请求）与补全/代码操作文本还原使用：
    /// 英文代码经 rustfmt 格式化后，据此还原为母语代码。
    /// 反向表为构造时预构建的合并表（关键字优先），
    /// 保证与正向翻译互逆。
    ///
    /// `资源标识` 为文档原始统一资源标识：传入时按该文档的编辑地图精确删除代理添加的
    /// `crate::` 前缀（用户手写的前缀保留）；为 `无`（补全片段等无文档
    /// 上下文场景）时不删除任何前缀，宁可保留代理前缀也不误删用户手写。
    公开 函数 反向转译(&自我, 资源标识: 选项<&文本>, 英文内容: &文本) -> 字符串 {
        // 无文档上下文或项无代理前缀时，模块名集完全不被使用
        //（词法器仅在新增包前缀词汇命中后才查模块名集合）——
        // 跳过全表扫描：补全/代码操作响应的每个片段都走这里，
        // 每次省一次随文档数增长的读锁遍历
        让 新增包前缀词汇 = 资源标识
            .而后映射(|标识值| 自我.查询原始(标识值))
            .映射(|项值| 项值.新增包前缀词汇.克隆值())
            .取值或默认();
        让 模块名集 = 如果 新增包前缀词汇.是否为空() {
            哈希集合::新建()
        } 否则 {
            自我.当前模块名集合(无)
        };
        词法器::反译(
            英文内容,
            &自我.反向映射,
            &模块名集,
            &新增包前缀词汇,
        )
    }

    /// 获取虚拟项目目录的资源标识（供工作区通知使用）
    公开 函数 虚拟项目资源标识(&自我) -> 字符串 {
        路径转统一资源标识(&自我.临时根目录)
    }

    /// 获取虚拟项目目录的文件路径（供代理自跑 cargo 检查使用）
    公开 函数 虚拟项目目录(&自我) -> 路径缓冲 {
        自我.临时根目录.克隆值()
    }

    /// 映射管理器（镜像检查用同一语言包转译，规则零重复）
    公开(包) 函数 映射管理器引用(&自我) -> &映射管理器 {
        &自我.映射管理器实例
    }

    /// 当前模块集合版本号（模块集合变化时递增）
    公开 函数 模块版本(&自我) -> 无符号长整数 {
        自我.模块版本
            .加载(内存顺序::顺序)
    }

    /// 递增模块集合版本号，返回新值
    #[必须使用]
    公开 函数 递增模块版本(&自我) -> 无符号长整数 {
        自我.模块版本
            .获取并修改(1, 内存顺序::顺序)
            + 1
    }

    /// 获取当前模块名集合（所有已打开 `.zh` 文件的文件名）
    ///
    /// `额外路径` 用于在置入缓存前把新文件的模块名一并计入。
    函数 当前模块名集合(&自我, 额外路径: 选项<&路径缓冲>) -> 哈希集合<字符串> {
        让 可变 名称集 = 哈希集合::新建();
        如果让 有值(附加路径) = 额外路径
            && 让 有值(名称值) = 附加路径.文件名干().而后映射(|片段| 片段.取字符串引用())
        {
            名称集.置入(名称值.转字符串());
        }
        如果让 成功(表) = 自我.条目表.读() {
            对于 缓存项 在 表.值() {
                如果让 有值(名称值) = 缓存项.原始路径.文件名干().而后映射(|片段| 片段.取字符串引用()) {
                    名称集.置入(名称值.转字符串());
                }
            }
        }
        名称集
    }

    /// 查询某源文件在多层模块树中的直接子模块项
    ///
    /// rustc 规则：`src/领域.rs` 的子文件位于 `src/领域/<名>.rs`，
    /// 即「与本文件同目录、以本文件词干命名的子目录」中的全部方言文件。
    /// 返回 `(子模块名（真实词干，与用户路径一致）, 子虚拟文件名)`，
    /// 按名排序保证产物确定性。
    函数 嵌套子模块声明(&自我, 原始路径: &路径类型) -> 向量<(字符串, 字符串)> {
        让 (有值(父级), 有值(词干)) = (原始路径.父目录(), 原始路径.文件名干()) 否则 {
            返回 向量::新建();
        };
        让 子目录 = 父级.连接(词干);
        让 表 = 匹配 自我.条目表.读() {
            成功(表值) => 表值,
            错误(_) => 返回 向量::新建(),
        };
        让 可变 子项集: 向量<(字符串, 字符串)> = 表
            .值()
            .过滤(|项值| 项值.原始路径.父目录() == 有值(子目录.转路径()))
            .过滤映射(|项值| {
                让 子词干 = 项值.原始路径.文件名干()?.取字符串引用()?.转字符串();
                让 子文件名 = 项值.虚拟路径.取文件名()?.取字符串引用()?.转字符串();
                有值((子词干, 子文件名))
            })
            .收集();
        子项集.排序();
        子项集.去重();
        子项集
    }

    /// 项目级声明上下文（跨文件声明豁免，#8）
    ///
    /// 模块名 = 全部已打开方言文件的词干（同 [`当前模块名集合`]）；
    /// 声明名 = 各文件母语原文的项名与结构体字段并集。声明收集在关键字
    /// 转译后的文本上进行，由引擎 [`引擎库::别名::项目上下文::从源集合`]
    /// 统一实现（与命令行同一规则来源，杜绝平行实现漂移）。
    /// 调用方在文档内容入库后调用，保证上下文包含最新内容。
    ///
    /// 性能：单文件声明名随转译结果挂在缓存项上（见
    /// [`翻译条目::已声明`]），汇总时直接复用，既不重算词法转译
    /// 也不做全文哈希；只有内容已变、尚未重译的项才退回内容哈希缓存。
    函数 当前项目上下文(
        &自我,
        模块名集: &哈希集合<字符串>,
    ) -> 引擎库::别名::项目上下文 {
        让 声明们 = 自我.条目声明汇总(无);
        引擎库::别名::项目上下文::从声明集合(
            模块名集.克隆值(),
            声明们.迭代().映射(|项值| 项值.作为引用方法()),
        )
    }

    /// 用内容哈希缓存汇总任意源文件集合的声明，构建项目上下文
    ///
    /// 镜像检查每次保存都会重扫全项目；声明收集需先跑词法转译，
    /// 复用 [`自身::缓存声明名`] 后，未改动文件不再重算。
    公开(包) 函数 从内容集构建项目上下文(
        &自我,
        模块名集: &哈希集合<字符串>,
        源内容集: &[&文本],
    ) -> 引擎库::别名::项目上下文 {
        让 声明们: 向量<原子引用计数<引擎库::别名::已声明名集合>> = 源内容集
            .迭代()
            .映射(|内容值| 自我.缓存声明名(内容值))
            .收集();
        引擎库::别名::项目上下文::从声明集合(
            模块名集.克隆值(),
            声明们.迭代().映射(|项值| 项值.作为引用方法()),
        )
    }

    /// 镜像检查用整文件转译：按 (内容哈希, 语境指纹) 复用转译输出
    ///
    /// 与 [`自身::从内容集构建项目上下文`] 配套：镜像重扫项目时，未改动文件
    /// 直接复用上一次的转译输出；项目声明集合变化时指纹变化，相关条目自动失效。
    公开(包) 函数 镜像转译(
        &自我,
        内容: &文本,
        模块名集: &哈希集合<字符串>,
        项目: &引擎库::别名::项目上下文,
    ) -> 原子引用计数<引擎库::缓存::转译输出> {
        让 哈希码 = 引擎库::缓存::转译缓存::计算内容哈希(内容);
        让 指纹 = 引擎库::缓存::转译缓存::组合指纹(
            自我.映射管理器实例.取语境指纹(),
            有值(项目.指纹()),
        );
        让 键值 = (哈希码, 指纹);
        如果让 成功(表) = 自我.镜像翻译缓存.读()
            && 让 有值(命中) = 表.获取(&键值)
        {
            返回 命中.克隆值();
        }
        让 输出值 = 原子引用计数::新建(引擎库::静默带映射与项目转译管线(
            内容,
            &自我.映射管理器实例,
            有值(模块名集),
            有值(项目),
        ));
        如果让 成功(可变 表) = 自我.镜像翻译缓存.写入() {
            如果 表.长度() >= 声明缓存上限 {
                表.清空();
            }
            表.置入(键值, 输出值.克隆值());
        }
        输出值
    }

    /// 汇总项的声明名（`跳过标识` 为需要排除的项）
    ///
    /// 锁内只做快照：自带声明的项仅取原子引用计数，未转译过的才克隆全文；
    /// 哈希与声明扫描都在锁外进行——持条目表读锁做计算会阻塞写入者。
    函数 条目声明汇总(
        &自我,
        跳过标识: 选项<&文本>,
    ) -> 向量<原子引用计数<引擎库::别名::已声明名集合>> {
        让 可变 已就绪: 向量<原子引用计数<引擎库::别名::已声明名集合>> = 向量::新建();
        让 可变 待处理: 向量<字符串> = 向量::新建();
        如果让 成功(表) = 自我.条目表.读() {
            对于 (资源标识, 缓存项) 在 表.迭代() {
                如果 跳过标识 == 有值(资源标识.作为文本切片()) {
                    继续;
                }
                匹配 &缓存项.已声明 {
                    有值(已声明值) => 已就绪.推入(原子引用计数::克隆值(已声明值)),
                    无 => 待处理.推入(缓存项.母语内容.克隆值()),
                }
            }
        }
        已就绪.扩展(待处理.迭代().映射(|内容| 自我.缓存声明名(内容)));
        已就绪
    }

    /// 取单文件声明收集结果（按内容哈希缓存）
    ///
    /// 缓存条数上限 [`声明缓存上限`]：超出时整体清空（会话内打开的文件数
    /// 远小于该值，清空代价可忽略，避免长期会话下无界增长）。
    函数 缓存声明名(&自我, 内容: &文本) -> 原子引用计数<引擎库::别名::已声明名集合> {
        让 哈希码 = 引擎库::缓存::转译缓存::计算内容哈希(内容);
        如果让 成功(表) = 自我.声明名缓存.读()
            && 让 有值(命中) = 表.获取(&哈希码)
        {
            返回 命中.克隆值();
        }
        让 结果值 = 原子引用计数::新建(引擎库::别名::收集源声明(
            内容,
            &自我.映射管理器实例,
        ));
        自我.存储声明(哈希码, 结果值.克隆值());
        结果值
    }

    /// 写入声明缓存（按内容哈希；超上限整体清空）
    函数 存储声明(&自我, 哈希码: 无符号长整数, 声明值: 原子引用计数<引擎库::别名::已声明名集合>) {
        如果让 成功(可变 表) = 自我.声明名缓存.写入() {
            如果 表.长度() >= 声明缓存上限 {
                表.清空();
            }
            表.置入(哈希码, 声明值);
        }
    }

    /// 取除 `资源标识` 外全部项的声明（项自带则直接复用）
    ///
    /// 转译链路专用：当前项每次按键内容都会变，其声明由词法阶段顺带产出
    ///（见 [`自身::延迟重写条目`]），不能从缓存里取旧内容对应的项。
    函数 其他声明项(&自我, 资源标识: &文本) -> 向量<原子引用计数<引擎库::别名::已声明名集合>> {
        自我.条目声明汇总(有值(资源标识))
    }

    /// 重写单个项的虚拟内容：翻译 + 模块路径加 `crate::` 前缀 + 重建列映射 + 写盘
    ///
    /// 内容未发生变化（模块集合/项目声明名集合未引入新豁免或前缀）时返回 `无`。
    ///
    /// 转译与列映射统一走引擎完整管线（`带映射与项目转译管线`）：
    /// 词法 → 使用路径 → `crate::` 前缀（跨文件引用）→ 别名（含项目级
    /// 声明豁免，#8），列映射基于引擎实测的流程映射回放（[`重放列位映射`]），
    /// 不复刻任何转译规则——规则唯一来源是引擎，杜绝平行实现漂移。
    函数 重写条目(
        &自我,
        资源标识: &文本,
        模块名集: &哈希集合<字符串>,
        项目上下文值: &引擎库::别名::项目上下文,
    ) -> 选项<原子引用计数<翻译条目>> {
        让 旧项 = 自我.查询原始(资源标识)?;
        让 输出值 = 引擎库::静默带映射与项目转译管线(
            &旧项.母语内容,
            &自我.映射管理器实例,
            有值(模块名集),
            有值(项目上下文值),
        );
        让 缓存声明值 = 自我.缓存声明名(&旧项.母语内容);
        让 已声明值 = 有值(缓存声明值);
        自我.完成条目(资源标识, 旧项, 输出值, 已声明值)
    }

    /// 同 [`自身::重写条目`]，但项目上下文由引擎在词法阶段后补全
    ///
    /// 当前项的内容每次都变，其声明名无法从内容哈希缓存命中；而完整上下文
    /// 又是转译的前提。此入口把词法阶段提前，本文件声明从词法产物顺带收集，
    /// 回调只合并其他项的缓存声明，省去「为取声明而多做的一整趟转译」。
    ///
    /// 返回（项内容是否变化 → 新项；所用项目上下文）。
    函数 延迟重写条目(
        &自我,
        资源标识: &文本,
        模块名集: &哈希集合<字符串>,
    ) -> 选项<(
        选项<原子引用计数<翻译条目>>,
        引擎库::别名::项目上下文,
    )> {
        让 旧项 = 自我.查询原始(资源标识)?;
        让 其他声明 = 自我.其他声明项(资源标识);
        让 (输出值, 本文件声明, 项目上下文值) =
            引擎库::静默延迟项目转译管线(
                &旧项.母语内容,
                &自我.映射管理器实例,
                有值(模块名集),
                |本文件| {
                    引擎库::别名::项目上下文::从声明集合(
                        模块名集.克隆值(),
                        其他声明
                            .迭代()
                            .映射(|项值| 项值.作为引用方法())
                            .链式(标准库::迭代::一旦(本文件)),
                    )
                },
            );
        // 本文件声明随项入库：下次编辑其他文件时取上下文直接复用，
        // 不再按内容哈希重算（一次 FNV 全文哈希）
        让 已声明值 = 有值(原子引用计数::新建(本文件声明));
        有值((自我.完成条目(资源标识, 旧项, 输出值, 已声明值), 项目上下文值))
    }

    /// 转译后的单条目收尾：净化 + 子模块声明 + 列映射 + 写盘 + 入库
    函数 完成条目(
        &自我,
        资源标识: &文本,
        旧项: 原子引用计数<翻译条目>,
        输出值: 引擎库::缓存::转译输出,
        已声明值: 选项<原子引用计数<引擎库::别名::已声明名集合>>,
    ) -> 选项<原子引用计数<翻译条目>> {
        让 英文内容 = 输出值.转译产物文本;
        // 净化：抹除文件式模块声明（含前置属性/可见性）——
        // LSP 虚拟项目按哈希名托管文件并以路径属性聚合，用户原文的
        // 文件式声明指向不存在的文件，cargo 检查与 rust-analyzer 会报
        // E0583/E0754 误报。净化以 1:1 字符替换实现，行列号与英文内容
        // 严格一致（列位映射无需调整）；发送给 rust-analyzer 的内存
        // 文档使用净化版，格式化与反向转译仍用英文内容
        //（用户原文的模块声明行不能丢失）。
        // 用户原文的文件式模块声明先 1:1 净化抹除（行列严格不变），
        // 再在**末尾**追加本文件的嵌套子模块声明（多层模块树）。
        // 子文件以平铺哈希名托管在同一源目录，路径属性相对当前虚拟文件
        // 所在目录解析，故直接指向子虚拟文件名；统一公开可见性与合成
        // 主文件的放宽可见性同理（避免 E0603 假红）。追加在末尾新增行，
        // 不影响原文任何行列映射；仅树中真实存在的子文件生成声明。
        让 可变 分析器内容 = 引擎库::模块路径::剥离文件模块声明(&英文内容);
        让 嵌套声明集 = 自我.嵌套子模块声明(&旧项.原始路径);
        如果 !嵌套声明集.是否为空() {
            如果 !分析器内容.是否为空() && !分析器内容.以结尾('\n') {
                分析器内容.推入('\n');
            }
            分析器内容.推入字符串("// i18n-virtual: nested module children\n");
            对于 (子词干, 子文件名) 在 &嵌套声明集 {
                分析器内容.推入字符串(&格式化!(
                    "#[path = \"{子文件名}\"] pub mod {子词干};\n"
                ));
            }
        }
        // 虚拟项目的包入口在聚合主文件中转发调用 `main::main()`，
        // 模块内函数默认私有会触发 cargo 检查 E0603。但发送给 rust-analyzer
        // 的内存文档必须保持无公开可见性——否则语义词汇多出公开标记、
        // 函数/主函数位置偏移，变量等颜色错乱。
        //（列位映射基于无公开可见性内容构建，与内存文档一致）
        让 是主文件 = 旧项.原始路径.文件名干().而后映射(|片段| 片段.取字符串引用()) == 有值("main");
        让 磁盘内容 = 如果 是主文件 {
            // 逐行查找函数声明（行首空白后紧跟主函数签名），
            // 避免朴素子串替换误命中注释或字符串字面量中的签名
            让 可变 结果值 = 字符串::带容量(分析器内容.长度() + 8);
            对于 行文本 在 分析器内容.逐行() {
                让 裁剪后行 = 行文本.裁剪左侧();
                让 缩进长 = 行文本.长度() - 裁剪后行.长度();
                如果 裁剪后行.以开头("fn main(") {
                    结果值.推入字符串(&行文本[..缩进长]);
                    结果值.推入字符串("pub ");
                    结果值.推入字符串(裁剪后行);
                } 否则 {
                    结果值.推入字符串(行文本);
                }
                结果值.推入('\n');
            }
            // 保留原文末尾是否有换行的精确性
            如果 !分析器内容.以结尾('\n') && 结果值.以结尾('\n') {
                结果值.弹出();
            }
            结果值
        } 否则 {
            分析器内容.克隆值()
        };
        让 列位映射值 = 重放列位映射(&旧项.母语内容, &输出值.流程映射);
        // 代理添加的 `crate::` 前缀记录（词法项序号）：反向转译时只删这些前缀
        让 新增包前缀词汇 =
            词法器::新增包前缀令牌序号(&英文内容, &输出值.流程映射);

        // 构造新版本只搬必要字段：整体克隆会把旧项的
        // 英文内容/分析器内容/列位映射也整份克隆一遍再丢弃——每次
        // 按键白拷两份全文，外加每行一次小向量分配（列映射有几百行）。
        // 英文内容/分析器内容的旧值已在上面的映射计算里读完，两份新
        // 文本按值移入新项
        让 新项 = 原子引用计数::新建(翻译条目 {
            原始资源标识: 旧项.原始资源标识.克隆值(),
            原始路径: 旧项.原始路径.克隆值(),
            母语内容: 旧项.母语内容.克隆值(),
            英文内容,
            分析器内容,
            虚拟资源标识: 旧项.虚拟资源标识.克隆值(),
            虚拟路径: 旧项.虚拟路径.克隆值(),
            行映射: 旧项.行映射.克隆值(),
            列位映射: 列位映射值,
            新增包前缀词汇,
            文档版本: 旧项.文档版本,
            已打开: 旧项.已打开,
            源元数据: 旧项.源元数据,
            已声明: 已声明值,
        });

        // 写入虚拟文件到磁盘（rust-analyzer 需要文件系统支持；主文件写公开版）
        // 先确保父目录存在（首次打开时源目录可能尚未创建，
        // 直接写会静默失败导致 cargo 检查读到不完整的虚拟项目）
        如果让 有值(父级) = 新项.虚拟路径.父目录() {
            记录输入输出错误("创建父目录", 父级, 标准库::文件系统::创建所有目录(父级));
        }
        记录输入输出错误(
            "写入虚拟文件",
            &新项.虚拟路径,
            标准库::文件系统::写入(&新项.虚拟路径, &磁盘内容),
        );

        // 包含字符串/包含字节资源复制（虚拟项目高保真化）：
        // 资源按与源文件相同的相对位置复制到虚拟项目，使 rust-analyzer
        // 与 cargo 检查在虚拟项目中也能读取包含资源（如界面资源引用），
        // 消除「无法读取」类误报的根源（过滤链仅兜底）
        如果让 (有值(原始目录), 有值(虚拟目录)) = (
            新项.原始路径.父目录(),
            新项.虚拟路径.父目录(),
        ) {
            复制包含资源(&磁盘内容, 原始目录, 虚拟目录, &自我.临时根目录);
        }

        {
            让 可变 表 = 匹配 自我.条目表.写入() {
                成功(表值) => 表值,
                错误(_) => 返回 无,
            };
            如果让 有值(缓存项) = 表.获取可变(资源标识) {
                *缓存项 = 原子引用计数::克隆值(&新项);
            }
            // 项已替换：同步索引指向最新原子引用计数（语义词汇/诊断等经索引
            // 查询若拿到旧版本，列映射与虚拟内容会错位）
            如果让 成功(可变 索引) = 自我.虚拟索引.写入() {
                索引.置入(新项.虚拟资源标识.克隆值(), 原子引用计数::克隆值(&新项));
            }
        }

        // 内容是否变化以净化版（rust-analyzer 实际感知的内容）为准：
        // 仅在模块声明区域内改动（净化后为等宽空格）不需要重新通知
        如果 新项.分析器内容 != 旧项.分析器内容 {
            有值(新项)
        } 否则 {
            无
        }
    }

    /// 用给定的模块名集合重写缓存中的所有项
    ///
    /// 返回内容实际发生变化的项列表（供调用方通知 rust-analyzer）。
    函数 重写全部(
        &自我,
        模块名集: &哈希集合<字符串>,
        项目上下文值: &引擎库::别名::项目上下文,
    ) -> 向量<原子引用计数<翻译条目>> {
        自我.重写除指定外(无, 模块名集, 项目上下文值)
    }

    /// 同 [`自身::重写全部`]，但跳过已单独重译过的项
    函数 重写除指定外(
        &自我,
        跳过标识: 选项<&文本>,
        模块名集: &哈希集合<字符串>,
        项目上下文值: &引擎库::别名::项目上下文,
    ) -> 向量<原子引用计数<翻译条目>> {
        让 资源标识集: 向量<字符串> = {
            让 表 = 匹配 自我.条目表.读() {
                成功(表值) => 表值,
                错误(_) => 返回 向量::新建(),
            };
            表
                .值()
                .过滤(|项值| 跳过标识 != 有值(项值.原始资源标识.作为文本切片()))
                .映射(|项值| 项值.原始资源标识.克隆值())
                .收集()
        };
        让 可变 变更集 = 向量::新建();
        对于 资源标识 在 资源标识集 {
            如果让 有值(缓存项) = 自我.重写条目(&资源标识, 模块名集, 项目上下文值) {
                变更集.推入(缓存项);
            }
        }
        变更集
    }

    /// 刷新虚拟项目：写入清单与聚合主文件
    ///
    /// 将当前所有虚拟翻译文件聚合为同一二进制包，
    /// 使 rust-analyzer 能够解析模块/使用声明的跨文件引用。
    /// 使用二进制段而非库段，使主函数被识别为程序入口，
    /// 避免「主函数从未使用」警告。
    函数 刷新虚拟项目(&自我) {
        // 先在锁内收集所需数据、释放读锁，再执行磁盘输入输出：
        // 持读锁期间做文件系统操作会阻塞所有写入者（重写条目等）
        让 模块表: 向量<(字符串, 路径缓冲, 路径缓冲)> = {
            让 表 = 匹配 自我.条目表.读() {
                成功(表值) => 表值,
                错误(_) => 返回,
            };
            表
                .值()
                .映射(|项值| {
                    (
                        项值.原始路径
                            .文件名干()
                            .而后映射(|片段| 片段.取字符串引用())
                            .取值或默认()
                            .转字符串(),
                        项值.虚拟路径.克隆值(),
                        项值.原始路径.克隆值(),
                    )
                })
                .收集()
        };
        // 多层模块树的托管根（通常为项目源目录；无源布局时取公共父目录）。
        // 聚合主文件只声明根下的顶层模块；嵌套模块由各父虚拟文件
        // 末尾的路径属性子声明承担（见重写条目追加块）。
        让 源根 = 推导虚拟根(
            &模块表
                .迭代()
                .映射(|(_, _, 原始路径值)| 原始路径值.克隆值())
                .收集::<向量<_>>(),
        );

        // 清单文件（包名保留英文，见项目规范）
        // 二进制段使其成为二进制包，主函数即为入口
        // 工作区空表使其脱离任何父工作区，避免被上层清单吞并
        让 清单内容 = "[package]\nname = \"i18n-virtual\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[[bin]]\npath = \"src/main.rs\"\nname = \"i18n-virtual\"\n\n[workspace]\n";
        记录输入输出错误(
            "写入清单文件",
            &自我.临时根目录.连接("Cargo.toml"),
            标准库::文件系统::写入(自我.临时根目录.连接("Cargo.toml"), 清单内容),
        );
        // 预生成锁文件：无依赖项目内容固定。缺少锁文件时 cargo
        //（rust-analyzer 的元数据查询与代理的检查）会尝试联网更新
        // 软件包索引，网络不可达时进程卡死且无诊断
        让 锁内容 = "# This file is automatically @generated by Cargo.\n# It is not intended for manual editing.\nversion = 3\n\n[[package]]\nname = \"i18n-virtual\"\nversion = \"0.1.0\"\n";
        记录输入输出错误(
            "写入锁文件",
            &自我.临时根目录.连接("Cargo.lock"),
            标准库::文件系统::写入(自我.临时根目录.连接("Cargo.lock"), 锁内容),
        );

        // 清理旧版本残留文件（避免 rust-analyzer 同时读取库文件与主文件）
        记录输入输出错误(
            "清理残留库文件",
            &自我.临时根目录.连接("src").连接("lib.rs"),
            标准库::文件系统::删除文件(自我.临时根目录.连接("src").连接("lib.rs")),
        );
        // 确保源目录存在（首次启动时可能尚未创建，写盘会静默失败）
        记录输入输出错误(
            "创建源目录",
            &自我.临时根目录.连接("src"),
            标准库::文件系统::创建所有目录(自我.临时根目录.连接("src")),
        );

        // 聚合主文件：以路径属性按模块名聚合所有虚拟文件
        // 允许未使用代码属性抑制辅助函数/类型的未使用警告
        让 可变 主文件内容 = 格式化!(
            "#![allow(dead_code)]\n{}\n",
            包::界面消息::全局界面().取消息("lsp_gen_lib_comment")
        );
        // 模块名净化为合法标识符，并在重名时追加哈希后缀。
        // 仅聚合托管根下的顶层模块；嵌套模块（源目录下的多层文件等）由
        // 父虚拟文件末尾的路径属性子声明加载，平铺在此会与父文件内的
        // 子模块树冲突且无法表达层级。
        让 可变 已用名: 哈希集合<字符串> = 哈希集合::新建();
        让 可变 有主模块 = 假;
        对于 (词干, 虚拟路径, 原始路径值) 在 &模块表 {
            如果 原始路径值.父目录() != 有值(源根.转路径()) {
                继续;
            }
            如果 词干 == "main" {
                有主模块 = 真;
            }
            让 可变 模块名 = 如果 词干.是否为空() {
                包::界面消息::全局界面().取消息("lsp_gen_module_fallback")
            } 否则 {
                净化模块名(词干)
            };
            如果 !已用名.置入(模块名.克隆值()) {
                使用 标准库::集合::哈希映射模块::默认哈希器;
                使用 标准库::哈希模块::{哈希, 哈希器};
                让 可变 哈希器实例 = 默认哈希器::新建();
                虚拟路径.转路径().哈希模块(&可变 哈希器实例);
                模块名 = 格式化!("{}_{:x}", 模块名, 哈希器实例.完成());
                已用名.置入(模块名.克隆值());
            }
            让 文件名值 = 虚拟路径
                .取文件名()
                .而后映射(|片段| 片段.取字符串引用())
                .解包或用("");
            主文件内容.推入字符串(&格式化!(
                "#[path = \"{}\"]\nmod {};\n",
                文件名值, 模块名
            ));
        }
        // 入口转发：主函数位于子模块（如主模块）时不是包入口，
        // cargo 检查会报 E0601 使保存时检查诊断整体失败（所有权可视化
        // 依赖 E0382 等 cargo 检查诊断，将全部丢失）。此处显式转发调用：
        // 模块名在类型命名空间、函数名在值命名空间，同名合法；
        // 错误仍定位在子模块文件内，行号映射零偏移。
        如果 有主模块 {
            主文件内容.推入字符串("fn main() { main::main() }\n");
        }
        记录输入输出错误(
            "写入聚合主文件",
            &自我.临时根目录.连接("src").连接("main.rs"),
            标准库::文件系统::写入(自我.临时根目录.连接("src").连接("main.rs"), 主文件内容),
        );
    }
}

/// 推导虚拟模块树的托管根
///
/// 取各方言源路径最近的名为源目录的祖先（多数票，兼容单仓多包中
/// 打开依赖目录源文件的边界情况）；不存在源层级时退化为全部
/// 父目录的公共祖先（项目根直接放方言文件的教学布局）。
函数 推导虚拟根(路径集: &[路径缓冲]) -> 路径缓冲 {
    让 可变 源票数: 哈希映射<路径缓冲, 无符号机器整数> = 哈希映射::新建();
    对于 路径值 在 路径集 {
        让 可变 当前 = 路径值.父目录();
        当让 有值(目录) = 当前 {
            如果 目录.取文件名().而后映射(|片段| 片段.取字符串引用()) == 有值("src") {
                *源票数.取条目(目录.转路径缓冲()).或用缺省() += 1;
                中断;
            }
            当前 = 目录.父目录();
        }
    }
    如果让 有值(根值) = 源票数
        .转迭代()
        .最大_by_key(|(_, 票数)| *票数)
        .映射(|(路径值, _)| 路径值)
    {
        返回 根值;
    }
    // 公共父目录兜底
    让 可变 迭代器值 = 路径集.迭代().过滤映射(|路径值| 路径值.父目录());
    让 有值(首个) = 迭代器值.下一个() 否则 {
        返回 路径缓冲::新建();
    };
    让 可变 公共: 路径缓冲 = 首个.转路径缓冲();
    对于 父目录值 在 迭代器值 {
        当 !父目录值.以开头(&公共) {
            如果 !公共.弹出() {
                返回 路径缓冲::新建();
            }
        }
    }
    公共
}

/// 将任意文件名主干净化为合法模块名
///
/// 非法字符替换为 `_`；空名回退 `m`；数字开头前补 `_`。
/// 中文等 Unicode 字母属于合法标识符字符，予以保留。
函数 净化模块名(名称: &文本) -> 字符串 {
    让 可变 输出串: 字符串 = 名称
        .逐字符()
        .映射(|字符值| {
            如果 字符值 == '_' || 字符值.是否为字母数字() {
                字符值
            } 否则 {
                '_'
            }
        })
        .收集();
    如果 输出串.是否为空() {
        输出串.推入('m');
    }
    如果 输出串.逐字符().下一个().有值且(|字符值| 字符值.是否为数字()) {
        输出串.置入(0, '_');
    }
    输出串
}

/// 读取磁盘文件的 (修改时间, 字节数)，失败返回 `无`
函数 磁盘元数据(文件路径: &路径类型) -> 选项<(系统时间, 无符号长整数)> {
    让 元信息 = 标准库::文件系统::取元数据(文件路径).转选项()?;
    有值((元信息.修改时间().转选项()?, 元信息.文件大小()))
}

/// 词法归一化路径（解析当前目录/上级目录，不访问文件系统）并判断是否位于根内
///
/// 供包含资源复制防护越界逃逸虚拟项目根（写入任意位置）。
函数 路径在根内(文件路径: &路径类型, 根路径: &路径类型) -> 布尔 {
    函数 规范化(路径值: &路径类型) -> 路径缓冲 {
        让 可变 结果路径 = 路径缓冲::新建();
        对于 组件值 在 路径值.组件() {
            匹配 组件值 {
                路径组件::上级目录组件 => {
                    结果路径.弹出();
                }
                路径组件::当前目录组件 => {}
                其他 => 结果路径.推入(其他),
            }
        }
        结果路径
    }
    规范化(文件路径).以开头(规范化(根路径))
}

/// 从（已转译的）源码中提取包含字符串/包含字节的路径字面量
///
/// 以词法扫描实现：仅识别标识符后紧跟 `!` `(` 字符串字面量 `)` 的形式，
/// 注释与字符串内的伪调用天然排除。
函数 收集包含资源路径(内容: &文本) -> 向量<字符串> {
    使用 词法解析器::{字面量种类, 令牌种类, 切分令牌};
    // 快速通道：识别包含字符串/包含字节要求词法项文本精确匹配，
    // 全文连子串都不含时直接返回空。本函数每次按键都会对整份虚拟内容调用，
    // 而带包含资源的文件是少数。
    如果 !内容.包含("include_str") && !内容.包含("include_bytes") {
        返回 向量::新建();
    }
    让 可变 跨度表: 向量<(令牌种类, 无符号机器整数, 无符号机器整数)> = 向量::新建();
    让 可变 偏移 = 0usize;
    对于 词法项 在 切分令牌(内容) {
        让 起点值 = 偏移;
        偏移 += 词法项.令牌长度;
        跨度表.推入((词法项.令牌类别, 起点值, 偏移));
    }
    让 可变 结果值 = 向量::新建();
    让 可变 下标 = 0usize;
    当 下标 < 跨度表.长度() {
        让 (种类值, 起点偏移, 终点偏移) = 跨度表[下标];
        下标 += 1;
        如果 种类值 != 令牌种类::标识符记号
            || !模式匹配!(&内容[起点偏移..终点偏移], "include_str" | "include_bytes")
        {
            继续;
        }
        // 依次找到 `!` `(` 后的字符串字面量（允许空白/注释分隔）
        让 (可变 后续下标, 可变 步骤, 可变 路径值) = (下标, 0u8, 无);
        当 后续下标 < 跨度表.长度() {
            让 (词法种类, 词法起, 词法止) = 跨度表[后续下标];
            如果 模式匹配!(
                词法种类,
                令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. }
            ) {
                后续下标 += 1;
                继续;
            }
            匹配 步骤 {
                0 如果 词法种类 == 令牌种类::非号 => 步骤 = 1,
                1 如果 词法种类 == 令牌种类::开圆括号 => 步骤 = 2,
                2 => {
                    如果 模式匹配!(
                        词法种类,
                        令牌种类::字面量记号 {
                            令牌类别: 字面量种类::文本字面量 { .. },
                            ..
                        }
                    ) {
                        让 词法文本 = &内容[词法起..词法止];
                        路径值 = 有值(
                            词法文本.去前缀('"')
                                .而后映射(|片段| 片段.去后缀('"'))
                                .解包或用(词法文本)
                                .转字符串(),
                        );
                    }
                    中断;
                }
                _ => 中断,
            }
            后续下标 += 1;
        }
        如果让 有值(路径文本) = 路径值 {
            结果值.推入(路径文本);
        }
    }
    结果值
}

/// 复制包含字符串/包含字节引用的资源到虚拟项目对应相对位置
///
/// 源文件与其虚拟文件处于相同的相对位置（都位于源目录下），以相同的
/// 相对路径拷贝即可让包含宏在虚拟项目中命中（支持上级目录引用，如
/// 配置文件引用）。目标路径词法归一化后必须仍落在
/// 虚拟项目根内（防越界逃逸）；源文件不存在时跳过，交由诊断过滤链兜底。
函数 复制包含资源(内容: &文本, 原始目录: &路径类型, 虚拟目录: &路径类型, 临时目录: &路径类型) {
    对于 相对路径 在 收集包含资源路径(内容) {
        让 相对路径 = 路径类型::新建(&相对路径);
        如果 相对路径.是否绝对() {
            继续;
        }
        让 源文件 = 原始目录.连接(相对路径);
        如果 !源文件.是否为文件() {
            继续;
        }
        让 目标文件 = 虚拟目录.连接(相对路径);
        如果 !路径在根内(&目标文件, 临时目录) {
            继续;
        }
        如果让 有值(父级) = 目标文件.父目录() {
            记录输入输出错误("创建资源目录", 父级, 标准库::文件系统::创建所有目录(父级));
        }
        记录输入输出错误(
            "复制包含资源",
            &目标文件,
            标准库::文件系统::复制文件(&源文件, &目标文件).映射(|_| ()),
        );
    }
}

/// 路径归一化比较键：容忍同一文件路径的表示差异
///
/// 资源标识解出的路径与文件系统路径可能形式不同（Windows 盘符/目录名大小写、
/// 分隔符、逐字前缀），字符串比较会失效。Windows 上统一为
/// 小写、正斜杠、无逐字前缀的形式；其他平台保持原样（路径大小写
/// 敏感，归一化反而会引入误判）。
函数 路径比较键(文件路径: &路径类型) -> 字符串 {
    让 文本串 = 文件路径.转有损字符串();
    如果 配置!(窗口) {
        让 规范化 = 文本串.替换('\\', "/");
        让 规范化 = 规范化.去前缀("//?/").解包或用(&规范化);
        规范化.转小写()
    } 否则 {
        文本串.转所有权()
    }
}

/// 将 `file://` 统一资源标识转换为文件路径
///
/// 编辑器（如 VS Code）会对非 ASCII 字符（中文文件名）做百分号编码，
/// 必须完整解码，否则文件名残留百分号转义导致模块名非法。
函数 资源标识转路径(资源标识: &文本) -> 路径缓冲 {
    如果让 有值(路径文本) = 资源标识.去前缀("file://") {
        让 已解码 = 资源标识解码(路径文本);
        // Windows 形式 `file:///C:/...`：盘符前的前导 `/` 不属于路径
        让 字节序列 = 已解码.转为字节();
        如果 字节序列.长度() >= 3 && 字节序列[0] == b'/' && 字节序列[2] == b':' {
            返回 路径缓冲::从(&已解码[1..]);
        }
        路径缓冲::从(已解码)
    } 否则 {
        路径缓冲::从(资源标识)
    }
}

/// 百分号解码统一资源标识（仅处理百分号转义形式，UTF-8 字节流）
///
/// rust-analyzer 等工具返回的资源标识会百分号编码非 ASCII 字符
///（如中文路径），需要解码后才能与缓存中的未编码资源标识比较。
函数 资源标识解码(资源标识: &文本) -> 字符串 {
    让 字节序列 = 资源标识.转为字节();
    让 可变 结果值 = 向量::带容量(字节序列.长度());
    让 可变 下标 = 0usize;
    当 下标 < 字节序列.长度() {
        如果 字节序列[下标] == b'%'
            && 下标 + 2 < 字节序列.长度()
            && 让 (有值(高位), 有值(低位)) =
                (十六进制值(字节序列[下标 + 1]), 十六进制值(字节序列[下标 + 2]))
        {
            结果值.推入(高位 * 16 + 低位);
            下标 += 3;
            继续;
        }
        结果值.推入(字节序列[下标]);
        下标 += 1;
    }
    字符串::从utf8宽松(&结果值).转字符串()
}

/// 十六进制字符转数值
函数 十六进制值(字节值: 字节) -> 选项<字节> {
    匹配 字节值 {
        b'0'..=b'9' => 有值(字节值 - b'0'),
        b'a'..=b'f' => 有值(字节值 - b'a' + 10),
        b'A'..=b'F' => 有值(字节值 - b'A' + 10),
        _ => 无,
    }
}

/// 将文件路径转换为 `file://` 统一资源标识
///
/// 对非安全字符做百分号编码（路径含空格/中文时生成合法资源标识）。
/// Windows 路径额外处理：反斜杠归一为正斜杠、盘符前补 `/`、盘符转小写，
/// 与 rust-analyzer 返回的规范形式保持一致，
/// 否则两端资源标识永不相等，查询/还原全链路失效。
公开(包) 函数 路径转统一资源标识(文件路径: &路径类型) -> 字符串 {
    让 可变 资源标识 = 字符串::从("file://");
    让 可变 文本串 = 文件路径.转有损字符串().替换('\\', "/");
    // 盘符路径（X:/...）补前导斜杠并统一小写盘符（分析器返回小写）
    让 字节序列 = 文本串.转为字节();
    如果 字节序列.长度() >= 2 && 字节序列[1] == b':' && !文本串.以开头('/') {
        文本串.置入(0, '/');
        文本串.替换范围(1..2, &文本串[1..2].转小写());
    }
    对于 &字节值 在 文本串.转为字节() {
        匹配 字节值 {
            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'.' | b'_' | b'~' | b'/' | b':' => {
                资源标识.推入(字节值 作为 字符)
            }
            _ => 资源标识.推入字符串(&格式化!("%{:02X}", 字节值)),
        }
    }
    资源标识
}

/// 根据列映射项将英文列转换为母语列（按行查询）
///
/// 公开(包)：供响应映射器的语义词汇预取项路径直接调用
///（避免每词法项重复锁与表扫描）。
公开(包) 函数 英文列转母语列(缓存项: &翻译条目, 行号: 无符号整数, 英文列: 无符号整数) -> 无符号整数 {
    让 行选项 = 缓存项
        .列位映射
        .取行(行号 作为 无符号机器整数)
        .或用否则(|| 缓存项.列位映射.末行());
    让 行段 = 匹配 行选项 {
        有值(段) 如果 !段.是否为空() => 段,
        _ => 返回 英文列,
    };
    // 顺序查找（每行分段极少，线性足够）：找到最后一个英文列 <= 目标英文列的分段
    让 可变 偏移差结果 = 行段[0].偏移差;
    对于 分段点 在 行段 {
        如果 分段点.英文列 <= 英文列 {
            偏移差结果 = 分段点.偏移差;
        } 否则 {
            中断;
        }
    }
    (英文列 作为 整数 - 偏移差结果).最大(0) 作为 无符号整数
}

/// 根据列映射项将母语列转换为英文列（按行查询）
///
/// 公开(包)：供服务端请求方向位置转换直接调用
///（调用方已持有预取的项，避免每处位置重复锁与表查询）。
公开(包) 函数 母语列转英文列(缓存项: &翻译条目, 行号: 无符号整数, 母语列: 无符号整数) -> 无符号整数 {
    让 行选项 = 缓存项
        .列位映射
        .取行(行号 作为 无符号机器整数)
        .或用否则(|| 缓存项.列位映射.末行());
    让 行段 = 匹配 行选项 {
        有值(段) 如果 !段.是否为空() => 段,
        _ => 返回 母语列,
    };
    // 顺序查找：找到最后一个母语列 <= 目标母语列的分段
    让 可变 偏移差结果 = 行段[0].偏移差;
    对于 分段点 在 行段 {
        如果 分段点.母语列 <= 母语列 {
            偏移差结果 = 分段点.偏移差;
        } 否则 {
            中断;
        }
    }
    (母语列 作为 整数 + 偏移差结果).最大(0) 作为 无符号整数
}

/// 由正向关键字映射（母语 → 英文）构建反向映射（英文 → 母语）
///
/// 按母语词排序后置入，多对一冲突时保留排序最小者，保证结果确定性。
函数 构建反向映射(正向表: &哈希映射<字符串, 字符串>) -> 哈希映射<字符串, 字符串> {
    让 可变 成对表: 向量<(&字符串, &字符串)> = 正向表.迭代().收集();
    成对表.排序();
    让 可变 反向表 = 哈希映射::带容量(正向表.长度());
    对于 (母语词, 英文词) 在 成对表 {
        反向表.取条目(英文词.克隆值()).或插入(母语词.克隆值());
    }
    反向表
}

/// 由引擎全管线编辑地图重建列偏移映射
///
/// 转译是逐词法项的原地替换、不增删换行，所以回放只需要两样东西：编辑表
/// （已按母语源偏移升序，[`引擎库::组合流程映射`] 保证）
/// 和源码文本本身。未命中编辑表的文本中英文同步等宽，唯一会打断列累加的
/// 是换行——因此按「编辑边界」把源文本切开顺序推进即可，不必为回放再分词
/// 一次（切分令牌是这条路径上最贵的一步：359 行样例上列映射约 166 微秒，
/// 其中分词占大头）。
///
/// 编辑项一律是词法项对齐的单词法项替换（词法关键字/宏/派生、使用路径段、
/// `crate::` 前缀、别名），故编辑起点就是被替换文本的起点，长度即那段
/// 区间的字节长度；替换文字的 UTF-16 宽度与真实转译输出一致（含宏自动
/// 补的 `!` 与 `crate::` 前缀）。
///
/// 不包含任何转译判定——规则的唯一来源是引擎，此处仅做纯算术回放，杜绝与
/// 引擎转译逻辑的平行实现漂移。
///
/// 与 [`重放列位映射分词版`]（分词实现，仅测试期保留为等价性基准）
/// 的唯一行为差异：跨行字面量（多行字符串/原始字符串）内的换行现在也切分
/// 新行——分词版把非空白词法项里的换行当普通字符计入列宽，其后的行会
/// 整体错位；扫描版按物理行切分，与其余行口径一致。
函数 重放列位映射(母语内容: &文本, 流程映射: &[源码映射条目]) -> 列位映射 {
    让 估计行数 = 母语内容.长度() / 24 + 2;
    让 可变 逐行列位映射 = 列位映射::按容量创建(估计行数, 流程映射.长度());
    让 可变 母语列 = 0u32;
    让 可变 英文列 = 0u32;
    让 可变 偏移差 = 0i32; // 当前行内英文列 - 母语列
    // 上一个分段点的偏移差（行首为 0）：避免每词法项回头读表尾
    让 可变 上次偏移差 = 0i32;
    让 可变 游标 = 0usize;

    对于 编辑项 在 流程映射 {
        让 起点值 = 编辑项.源偏移;
        // 防御：乱序/重叠/越界项（管线保证不会出现）宁可少一段映射也不崩溃
        如果 起点值 < 游标 || 起点值 > 母语内容.长度() {
            继续;
        }
        推进列位(
            &母语内容[游标..起点值],
            &可变 逐行列位映射,
            &可变 母语列,
            &可变 英文列,
            &可变 偏移差,
            &可变 上次偏移差,
        );
        // 被替换区间：中英长度可不同，累计偏移差变化处记录分段点
        让 母语宽度 = 十六位列宽(编辑项.原文.文本切片());
        让 英文宽度 = 十六位列宽(编辑项.替换文字.文本切片());
        母语列 += 母语宽度;
        英文列 += 英文宽度;
        偏移差 += (英文宽度 作为 整数) - (母语宽度 作为 整数);
        如果 偏移差 != 上次偏移差 {
            上次偏移差 = 偏移差;
            逐行列位映射.推入分段点(列位映射点 {
                英文列,
                母语列,
                偏移差,
            });
        }
        游标 = (起点值 + 编辑项.源码长度).最小(母语内容.长度());
    }
    推进列位(
        &母语内容[游标..],
        &可变 逐行列位映射,
        &可变 母语列,
        &可变 英文列,
        &可变 偏移差,
        &可变 上次偏移差,
    );

    逐行列位映射
}

/// 推进一段未被替换的文本：中英同步等宽，仅在换行处切分行并重置行内偏移差
函数 推进列位(
    文本串: &文本,
    逐行列位映射: &可变 列位映射,
    母语列: &可变 无符号整数,
    英文列: &可变 无符号整数,
    偏移差: &可变 整数,
    上次偏移差: &可变 整数,
) {
    如果 文本串.是否为空() {
        返回;
    }
    如果 文本串.是否为ASCII() {
        // ASCII 快路径：列宽即字节数，只需找换行
        让 可变 宽度 = 0u32;
        对于 字节值 在 文本串.转为字节() {
            如果 *字节值 == b'\n' {
                *母语列 += 宽度;
                *英文列 += 宽度;
                *母语列 = 0;
                *英文列 = 0;
                *偏移差 = 0;
                *上次偏移差 = 0;
                逐行列位映射.新建行();
                宽度 = 0;
            } 否则 {
                宽度 += 1;
            }
        }
        *母语列 += 宽度;
        *英文列 += 宽度;
        返回;
    }
    // 非 ASCII（中文标识符/注释/字面量）：逐字符取 UTF-16 列宽
    对于 字符值 在 文本串.逐字符() {
        如果 字符值 == '\n' {
            *母语列 = 0;
            *英文列 = 0;
            *偏移差 = 0;
            *上次偏移差 = 0;
            逐行列位映射.新建行();
        } 否则 {
            让 宽度 = 字符值.长度UTF16() 作为 无符号整数;
            *母语列 += 宽度;
            *英文列 += 宽度;
        }
    }
}

/// 文本的 UTF-16 列宽（LSP 协议口径：增补平面字符占 2 个单元）
函数 十六位列宽(文本串: &文本) -> 无符号整数 {
    如果 文本串.是否为ASCII() {
        文本串.长度() 作为 无符号整数
    } 否则 {
        文本串.逐字符().映射(|字符值| 字符值.长度UTF16() 作为 无符号整数).求和()
    }
}

/// 分词回放（仅测试期保留：[`重放列位映射`] 的等价性基准，勿在生产路径使用）
///
/// 对母语源逐词法项推进：命中地图项的词法项输出长度取替换文字的
/// UTF-16 长度（与真实转译输出一致，含宏自动补的 `!` 与 `crate::` 前缀），
/// 未命中的词法项原样长度；累计偏移差变化处记录分段点。
///
/// 不包含任何转译判定——规则的唯一来源是引擎（`带映射转译管线`），
/// 此处仅做纯算术回放，杜绝与引擎转译逻辑的平行实现漂移。
///
/// 编辑表按源偏移升序（[`引擎库::组合流程映射`] 保证），
/// 因此用游标顺序推进即可定位「当前词法项是否被替换」，不必建偏移哈希表；
/// 空白/注释按字节扫（只需识别换行与列宽），ASCII 词法项长度即 UTF-16 长度。
#[配置(测试)]
函数 重放列位映射分词版(母语内容: &文本, 流程映射: &[源码映射条目]) -> 列位映射 {
    使用 词法解析器::{令牌种类, 切分令牌};

    让 可变 逐行列位映射 = 列位映射::按容量创建(母语内容.长度() / 24 + 2, 流程映射.长度());
    让 可变 母语列 = 0u32;
    让 可变 英文列 = 0u32;
    让 可变 累计偏移差 = 0i32; // 当前行内英文列 - 母语列
    // 上一个分段点的偏移差（行首为 0）：避免每词法项回头读表尾
    让 可变 上次偏移差 = 0i32;
    让 可变 当前偏移 = 0usize;
    让 可变 编辑下标 = 0usize;
    让 是空白 = |种类值: 令牌种类| {
        模式匹配!(
            种类值,
            令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. }
        )
    };

    对于 词法项 在 切分令牌(母语内容) {
        让 词法起点值 = 当前偏移;
        让 词法文本 = &母语内容[当前偏移..][..词法项.令牌长度];
        当前偏移 += 词法项.令牌长度;

        // 空白词法项：两列同步前进（逐字节处理，只需识别换行）
        如果 是空白(词法项.令牌类别) {
            如果 词法文本.是否为ASCII() {
                对于 字节值 在 词法文本.转为字节() {
                    如果 *字节值 == b'\n' {
                        // 新行：行内列与偏移差重置，并记录新行起点
                        母语列 = 0;
                        英文列 = 0;
                        累计偏移差 = 0;
                        上次偏移差 = 0;
                        逐行列位映射.新建行();
                    } 否则 {
                        母语列 += 1;
                        英文列 += 1;
                    }
                }
            } 否则 {
                对于 字符值 在 词法文本.逐字符() {
                    如果 字符值 == '\n' {
                        母语列 = 0;
                        英文列 = 0;
                        累计偏移差 = 0;
                        上次偏移差 = 0;
                        逐行列位映射.新建行();
                    } 否则 {
                        母语列 += 字符值.长度UTF16() 作为 无符号整数;
                        英文列 += 字符值.长度UTF16() 作为 无符号整数;
                    }
                }
            }
            继续;
        }

        // 游标推进到当前词法项（编辑表升序、每条对应一个被替换词法项的起点）
        当 编辑下标 < 流程映射.长度() && 流程映射[编辑下标].源偏移 < 词法起点值 {
            编辑下标 += 1;
        }

        // 输出长度：命中地图项取替换文字的 UTF-16 长度，否则原样
        让 母语宽度: 无符号整数 = 如果 词法文本.是否为ASCII() {
            词法文本.长度() 作为 无符号整数
        } 否则 {
            词法文本.逐字符().映射(|字符值| 字符值.长度UTF16() 作为 无符号整数).求和()
        };
        让 英文宽度: 无符号整数 = 匹配 流程映射.获取(编辑下标) {
            有值(编辑项) 如果 编辑项.源偏移 == 词法起点值 => {
                编辑项.替换文字.逐字符().映射(|字符值| 字符值.长度UTF16() 作为 无符号整数).求和()
            }
            _ => 母语宽度,
        };

        累计偏移差 += (英文宽度 作为 整数) - (母语宽度 作为 整数);
        母语列 += 母语宽度;
        英文列 += 英文宽度;

        // 如果偏移差变化了，记录新的分段边界（当前行内）
        如果 累计偏移差 != 上次偏移差 {
            上次偏移差 = 累计偏移差;
            逐行列位映射.推入分段点(列位映射点 {
                英文列,
                母语列,
                偏移差: 累计偏移差,
            });
        }
    }

    逐行列位映射
}

/// 生成英文行号到母语行号的映射
///
/// 由于当前翻译是逐行替换关键字，行数保持一致，
/// 因此映射为 0→0, 1→1, 2→2, ...
///
/// 行数按字节统计换行：逐行迭代需逐字符解码，9.6 千字节源码上两次计数
/// 就是 20 微秒量级，而这里只要行数。
/// 未来若支持多行展开/折叠，此处需要更复杂的算法。
函数 生成行映射(内容: &文本) -> 向量<无符号整数> {
    (0..行数(内容)).收集()
}

/// 行数，口径与逐行计数一致（末尾换行不产生额外空行）
函数 行数(内容: &文本) -> 无符号整数 {
    如果 内容.是否为空() {
        返回 0;
    }
    让 换行数 = 内容
        .转为字节()
        .迭代()
        .过滤(|字节值| **字节值 == b'\n')
        .计数() 作为 无符号整数;
    如果 内容.以结尾('\n') {
        换行数
    } 否则 {
        换行数 + 1
    }
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    /// 统一资源标识双向转换：Unix 路径、空格/中文编码、Windows 盘符形式
    #[测试]
    函数 路径资源标识往返() {
        // Unix：根路径保留，空格百分号编码
        断言相等!(
            路径转统一资源标识(路径类型::新建("/tmp/a b/main.rs")),
            "file:///tmp/a%20b/main.rs"
        );
        断言相等!(
            资源标识转路径("file:///tmp/a%20b/main.rs"),
            路径缓冲::从("/tmp/a b/main.rs")
        );

        // Windows：反斜杠归一、盘符前补斜杠、盘符转小写（与分析器一致）
        断言相等!(
            路径转统一资源标识(路径类型::新建("C:\\Users\\x\\main.rs")),
            "file:///c:/Users/x/main.rs"
        );
        // 反向：盘符前导斜杠被剥离
        让 返回路径 = 资源标识转路径("file:///c:/Users/x/main.rs");
        断言相等!(
            返回路径.转有损字符串().替换('\\', "/"),
            "c:/Users/x/main.rs"
        );
    }

    函数 测试映射() -> 哈希映射<字符串, 字符串> {
        哈希映射::从([
            ("函数".转为(), "fn".转为()),
            ("让".转为(), "let".转为()),
            ("可变".转为(), "mut".转为()),
            ("如果".转为(), "if".转为()),
            ("否则".转为(), "else".转为()),
        ])
    }

    /// 构造测试用映射管理器（关键字表 + 可选别名表，模块路径/宏/派生表为空）
    函数 测试管理器(别名表: 哈希映射<字符串, 字符串>) -> 映射管理器 {
        映射管理器::从扁表构造(测试映射(), 哈希映射::新建(), 别名表)
    }

    /// 列映射扫描回放与分词回放差分：多种源码形态 + 真实管线编辑表必须逐行逐段一致
    ///
    /// 扫描版是生产实现（省去每按键一次全文分词）；分词版仅在此充当等价性基准。
    /// 语料覆盖：单行/多行、制表符缩进、回车换行、块注释跨行、中文/表情符号字面量、
    /// 使用路径段、`crate::` 前缀、别名替换、空文件。
    #[测试]
    函数 列位映射回放与分词回放一致() {
        让 管理器 = 测试管理器(哈希映射::从([
            ("字符串".转为(), "String".转为()),
            ("新建".转为(), "new".转为()),
        ]));
        让 模块名集: 哈希集合<字符串> = ["工具".转字符串(), "辅助".转字符串()]
            .转迭代()
            .收集();
        让 源集 = [
            "让 可变 x = 5;",
            "函数 主函数() {\n    让 结果 = 计算(2);\n    // 注释：中文\n    返回 结果;\n}\n",
            "函数 f(名称: 字符串) -> 字符串 {\n\t让 s = 名称.新建();\n\ts\n}\n",
            "使用 工具::辅助;\n\n函数 主函数() {\n    工具::辅助::执行(1);\n}\n",
            "/* 块注释\n   跨行 */\n让 a = 1;\n\n\n让 b = 2;\n",
            "让 s = \"中文 字面量 😀\";\r\n让 t = 1;\r\n",
            "让 r = r#\"原样 字符串\"#;\n让 x = 1;",
            "",
            "// 只有注释\n",
        ];
        对于 源码文本 在 源集 {
            让 输出值 = 引擎库::静默带映射与项目转译管线(
                源码文本,
                &管理器,
                有值(&模块名集),
                无,
            );
            断言相等!(
                重放列位映射(源码文本, &输出值.流程映射),
                重放列位映射分词版(源码文本, &输出值.流程映射),
                "扫描回放与分词回放不一致：{源码文本:?}"
            );
        }
    }

    /// 跨行原始字符串：换行也切分新行
    ///
    /// 分词回放把非空白词法项里的换行当普通字符计入列宽，多行字面量之后的
    /// 行会整体错位；扫描回放按物理行切分，行数与逐行迭代对齐。
    #[测试]
    函数 列位映射多行字面量切分行() {
        让 源码文本 = "让 s = r#\"第一行\n第二行\"#;\n让 t = 1;";
        让 映射 = 重放列位映射(源码文本, &[]);
        断言相等!(映射.行数(), 3, "三行源码应有三行映射");
        // 未被替换的第三行：行内偏移差为 0（分词版会把前两行宽度累加进第三行）
        让 行段 = 映射.取行(2).期望("第三行应有分段表");
        断言相等!(行段.长度(), 1);
        断言相等!(行段[0].偏移差, 0);
    }

    #[测试]
    函数 更新文档() {
        让 临时目录 = 临时文件::建临时目录().解包();
        让 缓存实例 = 转译缓存::新建(测试管理器(哈希映射::新建()), 临时目录.条目路径().转路径缓冲());

        让 (缓存项, 其他变更) = 缓存实例
            .更新文档("file:///test/main.zh", "让 可变 x = 5;", 1)
            .解包();
        断言相等!(缓存项.英文内容, "let mut x = 5;");
        断言!(缓存项.虚拟路径.存在());
        断言!(其他变更.是否为空());
    }

    /// 路径级反查（按路径查询）：资源标识与路径的表示差异（Windows 盘符
    /// 大小写/分隔符）在 Windows 上归一命中，其他平台保持精确匹配语义
    ///（大小写敏感，归一化会引入误判）
    #[测试]
    函数 按路径查询容忍窗口形式() {
        让 临时目录 = 临时文件::建临时目录().解包();
        让 缓存实例 = 转译缓存::新建(测试管理器(哈希映射::新建()), 临时目录.条目路径().转路径缓冲());

        // 客户端资源标识为反斜杠/盘符形式：解出 C:/x/main.zh
        让 (缓存项, _) = 缓存实例
            .更新文档("file://C:/x/main.zh", "让 x = 1;", 1)
            .解包();
        // 精准路径命中（不限平台）
        断言!(缓存实例.按路径查询(&缓存项.原始路径).是否为有值());
        // 表示变体：Windows 归一命中；其他平台视为不同路径
        断言相等!(
            缓存实例.按路径查询(路径类型::新建(r"c:\x\main.zh")).是否为有值(),
            配置!(窗口),
            "大小写/分隔符归一应仅 Windows 生效"
        );
        断言!(缓存实例.按路径查询(路径类型::新建("/no/such/file.zh")).是否为无());
    }

    /// 别名替换接通：库标识符转英文，声明位同名用户定义受保护（与命令行一致）
    #[测试]
    函数 别名替换与声明保护() {
        让 临时目录 = 临时文件::建临时目录().解包();
        让 别名表 = 哈希映射::从([
            ("字符串".转为(), "String".转为()),
            ("新建".转为(), "new".转为()),
        ]);
        让 缓存实例 = 转译缓存::新建(测试管理器(别名表), 临时目录.条目路径().转路径缓冲());

        让 (缓存项, _) = 缓存实例
            .更新文档(
                "file:///test/main.zh",
                "让 新建 = 1;\n让 y = 新建;\n让 t = 字符串::新建();",
                1,
            )
            .解包();
        // 声明位 新建 保留；用户声明名的裸使用处（y = 新建）豁免；
        // 但 `::` 限定后的路径段是库接口访问，照常替换（字符串::新建 → 英文类型构造）
        断言相等!(
            缓存项.英文内容,
            "let 新建 = 1;\nlet y = 新建;\nlet t = String::new();"
        );
    }

    /// 无用户声明撞名时，别名在使用处照常替换
    #[测试]
    函数 别名未声明时照常替换() {
        让 临时目录 = 临时文件::建临时目录().解包();
        让 别名表 = 哈希映射::从([("字符串".转为(), "String".转为())]);
        让 缓存实例 = 转译缓存::新建(测试管理器(别名表), 临时目录.条目路径().转路径缓冲());

        让 (缓存项, _) = 缓存实例
            .更新文档("file:///test/main.zh", "让 s: 字符串 = x;", 1)
            .解包();
        断言相等!(缓存项.英文内容, "let s: String = x;");
    }

    /// 别名替换后的列映射对齐：中英文列号双向转换在替换点精确
    #[测试]
    函数 别名列位映射对齐() {
        让 临时目录 = 临时文件::建临时目录().解包();
        让 别名表 = 哈希映射::从([("字符串".转为(), "String".转为())]);
        让 缓存实例 = 转译缓存::新建(测试管理器(别名表), 临时目录.条目路径().转路径缓冲());
        让 标识 = "file:///test/main.zh";
        让 (缓存项, _) = 缓存实例.更新文档(标识, "让 s: 字符串 = x;", 1).解包();

        // 母语列 5（字符串 起点）→ 英文列 7（英文类型名起点），反向亦然
        断言相等!(母语列转英文列(&缓存项, 0, 5), 7);
        断言相等!(英文列转母语列(&缓存项, 0, 7), 5);
        // 替换点之后的列（等号：母语列 9 / 英文列 14）仍精确
        断言相等!(母语列转英文列(&缓存项, 0, 9), 14);
        断言相等!(英文列转母语列(&缓存项, 0, 14), 9);
    }

    #[测试]
    函数 关闭文档() {
        让 临时目录 = 临时文件::建临时目录().解包();
        让 缓存实例 = 转译缓存::新建(测试管理器(哈希映射::新建()), 临时目录.条目路径().转路径缓冲());

        让 (缓存项, _) = 缓存实例
            .更新文档("file:///test/main.zh", "让 x = 1;", 1)
            .解包();
        断言!(缓存项.虚拟路径.存在());

        缓存实例.关闭文档("file:///test/main.zh").解包();
        断言!(!缓存项.虚拟路径.存在());
        断言!(缓存实例.查询原始("file:///test/main.zh").是否为无());
    }

    /// 关闭不在缓存中的文档：幂等早返回，不触发重写
    #[测试]
    函数 关闭不存在文档为空操作() {
        让 临时目录 = 临时文件::建临时目录().解包();
        让 缓存实例 = 转译缓存::新建(测试管理器(哈希映射::新建()), 临时目录.条目路径().转路径缓冲());
        缓存实例
            .更新文档("file:///test/main.zh", "让 x = 1;", 1)
            .解包();
        让 先前版本 = 缓存实例.模块版本();
        让 变更集 = 缓存实例.关闭文档("file:///test/不存在.zh").解包();
        断言!(变更集.是否为空());
        // 模块集合未变：版本号不递增
        断言相等!(缓存实例.模块版本(), 先前版本);
    }

    /// 用户词汇缓存：文档未变时命中，变更后失效重建
    #[测试]
    函数 用户词汇缓存失效() {
        让 临时目录 = 临时文件::建临时目录().解包();
        让 缓存实例 = 转译缓存::新建(测试管理器(哈希映射::新建()), 临时目录.条目路径().转路径缓冲());
        缓存实例
            .更新文档("file:///test/main.zh", "函数 自定义甲() {}", 1)
            .解包();
        让 首个 = 缓存实例.用户定义词汇();
        断言!(首个.包含("自定义甲"));
        // 命中路径：结果一致
        断言相等!(首个, 缓存实例.用户定义词汇());
        // 文档变更后缓存失效，新名词可见
        缓存实例
            .更新文档("file:///test/main.zh", "函数 自定义乙() {}", 2)
            .解包();
        让 第二个 = 缓存实例.用户定义词汇();
        断言!(第二个.包含("自定义乙"));
        断言!(!第二个.包含("自定义甲"));
    }

    #[测试]
    函数 按虚拟资源标识查询() {
        让 临时目录 = 临时文件::建临时目录().解包();
        让 缓存实例 = 转译缓存::新建(测试管理器(哈希映射::新建()), 临时目录.条目路径().转路径缓冲());

        让 (缓存项, _) = 缓存实例
            .更新文档("file:///test/main.zh", "让 x = 1;", 1)
            .解包();
        让 找到项 = 缓存实例.按虚拟资源标识查询(&缓存项.虚拟资源标识).解包();
        断言相等!(找到项.原始资源标识, "file:///test/main.zh");
        // 解码形式（索引未命中时回退线性扫描）仍可查到
        让 已解码 = 资源标识解码(&缓存项.虚拟资源标识);
        让 找到项 = 缓存实例.按虚拟资源标识查询(&已解码).解包();
        断言相等!(找到项.原始资源标识, "file:///test/main.zh");
        // 中文文件名：编码资源标识经索引命中
        让 (中文项, _) = 缓存实例
            .更新文档("file:///test/%E6%B5%8B%E8%AF%95.zh", "让 x = 1;", 1)
            .解包();
        断言!(
            缓存实例.按虚拟资源标识查询(&中文项.虚拟资源标识).是否为有值(),
            "编码资源标识应经索引命中"
        );
        // 内容更新（重写条目替换项）后，索引应指向最新版本
        让 (第二版项, _) = 缓存实例
            .更新文档("file:///test/main.zh", "让 x = 2;", 2)
            .解包();
        让 找到项 = 缓存实例.按虚拟资源标识查询(&第二版项.虚拟资源标识).解包();
        断言相等!(找到项.英文内容, "let x = 2;");
        // 关闭文档后索引同步清理，查询不再命中
        缓存实例.关闭文档("file:///test/main.zh").解包();
        断言!(缓存实例.按虚拟资源标识查询(&缓存项.虚拟资源标识).是否为无());
    }

    #[测试]
    函数 模块路径列位映射() {
        // 包前缀重写逻辑已迁入引擎（模块路径::带映射限定模块路径，
        // 其行为测试在引擎侧）；此处验证列映射与虚拟内容经由完整管线正确对齐
        让 管理器 = 映射管理器::从扁表构造(
            哈希映射::从([
                ("函数".转为(), "fn".转为()),
                ("让".转为(), "let".转为()),
                ("公开".转为(), "pub".转为()),
            ]),
            哈希映射::新建(),
            哈希映射::新建(),
        );
        让 临时目录 = 临时文件::建临时目录().解包();
        让 缓存实例 = 转译缓存::新建(管理器, 临时目录.条目路径().转路径缓冲());

        // 先打开 辅助.zh，使模块集合包含 辅助
        让 (辅助项, _) = 缓存实例
            .更新文档(
                "file:///test/辅助.zh",
                "公开 函数 辅助函数() {\n    让 x = 1;\n}",
                1,
            )
            .解包();
        断言相等!(
            辅助项.英文内容,
            "pub fn 辅助函数() {\n    let x = 1;\n}"
        );

        // 主.zh 引用 辅助 模块：母语列 8（辅助函数起点）应映射到英文列 15
        //（`辅助::` 被重写为 `crate::辅助::`，多出 7 个 UTF-16 单元）
        让 (缓存项, 其他变更) = 缓存实例
            .更新文档(
                "file:///test/主.zh",
                "函数 主函数() {\n    辅助::辅助函数();\n}",
                1,
            )
            .解包();
        断言相等!(
            缓存项.英文内容,
            "fn 主函数() {\n    crate::辅助::辅助函数();\n}"
        );

        // 母语列 8 → 英文列 15
        断言相等!(母语列转英文列(&缓存项, 1, 8), 15);
        // 英文列 15 → 母语列 8
        断言相等!(英文列转母语列(&缓存项, 1, 15), 8);
        // 英文列 19（辅助函数末尾）→ 母语列 12
        断言相等!(英文列转母语列(&缓存项, 1, 19), 12);
        // 辅助.zh 未引用任何模块，内容不变，不进入变更列表
        断言!(其他变更.是否为空());
    }

    /// 使用语句路径段中文化（LSP 此前缺失的环节，现经引擎完整管线修复）
    #[测试]
    函数 使用语句模块路径转译() {
        让 管理器 = 映射管理器::从内置载入(
            r#"
["声明"]
"函数" = "fn"
"让" = "let"
"使用" = "use"
"#,
            r#"
["模块路径"]
"标准集合" = "std::collections"
"#,
            r#"
["标识符"]
"哈希映射" = "HashMap"
"#,
            &[],
        )
        .期望("管理器创建失败");
        让 临时目录 = 临时文件::建临时目录().解包();
        让 缓存实例 = 转译缓存::新建(管理器, 临时目录.条目路径().转路径缓冲());
        让 (缓存项, _) = 缓存实例
            .更新文档("file:///test/main.zh", "使用 标准集合::哈希映射;", 1)
            .解包();
        断言相等!(缓存项.英文内容, "use std::collections::HashMap;");
        // 列映射与虚拟内容对齐：行首位置恒等
        断言相等!(母语列转英文列(&缓存项, 0, 0), 0);
        断言相等!(英文列转母语列(&缓存项, 0, 0), 0);
    }

    /// #3 症状一回归：包名连字符在 LSP 转译路径上规范化为下划线
    ///
    /// weix-1 实测：`使用 日志订阅 as 日志框架;` 曾转译为
    /// `use tracing-subscriber as 日志框架;`（含连字符，非法路径），
    /// rust-analyzer 报「期望 `::`、`;` 或别名关键字，却见到 `-`」。
    /// 包段规范化后虚拟文件语法合法，误报消失（命令行走同一引擎管线）。
    #[测试]
    函数 使用语句连字符包名规范化() {
        让 管理器 = 映射管理器::从内置载入(
            r#"
["声明"]
"使用" = "use"
"#,
            r#"
["模块路径"]
"日志订阅" = "tracing-subscriber"
"#,
            "",
            &[],
        )
        .期望("管理器创建失败");
        让 临时目录 = 临时文件::建临时目录().解包();
        让 缓存实例 = 转译缓存::新建(管理器, 临时目录.条目路径().转路径缓冲());
        让 (缓存项, _) = 缓存实例
            .更新文档("file:///test/日志设置.zh", "使用 日志订阅 as 日志框架;", 1)
            .解包();
        断言相等!(缓存项.英文内容, "use tracing_subscriber as 日志框架;");
    }

    /// 跨文件声明豁免（#8）：其他文件声明的成员名在调用侧同样豁免
    ///
    /// weix-1 场景：甲文件声明 `函数 新建()`（撞 `新建` 映射），
    /// 乙文件跨文件调用 `平台Linux::新建()`——模块路径链（`crate::` 前缀
    /// 由虚拟项目重写补全）内成员与声明侧一致；库接口路径（盒子::新建）
    /// 照常替换。
    #[测试]
    函数 跨文件声明上下文() {
        让 临时目录 = 临时文件::建临时目录().解包();
        让 别名表 =
            哈希映射::从([("新建".转为(), "new".转为()), ("盒子".转为(), "Box".转为())]);
        让 缓存实例 = 转译缓存::新建(测试管理器(别名表.克隆值()), 临时目录.条目路径().转路径缓冲());

        // 甲文件：声明 `新建`（同名用户函数）
        让 (_, _) = 缓存实例
            .更新文档("file:///test/平台Linux.zh", "函数 新建() {}", 1)
            .解包();
        // 乙文件：跨文件调用甲的成员 + 库接口调用
        让 (缓存项, _) = 缓存实例
            .更新文档(
                "file:///test/平台接口.zh",
                "让 e = 平台Linux::新建();\n让 b = 盒子::新建();",
                1,
            )
            .解包();
        断言!(
            缓存项.英文内容.包含("crate::平台Linux::新建()"),
            "跨文件调用位应与声明侧一致：{}",
            缓存项.英文内容
        );
        断言!(
            缓存项.英文内容.包含("Box::new()"),
            "库接口路径段照常替换：{}",
            缓存项.英文内容
        );

        // 对照：无甲声明（单独打开乙）时保持旧行为——`新建` 被替换为英文构造名
        让 另一个临时目录 = 临时文件::建临时目录().解包();
        让 另一个缓存 = 转译缓存::新建(测试管理器(别名表), 另一个临时目录.条目路径().转路径缓冲());
        让 (另一个项, _) = 另一个缓存
            .更新文档(
                "file:///test/平台接口.zh",
                "让 e = 平台Linux::新建();\n让 b = 盒子::新建();",
                1,
            )
            .解包();
        断言!(
            另一个项.英文内容.包含("平台Linux::new()"),
            "无跨文件声明时保持旧行为：{}",
            另一个项.英文内容
        );
    }

    /// 增量编辑（集合不变）走延迟上下文单趟路径：
    /// 声明名变化 → 其余项按新上下文重译；纯函数体编辑 → 不触发全量重译
    #[测试]
    函数 增量编辑声明变化重写其余() {
        让 临时目录 = 临时文件::建临时目录().解包();
        让 别名表 = 哈希映射::从([("新建".转为(), "new".转为())]);
        让 缓存实例 = 转译缓存::新建(测试管理器(别名表), 临时目录.条目路径().转路径缓冲());

        // 两个文件都不含 `新建` 声明：调用位照常替换（此时集合变化 → 全量路径）
        缓存实例
            .更新文档("file:///test/甲.zh", "函数 甲函数() {}", 1)
            .解包();
        让 (乙项, _) = 缓存实例
            .更新文档(
                "file:///test/乙.zh",
                "函数 乙函数() { 让 值 = 甲::新建(); }",
                1,
            )
            .解包();
        断言!(
            乙项.英文内容.包含("甲::new()"),
            "无声明时应替换：{}",
            乙项.英文内容
        );

        // 编辑甲：新增 `新建` 声明（集合不变 → 增量路径；声明名变化 → 其余项重译）
        让 (_, 其他变更) = 缓存实例
            .更新文档("file:///test/甲.zh", "函数 新建() {}\n函数 甲函数() {}", 2)
            .解包();
        断言!(!其他变更.是否为空(), "声明名变化应触发其余项重译");
        让 乙项 = 缓存实例.查询原始("file:///test/乙.zh").期望("乙项");
        断言!(
            乙项.英文内容.包含("甲::新建()"),
            "跨文件声明应豁免：{}",
            乙项.英文内容
        );

        // 继续纯函数体编辑：声明名未变 → 不得重译其余项
        让 (_, 其他变更) = 缓存实例
            .更新文档(
                "file:///test/甲.zh",
                "函数 新建() { 让 值 = 1; }\n函数 甲函数() {}",
                3,
            )
            .解包();
        断言!(其他变更.是否为空(), "声明名未变不应重译其余项");
    }

    /// 行映射：1:1 恒等，行数口径与逐行计数一致（含末尾换行/CRLF）
    #[测试]
    函数 行映射() {
        断言相等!(生成行映射("行0\n行1\n行2"), 向量![0, 1, 2]);
        // 末尾换行不多算一行
        断言相等!(生成行映射("let 让\n"), 向量![0]);
        断言相等!(生成行映射("a\r\nb\r\n"), 向量![0, 1]);
        // 空内容无行
        断言!(生成行映射("").是否为空());
        对于 样例 在 [
            "a",
            "a\n",
            "a\nb",
            "a\n\nb\n",
            "函数 f() {\n    让 x = 1;\n}",
        ] {
            断言相等!(
                行数(样例),
                样例.逐行().计数() 作为 无符号整数,
                "{样例:?}"
            );
        }
    }

    #[测试]
    函数 反向转译() {
        让 管理器 = 映射管理器::从扁表构造(
            哈希映射::从([
                ("函数".转为(), "fn".转为()),
                ("让".转为(), "let".转为()),
                ("打印行".转为(), "println".转为()),
                ("整数".转为(), "i32".转为()),
            ]),
            哈希映射::新建(),
            哈希映射::新建(),
        );
        让 临时目录 = 临时文件::建临时目录().解包();
        让 缓存实例 = 转译缓存::新建(管理器, 临时目录.条目路径().转路径缓冲());
        让 (缓存项, _) = 缓存实例
            .更新文档(
                "file:///test/main.zh",
                "函数 主函数() {\n让 count = 1;\n打印行!(\"count={}\", count);\n}",
                1,
            )
            .解包();
        断言相等!(
            缓存项.英文内容,
            "fn 主函数() {\nlet count = 1;\nprintln!(\"count={}\", count);\n}"
        );

        // 模拟 rustfmt 输出：统一缩进为 4 空格
        让 英文格式化文本 =
            "fn 主函数() {\n    let count = 1;\n    println!(\"count={}\", count);\n}\n";
        让 已还原 = 缓存实例.反向转译(有值("file:///test/main.zh"), 英文格式化文本);
        // 关键字/宏还原为母语，英文自定义标识符与中文标识符 主函数 保留
        断言相等!(
            已还原,
            "函数 主函数() {\n    让 count = 1;\n    打印行!(\"count={}\", count);\n}\n"
        );
    }

    /// 统一资源标识百分号解码：中文文件名（编辑器必然编码）能还原为真实路径
    #[测试]
    函数 资源标识转路径解码百分号() {
        // 测试.zh 的 UTF-8 百分号编码
        让 文件路径 = 资源标识转路径("file:///test/%E6%B5%8B%E8%AF%95.zh");
        断言相等!(文件路径, 路径缓冲::从("/test/测试.zh"));
        // 空格与井号同样可解码
        让 文件路径 = 资源标识转路径("file:///a%20dir/f%23ile.zh");
        断言相等!(文件路径, 路径缓冲::从("/a dir/f#ile.zh"));
    }

    /// 路径转统一资源标识对非安全字符做百分号编码，生成合法资源标识
    #[测试]
    函数 路径转资源标识编码特殊字符() {
        让 资源标识 = 路径转统一资源标识(路径类型::新建("/tmp/my dir/测试.rs"));
        断言!(资源标识.以开头("file:///tmp/my%20dir/"));
        断言!(资源标识.包含("%"));
        断言!(!资源标识.包含(' '));
        // 解码后能往返还原
        断言相等!(资源标识解码(&资源标识), "file:///tmp/my dir/测试.rs");
    }

    /// 模块名净化：非法字符替换、数字开头补下划线、空名回退
    #[测试]
    函数 模块名净化() {
        // 中文保留（合法标识符）
        断言相等!(净化模块名("辅助"), "辅助");
        // 非法字符替换为下划线
        断言相等!(净化模块名("a-b.zh\"x"), "a_b_zh_x");
        // 数字开头前补下划线
        断言相等!(净化模块名("1main"), "_1main");
        // 空名回退 m
        断言相等!(净化模块名(""), "m");
    }

    /// 中文文件名（百分号编码资源标识）打开后模块名合法，虚拟项目可编译
    #[测试]
    函数 更新文档编码中文文件名() {
        让 临时目录 = 临时文件::建临时目录().解包();
        让 缓存实例 = 转译缓存::新建(测试管理器(哈希映射::新建()), 临时目录.条目路径().转路径缓冲());
        让 (缓存项, _) = 缓存实例
            .更新文档("file:///test/%E6%B5%8B%E8%AF%95.zh", "让 x = 1;", 1)
            .解包();
        断言相等!(缓存项.英文内容, "let x = 1;");
        // 虚拟主文件中的模块名应为解码后的中文（合法标识符），而非百分号转义
        让 主文件文本 = 标准库::文件系统::读取字符串(临时目录.条目路径().连接("src").连接("main.rs")).解包();
        断言!(
            主文件文本.包含("mod 测试;"),
            "模块名应为解码后的中文: {主文件文本}"
        );
        断言!(!主文件文本.包含('%'));
    }

    /// 含 `公开`/`包含字符串` 映射的测试管理器（C2 系列测试用）
    函数 测试管理器扩展() -> 映射管理器 {
        让 可变 映射表 = 测试映射();
        映射表.置入("公开".转为(), "pub".转为());
        映射表.置入("包含字符串".转为(), "include_str".转为());
        映射管理器::从扁表构造(映射表, 哈希映射::新建(), 哈希映射::新建())
    }

    /// C2 甲：同目录未打开的兄弟模块被聚合（虚拟项目高保真化）
    ///
    /// weix-1 场景：主文件引用 工具.zh 的函数而 工具.zh 从未在编辑器中
    /// 打开——此前虚拟项目不含该模块，rust-analyzer 报 E0433/E0432 误报。
    #[测试]
    函数 兄弟模块聚合() {
        让 项目目录 = 临时文件::建临时目录().解包();
        让 虚拟目录 = 临时文件::建临时目录().解包();
        让 源目录 = 项目目录.条目路径().连接("src");
        标准库::文件系统::创建所有目录(&源目录).解包();
        标准库::文件系统::写入(
            源目录.连接("工具.zh"),
            "公开 函数 加一(数: i32) -> i32 {\n    数 + 1\n}\n",
        )
        .解包();

        让 缓存实例 = 转译缓存::新建(测试管理器扩展(), 虚拟目录.条目路径().转路径缓冲());
        让 主资源标识 = 路径转统一资源标识(&源目录.连接("main.zh"));
        让 (缓存项, _) = 缓存实例
            .更新文档(&主资源标识, "函数 主函数() {\n    工具::加一(1);\n}\n", 1)
            .解包();

        // 主文件跨文件引用补 `crate::` 前缀（模块集合已含新聚合的 工具）
        断言!(
            缓存项.英文内容.包含("crate::工具::加一(1)"),
            "跨文件引用应补 `crate::` 前缀：{}",
            缓存项.英文内容
        );
        // 兄弟模块已登记（已打开=假）并转译写盘
        让 工具项 = 缓存实例
            .查询原始(&路径转统一资源标识(&源目录.连接("工具.zh")))
            .期望("同目录兄弟模块应被聚合");
        断言!(!工具项.已打开, "磁盘聚合的模块不应标记为打开");
        断言!(
            工具项.英文内容.包含("pub fn 加一"),
            "兄弟模块应已转译：{}",
            工具项.英文内容
        );
        断言!(工具项.虚拟路径.存在(), "兄弟模块虚拟文件应写盘");
        // 聚合主文件同时声明两个模块
        让 聚合文本 = 标准库::文件系统::读取字符串(虚拟目录.条目路径().连接("src").连接("main.rs")).解包();
        断言!(
            聚合文本.包含("mod 工具;") && 聚合文本.包含("mod main;"),
            "聚合主文件：{聚合文本}"
        );
    }

    /// 多层模块布局：src/领域.zh + src/领域/工具.zh
    ///
    /// - 嵌套文件被递归登记并转译写盘；
    /// - 聚合主文件只声明顶层 `mod 领域`，不平铺嵌套 `mod 工具`；
    /// - 父虚拟文件（领域）末尾追加路径属性子声明，
    ///   使 rust-analyzer 能解析多层跨文件引用；
    /// - 叶子文件与主文件不追加子声明。
    #[测试]
    函数 嵌套模块树聚合() {
        让 项目目录 = 临时文件::建临时目录().解包();
        让 虚拟目录 = 临时文件::建临时目录().解包();
        让 源目录 = 项目目录.条目路径().连接("src");
        让 嵌套目录 = 源目录.连接("领域");
        标准库::文件系统::创建所有目录(&嵌套目录).解包();
        标准库::文件系统::写入(源目录.连接("领域.zh"), "公开 模块 工具;\n").解包();
        标准库::文件系统::写入(
            嵌套目录.连接("工具.zh"),
            "公开 函数 加一(数: i32) -> i32 {\n    数 + 1\n}\n",
        )
        .解包();

        让 缓存实例 = 转译缓存::新建(测试管理器扩展(), 虚拟目录.条目路径().转路径缓冲());
        让 主资源标识 = 路径转统一资源标识(&源目录.连接("main.zh"));
        让 (缓存项, _) = 缓存实例
            .更新文档(
                &主资源标识,
                "模块 领域;\n函数 主函数() {\n    领域::工具::加一(1);\n}\n",
                1,
            )
            .解包();
        断言!(
            缓存项.英文内容.包含("crate::领域::工具::加一(1)"),
            "多层跨文件引用应补 `crate::` 前缀：{}",
            缓存项.英文内容
        );

        // 嵌套文件被递归登记并转译
        让 工具项 = 缓存实例
            .查询原始(&路径转统一资源标识(&嵌套目录.连接("工具.zh")))
            .期望("嵌套模块应被递归同步");
        断言!(
            工具项.英文内容.包含("pub fn 加一"),
            "嵌套模块应已转译：{}",
            工具项.英文内容
        );
        断言!(工具项.虚拟路径.存在(), "嵌套虚拟文件应写盘");

        // 聚合主文件：仅顶层声明
        让 聚合文本 = 标准库::文件系统::读取字符串(虚拟目录.条目路径().连接("src").连接("main.rs")).解包();
        断言!(聚合文本.包含("mod 领域;"), "聚合应含顶层 领域：{聚合文本}");
        断言!(
            !聚合文本.包含("mod 工具;"),
            "嵌套模块不应平铺进聚合主文件：{聚合文本}"
        );

        // 父虚拟文件末尾的嵌套子声明：路径属性指向工具的平铺哈希文件名
        让 领域项 = 缓存实例
            .查询原始(&路径转统一资源标识(&源目录.连接("领域.zh")))
            .期望("领域模块应已登记");
        让 工具文件名 = 工具项
            .虚拟路径
            .取文件名()
            .解包()
            .转有损字符串()
            .转字符串();
        断言!(
            领域项
                .分析器内容
                .包含(&格式化!("#[path = \"{工具文件名}\"] pub mod 工具;")),
            "父虚拟文件应追加嵌套子声明：{}",
            领域项.分析器内容
        );
        // 用户原文行仍保留在反向转译用的英文内容中（测试词表未收录
        // 「模块」到模块声明的映射，原文形态保留；真实语言包下为公开模块声明）
        断言!(
            领域项.英文内容.包含("模块 工具;") || 领域项.英文内容.包含("mod 工具;"),
            "{}",
            领域项.英文内容
        );

        // 叶子与主文件无追加块
        断言!(
            !工具项.分析器内容.包含("nested module children"),
            "叶子模块不应有子声明块：{}",
            工具项.分析器内容
        );
        断言!(
            !缓存项.分析器内容.包含("nested module children"),
            "主文件不应出现源目录之外的子声明：{}",
            缓存项.分析器内容
        );
    }

    /// C2 甲：兄弟模块磁盘内容变化被增量同步（未打开文件以磁盘为准）
    #[测试]
    函数 兄弟模块磁盘更新同步() {
        让 项目目录 = 临时文件::建临时目录().解包();
        让 虚拟目录 = 临时文件::建临时目录().解包();
        让 源目录 = 项目目录.条目路径().连接("src");
        标准库::文件系统::创建所有目录(&源目录).解包();
        让 工具路径 = 源目录.连接("工具.zh");
        标准库::文件系统::写入(
            &工具路径,
            "公开 函数 加一(数: i32) -> i32 {\n    数 + 1\n}\n",
        )
        .解包();

        让 缓存实例 = 转译缓存::新建(测试管理器扩展(), 虚拟目录.条目路径().转路径缓冲());
        让 主资源标识 = 路径转统一资源标识(&源目录.连接("main.zh"));
        缓存实例
            .更新文档(&主资源标识, "函数 主函数() {\n    工具::加一(1);\n}\n", 1)
            .解包();
        让 工具资源标识 = 路径转统一资源标识(&工具路径);
        断言!(
            缓存实例
                .查询原始(&工具资源标识)
                .解包()
                .英文内容
                .包含("加一")
        );

        // 修改磁盘上的兄弟模块（长度变化确保增量判定命中）
        标准库::文件系统::写入(
            &工具路径,
            "公开 函数 加二(数: i32) -> i32 {\n    数 + 2\n}\n// 变更标记\n",
        )
        .解包();
        让 (_, 其他变更) = 缓存实例
            .更新文档(&主资源标识, "函数 主函数() {\n    工具::加一(1);\n}\n", 2)
            .解包();

        让 工具项 = 缓存实例.查询原始(&工具资源标识).解包();
        断言!(
            工具项.英文内容.包含("加二"),
            "磁盘变更应增量同步：{}",
            工具项.英文内容
        );
        断言!(
            其他变更.迭代().任意(|项值| 项值.原始资源标识 == 工具资源标识),
            "变更的兄弟模块应进入通知列表"
        );
    }

    /// C2 甲：磁盘上删除的兄弟模块被清理（项与虚拟文件一并移除）
    #[测试]
    函数 兄弟模块磁盘删除清理() {
        让 项目目录 = 临时文件::建临时目录().解包();
        让 虚拟目录 = 临时文件::建临时目录().解包();
        让 源目录 = 项目目录.条目路径().连接("src");
        标准库::文件系统::创建所有目录(&源目录).解包();
        让 工具路径 = 源目录.连接("工具.zh");
        标准库::文件系统::写入(&工具路径, "公开 函数 加一() {}\n").解包();

        让 缓存实例 = 转译缓存::新建(测试管理器扩展(), 虚拟目录.条目路径().转路径缓冲());
        让 主资源标识 = 路径转统一资源标识(&源目录.连接("main.zh"));
        缓存实例
            .更新文档(&主资源标识, "函数 主函数() {}\n", 1)
            .解包();
        让 工具资源标识 = 路径转统一资源标识(&工具路径);
        让 工具虚拟路径 = 缓存实例
            .查询原始(&工具资源标识)
            .解包()
            .虚拟路径
            .克隆值();
        断言!(工具虚拟路径.存在());
        让 先前版本 = 缓存实例.模块版本();

        // 磁盘删除后再次更新：项与虚拟文件应被清理，模块集合版本递增
        标准库::文件系统::删除文件(&工具路径).解包();
        缓存实例
            .更新文档(&主资源标识, "函数 主函数() {}\n", 2)
            .解包();

        断言!(
            缓存实例.查询原始(&工具资源标识).是否为无(),
            "删除的兄弟模块应移除项"
        );
        断言!(!工具虚拟路径.存在(), "虚拟文件应一并移除");
        断言!(
            缓存实例.模块版本() > 先前版本,
            "模块集合变化应递增版本"
        );
    }

    /// C2 乙：包含字符串资源复制进虚拟项目（无法读取误报根治）
    #[测试]
    函数 包含资源复制到虚拟项目() {
        让 项目目录 = 临时文件::建临时目录().解包();
        让 虚拟目录 = 临时文件::建临时目录().解包();
        让 源目录 = 项目目录.条目路径().连接("src");
        标准库::文件系统::创建所有目录(&源目录).解包();
        标准库::文件系统::写入(源目录.连接("数据.txt"), "占位内容").解包();

        让 缓存实例 = 转译缓存::新建(测试管理器扩展(), 虚拟目录.条目路径().转路径缓冲());
        让 主资源标识 = 路径转统一资源标识(&源目录.连接("main.zh"));
        让 (缓存项, _) = 缓存实例
            .更新文档(
                &主资源标识,
                "函数 主函数() {\n    让 页面 = 包含字符串!(\"数据.txt\");\n}\n",
                1,
            )
            .解包();
        断言!(
            缓存项.英文内容.包含("include_str!(\"数据.txt\")"),
            "宏名应转译且保留感叹号：{}",
            缓存项.英文内容
        );
        // 资源按相对位置复制到虚拟项目（与虚拟 `.rs` 同目录）
        让 已复制 = 虚拟目录.条目路径().连接("src").连接("数据.txt");
        断言!(已复制.是否为文件(), "包含资源应复制到虚拟项目");
        断言相等!(标准库::文件系统::读取字符串(已复制).解包(), "占位内容");
    }

    /// 包含资源路径收集：子串早退只跳过真实子串缺失的情形
    ///
    /// 早退判据是「全文不含包含字符串/包含字节子串」，而识别一个
    /// 调用要求词法项文本恰为该名，故早退不可能误跳过真实调用；本测试同时钉住
    /// 无宏内容、真实调用、伪调用（注释里的子串）与跨行调用四类结果。
    #[测试]
    函数 收集包含资源路径早退() {
        断言!(收集包含资源路径("fn main() { let s = \"文本\"; }").是否为空());
        断言相等!(
            收集包含资源路径("fn main() { let s = include_str!(\"数据.txt\"); }"),
            向量!["数据.txt".转字符串()]
        );
        // 子串存在但不是调用（行注释）：不走早退，但也不收集
        断言!(
            收集包含资源路径("// include_str!(\"假.txt\")\nfn main() {}").是否为空()
        );
        断言相等!(
            收集包含资源路径("static B: &[u8] = include_bytes!(\"图片.png\");"),
            向量!["图片.png".转字符串()]
        );
        // 允许 `!(` 之间存在空白/换行
        断言相等!(
            收集包含资源路径("let s = include_str ! (\n    \"配置.toml\",\n);"),
            向量!["配置.toml".转字符串()]
        );
    }

    /// 关闭文档：磁盘文件仍存在时降级为兄弟模块（不删除项/虚拟文件）
    #[测试]
    函数 关闭文档磁盘存在时降级() {
        让 项目目录 = 临时文件::建临时目录().解包();
        让 虚拟目录 = 临时文件::建临时目录().解包();
        让 源目录 = 项目目录.条目路径().连接("src");
        标准库::文件系统::创建所有目录(&源目录).解包();
        // 磁盘内容与缓冲区不同：关闭后应以磁盘为准
        标准库::文件系统::写入(源目录.连接("main.zh"), "让 磁盘 = 1;\n").解包();

        让 缓存实例 = 转译缓存::新建(测试管理器(哈希映射::新建()), 虚拟目录.条目路径().转路径缓冲());
        让 主资源标识 = 路径转统一资源标识(&源目录.连接("main.zh"));
        缓存实例
            .更新文档(&主资源标识, "让 缓冲 = 2;\n", 1)
            .解包();

        缓存实例.关闭文档(&主资源标识).解包();
        让 缓存项 = 缓存实例
            .查询原始(&主资源标识)
            .期望("磁盘文件存在时应降级保留，而非移除");
        断言!(!缓存项.已打开, "关闭后应降级为兄弟模块");
        断言相等!(缓存项.母语内容, "让 磁盘 = 1;\n", "降级后内容以磁盘为准");
        断言!(缓存项.虚拟路径.存在(), "虚拟文件保留");
        断言!(
            缓存项.英文内容.包含("let 磁盘 = 1;"),
            "应重译磁盘内容：{}",
            缓存项.英文内容
        );
    }
}
