//! 代理服务器模块
//!
//! 语言服务代理服务器的核心逻辑：
//! 1. 通过 lsp-server 与编辑器客户端建立语言服务连接
//! 2. 接收方言文件（`.zh` 等）变更，翻译后通知 rust-analyzer
//! 3. 转发 rust-analyzer 的响应与通知，并还原位置信息
//! 4. 把诊断消息翻译为对应语言

使用 标准库::集合::哈希映射;
使用 标准库::输入输出::写入特征;
使用 标准库::路径::{路径类型, 路径缓冲};
使用 标准库::同步模块::原子引用计数;
使用 标准库::线程;

使用 语言服务器库::{连接对象, 消息, 通知消息, 请求, 语言服务器响应};

使用 JSON序列化::JSON值;

使用 引擎库::映射源;

使用 包::分析器::分析器连接;
使用 包::响应映射::响应映射器;
使用 包::翻译缓存::{翻译条目, 路径转统一资源标识, 转译缓存};

/// 默认支持的方言文件扩展名（与内置语言包 lang_info.toml 的扩展名一致，
/// 单一来源：引擎 lang-packs 目录，避免清单与语言包漂移）；
/// 可通过命令行 `--extensions` 参数覆盖
函数 默认扩展名() -> 向量<字符串> {
    引擎库::语言::内置语言扩展名()
        .消费迭代()
        .映射(|扩展值| 格式化!(".{扩展值}"))
        .收集()
}

/// 语言服务代理服务器
公开 结构体 代理服务器 {
    /// 与编辑器客户端的语言服务连接
    客户端连接: 连接对象,
    /// 翻译缓存
    缓存: 原子引用计数<转译缓存>,
    /// rust-analyzer 子进程
    分析器: 分析器连接,
    /// 响应映射器
    响应映射器: 原子引用计数<响应映射器>,
    /// 自增请求标识
    请求计数器: 原子引用计数<标准库::同步模块::原子::原子i64>,
    /// 待映射的 rust-analyzer 请求标识 → 原始客户端请求信息
    待处理请求表: 待处理请求表类型,
    /// 支持的方言文件扩展名列表（如 `.zh`、`.de`）
    支持扩展名表: 向量<字符串>,
    /// 上次重载时的模块集合版本号（初值 -1 保证首个文档打开时重载一次）
    上次模块版本: 标准库::同步模块::原子::原子i64,
    /// rust-analyzer 声明的语义着色能力（初始化响应透传给客户端，
    /// 保证着色图例与记号类型索引一致，否则变量等语义着色错乱）
    语义记号提供者: 标准库::同步模块::互斥锁<选项<JSON值>>,
    /// 最近一次转发的内置诊断（方言资源标识 → 诊断列表）：代理自跑编译检查
    /// 后合并发布，避免检查结果覆盖语法/类型等实时诊断
    内置诊断表: 内置诊断表类型,
    /// 编译检查是否在运行（保存频繁时跳过进行中的检查，避免并发卡锁）
    检查进行中: 原子引用计数<标准库::同步模块::原子::原子布尔>,
    /// 运行期间是否收到新的保存请求（检查完成后补跑一次，
    /// 合并连续保存的中间状态，避免最终诊断停留在旧版本）
    待补检查: 原子引用计数<标准库::同步模块::原子::原子布尔>,
}

/// 记录一个转发给 rust-analyzer 的请求的原始信息
#[派生(调试, 克隆)]
结构体 待处理请求信息 {
    原始标识: 语言服务器库::请求标识,
    请求方法: 字符串,
    原始资源标识: 字符串,
    /// 转发时刻（用于超时清理，避免响应永不到达时条目无限累积）
    创建时刻: 标准库::时间模块::瞬间,
    /// 代码操作请求上下文诊断中提取的未声明包名
    ///（响应时注入“添加依赖”快捷修复；非代码操作请求为空）
    未解析包名表: 向量<字符串>,
    /// 代码操作请求上下文中的教学诊断（全角标点/教学检查，方言坐标）：
    /// 响应时注入对应快捷修复（一键替换半角/忽略此行）；非代码操作请求为空
    教学诊断表: 向量<JSON值>,
}

/// 待映射请求表：rust-analyzer 请求标识 → 原始客户端请求信息
类型 待处理请求表类型 =
    原子引用计数<标准库::同步模块::互斥锁<哈希映射<长整数, 待处理请求信息>>>;

/// 内置诊断表：方言资源标识 → 诊断列表
类型 内置诊断表类型 =
    原子引用计数<标准库::同步模块::互斥锁<哈希映射<字符串, 向量<JSON值>>>>;

/// 转发请求的等待超时：超过后向客户端应答错误并丢弃条目
常量 请求超时: 标准库::时间模块::持续时间 = 标准库::时间模块::持续时间::从秒(60);

实现 代理服务器 {
    /// 创建并初始化代理服务器
    ///
    /// 扩展名列表：支持的方言文件扩展名（如 `.zh`），
    /// 传空列表时使用默认值（`.zh` / `.de`）。
    公开 函数 新建(
        语言包路径: &路径类型,
        扩展名列表: &[字符串],
    ) -> 错误处理::结果<(自身, 语言服务器库::输入输出线程)> {
        // 1. 加载语言包（统一映射管理器，含模块路径映射）
        让 管理器 = 载入语言包(语言包路径)?;
        // 初始化诊断翻译器（errors.toml 消息表 + 由映射管理器构建的类型映射表，
        // 与命令行同源），供诊断映射与镜像检查翻译 rust-analyzer 诊断（E0004 等）
        包::响应映射::初始化诊断翻译器(语言包路径, &管理器);
        日志::信息!(
            "{}",
            包::界面消息::全局界面().取带参消息(
                "lsp_log_loaded_mappings",
                &[
                    &管理器.关键词表.长度().转字符串(),
                    &管理器.取宏表().长度().转字符串()
                ]
            )
        );

        // 2. 创建翻译缓存（临时目录按用户隔离，避免多用户共享系统临时目录）
        让 临时目录值 = 虚拟临时目录()?;
        让 缓存实例 = 转译缓存::新建(管理器, 临时目录值);

        // 3. 启动 rust-analyzer
        //
        // 启动失败（未安装/不可执行）不在此处返回错误：此刻尚未收到客户端
        // 的初始化请求，进程一旦退出，编辑器只能显示“服务端初始化失败”。
        // 失败原因先记入连接，由 `运行` 在握手后告知客户端。
        让 分析器实例 = 分析器连接::启动();

        // 4. 创建响应映射器
        让 映射器实例 = 原子引用计数::新建(响应映射器::新建(缓存实例.克隆值()));

        // 5. 建立语言服务连接（标准输入输出）
        让 (客户端连接, 输入输出线程) = 连接对象::标准输入输出();

        让 服务器实例 = 自身 {
            客户端连接,
            缓存: 缓存实例,
            分析器: 分析器实例,
            响应映射器: 映射器实例,
            请求计数器: 原子引用计数::新建(标准库::同步模块::原子::原子i64::新建(1000)),
            待处理请求表: 原子引用计数::新建(标准库::同步模块::互斥锁::新建(哈希映射::新建())),
            支持扩展名表: 如果 扩展名列表.是否为空() {
                默认扩展名()
            } 否则 {
                扩展名列表.到向量()
            },
            上次模块版本: 标准库::同步模块::原子::原子i64::新建(-1),
            语义记号提供者: 标准库::同步模块::互斥锁::新建(无),
            内置诊断表: 原子引用计数::新建(标准库::同步模块::互斥锁::新建(哈希映射::新建())),
            检查进行中: 原子引用计数::新建(标准库::同步模块::原子::原子布尔::新建(假)),
            待补检查: 原子引用计数::新建(标准库::同步模块::原子::原子布尔::新建(假)),
        };

        成功((服务器实例, 输入输出线程))
    }

    /// 运行服务器主循环
    公开 函数 运行(自我, 输入输出线程: 语言服务器库::输入输出线程) -> 错误处理::结果<()> {
        // 1. 等待初始化请求并握手
        让 (初始化标识, 初始化参数) = 自我.握手()?;
        日志::信息!("{}", 包::界面消息::全局界面().取消息("lsp_log_client_init"));

        // 2. 初始化 rust-analyzer
        //
        // 失败必须先把原因作为 `window/showMessage` 推给客户端，否则用户
        // 只看到“服务端初始化失败”与“连接已释放，待处理响应被拒绝”
        // 两条无法行动的提示。
        如果让 有值(错误原因) = 自我.分析器.启动失败原因() {
            返回 自我.初始化失败(初始化标识, &错误原因);
        }
        如果让 错误(错误值) = 自我.初始化分析器(&初始化参数) {
            返回 自我.初始化失败(初始化标识, &错误值.转字符串());
        }

        // 3. 回复客户端初始化响应
        自我.应答初始化(初始化标识)?;

        // 4. 启动 rust-analyzer 消息转发线程
        自我.启动转发线程()?;

        // 5. 进入主循环
        自我.主循环()?;

        // 6. 主循环结束后（收到关闭请求或客户端断开）清理资源。
        // 消息转发线程持有客户端发送端的克隆，并阻塞在 rust-analyzer
        // 的消息通道上；必须先停止 rust-analyzer 子进程让转发线程退出，
        // 再释放服务器（含客户端连接发送端），否则输入输出写入线程
        // 因通道永不关闭而无法结束，进程将无法退出。
        让 服务器实例 = 自我;
        服务器实例.分析器.停止();
        丢弃(服务器实例);

        // 7. 等待输入输出线程结束
        输入输出线程.等待线程()?;

        成功(())
    }

    /// 初始化失败时告知客户端并终止
    ///
    /// 顺序必须是「先通知、后错误响应」：客户端收到初始化错误响应会
    /// 立即释放连接（对应“连接已释放，待处理响应被拒绝”），之后再发的
    /// 任何消息均不可达。
    ///
    /// 返回错误让程序入口以非零码退出，并把原因留在标准错误（输出面板可见）。
    函数 初始化失败(&自我, 标识: 语言服务器库::请求标识, 错误原因: &文本) -> 错误处理::结果<()> {
        让 消息串 = 包::界面消息::全局界面().取带参消息("lsp_fail_notify", &[错误原因]);
        日志::日志错误!("{消息串}");
        // 失败时可能已经拉起子进程（如初始化超时），先收尾避免孤儿进程
        自我.分析器.停止();
        让 通知项 = 语言服务器库::通知消息::新建(
            "window/showMessage".转字符串(),
            JSON序列化::JSON格式!({ "type": 1, "message": 消息串 }),
        );
        让 _ = 自我.客户端连接.发送通道.发送(消息::通知消息(通知项));
        让 _ = 自我.客户端连接.发送通道.发送(消息::语言服务器响应(语言服务器响应::新建错误(
            标识,
            语言服务器库::错误码类型::内部错误码 作为 整数,
            错误原因.转字符串(),
        )));
        错误处理::错误中止!("{错误原因}")
    }

    /// 握手：接收初始化请求并回复
    函数 握手(&自我) -> 错误处理::结果<(语言服务器库::请求标识, JSON值)> {
        让 消息值 = 自我.客户端连接.接收通道.接收().映射错误(|错误值| {
            错误处理::错误处理!(
                "{}",
                包::界面消息::全局界面().取带参消息(
                    "lsp_err_recv_initialize",
                    &[&错误值.转字符串()]
                )
            )
        })?;

        匹配 消息值 {
            消息::请求(请求值) => {
                如果 请求值.方法 == "initialize" {
                    让 标识 = 请求值.标识号.克隆值();
                    让 参数值 = 请求值.请求参数.克隆值();
                    成功((标识, 参数值))
                } 否则 {
                    错误处理::错误中止!(
                        "{}",
                        包::界面消息::全局界面().取带参消息(
                            "lsp_err_expect_initialize",
                            &[&请求值.方法]
                        )
                    )
                }
            }
            _ => 错误处理::错误中止!(
                "{}",
                包::界面消息::全局界面().取消息("lsp_err_expect_request")
            ),
        }
    }

    /// 向 rust-analyzer 发送初始化请求并等待响应
    函数 初始化分析器(&自我, 参数值: &JSON值) -> 错误处理::结果<()> {
        // 不透传客户端的根资源标识/工作区文件夹：
        // 客户端工作区（如整个项目）与母语文件无关，
        // 透传会导致 rust-analyzer 全量分析并发布海量诊断，
        // 阻塞代理到客户端的消息通道。
        // 改用虚拟项目目录作为 rust-analyzer 的工作区根，
        // 使其只分析自动生成的虚拟 `.rs` 文件。
        让 _ = 参数值;
        让 虚拟项目 = 自我.缓存.虚拟项目资源标识();

        让 初始化请求 = JSON序列化::JSON格式!({
            "jsonrpc": "2.0",
            "id": 0,
            "method": "initialize",
            "params": {
                "processId": 标准库::进程::进程号(),
                "rootUri": 虚拟项目,
                "capabilities": {
                    "textDocument": {
                        "completion": {
                            "completionItem": {
                                // 启用代码片段：rust-analyzer 的方法/关键字补全
                                // 依赖它才能附带括号（如 `长度()`）与占位符
                                "snippetSupport": 真,
                                "labelDetailsSupport": 真
                            }
                        },
                        "publishDiagnostics": {
                            "relatedInformation": 真
                        },
                        "hover": {
                            "contentFormat": ["markdown", "plaintext"]
                        },
                        "definition": {},
                        "references": {},
                        "documentHighlight": {},
                        "documentSymbol": {
                            "hierarchicalDocumentSymbolSupport": 真
                        },
                        "rename": {
                            "prepareSupport": 真,
                            "prepareSupportDefaultBehavior": 1
                        },
                        "codeAction": {
                            "codeActionLiteralSupport": {
                                "codeActionKind": {
                                    "valueSet": ["quickfix", "refactor", "source"]
                                }
                            },
                            "resolveSupport": { "properties": ["edit"] }
                        },
                        "signatureHelp": {
                            "signatureInformation": {
                                "parameterInformation": { "labelOffsetSupport": 真 }
                            }
                        }
                    },
                    "workspace": {
                        "workspaceEdit": { "documentChanges": 真 }
                    }
                },
                "workspaceFolders": [{
                    "uri": 虚拟项目,
                    "name": "i18n-virtual"
                }],
                // 虚拟项目无依赖/无构建脚本/无过程宏：关闭相应后台任务，
                // 减少启动与保存时的编译开销；诊断保留由代理自跑检查发布
                "initializationOptions": {
                    "cargo": { "buildScripts": { "enable": 假 } },
                    "procMacro": { "enable": 假 },
                    // 注：不启用 rust-analyzer 的保存即检查——其诊断在虚拟项目
                    // 上不可达（编译服务常驻但无诊断发布）；改为代理在保存时
                    // 自跑编译检查并发布（见 `触发编译检查`）
                    // 自定义代码片段：方法/关键字补全附带括号与占位符
                    //（如 `长度()`、`让 可变 ${1:x}`），配合片段支持使用
                    "completion": { "snippets": "custom" }
                }
            }
        });

        自我.分析器.发送消息(&初始化请求)?;

        // 等待 rust-analyzer 的初始化响应（超时则直接报错，
        // 避免在半初始化状态下继续服务导致行为不可预测）
        让 可变 初始化完成 = 假;
        对于 _ 在 0..200 {
            如果让 有值(消息项) = 自我.分析器.尝试接收() {
                如果 消息项.读取条目("id").而后映射(|值| 值.转长整数()) == 有值(0) {
                    // 保存 rust-analyzer 的语义着色能力声明：初始化响应
                    // 透传给客户端，保证着色图例与记号类型索引一致
                    //（否则变量/参数等语义记号的类型索引错位，着色乱或不显示）
                    让 提供者 =
                        消息项["result"]["capabilities"]["semanticTokensProvider"].克隆值();
                    如果 !提供者.是空值()
                        && 让 成功(可变 槽位) = 自我.语义记号提供者.加锁()
                    {
                        *槽位 = 有值(提供者);
                    }
                    日志::信息!(
                        "{}",
                        包::界面消息::全局界面().取消息("lsp_log_ra_init_done")
                    );
                    初始化完成 = 真;
                    中断;
                }
                // 初始化期间 rust-analyzer 可能主动请求配置
                //（`workspace/configuration`）：必须立即响应，否则它一直等待
                // 导致配置加载挂起。返回补全片段配置并禁用其自跑编译检查
                //（见 `分析器配置答复` 的说明），其余键维持默认。
                如果 消息项.读取条目("method").而后映射(|值| 值.作为字符串())
                    == 有值("workspace/configuration")
                {
                    让 条目数 = 消息项["params"]["items"]
                        .作为数组()
                        .映射(|数组值| 数组值.长度())
                        .取值或(0);
                    让 答复值 = 分析器配置答复(条目数);
                    让 响应值 = JSON序列化::JSON格式!({
                        "jsonrpc": "2.0",
                        "id": 消息项["id"].克隆值(),
                        "result": 答复值
                    });
                    如果让 错误(错误值) = 自我.分析器.发送消息(&响应值) {
                        日志::警告!("配置响应发送失败: {错误值}");
                    }
                }
            }
            线程::线程休眠(标准库::时间模块::持续时间::从毫秒(50));
        }
        如果 !初始化完成 {
            错误处理::错误中止!(
                "{}",
                包::界面消息::全局界面().取消息("lsp_err_ra_init_timeout")
            );
        }

        // 注意：初始化完成通知不在本处发送，
        // 而是等客户端发来初始化完成通知时再转发（见 `处理客户端通知`），
        // 避免重复发送导致 rust-analyzer 报未处理的通知。

        成功(())
    }

    /// 回复客户端初始化响应
    函数 应答初始化(&自我, 标识: 语言服务器库::请求标识) -> 错误处理::结果<()> {
        让 可变 能力表 = JSON序列化::JSON格式!({
            "capabilities": {
                "textDocumentSync": {
                    "openClose": 真,
                    "change": 2,
                    "save": { "includeText": 真 }
                },
                "completionProvider": {
                    "triggerCharacters": [".", ":"]
                },
                "hoverProvider": 真,
                "definitionProvider": 真,
                "referencesProvider": 真,
                "documentSymbolProvider": 真,
                "codeActionProvider": 真,
                "renameProvider": 真,
                "documentHighlightProvider": 真,
                "documentFormattingProvider": 真,
                "signatureHelpProvider": {
                    "triggerCharacters": ["(", ","]
                }
            },
            "serverInfo": {
                "name": "i18n-rust-lsp",
                "version": 环境!("CARGO_PKG_VERSION")
            }
        });
        // 透传 rust-analyzer 的语义着色能力（含着色图例），
        // 使客户端请求语义记号并正确渲染变量/参数等颜色
        如果让 成功(槽位) = 自我.语义记号提供者.加锁()
            && 让 有值(提供者) = 槽位.作为引用方法()
        {
            能力表["capabilities"]["semanticTokensProvider"] = 提供者.克隆值();
        }

        让 响应值 = 语言服务器响应 {
            标识号: 标识,
            响应结果: 成功(能力表),
        };

        自我
            .客户端连接
            .发送通道
            .发送(消息::语言服务器响应(响应值))
            .映射错误(|错误值| {
                错误处理::错误处理!(
                    "{}",
                    包::界面消息::全局界面().取带参消息(
                        "lsp_err_send_initialize",
                        &[&错误值.转字符串()]
                    )
                )
            })?;
        成功(())
    }

    /// 启动 rust-analyzer → 客户端的消息转发线程
    函数 启动转发线程(&自我) -> 错误处理::结果<()> {
        让 接收器 = 自我.分析器.消息通道();
        让 映射器 = 自我.响应映射器.克隆值();
        让 发送方 = 自我.客户端连接.发送通道.克隆值();
        让 待处理表 = 自我.待处理请求表.克隆值();
        // rust-analyzer 主动请求（如配置、诊断刷新）
        // 的响应需要回发给 rust-analyzer 本身，而非客户端。
        让 分析器发送端 = 自我.分析器.取发送端副本();
        // 内置诊断缓存：编译检查结果合并发布时使用
        让 内置诊断 = 自我.内置诊断表.克隆值();

        线程::生成(移动 || {
            // 用带超时的接收代替阻塞接收，使无消息时也能周期性
            // 清理超时请求（rust-analyzer 挂起/丢弃请求时向客户端应答错误）
            让 可变 上次清理 = 标准库::时间模块::瞬间::现在();
            循环 {
                匹配 接收器.接收超时(标准库::时间模块::持续时间::从秒(1)) {
                    成功(消息值) => 处理分析器消息(
                        &消息值,
                        &映射器,
                        &发送方,
                        &待处理表,
                        &分析器发送端,
                        &内置诊断,
                    ),
                    错误(跨梁通道::接收超时错误::超时变体) => {}
                    错误(跨梁通道::接收超时错误::已断开) => 中断,
                }
                如果 上次清理.经过() >= 标准库::时间模块::持续时间::从秒(10) {
                    清理超时请求(&待处理表, &发送方);
                    上次清理 = 标准库::时间模块::瞬间::现在();
                }
            }
            日志::信息!("{}", 包::界面消息::全局界面().取消息("lsp_log_ra_thread_exit"));
        });

        成功(())
    }

    /// 主消息循环
    ///
    /// 用带超时的接收轮询代替阻塞接收：空闲时周期性检查
    /// rust-analyzer 崩溃标志，触发自动重启（进程崩溃后编辑器内
    /// 功能会静默失效，必须主动恢复而非空转等待）。
    函数 主循环(&自我) -> 错误处理::结果<()> {
        循环 {
            让 消息值 = 匹配 自我
                .客户端连接
                .接收通道
                .接收超时(标准库::时间模块::持续时间::从毫秒(100))
            {
                成功(消息项) => 消息项,
                错误(跨梁通道::接收超时错误::超时变体) => {
                    // rust-analyzer 异常退出：自动重启并重做完整握手
                    如果 自我.分析器.是否崩溃()
                        && 让 错误(错误值) = 自我.重启分析器()
                    {
                        日志::日志错误!(
                            "{}",
                            包::界面消息::全局界面().取带参消息(
                                "lsp_err_ra_restart",
                                &[&错误值.转字符串()]
                            )
                        );
                        // 重启失败（如二进制被卸载）：通知客户端并暂停自动重试，
                        // 避免每 100 毫秒刷一次错误日志与提示
                        让 参数值 = JSON序列化::JSON格式!({
                            "type": 1,
                            "message": 包::界面消息::全局界面().取带参消息(
                                "lsp_err_ra_restart",
                                &[&错误值.转字符串()]
                            )
                        });
                        让 _ = 自我.客户端连接.发送通道.发送(消息::通知消息(通知消息 {
                            方法: "window/showMessage".转字符串(),
                            请求参数: 参数值,
                        }));
                        自我.分析器.清除崩溃();
                    }
                    继续;
                }
                错误(_) => {
                    日志::信息!(
                        "{}",
                        包::界面消息::全局界面().取消息("lsp_log_client_disconnected")
                    );
                    中断;
                }
            };

            匹配 消息值 {
                消息::请求(请求值) => {
                    如果 请求值.方法 == "shutdown" {
                        日志::信息!(
                            "{}",
                            包::界面消息::全局界面().取消息("lsp_log_shutdown")
                        );
                        让 响应值 = 语言服务器响应 {
                            标识号: 请求值.标识号,
                            响应结果: 成功(JSON值::空值节点),
                        };
                        让 _ = 自我.客户端连接.发送通道.发送(消息::语言服务器响应(响应值));
                        中断;
                    }
                    // 单条请求处理失败（如 rust-analyzer 写入失败）只记录错误，
                    // 不退出服务器，避免一次偶发故障杀死整个会话
                    如果让 错误(错误值) = 自我.处理客户端请求(请求值) {
                        日志::日志错误!(
                            "{}",
                            包::界面消息::全局界面().取带参消息(
                                "lsp_err_handle_request",
                                &[&错误值.转字符串()]
                            )
                        );
                    }
                }
                消息::通知消息(通知值) => {
                    如果让 错误(错误值) = 自我.处理客户端通知(通知值) {
                        日志::日志错误!(
                            "{}",
                            包::界面消息::全局界面().取带参消息(
                                "lsp_err_handle_notification",
                                &[&错误值.转字符串()]
                            )
                        );
                    }
                }
                消息::语言服务器响应(_) => {}
            }
        }
        成功(())
    }

    /// rust-analyzer 崩溃后的自动恢复：重启子进程并重做完整握手，
    /// 使编辑器会话无感恢复（诊断/补全/悬停等重新可用）。
    函数 重启分析器(&自我) -> 错误处理::结果<()> {
        日志::警告!("{}", 包::界面消息::全局界面().取消息("lsp_log_ra_crashed"));
        自我.分析器.重启()?;
        // 重握手：初始化（含语义着色能力捕获）
        自我.初始化分析器(&JSON值::空值节点)?;
        // 初始化完成通知：客户端不会重复发送，此处必须手动补发
        自我.分析器.发送消息(&JSON序列化::JSON格式!({
            "jsonrpc": "2.0",
            "method": "initialized",
            "params": {}
        }))?;
        // 工作区：初始化请求已携带虚拟项目工作区文件夹，
        // 新进程按磁盘现状直接加载（`main.rs` 已由模块集合变化写盘），
        // 无需再发工作区变更通知
        // 重新打开所有已打开文档的虚拟文件（其磁盘副本与缓冲区不同步，
        // 必须重发打开通知提供内存副本）；兄弟模块未打开，不发打开通知
        // ——否则 rust-analyzer 以内存副本为准，后续磁盘更新通知不再生效
        对于 条目值 在 自我.缓存.全部条目() {
            如果 !条目值.已打开 {
                继续;
            }
            让 消息项 = JSON序列化::JSON格式!({
                "jsonrpc": "2.0",
                "method": "textDocument/didOpen",
                "params": {
                    "textDocument": {
                        "uri": 条目值.虚拟资源标识,
                        "languageId": "rust",
                        "version": 条目值.文档版本,
                        "text": 条目值.分析器内容
                    }
                }
            });
            自我.分析器.发送消息(&消息项)?;
        }
        // 旧进程遗留的待映射请求永远不会有响应：统一向客户端应答错误，
        // 避免客户端永久等待（否则编辑器内对应请求一直转圈）
        全部待处理失败应答(&自我.待处理请求表, &自我.客户端连接.发送通道);
        日志::信息!("{}", 包::界面消息::全局界面().取消息("lsp_log_ra_restarted"));
        成功(())
    }

    /// 处理客户端请求
    函数 处理客户端请求(&自我, 请求值: 请求) -> 错误处理::结果<()> {
        日志::调试!(
            "{}",
            包::界面消息::全局界面().取带参消息(
                "lsp_log_client_request",
                &[&请求值.方法, &格式化!("{:?}", 请求值.标识号)]
            )
        );

        匹配 请求值.方法.作为文本切片() {
            "initialize" => 成功(()), // 已在握手中处理
            // 格式化采用全文件替换策略，由代理自行处理（不转发 rust-analyzer）
            "textDocument/formatting" => 自我.处理格式化(请求值),
            "textDocument/completion"
            | "textDocument/hover"
            | "textDocument/definition"
            | "textDocument/references"
            | "textDocument/documentSymbol"
            | "textDocument/codeAction"
            | "textDocument/rename"
            | "textDocument/documentHighlight"
            | "textDocument/signatureHelp" => 自我.转发请求(请求值),
            _ => 自我.转发请求(请求值),
        }
    }

    /// 处理客户端通知
    函数 处理客户端通知(&自我, 通知值: 通知消息) -> 错误处理::结果<()> {
        日志::调试!(
            "{}",
            包::界面消息::全局界面().取带参消息(
                "lsp_log_client_notification",
                &[&通知值.方法]
            )
        );

        匹配 通知值.方法.作为文本切片() {
            "textDocument/didOpen" => 自我.处理文档打开(&通知值.请求参数),
            "textDocument/didChange" => 自我.处理文档变更(&通知值.请求参数),
            "textDocument/didClose" => 自我.处理文档关闭(&通知值.请求参数),
            "textDocument/didSave" => 自我.处理文档保存(&通知值.请求参数),
            "initialized" => {
                // 转发初始化完成通知给 rust-analyzer。
                // 虚拟项目工作区已在初始化请求中作为工作区文件夹
                // 声明：rust-analyzer 收到后统一加载，
                // 避免二次加载与工作区重载的并发竞态
                //（历史上重载模块的发送错误崩溃即源于此）。
                让 消息项 = JSON序列化::JSON格式!({
                    "jsonrpc": "2.0",
                    "method": "initialized",
                    "params": {}
                });
                自我.分析器.发送消息(&消息项)
            }
            _ => {
                让 消息项 = JSON序列化::JSON格式!({
                    "jsonrpc": "2.0",
                    "method": 通知值.方法,
                    "params": 通知值.请求参数
                });
                自我.分析器.发送消息(&消息项)
            }
        }
    }

    /// 判断资源标识是否为受支持的方言文件
    函数 是受支持文件(&自我, 资源标识: &文本) -> 布尔 {
        是受支持文件(资源标识, &自我.支持扩展名表)
    }

    /// 模块集合变化时通知 rust-analyzer 重读聚合主文件
    ///
    /// 打开/关闭方言文件会重写虚拟项目的聚合主文件；rust-analyzer 的
    /// 文件系统监听对虚拟项目（临时目录下的临时目录）不可靠，其虚拟
    /// 文件系统中的主文件内容会停留在旧版本，导致模块文件被判定为
    /// “不属于模块树中的任何位置”（未链接文件误报）。此处显式以
    /// 文件变更监听（已变更）告知主文件已更新，让 rust-analyzer 重读该文件
    ///（实测比工作区先移除再添加的重载更快，且不触发重载竞态崩溃）。
    函数 模块变化时通知主文件更新(&自我) -> 错误处理::结果<()> {
        让 新版本 = 自我.缓存.模块版本() 作为 长整数;
        让 旧版本 = 自我
            .上次模块版本
            .交换(新版本, 标准库::同步模块::原子::内存顺序::顺序);
        如果 旧版本 == 新版本 {
            返回 成功(());
        }
        让 主文件标识 = 路径转统一资源标识(
            &自我.缓存.虚拟项目目录().连接("src").连接("main.rs"),
        );
        让 通知项 = JSON序列化::JSON格式!({
            "jsonrpc": "2.0",
            "method": "workspace/didChangeWatchedFiles",
            "params": {
                "changes": [{ "uri": 主文件标识, "type": 2 }]
            }
        });
        自我.分析器.发送消息(&通知项)
    }

    /// 其他虚拟条目的内容变化通知：按条目打开状态路由
    ///
    /// 打开中的文档在 rust-analyzer 中有对应的内存副本，必须用变更通知
    /// 全量同步（对已打开文档重复打开通知违反语言服务协议）；兄弟模块
    /// 未在编辑器中打开，其虚拟文件由代理直接写盘，用文件变更监听
    ///（已变更）让 rust-analyzer 从磁盘重读。
    函数 通知虚拟条目变化(
        &自我,
        条目列表: &[原子引用计数<翻译条目>],
    ) -> 错误处理::结果<()> {
        对于 条目值 在 条目列表 {
            让 分析器消息 = 如果 条目值.已打开 {
                JSON序列化::JSON格式!({
                    "jsonrpc": "2.0",
                    "method": "textDocument/didChange",
                    "params": {
                        "textDocument": {
                            "uri": 条目值.虚拟资源标识,
                            "version": 条目值.文档版本
                        },
                        "contentChanges": [{ "text": 条目值.分析器内容 }]
                    }
                })
            } 否则 {
                JSON序列化::JSON格式!({
                    "jsonrpc": "2.0",
                    "method": "workspace/didChangeWatchedFiles",
                    "params": {
                        "changes": [{ "uri": 条目值.虚拟资源标识, "type": 2 }]
                    }
                })
            };
            自我.分析器.发送消息(&分析器消息)?;
        }
        成功(())
    }

    /// 处理文档打开
    函数 处理文档打开(&自我, 参数值: &JSON值) -> 错误处理::结果<()> {
        让 文档 = &参数值["textDocument"];
        让 资源标识 = 文档["uri"].作为字符串().取值或("");
        让 内容值 = 文档["text"].作为字符串().取值或("");
        让 文档版本 = 文档["version"].转长整数().取值或(1) 作为 整数;

        如果 !自我.是受支持文件(资源标识) {
            返回 成功(());
        }

        让 (条目值, 其他变更) = 自我.缓存.更新文档(资源标识, 内容值, 文档版本)?;

        // 模块集合变化时通知 rust-analyzer 重读聚合主文件，
        // 确保其识别新模块（虚拟项目的文件系统监听不可靠）。
        自我.模块变化时通知主文件更新()?;

        // 模块集合变化可能导致其他文件被重写（其虚拟内容新增/移除
        // 包前缀）：打开中的用变更通知同步，兄弟模块用文件变更监听
        // 通知磁盘重读
        自我.通知虚拟条目变化(&其他变更)?;

        让 分析器消息 = JSON序列化::JSON格式!({
            "jsonrpc": "2.0",
            "method": "textDocument/didOpen",
            "params": {
                "textDocument": {
                    "uri": 条目值.虚拟资源标识,
                    "languageId": "rust",
                    "version": 文档版本,
                    "text": 条目值.分析器内容
                }
            }
        });
        自我.分析器.发送消息(&分析器消息)?;
        日志::信息!(
            "{}",
            包::界面消息::全局界面().取带参消息(
                "lsp_log_doc_opened",
                &[资源标识, &文档版本.转字符串()]
            )
        );

        // 打开即跑权威检查（真实项目镜像）：无需保存即可见编译级诊断；
        // 镜像不可用时回退虚拟项目检查（草稿虚拟为假时的兜底）
        自我.触发编译检查(资源标识, 假)?;
        成功(())
    }

    /// 处理文档变更
    ///
    /// 代理声明增量同步（变更类型 2）以减少客户端→代理的传输量：
    /// 无范围的变更项为全量文本（兼容旧客户端），
    /// 带范围的按语言服务位置（UTF-16）逐项应用到缓存中的母语文本。
    /// 应用后仍全量重译，并以全量替换通知 rust-analyzer。
    函数 处理文档变更(&自我, 参数值: &JSON值) -> 错误处理::结果<()> {
        让 文档 = &参数值["textDocument"];
        让 资源标识 = 文档["uri"].作为字符串().取值或("");
        让 文档版本 = 文档["version"].转长整数().取值或(1) 作为 整数;

        如果 !自我.是受支持文件(资源标识) {
            返回 成功(());
        }

        让 有值(变更表) = 参数值["contentChanges"].作为数组() 否则 {
            返回 成功(());
        };

        // 在缓存旧文本上按序应用变更，得到新全文
        让 可变 内容值 = 自我
            .缓存
            .查询原始(资源标识)
            .映射(|条目项| 条目项.母语内容.克隆值())
            .取值或默认();
        对于 变更项 在 变更表 {
            如果让 有值(文本串) = 变更项["text"].作为字符串() {
                如果 变更项.读取条目("range").是否为无() {
                    // 全量替换
                    内容值 = 文本串.转字符串();
                } 否则 {
                    应用增量变更(&可变 内容值, &变更项["range"], 文本串);
                }
            }
        }

        让 (条目值, 其他变更) = 自我.缓存.更新文档(资源标识, &内容值, 文档版本)?;
        让 分析器消息 = JSON序列化::JSON格式!({
            "jsonrpc": "2.0",
            "method": "textDocument/didChange",
            "params": {
                "textDocument": {
                    "uri": 条目值.虚拟资源标识,
                    "version": 文档版本
                },
                "contentChanges": [{ "text": 条目值.分析器内容 }]
            }
        });
        自我.分析器.发送消息(&分析器消息)?;
        // 兄弟模块集合可能增删（磁盘文件变化）：聚合主文件需重读；
        // 其他条目内容被重写时按打开状态分别同步
        自我.模块变化时通知主文件更新()?;
        自我.通知虚拟条目变化(&其他变更)?;
        成功(())
    }

    /// 处理文档关闭
    函数 处理文档关闭(&自我, 参数值: &JSON值) -> 错误处理::结果<()> {
        让 资源标识 = 参数值["textDocument"]["uri"].作为字符串().取值或("");
        如果 !自我.是受支持文件(资源标识) {
            返回 成功(());
        }

        如果让 有值(条目值) = 自我.缓存.查询原始(资源标识) {
            让 分析器消息 = JSON序列化::JSON格式!({
                "jsonrpc": "2.0",
                "method": "textDocument/didClose",
                "params": {
                    "textDocument": { "uri": 条目值.虚拟资源标识 }
                }
            });
            自我.分析器.发送消息(&分析器消息)?;
        }

        // 关闭文档会缩小模块集合，其余条目的虚拟内容可能被重写
        让 其他变更 = 自我.缓存.关闭文档(资源标识)?;

        // 模块集合变化时通知 rust-analyzer 重读聚合主文件（模块已移除）
        自我.模块变化时通知主文件更新()?;

        // 其余条目按打开状态同步：打开中的用变更通知全量同步，
        // 兄弟模块（含刚降级的本条）用文件变更监听从磁盘重读
        自我.通知虚拟条目变化(&其他变更)?;
        成功(())
    }

    /// 处理文档保存
    函数 处理文档保存(&自我, 参数值: &JSON值) -> 错误处理::结果<()> {
        让 资源标识 = 参数值["textDocument"]["uri"].作为字符串().取值或("");
        如果 !自我.是受支持文件(资源标识) {
            返回 成功(());
        }

        如果让 有值(条目值) = 自我.缓存.查询原始(资源标识) {
            让 分析器消息 = JSON序列化::JSON格式!({
                "jsonrpc": "2.0",
                "method": "textDocument/didSave",
                "params": {
                    "textDocument": { "uri": 条目值.虚拟资源标识 },
                    "text": 条目值.分析器内容
                }
            });
            自我.分析器.发送消息(&分析器消息)?;
        }

        // 代理自跑编译检查并发布诊断：先虚拟项目草稿（快速反馈），
        // 再真实项目镜像（权威，与 rzc 构建口径一致）。rust-analyzer
        // 的保存即检查在虚拟项目上诊断不可达（编译服务常驻但无发布），
        // 而所有权可视化依赖 E0382 等检查诊断（移动黄/使用红/生命周期绿）
        自我.触发编译检查(资源标识, 真)?;
        成功(())
    }

    /// 异步执行编译检查并发布诊断
    ///
    /// 两条通路：
    /// - 虚拟项目草稿检查（`草稿虚拟` 为真时先跑）：教学场景无第三方
    ///   依赖，秒级反馈；
    /// - 真实项目镜像检查（权威）：项目树复制 + 方言转译产物覆盖 +
    ///   离线编译检查，复用真实构建目录的依赖产物，
    ///   诊断口径与 rzc 构建完全一致；镜像不可用时回退虚拟检查。
    ///
    /// `保存资源标识`：触发本次检查的方言文件（定位项目根）；
    /// `草稿虚拟`：是否先跑虚拟项目草稿检查（保存为真，
    /// 打开为假——镜像已含全部信息，草稿无必要）。
    函数 触发编译检查(
        &自我,
        保存资源标识: &文本,
        草稿虚拟: 布尔,
    ) -> 错误处理::结果<()> {
        让 缓存实例 = 自我.缓存.克隆值();
        让 映射器 = 自我.响应映射器.克隆值();
        让 发送方 = 自我.客户端连接.发送通道.克隆值();
        让 内置诊断 = 自我.内置诊断表.克隆值();
        让 检查进行中标志 = 自我.检查进行中.克隆值();
        让 待补检查标志 = 自我.待补检查.克隆值();
        让 扩展名表 = 自我.支持扩展名表.克隆值();
        // 教学检查词表索引由管理器缓存：跨线程只带一份引用计数，
        // 线程内按需取分桶索引（早先每次保存克隆整张词表一千余项）
        让 管理器 = 映射器.管理器共享();
        让 保存资源标识 = 保存资源标识.转字符串();
        让 项目目录 = 缓存实例.虚拟项目目录();

        // 并发保护：上次检查未结束（可能卡在锁等待）时，标记待重跑
        // 并立即返回——检查完成后补跑一次合并中间状态，避免连续保存
        // 时中间检查被静默丢弃，最终诊断停留在旧版本
        如果 检查进行中标志.交换(真, 标准库::同步模块::原子::内存顺序::顺序) {
            待补检查标志.存值(真, 标准库::同步模块::原子::内存顺序::顺序);
            返回 成功(());
        }

        标准库::线程::生成(移动 || {
            // 循环执行：期间收到新保存请求（待补位置位）则补跑一次；
            // 待补标志由首轮消费，最多连跑两次，合并中间全部状态
            循环 {
                待补检查标志.存值(假, 标准库::同步模块::原子::内存顺序::顺序);
                如果 草稿虚拟 {
                    自身::运行编译检查一次(
                        &缓存实例,
                        &映射器,
                        &发送方,
                        &内置诊断,
                        &项目目录,
                    );
                }
                // 镜像检查（权威）；不可用时回退虚拟检查
                //（保存时已跑过草稿，无需重复）
                让 镜像可用 = 包::镜像检查::运行镜像检查(
                    &缓存实例,
                    &发送方,
                    &内置诊断,
                    &扩展名表,
                    &保存资源标识,
                    &管理器,
                );
                如果 !镜像可用 && !草稿虚拟 {
                    自身::运行编译检查一次(
                        &缓存实例,
                        &映射器,
                        &发送方,
                        &内置诊断,
                        &项目目录,
                    );
                }
                如果 !待补检查标志.加载(标准库::同步模块::原子::内存顺序::顺序) {
                    中断;
                }
            }
            检查进行中标志.存值(假, 标准库::同步模块::原子::内存顺序::顺序);
        });
        成功(())
    }

    /// 执行一次编译检查并发布诊断（供 `触发编译检查` 的线程循环调用）
    ///
    /// 不负责检查进行中/待补检查标记（由调用方线程循环统一管理）。
    函数 运行编译检查一次(
        缓存实例: &原子引用计数<转译缓存>,
        映射器: &原子引用计数<响应映射器>,
        发送方: &跨梁通道::发送端<消息>,
        内置诊断: &内置诊断表类型,
        项目目录: &路径类型,
    ) {
        // 超时控制：编译命令在锁竞争等场景可能长时间不退出，
        // 轮询等待最多 30 秒后强杀，避免每次保存都挂起一个进程
        让 子进程值 = 匹配 标准库::进程::命令::新建("cargo")
            // 离线：虚拟项目无第三方依赖，跳过索引网络访问
            //（无锁文件时包管理器默认联网解析依赖，网络不可达会卡死）
            .参数(["check", "--offline", "--message-format=json"])
            .当前目录(项目目录)
            .标准输入(标准库::进程::标准流::空流())
            .标准输出(标准库::进程::标准流::管道化())
            .标准错误(标准库::进程::标准流::管道化())
            .生成()
        {
            成功(子进程项) => 子进程项,
            错误(错误值) => {
                日志::警告!("编译检查启动失败：{错误值}");
                返回;
            }
        };
        让 可变 子进程可选项 = 有值(子进程值);
        让 可变 输出项 = 无;
        让 可变 已超时 = 假;
        对于 序号 在 0..300 {
            匹配 子进程可选项
                .作为可变引用方法()
                .映射(|子进程项| 子进程项.尝试等待())
            {
                有值(成功(有值(_))) => {
                    输出项 = 子进程可选项
                        .取()
                        .而后映射(|子进程项| 子进程项.等待输出().转选项());
                    中断;
                }
                有值(成功(无)) => {
                    如果 序号 == 299 {
                        已超时 = 真;
                    }
                    标准库::线程::线程休眠(标准库::时间模块::持续时间::从毫秒(100));
                }
                _ => 中断,
            }
        }
        如果 已超时 {
            日志::警告!("编译检查超时，已终止");
            如果让 有值(可变 子进程项) = 子进程可选项.取() {
                让 _ = 子进程项.终止进程();
                让 _ = 子进程项.等待进程();
            }
        }
        让 有值(输出数据) = 输出项 否则 {
            返回;
        };

        // 解析编译消息行 → 按虚拟资源标识聚合（值 = (方言资源标识, 诊断列表)）
        让 标准输出文本 = 字符串::从utf8宽松(&输出数据.标准输出);
        让 可变 按资源标识: 哈希映射<字符串, (字符串, 向量<JSON值>)> = 哈希映射::新建();
        对于 行文本 在 标准输出文本.逐行() {
            让 成功(值项) = JSON序列化::解析字符串::<JSON值>(行文本) 否则 {
                继续;
            };
            如果 值项["reason"].作为字符串() != 有值("compiler-message") {
                继续;
            }
            让 消息项 = &值项["message"];
            让 有值(跨度项) = 消息项["spans"]
                .作为数组()
                .而后映射(|数组值| 数组值.第一个())
            否则 {
                继续;
            };
            让 有值(文件名值) = 跨度项["file_name"].作为字符串() 否则 {
                继续;
            };
            // 编译器可能输出相对路径（工作目录为虚拟项目目录），拼上项目目录
            让 文件路径 = 如果 路径类型::新建(文件名值).是否绝对() {
                路径缓冲::从(文件名值)
            } 否则 {
                项目目录.连接(文件名值)
            };
            // 仅处理虚拟方言文件（聚合主文件、标准库等跳过）
            让 有值(条目值) =
                缓存实例.按虚拟资源标识查询(&路径转统一资源标识(&文件路径))
            否则 {
                继续;
            };
            让 行号 = 跨度项["line_start"].作为长整数().取值或(1).饱和减(1);
            让 列号 = 跨度项["column_start"].作为长整数().取值或(1).饱和减(1);
            让 末行号 = 跨度项["line_end"]
                .作为长整数()
                .取值或(行号 + 1)
                .饱和减(1);
            让 末列号 = 跨度项["column_end"]
                .作为长整数()
                .取值或(列号 + 1)
                .饱和减(1);
            让 错误码值 = 消息项["code"]["code"].作为字符串().取值或("").转字符串();
            让 严重级 = 匹配 消息项["level"].作为字符串() {
                有值("error") => 1,
                有值("warning") => 2,
                _ => 3,
            };
            让 诊断项 = JSON序列化::JSON格式!({
                "range": {
                    "start": { "line": 行号, "character": 列号 },
                    "end": { "line": 末行号, "character": 末列号 }
                },
                "severity": 严重级,
                "code": 错误码值,
                "message": 消息项["message"].作为字符串().取值或(""),
            });
            让 目标项 = 按资源标识
                .取条目(条目值.虚拟资源标识.克隆值())
                .或用插入(|| (条目值.原始资源标识.克隆值(), 向量::新建()));
            目标项.1.推入(诊断项);
        }

        // 合并内置诊断（语法/类型）后发布：同诊断码且同起始行视为重复。
        // 注意：诊断映射期望输入虚拟资源标识（内部还原为方言资源标识），
        // 传方言资源标识会导致位置映射查不到条目而丢失全部诊断。
        对于 (虚拟资源标识, (原始资源标识, 可变 诊断表)) 在 按资源标识 {
            如果让 成功(守卫) = 内置诊断.加锁()
                && 让 有值(内置项) = 守卫.读取条目(&原始资源标识)
            {
                对于 内置诊断项 在 内置项.克隆值() {
                    让 是重复 = 诊断表.迭代().任意(|诊断项| {
                        诊断项["code"] == 内置诊断项["code"]
                            && 诊断项["range"]["start"]["line"]
                                == 内置诊断项["range"]["start"]["line"]
                    });
                    如果 !是重复 {
                        诊断表.推入(内置诊断项);
                    }
                }
            }
            让 参数值 =
                JSON序列化::JSON格式!({ "uri": 虚拟资源标识, "diagnostics": 诊断表 });
            让 可变 映射后 = 映射器.映射诊断(&参数值);
            // 教学诊断注入（与分析器链路一致）：由条目内容直接计算，
            // 不依赖内置缓存时序（虚拟检查可能先于分析器首批发布，
            // 缓存为空时教学提示不能丢失）
            如果让 有值(条目值) = 缓存实例.查询原始(&原始资源标识) {
                让 可变 最终诊断 = 映射后["diagnostics"]
                    .作为数组()
                    .克隆副本()
                    .取值或默认();
                包::响应映射::诊断文本::注入教学诊断(
                    &可变 最终诊断,
                    &条目值,
                    映射器.教学词分桶(),
                    映射器.歧义构造器词集(),
                    映射器.英文回落映射(),
                    映射器.关键词映射(),
                );
                映射后["diagnostics"] = JSON值::JSON数组(最终诊断);
            }
            让 通知项 = 通知消息 {
                方法: "textDocument/publishDiagnostics".转字符串(),
                请求参数: 映射后,
            };
            让 _ = 发送方.发送(消息::通知消息(通知项));
        }
    }

    /// 处理代码格式化请求（`textDocument/formatting`）
    ///
    /// 采用全文件替换策略，不转发 rust-analyzer：
    /// 取缓存中的英文译文 → rustfmt 格式化 → 反向翻译回母语 →
    /// 返回覆盖整个文档的文本编辑。
    /// 文档未打开或 rustfmt 失败时返回空数组，不崩溃。
    函数 处理格式化(&自我, 请求值: 请求) -> 错误处理::结果<()> {
        让 资源标识 = 请求值.请求参数["textDocument"]["uri"].作为字符串().取值或("");

        让 编辑表 = 匹配 自我.缓存.查询原始(资源标识) {
            有值(条目值) => {
                让 制表宽度 = 请求值.请求参数["options"]["tabSize"].作为长整数().取值或(4);
                匹配 运行格式化(&条目值.英文内容, 制表宽度) {
                    有值(格式化英文) => {
                        // 将格式化后的英文代码反向翻译为母语代码
                        //（按文档编辑映射精确删除代理添加的包前缀）
                        让 格式化母语 =
                            自我.缓存.反向转译(有值(资源标识), &格式化英文);
                        向量![JSON序列化::JSON格式!({
                            "range": {
                                "start": { "line": 0, "character": 0 },
                                "end": 文末位置(&条目值.母语内容)
                            },
                            "newText": 格式化母语
                        })]
                    }
                    无 => 向量::新建(),
                }
            }
            无 => 向量::新建(),
        };

        让 响应值 = 语言服务器响应 {
            标识号: 请求值.标识号,
            响应结果: 成功(JSON值::JSON数组(编辑表)),
        };
        自我
            .客户端连接
            .发送通道
            .发送(消息::语言服务器响应(响应值))
            .映射错误(|错误值| {
                错误处理::错误处理!(
                    "{}",
                    包::界面消息::全局界面().取带参消息(
                        "lsp_err_send_format",
                        &[&错误值.转字符串()]
                    )
                )
            })?;
        成功(())
    }

    /// 转发请求到 rust-analyzer
    ///
    /// 除了将资源标识替换为虚拟文件资源标识，还将请求中的位置
    ///（位置/范围）从母语坐标转换为英文坐标，
    /// 并将重命名的新名字段翻译为英文。
    函数 转发请求(&自我, 请求值: 请求) -> 错误处理::结果<()> {
        让 分析器标识 = 自我
            .请求计数器
            .获取并修改(1, 标准库::同步模块::原子::内存顺序::顺序);

        让 原始资源标识 = 请求值.请求参数["textDocument"]["uri"]
            .作为字符串()
            .取值或("")
            .转字符串();

        {
            让 可变 待处理表 = 自我.待处理请求表.加锁().映射错误(|_| {
                错误处理::错误处理!(
                    "{}",
                    包::界面消息::全局界面().取消息("lsp_err_lock")
                )
            })?;
            待处理表.置入(
                分析器标识,
                待处理请求信息 {
                    原始标识: 请求值.标识号,
                    请求方法: 请求值.方法.克隆值(),
                    原始资源标识: 原始资源标识.克隆值(),
                    创建时刻: 标准库::时间模块::瞬间::现在(),
                    未解析包名表: 如果 请求值.方法 == "textDocument/codeAction" {
                        让 诊断表 = 请求值.请求参数["context"]["diagnostics"]
                            .作为数组()
                            .映射(|数组值| &数组值[..])
                            .取值或(&[]);
                        从诊断提取未解析包名(诊断表)
                    } 否则 {
                        向量::新建()
                    },
                    教学诊断表: 如果 请求值.方法 == "textDocument/codeAction" {
                        请求值.请求参数["context"]["diagnostics"]
                            .作为数组()
                            .映射(|数组值| {
                                数组值
                                    .迭代()
                                    .过滤(|诊断项| {
                                        包::响应映射::诊断文本::是教学诊断(诊断项)
                                    })
                                    .克隆副本()
                                    .收集()
                            })
                            .取值或默认()
                    } 否则 {
                        向量::新建()
                    },
                },
            );
        }

        // 替换资源标识为虚拟资源标识，并转换请求中的位置
        让 可变 参数值 = 请求值.请求参数.克隆值();
        让 条目选项 = 如果 自我.是受支持文件(&原始资源标识) {
            自我.缓存.查询原始(&原始资源标识)
        } 否则 {
            无
        };

        如果让 有值(条目值) = &条目选项 {
            // 1. 替换文本文档的资源标识字段
            如果让 有值(标识字段) = 参数值
                .获取可变("textDocument")
                .而后映射(|文档值| 文档值.获取可变("uri"))
            {
                *标识字段 = JSON值::字符串值(条目值.虚拟资源标识.克隆值());
            }

            // 2. 按方法转换位置参数（母语坐标 → 英文坐标）
            匹配 请求值.方法.作为文本切片() {
                "textDocument/completion"
                | "textDocument/hover"
                | "textDocument/definition"
                | "textDocument/references"
                | "textDocument/rename"
                | "textDocument/documentHighlight"
                | "textDocument/signatureHelp" => {
                    如果让 有值(位置值) = 参数值.获取可变("position") {
                        *位置值 = 位置转英文(条目值, 位置值);
                    }
                }
                "textDocument/codeAction" => {
                    如果让 有值(范围值) = 参数值.获取可变("range") {
                        *范围值 = 范围转英文(条目值, 范围值);
                    }
                    // 上下文诊断来自我们发布的中文诊断，同样需要转换
                    如果让 有值(诊断列表) = 参数值
                        .获取可变("context")
                        .而后映射(|上下文值| 上下文值.获取可变("diagnostics"))
                        .而后映射(|诊断值| 诊断值.作为可变数组())
                    {
                        对于 诊断项 在 诊断列表.可变迭代() {
                            如果让 有值(范围值) = 诊断项.获取可变("range") {
                                *范围值 = 范围转英文(条目值, 范围值);
                            }
                        }
                    }
                }
                _ => {}
            }

            // 3. 重命名的新名字段：中文 → 英文（不在关键字映射中则保持原样）
            如果 请求值.方法 == "textDocument/rename"
                && 让 有值(母语名) = 请求值.请求参数
                    .读取条目("newName")
                    .而后映射(|值| 值.作为字符串())
            {
                让 英文名 = 自我
                    .缓存
                    .关键词映射()
                    .读取条目(母语名)
                    .或用否则(|| 自我.缓存.标识符别名映射().读取条目(母语名))
                    .克隆副本()
                    .解包或用否则(|| 母语名.转字符串());
                参数值["newName"] = JSON值::字符串值(英文名);
            }
        }

        让 分析器消息 = JSON序列化::JSON格式!({
            "jsonrpc": "2.0",
            "id": 分析器标识,
            "method": 请求值.方法,
            "params": 参数值
        });
        自我.分析器.发送消息(&分析器消息)
    }
}

/// 判断资源标识是否以任一受支持的方言扩展名结尾
函数 是受支持文件(资源标识: &文本, 扩展名表: &[字符串]) -> 布尔 {
    扩展名表.迭代().任意(|扩展项| 资源标识.以结尾(扩展项))
}

/// 从代码操作请求上下文诊断中提取未声明的包名
///
/// 消息可能是英文原文（rust-analyzer 直发）或翻译后的母语文本
///（经我方发布后由客户端回传）：两者都保留反引号包裹的路径
/// 内容，提取逻辑统一；母语消息按本地化短语表判定未解析导入。
函数 从诊断提取未解析包名(诊断表: &[JSON值]) -> 向量<字符串> {
    让 翻译短语 = 包::界面消息::全局界面().取消息("lsp_phrase_unresolved_import");
    让 可变 未解析表 = 向量::新建();
    对于 诊断项 在 诊断表 {
        让 有值(消息串) = 诊断项.读取条目("message").而后映射(|值| 值.作为字符串())
        否则 {
            继续;
        };
        让 是未解析 = 引擎库::诊断::是否未解析导入消息(消息串)
            || 消息串.包含(翻译短语.作为文本切片());
        如果 !是未解析 {
            继续;
        }
        对于 段 在 引擎库::诊断::取反引号首段(消息串) {
            如果 ["std", "core", "alloc", "self", "super", "crate", "proc_macro"]
                .包含(&段.作为文本切片())
                || 段.逐字符().下一个().有值且(|字符值| 字符值.是数字字符())
            {
                继续;
            }
            如果 !未解析表.包含(&段) {
                未解析表.推入(段);
            }
        }
    }
    未解析表
}

/// 计算虚拟项目临时目录（按用户 + 进程实例隔离）并拒绝符号链接
///
/// 固定共享的临时路径在多用户机器上可被预创建为符号链接，
/// 后续写文件会跟随链接覆写任意位置；按用户名隔离并校验规避此风险。
/// 同一用户的多个编辑器实例各起一个语言服务代理进程，再叠加进程号后缀
/// 避免互相同目录覆写清单文件与源码内容；启动时清理已死进程
/// 的残留目录（见 `清理残留虚拟目录`）防止无限累积。
函数 虚拟临时目录() -> 错误处理::结果<路径缓冲> {
    让 用户名 = 标准库::环境::环境变量("USER")
        .或用否则(|_| 标准库::环境::环境变量("USERNAME"))
        .解包或用否则(|_| "default".转字符串());
    让 安全用户名: 字符串 = 用户名
        .逐字符()
        .映射(|字符值| {
            如果 字符值.是否为字母数字() || 字符值 == '_' {
                字符值
            } 否则 {
                '_'
            }
        })
        .收集();
    清理残留虚拟目录(&安全用户名);
    让 目录值 = 标准库::环境::临时目录().连接(格式化!(
        "i18n_lsp_virtual_{}_{}",
        安全用户名,
        标准库::进程::进程号()
    ));
    // 两道校验，缺一不可：
    // 1. 创建前——可预测名（用户 + 进程号）可被本地攻击者预创建为符号链接；
    // 2. 创建后、任何写文件之前——校验与创建之间存在竞态窗口，
    //    攻击者可在此期间把路径换成符号链接，而创建目录会跟随它。
    //    此时符号链接元数据仍报告链接本身，立即拒绝可保证
    //    尚无任何文件写入发生在链接目标处。
    如果 是符号链接(&目录值) {
        错误处理::错误中止!(
            "{}",
            包::界面消息::全局界面().取带参消息(
                "lsp_err_temp_symlink",
                &[&目录值.展示().转字符串()]
            )
        );
    }
    标准库::文件系统::创建所有目录(&目录值).映射错误(|错误值| {
        错误处理::错误处理!(
            "创建 LSP 虚拟项目目录失败：{}（{}）",
            目录值.展示(),
            错误值
        )
    })?;
    如果 是符号链接(&目录值) {
        错误处理::错误中止!(
            "{}",
            包::界面消息::全局界面().取带参消息(
                "lsp_err_temp_symlink",
                &[&目录值.展示().转字符串()]
            )
        );
    }
    成功(目录值)
}

/// 路径自身是否为符号链接（不跟随末段链接）
函数 是符号链接(路径值: &路径类型) -> 布尔 {
    路径值
        .符号链接元数据()
        .映射(|元数据值| 元数据值.文件类型().是否为符号链接())
        .取值或(假)
}

/// 清理同用户的残留虚拟/镜像目录：仅删除名称中带进程号后缀且进程已死的目录
///
/// 虚拟目录名 `i18n_lsp_virtual_<用户>_<进程号>`；镜像目录名
/// `i18n_lsp_mirror_<用户>_<进程号>_<项目哈希>`（进程号段后还有哈希段）。
/// 尽力而为：任何失败（目录列举失败、无法解析进程号、删除失败）都静默跳过，
/// 不影响本实例启动。存活检查对 Unix（零信号探活）与其余平台分别处理。
函数 清理残留虚拟目录(安全用户名: &文本) {
    让 前缀表 = [
        格式化!("i18n_lsp_virtual_{}_", 安全用户名),
        格式化!("i18n_lsp_mirror_{}_", 安全用户名),
    ];
    让 成功(目录读取器) = 标准库::文件系统::读取目录(标准库::环境::临时目录()) 否则 {
        返回;
    };
    对于 目录项 在 目录读取器.展平() {
        让 名称值 = 目录项.文件名();
        让 有值(名称串) = 名称值.取字符串引用() 否则 {
            继续;
        };
        // 仅处理本用户且带进程号后缀的目录；无后缀的旧版目录不动（避免误删）
        让 有值(剩余串) = 前缀表
            .迭代()
            .查找映射(|前缀项| 名称串.去前缀(前缀项.作为文本切片()))
        否则 {
            继续;
        };
        // 兼容上轮改名后未删除干净的残留后缀；镜像名进程号后还有
        // 哈希段，取首个下划线之前的部分为进程号
        让 剩余串 = 剩余串.去后缀(".stale").取值或(剩余串);
        让 进程号串 = 剩余串.分割('_').下一个().取值或(剩余串);
        如果 进程号串 == 标准库::进程::进程号().转字符串() {
            继续; // 当前进程自己的目录
        }
        让 成功(进程号值) = 进程号串.解析::<无符号整数>() 否则 {
            继续;
        };
        如果 进程存活(进程号值) {
            继续;
        }
        // 进程已死：目录是残留，先原子改名再删除（竞态防护）：
        // 检查与删除之间进程号可能被系统回收并由新进程重建同名目录，
        // 改名把旧目录移走后再删，新进程创建的是新路径，不受影响
        让 路径值 = 目录项.条目路径();
        如果 路径值
            .符号链接元数据()
            .映射(|元数据值| 元数据值.文件类型().是否为符号链接())
            .取值或(真)
        {
            继续; // 符号链接不跟随删除
        }
        让 残留路径 = 目录项.条目路径().带文件名(格式化!("{名称串}.stale"));
        如果 标准库::文件系统::重命名(&路径值, &残留路径).是否为成功() {
            让 _ = 标准库::文件系统::删除所有目录(&残留路径);
        }
    }
}

/// 响应 rust-analyzer 的配置请求
///
/// - 补全片段设为自定义：方法补全附带括号；
/// - 保存即检查与检查开关设为假：禁用 rust-analyzer 自跑的
///   编译检查。该检查针对无第三方依赖、无过程宏的虚拟项目，
///   结果按工作区全部文件成批发布：依赖缺失、派生不展开的级联错误
///   在该环境下恒为假红。编译级诊断由代理自跑虚拟/镜像检查提供
///   （打开/保存时触发）。
函数 分析器配置答复(条目数: 无符号机器整数) -> JSON值 {
    JSON值::JSON数组(
        (0..条目数)
            .映射(|_| {
                JSON序列化::JSON格式!({
                    "completion": { "snippets": "custom" },
                    "checkOnSave": { "enable": 假 },
                    "check": { "enable": 假 }
                })
            })
            .收集(),
    )
}

/// 判断进程号是否存活（仅用于残留目录清理，误判代价低）
///
/// Unix：零信号探活，命令退出成功即视为存活；探测本身失败时保守视为存活，
/// 宁可残留目录下轮再清，也不误删活进程的文件。
函数 进程存活(进程号值: 无符号整数) -> 布尔 {
    #[配置(Unix系统)]
    {
        // 零信号探活：`kill -0 <进程号>` 成功即进程存在且有权限。
        // 外部 C 函数块不允许非 ASCII 名字，故改走系统必装的命令解释器
        // 内建命令；只在启动清理时调用，额外开销可忽略。
        标准库::进程::命令::新建("sh")
            .参数(["-c", &格式化!("kill -0 {}", 进程号值)])
            .标准输出(标准库::进程::标准流::空流())
            .标准错误(标准库::进程::标准流::空流())
            .进程状态()
            .映射(|状态值| 状态值.退出成功())
            .取值或(真)
    }
    #[配置(非(Unix系统))]
    {
        // 非 Unix 平台无廉价探活手段：保守视为存活，不删除
        让 _ = 进程号值;
        真
    }
}

/// 清理超时的待映射请求：向客户端应答错误，避免永久等待与条目泄漏
函数 清理超时请求(
    待处理表: &待处理请求表类型,
    发送方: &跨梁通道::发送端<消息>,
) {
    让 当前时刻 = 标准库::时间模块::瞬间::现在();
    让 可变 超时表: 向量<语言服务器库::请求标识> = 向量::新建();
    {
        让 可变 请求表 = 匹配 待处理表.加锁() {
            成功(守卫) => 守卫,
            错误(_) => 返回,
        };
        请求表.保留项(|_标识, 信息项| {
            如果 当前时刻.自纪元(信息项.创建时刻) > 请求超时 {
                超时表.推入(信息项.原始标识.克隆值());
                假
            } 否则 {
                真
            }
        });
    }
    对于 标识 在 超时表 {
        日志::警告!("{}", 包::界面消息::全局界面().取消息("lsp_warn_request_timeout"));
        让 响应值 = 语言服务器响应 {
            标识号: 标识,
            响应结果: 错误(语言服务器库::响应错误 {
                代码: -32603,
                消息文本: "rust-analyzer 未在超时前响应".转字符串(),
                附加数据: 无,
            }),
        };
        让 _ = 发送方.发送(消息::语言服务器响应(响应值));
    }
}

/// 清空全部待映射请求：向客户端应答错误（rust-analyzer 崩溃重启后调用，
/// 旧进程的请求永远不会有响应，必须主动应答避免客户端永久等待）
函数 全部待处理失败应答(
    待处理表: &待处理请求表类型,
    发送方: &跨梁通道::发送端<消息>,
) {
    让 标识表: 向量<语言服务器库::请求标识> = {
        让 可变 请求表 = 匹配 待处理表.加锁() {
            成功(守卫) => 守卫,
            错误(_) => 返回,
        };
        请求表
            .耗尽()
            .映射(|(_标识, 信息项)| 信息项.原始标识)
            .收集()
    };
    对于 标识 在 标识表 {
        让 响应值 = 语言服务器响应 {
            标识号: 标识,
            响应结果: 错误(语言服务器库::响应错误 {
                代码: -32603,
                消息文本: "rust-analyzer 已重启".转字符串(),
                附加数据: 无,
            }),
        };
        让 _ = 发送方.发送(消息::语言服务器响应(响应值));
    }
}

/// 调用系统 rustfmt 格式化英文代码
///
/// 通过标准输入传入源码、标准输出取回格式化结果。
/// 新版 rustfmt（1.9 以上）不传文件参数时从标准输入读取，需配合 `--emit stdout`；
/// rustfmt 不存在、源码含语法错误或输出非 UTF-8 时返回无。
函数 运行格式化(源文本: &文本, 制表宽度: 无符号长整数) -> 选项<字符串> {
    让 可变 子进程值 = 标准库::进程::命令::新建("rustfmt")
        .单参数("--emit")
        .单参数("stdout")
        .单参数("--edition")
        .单参数("2021")
        .单参数("--config")
        .单参数(格式化!("tab_spaces={}", 制表宽度.最大值(1)))
        .标准输入(标准库::进程::标准流::管道化())
        .标准输出(标准库::进程::标准流::管道化())
        .标准错误(标准库::进程::标准流::空流())
        .生成()
        .转选项()?;
    如果让 有值(可变 标准输入管道) = 子进程值.标准输入.取() {
        标准输入管道.写入全部(源文本.转为字节()).转选项()?;
        // 标准输入管道在此处丢弃，关闭管道使 rustfmt 结束输出
    }
    让 输出项 = 子进程值.等待输出().转选项()?;
    如果 !输出项.进程状态.退出成功() {
        返回 无;
    }
    字符串::从字节(输出项.标准输出).转选项()
}

/// 计算母语文本末尾的语言服务位置（最后一行、最后一列的 UTF-16 长度）
///
/// 用于生成覆盖整个文档的格式化文本编辑的范围终点。
函数 文末位置(内容值: &文本) -> JSON值 {
    让 行数 = 内容值.匹配('\n').计数() 作为 无符号长整数 + 1;
    让 末行 = 内容值.逆分割('\n').下一个().取值或("");
    让 列数: 无符号长整数 = 末行
        .逐字符()
        .映射(|字符值| 字符值.长度UTF16() 作为 无符号长整数)
        .求和();
    JSON序列化::JSON格式!({ "line": 行数 - 1, "character": 列数 })
}

/// 将增量变更（范围 + 文本）应用到母语文本
///
/// 语言服务位置按 UTF-16 编码单元计数；越界位置钳制到行尾/文末，
/// 防御客户端发来异常范围时崩溃。
函数 应用增量变更(内容值: &可变 字符串, 范围值: &JSON值, 文本串: &文本) {
    让 起始偏移 = 位置转偏移(内容值, &范围值["start"]);
    让 结束偏移 = 位置转偏移(内容值, &范围值["end"]).最大值(起始偏移);
    内容值.替换范围(起始偏移..结束偏移, 文本串);
}

/// 语言服务位置（行/字符，UTF-16）→ 文本字节偏移
///
/// 行号越界钳制到最后一行；列号越界钳制到行尾（含换行符前）。
函数 位置转偏移(内容值: &文本, 位置值: &JSON值) -> 无符号机器整数 {
    让 行号 = 位置值["line"].作为长整数().取值或(0) 作为 无符号整数;
    让 字符号 = 位置值["character"].作为长整数().取值或(0) 作为 无符号整数;
    让 换行位置表: 向量<无符号机器整数> = 内容值
        .匹配位置('\n')
        .映射(|(偏移值, _)| 偏移值)
        .收集();
    让 目标行 = 行号 作为 无符号机器整数;
    让 行首偏移 = 如果 目标行 == 0 {
        0
    } 否则 {
        匹配 换行位置表.获取(目标行 - 1) {
            有值(偏移值) => 偏移值 + 1,
            无 => 换行位置表
                .最后一个()
                .映射(|偏移值| 偏移值 + 1)
                .取值或(0),
        }
    };
    // 行内按 UTF-16 单元前进，列号用尽或到达行尾（不含换行符）即停
    让 行内文本 = &内容值[行首偏移..];
    让 可变 编码单元数 = 0u32;
    对于 (字节位置, 字符值) 在 行内文本.逐字符枚举() {
        如果 字符值 == '\n' || 编码单元数 >= 字符号 {
            返回 行首偏移 + 字节位置;
        }
        编码单元数 += 字符值.长度UTF16() 作为 无符号整数;
    }
    行首偏移 + 行内文本.长度()
}

/// 将语言服务位置从母语坐标转换为英文坐标
///
/// 当前翻译逐行替换关键字、行数保持不变（行映射为一一对应），
/// 因此仅列号需要按列偏移映射转换。
函数 位置转英文(条目值: &翻译条目, 位置值: &JSON值) -> JSON值 {
    让 行号 = 位置值["line"].作为长整数().取值或(0) 作为 无符号整数;
    让 列号 = 位置值["character"].作为长整数().取值或(0) 作为 无符号整数;
    // 调用方已持有条目：直接走无锁单函数，避免再按资源标识查缓存（多次加锁）
    让 英文列 = 包::翻译缓存::母语列转英文列(条目值, 行号, 列号);
    JSON序列化::JSON格式!({ "line": 行号, "character": 英文列 })
}

/// 将语言服务范围从母语坐标转换为英文坐标
函数 范围转英文(条目值: &翻译条目, 范围值: &JSON值) -> JSON值 {
    让 起点 = 位置转英文(条目值, &范围值["start"]);
    让 终点 = 位置转英文(条目值, &范围值["end"]);
    JSON序列化::JSON格式!({ "start": 起点, "end": 终点 })
}

/// 处理来自 rust-analyzer 的消息并转发给客户端
函数 处理分析器消息(
    消息值: &JSON值,
    映射器: &原子引用计数<响应映射器>,
    发送方: &跨梁通道::发送端<消息>,
    待处理表: &待处理请求表类型,
    回发发送端: &包::分析器::发送端,
    内置诊断: &内置诊断表类型,
) {
    如果让 有值(标识) = 消息值.读取条目("id").而后映射(|值| 值.转长整数()) {
        // 是响应
        让 原始信息 = {
            让 可变 请求表 = 匹配 待处理表.加锁() {
                成功(守卫) => 守卫,
                错误(_) => 返回,
            };
            请求表.移除(&标识)
        };

        如果让 有值(信息项) = 原始信息 {
            // rust-analyzer 返回错误时（如文件不存在），原样透传给客户端
            如果 消息值.读取条目("error").是否为有值() {
                让 错误值 = 消息值["error"].克隆值();
                让 响应值 = 语言服务器响应 {
                    标识号: 信息项.原始标识,
                    响应结果: 错误(语言服务器库::响应错误 {
                        代码: 错误值["code"].转长整数().取值或(-32603) 作为 整数,
                        消息文本: 错误值["message"]
                            .作为字符串()
                            .映射(字符串::从)
                            .解包或用否则(|| {
                                包::界面消息::全局界面().取消息("lsp_internal_error")
                            }),
                        附加数据: 错误值.读取条目("data").克隆副本(),
                    }),
                };
                让 _ = 发送方.发送(消息::语言服务器响应(响应值));
                返回;
            }

            让 结果值 = 消息值
                .读取条目("result")
                .克隆副本()
                .取值或(JSON值::空值节点);
            让 映射后数据 = 匹配 信息项.请求方法.作为文本切片() {
                "textDocument/completion" => {
                    映射器.映射补全响应(&结果值, &信息项.原始资源标识)
                }
                "textDocument/hover" => {
                    映射器.映射悬停响应(&结果值, &信息项.原始资源标识)
                }
                "textDocument/signatureHelp" => 映射器.映射签名帮助响应(&结果值),
                "textDocument/definition" => 映射器.映射定义响应(&结果值),
                "textDocument/references" => 映射器.映射引用响应(&结果值),
                "textDocument/documentSymbol" => {
                    映射器.映射文档符号响应(&结果值, &信息项.原始资源标识)
                }
                "textDocument/codeAction" => {
                    让 映射后 =
                        映射器.映射代码操作响应(&结果值, &信息项.原始资源标识);
                    // 未解析导入错误时注入“添加依赖”快捷修复（包管理器安装）
                    让 映射后 = 映射器
                        .注入添加依赖动作(&映射后, &信息项.未解析包名表);
                    // 教学诊断（全角标点/教学检查）注入一键修复动作
                    映射器.注入教学动作(
                        &映射后,
                        &信息项.教学诊断表,
                        &信息项.原始资源标识,
                    )
                }
                "codeAction/resolve" => 映射器.映射代码操作解析响应(&结果值),
                "textDocument/rename" => 映射器.映射重命名响应(&结果值),
                "textDocument/documentHighlight" => {
                    映射器.映射文档高亮响应(&结果值, &信息项.原始资源标识)
                }
                "textDocument/semanticTokens/full"
                | "textDocument/semanticTokens/range" => {
                    映射器.映射语义记号响应(&结果值, &信息项.原始资源标识)
                }
                _ => 结果值,
            };

            让 响应值 = 语言服务器响应 {
                标识号: 信息项.原始标识,
                响应结果: 成功(映射后数据),
            };
            让 _ = 发送方.发送(消息::语言服务器响应(响应值));
        } 否则 如果 消息值
            .读取条目("method")
            .而后映射(|值| 值.作为字符串())
            .是否为有值()
        {
            // 待映射表中没有对应记录：这是 rust-analyzer 主动发来的请求
            //（如配置、诊断刷新）。必须把响应回发给 rust-analyzer 本身，
            // 否则它会一直等待。
            让 方法名 = 消息值["method"].作为字符串().取值或("");
            让 结果值 = 如果 方法名 == "workspace/configuration" {
                让 条目数 = 消息值["params"]["items"]
                    .作为数组()
                    .映射(|数组值| 数组值.长度())
                    .取值或(0);
                分析器配置答复(条目数)
            } 否则 {
                JSON值::空值节点
            };
            让 响应值 = JSON序列化::JSON格式!({
                "jsonrpc": "2.0",
                "id": 标识,
                "result": 结果值
            });
            让 _ = 回发发送端.发送消息(&响应值);
        }
    } 否则 如果让 有值(方法名) =
        消息值.读取条目("method").而后映射(|值| 值.作为字符串())
    {
        // 是通知
        匹配 方法名 {
            "textDocument/publishDiagnostics" => {
                如果让 有值(参数值) = 消息值.读取条目("params") {
                    // 只转发虚拟母语文件的诊断：
                    // rust-analyzer 可能对其他项目文件发布诊断，
                    // 这些与母语代码无关，不应发给客户端。
                    让 诊断资源标识 = 参数值["uri"].作为字符串().取值或("");
                    如果 !映射器.是虚拟资源标识(诊断资源标识) {
                        返回;
                    }
                    让 可变 映射后 = 映射器.映射诊断(参数值);
                    // 合并全角标点教学诊断（方言坐标，与内置诊断同格式）：
                    // 全角标点在转译后的虚拟文本中保留，扫描结果经列映射
                    // 还原为方言坐标，随分析器发布链路同步下发——教学提示
                    // 与语法诊断共存，不因诊断全量替换而闪烁
                    让 可变 合并诊断: 向量<JSON值> = 映射后["diagnostics"]
                        .作为数组()
                        .映射(|数组值| 数组值.到向量())
                        .取值或默认();
                    让 合并资源标识 =
                        映射后["uri"].作为字符串().取值或("").转字符串();
                    如果让 有值(条目值) = 映射器.原始条目(&合并资源标识) {
                        // 分析器的编译错误在编译项目中抑制：编译级诊断
                        // 以代理自跑的镜像/虚拟项目检查（编译器口径）为准，
                        // 分析器在虚拟项目上对第三方依赖与过程宏的类型推断恒为
                        // 假红（详见 `抑制分析器编译错误` 的说明）
                        合并诊断.保留项(|诊断项| {
                            !包::响应映射::诊断文本::抑制分析器编译错误(
                                诊断项,
                                &条目值.原始路径,
                            )
                        });
                        // 教学诊断注入（全角标点 + 教学检查；移除旧注入保证最新）
                        包::响应映射::诊断文本::注入教学诊断(
                            &可变 合并诊断,
                            &条目值,
                            映射器.教学词分桶(),
                            映射器.歧义构造器词集(),
                            映射器.英文回落映射(),
                            映射器.关键词映射(),
                        );
                        映射后["diagnostics"] = JSON值::JSON数组(合并诊断.克隆值());
                    }
                    // 缓存映射后的内置诊断（方言坐标），供编译检查结果合并发布
                    如果让 成功(可变 守卫) = 内置诊断.加锁() {
                        守卫.置入(合并资源标识, 合并诊断);
                    }
                    让 通知项 = 通知消息 {
                        方法: 方法名.转字符串(),
                        请求参数: 映射后,
                    };
                    让 _ = 发送方.发送(消息::通知消息(通知项));
                }
            }
            _ => {
                让 通知项 = 通知消息 {
                    方法: 方法名.转字符串(),
                    请求参数: 消息值
                        .读取条目("params")
                        .克隆副本()
                        .取值或(JSON值::空值节点),
                };
                让 _ = 发送方.发送(消息::通知消息(通知项));
            }
        }
    }
}

/// 加载语言包：返回统一映射管理器（关键字/宏/派生/模块路径/别名全量）
///
/// 关键字与别名分离（与命令行统一管线对齐）：关键字在词法阶段无条件替换，
/// 标准库/第三方库标识符（别名）在词法转译后经声明位保护替换，
/// 避免用户声明与库别名撞名时被误替换（如 `让 新 = 5`）。
/// 模块路径映射随统一管线一并启用（使用语句路径段中文化）。
函数 载入语言包(语言包路径: &路径类型) -> 错误处理::结果<引擎库::映射管理器::映射管理器> {
    让 映射表路径 = 语言包路径.连接("映射表");
    如果 映射表路径.存在() {
        匹配 映射源::载入关键字映射(语言包路径) {
            成功(映射表) => {
                // 旧“映射表”目录格式：仅有扁平关键字表，宏/派生/模块路径/别名表为空
                返回 成功(引擎库::映射管理器::映射管理器::从扁表构造(
                    映射表,
                    哈希映射::新建(),
                    哈希映射::新建(),
                ));
            }
            错误(错误值) => 日志::警告!(
                "{}",
                包::界面消息::全局界面().取带参消息(
                    "lsp_log_mappings_fallback",
                    &[&错误值.转字符串()]
                )
            ),
        }
    }

    让 关键词路径 = 语言包路径.连接("keywords.toml");
    如果 关键词路径.存在() {
        // 复用引擎统一加载器（与命令行完全同源）：关键字/别名分离、
        // 标准库优先于第三方库、各包词表按文件名排序合并
        返回 引擎库::映射管理器::映射管理器::从目录载入(语言包路径).映射错误(
            |错误值| {
                错误处理::错误处理!(
                    "{}",
                    包::界面消息::全局界面().取带参消息(
                        "lsp_err_load_keywords",
                        &[&错误值.转字符串()]
                    )
                )
            },
        );
    }

    日志::警告!("{}", 包::界面消息::全局界面().取消息("lsp_warn_builtin_fallback"));
    // 语言包目录缺失时的回退：物化引擎编译期内嵌的完整中文语言包后
    // 走统一加载器（与命令行完全同源，含关键字/宏/别名全量）。
    // 不可再退回创建内置关键字映射：那是早期硬编码旧表
    //（54 个旧词、无宏表、无 `让` 等新关键字），会导致转译残缺——
    // 如 `打印行!` 不翻译报找不到宏、`让` 不翻译报语法错误。
    如果让 有值(管理器) = 载入内置中文回退() {
        返回 成功(管理器);
    }
    // 极端兜底：物化失败时退回硬编码旧表（可能残缺，但保证可启动）
    成功(引擎库::映射管理器::映射管理器::从扁表构造(
        映射源::创建内置关键字映射(),
        哈希映射::新建(),
        哈希映射::新建(),
    ))
}

/// 从引擎编译期内嵌的中文语言包物化出完整映射管理器
///
/// 将内嵌文件（关键字/标准库/模块路径/各包词表）写入临时目录，
/// 复用统一加载器，保证与磁盘语言包完全同源。
函数 载入内置中文回退() -> 选项<引擎库::映射管理器::映射管理器> {
    让 临时目录值 = 临时文件::建临时目录().转选项()?;
    让 中文目录 = 临时目录值.条目路径().连接("zh");
    标准库::文件系统::创建所有目录(&中文目录).转选项()?;
    对于 (文件名值, 内容值) 在 引擎库::语言::内置语言包文件("zh") {
        // 含子目录的文件（如各包词表）：逐级创建父目录
        如果让 有值(父级) = 路径类型::新建(文件名值).父目录()
            && !父级.作为系统串().是否为空()
        {
            标准库::文件系统::创建所有目录(中文目录.连接(父级)).转选项()?;
        }
        标准库::文件系统::写入(中文目录.连接(文件名值), 内容值).转选项()?;
    }
    引擎库::映射管理器::映射管理器::从目录载入(&中文目录).转选项()
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;
    使用 标准库::集合::哈希映射;

    /// 语言包目录缺失时的回退必须加载完整中文表（含宏与 `让` 等新关键字），
    /// 而非硬编码旧表——否则 `打印行!` 不翻译报找不到宏、
    /// `让` 不翻译报语法错误（真实事故：扩展未找到语言包目录时触发）
    #[测试]
    函数 语言包回退完整() {
        让 管理器 = 载入语言包(路径类型::新建("/不存在的目录")).期望("回退应成功");
        断言相等!(
            管理器.关键词表.读取条目("让").映射(字符串::作为文本切片),
            有值("let")
        );
        断言相等!(
            管理器.取派生特征表().读取条目("克隆").映射(字符串::作为文本切片),
            有值("Clone")
        );
        断言相等!(
            管理器.取宏表().读取条目("打印行").映射(字符串::作为文本切片),
            有值("println")
        );
        断言!(
            管理器.关键词表.长度() >= 100,
            "完整关键字表应 ≥100，实际 {}",
            管理器.关键词表.长度()
        );
        断言!(
            管理器.取宏表().长度() >= 30,
            "宏表应 ≥30，实际 {}",
            管理器.取宏表().长度()
        );
        断言!(!管理器.标识符别名.是否为空(), "别名表不应为空");
        断言!(!管理器.模块路径表.是否为空(), "模块路径表不应为空");
    }

    /// 默认扩展名列表覆盖全部内置语言包（引擎语言包目录单一来源），未知扩展名不匹配
    #[测试]
    函数 受支持文件默认扩展名() {
        让 扩展名表 = 默认扩展名();
        断言!(扩展名表.长度() >= 10, "内置语言包数量异常");
        断言!(是受支持文件("file:///project/src/main.zh", &扩展名表));
        断言!(是受支持文件("file:///project/src/main.de", &扩展名表));
        断言!(是受支持文件("file:///project/src/main.ru", &扩展名表));
        断言!(是受支持文件("file:///project/src/main.ja", &扩展名表));
        断言!(!是受支持文件("file:///project/src/main.rs", &扩展名表));
        断言!(!是受支持文件("file:///project/src/main.xyz", &扩展名表));
    }

    /// 自定义扩展名列表生效
    #[测试]
    函数 受支持文件自定义扩展名() {
        让 扩展名表 = 向量![".fr".转字符串()];
        断言!(是受支持文件("file:///project/src/main.fr", &扩展名表));
        断言!(!是受支持文件("file:///project/src/main.zh", &扩展名表));
    }

    函数 新建测试缓存() -> (原子引用计数<转译缓存>, 临时文件::临时目录句柄) {
        让 管理器 = 引擎库::映射管理器::映射管理器::从扁表构造(
            哈希映射::从([
                ("函数".转为(), "fn".转为()),
                ("让".转为(), "let".转为()),
                ("可变".转为(), "mut".转为()),
            ]),
            哈希映射::新建(),
            哈希映射::新建(),
        );
        让 临时目录值 = 临时文件::建临时目录().解包();
        让 缓存实例 = 转译缓存::新建(管理器, 临时目录值.条目路径().转路径缓冲());
        (缓存实例, 临时目录值)
    }

    #[测试]
    函数 位置转英文测试() {
        让 (缓存实例, _临时) = 新建测试缓存();
        让 (条目值, _) = 缓存实例
            .更新文档("file:///test/main.zh", "让 x = 1;", 1)
            .解包();
        断言相等!(条目值.英文内容, "let x = 1;");

        // 中文列 0（“让”起点）→ 英文列 0
        让 位置值 = JSON序列化::JSON格式!({ "line": 0, "character": 0 });
        让 英文位置 = 位置转英文(&条目值, &位置值);
        断言相等!(英文位置["line"], 0);
        断言相等!(英文位置["character"], 0);

        // 中文列 3（“x”末尾）→ 英文列 5（“让”为 1 个 UTF-16 单元，英文“让”占 3 列）
        让 位置值 = JSON序列化::JSON格式!({ "line": 0, "character": 3 });
        让 英文位置 = 位置转英文(&条目值, &位置值);
        断言相等!(英文位置["character"], 5);

        // 中文列 2（“x”起点）→ 英文列 4
        让 位置值 = JSON序列化::JSON格式!({ "line": 0, "character": 2 });
        让 英文位置 = 位置转英文(&条目值, &位置值);
        断言相等!(英文位置["character"], 4);
    }

    #[测试]
    函数 范围转英文测试() {
        让 (缓存实例, _临时) = 新建测试缓存();
        让 (条目值, _) = 缓存实例
            .更新文档("file:///test/main.zh", "让 x = 1;", 1)
            .解包();

        让 范围值 = JSON序列化::JSON格式!({
            "start": { "line": 0, "character": 2 },
            "end": { "line": 0, "character": 3 }
        });
        让 英文范围 = 范围转英文(&条目值, &范围值);
        断言相等!(英文范围["start"]["character"], 4);
        断言相等!(英文范围["end"]["character"], 5);
    }

    #[测试]
    函数 重命名全链路() {
        // 模拟完整闭环：中文请求 → 转换转发 → rust-analyzer 响应 → 映射回母语
        让 (缓存实例, _临时) = 新建测试缓存();
        让 映射器 = 响应映射器::新建(缓存实例.克隆值());
        让 (条目值, _) = 缓存实例
            .更新文档("file:///test/main.zh", "函数 主() {}", 1)
            .解包();
        断言相等!(条目值.英文内容, "fn 主() {}");

        // —— 请求方向（与转发请求相同的转换逻辑）——
        让 请求载荷 = JSON序列化::JSON格式!({
            "textDocument": { "uri": "file:///test/main.zh" },
            "position": { "line": 0, "character": 0 },
            "newName": "函数"
        });

        让 可变 参数值 = 请求载荷.克隆值();
        // 1. 资源标识替换为虚拟资源标识
        参数值["textDocument"]["uri"] = JSON值::字符串值(条目值.虚拟资源标识.克隆值());
        // 2. 位置转换为英文坐标
        参数值["position"] = 位置转英文(&条目值, &参数值["position"]);
        // 3. 新名中文 → 英文
        让 英文名 = 缓存实例.关键词映射().读取条目("函数").克隆副本().解包();
        参数值["newName"] = JSON值::字符串值(英文名);

        断言相等!(
            参数值["textDocument"]["uri"].作为字符串().解包(),
            条目值.虚拟资源标识
        );
        断言相等!(参数值["position"]["character"], 0);
        断言相等!(参数值["newName"].作为字符串().解包(), "fn");

        // —— 响应方向（rust-analyzer 返回虚拟文件编辑）——
        让 响应值 = JSON序列化::JSON格式!({
            "changes": {
                条目值.虚拟资源标识.克隆值(): [{
                    "range": {
                        "start": { "line": 0, "character": 0 },
                        "end": { "line": 0, "character": 2 }
                    },
                    "newText": "fn"
                }]
            }
        });
        让 映射后 = 映射器.映射重命名响应(&响应值);
        让 编辑项 = &映射后["changes"]["file:///test/main.zh"][0];

        // 客户端收到的编辑：资源标识还原、位置为母语坐标、新文本恢复中文
        断言相等!(编辑项["range"]["start"]["character"], 0);
        断言相等!(编辑项["range"]["end"]["character"], 2);
        断言相等!(编辑项["newText"].作为字符串().解包(), "函数");
    }

    #[测试]
    函数 文末位置测试() {
        // 空文档
        断言相等!(
            文末位置(""),
            JSON序列化::JSON格式!({ "line": 0, "character": 0 })
        );
        // 单行 ASCII
        断言相等!(
            文末位置("ab"),
            JSON序列化::JSON格式!({ "line": 0, "character": 2 })
        );
        // 中文按 UTF-16 计数（4 个汉字 = 4 个单元）
        断言相等!(
            文末位置("行\n中文测试"),
            JSON序列化::JSON格式!({ "line": 1, "character": 4 })
        );
        // 末尾换行：最后一行是空行
        断言相等!(
            文末位置("行\n"),
            JSON序列化::JSON格式!({ "line": 1, "character": 0 })
        );
    }

    #[测试]
    函数 位置转偏移测试() {
        让 文本串 = "让 可变 x = 5;\n让 y = 10;";
        // 首行中文列：「可变」起点（列 2）
        让 位置值 = JSON序列化::JSON格式!({ "line": 0, "character": 2 });
        断言相等!(位置转偏移(文本串, &位置值), "让 ".长度());
        // 第二行起点
        让 位置值 = JSON序列化::JSON格式!({ "line": 1, "character": 0 });
        断言相等!(位置转偏移(文本串, &位置值), "让 可变 x = 5;\n".长度());
        // 列号越界钳制到行尾（不含换行符）
        让 位置值 = JSON序列化::JSON格式!({ "line": 0, "character": 999 });
        断言相等!(位置转偏移(文本串, &位置值), "让 可变 x = 5;".长度());
        // 行号越界钳制到最后一行
        让 位置值 = JSON序列化::JSON格式!({ "line": 99, "character": 2 });
        断言相等!(
            位置转偏移(文本串, &位置值),
            "让 可变 x = 5;\n让 ".长度()
        );
    }

    #[测试]
    函数 应用增量变更测试() {
        // 中文行内插入
        让 可变 文本串 = "让 x = 5;".转字符串();
        让 范围值 = JSON序列化::JSON格式!({
            "start": { "line": 0, "character": 2 },
            "end": { "line": 0, "character": 2 }
        });
        应用增量变更(&可变 文本串, &范围值, "可变 ");
        断言相等!(文本串, "让 可变 x = 5;");

        // 跨行删除替换
        让 可变 文本串 = "行一\n行二\n行三".转字符串();
        让 范围值 = JSON序列化::JSON格式!({
            "start": { "line": 0, "character": 1 },
            "end": { "line": 1, "character": 1 }
        });
        应用增量变更(&可变 文本串, &范围值, "新");
        // 删除「一\n行」并插入「新」
        断言相等!(文本串, "行新二\n行三");

        // 异常范围（终点早于起点）不崩溃，退化为插入
        让 可变 文本串 = "abc".转字符串();
        让 范围值 = JSON序列化::JSON格式!({
            "start": { "line": 0, "character": 3 },
            "end": { "line": 0, "character": 1 }
        });
        应用增量变更(&可变 文本串, &范围值, "X");
        断言相等!(文本串, "abcX");
    }

    /// 从诊断列表提取未声明包候选：英文原文命中、保留名单过滤、
    /// 无关消息不命中、跨诊断去重
    #[测试]
    函数 从诊断提取未解析包名测试() {
        让 诊断表 = 向量![
            JSON序列化::JSON格式!({"message": "unresolved import `serde_json`"}),
            JSON序列化::JSON格式!({"message": "use of undeclared crate or module `reqwest`"}),
            JSON序列化::JSON格式!({"message": "unresolved import `std::collections`"}),
            JSON序列化::JSON格式!({"message": "unresolved import `crate::模块`"}),
            JSON序列化::JSON格式!({"message": "cannot find value `x` in this scope"}),
            JSON序列化::JSON格式!({"message": "unresolved import `serde_json`"}),
        ];
        断言相等!(
            从诊断提取未解析包名(&诊断表),
            向量!["serde_json".转字符串(), "reqwest".转字符串()]
        );

        // 无诊断 / 无匹配消息 → 空列表
        断言!(从诊断提取未解析包名(&[]).是否为空());
        让 其他诊断 = 向量![JSON序列化::JSON格式!({"message": "mismatched types"})];
        断言!(从诊断提取未解析包名(&其他诊断).是否为空());
    }

    /// 给 rust-analyzer 的配置答复：每条目固定三项关键配置，
    /// 数量与请求的条目对齐（数量错误会让分析器对部分工作区缺省）
    #[测试]
    函数 分析器配置答复形状() {
        让 空答复 = 分析器配置答复(0);
        断言相等!(空答复, JSON序列化::JSON格式!([]));
        让 答复值 = 分析器配置答复(2);
        让 数组值 = 答复值.作为数组().期望("应为数组");
        断言相等!(数组值.长度(), 2);
        对于 项 在 数组值 {
            断言相等!(项["completion"]["snippets"], JSON序列化::JSON格式!("custom"));
            断言相等!(项["checkOnSave"]["enable"], JSON序列化::JSON格式!(假));
            断言相等!(项["check"]["enable"], JSON序列化::JSON格式!(假));
        }
    }

    /// 是符号链接：不跟随末段链接——悬空链接仍是链接；普通文件/不存在路径为假
    ///
    /// 链接构造只在 Unix 上跑（Windows 建符号链接需开发者模式/管理员权限，
    /// 普通持续集成跑不上）；非链接分支三平台都测。
    #[测试]
    函数 是符号链接语义() {
        让 临时 = 临时文件::建临时目录().解包();
        让 文件值 = 临时.条目路径().连接("f");
        标准库::文件系统::写入(&文件值, b"x").解包();
        断言!(!是符号链接(&文件值));
        断言!(!是符号链接(&临时.条目路径().连接("absent")));

        #[配置(Unix系统)]
        {
            让 链接值 = 临时.条目路径().连接("link");
            标准库::操作系统::Unix系统::文件系统::符号链接(&文件值, &链接值).解包();
            断言!(是符号链接(&链接值));

            // 悬空符号链接（目标不存在）仍须识别为链接
            让 悬空值 = 临时.条目路径().连接("dangling");
            标准库::操作系统::Unix系统::文件系统::符号链接(
                临时.条目路径().连接("gone"),
                &悬空值,
            )
            .解包();
            断言!(是符号链接(&悬空值));
        }
    }

    /// 进程号探活：当前进程必然存活（残留目录清理依据，误判会误删活进程目录）
    #[测试]
    函数 进程存活自身() {
        断言!(进程存活(标准库::进程::进程号()));
    }

    /// 虚拟临时目录：按用户与进程号隔离命名、实际创建、同进程重复调用稳定同目录
    #[测试]
    函数 虚拟临时目录形状与稳定() {
        让 目录值 = 虚拟临时目录().期望("应能创建虚拟目录");
        断言!(目录值.是否为目录());
        让 名称值 = 目录值.文件名().解包().转有损字符串().转所有权();
        断言!(名称值.以开头("i18n_lsp_virtual_"), "实际：{名称值}");
        断言!(名称值.以结尾(&标准库::进程::进程号().转字符串()));
        让 再次目录 = 虚拟临时目录().期望("重复调用应幂等");
        断言相等!(再次目录, 目录值);
    }

    // ===== 处理分析器消息：消息分发的分支级单测 =====

    /// 分发装置返回的部件组：映射器、待处理表、客户端通道两端、
    /// 内置诊断、空分析器回发端、以及（缓存、临时目录、虚拟资源标识）
    类型 分发装置返回值 = (
        原子引用计数<响应映射器>,
        待处理请求表类型,
        跨梁通道::发送端<消息>,
        跨梁通道::接收端<消息>,
        内置诊断表类型,
        包::分析器::发送端,
        (原子引用计数<转译缓存>, 临时文件::临时目录句柄, 字符串),
    );

    /// 构造分发单测所需的全部部件
    函数 分发装置(源文本: &文本) -> 分发装置返回值 {
        让 (缓存实例, 临时目录值) = 新建测试缓存();
        让 (条目值, _) = 缓存实例
            .更新文档("file:///test/main.zh", 源文本, 1)
            .期望("测试文档应可入缓存");
        让 映射器 = 原子引用计数::新建(响应映射器::新建(缓存实例.克隆值()));
        让 待处理表 = 原子引用计数::新建(标准库::同步模块::互斥锁::新建(哈希映射::新建()));
        让 内置诊断 = 原子引用计数::新建(标准库::同步模块::互斥锁::新建(哈希映射::新建()));
        让 (发送端值, 接收端值) = 跨梁通道::无界通道();
        让 回发端 = 包::分析器::发送端::测试用空端();
        (
            映射器,
            待处理表,
            发送端值,
            接收端值,
            内置诊断,
            回发端,
            (缓存实例, 临时目录值, 条目值.虚拟资源标识.克隆值()),
        )
    }

    /// 登记一条转发请求记录
    函数 登记待处理请求(
        待处理表: &待处理请求表类型,
        分析器标识: 长整数,
        客户端标识: 整数,
        请求方法: &文本,
        资源标识: &文本,
    ) {
        待处理表.加锁().解包().置入(
            分析器标识,
            待处理请求信息 {
                原始标识: 语言服务器库::请求标识::从(客户端标识),
                请求方法: 请求方法.转字符串(),
                原始资源标识: 资源标识.转字符串(),
                创建时刻: 标准库::时间模块::瞬间::现在(),
                未解析包名表: 如果 请求方法 == "textDocument/codeAction" {
                    向量!["serde_json".转字符串()]
                } 否则 {
                    向量::新建()
                },
                教学诊断表: 向量::新建(),
            },
        );
    }

    /// 全部响应映射分支：空结果也必须安全通过各自映射器并应答到客户端，
    /// 原始客户端请求标识必须原样带回
    #[测试]
    函数 处理分析器响应方法分支() {
        让 (映射器, 待处理表, 发送端值, 接收端值, 内置诊断, 回发端, _装置) =
            分发装置("函数 主() {\n    打印行!();\n}\n");
        让 方法表 = [
            "textDocument/completion",
            "textDocument/hover",
            "textDocument/signatureHelp",
            "textDocument/definition",
            "textDocument/references",
            "textDocument/documentSymbol",
            "textDocument/codeAction",
            "codeAction/resolve",
            "textDocument/rename",
            "textDocument/documentHighlight",
            "textDocument/semanticTokens/full",
            "textDocument/semanticTokens/range",
            "textDocument/unknownFutureMethod",
        ];
        对于 (序号, 方法名) 在 方法表.迭代().枚举() {
            登记待处理请求(
                &待处理表,
                序号 作为 长整数 + 1,
                序号 作为 整数 + 100,
                方法名,
                "file:///test/main.zh",
            );
        }
        对于 序号 在 0..方法表.长度() {
            让 请求标识值 = 序号 作为 长整数 + 1;
            让 消息项 = JSON序列化::JSON格式!({
                "jsonrpc": "2.0",
                "id": 请求标识值,
                "result": JSON值::空值节点
            });
            处理分析器消息(&消息项, &映射器, &发送端值, &待处理表, &回发端, &内置诊断);
        }
        // 13 条全部应答（按发送顺序即为待处理表插入顺序）
        让 已收消息: 向量<消息> = 接收端值.尝试迭代().收集();
        断言相等!(已收消息.长度(), 方法表.长度());
        对于 (序号, 消息项) 在 已收消息.迭代().枚举() {
            匹配 消息项 {
                消息::语言服务器响应(响应值) => {
                    断言相等!(
                        响应值.标识号,
                        语言服务器库::请求标识::从(序号 作为 整数 + 100)
                    );
                    断言!(
                        !响应值.响应结果.是否为错误(),
                        "分支 {序号} 不应产生错误应答"
                    );
                }
                其他 => 恐慌!("期望响应消息，实际收到 {其他:?}"),
            }
        }
    }

    /// 分析器返回错误（如方法未知）：错误体原样透传给客户端，
    /// 缺省错误码归一为内部错误
    #[测试]
    函数 处理分析器错误透传() {
        让 (映射器, 待处理表, 发送端值, 接收端值, 内置诊断, 回发端, _装置) =
            分发装置("函数 主() {}\n");
        登记待处理请求(
            &待处理表,
            1,
            100,
            "textDocument/hover",
            "file:///test/main.zh",
        );
        让 消息项 = JSON序列化::JSON格式!({
            "jsonrpc": "2.0", "id": 1,
            "error": { "code": -32601, "message": "method not found" }
        });
        处理分析器消息(&消息项, &映射器, &发送端值, &待处理表, &回发端, &内置诊断);
        匹配 接收端值.接收().解包() {
            消息::语言服务器响应(响应值) => {
                断言相等!(响应值.标识号, 语言服务器库::请求标识::从(100));
                让 错误值 = 响应值.响应结果.期望错误("应透传错误");
                断言相等!(错误值.代码, -32601);
                断言相等!(错误值.消息文本, "method not found");
            }
            其他 => 恐慌!("期望响应消息：{其他:?}"),
        }
        // 缺错误码：归一内部错误；缺消息文本：用内置文案
        登记待处理请求(
            &待处理表,
            2,
            101,
            "textDocument/hover",
            "file:///test/main.zh",
        );
        让 消息项 = JSON序列化::JSON格式!({ "jsonrpc": "2.0", "id": 2, "error": {} });
        处理分析器消息(&消息项, &映射器, &发送端值, &待处理表, &回发端, &内置诊断);
        匹配 接收端值.接收().解包() {
            消息::语言服务器响应(响应值) => {
                让 错误值 = 响应值.响应结果.取错误值();
                断言相等!(错误值.代码, -32603);
                断言!(!错误值.消息文本.是否为空(), "缺消息文本应用内置文案");
            }
            其他 => 恐慌!("期望响应消息：{其他:?}"),
        }
    }

    /// 诊断发布：非虚拟资源标识丢弃；虚拟资源标识经映射后转发到母语资源标识，
    /// 并写入内置诊断缓存供编译检查合并
    #[测试]
    函数 处理分析器诊断路由() {
        让 (映射器, 待处理表, 发送端值, 接收端值, 内置诊断, 回发端, 装置值) =
            分发装置("函数 主() {\n    打印行!();\n}\n");
        让 (_缓存值, _临时值, 虚拟资源标识) = 装置值;

        // 非虚拟资源标识：直接丢弃，客户端收不到
        让 外来消息 = JSON序列化::JSON格式!({
            "jsonrpc": "2.0", "method": "textDocument/publishDiagnostics",
            "params": { "uri": "file:///other/project/src/main.rs", "diagnostics": [] }
        });
        处理分析器消息(&外来消息, &映射器, &发送端值, &待处理表, &回发端, &内置诊断);
        断言!(接收端值.是否为空(), "非虚拟文件诊断必须丢弃");

        // 虚拟资源标识：映射回母语资源标识并转发
        让 诊断项 = JSON序列化::JSON格式!({
            "range": {
                "start": { "line": 1, "character": 4 },
                "end": { "line": 1, "character": 12 }
            },
            "severity": 1,
            "source": "rust-analyzer",
            "message": "mismatched types",
            "code": "E0308"
        });
        让 虚拟消息 = JSON序列化::JSON格式!({
            "jsonrpc": "2.0", "method": "textDocument/publishDiagnostics",
            "params": { "uri": 虚拟资源标识, "diagnostics": [诊断项] }
        });
        处理分析器消息(&虚拟消息, &映射器, &发送端值, &待处理表, &回发端, &内置诊断);
        匹配 接收端值.接收().解包() {
            消息::通知消息(通知值) => {
                断言相等!(通知值.方法, "textDocument/publishDiagnostics");
                断言相等!(
                    通知值.请求参数["uri"].作为字符串(),
                    有值("file:///test/main.zh"),
                    "资源标识应还原为母语文件"
                );
                断言!(
                    !通知值.请求参数["diagnostics"].作为数组().解包().是否为空(),
                    "原始诊断应保留（非编译项目不抑制）"
                );
            }
            其他 => 恐慌!("期望通知消息：{其他:?}"),
        }
        // 内置诊断以母语资源标识为键缓存
        让 守卫 = 内置诊断.加锁().解包();
        让 缓存项 = 守卫.读取条目("file:///test/main.zh").期望("应缓存内置诊断");
        断言!(!缓存项.是否为空());
    }

    /// 其他通知（日志消息等）原样转发给客户端
    #[测试]
    函数 处理分析器其他通知转发() {
        让 (映射器, 待处理表, 发送端值, 接收端值, 内置诊断, 回发端, _装置) =
            分发装置("函数 主() {}\n");
        让 消息项 = JSON序列化::JSON格式!({
            "jsonrpc": "2.0", "method": "window/logMessage",
            "params": { "type": 3, "message": "indexed" }
        });
        处理分析器消息(&消息项, &映射器, &发送端值, &待处理表, &回发端, &内置诊断);
        匹配 接收端值.接收().解包() {
            消息::通知消息(通知值) => {
                断言相等!(通知值.方法, "window/logMessage");
                断言相等!(通知值.请求参数["message"].作为字符串(), 有值("indexed"));
            }
            其他 => 恐慌!("期望通知消息：{其他:?}"),
        }
    }

    /// 分析器主动请求（无待处理记录）：配置请求按请求项数构造结果回发给分析器
    ///（本用例空发送器发送失败被忽略，验证分发不崩溃且不会误转发给客户端）
    #[测试]
    函数 处理分析器主动请求回发() {
        让 (映射器, 待处理表, 发送端值, 接收端值, 内置诊断, 回发端, _装置) =
            分发装置("函数 主() {}\n");
        让 消息项 = JSON序列化::JSON格式!({
            "jsonrpc": "2.0", "id": 999, "method": "workspace/configuration",
            "params": { "items": [ {}, {} ] }
        });
        处理分析器消息(&消息项, &映射器, &发送端值, &待处理表, &回发端, &内置诊断);
        断言!(接收端值.是否为空(), "回发给分析器的响应不应出现在客户端通道");
        // 无方法名的杂讯（既非响应也非通知）：静默忽略
        让 杂讯 = JSON序列化::JSON格式!({ "jsonrpc": "2.0" });
        处理分析器消息(&杂讯, &映射器, &发送端值, &待处理表, &回发端, &内置诊断);
        断言!(接收端值.是否为空());
    }

    /// 超时清理：仅超过请求超时的条目被移除并主动应答超时错误；
    /// 新条目保留且不产生消息
    #[测试]
    函数 清理超时请求仅旧项() {
        让 (_映射器, 待处理表, 发送端值, 接收端值, _内置诊断, _回发端, _装置) =
            分发装置("函数 主() {}\n");
        // 新条目
        登记待处理请求(
            &待处理表,
            1,
            100,
            "textDocument/hover",
            "file:///test/main.zh",
        );
        // 过期条目
        {
            让 可变 请求表 = 待处理表.加锁().解包();
            请求表.获取可变(&1).解包().创建时刻 = 标准库::时间模块::瞬间::现在();
            请求表.置入(
                2,
                待处理请求信息 {
                    原始标识: 语言服务器库::请求标识::从(101),
                    请求方法: "textDocument/hover".转字符串(),
                    原始资源标识: "file:///test/main.zh".转字符串(),
                    创建时刻: 标准库::时间模块::瞬间::现在()
                        .检查减(请求超时 + 标准库::时间模块::持续时间::从秒(1))
                        .解包(),
                    未解析包名表: 向量::新建(),
                    教学诊断表: 向量::新建(),
                },
            );
        }
        清理超时请求(&待处理表, &发送端值);
        // 仅 1 条超时应答
        匹配 接收端值.尝试迭代().下一个() {
            有值(消息::语言服务器响应(响应值)) => {
                断言相等!(响应值.标识号, 语言服务器库::请求标识::从(101));
                断言相等!(响应值.响应结果.取错误值().代码, -32603);
            }
            其他 => 恐慌!("期望超时响应消息：{其他:?}"),
        }
        断言!(接收端值.是否为空(), "新条目不应产生应答");
        让 请求表 = 待处理表.加锁().解包();
        断言!(请求表.包含键(&1), "新条目必须保留");
        断言!(!请求表.包含键(&2), "过期条目必须移除");
    }

    /// 分析器崩溃重启：全部挂起请求排空，逐条收到“已重启”错误应答
    #[测试]
    函数 全部待处理失败应答排空() {
        让 (_映射器, 待处理表, 发送端值, 接收端值, _内置诊断, _回发端, _装置) =
            分发装置("函数 主() {}\n");
        登记待处理请求(
            &待处理表,
            1,
            100,
            "textDocument/hover",
            "file:///test/main.zh",
        );
        登记待处理请求(
            &待处理表,
            2,
            101,
            "textDocument/completion",
            "file:///test/main.zh",
        );
        全部待处理失败应答(&待处理表, &发送端值);
        断言!(待处理表.加锁().解包().是否为空(), "排空后表应为空");
        让 可变 标识表 = 向量::新建();
        当让 有值(消息::语言服务器响应(响应值)) = 接收端值.尝试迭代().下一个() {
            断言相等!(
                响应值.响应结果.作为引用方法().取错误值().消息文本,
                "rust-analyzer 已重启"
            );
            标识表.推入(响应值.标识号);
        }
        断言相等!(标识表.长度(), 2, "两个挂起请求都应被应答");
    }
}
