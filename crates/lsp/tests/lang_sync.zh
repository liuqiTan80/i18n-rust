//! LSP 启动时是否把界面语言同步给引擎（缺陷 C 回归）
//!
//! LSP 自己的 `lsp_*` 消息走 `crates/lsp/src/界面消息.rs` 的加载链，解析与代入落在
//! 引擎侧的 `crates/engine/src/界面消息.rs`；引擎的用户可见
//! 文本（Unicode 混淆 / 全角标点 / 教学检查 / 诊断模板）走 `语言::` 的**全局
//! 语言**。改前初始化只加载前者、从不调 `语言::设定语言`（CLI 在启动时
//! 同步），于是德语/俄文用户的编辑器里「界面消息是母语、引擎教学文本恒为中文」。
//!
//! 本文件单独成一个测试二进制：初始化写的是进程级全局（全局状态与 `语言::当前语言码`），
//! 不能与依赖默认语言的用例同进程并行。

使用 标准库::路径::路径缓冲;

使用 引擎库::混淆检测::检查混淆;
使用 引擎库::语言;

/// 按语言码定位引擎内置语言包目录（测试运行时当前目录为 `crates/lsp`）
函数 语言包目录(语言码: &文本) -> 路径缓冲 {
    让 清单目录 = 路径缓冲::从(标准库::编译环境::环境变量("CARGO_MANIFEST_DIR").期望("缺少 manifest 目录"));
    清单目录.等待线程(格式化!("../engine/lang-packs/{语言码}"))
}

/// 初始化必须同步引擎全局语言，并消除西里尔标识符的假告警
#[测试]
函数 初始化_同步引擎语言并消除母语文字假阳性() {
    // 俄文方言的合法源码：每个西里尔字母都命中同形异义表
    让 源码 = "функция главная() {\n    пусть количество = 5;\n}\n";

    // 钉住「全局语言 = zh」这一改前状态：此时同形判定照常报（不是检测坏了，
    // 而是 LSP 根本没把用户语言告诉引擎）
    语言::设定语言("zh");
    断言相等!(语言::当前语言(), "zh");
    断言!(
        !检查混淆(源码).为空(),
        "zh 语境下西里尔标识符应被判为同形异义（这正是 LSP 改前的实际状态）"
    );

    语言服务库::界面消息::设定全局(&语言包目录("ru"));

    断言相等!(
        语言::当前语言(),
        "ru",
        "init 应把命中的语言代码同步给引擎（改前从不调 设定语言）"
    );
    断言!(
        检查混淆(源码).为空(),
        "ru 语境下合法的西里尔标识符不该报同形异义，实际：{:?}",
        检查混淆(源码)
    );
    // 引擎模板也随语言切换：同一键在 ru 表里是俄文，不再恒为中文
    断言相等!(语言::取消息("unicode_cat_homoglyph"), "символ-омоглиф");
    // LSP 自己的消息表同一条链，界面语言与引擎语言不得分叉
    断言相等!(
        语言服务库::界面消息::全局界面().取消息("lsp_about"),
        "LSP-прокси-сервер i18n-rust"
    );
}

/// 语言代码与消息表由同一条链产出（`载入带语言` 纯函数入口，不碰全局）
#[测试]
函数 载入带语言_报告实际使用的语言() {
    让 (界面表, 语言码) = 语言服务库::界面消息::界面::载入带语言(&语言包目录("de"));
    断言相等!(语言码, "de", "显式语言包目录应按目录名登记语言");
    断言相等!(界面表.取消息("lsp_about"), "i18n-rust LSP-Proxy-Server");

    让 (界面表, 语言码) = 语言服务库::界面消息::界面::载入带语言(&语言包目录("zh"));
    断言相等!(语言码, "zh");
    断言相等!(界面表.取消息("lsp_about"), "i18n-rust LSP 代理服务器");

    // 目录里没有 `ui.toml` 时走目录名匹配内置包，语言代码同样要说清（改前这里
    // 只回消息表、语言代码无人知晓，两条链路就分叉了）
    让 (界面表, 语言码) =
        语言服务库::界面消息::界面::载入带语言(标准库::路径模块::路径类型::新建("/任意路径/ja"));
    断言相等!(语言码, "ja");
    断言!(
        !界面表.取消息("lsp_about").包含("LSP 代理服务器"),
        "ja 包的消息表不该回退成中文：{}",
        界面表.取消息("lsp_about")
    );
}
