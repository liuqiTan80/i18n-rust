//! 配套组件安装模块
//!
//! `rzc install` 安装 rzc 所需的配套组件。当前组件为语言服务器
//! i18n-rust-lsp（编辑器扩展的补全/诊断后端），与 rzc 属于不同
//! 包，常规安装不会自动带上，需单独安装。
//!
//! 安装来源优先级：
//! 1. 与 rzc 同目录的可执行文件（离线发布包自带，免网络直接复制到工具目录）
//! 2. 远端包仓库（安装语言服务器，版本与 rzc 严格一致，
//!    保证协议与语言包版本兼容）

使用 标准库::路径::{路径类型, 路径缓冲};
使用 标准库::进程::命令;

使用 包::界面::界面消息表;
使用 标准库::输入输出::读取特征;

使用 包::语言管理::{
    全部可用扩展名, 全局语言包, 全局语言包子目录名, 全局语言目录, 扫描全局语言包,
    静态扩展名映射, 获取内置元数据,
};

/// 语言服务器可执行文件名（对应语言服务包的包名）
常量 语言服务程序名: &文本 = "i18n-rust-lsp";

/// 当前平台可执行文件后缀（Windows 为可执行后缀，其余为空）
常量 程序后缀: &文本 = 标准库::环境::平台常量::可执行后缀;

/// 工具程序目录：工具主目录下的程序目录，未设置时回退用户主目录下的默认位置
函数 货物程序目录() -> 路径缓冲 {
    如果让 成功(主目录) = 标准库::环境::环境变量("CARGO_HOME")
        && !主目录.是否为空()
    {
        返回 路径缓冲::从(主目录).连接("bin");
    }
    // HOME（Unix）优先，USERPROFILE（Windows）回退，保证跨平台目录正确
    让 主目录 = 标准库::环境::环境变量("HOME")
        .或用否则(|_| 标准库::环境::环境变量("USERPROFILE"))
        .解包或用否则(|_| ".".转字符串());
    路径缓冲::从(主目录).连接(".cargo").连接("bin")
}

/// 安装语言服务器 i18n-rust-lsp
///
/// 优先使用与 rzc 同目录的可执行文件（离线包场景）；否则通过
/// 包管理器从远端包仓库安装，保证与 rzc 版本严格一致。
///
/// 已安装时先校验版本：与 rzc 一致则提示已安装；不一致或无法确认时
/// 引导用户执行 `--force` 重装（不自动覆盖，避免打断正在使用的语言服务进程）。
公开 函数 安装语言服务(界面表: &界面消息表, 强制: 布尔) -> 错误处理::结果<空> {
    让 目标路径 = 货物程序目录().连接(格式化!("{语言服务程序名}{程序后缀}"));
    如果 目标路径.是否为文件() && !强制 {
        匹配 核对语言服务版本(读取已装语言服务版本(&目标路径), 编译环境!("CARGO_PKG_VERSION")) {
            版本核对::一致 => {
                打印行!(
                    "{}",
                    界面表.取带参消息("lsp_install_already", &[&目标路径.展示().转字符串()])
                );
            }
            版本核对::不一致(已装版本) => {
                打印行!(
                    "{}",
                    界面表.取带参消息(
                        "lsp_install_version_mismatch",
                        &[&已装版本, 编译环境!("CARGO_PKG_VERSION")]
                    )
                );
            }
            版本核对::未知 => {
                打印行!(
                    "{}",
                    界面表.取带参消息(
                        "lsp_install_version_unknown",
                        &[&目标路径.展示().转字符串()]
                    )
                );
            }
        }
        返回 成功(());
    }

    // 1. 离线发布包：与 rzc 同目录附带同名可执行文件，直接复制（无需网络）
    如果让 成功(可执行路径) = 标准库::环境::当前可执行文件()
        && 让 有值(所在目录) = 可执行路径.父目录()
    {
        让 本地路径 = 所在目录.连接(格式化!("{语言服务程序名}{程序后缀}"));
        如果 本地路径.是否为文件() {
            从本地安装(界面表, &本地路径, &目标路径)?;
            返回 成功(());
        }
    }

    // 2. 远端包仓库：版本与 rzc 精确一致
    从包仓库安装(界面表, &目标路径)?;
    成功(())
}

/// 从本地路径复制到工具程序目录
函数 从本地安装(界面表: &界面消息表, 本地路径: &路径类型, 目标路径: &路径类型) -> 错误处理::结果<空> {
    让 程序目录 = 目标路径
        .父目录()
        .缺值转错(|| 错误处理::错误处理!("{}", 界面表.取带参消息("lsp_install_failed", &["无有效安装目录"])))?;
    标准库::文件系统::递归创建目录(程序目录)
        .映射错误(|错误值| 错误处理::错误处理!("{}", 界面表.取带参消息("lsp_install_failed", &[&错误值.转字符串()])))?;
    标准库::文件系统::复制文件(本地路径, 目标路径)
        .映射错误(|错误值| 错误处理::错误处理!("{}", 界面表.取带参消息("lsp_install_failed", &[&错误值.转字符串()])))?;
    打印行!(
        "{}",
        界面表.取带参消息("lsp_install_local", &[&目标路径.展示().转字符串()])
    );
    成功(())
}

/// 通过包管理器从远端包仓库安装
函数 从包仓库安装(界面表: &界面消息表, 目标路径: &路径类型) -> 错误处理::结果<空> {
    让 版本值 = 编译环境!("CARGO_PKG_VERSION");
    打印行!("{}", 界面表.取带参消息("lsp_install_cargo", &[版本值]));
    让 状态值 = 命令::新建(包::解析cargo())
        .单参数("install")
        .单参数(语言服务程序名)
        .单参数("--version")
        .单参数(格式化!("={版本值}"))
        .进程状态()
        .映射错误(|错误值| 错误处理::错误处理!("{}", 界面表.取带参消息("lsp_install_no_cargo", &[&错误值.转字符串()])))?;
    如果 !状态值.退出成功() {
        错误处理::错误中止!("{}", 界面表.取带参消息("lsp_install_failed", &[&状态值.转字符串()]));
    }
    // 包管理器默认输出到工具主目录下的程序目录，与目标路径一致
    打印行!("{}", 界面表.取带参消息("lsp_install_done", &[版本值]));
    打印行!(
        "{}",
        界面表.取带参消息("lsp_install_hint", &[&目标路径.展示().转字符串()])
    );
    成功(())
}

/// 已安装版本与期望版本的比较结果
#[派生(可调试, 部分相等, 全等)]
枚举 版本核对 {
    /// 版本一致
    一致,
    /// 版本不一致（附已安装版本号）
    不一致(字符串),
    /// 无法确定已安装版本
    未知,
}

/// 比较已安装语言服务器版本与期望版本（纯函数，便于测试）
函数 核对语言服务版本(已装版本: 选项<字符串>, 期望版本: &文本) -> 版本核对 {
    匹配 已装版本 {
        有值(版本值) 如果 版本值 == 期望版本 => 版本核对::一致,
        有值(版本值) => 版本核对::不一致(版本值),
        无 => 版本核对::未知,
    }
}

/// 读取已安装语言服务器的版本号（`i18n-rust-lsp --version` 输出纯版本号）
///
/// 可执行文件不存在、执行失败（如被占用）或输出为空时返回空值。
函数 读取已装语言服务版本(目标路径: &路径类型) -> 选项<字符串> {
    让 输出值 = 命令::新建(目标路径).单参数("--version").取输出().转选项()?;
    如果 !包::界面::命令成功(&输出值) {
        返回 空值;
    }
    让 版本值 = 字符串::从utf8宽松(&输出值.标准输出).裁剪().转字符串();
    如果 版本值.是否为空() {
        空值
    } 否则 {
        有值(版本值)
    }
}

// ============================================================
// 内置工具链（独立编译器/包管理器/语言分析器）
// ============================================================

/// 语言分析器官方发布标签（随官方发布升级；可用 `--ra-tag` 覆盖）
公开 常量 语言服务发布标签: &文本 = "2026-08-24";

/// 当前平台的目标三元组（官方分发与语言分析器发布资产名用）
///
/// 不支持的平台返回错误而非恐慌，由调用方以本地化提示终止（避免崩溃式退出）。
函数 目标三元组() -> 错误处理::结果<静态字符串引用> {
    匹配 (标准库::环境::平台常量::操作系统名, 标准库::环境::平台常量::架构名) {
        ("windows", "x86_64") => 成功("x86_64-pc-windows-msvc"),
        ("linux", "x86_64") => 成功("x86_64-unknown-linux-gnu"),
        ("macos", "aarch64") => 成功("aarch64-apple-darwin"),
        ("macos", "x86_64") => 成功("x86_64-apple-darwin"),
        (系统值, 架构值) => 错误处理::错误中止!("不支持的平台 {系统值}/{架构值}（内置工具链暂未覆盖）"),
    }
}

/// 安装内置工具链（独立编译器/包管理器/语言分析器）到用户工具链目录
///
/// 编译器与包管理器来自官方分发（含全套组件）；
/// 语言分析器来自官方发布（下载失败不阻塞——可稍后补装）。
/// `仅分析器` 为真时仅升级语言分析器（跳过编译器与包管理器的三百兆重下）。
/// 安装后 rzc 与语言服务优先使用内置工具链，不再依赖工具链管理器与 PATH 配置。
公开 函数 安装工具链(
    界面表: &界面消息表,
    版本值: &文本,
    分析器标签: &文本,
    强制: 布尔,
    仅分析器: 布尔,
) -> 错误处理::结果<空> {
    使用 引擎库::工具链::{安装根目录, 工具链程序目录};

    让 程序目录 = 工具链程序目录();
    如果 仅分析器 {
        返回 仅安装语言分析器(界面表, 分析器标签, &程序目录);
    }

    让 编译器路径 = 程序目录.连接(格式化!("rustc{程序后缀}"));
    如果 编译器路径.是否为文件() && !强制 {
        打印行!(
            "{}",
            界面表.取带参消息("tc_install_already", &[&程序目录.展示().转字符串()])
        );
        返回 成功(());
    }

    让 三元组 = 目标三元组()?;
    让 临时 = 临时文件::建临时目录()?;

    // 1. 编译器与包管理器独立包（官方分发单包含全部组件）
    让 地址 = 格式化!("https://static.rust-lang.org/dist/rust-{版本值}-{三元组}.tar.gz");
    打印行!("{}", 界面表.取带参消息("tc_download_rustc", &[&地址]));
    让 归档路径 = 临时.条目路径().连接("rust.tar.gz");
    下载到(&地址, &归档路径)?;
    // 校验官方摘要（官方分发提供摘要文件）
    // 缺失即停：校验和缺失/格式非法时直接中止，绝不静默放行
    让 摘要地址 = 格式化!("{地址}.sha256");
    让 期望值 = 下载文本(&摘要地址)?
        .分割空白()
        .下一个()
        .解包或用("")
        .转字符串();
    让 摘要有效 = 期望值.长度() == 64
        && 期望值.逐字符().全部(|本字| "0123456789abcdef".包含(本字.转ASCII小写()));
    如果 !摘要有效 {
        错误处理::错误中止!("编译器包摘要校验和不可用（{摘要地址} 返回异常内容），已中止下载");
    }
    让 实际值 = 文件摘要(&归档路径)?;
    如果 实际值 != 期望值 {
        错误处理::错误中止!("编译器包摘要校验失败（下载可能被篡改，请重试）");
    }
    打印行!("{}", 界面表.取消息("tc_extracting"));
    解压归档包(&归档路径, 临时.条目路径())?;
    让 根目录 = 临时.条目路径().连接(格式化!("rust-{版本值}-{三元组}"));
    标准库::文件系统::递归创建目录(&程序目录)?;
    复制程序目录(&根目录.连接("rustc").连接("bin"), &程序目录, 强制)?;
    复制程序目录(&根目录.连接("cargo").连接("bin"), &程序目录, 强制)?;
    // 覆盖安装后做一次冒烟校验：文件在但不可执行（半截覆盖/平台不匹配）
    // 不能写版本号冒充成功
    让 版本可用 = 命令::新建(&编译器路径)
        .单参数("--version")
        .取输出()
        .映射(|输出值| 输出值.进程状态.退出成功())
        .取值或(假);
    如果 !版本可用 {
        错误处理::错误中止!(
            "工具链安装后校验失败：{} --version 未成功（若为覆盖安装，请关闭正在使用该工具链的进程后重试）",
            编译器路径.展示()
        );
    }

    // 2. 语言分析器（官方发布的压缩资产：类 Unix 为压缩流、Windows 为压缩包；
    //    失败不阻塞主流程，但已下载的可执行文件必须通过摘要校验，未经验证绝不落盘）
    匹配 下载语言分析器(分析器标签, 三元组, &程序目录, 临时.条目路径()) {
        成功(()) => 打印行!("{}", 界面表.取带参消息("tc_ra_installed", &[分析器标签])),
        错误(错误值) => 打印行!("{}", 界面表.取带参消息("tc_ra_skipped", &[&错误值.转字符串()])),
    }

    // 3. 记录版本
    让 工具链目录 = 安装根目录().连接("toolchain");
    标准库::文件系统::递归创建目录(&工具链目录)?;
    标准库::文件系统::写入(工具链目录.连接("version.txt"), 版本值)?;
    打印行!(
        "{}",
        界面表.取带参消息("tc_install_done", &[&程序目录.展示().转字符串()])
    );
    成功(())
}

/// 仅升级语言分析器（跳过编译器与包管理器的三百兆重下）
函数 仅安装语言分析器(界面表: &界面消息表, 分析器标签: &文本, 程序目录: &路径类型) -> 错误处理::结果<空> {
    // 首次运行时工具链程序目录可能不存在，须先创建（否则解压后重命名报错）
    标准库::文件系统::递归创建目录(程序目录)?;
    让 三元组 = 目标三元组()?;
    让 临时 = 临时文件::建临时目录()?;
    下载语言分析器(分析器标签, 三元组, 程序目录, 临时.条目路径())?;
    打印行!("{}", 界面表.取带参消息("tc_ra_installed", &[分析器标签]));
    成功(())
}

/// 下载并安装语言分析器（官方发布的压缩资产，带摘要校验）
///
/// 资产命名：类 Unix 为压缩流、Windows 为压缩包，
/// 官方不发布裸可执行资产（旧代码直接下载裸名会失败，从未安装成功）。
/// 完整性校验：官方未发布独立摘要文件，摘要由远端接口的
/// 资产列表提供；校验失败（篡改）或摘要不可用（接口限流）均抛错中止，
/// 不做「未验证降级安装」——后者会让阻断接口请求成为绕过完整性校验的手段。
函数 下载语言分析器(
    分析器标签: &文本,
    三元组: &文本,
    程序目录: &路径类型,
    临时目录: &路径类型,
) -> 错误处理::结果<空> {
    让 是视窗 = 标准库::环境::平台常量::操作系统名 == "windows";
    让 资产名 = 如果 是视窗 {
        格式化!("rust-analyzer-{三元组}.zip")
    } 否则 {
        格式化!("rust-analyzer-{三元组}.gz")
    };
    让 地址 = 格式化!(
        "https://github.com/rust-lang/rust-analyzer/releases/download/{分析器标签}/{资产名}"
    );
    让 分析器目标 = 程序目录.连接(格式化!("rust-analyzer{程序后缀}"));

    // 下载压缩资产
    让 压缩路径 = 临时目录.连接("rust-analyzer.asset");
    下载到(&地址, &压缩路径)?;

    // 完整性校验：官方接口的摘要字段（无独立摘要文件）。
    // 摘要不可用时**中止安装**：跳过校验等于放弃完整性保证，而让接口
    // 不可达（限流、域名系统或中间人劫持）比篡改发布资产容易得多，若此时仍安装，
    // 攻击者只需阻断一次接口请求即可让任意可执行文件被装入并随后运行。
    让 期望值 = 分析器资产摘要(分析器标签, &资产名).缺值转错(|| {
        错误处理::错误处理!(
            "无法获取语言分析器官方摘要（资产 {资产名}，标签 {分析器标签}）：\
             远端接口可能限流或网络不可达。为避免安装未经验证的可执行文件已中止，请稍后重试"
        )
    })?;
    让 实际值 = 文件摘要(&压缩路径)?;
    如果 实际值 != 期望值 {
        让 _ = 标准库::文件系统::删除文件(&压缩路径);
        错误处理::错误中止!("语言分析器包摘要校验失败（下载可能被篡改）");
    }

    // 解压到目标目录
    如果 是视窗 {
        提取压缩包条目(&压缩路径, &分析器目标)?;
    } 否则 {
        让 压缩数据 = 标准库::文件系统::读取(&压缩路径)?;
        让 解压流 = 数据压缩::读取::解压读取器::新建(标准库::输入输出::游标::新建(压缩数据));
        让 可变 解压流变量 = 解压流;
        让 可变 解压内容 = 向量::新建();
        解压流变量.读取全部(&可变 解压内容)?;
        标准库::文件系统::写入(&分析器目标, &解压内容)?;
    }
    // 类 Unix 平台确保可执行权限
    #[配置(Unix系统)]
    {
        使用 标准库::操作系统模块::Unix系统::文件系统::权限扩展;
        使用 标准库::文件系统::权限;
        让 _ = 标准库::文件系统::设置权限(&分析器目标, 权限::从模式(0o755));
    }
    成功(())
}

/// 从远端接口获取指定发布资产的摘要值（官方未发布独立摘要文件）
函数 分析器资产摘要(标签: &文本, 资产名: &文本) -> 选项<字符串> {
    让 地址 = 格式化!("https://api.github.com/repos/rust-lang/rust-analyzer/releases/tags/{标签}");
    让 响应值 = 轻量HTTP客户端::获取(&地址)
        .头部("User-Agent", "rzc-install")
        .取配置()
        .整体限时(有值(标准库::时间模块::持续时间::从秒(30)))
        .构建()
        .发出请求()
        .转选项()?;
    让 响应文本 = 响应值.转入主体().读取全部字符串().转选项()?;
    让 值项: JSON序列化::JSON值 = JSON序列化::解析字符串(&响应文本).转选项()?;
    让 资产们 = 值项.获取("assets")?.作为数组()?;
    对于 资产项 在 资产们 {
        如果 资产项.获取("name").而后映射(|名称值| 名称值.作为文本切片()) == 有值(资产名) {
            返回 资产项
                .获取("digest")
                .而后映射(|摘要值| 摘要值.作为文本切片())
                .而后映射(|摘要文本| 摘要文本.去前缀("sha256:"))
                .映射(|摘要文本| 摘要文本.转字符串());
        }
    }
    空值
}

/// 解压压缩包中的第一个条目到目标文件（语言分析器的 Windows 资产为单文件压缩包）
函数 提取压缩包条目(压缩包路径: &路径类型, 目标文件: &路径类型) -> 错误处理::结果<空> {
    让 压缩数据 = 标准库::文件系统::读取(压缩包路径)?;
    让 文件游标 = 标准库::输入输出::游标::新建(压缩数据);
    让 可变 归档 = 拉链::压缩包归档::新建(文件游标)?;
    让 可变 条目值 = 归档.按序号(0)?;
    让 可变 条目内容 = 向量::新建();
    条目值.读取全部(&可变 条目内容)?;
    标准库::文件系统::写入(目标文件, &条目内容)?;
    成功(())
}

/// 轻量客户端流式下载到文件（大文件不驻留内存）
函数 下载到(地址: &文本, 目标文件: &路径类型) -> 错误处理::结果<空> {
    让 响应值 = 轻量HTTP客户端::获取(地址)
        .取配置()
        .整体限时(有值(标准库::时间模块::持续时间::从秒(600)))
        .构建()
        .发出请求()
        .映射错误(|错误值| 错误处理::错误处理!("下载失败: {错误值}"))?;
    让 可变 读取器 = 响应值.转入主体().转入读取器();
    让 可变 内容 = 向量::新建();
    读取器.读取全部(&可变 内容)?;
    标准库::文件系统::写入(目标文件, &内容)?;
    成功(())
}

/// 轻量客户端下载文本内容（如官方摘要校验文件）
函数 下载文本(地址: &文本) -> 错误处理::结果<字符串> {
    让 响应值 = 轻量HTTP客户端::获取(地址)
        .取配置()
        .整体限时(有值(标准库::时间模块::持续时间::从秒(60)))
        .构建()
        .发出请求()
        .映射错误(|错误值| 错误处理::错误处理!("下载失败: {错误值}"))?;
    响应值
        .转入主体()
        .读取全部字符串()
        .映射错误(|错误值| 错误处理::错误处理!("读取失败: {错误值}"))
}

/// 计算文件摘要（十六进制小写）
函数 文件摘要(路径值: &路径类型) -> 错误处理::结果<字符串> {
    使用 SHA2哈希::{摘要算法, SHA256哈希};
    让 数据项 = 标准库::文件系统::读取(路径值)?;
    让 可变 摘要器 = SHA256哈希::新建();
    摘要器.追加输入(&数据项);
    成功(格式化!("{:x}", 摘要器.完成摘要()))
}

/// 解压归档包到目标目录（归档库默认拒绝 `..` 与绝对路径，路径安全）
函数 解压归档包(归档路径: &路径类型, 目标目录: &路径类型) -> 错误处理::结果<空> {
    让 压缩数据 = 标准库::文件系统::读取(归档路径)?;
    让 解压流 = 数据压缩::读取::解压读取器::新建(标准库::输入输出::游标::新建(压缩数据));
    让 可变 归档 = 归档读取库::归档读取器::新建(解压流);
    归档.解包到(目标目录)?;
    成功(())
}

/// 复制目录内全部文件到目标目录（`覆盖` 为假时跳过已存在文件，避免覆盖冲突）
函数 复制程序目录(
    来源目录: &路径类型,
    目标目录: &路径类型,
    覆盖: 布尔,
) -> 错误处理::结果<空> {
    对于 条目值 在 标准库::文件系统::读取目录(来源目录)? {
        让 条目值 = 条目值?;
        让 目标路径 = 目标目录.连接(条目值.取文件名());
        如果 目标路径.是否为文件() && !覆盖 {
            继续;
        }
        标准库::文件系统::复制文件(条目值.条目路径(), &目标路径)?;
    }
    成功(())
}

/// 环境诊断：rzc / 内置工具链 / 环境工具链 / 版本对比
公开 函数 诊断环境() -> 错误处理::结果<空> {
    使用 引擎库::工具链::{工具链程序目录, 已安装版本, 锁定版本};

    打印行!("=== rzc doctor ===");
    打印行!("rzc: {}", 编译环境!("CARGO_PKG_VERSION"));

    让 程序目录 = 工具链程序目录();
    让 内置版本 = 已安装版本();
    匹配 &内置版本 {
        有值(版本值) => 打印行!("内置工具链: {}（{}）", 版本值, 程序目录.展示()),
        无 => {
            打印行!("内置工具链: 未安装（可执行 rzc install toolchain 一键安装，脱离工具链管理器）")
        }
    }

    对于 行值 在 组件状态行(&程序目录) {
        打印行!("{行值}");
    }

    // 编辑器链路：语言服务器版本可能落后于 rzc（旧包仓库版本或旧拷贝）
    如果让 有值(来源项) = 定位组件(语言服务程序名, &程序目录) {
        让 版本值 = 命令::新建(来源项.取路径())
            .单参数("--version")
            .取输出()
            .转选项()
            .映射(|输出值| 字符串::从utf8宽松(&输出值.标准输出).转字符串());
        如果让 有值(行值) = 语言服务版本行(版本值.作为解引用(), 编译环境!("CARGO_PKG_VERSION")) {
            打印行!("{行值}");
        }
    }

    // 语言包健康检查：遮蔽/备份遗留/身份不符只在用户环境发生，静态门检查不出
    让 语言根 = 全局语言目录();
    让 健康行们 = 语言包健康行(
        &扫描全局语言包(),
        &全局语言包子目录名(),
    );
    打印行!();
    打印行!("语言包: {}", 语言根.展示());
    如果 健康行们.是否为空() {
        打印行!("  全局语言包: 无遮蔽风险（未安装用户级语言包，或均与内置不冲突）");
    } 否则 {
        对于 行值 在 健康行们 {
            打印行!("{行值}");
        }
    }

    如果让 有值(版本值) = 内置版本.作为解引用()
        && 版本值 != 锁定版本
    {
        打印行!(
            "提示: 内置工具链 {} 与锁定版本 {} 不一致（rzc install toolchain --force 更新）",
            版本值, 锁定版本
        );
    }
    打印行!(
        "升级内置工具链：rzc install toolchain --version <新版本> --force（当前锁定 {}）",
        锁定版本
    );

    // 项目入口自检：在项目里跑诊断命令时，把「直接构建撞无目标」
    // 这条墙提前看得见（判定与 rzc run/check 的阻断同源）
    让 项目根 = 标准库::环境::当前目录()
        .转选项()
        .而后映射(|当前值| 包::向上查找项目根(&当前值));
    打印行!();
    匹配 项目根 {
        有值(根路径) => {
            打印行!("项目: {}", 根路径.展示());
            让 健康行们 =
                项目入口健康行(&根路径, &全部可用扩展名());
            如果 健康行们.是否为空() {
                打印行!("  包管理器可读入口: 正常");
            } 否则 {
                对于 行值 在 健康行们 {
                    打印行!("{行值}");
                }
            }
        }
        无 => 打印行!("项目: 当前目录不在包管理项目内（未找到 Cargo.toml，跳过入口自检）"),
    }
    成功(())
}

/// 项目入口自检状态行（纯函数，便于测试）
///
/// 把「直接构建撞清单无目标」这条墙从「读得懂编译器原文」降级为「提前看得见」：
/// 在项目里跑 `rzc doctor` 就能看见缺哪个入口产物、该跑哪条命令补上。
/// 构建目标判定沿用 [`包::有货物目标`]，与 `rzc run`/`rzc check` 的阻断同一口径，不许分叉。
///
/// 报三类：
/// - 包管理器读不到任何构建目标：点名源码目录下的方言源文件，给出该先跑的
///   `rzc check <入口候选>`；源码目录里连方言文件都没有时提示 `rzc init`；
/// - 主程序与库同项目只生成了主程序产物：库源在、库产物不在、
///   清单又没声明库目标，提示用库之前先检查一次库；
/// - 工作区根：虚拟清单本就没有构建目标，跳过而不报「缺入口」。
函数 项目入口健康行(项目根: &路径类型, 扩展名们: &[字符串]) -> 向量<字符串> {
    让 可变 行们 = 向量::新建();
    如果 !项目根.连接("Cargo.toml").是否为文件() {
        返回 行们;
    }
    如果 清单为工作区(项目根) {
        行们.推入(
            "  这是工作区根（虚拟清单，本身没有构建目标）：进成员目录再跑 doctor".转字符串(),
        );
        返回 行们;
    }
    让 源文件们 = 源目录方言源(项目根, 扩展名们);
    如果 !包::有货物目标(项目根) {
        如果 源文件们.是否为空() {
            行们.推入("  ⚠ 包管理器读不到任何构建目标，源码目录下也没有方言源文件".转字符串());
            行们.推入("    → rzc init <项目名> 建骨架，或写一个 src/main.<语言>".转字符串());
            返回 行们;
        }
        行们.推入(格式化!(
            "  ⚠ 项目有 {} 个方言源文件，但包管理器读不到任何构建目标（src/main.rs、src/lib.rs 都不存在）",
            源文件们.元素数()
        ));
        行们.推入(格式化!(
            "    方言源文件: {}",
            源文件们
                .迭代器()
                .取值(5)
                .克隆副本()
                .收集::<向量<_>>()
                .连接(", ")
        ));
        让 入口值 = 入口候选(&源文件们);
        行们.推入(格式化!(
            "    → 先跑 `rzc check {入口值}` 生成入口产物；此刻直接构建会报 `no targets specified in the manifest`"
        ));
        返回 行们;
    }
    // 库源在、库产物不在，且清单没声明库目标（含库路径时包管理器直接认库目标）
    让 有值(库源) = 源文件们
        .迭代器()
        .查找(|相对值| 路径类型::新建(相对值).文件名干().有值且(|干值| 干值 == "lib"))
    否则 {
        返回 行们;
    };
    如果 !项目根.连接("src/lib.rs").是否为文件() && !清单声明库(项目根) {
        行们.推入(格式化!(
            "  ⚠ {库源} 还没有入口产物 src/lib.rs（入口产物只由被请求的文件写）"
        ));
        行们.推入(格式化!(
            "    → 主程序 `使用` 这个库之前，先跑一次 `rzc check {库源}`"
        ));
    }
    行们
}

/// 源码目录下的方言源文件（相对项目根路径，字典序；只认已装语言包的扩展名）
函数 源目录方言源(项目根: &路径类型, 扩展名们: &[字符串]) -> 向量<字符串> {
    让 可变 已找到 = 向量::新建();
    收集方言源(
        &项目根.连接("src"),
        项目根,
        扩展名们,
        &可变 已找到,
    );
    已找到.排序();
    已找到
}

函数 收集方言源(
    目录值: &路径类型,
    根路径: &路径类型,
    扩展名们: &[字符串],
    已找到: &可变 向量<字符串>,
) {
    让 成功(目录读) = 标准库::文件系统::读取目录(目录值) 否则 {
        返回;
    };
    对于 条目值 在 目录读.展平() {
        让 路径值 = 条目值.条目路径();
        如果 路径值.是否为目录() {
            收集方言源(&路径值, 根路径, 扩展名们, 已找到);
            继续;
        }
        让 是方言 = 路径值
            .扩展名()
            .而后映射(|后缀| 后缀.取字符串引用())
            .有值且(|后缀| 扩展名们.迭代器().任意(|已知值| 已知值 == 后缀));
        如果 !是方言 {
            继续;
        }
        如果让 成功(相对值) = 路径值.去前缀(根路径) {
            已找到.推入(相对值.展示().转字符串().替换('\\', "/"));
        }
    }
}

/// 无构建目标时建议先跑的入口候选：主程序 → 库 → 源码目录直属的第一个
/// 方言文件（母语词干入口如 `src/主函数.zh` 走最后一条，也正好是该先跑的那条命令）
函数 入口候选(源文件们: &[字符串]) -> 字符串 {
    让 取词干 = |相对值: &文本| {
        路径类型::新建(相对值)
            .文件名干()
            .映射(|干值| 干值.转有损字符串().转字符串())
    };
    ["main", "lib"]
        .迭代器()
        .查找映射(|目标值| {
            源文件们
                .迭代器()
                .查找(|相对值| 取词干(相对值).有值且(|干值| 干值 == *目标值))
                .克隆副本()
        })
        .或用否则(|| {
            源文件们
                .迭代器()
                .查找(|相对值| 相对值.模式匹配('/').计数() == 1)
                .克隆副本()
        })
        .或用否则(|| 源文件们.第一个().克隆副本())
        .解包或用否则(|| "src/main.rs".转字符串())
}

/// 清单是否为工作区根（虚拟清单含工作区节）
函数 清单为工作区(项目根: &路径类型) -> 布尔 {
    清单值(项目根).有值且(|值项| 值项.获取("workspace").是否为有值())
}

/// 清单是否声明了库目标（含库路径：此时库目标由包管理器直接认，不要求产物名）
函数 清单声明库(项目根: &路径类型) -> 布尔 {
    清单值(项目根).有值且(|值项| 值项.获取("lib").是否为有值())
}

函数 清单值(项目根: &路径类型) -> 选项<TOML处理::TOML值> {
    让 文本串 = 标准库::文件系统::读取字符串(项目根.连接("Cargo.toml")).转选项()?;
    TOML处理::解析字符串::<TOML处理::TOML值>(&文本串).转选项()
}

/// 语言包健康检查状态行（纯函数，便于测试）
///
/// `包列表` 为全局目录下的语言包候选（含 keywords.toml 的子目录），
/// `子目录们` 为该目录下全部子目录名。返回空表示无异常。
///
/// 报三类问题（均只在用户环境发生，静态门检查不出）：
/// - 目录名与内置代码相同 → 用户级副本遮蔽内置表（内置表优先级最低）
/// - 目录名形如备份（以备份后缀结尾或含过期标记）→ 仍被当语言包吃掉并接管扩展名
/// - 正常包（非备份）目录名与声明的扩展名不一致 → 提示确认是否有意为之
///
/// 第三方自研包（目录名与扩展名相同）不属异常，不报警。
函数 语言包健康行(
    包列表: &[全局语言包],
    子目录们: &[字符串],
) -> 向量<字符串> {
    让 可变 行们 = 向量::新建();
    // 1. 遮蔽内置表（同名的正常目录）
    对于 包项 在 包列表 {
        如果 !包::内置语言::有内置语言包(&包项.目录名) || 是备份名(&包项.目录名) {
            继续;
        }
        让 内置版本 = 获取内置元数据(&包项.目录名)
            .映射(|元项| 元项.版本)
            .解包或用否则(|| "?".转字符串());
        让 用户版本 = 包项
            .元数据
            .作为引用方法()
            .映射(|元项| 元项.版本.克隆值())
            .解包或用否则(|| "?".转字符串());
        行们.推入(格式化!(
            "  ⚠ 全局包 {}（v{}）遮蔽内置语言包（v{}），当前 .{} 源码走全局副本",
            包项.目录名,
            用户版本,
            内置版本,
            语言包扩展名(包项).解包或用否则(|| 包项.目录名.克隆值())
        ));
        行们.推入(
            "    → 升级 rzc 后诊断文案仍是旧的，多半是此因：rzc lang remove <码>，或把该目录移出 lang-packs/"
                .转字符串(),
        );
    }
    // 2. 备份/改名遗留：无论是否含 keywords.toml，留在 lang-packs/ 内都可能被吃掉
    对于 名称值 在 子目录们 {
        如果 !是备份名(名称值) {
            继续;
        }
        如果 包列表.迭代器().任意(|包项| &包项.目录名 == 名称值) {
            行们.推入(格式化!(
                "  ⚠ 备份目录 {} 仍被当作语言包吃掉（语言代码取目录名）：请移出 {}",
                名称值,
                全局语言目录().展示()
            ));
        } 否则 {
            行们.推入(格式化!(
                "  ⚠ 子目录 {} 不具备 keywords.toml（未作为语言包加载）：备份建议移出 lang-packs/",
                名称值
            ));
        }
    }
    // 3. 目录名与声明扩展名不符（排除备份与自研同名包）
    对于 包项 在 包列表 {
        如果 包::内置语言::有内置语言包(&包项.目录名) || 是备份名(&包项.目录名) {
            继续;
        }
        如果让 有值(后缀值) = 语言包扩展名(包项)
            && 后缀值 != 包项.目录名
        {
            行们.推入(格式化!(
                "  ⚠ 全局包目录名 {} 与其声明的扩展名 {} 不一致（语言代码取目录名，当前 .{} 源码按声明接管）",
                包项.目录名,
                后缀值,
                后缀值
            ));
        }
    }
    行们
}

/// 备份/改名遗留目录名特征：以备份后缀结尾或含过期标记
函数 是备份名(名称值: &文本) -> 布尔 {
    名称值.以结尾(".bak") || 名称值.包含(".stale")
}

/// 取全局包生效的扩展名：语言信息声明优先，缺失时回退静态映射推断
函数 语言包扩展名(包项: &全局语言包) -> 选项<字符串> {
    包项
        .元数据
        .作为引用方法()
        .映射(|元项| 元项.扩展名.克隆值())
        .或用否则(|| {
            静态扩展名映射()
                .消费迭代()
                .查找(|(_, 代码值)| 代码值 == &包项.目录名)
                .映射(|(后缀, _)| 后缀)
        })
}

/// 组件来源：内置工具链目录优先，其次环境变量路径
枚举 组件来源 {
    内置(路径缓冲),
    路径来源(路径缓冲),
}

实现 组件来源 {
    函数 取路径(&自我) -> &路径类型 {
        匹配 自我 {
            自身::内置(值项) | 自身::路径来源(值项) => 值项,
        }
    }
}

/// 定位组件实际使用的可执行文件（内置目录优先，其次环境变量路径）
函数 定位组件(名称值: &文本, 程序目录: &路径类型) -> 选项<组件来源> {
    让 内置路径 = 程序目录.连接(格式化!("{名称值}{程序后缀}"));
    如果 内置路径.是否为文件() {
        返回 有值(组件来源::内置(内置路径));
    }
    引擎库::工具链::查找工具链程序(名称值).映射(组件来源::路径来源)
}

/// 各组件来源状态行（纯函数，便于测试）：编译器内置、包管理器来自环境变量路径等
///
/// 除编译链路外，还覆盖编辑器链路的两个必需件：语言分析器（语言服务代理
/// 转发目标）与语言服务器（编辑器扩展启动的语言服务器）。两者缺失
/// 在编辑器里只表现为服务初始化失败而拿不到原因，
/// `rzc doctor` 是唯一的自查入口，因此缺失时必须给出可直接复制的安装命令。
函数 组件状态行(程序目录: &路径类型) -> 向量<字符串> {
    常量 组件清单: [(&文本, &文本); 4] = [
        ("rustc", "rzc install toolchain（或 rustup default stable）"),
        ("cargo", "rzc install toolchain（或 rustup default stable）"),
        (
            "rust-analyzer",
            "rustup component add rust-analyzer（或 rzc install toolchain 装内置工具链）",
        ),
        (
            "i18n-rust-lsp",
            "rzc install lsp（或 cargo install i18n-rust-lsp）",
        ),
    ];
    让 可变 行们 = 向量::新建();
    对于 (组件名, 修复命令) 在 组件清单 {
        让 状态文本 = 匹配 定位组件(组件名, 程序目录) {
            有值(组件来源::内置(路径值)) => 格式化!("内置（{}）", 路径值.展示()),
            有值(组件来源::路径来源(路径值)) => 格式化!("环境路径（{}）", 路径值.展示()),
            无 => {
                行们.推入(格式化!("{}: 未找到", 组件名));
                行们.推入(格式化!("  → 安装：{}", 修复命令));
                继续;
            }
        };
        行们.推入(格式化!("{}: {}", 组件名, 状态文本));
    }
    行们
}

/// 语言服务器与 rzc 的版本一致性行（纯函数，便于测试）
///
/// 两者是两条独立安装链路：服务器可执行文件可能来自更早的包仓库版本或
/// 手动拷贝的旧文件，转译规则与诊断文案都是旧的。版本拿不到时不给结论
/// （返回空值，避免在旧版无版本输出时误报）。
函数 语言服务版本行(语言服务版本: 选项<&文本>, 程序版本: &文本) -> 选项<字符串> {
    // 命令行风格输出可能是「包名 版本号」，取末个字段作版本号
    让 版本值 = 语言服务版本
        .映射(|值项| 值项.裁剪())
        .过滤(|值项| !值项.是否为空())?
        .分割空白()
        .最后一个()?;
    如果 版本值 == 程序版本 {
        有值(格式化!("  ✓ 语言服务器与 rzc 版本一致（{}）", 版本值))
    } 否则 {
        有值(格式化!(
            "  ⚠ 语言服务器 {} 与 rzc {} 不一致：转译规则与诊断文案仍是旧的 → rzc install lsp --force 更新",
            版本值,
            程序版本
        ))
    }
}

/// 双击可执行文件（或终端无参数运行）时的环境安装向导：
/// 逐项检查组件状态，标注「已就绪」或「缺失 + 解决命令」。
公开 函数 显示安装向导() {
    使用 引擎库::工具链::{工具链程序目录, 查找工具链程序};
    让 后缀值 = 标准库::环境::平台常量::可执行后缀;

    打印行!("════════════ i18n-rust 环境安装向导 ════════════");
    打印行!("rzc 本体          v{}（已就绪）", 编译环境!("CARGO_PKG_VERSION"));
    打印行!();
    打印行!("  💡 也可下载「离线发布包」：压缩包已含语言分析器 + 语言服务器 +");
    打印行!("     语言包与教程，适合无网络环境（离线包由本地构建，手动分发）。");
    打印行!();

    // 1. 内置工具链（编译器 / 包管理器 / 语言分析器）
    打印行!("【第 1 步】编译器与工具链（rzc install toolchain 一键安装）");
    对于 (组件名, 安装命令) 在 [
        ("rustc", "rzc install toolchain"),
        ("cargo", "rzc install toolchain"),
        ("rust-analyzer", "rzc install toolchain --force"),
    ] {
        让 内置路径 = 工具链程序目录().连接(格式化!("{组件名}{后缀值}"));
        让 (标记, 详情) = 如果 内置路径.是否为文件() {
            ("✓ 已就绪", 格式化!("内置（{}）", 内置路径.展示()))
        } 否则 如果让 有值(路径项) = 查找工具链程序(组件名) {
            ("✓ 已就绪", 格式化!("环境路径（{}）", 路径项.展示()))
        } 否则 {
            (
                "✗ 缺失",
                格式化!("未找到 → 运行: {}（需联网，约 300MB）", 安装命令),
            )
        };
        打印行!("  [{}] {:<14} {}", 标记, 组件名, 详情);
    }
    打印行!();

    // 2. 语言服务器（编辑器补全/诊断后端）
    打印行!("【第 2 步】语言服务器 i18n-rust-lsp（rzc install lsp 一键安装）");
    如果让 有值(路径项) = 查找工具链程序("i18n-rust-lsp") {
        打印行!("  [✓ 已就绪] {}", 路径项.展示());
        如果让 成功(输出值) = 标准库::进程::命令::新建(&路径项).单参数("--version").取输出() {
            让 版本值 = 字符串::从utf8宽松(&输出值.标准输出).裁剪().转字符串();
            如果 !版本值.是否为空() {
                打印行!("              版本 {版本值}");
            }
        }
    } 否则 {
        打印行!("  [✗ 缺失] 未找到 i18n-rust-lsp{} → 运行: rzc install lsp", 后缀值);
    }
    打印行!();

    // 3. 编辑器扩展
    打印行!("【第 3 步】编辑器扩展（安装包手动安装，未发布到扩展商城）");
    打印行!("  [? 手动] 从发布页下载 i18n-rust-<版本> 安装包");
    打印行!("           → 编辑器命令面板（Ctrl+Shift+P）→ 从安装包安装并选择该文件");
    打印行!();

    // 4. 环境变量（可选）
    打印行!("【第 4 步】环境变量（可选，一般无需配置）");
    打印行!("  RZ_LANG_DIR        指定语言包目录（默认内置）");
    打印行!("  RUST_ANALYZER_PATH 指定语言分析器路径（自动检测失败时）");
    打印行!("  编辑器设置 i18n-rust.serverPath 可指定语言服务器路径");
    打印行!();

    // 常用命令
    打印行!("────────── 常用命令速查 ──────────");
    打印行!("  rzc init 我的项目        创建新项目");
    打印行!("  rzc run src/main.zh      运行中文代码");
    打印行!("  rzc check src/main.zh    类型检查（中文错误提示）");
    打印行!("  rzc install toolchain    一键安装内置工具链");
    打印行!("  rzc install lsp          安装语言服务器");
    打印行!("  rzc doctor               查看工具链环境状态与语言包遮蔽");
    打印行!("  rzc --help               查看全部命令");
    打印行!();
    打印行!("详细教程见《开篇：这本书怎么用》与《第一章：用好编辑器扩展》。");
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;
    使用 标准库::文件系统;

    #[测试]
    函数 语言服务版本一致() {
        断言相等!(
            核对语言服务版本(有值("0.5.5".转字符串()), "0.5.5"),
            版本核对::一致
        );
    }

    #[测试]
    函数 语言服务版本不一致() {
        断言相等!(
            核对语言服务版本(有值("0.5.3".转字符串()), "0.5.5"),
            版本核对::不一致("0.5.3".转字符串())
        );
    }

    #[测试]
    函数 语言服务版本未知() {
        断言相等!(核对语言服务版本(空值, "0.5.5"), 版本核对::未知);
    }

    #[测试]
    函数 目标三元组支持当前平台() {
        // 当前平台必须能被识别（不恐慌）
        让 三元组 = 目标三元组().期望("当前平台应受支持");
        断言!(!三元组.是否为空());
    }

    /// 摘要计算正确性（空文件与已知内容）
    #[测试]
    函数 文件摘要已知内容() {
        让 目录值 = 临时文件::建临时目录().解包();
        让 文件路径 = 目录值.条目路径().连接("a.txt");
        标准库::文件系统::写入(&文件路径, b"hello").解包();
        // 该短串的摘要（标准已知值）
        断言相等!(
            文件摘要(&文件路径).解包(),
            "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"
        );
    }

    /// 内置工具链存在时状态行标记为内置
    #[测试]
    函数 组件状态行内置标记() {
        让 目录值 = 临时文件::建临时目录().解包();
        让 程序目录 = 目录值.条目路径();
        标准库::文件系统::写入(程序目录.连接(格式化!("rustc{程序后缀}")), b"x").解包();
        让 行们 = 组件状态行(程序目录);
        断言!(行们.迭代器().任意(|行值| 行值.以开头("rustc: 内置")));
        // 其余组件未内置时标记环境路径或未找到（不恐慌）
        断言!(行们.迭代器().任意(|行值| 行值.以开头("cargo:")));
        断言!(行们.迭代器().任意(|行值| 行值.以开头("rust-analyzer:")));
    }

    /// 诊断覆盖编辑器链路：语言服务器必须有状态行，
    /// 且任何「未找到」行后面紧跟一条可复制的安装命令
    #[测试]
    函数 组件状态行覆盖编辑器链路() {
        让 目录值 = 临时文件::建临时目录().解包();
        让 行们 = 组件状态行(目录值.条目路径());
        断言!(
            行们.迭代器().任意(|行值| 行值.以开头("i18n-rust-lsp:")),
            "{行们:?}"
        );
        对于 (序号, 行值) 在 行们.迭代器().枚举() {
            如果 行值.包含("未找到") {
                // 下一行必须是可直接复制的安装命令（三种来源）
                让 下一行 = 行们.获取(序号 + 1).映射(|值项| 值项.作为文本切片()).取值或默认();
                断言!(
                    下一行.以开头("  → 安装：") && 下一行.包含("install"),
                    "「{}」后缺少安装提示：{:?}",
                    行值,
                    下一行
                );
            }
        }
    }

    /// 语言服务器版本漂移提示：一致时无警告，落后时给更新命令
    #[测试]
    函数 语言服务版本行标记漂移() {
        让 相同行 = 语言服务版本行(有值("0.8.11"), "0.8.11").解包();
        断言相等!(相同行, "  ✓ 语言服务器与 rzc 版本一致（0.8.11）");
        // 带包名前缀的输出同样能比对
        让 漂移行 = 语言服务版本行(有值("i18n-rust-lsp 0.8.2"), "0.8.11").解包();
        断言!(漂移行.包含("0.8.2"), "{漂移行}");
        断言!(漂移行.包含("rzc install lsp --force"), "{漂移行}");
        // 旧版无版本输出：不给结论，避免误报
        断言!(语言服务版本行(空值, "0.8.11").是否为无());
        断言!(语言服务版本行(有值("  \n"), "0.8.11").是否为无());
    }

    /// 构造全局语言包候选条目（测试辅助）
    函数 全局包(
        目录名值: &文本,
        后缀: 选项<&文本>,
        版本值: 选项<&文本>,
    ) -> 全局语言包 {
        使用 包::语言管理::语言元数据;
        全局语言包 {
            目录名: 目录名值.转字符串(),
            元数据: 后缀.映射(|后缀值| 语言元数据 {
                名称: "测试".转字符串(),
                扩展名: 后缀值.转字符串(),
                版本: 版本值.解包或用("0.1").转字符串(),
            }),
        }
    }

    /// 全局同名包遮蔽内置表：须报警并给出解除命令
    #[测试]
    函数 语言包健康遮蔽() {
        让 包列表 = 向量![全局包("zh", 有值("zh"), 有值("1.0"))];
        让 行们 = 语言包健康行(&包列表, &["zh".转字符串()]);
        断言!(
            行们.迭代器().任意(|行值| 行值.包含("遮蔽内置语言包")),
            "{行们:?}"
        );
        断言!(
            行们.迭代器().任意(|行值| 行值.包含("rzc lang remove")),
            "应给出解除命令: {行们:?}"
        );
    }

    /// 备份目录改名后仍被当语言包吃掉：须报警（即上一步实际踩到的坑）
    #[测试]
    函数 语言包健康备份遗留() {
        让 名称值 = "zh.stale-20260919.bak";
        让 包列表 = 向量![全局包(名称值, 有值("zh"), 空值)];
        让 行们 = 语言包健康行(&包列表, &[名称值.转字符串()]);
        断言!(
            行们.迭代器().任意(|行值| 行值.包含("仍被当作语言包吃掉")),
            "{行们:?}"
        );
        // 遮蔽行只针对目录名与内置代码完全相同的包，备份不当作遮蔽报
        断言!(
            !行们.迭代器().任意(|行值| 行值.包含("遮蔽内置语言包")),
            "{行们:?}"
        );
    }

    /// 备份目录不具备 keywords.toml（未被加载）也须提示移出
    #[测试]
    函数 语言包健康未加载备份() {
        让 名称值 = "ja.backup-20260919.stale";
        让 行们 = 语言包健康行(&[], &[名称值.转字符串()]);
        断言!(
            行们
                .迭代器()
                .任意(|行值| 行值.包含(名称值) && 行值.包含("keywords.toml")),
            "{行们:?}"
        );
    }

    /// 第三方自研包（目录名与扩展名一致）不应被误报
    #[测试]
    函数 语言包健康自研包安静() {
        让 包列表 = 向量![全局包("vi", 有值("vi"), 有值("1.0"))];
        断言!(
            语言包健康行(&包列表, &["vi".转字符串()]).是否为空(),
            "自研包不应报警"
        );
    }

    /// 自研包目录名与声明扩展名不符：提示身份不一致
    #[测试]
    函数 语言包健康身份不符() {
        让 包列表 = 向量![全局包("mypack", 有值("vi"), 空值)];
        让 行们 = 语言包健康行(&包列表, &["mypack".转字符串()]);
        断言!(行们.迭代器().任意(|行值| 行值.包含("不一致")), "{行们:?}");
    }

    /// 无全局包时不报任何异常
    #[测试]
    函数 语言包健康空清单() {
        断言!(语言包健康行(&[], &[]).是否为空());
    }

    /// 写一个全局语言包目录（keywords.toml + 可选语言信息），供端到端注入。
    /// 后缀为空时不写语言信息（模拟扩展名靠静态映射推断的旧包）。
    函数 写全局包(
        根路径: &路径类型,
        目录名值: &文本,
        后缀: 选项<&文本>,
        版本值: 选项<&文本>,
        带关键词: 布尔,
    ) {
        让 目录值 = 根路径.连接(目录名值);
        标准库::文件系统::递归创建目录(&目录值).解包();
        如果 带关键词 {
            标准库::文件系统::写入(目录值.连接("keywords.toml"), "# 占位\n").解包();
        }
        如果让 有值(后缀值) = 后缀 {
            让 版本文本 = 版本值.解包或用("1.0");
            标准库::文件系统::写入(
                目录值.连接("lang_info.toml"),
                格式化!("[\"语言包\"]\n\"名称\" = \"{目录名值}\"\n\"扩展名\" = \"{后缀值}\"\n\"版本\" = \"{版本文本}\"\n"),
            )
            .解包();
        }
    }

    /// 端到端故障注入：真实文件系统扫描 → 健康行，逐场景核应报/不误报。
    ///
    /// 上面几例只喂合成切片，验不出 [`扫描全局语言包`]/[`全局语言包子目录名`]
    /// 对真实目录（含/不含 keywords.toml、语言信息解析）的处理是否与判定假设一致；
    /// 这里把六类只在用户环境发生的坑一次性注入语言目录指向的临时目录，
    /// 走真实的扫描→健康行链路验证诊断命令能一次查全且不误报。
    #[测试]
    函数 诊断语言包端到端注入() {
        让 _锁 = 包::语言管理::母语测试::环境锁();
        让 临时根 = 临时文件::建临时目录().解包();
        让 全局目录 = 临时根.条目路径().连接("global");
        标准库::文件系统::递归创建目录(&全局目录).解包();
        // ① 同名遮蔽内置表（版本不同）
        写全局包(&全局目录, "zh", 有值("zh"), 有值("9.9"), 真);
        // ② 改名遗留的备份且仍被当包吃掉（含 keywords.toml）
        写全局包(&全局目录, "de.stale-20260101.bak", 有值("de"), 空值, 真);
        // ③ 不具备 keywords.toml 的备份（未被加载，仍须提示移出）
        写全局包(&全局目录, "ja.backup.stale", 有值("ja"), 空值, 假);
        // ④ 合法自研包（目录名即扩展名）：不得误报
        写全局包(&全局目录, "vi", 有值("vi"), 有值("1.0"), 真);
        // ⑤ 目录名与声明扩展名不符的自研包：应报身份不一致
        写全局包(&全局目录, "mypack", 有值("fr"), 空值, 真);

        不安全 { 标准库::环境::设置环境变量("RZ_LANG_DIR", &全局目录) };
        让 包列表 = 扫描全局语言包();
        让 子目录们 = 全局语言包子目录名();
        让 健康行们 = 语言包健康行(&包列表, &子目录们);
        不安全 { 标准库::环境::移除环境变量("RZ_LANG_DIR") };

        让 合并文本 = 健康行们.连接("\n");
        // ① 同名遮蔽：报警 + 给出解除命令
        断言!(
            合并文本.包含("遮蔽内置语言包") && 合并文本.包含("rzc lang remove"),
            "{合并文本}"
        );
        // ② 备份仍被吃掉
        断言!(
            健康行们
                .迭代器()
                .任意(|行值| 行值.包含("de.stale-20260101.bak") && 行值.包含("仍被当作语言包吃掉")),
            "{合并文本}"
        );
        // ③ 未加载备份：提示 keywords.toml 缺失
        断言!(
            健康行们
                .迭代器()
                .任意(|行值| 行值.包含("ja.backup.stale") && 行值.包含("keywords.toml")),
            "{合并文本}"
        );
        // ⑤ 身份不一致
        断言!(
            健康行们
                .迭代器()
                .任意(|行值| 行值.包含("mypack") && 行值.包含("不一致")),
            "{合并文本}"
        );
        // ④ 合法自研包不得出现在任何报警行
        断言!(
            !健康行们.迭代器().任意(|行值| 行值.包含("vi（")
                || 行值.包含("  vi ")
                || (行值.包含("vi") && 行值.包含("不一致"))),
            "合法自研包 vi 不应被误报：{合并文本}"
        );
    }

    /// 文件摘要：已知向量（空串/短串）；文件缺失报错
    #[测试]
    函数 文件摘要已知向量() {
        让 临时 = 临时文件::建临时目录().解包();
        让 空路径 = 临时.条目路径().连接("empty");
        文件系统::写入(&空路径, b"").解包();
        断言相等!(
            文件摘要(&空路径).解包(),
            "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        );
        让 短串路径 = 临时.条目路径().连接("abc");
        文件系统::写入(&短串路径, b"abc").解包();
        断言相等!(
            文件摘要(&短串路径).解包(),
            "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
        );
        断言!(文件摘要(&临时.条目路径().连接("absent")).是否为错误());
    }

    /// 复制程序目录：默认跳过已存在；覆盖模式替换旧文件
    #[测试]
    函数 复制程序目录可覆盖已存在() {
        让 临时 = 临时文件::建临时目录().解包();
        让 来源目录 = 临时.条目路径().连接("from");
        让 目标目录 = 临时.条目路径().连接("to");
        文件系统::递归创建目录(&来源目录).解包();
        文件系统::递归创建目录(&目标目录).解包();
        文件系统::写入(来源目录.连接("a"), b"new-a").解包();
        文件系统::写入(来源目录.连接("b"), b"new-b").解包();
        文件系统::写入(目标目录.连接("a"), b"keep-old").解包();
        复制程序目录(&来源目录, &目标目录, 假).解包();
        断言相等!(文件系统::读取(目标目录.连接("a")).解包(), b"keep-old");
        断言相等!(文件系统::读取(目标目录.连接("b")).解包(), b"new-b");
        // 覆盖模式：旧文件被替换（强制安装修复被篡改的工具链）
        复制程序目录(&来源目录, &目标目录, 真).解包();
        断言相等!(文件系统::读取(目标目录.连接("a")).解包(), b"new-a");
        // 源目录缺失报错（调用方负责确保前置条件）
        断言!(复制程序目录(&临时.条目路径().连接("absent"), &目标目录, 假).是否为错误());
    }

    /// 提取压缩包条目：取压缩包第一个条目原样落盘（Windows 单文件资产路径）
    #[测试]
    函数 提取压缩包条目往返() {
        使用 标准库::输入输出::写入特征 作为 _;
        使用 拉链::写出::文件选项;
        让 临时 = 临时文件::建临时目录().解包();
        让 压缩包路径 = 临时.条目路径().连接("asset.zip");
        让 负载 = b"rust-analyzer binary \x00\x01\x02";
        {
            让 可变 写入器 = 拉链::压缩包写入器::新建(标准库::输入输出::游标::新建(向量::新建()));
            写入器
                .开始文件("rust-analyzer", 文件选项::<空>::默认值())
                .解包();
            写入器.写入全部(负载).解包();
            文件系统::写入(压缩包路径.转路径(), 写入器.完成().解包().取内层()).解包();
        }
        让 目标路径 = 临时.条目路径().连接("out/rust-analyzer");
        文件系统::递归创建目录(目标路径.父目录().解包()).解包();
        提取压缩包条目(&压缩包路径, &目标路径).解包();
        断言相等!(文件系统::读取(&目标路径).解包(), 负载);
        // 损坏/缺失压缩包 → 报错而非写出半截文件
        让 坏路径 = 临时.条目路径().连接("bad.zip");
        文件系统::写入(&坏路径, b"not a zip").解包();
        断言!(提取压缩包条目(&坏路径, &临时.条目路径().连接("out2")).是否为错误());
    }

    /// 解压归档包：归档内文件按相对路径还原到目标目录
    #[测试]
    函数 解压归档包往返() {
        让 临时 = 临时文件::建临时目录().解包();
        让 归档路径 = 临时.条目路径().连接("bin.tar.gz");
        让 负载 = b"#!/bin/sh\necho hi\n";
        {
            让 编码器 = 数据压缩::写入::压缩编码器::新建(
                标准库::输入输出::游标::新建(向量::新建()),
                数据压缩::压缩级别::默认值(),
            );
            让 可变 构建器 = 归档读取库::归档写入构建::新建(编码器);
            让 可变 头部 = 归档读取库::头部类型::新建通用();
            头部.设置路径("bin/rzc").解包();
            头部.设置大小(负载.元素数() 作为 无符号长整数);
            头部.设置模式(0o755);
            头部.设置校验和();
            构建器.追加(&头部, &负载[..]).解包();
            让 压缩数据 = 构建器.取内层().解包().完成().解包().取内层();
            文件系统::写入(&归档路径, &压缩数据).解包();
        }
        让 目标目录 = 临时.条目路径().连接("dest");
        解压归档包(&归档路径, &目标目录).解包();
        断言相等!(文件系统::读取(目标目录.连接("bin/rzc")).解包(), 负载);
    }

    /// 项目自检用例的公共脚手架：写清单 + 源码目录下的文件，返回项目根
    函数 建项目(根路径: &路径类型, 清单文本: &文本, 文件们: &[&文本]) {
        标准库::文件系统::写入(根路径.连接("Cargo.toml"), 清单文本).解包();
        标准库::文件系统::递归创建目录(根路径.连接("src")).解包();
        对于 相对值 在 文件们 {
            让 路径值 = 根路径.连接(相对值);
            标准库::文件系统::递归创建目录(路径值.父目录().解包()).解包();
            标准库::文件系统::写入(&路径值, "// 占位\n").解包();
        }
    }

    常量 中英扩展名: &[&文本] = &["zh", "ja"];

    函数 健康(根路径: &路径类型) -> 向量<字符串> {
        项目入口健康行(
            根路径,
            &中英扩展名.迭代器().映射(|文本值| 文本值.转字符串()).收集::<向量<_>>(),
        )
    }

    /// 有方言源文件却没有入口产物：点名缺构建目标，并给出能走通的那条检查命令
    #[测试]
    函数 项目入口健康指向检查命令() {
        让 目录值 = 临时文件::建临时目录().解包();
        建项目(
            目录值.条目路径(),
            "[package]\nname=\"p\"\nversion=\"0.1.0\"\nedition=\"2021\"\n",
            &["src/main.zh", "src/餐具库.zh"],
        );
        让 行们 = 健康(目录值.条目路径());
        让 文本串 = 行们.连接("\n");
        断言!(文本串.包含("包管理器读不到任何构建目标"), "{文本串}");
        断言!(文本串.包含("2 个方言源文件"), "{文本串}");
        断言!(文本串.包含("rzc check src/main.zh"), "{文本串}");
        断言!(
            文本串.包含("no targets specified in the manifest"),
            "须写明直接构建会撞的那句原文：{文本串}"
        );
    }

    /// 入口产物齐备：一行都不报（正常项目不得被自检噪音打扰）
    #[测试]
    函数 项目入口健康产物齐备安静() {
        让 目录值 = 临时文件::建临时目录().解包();
        建项目(
            目录值.条目路径(),
            "[package]\nname=\"p\"\nversion=\"0.1.0\"\nedition=\"2021\"\n",
            &["src/main.zh", "src/main.rs"],
        );
        断言!(健康(目录值.条目路径()).是否为空(), "{:?}", 健康(目录值.条目路径()));
    }

    /// 主程序与库的第 ③ 条墙：库源在、库产物不在 → 提示先检查一次库
    #[测试]
    函数 项目入口健康标记未建库() {
        让 目录值 = 临时文件::建临时目录().解包();
        建项目(
            目录值.条目路径(),
            "[package]\nname=\"p\"\nversion=\"0.1.0\"\nedition=\"2021\"\n",
            &["src/main.zh", "src/main.rs", "src/lib.zh"],
        );
        让 文本串 = 健康(目录值.条目路径()).连接("\n");
        断言!(
            文本串.包含("src/lib.zh 还没有入口产物 src/lib.rs"),
            "{文本串}"
        );
        断言!(文本串.包含("rzc check src/lib.zh"), "{文本串}");
    }

    /// 清单声明了库路径时不报库产物：库目标由包管理器直接认
    #[测试]
    函数 项目入口健康尊重声明库() {
        让 目录值 = 临时文件::建临时目录().解包();
        建项目(
            目录值.条目路径(),
            "[package]\nname=\"p\"\nversion=\"0.1.0\"\nedition=\"2021\"\n[lib]\npath=\"src/库.rs\"\n",
            &["src/main.rs", "src/lib.zh"],
        );
        断言!(健康(目录值.条目路径()).是否为空(), "{:?}", 健康(目录值.条目路径()));
    }

    /// 母语词干入口（`src/主函数.zh`）：建议的命令就是它，不是凭空造一个主程序产物
    #[测试]
    函数 项目入口健康回退直属入口() {
        让 目录值 = 临时文件::建临时目录().解包();
        建项目(
            目录值.条目路径(),
            "[package]\nname=\"p\"\nversion=\"0.1.0\"\nedition=\"2021\"\n",
            &["src/领域/工具.zh", "src/主函数.zh"],
        );
        让 文本串 = 健康(目录值.条目路径()).连接("\n");
        断言!(文本串.包含("rzc check src/主函数.zh"), "{文本串}");
    }

    /// 工作区根（虚拟清单）本就没有构建目标：跳过，不报「缺入口」
    #[测试]
    函数 项目入口健康跳工作区根() {
        让 目录值 = 临时文件::建临时目录().解包();
        建项目(目录值.条目路径(), "[workspace]\nmembers = [\"crates/a\"]\n", &[]);
        让 文本串 = 健康(目录值.条目路径()).连接("\n");
        断言!(文本串.包含("工作区根"), "{文本串}");
        断言!(!文本串.包含("包管理器读不到任何构建目标"), "{文本串}");
    }

    /// 没有清单的目录：整段自检沉默（诊断另有「不在项目内」一行）
    #[测试]
    函数 项目入口健康项目外沉默() {
        让 目录值 = 临时文件::建临时目录().解包();
        标准库::文件系统::递归创建目录(目录值.条目路径().连接("src/main.rs")).解包();
        断言!(健康(目录值.条目路径()).是否为空());
    }

    /// 源码目录下连方言文件都没有：给出初始化命令，而不是编不出来的检查命令
    #[测试]
    函数 项目入口健康无源提示初始化() {
        让 目录值 = 临时文件::建临时目录().解包();
        建项目(
            目录值.条目路径(),
            "[package]\nname=\"p\"\nversion=\"0.1.0\"\nedition=\"2021\"\n",
            &["src/说明.txt"],
        );
        让 文本串 = 健康(目录值.条目路径()).连接("\n");
        断言!(文本串.包含("rzc init"), "{文本串}");
        断言!(!文本串.包含("rzc check"), "{文本串}");
    }

    /// 备份名识别：以备份后缀结尾或含过期段；正常目录名不误判
    #[测试]
    函数 备份名规则() {
        断言!(是备份名("ja.bak"));
        断言!(是备份名("de.stale-20260101.bak"));
        断言!(是备份名("ja.backup.stale"));
        断言!(!是备份名("ja"));
        断言!(!是备份名("backup-dir"));
        断言!(!是备份名("stale"));
    }
}
