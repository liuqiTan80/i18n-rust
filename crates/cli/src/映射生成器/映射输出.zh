//! 映射 TOML 构建：与现有 crates/*.toml 格式一致，含免责声明与生成时间戳。

使用 标准库::集合::哈希映射;

使用 超级::{接口条目, 免责声明文本};

/// TOML 字符串转义（含 \r 与其余控制字符，避免生成非法 TOML）
函数 转义文本(串: &文本) -> 字符串 {
    让 转义后 = 串
        .替换('\\', "\\\\")
        .替换('"', "\\\"")
        .替换('\n', "\\n")
        .替换('\t', "\\t")
        .替换('\r', "\\r");
    转义后
        .chars()
        .映射(|每字符| {
            匹配 每字符 {
                每字符 如果 (每字符 作为 无符号整数) < 0x20 => 格式化!("\\u{:04X}", 每字符 作为 无符号整数),
                每字符 => 每字符.转字符串(),
            }
        })
        .收集()
}

/// 当前时间字符串（UTC，`YYYY-MM-DD HH:MM:SS`）
函数 当前时间戳() -> 字符串 {
    让 秒数 = 标准库::时间模块::系统时间::现在()
        .自纪元(标准库::时间模块::历元)
        .unwrap_or_default()
        .总秒数();
    让 天数 = (秒数 / 86_400) 作为 长整数;
    让 当日秒 = 秒数 % 86_400;
    让 (年, 月, 日) = 分解日期(天数);
    格式化!(
        "{:04}-{:02}-{:02} {:02}:{:02}:{:02}",
        年,
        月,
        日,
        当日秒 / 3_600,
        (当日秒 % 3_600) / 60,
        当日秒 % 60
    )
}

/// 天数 → (年, 月, 日)（civil_from_days 算法，与引擎 logger.rs 一致）
函数 分解日期(天数: 长整数) -> (长整数, 无符号整数, 无符号整数) {
    让 序日 = 天数 + 719_468;
    让 纪元 = 序日.欧几里得除(146_097);
    让 纪元内日 = 序日 - 纪元 * 146_097;
    让 年偏移 =
        (纪元内日 - 纪元内日 / 1_460 + 纪元内日 / 36_524 - 纪元内日 / 146_096) / 365;
    让 年 = 年偏移 + 纪元 * 400;
    让 年内日 = 纪元内日 - (365 * 年偏移 + 年偏移 / 4 - 年偏移 / 100);
    让 月偏移 = (5 * 年内日 + 2) / 153;
    让 日 = (年内日 - (153 * 月偏移 + 2) / 5 + 1) 作为 无符号整数;
    让 月 = (月偏移 + 如果 月偏移 < 10 { 3 } 否则 { -9 }) 作为 无符号整数;
    让 年 = 如果 月 <= 2 { 年 + 1 } 否则 { 年 };
    (年, 月, 日)
}

/// 构建语言包映射 TOML（与现有 crates/*.toml 格式一致：
/// `["模块路径"]` / `["标识符"]` 两节为映射管理器识别的 String 值格式，
/// `["解释"]` 节为扩展，映射管理器加载时自动忽略，保持兼容）。
/// `目标版本串` 为提取时实际解析到的基准版本（写入文件头，供复现与比对）。
公开 函数 构建映射文本(
    语言: &文本,
    crate英文名: &文本,
    crate中文名: &文本,
    目标版本串: 选项<&文本>,
    条目表: &[接口条目],
    中文名表: &[(字符串, 字符串)],
    解说表: &哈希映射<字符串, 字符串>,
) -> 字符串 {
    让 界面 = crate::本地化::界面::按语言加载(语言);
    让 可变 输出串 = 字符串::新建();
    输出串.push_str(&格式化!("{}\n", 界面.取文("mg_header_title")));
    输出串.push_str(&格式化!("{}\n", 界面.取文带参("mg_header_crate", &[crate英文名])));
    // 生成基准版本（--target-version 锁定依据；解析不到版本时省略整行）
    如果 让 有值(版本串) = 目标版本串 {
        输出串.push_str(&格式化!(
            "{}\n",
            界面.取文带参("mg_header_target_version", &[版本串])
        ));
    }
    输出串.push_str(&格式化!(
        "{}\n",
        界面.取文带参("mg_header_generated_at", &[&当前时间戳()])
    ));
    输出串.push_str(&格式化!("# {}\n\n", 免责声明文本(语言)));

    输出串.push_str("[\"模块路径\"]\n");
    输出串.push_str(&格式化!(
        "\"{}\" = \"{}\"\n\n",
        转义文本(crate中文名),
        转义文本(crate英文名)
    ));

    输出串.push_str("[\"标识符\"]\n");
    // 预构建英文名→签名索引，避免 O(n²) 线性查找
    让 签名索引: 哈希映射<&文本, &文本> = 条目表
        .iter()
        .映射(|项| (项.英文原名.as_str(), 项.类型签名.as_str()))
        .收集();
    对于 (中文名, 英文名) in 中文名表 {
        让 签名 = 签名索引.get(英文名.as_str()).copied().unwrap_or("");
        输出串.push_str(&格式化!(
            "\"{}\" = \"{}\"  # {}\n",
            转义文本(中文名),
            转义文本(英文名),
            签名
        ));
    }
    输出串.push('\n');

    输出串.push_str("[\"解释\"]\n");
    对于 (中文名, _) in 中文名表 {
        让 解说 = 解说表
            .get(中文名)
            .映射(字符串::as_str)
            .unwrap_or("");
        输出串.push_str(&格式化!(
            "\"{}\" = \"{}\"\n",
            转义文本(中文名),
            转义文本(解说)
        ));
    }
    输出串
}

#[配置(测试)]
模块 单元测试 {
    使用 超级::超级::规则生成::规则生成中文名;
    使用 超级::超级::接口解析::{提取公开接口, 样例文本};
    使用 超级::*;

    #[测试]
    函数 测试构建映射文本与免责声明() {
        让 条目表 = 提取公开接口(&样例文本()).unwrap();
        让 中文名表: Vec<(字符串, 字符串)> = 条目表
            .iter()
            .映射(|项| {
                (
                    规则生成中文名(&项.英文原名),
                    项.英文原名.clone(),
                )
            })
            .收集();
        让 可变 解说表 = 哈希映射::新建();
        解说表.insert("新建".to_string(), "创建新的值".to_string());
        让 生成文本 = 构建映射文本(
            "zh",
            "示例",
            "示例库",
            有值("1.2.3"),
            &条目表,
            &中文名表,
            &解说表,
        );
        // 免责声明必须存在
        断言!(生成文本.contains(&免责声明文本("zh")), "缺少免责声明");
        断言!(生成文本.contains("# crate: 示例"));
        // 生成基准版本写入文件头（--target-version 锁定依据）
        断言!(生成文本.contains("# 基准版本: 1.2.3"));
        // 可被标准 TOML 解析
        让 解析值: toml::Value = toml::from_str(&生成文本).expect("TOML 应可解析");
        断言!(解析值.get("模块路径").is_some());
        断言!(解析值.get("标识符").is_some());
        断言!(解析值.get("解释").is_some());
        断言相等!(解析值["模块路径"]["示例库"].as_str(), 有值("示例"));
        断言相等!(解析值["标识符"]["新建"].as_str(), 有值("new"));
        断言相等!(解析值["标识符"]["状态"].as_str(), 有值("State"));
        断言相等!(解析值["解释"]["新建"].as_str(), 有值("创建新的值"));
    }

    #[测试]
    函数 测试映射文本可被管理器加载() {
        让 条目表 = 提取公开接口(&样例文本()).unwrap();
        让 中文名表: Vec<(字符串, 字符串)> = 条目表
            .iter()
            .映射(|项| {
                (
                    规则生成中文名(&项.英文原名),
                    项.英文原名.clone(),
                )
            })
            .收集();
        让 生成文本 = 构建映射文本(
            "zh",
            "示例",
            "示例库",
            无,
            &条目表,
            &中文名表,
            &哈希映射::新建(),
        );
        让 临时 = tempfile::tempdir().unwrap();
        // 模拟语言包目录结构：keywords.toml + crates/示例.toml（映射管理器要求 keywords.toml 存在）
        std::fs::write(
            临时.path().join("keywords.toml"),
            "[\"声明\"]\n\"函数\" = \"fn\"\n",
        )
        .unwrap();
        让 目录 = 临时.path().join("crates");
        std::fs::create_dir_all(&目录).unwrap();
        std::fs::write(目录.join("示例.toml"), 生成文本).unwrap();
        让 管理器 = i18n_rust_engine::映射管理::映射管理器::自目录加载(临时.path())
            .expect("映射管理器应能加载");
        // ["解释"] 节被忽略，["标识符"]/["模块路径"] 正常生效
        断言相等!(
            管理器.模块路径映射表.get("示例库").映射(字符串::as_str),
            有值("示例")
        );
        断言相等!(
            管理器.别名映射表.get("新建").映射(字符串::as_str),
            有值("new")
        );
        断言相等!(
            管理器.别名映射表.get("状态").映射(字符串::as_str),
            有值("State")
        );
    }
}
