/// 根据源码文件扩展名获取语言代码
///
/// 优先查询动态映射表，未命中时回退静态映射。
函数 扩展名转语言代码(扩展值: &文本) -> 选项<字符串> {
    如果让 有值(语言码) = 查询扩展名映射(扩展值) {
        返回 有值(语言码);
    }
    静态扩展名映射().获取(扩展值).克隆副本()
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::{
        注解非母语模块, 收集项目上下文, 收集同级方言文件, 探测工具链通道, 入口产物路径,
        查找映射别名, 扩展名转语言代码, 按语言分组文件, 是否入口源, 清理入口生成副本,
        转译项目文件, 转译为英文, 项目缓存转译, 写入转译产物,
    };
    // 引擎注解器直测（产物写盘已改走产物布局的托管布局版）
    使用 引擎库::模块路径::注解非母语模块并返回行映射;

    /// 加载内置中文映射管理器（测试转译管线用）
    函数 中文管理器() -> 引擎库::映射管理器::映射管理器 {
        让 内置数据 = 包::内置语言::获取内置数据("zh");
        引擎库::映射管理器::映射管理器::从内置载入(
            内置数据.关键字内容,
            内置数据.模块路径内容,
            内置数据.标准库内容,
            内置数据.三方库数据,
        )
        .期望("内置中文语言包应可加载")
    }

    /// 混合语言目录按扩展名分组：同语言文件归组，显式语言包不再分组
    ///
    /// 持环境变量锁：分组走扩展名动态映射（扫描全局语言包目录，受
    /// 语言目录环境变量影响），语言管理的环境变量测试并发修改该变量时
    /// 会令日文解不出语言码、组序错位。
    #[测试]
    函数 按语言分组测试() {
        让 _锁 = 包::语言管理::测试模块::环境锁();
        使用 标准库::路径::{路径类型, 路径缓冲};
        让 文件们 = 向量![
            路径缓冲::从("a.zh"),
            路径缓冲::从("b.ja"),
            路径缓冲::从("c.zh"),
        ];
        让 分组们 = 按语言分组文件(&文件们, 无);
        // 有序映射按语言码排序：日文组在前，中文组保留文件顺序
        断言相等!(分组们.元素数(), 2);
        断言相等!(分组们[0].元素数(), 1);
        断言!(分组们[0][0].以结尾("b.ja"));
        断言相等!(分组们[1].元素数(), 2);
        断言!(分组们[1][0].以结尾("a.zh"));
        断言!(分组们[1][1].以结尾("c.zh"));
        // 显式语言包：不分组，全部文件交给指定语言包
        让 显式分组 = 按语言分组文件(&文件们, 有值(路径类型::新建("lang-packs/ja")));
        断言相等!(显式分组.元素数(), 1);
        断言相等!(显式分组[0].元素数(), 3);
    }

    /// 单文件上下文补齐只扫同目录直接子文件：不递归子目录
    #[测试]
    函数 同级文件不递归测试() {
        让 目录 = 临时文件::建临时目录().期望("创建临时目录失败");
        标准库::文件系统::写入(目录.文件路径方法().连接("a.zh"), "").解包();
        标准库::文件系统::写入(目录.文件路径方法().连接("b.ja"), "").解包();
        标准库::文件系统::写入(目录.文件路径方法().连接("c.rs"), "").解包();
        标准库::文件系统::创建目录(目录.文件路径方法().连接("sub")).解包();
        标准库::文件系统::写入(目录.文件路径方法().连接("sub/d.zh"), "").解包();
        让 扩展名序列 = ["zh".转字符串(), "ja".转字符串()];
        让 文件们 = 收集同级方言文件(目录.文件路径方法(), &扩展名序列);
        让 名称们: 向量<字符串> = 文件们
            .迭代()
            .映射(|路径值| 路径值.文件名().解包().转有损字符串().转字符串())
            .收集();
        断言相等!(名称们, 向量!["a.zh".转字符串(), "b.ja".转字符串()]);
    }

    /// 入口产物路径：入口词干（主函数词或语言包主函数词）写入 包根，
    /// 非入口文件进托管目录（镜像源码布局），不占用入口产物
    ///（构建脚本不得覆盖入口产物）
    ///
    /// 项目根必须是真实落盘目录：合成路径在某些平台上不具
    /// 绝对性，且与项目根连接出的源码目录不在同一比较空间，
    /// 直属源码目录判定会恒为假，使母语词干入口这条断言在任何平台上都测不到真实行为。
    #[测试]
    函数 入口产物路径测试() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.文件路径方法().连接("proj");
        标准库::文件系统::创建所有目录(根.连接("src")).解包();
        让 管理器值 = 中文管理器();
        // 主文件词干聚合到固定入口
        断言相等!(
            入口产物路径(&根, &根.连接("src/main.zh"), &管理器值),
            根.连接("src/main.rs")
        );
        // 母语词干入口（映射主函数，旧项目命名）同样聚合到入口产物
        //（回归：此前仅认字面主函数名，母语主文件产物写自身名致构建工具找不到目标）
        断言相等!(
            入口产物路径(&根, &根.连接("src/主函数.zh"), &管理器值),
            根.连接("src/main.rs")
        );
        // 项目根的构建脚本（词干非入口）进托管目录，绝不触碰入口产物
        断言相等!(
            入口产物路径(&根, &根.连接("build.zh"), &管理器值),
            根.连接(".rz/gen/build.rs")
        );
        // 源码目录下非入口模块进托管目录镜像
        断言相等!(
            入口产物路径(&根, &根.连接("src/helper.zh"), &管理器值),
            根.连接(".rz/gen/src/helper.rs")
        );
    }

    /// 库入口产物路径：库入口落自动发现的库 包根，
    /// 让「造方言库」不再需要手写库路径声明。
    ///
    /// 三条边界都要钉住：只有源码目录直属的库词才是入口（子目录或项目根的库文件
    /// 是普通模块，落点若错到 包根会凭空给项目加一个编译目标）；清单
    /// 显式声明库路径时以声明为准；声明指向项目外时不猜意图。
    #[测试]
    函数 库入口产物路径测试() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.文件路径方法().连接("proj");
        标准库::文件系统::创建所有目录(根.连接("src/sub")).解包();
        让 管理器值 = 中文管理器();
        // 无清单即无声明即默认 包根
        断言相等!(
            入口产物路径(&根, &根.连接("src/lib.zh"), &管理器值),
            根.连接("src/lib.rs")
        );
        断言!(是否入口源(&根.连接("src/lib.zh"), &根, &管理器值));
        // 子目录与项目根的库文件不是入口（与主函数同规则，越界写出防护）
        断言相等!(
            入口产物路径(&根, &根.连接("src/sub/lib.zh"), &管理器值),
            根.连接(".rz/gen/src/sub/lib.rs")
        );
        断言相等!(
            入口产物路径(&根, &根.连接("lib.zh"), &管理器值),
            根.连接(".rz/gen/lib.rs")
        );
        断言!(!是否入口源(&根.连接("src/sub/lib.zh"), &根, &管理器值));
        // 库词没有母语别名（它不是关键字，各语言包都不翻译它）：
        // 写成母语库名只是普通模块，不会变成 包根
        断言相等!(
            入口产物路径(&根, &根.连接("src/库.zh"), &管理器值),
            根.连接(".rz/gen/src/库.rs")
        );

        // 旧配方：库路径指向托管目录，产物跟着声明走，不再另写默认 包根
        标准库::文件系统::写入(
            根.连接("Cargo.toml"),
            "[package]\nname = \"x\"\nversion = \"0.1.0\"\n\n[lib]\npath = \".rz/gen/src/lib.rs\"\n",
        )
        .解包();
        断言相等!(
            入口产物路径(&根, &根.连接("src/lib.zh"), &管理器值),
            根.连接(".rz/gen/src/lib.rs")
        );
        // 声明指向项目外时回退默认位置，不往项目外写文件
        标准库::文件系统::写入(
            根.连接("Cargo.toml"),
            "[package]\nname = \"x\"\nversion = \"0.1.0\"\n\n[lib]\npath = \"../outside.rs\"\n",
        )
        .解包();
        断言相等!(
            入口产物路径(&根, &根.连接("src/lib.zh"), &管理器值),
            根.连接("src/lib.rs")
        );
        // 主入口不受库路径影响（声明的是库，不是可执行程序）
        断言相等!(
            入口产物路径(&根, &根.连接("src/main.zh"), &管理器值),
            根.连接("src/main.rs")
        );
    }

    /// 入口产物落 包根后，托管目录里同一源文件的旧产物要清掉
    ///
    /// 只清「本次请求的入口文件」那一份：兄弟模块的托管产物仍在被模块路径注解引用。
    #[测试]
    函数 清理入口生成副本测试() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.文件路径方法().连接("proj");
        标准库::文件系统::创建所有目录(根.连接(".rz/gen/src")).解包();
        让 生成库 = 根.连接(".rz/gen/src/lib.rs");
        让 生成模块 = 根.连接(".rz/gen/src/数学.rs");
        标准库::文件系统::写入(&生成库, "陈旧产物").解包();
        标准库::文件系统::写入(&生成模块, "仍被引用").解包();
        清理入口生成副本(&根, &根.连接("src/lib.zh"), &根.连接("src/lib.rs"));
        断言!(!生成库.存在());
        断言!(生成模块.存在());
        // 落点就是托管路径时（清单声明了库路径）不能删——那是本次产物
        清理入口生成副本(&根, &根.连接("src/lib.zh"), &生成库);
        标准库::文件系统::写入(&生成库, "本次产物").解包();
        清理入口生成副本(&根, &根.连接("src/lib.zh"), &生成库);
        断言!(生成库.存在());
    }

    /// 越界写出回归：入口词干但不在项目源码目录直属的文件（子目录或示例
    /// 里恰好名为入口）不得聚合覆盖宿主入口产物，产物进托管目录的同名镜像路径。
    /// 对照：同时断言源码目录直属入口确实聚合（证明本测试真的在区分「直属」与
    /// 「子目录」，而非因目录不存在而两边都不聚合、造成假通过）。
    #[测试]
    函数 源码外入口不越界测试() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.文件路径方法().连接("proj");
        标准库::文件系统::创建所有目录(根.连接("src/sub")).解包();
        标准库::文件系统::创建所有目录(根.连接("examples")).解包();
        让 管理器值 = 中文管理器();
        // 对照：源码目录直属入口确实聚合
        断言相等!(
            入口产物路径(&根, &根.连接("src/main.zh"), &管理器值),
            根.连接("src/main.rs")
        );
        // 子目录入口不覆盖宿主入口
        断言相等!(
            入口产物路径(&根, &根.连接("src/sub/main.zh"), &管理器值),
            根.连接(".rz/gen/src/sub/main.rs")
        );
        // 示例入口不占用宿主入口
        断言相等!(
            入口产物路径(&根, &根.连接("examples/main.zh"), &管理器值),
            根.连接(".rz/gen/examples/main.rs")
        );
        // 母语主函数词但位于子目录同样不越界
        断言相等!(
            入口产物路径(&根, &根.连接("src/sub/主函数.zh"), &管理器值),
            根.连接(".rz/gen/src/sub/主函数.rs")
        );
    }

    /// 正向聚合：真实磁盘项目的源码目录直属入口（英文词干与母语词干）都聚合到
    /// 包根；相对词法路径（新建未落盘项目）按词法比较同样判定
    #[测试]
    函数 直属入口聚合测试() {
        让 管理器值 = 中文管理器();
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.文件路径方法().连接("proj");
        标准库::文件系统::创建所有目录(根.连接("src/sub")).解包();

        // 已落盘：真实目录的规范化比较
        断言相等!(
            入口产物路径(&根, &根.连接("src/main.zh"), &管理器值),
            根.连接("src/main.rs")
        );
        断言相等!(
            入口产物路径(&根, &根.连接("src/主函数.zh"), &管理器值),
            根.连接("src/main.rs")
        );
        // 同目录的非入口模块不聚合，且产物进托管目录
        断言相等!(
            入口产物路径(&根, &根.连接("src/工具.zh"), &管理器值),
            根.连接(".rz/gen/src/工具.rs")
        );

        // 未落盘：源码目录尚不存在，规范化双双失败退回词法路径，
        // 词干为入口时仍应聚合（编辑器里新建项目骨架的场景）
        让 幽灵根 = 临时.文件路径方法().连接("ghost-proj");
        断言相等!(
            入口产物路径(&幽灵根, &幽灵根.连接("src/main.zh"), &管理器值),
            幽灵根.连接("src/main.rs")
        );
        断言相等!(
            入口产物路径(&幽灵根, &幽灵根.连接("src/sub/main.zh"), &管理器值),
            幽灵根.连接(".rz/gen/src/sub/main.rs")
        );
    }

    /// 工具链通道探测：开发与持续集成环境必有编译器；主次版本号形如版本号，通道词原样
    #[测试]
    函数 探测工具链通道测试() {
        让 通道值 = 探测工具链通道().期望("测试环境应有 rustc");
        让 是版本号 = 通道值.分割一次('.').有值且(|(甲, 乙)| {
            !甲.是否为空()
                && !乙.是否为空()
                && 甲.逐字符().链式(乙.逐字符()).全部(|单字| 单字.是数字字符())
        });
        断言!(
            是版本号 || 模式匹配!(通道值.作为文本切片(), "nightly" | "beta"),
            "意外的通道格式：{通道值}"
        );
    }

    /// 已内置的语言包扩展名可解析出语言代码
    ///
    /// 持环境变量锁：扩展名映射会扫描全局语言包目录（受语言目录环境变量影响），
    /// 语言管理的环境变量测试并发修改该变量时会污染本测试
    #[测试]
    函数 内置扩展名语言代码测试() {
        让 _锁 = 包::语言管理::测试模块::环境锁();
        断言相等!(扩展名转语言代码("zh").作为解引用(), 有值("zh"));
        断言相等!(扩展名转语言代码("de").作为解引用(), 有值("de"));
        断言相等!(扩展名转语言代码("ru").作为解引用(), 有值("ru"));
        断言相等!(扩展名转语言代码("ja").作为解引用(), 有值("ja"));
        断言相等!(扩展名转语言代码("hi").作为解引用(), 有值("hi"));
    }

    /// 未知扩展名返回 `无`（同样受语言目录环境变量影响，需持锁）
    #[测试]
    函数 未知扩展名语言代码测试() {
        让 _锁 = 包::语言管理::测试模块::环境锁();
        断言相等!(扩展名转语言代码("xyz"), 无);
    }

    /// 统一转译管线：中文关键字转为标准 Rust
    #[测试]
    函数 中文关键字转译测试() {
        让 管理器值 = 中文管理器();
        让 输出文本 = 转译为英文("公开 函数 help() {}\n", &管理器值);
        断言!(输出文本.包含("pub fn help()"), "实际输出：{输出文本}");
    }

    /// 多文件转译：源码目录下的其他方言文件转译到托管目录，
    /// 入口与手写标准 Rust 不受影响；旧布局遗留在源文件旁的产物被清走；
    /// 跨文件声明豁免：其他文件声明的与映射词同名的成员不被替换
    #[测试]
    函数 项目文件转译测试() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.文件路径方法();
        标准库::文件系统::创建所有目录(根.连接("src")).解包();
        让 入口 = 根.连接("src/main.zh");
        // 跨文件调用本项目的函数（撞映射词）：
        // 项目上下文让调用位与声明侧一致（不被替换出英文原名）
        标准库::文件系统::写入(
            &入口,
            "模组 辅助;\n\n函数 main() {\n    让 x = 辅助::新建();\n}\n",
        )
        .解包();
        标准库::文件系统::写入(根.连接("src/辅助.zh"), "公开 函数 新建() {}\n").解包();
        标准库::文件系统::写入(根.连接("src/manual.rs"), "// 手写文件不覆盖\n").解包();
        // 旧布局遗留：本次已迁到托管目录，内容不同的同目录产物得备份后删除
        标准库::文件系统::写入(根.连接("src/辅助.rs"), "// 上一版旧产物\n").解包();

        让 管理器值 = 中文管理器();
        让 缓存 = 标准库::同步模块::互斥锁::新建(引擎库::缓存::转译缓存::新建诊断翻译器(8));
        // 项目级声明上下文：模块名（文件词干）与声明名（入口与源码目录全扫）
        让 上下文值 = 收集项目上下文(根, &入口, &管理器值);
        断言!(上下文值.模块集.包含("辅助"), "模块名应含文件名词干");
        断言!(上下文值.名字集.包含("新建"), "声明名应含其他文件的函数名");
        转译项目文件(根, &入口, &管理器值, &缓存, &上下文值).解包();

        // 其他方言文件已转译到托管目录（镜像源码布局）
        让 辅助产物 = 标准库::文件系统::读取字符串(根.连接(".rz/gen/src/辅助.rs")).解包();
        断言!(辅助产物.包含("pub fn 新建()"), "实际输出：{辅助产物}");
        // 旧布局遗留产物已从源码目录清走，旧内容备份
        断言!(
            !根.连接("src/辅助.rs").存在(),
            "旧布局遗留产物应已从源码目录迁走"
        );
        断言相等!(
            标准库::文件系统::读取字符串(根.连接("src/辅助.rs.bak")).解包(),
            "// 上一版旧产物\n",
            "内容与本次产物不同时得先备份"
        );
        // 手写标准 Rust 不被触碰
        让 手写产物 = 标准库::文件系统::读取字符串(根.连接("src/manual.rs")).解包();
        断言!(手写产物.包含("手写文件不覆盖"));
        // 入口文件未被重复转译（无入口产物产生，由调用方单独写入）
        断言!(!根.连接("src/main.rs").存在());

        // 入口转译（带项目上下文）：跨文件调用位不被替换
        让 入口产物文本 = 项目缓存转译(
            &标准库::文件系统::读取字符串(&入口).解包(),
            &管理器值,
            &可变 缓存.加锁().解包(),
            有值(&上下文值),
            "main.zh",
        )
        .转译产物文本;
        断言!(
            入口产物文本.包含("辅助::新建()"),
            "跨文件调用位应与声明侧一致：{入口产物文本}"
        );
    }

    /// 写入转译产物的备份语义（条件守卫）：目标存在且内容不同才备份为备份文件；
    /// 内容相同（幂等重跑）不产生备份，绝不静默覆盖用户文件
    #[测试]
    函数 转译产物备份测试() {
        让 目录 = 临时文件::建临时目录().解包();
        让 路径值 = 目录.文件路径方法().连接("main.rs");
        让 界面表 = 包::界面::界面消息表::按语言建表("zh");

        // 首次写入：文件不存在，直接写盘，无备份
        写入转译产物(&路径值, "v1", &界面表).解包();
        断言相等!(标准库::文件系统::读取字符串(&路径值).解包(), "v1");
        断言!(!路径值.设扩展名("rs.bak").存在());

        // 内容相同：幂等重跑，不产生备份，文件保持原内容
        写入转译产物(&路径值, "v1", &界面表).解包();
        断言!(!路径值.设扩展名("rs.bak").存在());

        // 内容不同：旧内容备份，文件更新为新内容
        写入转译产物(&路径值, "v2", &界面表).解包();
        断言相等!(标准库::文件系统::读取字符串(&路径值).解包(), "v2");
        断言相等!(
            标准库::文件系统::读取字符串(路径值.设扩展名("rs.bak")).解包(),
            "v1"
        );
    }

    /// 非 ASCII 文件式模块声明补模块路径注解（绕过编译器标识符限制）
    #[测试]
    函数 非母语模块注解测试() {
        让 输出文本 = 注解非母语模块("mod 数学;");
        断言相等!(输出文本, "#[path = \"数学.rs\"]\nmod 数学;");
    }

    /// 带公开可见性时注解插在可见性关键字之前
    #[测试]
    函数 公开模块注解测试() {
        让 输出文本 = 注解非母语模块("pub mod 数学;");
        断言相等!(输出文本, "#[path = \"数学.rs\"]\npub mod 数学;");
    }

    /// 英文模块名与内联模块块不处理
    #[测试]
    函数 跳过英文与内联模块测试() {
        断言相等!(注解非母语模块("mod math;"), "mod math;");
        断言相等!(注解非母语模块("mod 数学 { }"), "mod 数学 { }");
    }

    /// 已有模块路径注解时不重复添加；缩进保持
    #[测试]
    函数 已有注解与缩进测试() {
        让 源文本 = "#[path = \"数学.rs\"]\nmod 数学;";
        断言相等!(注解非母语模块(源文本), 源文本);
        让 输出文本 = 注解非母语模块("函数 main() {\n    mod 数学;\n}");
        断言相等!(
            输出文本,
            "函数 main() {\n    #[path = \"数学.rs\"]\n    mod 数学;\n}"
        );
    }

    /// 注解行映射：磁盘行到引擎直出行（从零起算），注解行归属其模块声明行，
    /// 多处注解时偏移逐处累积（对应多模块入口的诊断行号换算）
    #[测试]
    函数 注解行映射测试() {
        // 单处注解：磁盘第 0、1 行均归属引擎第 0 行
        让 (输出文本, 行映射) = 注解非母语模块并返回行映射("mod 数学;\nfn main() {}");
        断言相等!(输出文本, "#[path = \"数学.rs\"]\nmod 数学;\nfn main() {}");
        断言相等!(行映射, 向量![0, 0, 1]);

        // 无注解时映射恒等
        让 (_, 行映射二) = 注解非母语模块并返回行映射("fn main() {}\nfn f() {}");
        断言相等!(行映射二, 向量![0, 1]);

        // 两处注解：后续行偏移为 2
        让 两处 = "mod 数学;\nmod 物理;\nfn main() {}";
        让 (输出二, 行映射三) = 注解非母语模块并返回行映射(两处);
        断言相等!(
            输出二,
            "#[path = \"数学.rs\"]\nmod 数学;\n#[path = \"物理.rs\"]\nmod 物理;\nfn main() {}"
        );
        断言相等!(行映射三, 向量![0, 0, 1, 1, 2]);
    }

    /// 映射内容中按库名首段查找母语别名；连字符库名归一匹配
    #[测试]
    函数 映射别名查找测试() {
        让 映射文本 = "[\"模块路径\"]\n\"HTTP客户端\" = \"reqwest\"\n\"时间\" = \"chrono::prelude\"\n";
        断言相等!(
            查找映射别名(映射文本, "reqwest").作为解引用(),
            有值("HTTP客户端")
        );
        断言相等!(查找映射别名(映射文本, "chrono").作为解引用(), 有值("时间"));
        断言相等!(查找映射别名(映射文本, "tokio"), 无);
        断言相等!(
            查找映射别名(
                "[\"模块路径\"]\n\"序列化\" = \"serde-json\"\n",
                "serde_json"
            )
            .作为解引用(),
            有值("序列化")
        );
    }
}
