//! 多语言 Rust 教学方言编译器 CLI
//!
//! 提供 init / run / check / eject / lang / mapping 等子命令，
//! 将母语 Rust 源码实时转译为标准 Rust 并调用 cargo 编译/运行。

使用 clap::{FromArgMatches, Parser, Subcommand};
使用 i18n_rust_engine::映射管理::映射管理器;
使用 i18n_rust_engine::缓存::转译缓存;
使用 std::collections::{HashMap, HashSet};
使用 std::fs;
使用 std::io::{BufRead, BufReader};
使用 std::path::{Path, PathBuf};
使用 std::process::{Command, Stdio};

模块 内置语言;
模块 依赖注册表;
模块 诊断处理;
模块 组件安装;
模块 语言包工具;
模块 映射校验;
模块 覆盖审计;
// 目录模块：非 ASCII 模块名需显式路径注解（同 LSP 响应映射先例）
#[路径模块 = "映射生成器/mod.rs"]
模块 映射生成器;
模块 临时守护;
模块 本地化;

使用 诊断处理::{
    流式翻译器, 直调rustc检查, 直调rustc运行, 翻译cargo诊断, 能否直调rustc, 诊断上下文,
};
使用 语言包工具::语言来源;
// 非 ASCII 模块名 #[path] 注解：CLI 与 LSP 镜像共享同一引擎实现
使用 i18n_rust_engine::模块路径::{标注非西文模块, 标注非西文模块并行号};

#[派生(Parser)]
#[command(name = "rzc", version)]
// 兜底文案（本地化clap 会按界面语言覆盖）；用英文避免硬编码中文
#[command(about = "Multi-language Rust teaching dialect compiler")]
结构体 命令行参数集 {
    /// Suppress teaching lint hints (beginner code-style warnings; Unicode confusables / full-width punctuation warnings are unaffected)
    #[arg(long = "no-lint", global = true)]
    屏蔽教学提醒: 布尔,
    #[command(subcommand)]
    子命令实例: 顶层子命令,
}

#[派生(Subcommand)]
枚举 顶层子命令 {
    #[command(name = "init")]
    初始化项目 {
        #[arg(value_name = "PROJECT_NAME")]
        项目名: 字符串,
        // 缺省跟随系统 locale（LC_ALL/LANG）：全球用户的第一个项目应是自己的母语
        #[arg(short = 'l', long = "lang", default_value_t = 映射生成器::检测系统语言())]
        语言代码: 字符串,
    },
    #[command(name = "run")]
    运行项目 {
        #[arg(value_name = "FILE")]
        目标文件: PathBuf,
        #[arg(short = 'l', long = "lang-pack")]
        语言包路径: 选项<PathBuf>,
    },
    #[command(name = "check")]
    检查项目 {
        #[arg(value_name = "FILE")]
        目标文件: PathBuf,
        #[arg(short = 'l', long = "lang-pack")]
        语言包路径: 选项<PathBuf>,
        /// Auto-fix full-width punctuation (writes to the source file; only characters with a half-width counterpart are converted)
        #[arg(long = "fix")]
        修复标点: 布尔,
    },
    #[command(name = "eject")]
    弹出代码 {
        #[arg(value_name = "FILE")]
        目标文件: PathBuf,
        #[arg(short = 'l', long = "lang-pack")]
        语言包路径: 选项<PathBuf>,
    },
    /// Transpile preview: convert dialect source to standard Rust and print to stdout (no files written)
    #[command(name = "transpile")]
    转译预览 {
        #[arg(value_name = "FILE")]
        目标文件: PathBuf,
        #[arg(short = 'l', long = "lang-pack")]
        语言包路径: 选项<PathBuf>,
    },
    /// Add third-party dependencies to the current project (wraps cargo add, with native-language mapping hints)
    #[command(name = "add")]
    添加依赖 {
        /// crate name or name@version, repeatable (e.g. serde tokio@1)
        #[arg(required = true, value_name = "CRATES")]
        依赖名单: Vec<字符串>,
    },
    /// Language pack management (list / install / remove)
    #[command(name = "lang")]
    语言包管理 {
        #[command(subcommand)]
        子命令实例: 语言包子命令,
    },
    /// Generate third-party crate mappings (extract APIs from installed crates)
    #[command(name = "mapping")]
    映射生成 {
        #[command(subcommand)]
        子命令实例: 映射生成子命令,
    },
    /// Shared third-party crate registry (search / install / list / remove / update / publish)
    #[command(name = "crate")]
    依赖仓库 {
        #[command(subcommand)]
        子命令实例: 依赖仓库子命令,
    },
    /// Install companion components (language server i18n-rust-lsp, etc.)
    #[command(name = "install")]
    安装组件 {
        #[command(subcommand)]
        子命令实例: 选项<组件安装子命令>,
    },
    /// Diagnose the toolchain environment: bundled toolchain / PATH / version comparison
    #[command(name = "doctor")]
    环境体检,
    /// Native-language ↔ Rust mapping cheat sheet (keywords / module paths / aliases / derive traits)
    #[command(name = "cheat")]
    速查表 {
        /// Built-in language code (e.g. zh) or a language-pack directory path; auto-detected from the system language when omitted
        #[arg(value_name = "LANG")]
        语言代码: 选项<字符串>,
        /// Output as a Markdown table for embedding into docs
        #[arg(long = "markdown")]
        表格模式: 布尔,
    },
}

#[派生(Subcommand)]
枚举 组件安装子命令 {
    /// Install the language server i18n-rust-lsp (completion / diagnostics backend for the VS Code extension)
    #[command(name = "lsp")]
    语言服务器 {
        /// Force overwrite if already installed
        #[arg(short = 'f', long = "force")]
        强制覆盖: 布尔,
    },
    /// One-click install of the bundled toolchain (standalone rustc/cargo/rust-analyzer, no rustup required)
    #[command(name = "toolchain")]
    工具链套装 {
        /// Toolchain version (defaults to the version rzc is locked to, e.g. 1.98.0)
        #[arg(long = "version", default_value = i18n_rust_engine::工具链::锁定工具链版本)]
        工具链版本号: 字符串,
        /// Official rust-analyzer release tag (defaults to the locked version)
        #[arg(long = "ra-tag", default_value = crate::组件安装::分析器发布标签)]
        分析器发布标签: 字符串,
        /// Upgrade rust-analyzer only (skip the ~300 MB rustc/cargo re-download)
        #[arg(long = "ra-only")]
        仅更新分析器: 布尔,
        /// Force reinstall if already installed
        #[arg(short = 'f', long = "force")]
        强制覆盖: 布尔,
    },
}

#[派生(Subcommand)]
枚举 映射生成子命令 {
    /// Auto-generate third-party crate mapping files: extract the crate's public API; AI or rules generate names and explanations in the target language
    #[command(name = "auto")]
    自动生成 {
        /// Target crate name (must be installed or available from crates.io)
        #[arg(value_name = "CRATE_NAME")]
        依赖包名: 字符串,
        /// Target language (language-pack directory name, e.g. zh, ru; auto-detected from the system language by default)
        #[arg(long = "lang")]
        语言代码: 选项<字符串>,
        /// AI provider: deepseek (default; requires the DEEPSEEK_API_KEY environment variable) or rule (offline rule mode)
        #[arg(long = "provider", default_value = "deepseek")]
        生成提供方: 字符串,
        /// Pin the target crate version (e.g. 2.11.5 exact; 2.11 / 2 = latest in that line); uses the latest when omitted (not reproducible)
        #[arg(long = "target-version")]
        目标版本: 选项<字符串>,
        /// Output file path (defaults to the project language-pack root: <lang>/crates/<crate_name>.toml)
        #[arg(long = "output")]
        输出路径: 选项<PathBuf>,
        /// Also add the crate to the current project's Cargo.toml after generating mappings (cargo add)
        #[arg(long = "install")]
        同时添加依赖: 布尔,
    },
    /// Validate third-party crate mapping quality: duplicate keys / keyword avoidance / cross-file conflicts / entry-count consistency
    #[command(name = "check")]
    检查质量 {
        /// Built-in language code (e.g. zh) or a language-pack directory path; validates all built-in languages when omitted
        #[arg(value_name = "TARGET")]
        目标语言: 选项<字符串>,
    },
    /// Corpus coverage matrix: validate language-pack keyword/API coverage against real backend sources; lists missing native-language mappings
    #[command(name = "coverage")]
    覆盖矩阵 {
        /// Built-in language code (e.g. zh); checks all built-in languages when omitted
        #[arg(long = "lang")]
        语言代码: 选项<字符串>,
    },
    /// Generate a translation skeleton for the target language from the source-language crates mappings (keys kept for translation, English values unchanged)
    #[command(name = "scaffold")]
    生成骨架 {
        /// Source language code (a built-in language, e.g. zh)
        #[arg(value_name = "SOURCE")]
        源语言: 字符串,
        /// Target language code (new language-pack directory name, e.g. vi)
        #[arg(value_name = "TARGET")]
        目标语言: 字符串,
        /// Output directory (defaults to the project language-pack root: <target>/crates/)
        #[arg(long = "output")]
        输出路径: 选项<PathBuf>,
        /// Translation mode: rule (default; generates a TODO skeleton for manual translation) or deepseek (AI translates keys; requires DEEPSEEK_API_KEY)
        #[arg(long = "provider", default_value = "rule")]
        生成提供方: 字符串,
    },
}

#[派生(Subcommand)]
枚举 依赖仓库子命令 {
    /// Search third-party crate mappings published in the registry (optional keyword filter)
    #[command(name = "search")]
    搜索映射 {
        /// Keyword (matches crate name / language / author); lists everything when omitted (sorted by downloads)
        #[arg(value_name = "KEYWORD")]
        搜索关键词: 选项<字符串>,
    },
    /// Install a single third-party crate mapping: copy it from the registry into the global language pack
    #[command(name = "install")]
    安装映射 {
        /// Crate name (hyphens normalized to underscores)
        #[arg(value_name = "CRATE_NAME")]
        依赖包名: 字符串,
        /// Target language code (e.g. zh)
        #[arg(long = "lang")]
        语言代码: 字符串,
        /// Force overwrite if already installed
        #[arg(short = 'f', long = "force")]
        强制覆盖: 布尔,
    },
    /// List installed community mappings
    #[command(name = "list")]
    列出映射,
    /// Remove an installed community mapping (from the global language pack and the manifest)
    #[command(name = "remove")]
    移除映射 {
        /// Crate name
        #[arg(value_name = "CRATE_NAME")]
        依赖包名: 字符串,
        /// Language code
        #[arg(long = "lang")]
        语言代码: 字符串,
    },
    /// Re-fetch all mappings according to the installed manifest (pick up others' updates)
    #[command(name = "update")]
    更新映射,
    /// Publish a local mapping to the registry (quality gate runs first)
    #[command(name = "publish")]
    发布映射 {
        /// Crate name
        #[arg(value_name = "CRATE_NAME")]
        依赖包名: 字符串,
        /// Language code
        #[arg(long = "lang")]
        语言代码: 字符串,
        /// Mapping file path (when omitted, searched in common locations: global/project language pack or the current directory)
        #[arg(long = "file")]
        目标文件: 选项<PathBuf>,
        /// Translator credit (defaults to git user.name)
        #[arg(long = "author")]
        译者署名: 选项<字符串>,
    },
}

#[派生(Subcommand)]
枚举 语言包子命令 {
    /// List all installed language packs (built-in + user-installed)
    #[command(name = "list")]
    列出语言包,
    /// Install a language pack: a local directory path is copied directly; a language code is downloaded from the remote repository
    #[command(name = "install")]
    安装语言包 {
        /// Local language-pack directory path, or a remote language code
        #[arg(value_name = "SOURCE")]
        语言包来源: 字符串,
        /// Force overwrite if already installed
        #[arg(short = 'f', long = "force")]
        强制覆盖: 布尔,
    },
    /// Remove a user-installed language pack (built-in packs cannot be removed)
    #[command(name = "remove")]
    移除语言包 {
        /// Language code (language-pack directory name)
        #[arg(value_name = "LANG_CODE")]
        语言代码: 字符串,
    },
    /// Browse the remote language-pack marketplace (scan the remote repository; optional keyword filter)
    #[command(name = "search")]
    搜索语言包 {
        /// Keyword (matches language code or display name); lists all remote packs when omitted
        #[arg(value_name = "KEYWORD")]
        搜索关键词: 选项<字符串>,
    },
}

函数 main() -> std::process::ExitCode {
    使用 std::io::{IsTerminal, Read};
    // Windows 双击 rzc.exe（无参数且 stdout 是终端）：显示环境安装向导（逐项检查
    // 组件状态与解决方式）并停留，避免黑窗一闪而过。用 stdout 检测（双击时 stdout
    // 连控制台）而非 stdin（双击场景 stdin 句柄可能无效，read 立即 EOF 导致秒关）；
    // stdin 读取失败时停留数秒兜底。管道/重定向场景 stdout 非终端，走正常流程。
    如果 std::env::args().len() == 1 && std::io::stdout().is_terminal() {
        组件安装::显示安装向导();
        println!();
        println!("按任意键退出...");
        让 可变 缓冲 = [0u8; 1];
        如果 std::io::stdin().read_exact(&可变 缓冲).is_err() {
            std::thread::sleep(std::time::Duration::from_secs(8));
        }
        返回 std::process::ExitCode::SUCCESS;
    }
    匹配 执行() {
        成功(码) => 码,
        错误(错) => {
            eprintln!("Error: {错:#}");
            std::process::ExitCode::FAILURE
        }
    }
}

函数 执行() -> anyhow::结果<std::process::ExitCode> {
    // 按当前界面语言本地化 clap 帮助文本
    让 界面 = 本地化::界面::全局();
    // 同步引擎全局语言（错误/诊断/日志随界面语言输出）
    i18n_rust_engine::语言::设定语言(&本地化::检测界面语言());
    让 命令行 = 本地化clap(&界面);
    // clap 自身错误（--help/--version 输出、非法参数等）按 clap 退出码直接退出
    让 参数集 = 匹配 命令行参数集::from_arg_matches(&命令行.get_matches()) {
        成功(参数集) => 参数集,
        错误(错) => 错.exit(),
    };

    // `--no-lint`：项目开发（非教学）场景静默教学 lint（初学者代码风格提示，
    // 每次转译刷屏）；Unicode 混淆/全角标点告警不受影响
    如果 参数集.屏蔽教学提醒 {
        i18n_rust_engine::教学检查::设定教学检查开关(假);
    }

    // 首次运行引导：终端交互场景下，首次执行教学核心命令时打印
    // 欢迎语与环境检查（rustc 缺失提示 + 下一步建议），仅一次
    // （~/.rz/first-run 标记文件）；CI/管道等非终端场景自动跳过。
    匹配 &参数集.子命令实例 {
        顶层子命令::运行项目 { .. } | 顶层子命令::检查项目 { .. } | 顶层子命令::初始化项目 { .. } => {
            显示首次运行引导(&界面);
        }
        _ => {}
    }

    匹配 参数集.子命令实例 {
        顶层子命令::初始化项目 { 项目名, 语言代码 } => {
            i18n_rust_engine::语言::设定语言(&语言代码);
            创建项目(&项目名, &语言代码)?;
            成功(std::process::ExitCode::SUCCESS)
        }
        顶层子命令::运行项目 { 目标文件, 语言包路径 } => {
            让 界面 = 界面按文件(&目标文件, &语言包路径);
            让 源码 = fs::read_to_string(&目标文件)?;
            让 管理器 = 加载映射(语言包路径.clone(), 有值(&目标文件))?;
            让 项目根 = 定位项目根(&目标文件)?;
            // 项目级声明上下文（跨文件声明豁免）：扫描 src/ 全部方言文件 +
            // 入口，收集模块名与声明名；入口文件、项目内文件与诊断重放
            // 共享同一上下文（否则跨文件调用的成员名被当库别名替换，E0599）
            让 项目上下文 = 收集项目上下文(&项目根, &目标文件, &管理器);
            // 入口文件写入 src/main.rs 作为编译目标；会话缓存贯穿入口文件与
            // 项目内其他文件（并行转译共享命中，见 转译项目文件）
            让 源码路径 = 入口产物路径(&项目根, &目标文件, &管理器);
            让 缓存 = std::sync::Mutex::new(i18n_rust_engine::缓存::转译缓存::持久默认项());
            让 转译产物 = 项目转译映射带缓存(
                &源码,
                &管理器,
                &可变 缓存
                    .lock()
                    .unwrap_or_else(std::sync::PoisonError::into_inner),
                有值(&项目上下文),
            );
            // 列映射：把 rustc 诊断的英文产物列号回译到母语源码列号
            让 列映射 =
                i18n_rust_engine::列映射::列映射表::r#构建(&源码, &转译产物.管线映射);
            // 写盘产物含 `#[path]` 注解插入行：保留行映射供诊断回译先行换算
            让 (注解产物, 入口行映射) = 标注非西文模块并行号(&转译产物.产出);
            写入转译产物(&源码路径, &注解产物, &界面)?;
            // 同步转译项目内其他方言文件，保证多文件项目的 mod 引用链可用
            转译项目文件(&项目根, &目标文件, &管理器, &缓存, &项目上下文)?;

            // 单文件项目直调 rustc：绕开 cargo 的索引/项目结构（教学单文件
            // 场景编译更快、无网络索引问题）；多文件/有依赖项目回退 cargo
            如果 能否直调rustc(&项目根, &目标文件) {
                返回 直调rustc运行(
                    &界面,
                    &项目根,
                    &源码路径,
                    &语言包路径,
                    &管理器,
                    &源码,
                    &目标文件,
                    &列映射,
                    &入口行映射,
                    &项目上下文,
                );
            }

            // --message-format=json：编译诊断（warning/error）走 JSON 行翻译，
            // 程序自身 stdout/stderr 原样透传（cargo 不包装子进程输出），
            // 避免英文警告与程序输出混淆，也无需二次编译。
            让 可变 子进程 = Command::new(解析cargo路径())
                .args(["run", "--message-format=json"])
                .current_dir(&项目根)
                .stdin(Stdio::inherit())
                .stdout(Stdio::piped())
                .stderr(Stdio::piped())
                .spawn()
                .map_err(|错| {
                    anyhow::anyhow!(
                        "{}",
                        界面.取文带参(
                            "cargo_run_failed",
                            &[&项目根.display().to_string(), &错.to_string()]
                        )
                    )
                })?;
            让 标准输出 = 子进程
                .stdout
                .take()
                .ok_or_else(|| anyhow::anyhow!("cargo run stdout 管道不可用"))?;
            // stderr 线程逐行翻译：cargo 进度（Compiling/Finished 等）与程序
            // panic 输出本地化，其余行（程序普通 stderr）原样透传
            让 错误输出管道 = 子进程
                .stderr
                .take()
                .ok_or_else(|| anyhow::anyhow!("cargo run stderr 管道不可用"))?;
            让 错误输出线程 = std::thread::spawn(move || {
                让 界面 = 本地化::界面::全局();
                让 可变 翻译器 = 流式翻译器::r#新建();
                让 读取器 = BufReader::new(错误输出管道);
                对于 文本行 in 读取器.lines() {
                    匹配 文本行 {
                        成功(文本行) => eprintln!("{}", 翻译器.翻译一行(&文本行, &界面)),
                        错误(_) => 中断,
                    }
                }
            });
            让 读取器 = BufReader::new(标准输出);
            // 收集 cargo JSON 诊断行（含 reason 字段），其余行视为程序输出原样透传
            让 可变 诊断文本行 = 字符串::new();
            对于 文本行 in 读取器.lines() {
                让 文本行 = 文本行.map_err(|错| {
                    anyhow::anyhow!(
                        "{}",
                        界面.取文带参(
                            "cargo_run_failed",
                            &[&项目根.display().to_string(), &错.to_string()]
                        )
                    )
                })?;
                如果 文本行.starts_with('{')
                    && 让 成功(值) = serde_json::from_str::<serde_json::Value>(&文本行)
                    && 值.get("reason").is_some()
                {
                    诊断文本行.push_str(&文本行);
                    诊断文本行.push('\n');
                    继续;
                }
                println!("{文本行}");
            }
            让 状态 = 子进程.wait().map_err(|错| {
                anyhow::anyhow!(
                    "{}",
                    界面.取文带参(
                        "cargo_run_failed",
                        &[&项目根.display().to_string(), &错.to_string()]
                    )
                )
            })?;
            让 _ = 错误输出线程.join();

            // 编译诊断翻译（warning/error 均覆盖）；
            // 无诊断且成功时静默（程序已运行，不再提示编译状态）
            如果 !诊断文本行.is_empty() {
                让 _ = 翻译cargo诊断(
                    &诊断文本行,
                    "",
                    &诊断上下文 {
                        界面: &界面,
                        语言包: &语言包路径,
                        项目根: &项目根,
                        管理器: &管理器,
                        源码: &源码,
                        入口文件: &目标文件,
                        列映射: 有值(&列映射),
                        入口行映射: 有值(&入口行映射),
                        项目: 有值(&项目上下文),
                    },
                    状态.success(),
                    真,
                    // 输出已实时透传：构建成功而程序运行失败（如 panic）时
                    // 不补打“编译错误”标签
                    真,
                );
            }

            // 传播被运行程序的退出码（信号终止等无码场景回退 1）
            成功(状态
                .code()
                .map(|码| std::process::ExitCode::from(码 as u8))
                .unwrap_or(std::process::ExitCode::FAILURE))
        }
        顶层子命令::检查项目 {
            目标文件,
            语言包路径,
            修复标点,
        } => {
            让 界面 = 界面按文件(&目标文件, &语言包路径);
            让 可变 源码 = fs::read_to_string(&目标文件)?;
            // 全角标点教学修复：中文输入法下最常见的编译错误来源之一。
            // --fix 时自动将代码位置（字符串/注释内除外）的全角标点改写为半角，
            // 并提示剩余需人工修改的字符（顿号/全角空格等）；
            // 不带 --fix 时警告由转译管线（log_warn）自动输出。
            如果 修复标点 {
                让 (修复文本, 数量) = i18n_rust_engine::全角标点::修复全角标点(&源码);
                如果 数量 > 0 {
                    fs::write(&目标文件, &修复文本)?;
                    源码 = 修复文本;
                    println!(
                        "{}",
                        界面.取文带参(
                            "fullwidth_fix_done",
                            &[&数量.to_string(), &目标文件.display().to_string()]
                        )
                    );
                }
                让 剩余 = i18n_rust_engine::全角标点::查找全角标点(&源码).len();
                如果 剩余 > 0 {
                    println!(
                        "{}",
                        界面.取文带参("fullwidth_fix_remaining", &[&剩余.to_string()])
                    );
                }
            }
            让 管理器 = 加载映射(语言包路径.clone(), 有值(&目标文件))?;
            让 项目根 = 定位项目根(&目标文件)?;
            // 项目级声明上下文（跨文件声明豁免，同 run）
            让 项目上下文 = 收集项目上下文(&项目根, &目标文件, &管理器);
            让 源码路径 = 入口产物路径(&项目根, &目标文件, &管理器);
            让 缓存 = std::sync::Mutex::new(i18n_rust_engine::缓存::转译缓存::持久默认项());
            让 转译产物 = 项目转译映射带缓存(
                &源码,
                &管理器,
                &可变 缓存
                    .lock()
                    .unwrap_or_else(std::sync::PoisonError::into_inner),
                有值(&项目上下文),
            );
            // 列映射：把 rustc 诊断的英文产物列号回译到母语源码列号
            让 列映射 =
                i18n_rust_engine::列映射::列映射表::r#构建(&源码, &转译产物.管线映射);
            // 写盘产物含 `#[path]` 注解插入行：保留行映射供诊断回译先行换算
            让 (注解产物, 入口行映射) = 标注非西文模块并行号(&转译产物.产出);
            写入转译产物(&源码路径, &注解产物, &界面)?;
            // 同步转译项目内其他方言文件，保证多文件项目的 mod 引用链可用
            转译项目文件(&项目根, &目标文件, &管理器, &缓存, &项目上下文)?;

            // 单文件项目直调 rustc（绕开 cargo）；多文件/有依赖项目回退 cargo
            如果 能否直调rustc(&项目根, &目标文件) {
                返回 直调rustc检查(
                    &界面,
                    &项目根,
                    &源码路径,
                    &语言包路径,
                    &管理器,
                    &源码,
                    &目标文件,
                    &列映射,
                    &入口行映射,
                    &项目上下文,
                );
            }

            让 输出结果 = Command::new(解析cargo路径())
                .arg("check")
                .arg("--message-format=json")
                .current_dir(&项目根)
                .output()
                .map_err(|错| {
                    anyhow::anyhow!(
                        "{}",
                        界面.取文带参(
                            "cargo_check_failed",
                            &[&项目根.display().to_string(), &错.to_string()]
                        )
                    )
                })?;
            // cargo 整体是否成功（决定最终退出码）
            让 退出码 = 如果 输出结果.status.success() {
                std::process::ExitCode::SUCCESS
            } 否则 {
                std::process::ExitCode::FAILURE
            };

            // 结构化诊断翻译（与 run 编译失败路径共用同一管线）
            让 错误文本 = 字符串::from_utf8_lossy(&输出结果.stderr).to_string();
            让 引擎输出 = 格式化!(
                "{}\n{}",
                字符串::from_utf8_lossy(&输出结果.stdout),
                错误文本
            );
            让 _ = 翻译cargo诊断(
                &引擎输出,
                &错误文本,
                &诊断上下文 {
                    界面: &界面,
                    语言包: &语言包路径,
                    项目根: &项目根,
                    管理器: &管理器,
                    源码: &源码,
                    入口文件: &目标文件,
                    列映射: 有值(&列映射),
                    入口行映射: 有值(&入口行映射),
                    项目: 有值(&项目上下文),
                },
                输出结果.status.success(),
                假, // check 场景：无诊断且成功时提示"编译成功"
                假, // check：诊断输出由本函数负责（非流式透传）
            );
            成功(退出码)
        }
        顶层子命令::弹出代码 { 目标文件, 语言包路径 } => {
            让 界面 = 界面按文件(&目标文件, &语言包路径);
            让 源码 = fs::read_to_string(&目标文件)?;
            让 管理器 = 加载映射(语言包路径, 有值(&目标文件))?;
            让 英文代码 = 转译为英文(&源码, &管理器);
            让 输出路径 = 目标文件.with_extension("rs");
            fs::write(&输出路径, 英文代码)?;
            println!(
                "{}",
                界面.取文带参("exported_to", &[&输出路径.display().to_string()])
            );
            成功(std::process::ExitCode::SUCCESS)
        }
        顶层子命令::转译预览 { 目标文件, 语言包路径 } => {
            // 转译预览：仅输出到 stdout，不产生任何文件（与 eject 互补）
            让 界面 = 界面按文件(&目标文件, &语言包路径);
            让 源码 = fs::read_to_string(&目标文件)?;
            让 管理器 = 加载映射(语言包路径, 有值(&目标文件))?;
            让 英文代码 = 转译为英文(&源码, &管理器);
            print!("{英文代码}");
            让 _ = 界面; // stdout 模式无需额外提示
            成功(std::process::ExitCode::SUCCESS)
        }
        顶层子命令::安装组件 { 子命令实例 } => {
            // 省略子命令时默认安装全部组件（当前仅语言服务器）
            匹配 子命令实例.unwrap_or(组件安装子命令::语言服务器 { 强制覆盖: 假 }) {
                组件安装子命令::语言服务器 { 强制覆盖 } => 组件安装::安装语言服务器(&界面, 强制覆盖)?,
                组件安装子命令::工具链套装 {
                    工具链版本号,
                    分析器发布标签,
                    仅更新分析器,
                    强制覆盖,
                } => 组件安装::安装工具链(&界面, &工具链版本号, &分析器发布标签, 强制覆盖, 仅更新分析器)?,
            }
            成功(std::process::ExitCode::SUCCESS)
        }
        顶层子命令::环境体检 => 组件安装::诊断环境().map(|()| std::process::ExitCode::SUCCESS),
        顶层子命令::速查表 { 语言代码, 表格模式 } => {
            让 语言代码 = 语言代码.clone().unwrap_or_else(映射生成器::检测系统语言);
            // 速查表标题固定英文：全球用户的第一张卡不依赖界面语言
            i18n_rust_engine::语言::设定语言(&语言代码);
            让 虚拟源码 = PathBuf::from(格式化!("main.{语言代码}"));
            // 借虚拟扩展名让 加载映射 走既有解析链（项目内 → 全局 → 内置语言包）
            让 管理器 = 加载映射(无, 有值(&虚拟源码))?;
            打印速查表(&管理器, &语言代码, 表格模式);
            成功(std::process::ExitCode::SUCCESS)
        }
        顶层子命令::语言包管理 { 子命令实例 } => {
            处理语言子命令(子命令实例).map(|()| std::process::ExitCode::SUCCESS)
        }
        顶层子命令::添加依赖 { 依赖名单 } => 处理添加子命令(&依赖名单),
        顶层子命令::映射生成 { 子命令实例 } => 匹配 子命令实例 {
            映射生成子命令::自动生成 {
                依赖包名,
                语言代码,
                生成提供方,
                目标版本,
                输出路径,
                同时添加依赖,
            } => {
                让 语言代码 = 语言代码.unwrap_or_else(映射生成器::检测系统语言);
                i18n_rust_engine::语言::设定语言(&语言代码);
                让 输出路径 = 输出路径.unwrap_or_else(|| {
                    // 默认写入项目语言包根：从 cwd 向上找 Cargo.toml，
                    // 保证任意子目录下执行都落到项目本地语言包（加载映射 同一位置查找）；
                    // 主仓库内落到 crates/engine/lang-packs/（单一数据源），用户项目落 lang-packs/
                    让 基础目录 = std::env::current_dir()
                        .ok()
                        .and_then(|工作目录| 向上定位项目根(&工作目录))
                        .unwrap_or_else(|| PathBuf::from("."));
                    语言包根目录(&基础目录).join(格式化!("{}/crates/{}.toml", 语言代码, 依赖包名))
                });
                映射生成器::运行自动生成(
                    &依赖包名,
                    &语言代码,
                    &生成提供方,
                    &输出路径,
                    目标版本.as_deref(),
                )
                .map(|()| std::process::ExitCode::SUCCESS)
                .inspect(|_| {
                    // --install：生成成功后把 crate 加入当前项目依赖（用户项目内执行时）
                    如果 同时添加依赖 {
                        安装依赖到当前项目(&依赖包名, 目标版本.as_deref());
                    }
                    // 生成后自动对所在语言包跑一次冲突检测（仅提示，不改变退出码：
                    // 语言包可能存在历史遗留问题，生成成功与否以写入结果为准）
                    如果 让 有值(语言目录) = 输出路径.parent().and_then(|父| 父.parent())
                        && 语言目录.join("keywords.toml").exists()
                        && 让 有值(目录串) = 语言目录.to_str()
                    {
                        让 _ = 映射校验::运行校验(有值(目录串));
                    }
                })
            }
            映射生成子命令::检查质量 { 目标语言 } => {
                // check 输出的语言默认跟随系统语言
                让 语言代码 = 映射生成器::检测系统语言();
                i18n_rust_engine::语言::设定语言(&语言代码);
                匹配 映射校验::运行校验(目标语言.as_deref()) {
                    成功(真) => 成功(std::process::ExitCode::SUCCESS),
                    成功(假) => 成功(std::process::ExitCode::FAILURE),
                    错误(错) => 错误(错),
                }
            }
            映射生成子命令::覆盖矩阵 { 语言代码 } => {
                // coverage 输出的语言默认跟随系统语言
                让 界面语言 = 映射生成器::检测系统语言();
                i18n_rust_engine::语言::设定语言(&界面语言);
                匹配 覆盖审计::运行覆盖(语言代码.as_deref()) {
                    成功(真) => 成功(std::process::ExitCode::SUCCESS),
                    成功(假) => 成功(std::process::ExitCode::FAILURE),
                    错误(错) => 错误(错),
                }
            }
            映射生成子命令::生成骨架 {
                源语言,
                目标语言,
                输出路径,
                生成提供方,
            } => {
                让 语言代码 = 映射生成器::检测系统语言();
                i18n_rust_engine::语言::设定语言(&语言代码);
                映射校验::运行脚手架(&源语言, &目标语言, 输出路径.as_deref(), &生成提供方)
                    .map(|()| std::process::ExitCode::SUCCESS)
            }
        },
        顶层子命令::依赖仓库 { 子命令实例 } => 匹配 子命令实例 {
            依赖仓库子命令::搜索映射 { 搜索关键词 } => 依赖注册表::检索映射(搜索关键词.as_deref())
                .map(|()| std::process::ExitCode::SUCCESS),
            依赖仓库子命令::安装映射 {
                依赖包名,
                语言代码,
                强制覆盖,
            } => 依赖注册表::安装映射(&依赖包名, &语言代码, 强制覆盖)
                .map(|()| std::process::ExitCode::SUCCESS),
            依赖仓库子命令::列出映射 => {
                依赖注册表::列出映射().map(|()| std::process::ExitCode::SUCCESS)
            }
            依赖仓库子命令::移除映射 { 依赖包名, 语言代码 } => {
                依赖注册表::移除映射(&依赖包名, &语言代码)
                    .map(|()| std::process::ExitCode::SUCCESS)
            }
            依赖仓库子命令::更新映射 => {
                依赖注册表::刷新映射().map(|()| std::process::ExitCode::SUCCESS)
            }
            依赖仓库子命令::发布映射 {
                依赖包名,
                语言代码,
                目标文件,
                译者署名,
            } => 依赖注册表::发布映射(&依赖包名, &语言代码, 目标文件, 译者署名.as_deref())
                .map(|()| std::process::ExitCode::SUCCESS),
        },
    }
}

/// 首次运行引导：欢迎 + rustc 缺失提示 + 下一步建议
///
/// 仅交互终端（stdout 是终端）且标记文件不存在时显示；
/// 显示后写入标记文件，保证每个用户只看到一次。
函数 显示首次运行引导(界面: &本地化::界面) {
    使用 std::io::IsTerminal;
    如果 !std::io::stdout().is_terminal() {
        返回;
    }
    // 与 语言包工具::全局语言目录 相同的跨平台主目录解析
    让 主目录 = std::env::var("HOME")
        .or_else(|_| std::env::var("USERPROFILE"))
        .ok();
    让 标记文件 = 主目录.map(|首| PathBuf::from(首).join(".rz").join("first-run"));
    如果 让 有值(标记文件) = &标记文件
        && 标记文件.exists()
    {
        返回;
    }
    println!();
    println!("{}", 界面.取文("first_run_hello"));
    // rustc 检测：内置工具链目录或 PATH（含 rustc.exe/rustc）任一命中
    让 rustc就绪 = i18n_rust_engine::工具链::查找工具链程序("rustc").is_some()
        || std::env::var_os("PATH").is_some_and(|路径| {
            std::env::split_paths(&路径).any(|目录| {
                让 可执行 = 如果 cfg!(windows) { "rustc.exe" } 否则 { "rustc" };
                目录.join(可执行).exists()
            })
        });
    如果 !rustc就绪 {
        println!("{}", 界面.取文("first_run_rustc_missing"));
    }
    println!("{}", 界面.取文("first_run_next_steps"));
    println!();
    如果 让 有值(标记文件) = 标记文件 {
        如果 让 有值(父目录) = 标记文件.parent() {
            让 _ = std::fs::create_dir_all(父目录);
        }
        让 _ = std::fs::write(标记文件, "");
    }
}

/// 处理 `rzc lang` 子命令
函数 处理语言子命令(子命令: 语言包子命令) -> anyhow::结果<()> {
    让 界面 = 本地化::界面::全局();
    匹配 子命令 {
        语言包子命令::列出语言包 => {
            让 列表 = 语言包工具::列语言();
            如果 列表.is_empty() {
                println!("{}", 界面.取文("no_lang_installed"));
                返回 成功(());
            }
            println!(
                "{}",
                界面.取文带参("installed_langs_count", &[&列表.len().to_string()])
            );
            对于 信息 in &列表 {
                让 标签 = 匹配 信息.语言来源 {
                    语言来源::内置 => 界面.取文("tag_builtin"),
                    语言来源::用户安装 => 界面.取文("tag_user"),
                };
                让 扩展名 = 信息
                    .文件扩展名
                    .as_deref()
                    .map(|后| 格式化!(".{}", 后))
                    .unwrap_or_else(|| 界面.取文("unknown"));
                让 版本 = 匹配 信息.版本号.as_deref() {
                    有值(版本值项) => 版本值项.to_string(),
                    无 => 界面.取文("unknown"),
                };
                让 可删除 = 如果 信息.语言来源 == 语言来源::内置 {
                    界面.取文("not_removable")
                } 否则 {
                    字符串::new()
                };
                让 显示名 = 信息
                    .显示名称
                    .as_deref()
                    .map(|名| 格式化!("{} ({})", 名, 信息.语言代码))
                    .unwrap_or_else(|| 信息.语言代码.clone());
                println!(
                    "{}",
                    界面.取文带参(
                        "lang_list_display",
                        &[&标签, &显示名, &扩展名, &版本, &可删除]
                    )
                );
            }
            println!(
                "{}",
                界面.取文带参(
                    "global_lang_dir",
                    &[&语言包工具::全局语言目录().display().to_string()]
                )
            );
            成功(())
        }
        语言包子命令::安装语言包 { 语言包来源, 强制覆盖 } => 语言包工具::安装语言(&语言包来源, 强制覆盖),
        语言包子命令::搜索语言包 { 搜索关键词 } => {
            // 市场浏览：下载仓库 ZIP 扫描语言包（含显示名/版本），
            // 可选关键词过滤；与 install 共用同一远程源回退策略
            println!(
                "{}",
                界面.取文带参("lang_search_header", &[&界面.取文("lang_search_source")])
            );
            让 找到 = 语言包工具::搜索远程语言(搜索关键词.as_deref())?;
            如果 找到.is_empty() {
                匹配 搜索关键词.as_deref() {
                    有值(关键词) 如果 !关键词.trim().is_empty() => {
                        println!("{}", 界面.取文带参("lang_search_empty", &[关键词]));
                    }
                    _ => println!("{}", 界面.取文("lang_search_empty_all")),
                }
                返回 成功(());
            }
            对于 信息 in &找到 {
                让 名 = 信息.显示名称.as_deref().unwrap_or("—");
                让 版本 = 信息.版本号.as_deref().unwrap_or("—");
                println!("  {:<12} {:<16} {}", 信息.语言代码, 名, 版本);
            }
            println!();
            println!("{}", 界面.取文("lang_search_hint"));
            成功(())
        }
        语言包子命令::移除语言包 { 语言代码 } => 语言包工具::删除语言(&语言代码),
    }
}

/// 处理 `rzc add` 子命令：封装 cargo add，成功后提示母语映射可用性
函数 处理添加子命令(依赖名单: &[字符串]) -> anyhow::结果<std::process::ExitCode> {
    让 界面 = 本地化::界面::全局();
    让 当前目录 = std::env::current_dir()?;
    让 项目根 = 向上定位项目根(&当前目录)
        .ok_or_else(|| anyhow::anyhow!("{}", 界面.取文("add_no_project")))?;
    让 状态 = Command::new(解析cargo路径())
        .arg("add")
        .args(依赖名单)
        .current_dir(&项目根)
        .status()
        .map_err(|错| anyhow::anyhow!("{}", 界面.取文带参("add_cargo_failed", &[&错.to_string()])))?;
    如果 !状态.success() {
        // cargo add 自身已输出错误详情，直接传播退出码
        返回 成功(std::process::ExitCode::FAILURE);
    }
    让 语言代码 = 本地化::检测界面语言();
    对于 规格 in 依赖名单 {
        // 依赖名取 @版本 前段，并将 - 归一为 _（代码中 use 路径用下划线）
        让 crate名 = 规格.split('@').next().unwrap_or(规格).replace('-', "_");
        匹配 查找crate映射别名(&语言代码, &项目根, &crate名) {
            有值(别名) => println!(
                "{}",
                界面.取文带参("add_mapping_ready", &[&crate名, &别名])
            ),
            无 => println!(
                "{}",
                界面.取文带参("add_mapping_missing", &[&crate名, &crate名])
            ),
        }
    }
    成功(std::process::ExitCode::SUCCESS)
}

/// 查找 crate 在当前语言映射中的母语别名（项目/全局语言包 > 内置）
///
/// 扫描 crates/*.toml 的 ["模块路径"] 节：值的首段（:: 分隔）与 crate 名
/// 匹配即命中（如 "HTTP客户端" = "reqwest" → 首段 reqwest）；
/// 命中时返回对应母语键作为示例提示。
函数 查找crate映射别名(
    语言代码: &文本,
    项目根: &Path,
    crate名: &文本,
) -> 选项<字符串> {
    // 1. 项目内语言包与全局用户语言包的 crates/ 目录
    让 目录列表 = [
        语言包根目录(项目根)
            .join(语言代码)
            .join("crates"),
        语言包工具::全局语言目录().join(语言代码).join("crates"),
    ];
    对于 目录 in &目录列表 {
        让 成功(条目列表) = fs::read_dir(目录) 否则 {
            继续;
        };
        对于 条目 in 条目列表.flatten() {
            让 路径 = 条目.path();
            如果 路径.extension().and_then(|后| 后.to_str()) != 有值("toml") {
                继续;
            }
            如果 让 成功(内容) = fs::read_to_string(&路径)
                && 让 有值(别名) = 解析映射别名(&内容, crate名)
            {
                返回 有值(别名);
            }
        }
    }
    // 2. 内置语言包（未知语言代码自动回退中文）
    让 内置 = 内置语言::获取内置数据(语言代码);
    对于 (_, 内容) in 内置.三方库数据 {
        如果 让 有值(别名) = 解析映射别名(内容, crate名) {
            返回 有值(别名);
        }
    }
    无
}

/// 在单个映射 TOML 内容中查找 crate 对应的母语别名
函数 解析映射别名(内容: &文本, crate名: &文本) -> 选项<字符串> {
    让 值: toml::Value = toml::from_str(内容).ok()?;
    让 路径表 = 值.get("模块路径")?.as_table()?;
    对于 (键, 项) in 路径表 {
        让 有值(英文路径) = 项.as_str() 否则 {
            继续;
        };
        让 首段 = 英文路径.split("::").next().unwrap_or(英文路径);
        如果 首段.replace('-', "_") == crate名 {
            返回 有值(键.clone());
        }
    }
    无
}

/// mapping auto --install：把 crate 加入当前项目依赖（找不到项目时仅告警）
///
/// 指定 --target-version 时按同一版本需求添加（`crate@=x.y.z` 精确锁定 /
/// `crate@x.y.*` 前缀），保证应用依赖与映射生成基准一致。
函数 安装依赖到当前项目(crate名: &文本, 目标版本: 选项<&文本>) {
    让 界面 = 本地化::界面::全局();
    让 有值(根) = std::env::current_dir()
        .ok()
        .and_then(|工作目录| 向上定位项目根(&工作目录))
    否则 {
        println!("{}", 界面.取文("mapping_auto_install_no_project"));
        返回;
    };
    让 规格 = 匹配 目标版本.and_then(映射生成器::版本需求) {
        有值(需求) => 格式化!("{}@{}", crate名, 需求),
        无 => crate名.to_string(),
    };
    匹配 Command::new(解析cargo路径())
        .arg("add")
        .arg(&规格)
        .current_dir(&根)
        .status()
    {
        成功(状态) 如果 状态.success() => {
            println!("{}", 界面.取文带参("mapping_auto_installed", &[crate名]))
        }
        成功(状态) => println!(
            "{}",
            界面.取文带参(
                "mapping_auto_install_failed",
                &[crate名, &状态.to_string()]
            )
        ),
        错误(错) => println!(
            "{}",
            界面.取文带参("mapping_auto_install_failed", &[crate名, &错.to_string()])
        ),
    }
}

/// 根据源码文件定位项目根（包含 Cargo.toml 的目录）
函数 定位项目根(文件: &Path) -> anyhow::结果<PathBuf> {
    让 文件目录 = 如果 文件.is_absolute() {
        文件.parent()
            .map(|父| 父.to_path_buf())
            .unwrap_or_else(|| PathBuf::from("."))
    } 否则 {
        std::env::current_dir()?
            .join(文件)
            .parent()
            .map(|父| 父.to_path_buf())
            .unwrap_or_else(|| PathBuf::from("."))
    };

    如果 让 有值(根) = 向上定位项目根(&文件目录) {
        返回 成功(根);
    }
    // 未找到 Cargo.toml 时明确报错：静默回退当前目录会在无关目录写入 src/main.rs
    anyhow::bail!(
        "{}",
        本地化::界面::全局().取文带参("no_project_root", &[&文件.display().to_string()])
    )
}

/// 计算 `run`/`check` 的入口产物路径。
///
/// 仅当源文件确为**项目 src 直属**入口（父目录恰为 `project_root/src`，且词干为
/// [`是否入口词干`]，即 `main` 或语言包主函数词，如 `src/main.zh`、旧项目里的
/// `src/主函数.zh`）时才写入 Cargo 固定编译目标 `src/main.rs`；其余文件产物跟随
/// 自身扩展名（`file.with_extension("rs")`），绝不占用 `src/main.rs`：
/// - 项目根的 `build.zh` → `build.rs`，不把 build 脚本覆盖为入口（weix 工具异常 #4）；
/// - 子目录/示例里恰好名为 `main` 的文件（`src/sub/main.zh`、`examples/main.zh`）→
///   产物留在自身目录，不越界覆盖宿主 `src/main.rs`（越界写出坑）。
函数 入口产物路径(项目根: &Path, 文件: &Path, 管理器: &映射管理器) -> PathBuf {
    让 词干 = 文件.file_stem().and_then(|干| 干.to_str());
    如果 词干.is_some_and(|干| 是否入口词干(干, 管理器)) && 是否直属src(文件, 项目根) {
        项目根.join("src/main.rs")
    } 否则 {
        文件.with_extension("rs")
    }
}

/// 文件父目录（规范化为绝对路径，纯比较不依赖文件必已存在）是否恰为
/// `project_root/src`——即该文件是否为项目真正的 src 直属入口，用于防止子目录
/// 里恰好名为 `main` 的文件越界聚合、覆盖宿主入口产物。
函数 是否直属src(文件: &Path, 项目根: &Path) -> 布尔 {
    让 有值(父目录) = 文件.parent() 否则 {
        返回 假;
    };
    // 相对路径按当前目录补齐为绝对，再与已规范化的 项目根 对齐比较；
    // 路径可能尚未落盘（单元测试、新建文件），canonicalize 失败时退回词法路径。
    让 绝对父目录 = 如果 父目录.is_absolute() {
        父目录.to_path_buf()
    } 否则 {
        std::env::current_dir()
            .map(|当前| 当前.join(父目录))
            .unwrap_or_else(|_| 父目录.to_path_buf())
    };
    让 规范父目录 = 绝对父目录
        .canonicalize()
        .unwrap_or_else(|_| 绝对父目录.clone());
    让 src目录 = 项目根.join("src");
    让 规范src = src目录.canonicalize().unwrap_or_else(|_| src目录.clone());
    规范父目录 == 规范src
}

/// 词干是否为项目入口主函数名：字面 `main`，或语言包中映射到 `main` 的
/// 母语词（zh「主函数」、ja「主関数」、ru「главная」等）。
///
/// `init` 生成 `src/main.<lang>`，教程与示例（.zh-demo）同样使用 `src/main.zh`；
/// 早期项目还可能有母语词干入口（如 zh 的 `src/主函数.zh`）——都须聚合到
/// Cargo 固定入口 `src/main.rs`，否则 cargo 报「no targets specified」。
函数 是否入口词干(词干: &文本, 管理器: &映射管理器) -> 布尔 {
    词干 == "main"
        || 管理器
            .取关键词映射表()
            .iter()
            .any(|(母语词, 英文)| 英文 == "main" && 母语词 == 词干)
}

/// 从指定目录向上查找项目根（含 Cargo.toml 的目录），未找到返回 None
函数 向上定位项目根(起点: &Path) -> 选项<PathBuf> {
    让 可变 当前 = 起点.canonicalize().unwrap_or_else(|_| 起点.to_path_buf());
    循环 {
        如果 当前.join("Cargo.toml").exists() {
            返回 有值(当前);
        }
        当前 = 当前.parent()?.to_path_buf();
    }
}

/// 项目内语言包根目录：主仓库 zrRust 为单副本结构 `crates/engine/lang-packs/`
///（编译期内嵌与文件系统消费共用同一份数据）；
/// 普通用户项目仍沿用 `lang-packs/` 约定（自定义覆盖）
公开(crate) 函数 语言包根目录(基础: &Path) -> PathBuf {
    让 引擎包 = 基础.join("crates/engine/lang-packs");
    如果 引擎包.is_dir() {
        引擎包
    } 否则 {
        基础.join("lang-packs")
    }
}

/// 统一转译管线（复用 engine）：Unicode 检查 → 关键字/宏转译 → 模块路径替换 → 别名替换 → 非 ASCII 模块注解
///
/// 使用磁盘持久化增量缓存（~/.rz/cache/transpile-v1.json）：上次运行转译过
/// 且内容未变的文件直接命中，省去整条转译管线；语言包变化时语境指纹失效。
函数 转译为英文(源码: &文本, 管理器: &映射管理器) -> 字符串 {
    让 可变 缓存 = i18n_rust_engine::缓存::转译缓存::持久默认项();
    转译为英文带缓存(源码, 管理器, &可变 缓存)
}

/// 同 [`转译为英文`]，复用调用方提供的缓存实例
///
/// 多文件场景（run/check 命令）共享同一会话缓存：入口文件与项目内其他
/// 方言文件内容指纹一致时直接命中，避免每次调用重建缓存、反复读写磁盘。
函数 转译为英文带缓存(
    源码: &文本,
    管理器: &映射管理器,
    缓存: &可变 i18n_rust_engine::缓存::转译缓存,
) -> 字符串 {
    标注非西文模块(&转译映射带缓存(源码, 管理器, 缓存).产出)
}

/// 同 [`转译为英文带缓存`]，但保留转译产物的源映射
///
/// 源映射（`管线映射`）是诊断列号回译的唯一依据：rustc 报的是英文产物
/// 的列号，须据此回放替换过程才能还原母语源码列号。
/// 缓存命中时映射表随产物一并复用，无需重算。
函数 转译映射带缓存(
    源码: &文本,
    管理器: &映射管理器,
    缓存: &可变 i18n_rust_engine::缓存::转译缓存,
) -> i18n_rust_engine::缓存::转译产出 {
    i18n_rust_engine::源码转译并映射(源码, 管理器, 缓存).unwrap_or_else(|_错| {
        // 缓存失败不阻断转译：回退无缓存管线（与旧行为一致）
        i18n_rust_engine::警告日志!(
            "cli",
            "{}",
            i18n_rust_engine::语言::查句("log_transpile_cache_fallback")
        );
        i18n_rust_engine::转译管线(源码, 管理器)
    })
}

/// 同 [`转译映射带缓存`]，附项目级声明上下文（跨文件声明豁免）
///
/// 缓存语境指纹由引擎并入项目上下文指纹（[`源码转译并项目`]）：
/// 项目声明集合变化时相关缓存自动失效。
函数 项目转译映射带缓存(
    源码: &文本,
    管理器: &映射管理器,
    缓存: &可变 i18n_rust_engine::缓存::转译缓存,
    项目: 选项<&i18n_rust_engine::别名替换::项目上下文>,
) -> i18n_rust_engine::缓存::转译产出 {
    i18n_rust_engine::源码转译并项目(源码, 管理器, 缓存, 项目).unwrap_or_else(|_错| {
        // 缓存失败不阻断转译：回退无缓存管线（与旧行为一致）
        i18n_rust_engine::警告日志!(
            "cli",
            "{}",
            i18n_rust_engine::语言::查句("log_transpile_cache_fallback")
        );
        i18n_rust_engine::转译管线并项目(源码, 管理器, 项目)
    })
}

/// 解析 cargo 可执行文件：内置工具链（~/.rz/toolchain）优先，PATH 回退；
/// 找不到时返回 "cargo" 由系统报错（保持与旧行为一致的报错信息）
公开 函数 解析cargo路径() -> PathBuf {
    i18n_rust_engine::工具链::查找工具链程序("cargo").unwrap_or_else(|| PathBuf::from("cargo"))
}

/// 解析 rustc 可执行文件：内置工具链优先，PATH 回退
公开 函数 解析rustc路径() -> PathBuf {
    i18n_rust_engine::工具链::查找工具链程序("rustc").unwrap_or_else(|| PathBuf::from("rustc"))
}

/// 解析与 [`解析rustc路径`] 同工具链的 rustdoc：优先内建/PATH 的独立 rustdoc，
/// 缺失时改用 rustc 的 sysroot 精确定位其配套 rustdoc（rustdoc 与 rustc 同
/// sysroot，版本一致），否则回退 PATH 的 "rustdoc" 由系统报错。
///
/// `mapping auto` 手调 rustdoc 生成 JSON 时必须与 cargo 编译 rlib 用同一
/// rustc，否则跨版本链接触发 E0514（见 doc_json.rs 的 RUSTC 统一注入）。
公开 函数 解析rustdoc路径() -> PathBuf {
    如果 让 有值(路径) = i18n_rust_engine::工具链::查找工具链程序("rustdoc") {
        返回 路径;
    }
    如果 让 成功(输出结果) = std::process::Command::new(解析rustc路径())
        .arg("--print")
        .arg("sysroot")
        .output()
    {
        让 系统根路径 = 字符串::from_utf8_lossy(&输出结果.stdout).trim().to_string();
        如果 !系统根路径.is_empty() {
            让 二进制 = PathBuf::from(系统根路径)
                .join("bin")
                .join(格式化!("rustdoc{}", std::env::consts::EXE_SUFFIX));
            如果 二进制.is_file() {
                返回 二进制;
            }
        }
    }
    PathBuf::from("rustdoc")
}

/// 递归收集目录下全部方言源文件（路径排序保证确定性）
///
/// 支持多层模块布局（`src/领域/工具.zh`）：模块文件可放在以父模块
/// 命名的子目录中，与 rustc 的 `父模块.rs` + `父模块/` 目录规则一致。
函数 收集方言文件(目录: &Path, 扩展名列表: &[字符串]) -> Vec<PathBuf> {
    让 可变 输出 = Vec::new();
    递归收集方言文件(目录, 扩展名列表, &可变 输出);
    输出.sort();
    输出
}

函数 递归收集方言文件(目录: &Path, 扩展名列表: &[字符串], 输出: &可变 Vec<PathBuf>) {
    让 成功(条目列表) = fs::read_dir(目录) 否则 {
        返回;
    };
    对于 目录项 in 条目列表.flatten() {
        让 路径 = 目录项.path();
        让 成功(文件类型) = 目录项.file_type() 否则 {
            继续;
        };
        如果 文件类型.is_dir() {
            // target 等构建产物目录不会出现在 src 树内；无特殊排除
            递归收集方言文件(&路径, 扩展名列表, 输出);
        } 否则 如果 文件类型.is_file()
            && 路径
                .extension()
                .and_then(|后| 后.to_str())
                .is_some_and(|后缀| {
                    扩展名列表
                        .iter()
                        .any(|扩展| 扩展 == 后缀 || 扩展 == &格式化!(".{后缀}"))
                })
        {
            输出.push(路径);
        }
    }
}

/// 收集项目级声明上下文（跨文件声明豁免）
///
/// 递归扫描 src/ 下全部层级的方言文件与入口文件（可能在项目根），收集：
/// - 模块名：各方言文件词干（含嵌套层级，供 `crate::领域::工具::成员`
///   等多层路径链豁免）；
/// - 声明名：各文件的项名与结构体字段（裸使用处豁免）。
///
/// 与 [`转译项目文件`] 扫描范围保持一致（src/ 全层级递归），
/// 入口文件不在 src/ 时单独补扫；读取失败的文件跳过（转译阶段会报错）。
函数 收集项目上下文(
    项目根: &Path,
    入口文件: &Path,
    管理器: &映射管理器,
) -> i18n_rust_engine::别名替换::项目上下文 {
    使用 std::collections::HashSet;
    让 扩展名列表 = 语言包工具::全部可用扩展名();
    让 入口规范 = 入口文件.canonicalize().ok();
    让 可变 模块集 = HashSet::new();
    让 可变 源文件列表: Vec<字符串> = Vec::new();
    让 可变 入口已见 = 假;

    让 src目录 = 项目根.join("src");
    对于 路径 in 收集方言文件(&src目录, &扩展名列表) {
        如果 让 有值(词干) = 路径.file_stem().and_then(|干| 干.to_str()) {
            模块集.insert(词干.to_string());
        }
        如果 入口规范.is_some() && 路径.canonicalize().ok() == 入口规范 {
            入口已见 = 真;
        }
        如果 让 成功(源码) = fs::read_to_string(&路径) {
            源文件列表.push(源码);
        }
    }
    // 入口文件不在 src/（如项目根的自定义路径）时单独补扫
    如果 !入口已见 && 入口文件.is_file() {
        如果 让 有值(词干) = 入口文件.file_stem().and_then(|干| 干.to_str()) {
            模块集.insert(词干.to_string());
        }
        如果 让 成功(源码) = fs::read_to_string(入口文件) {
            源文件列表.push(源码);
        }
    }

    i18n_rust_engine::别名替换::项目上下文::自源文件新建(
        模块集,
        源文件列表.iter().map(字符串::as_str),
        管理器,
    )
}

/// 同步转译项目 src/ 下的全部方言源文件（入口文件除外）为对应 .rs 文件，
/// 使多文件项目的 mod 引用链可用；非已注册方言扩展名的文件（如手写 .rs）跳过。
/// 并行转译项目内其他方言文件，保证多文件项目的 mod 引用链可用
///
/// 转译在 `thread::scope` 中并行执行（教学项目文件相互独立，无共享可变
/// 状态）；共享缓存用 `Mutex` 保护——查询/插入为短临界区，转译本身在锁外
/// 并行，文件多时与串行相比显著提速（缓存命中时仅查表，开销可忽略）。
函数 转译项目文件(
    项目根: &Path,
    入口文件: &Path,
    管理器: &映射管理器,
    缓存: &std::sync::Mutex<转译缓存>,
    项目: &i18n_rust_engine::别名替换::项目上下文,
) -> anyhow::结果<()> {
    让 界面 = 本地化::界面::全局();
    让 src目录 = 项目根.join("src");
    // 无 src 目录时不处理，由 cargo 自行报错
    如果 !src目录.is_dir() {
        返回 成功(());
    }
    让 扩展名列表 = 语言包工具::全部可用扩展名();
    // 入口产物固定写入 src/main.rs：src/ 顶层任何入口词干的方言文件
    // （main.zh、旧项目的 主函数.zh 等）转译后都会覆盖入口产物，必须跳过；
    // 嵌套层级中的同名文件不是入口（rustc 模块树按路径区分），照常转译。
    让 入口绝对 = 入口文件.canonicalize().ok();
    让 可变 文件列表 = Vec::new();
    对于 路径 in 收集方言文件(&src目录, &扩展名列表) {
        如果 有值(&路径) == 入口绝对.as_ref() {
            继续;
        }
        让 处于src顶层 = 路径.parent() == 有值(src目录.as_path());
        如果 处于src顶层
            && 路径
                .file_stem()
                .and_then(|干| 干.to_str())
                .is_some_and(|干| 是否入口词干(干, 管理器))
        {
            继续;
        }
        让 有值(扩展名) = 路径.extension().and_then(|后| 后.to_str()) 否则 {
            继续;
        };
        如果 按扩展名取语言代码(扩展名).is_none() {
            继续;
        }
        文件列表.push(路径);
    }

    // 语境指纹只算一次（全部文件共享同一语言包与项目上下文）；
    // 项目上下文指纹并入后，跨文件声明变化时旧缓存自动失效。
    // 必须与引擎 `源码转译并项目` 使用同一组合函数：
    // 入口文件与项目内其它文件共用同一个 转译缓存 实例，
    // 两处指纹算法若不同，同一语境会算出两个键，缓存互相不可见。
    让 指纹 = i18n_rust_engine::缓存::转译缓存::合并语境指纹(
        管理器.语境指纹(),
        有值(项目.计算指纹()),
    );
    让 首错: std::sync::Mutex<选项<anyhow::Error>> = std::sync::Mutex::new(无);
    std::thread::scope(|作用域| {
        让 可变 句柄列表 = Vec::with_capacity(文件列表.len());
        对于 路径 in 文件列表 {
            // 界面/首错 遮蔽为引用：move 闭包捕获的是 Copy 的共享引用
            让 界面 = &界面;
            让 首错 = &首错;
            // 相对 src 的显示名在闭包外算好（避免 PathBuf 被 move 进线程）
            让 显示名称 = 路径
                .strip_prefix(&src目录)
                .unwrap_or(&路径)
                .display()
                .to_string();
            让 句柄 = 作用域.spawn(move || {
                如果 首错
                    .lock()
                    .unwrap_or_else(std::sync::PoisonError::into_inner)
                    .is_some()
                {
                    返回; // 已有失败文件：跳过剩余工作
                }
                让 源码 = 匹配 fs::read_to_string(&路径) {
                    成功(源) => 源,
                    错误(错) => {
                        *首错
                            .lock()
                            .unwrap_or_else(std::sync::PoisonError::into_inner) =
                            有值(anyhow::anyhow!(
                                "{}",
                                界面.取文带参(
                                    "transpile_file_failed",
                                    &[&路径.display().to_string(), &错.to_string()]
                                )
                            ));
                        返回;
                    }
                };
                // 短临界区：查询缓存（命中直接复用产物）
                让 命中 = 缓存
                    .lock()
                    .unwrap_or_else(std::sync::PoisonError::into_inner)
                    .检索(&源码, 指纹)
                    .cloned();
                让 产物 = 匹配 命中 {
                    有值(产物) => 产物,
                    无 => {
                        // 锁外并行转译，完成后短临界区写回缓存；
                        // 静默管线：教学告警改由下方带文件名输出（多文件项目
                        // 中裸行列无法定位到具体文件）；项目上下文保证
                        // 跨文件调用的成员名与声明侧一致（#8）
                        让 产物 = i18n_rust_engine::转译管线静默并项目(
                            &源码,
                            管理器,
                            有值(项目),
                        );
                        输出教学告警(
                            &源码,
                            &显示名称,
                            管理器.取教学检查词(),
                            &管理器.歧义构造词集(),
                        );
                        缓存
                            .lock()
                            .unwrap_or_else(std::sync::PoisonError::into_inner)
                            .写入缓存(&源码, 指纹, 产物.clone());
                        产物
                    }
                };
                // 非入口模块按多层布局补 `#[path]`：src/领域.rs 中的
                // `mod 工具;` 需指向 src/领域/工具.rs（#[path] 相对当前
                // 文件目录解析，前缀为当前文件词干细胞目录）。
                让 成品 = 如果 让 有值(词干) = 路径.file_stem().and_then(|干| 干.to_str()) {
                    i18n_rust_engine::模块路径::标注嵌套模块并行号(&产物.产出, 词干).0
                } 否则 {
                    产物.产出.clone()
                };
                如果 让 错误(错) = 写入转译产物(&路径.with_extension("rs"), &成品, 界面) {
                    *首错
                        .lock()
                        .unwrap_or_else(std::sync::PoisonError::into_inner) = 有值(错);
                }
            });
            句柄列表.push(句柄);
        }
        对于 句柄 in 句柄列表 {
            让 _ = 句柄.join();
        }
    });
    匹配 首错.into_inner().unwrap_or(无) {
        有值(错) => 错误(错),
        无 => 成功(()),
    }
}

/// 输出单个方言文件的教学告警（Unicode 混淆/全角标点/lint），带文件名归属
///
/// 多文件项目中项目内文件分散在多个方言文件，裸行列无法定位具体文件；
/// 入口文件的告警仍由转译管线直接输出（裸行列即命令传入的入口文件）。
/// 时机与转译一致（仅缓存未命中时输出），静默管线保证不重复输出。
函数 输出教学告警(
    源码: &文本,
    显示名称: &文本,
    检查词表: &HashSet<字符串>,
    歧义构造集: &HashSet<字符串>,
) {
    对于 警告 in i18n_rust_engine::混淆字符::检查混淆字符(源码) {
        i18n_rust_engine::警告日志!(
            "unicode_confusion",
            "{}：{}",
            显示名称,
            警告.格式化输出()
        );
    }
    对于 警告 in i18n_rust_engine::全角标点::查找全角标点(源码) {
        i18n_rust_engine::警告日志!("fullwidth", "{}：{}", 显示名称, 警告.格式化输出());
    }
    如果 i18n_rust_engine::教学检查::教学检查开关() {
        对于 警告 in i18n_rust_engine::教学检查::执行教学检查并词表(
            源码,
            检查词表,
            歧义构造集,
        ) {
            i18n_rust_engine::警告日志!("lint", "{}：{}", 显示名称, 警告.格式化提示());
        }
    }
}

/// 写转译产物：目标已存在且内容不同时先备份为 `.rs.bak`，绝不静默覆盖用户文件。
///
/// 幂等重跑（内容一致）不产生备份；无同名手写文件时行为与直接写入完全一致。
函数 写入转译产物(路径: &Path, 内容: &文本, 界面: &crate::本地化::界面) -> anyhow::结果<()> {
    // 方言文件直接放在项目根等场景下 src/ 可能尚不存在，先创建父目录
    //（否则 fs::write 报裸 ENOENT，LSP 侧 translation_cache 已有同款处理）
    如果 让 有值(父目录) = 路径.parent() {
        std::fs::create_dir_all(父目录)?;
    }
    如果 让 成功(已存在) = fs::read_to_string(路径)
        && 已存在 != 内容
    {
        让 备份 = 路径.with_extension("rs.bak");
        fs::rename(路径, &备份)?;
        println!(
            "{}",
            界面.取文带参(
                "transpile_backup",
                &[&路径.display().to_string(), &备份.display().to_string()]
            )
        );
    }
    fs::write(路径, 内容)?;
    成功(())
}

/// 探测本机当前生效工具链的通道号（如 `1.98` / `nightly`）
///
/// 解析 `rustc --version` 输出的第二段（形如 `1.98.0 (哈希 日期)` 或 `1.98.0-nightly`），
/// 取主次版本号作为 channel；nightly/beta 通道原样返回。
/// rustc 不在 PATH 或输出格式异常时返回 None（调用方跳过生成锁定文件）。
函数 探测工具链通道() -> 选项<字符串> {
    让 输出结果 = std::process::Command::new(解析rustc路径())
        .arg("--version")
        .output()
        .ok()?;
    如果 !输出结果.status.success() {
        返回 无;
    }
    让 标准输出 = 字符串::from_utf8_lossy(&输出结果.stdout);
    让 版本 = 标准输出.split_whitespace().nth(1)?;
    如果 版本.contains("nightly") {
        返回 有值("nightly".to_string());
    }
    如果 版本.contains("beta") {
        返回 有值("beta".to_string());
    }
    // "1.98.0" → "1.98"（channel 只保留主次版本，补丁版本由工具链自行解析）
    让 可变 段 = 版本.split('.');
    让 主版本 = 段.next()?;
    让 次版本 = 段.next()?;
    如果 主版本.chars().all(|字符| 字符.is_ascii_digit()) && 次版本.chars().all(|字符| 字符.is_ascii_digit()) {
        有值(格式化!("{主版本}.{次版本}"))
    } 否则 {
        无
    }
}

/// 输出母语 ↔ Rust 映射速查表（`rzc cheat`）
///
/// 四张表（关键字/模块路径/别名/派生特征）逐节输出，母语词按显示宽度对齐；
/// 母语词与英文原词相同的恒等条目不输出（如 en 语言包整表恒等，仅提示）。
/// `markdown` 模式输出可嵌入教程/README 的表格。
函数 打印速查表(管理器: &映射管理器, 语言代码: &文本, 表格模式: 布尔) {
    让 派生表 = 管理器.取派生映射表();
    让 章节表: [(&文本, &HashMap<字符串, 字符串>); 4] = [
        ("Keywords / 关键字", 管理器.取关键词映射表()),
        ("Module paths / 模块路径", 管理器.取模块路径映射表()),
        ("Aliases / 别名", 管理器.取别名映射表()),
        ("Derives / 派生特征", 派生表),
    ];

    // 过滤恒等条目（native == english）后统计剩余量：全恒等则无需速查
    让 章节表: Vec<(&文本, Vec<(字符串, 字符串)>)> = 章节表
        .into_iter()
        .map(|(标题, 映射内容)| {
            让 行列表: Vec<(字符串, 字符串)> = 映射内容
                .iter()
                .filter(|(母语, 英文)| 母语 != 英文)
                .map(|(母语, 英文)| (母语.clone(), 英文.clone()))
                .collect();
            (标题, 行列表)
        })
        .collect();

    让 总数: usize = 章节表.iter().map(|(_, 行列表)| 行列表.len()).sum();
    如果 总数 == 0 {
        println!("rzc cheat — {语言代码} ↔ Rust");
        println!();
        println!("This language pack maps every identifier to itself (identity mapping).");
        println!("No cheat sheet is needed — write Rust as usual.");
        返回;
    }

    如果 表格模式 {
        println!("# rzc cheat — {语言代码} ↔ Rust ({总数})");
    } 否则 {
        println!("rzc cheat — {语言代码} ↔ Rust（共 {总数} 条）");
    }
    println!();
    对于 (标题, 行列表) in &章节表 {
        如果 行列表.is_empty() {
            继续;
        }
        如果 表格模式 {
            println!("## {标题}");
            println!();
            println!("| {语言代码} | Rust |");
            println!("|---|---|");
            对于 (母语, 英文) in 行列表 {
                println!("| {母语} | `{英文}` |");
            }
            println!();
        } 否则 {
            让 宽度 = 行列表
                .iter()
                .map(|(母语, _)| 母语.chars().count())
                .max()
                .unwrap_or(0);
            println!("── {标题} ──");
            对于 (母语, 英文) in 行列表 {
                让 补齐 = 宽度 - 母语.chars().count();
                println!("  {母语}{}  {英文}", " ".repeat(补齐));
            }
            println!();
        }
    }
    如果 表格模式 {
        println!("> Generated by `rzc cheat {语言代码} --markdown`.");
    }
}

函数 创建项目(项目名: &文本, 语言: &文本) -> anyhow::结果<()> {
    让 界面 = 本地化::界面::按语言加载(语言);
    i18n_rust_engine::语言::设定语言(语言);
    让 项目路径 = PathBuf::from(项目名);
    如果 项目路径.exists() {
        anyhow::bail!("{}", 界面.取文带参("dir_exists", &[项目名]));
    }
    // 包名取路径最后一段（支持传入绝对/相对路径），并将 cargo 不允许的字符替换为下划线
    让 包名 = 项目路径
        .file_name()
        .and_then(|名| 名.to_str())
        .unwrap_or(项目名);
    让 包名: 字符串 = 包名
        .chars()
        .map(|字符| {
            如果 字符.is_ascii_alphanumeric() || 字符 == '-' || 字符 == '_' {
                字符
            } 否则 {
                '_'
            }
        })
        .collect();
    fs::create_dir_all(项目路径.join("src"))?;
    // 版本锁定：固定到本机当前工具链版本（动态探测，避免硬编码随时间过时，
    // 导致 rust-analyzer 等工具报"工具链过于陈旧"）；探测失败时不生成锁定文件，
    // 项目跟随系统默认工具链。components 含 rust-analyzer/rust-src 供 IDE 使用。
    如果 让 有值(通道号) = 探测工具链通道() {
        fs::write(
            项目路径.join("rust-toolchain.toml"),
            格式化!(
                "[toolchain]\nchannel = \"{通道号}\"\ncomponents = [\"rustc\", \"cargo\", \"rust-analyzer\", \"rust-src\"]\n"
            ),
        )?;
    }

    fs::write(
        项目路径.join("Cargo.toml"),
        格式化!(
            "[package]\nname = \"{}\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\n\n[workspace]\n",
            包名
        ),
    )?;
    // 语言包已内置到 rzc 可执行文件中，无需复制；主文件模板随 --lang 变化
    fs::write(
        项目路径.join(格式化!("src/main.{}", 语言)),
        界面.取文("template_main"),
    )?;
    fs::write(
        项目路径.join("README.md"),
        界面.取文带参("readme_template", &[项目名, 语言]),
    )?;
    // 随项目分发 AI 编码规则：让用户的编码代理从一开始就知道用中文方言写、并掌握常用命令
    fs::write(
        项目路径.join("AGENTS.md"),
        界面.取文("agents_md_template"),
    )?;
    println!("{}", 界面.取文带参("project_created", &[项目名]));
    println!("{}", 界面.取文带参("project_created_hint", &[语言]));
    println!("{}", 界面.取文带参("project_run_hint", &[语言]));
    成功(())
}

函数 加载映射(
    语言包路径: 选项<PathBuf>,
    源文件: 选项<&Path>,
) -> anyhow::结果<映射管理器> {
    // 映射数据来源日志（语言包开发调试：RZ_LOG=info rzc check 可见）
    // 注意：加载映射 先于转译管线执行，logger 需在此提前初始化（幂等）
    i18n_rust_engine::日志::r#初始化();
    让 界面 = 界面按文件(源文件.unwrap_or(Path::new("")), &语言包路径);
    // 1. 如果用户通过 --lang-pack 指定了外部目录，强制使用
    如果 让 有值(路径) = 语言包路径 {
        i18n_rust_engine::信息日志!(
            "映射加载",
            "{}",
            界面.取文带参("mapping_source_explicit", &[&路径.display().to_string()])
        );
        返回 映射管理器::自目录加载(&路径).map_err(|错| {
            anyhow::anyhow!(
                "{}",
                界面.取文带参("load_lang_pack_failed", &[&错.to_string()])
            )
        });
    }
    // 2. 根据源文件扩展名确定语言代码
    让 扩展名 = 源文件
        .and_then(|文件| 文件.extension())
        .and_then(|后| 后.to_str())
        .unwrap_or("");
    让 语言代码 = 按扩展名取语言代码(扩展名).ok_or_else(|| {
        让 可用 = 语言包工具::全部可用扩展名();
        让 可用文本 = 如果 可用.is_empty() {
            界面.取文("no_available_ext")
        } 否则 {
            可用
                .iter()
                .map(|后| 格式化!(".{}", 后))
                .collect::<Vec<_>>()
                .join(", ")
        };
        anyhow::anyhow!(
            "{}",
            界面.取文带参("unknown_extension", &[扩展名, &可用文本])
        )
    })?;
    // 3. 项目内语言包目录存在时优先使用（自定义覆盖）：
    //    主仓库为 crates/engine/lang-packs/<lang>（单一数据源），用户项目为 lang-packs/<lang>；
    //    项目根从源文件向上查找；源文件不在项目内时回退 cwd，兼容旧用法
    让 可变 本地候选: Vec<PathBuf> = Vec::new();
    如果 让 有值(文件) = 源文件
        && 让 有值(父目录) = 文件.parent()
        && 让 有值(根) = 向上定位项目根(父目录)
    {
        本地候选.push(语言包根目录(&根).join(&语言代码));
    }
    让 当前目录 = std::env::current_dir().unwrap_or_else(|_| PathBuf::from("."));
    本地候选.push(语言包根目录(&当前目录).join(&语言代码));
    对于 本地路径 in &本地候选 {
        如果 本地路径.exists() {
            i18n_rust_engine::信息日志!(
                "映射加载",
                "{}",
                界面.取文带参(
                    "mapping_source_project",
                    &[&本地路径.display().to_string()]
                )
            );
            返回 映射管理器::自目录加载(本地路径).map_err(|错| {
                anyhow::anyhow!(
                    "{}",
                    界面.取文带参("load_local_lang_pack_failed", &[&错.to_string()])
                )
            });
        }
    }
    // 4. 全局用户语言包目录
    让 全局路径 = 语言包工具::全局语言目录().join(&语言代码);
    如果 全局路径.exists() {
        i18n_rust_engine::信息日志!(
            "映射加载",
            "{}",
            界面.取文带参(
                "mapping_source_global",
                &[&全局路径.display().to_string()]
            )
        );
        返回 映射管理器::自目录加载(&全局路径).map_err(|错| {
            anyhow::anyhow!(
                "{}",
                界面.取文带参("load_global_lang_pack_failed", &[&错.to_string()])
            )
        });
    }
    // 5. 回退到内置语言包（未内置的语言提示用户安装，避免静默使用中文）
    如果 !内置语言::拥有内置语言(&语言代码) {
        返回 错误(anyhow::anyhow!(
            "{}",
            界面.取文带参("lang_not_builtin", &[&语言代码, &语言代码])
        ));
    }
    让 内置 = 内置语言::获取内置数据(&语言代码);
    i18n_rust_engine::信息日志!(
        "映射加载",
        "{}",
        界面.取文带参("mapping_source_builtin", &[&语言代码])
    );
    映射管理器::自内置加载(
        内置.关键字文本,
        内置.模块路径文本,
        内置.标准库文本,
        内置.三方库数据,
    )
    .map_err(|错| {
        anyhow::anyhow!(
            "{}",
            界面.取文带参("load_builtin_lang_pack_failed", &[&错.to_string()])
        )
    })
}

/// 根据源文件与 --lang-pack 参数选择界面消息语言
///
/// --lang-pack 显式目录优先；否则按源文件扩展名确定语言代码；
/// 无法识别时回退 RZ_LANG / 系统语言 / 中文。
函数 界面按文件(文件: &Path, 语言包: &选项<PathBuf>) -> 本地化::界面 {
    如果 让 有值(路径) = 语言包 {
        让 界面 = 本地化::界面::按显式目录加载(路径);
        // 同步引擎全局语言（目录名即语言代码）
        让 代码 = 路径
            .file_name()
            .and_then(|名| 名.to_str())
            .unwrap_or("zh")
            .to_string();
        i18n_rust_engine::语言::设定语言(&代码);
        返回 界面;
    }
    让 语言代码 = 文件
        .extension()
        .and_then(|后| 后.to_str())
        .and_then(按扩展名取语言代码)
        .unwrap_or_else(本地化::检测界面语言);
    i18n_rust_engine::语言::设定语言(&语言代码);
    本地化::界面::按语言加载(&语言代码)
}

/// 按当前界面语言本地化 clap 帮助文本
///
/// 利用 `CommandFactory` 生成命令后逐项覆盖 about / help，
/// 使 `rzc --help` 与各子命令帮助均使用目标语言。
函数 本地化clap(界面: &本地化::界面) -> clap::Command {
    使用 clap::CommandFactory;
    命令行参数集::command()
        .disable_help_subcommand(true).about(界面.取文("cli_about"))
        .mut_arg("屏蔽教学提醒", |参数| 参数.help(界面.取文("arg_no_lint_help")))
        .mut_subcommand("init", |命令| {
            命令.about(界面.取文("cmd_init_about"))
                .mut_arg("语言代码", |参数| 参数.help(界面.取文("arg_lang_help")))
        })
        .mut_subcommand("run", |命令| 命令.about(界面.取文("cmd_run_about")))
        .mut_subcommand("check", |命令| {
            命令.about(界面.取文("cmd_check_about"))
                .mut_arg("修复标点", |参数| 参数.help(界面.取文("arg_check_fix_help")))
        })
        .mut_subcommand("eject", |命令| 命令.about(界面.取文("cmd_eject_about")))
        .mut_subcommand("transpile", |命令| 命令.about(界面.取文("cmd_transpile_about")))
        .mut_subcommand("add", |命令| {
            命令.about(界面.取文("cmd_add_about"))
                .mut_arg("依赖名单", |参数| 参数.help(界面.取文("arg_add_crates_help")))
        })
        .mut_subcommand("install", |命令| {
            命令.disable_help_subcommand(true).about(界面.取文("cmd_install_about"))
                .mut_subcommand("lsp", |子| {
                    子.about(界面.取文("cmd_install_lsp_about"))
                        .mut_arg("强制覆盖", |参数| 参数.help(界面.取文("arg_force_help")))
                })
                .mut_subcommand("toolchain", |子| {
                    子.about(界面.取文("tc_install_help"))
                        .mut_arg("工具链版本号", |参数| 参数.help(界面.取文("arg_tc_version_help")))
                        .mut_arg("分析器发布标签", |参数| 参数.help(界面.取文("arg_tc_ra_tag_help")))
                        .mut_arg("仅更新分析器", |参数| 参数.help(界面.取文("arg_tc_ra_only_help")))
                        .mut_arg("强制覆盖", |参数| 参数.help(界面.取文("arg_force_help")))
                })
        })
        .mut_subcommand("doctor", |命令| 命令.about(界面.取文("tc_doctor_help")))
        .mut_subcommand("cheat", |命令| {
            命令.about(界面.取文("cmd_cheat_about"))
                .mut_arg("语言代码", |参数| 参数.help(界面.取文("arg_cheat_lang_help")))
                .mut_arg("表格模式", |参数| 参数.help(界面.取文("arg_markdown_help")))
        })
        .mut_subcommand("lang", |命令| {
            命令.disable_help_subcommand(true).about(界面.取文("cmd_lang_about"))
                .mut_subcommand("list", |子| 子.about(界面.取文("cmd_lang_list_about")))
                .mut_subcommand("install", |子| {
                    子.about(界面.取文("cmd_lang_install_about"))
                        .mut_arg("语言包来源", |参数| 参数.help(界面.取文("arg_lang_source_help")))
                        .mut_arg("强制覆盖", |参数| 参数.help(界面.取文("arg_force_help")))
                })
                .mut_subcommand("search", |子| {
                    子.about(界面.取文("cmd_lang_search_about"))
                        .mut_arg("搜索关键词", |参数| {
                            参数.help(界面.取文("arg_lang_search_keyword_help"))
                        })
                })
                .mut_subcommand("remove", |子| {
                    子.about(界面.取文("cmd_lang_remove_about"))
                        .mut_arg("语言代码", |参数| 参数.help(界面.取文("arg_lang_code_help")))
                })
        })
        .mut_subcommand("mapping", |命令| {
            命令.disable_help_subcommand(true).about(界面.取文("cmd_mapping_about"))
                .mut_subcommand("auto", |子| {
                    子.about(界面.取文("cmd_mapping_auto_about"))
                        .mut_arg("依赖包名", |参数| {
                            参数.help(界面.取文("arg_mapping_auto_crate_help"))
                        })
                        .mut_arg("语言代码", |参数| 参数.help(界面.取文("arg_lang_help")))
                        .mut_arg("生成提供方", |参数| 参数.help(界面.取文("arg_provider_help")))
                        .mut_arg("目标版本", |参数| {
                            参数.help(界面.取文("arg_target_version_help"))
                        })
                        .mut_arg("输出路径", |参数| 参数.help(界面.取文("arg_output_help")))
                        .mut_arg("同时添加依赖", |参数| 参数.help(界面.取文("arg_install_help")))
                })
                .mut_subcommand("check", |子| {
                    子.about(界面.取文("cmd_mapping_check_about"))
                        .mut_arg("目标语言", |参数| {
                            参数.help(界面.取文("cmd_mapping_check_target_help"))
                        })
                })
                .mut_subcommand("scaffold", |子| {
                    子.about(界面.取文("cmd_mapping_scaffold_about"))
                        .mut_arg("源语言", |参数| {
                            参数.help(界面.取文("cmd_mapping_scaffold_source_help"))
                        })
                        .mut_arg("目标语言", |参数| {
                            参数.help(界面.取文("cmd_mapping_scaffold_target_help"))
                        })
                        .mut_arg("输出路径", |参数| 参数.help(界面.取文("arg_output_help")))
                        .mut_arg("生成提供方", |参数| {
                            参数.help(界面.取文("cmd_mapping_scaffold_provider_help"))
                        })
                })
                .mut_subcommand("coverage", |子| {
                    子.about(界面.取文("cmd_mapping_coverage_about"))
                        .mut_arg("语言代码", |参数| 参数.help(界面.取文("arg_coverage_lang_help")))
                })
        })
        .mut_subcommand("crate", |命令| {
            命令.disable_help_subcommand(true).about(界面.取文("cmd_crate_about"))
                .mut_subcommand("search", |子| {
                    子.about(界面.取文("cmd_crate_search_about"))
                        .mut_arg("搜索关键词", |参数| 参数.help(界面.取文("arg_crate_keyword_help")))
                })
                .mut_subcommand("install", |子| {
                    子.about(界面.取文("cmd_crate_install_about"))
                        .mut_arg("依赖包名", |参数| {
                            参数.help(界面.取文("arg_crate_name_normalize_help"))
                        })
                        .mut_arg("语言代码", |参数| 参数.help(界面.取文("arg_lang_help")))
                        .mut_arg("强制覆盖", |参数| 参数.help(界面.取文("arg_force_help")))
                })
                .mut_subcommand("list", |子| 子.about(界面.取文("cmd_crate_list_about")))
                .mut_subcommand("remove", |子| {
                    子.about(界面.取文("cmd_crate_remove_about"))
                        .mut_arg("依赖包名", |参数| 参数.help(界面.取文("arg_crate_name_help")))
                        .mut_arg("语言代码", |参数| 参数.help(界面.取文("arg_lang_help")))
                })
                .mut_subcommand("update", |子| 子.about(界面.取文("cmd_crate_update_about")))
                .mut_subcommand("publish", |子| {
                    子.about(界面.取文("cmd_crate_publish_about"))
                        .mut_arg("依赖包名", |参数| 参数.help(界面.取文("arg_crate_name_help")))
                        .mut_arg("语言代码", |参数| 参数.help(界面.取文("arg_lang_help")))
                        .mut_arg("目标文件", |参数| 参数.help(界面.取文("arg_crate_file_help")))
                        .mut_arg("译者署名", |参数| 参数.help(界面.取文("arg_crate_author_help")))
                })
        })
}

/// 根据源码文件扩展名获取语言代码
///
/// 优先查询动态映射表，未命中时回退静态映射。
函数 按扩展名取语言代码(扩展名: &文本) -> 选项<字符串> {
    如果 让 有值(代码) = 语言包工具::查询扩展名映射(扩展名) {
        返回 有值(代码);
    }
    语言包工具::静态扩展名映射().get(扩展名).cloned()
}

#[配置(测试)]
模块 单元测试 {
    使用 超级::{
        收集项目上下文, 探测工具链通道, 入口产物路径, 解析映射别名,
        按扩展名取语言代码, 转译项目文件, 转译为英文,
        项目转译映射带缓存, 写入转译产物, 标注非西文模块,
        标注非西文模块并行号,
    };

    /// 加载内置中文映射管理器（测试转译管线用）
    函数 中文管理器() -> i18n_rust_engine::映射管理::映射管理器 {
        让 内置 = crate::内置语言::获取内置数据("zh");
        i18n_rust_engine::映射管理::映射管理器::自内置加载(
            内置.关键字文本,
            内置.模块路径文本,
            内置.标准库文本,
            内置.三方库数据,
        )
        .expect("内置中文语言包应可加载")
    }

    /// 入口产物路径：入口词干（main / 语言包主函数词）写入 src/main.rs，
    /// 非入口文件跟随自身扩展名，不占用 src/main.rs
    /// （weix 工具异常 #4：build.zh 不得覆盖入口产物）
    #[测试]
    函数 测试_入口产物路径() {
        使用 std::path::{Path, PathBuf};
        让 根 = Path::new("/proj");
        让 管理 = 中文管理器();
        // src/main.zh（词干 main）→ 聚合到 Cargo 固定入口
        断言相等!(
            入口产物路径(根, Path::new("/proj/src/main.zh"), &管理),
            PathBuf::from("/proj/src/main.rs")
        );
        // 母语词干入口「主函数」（映射 main，旧项目命名）→ 同样聚合到 src/main.rs
        // （回归：此前仅认字面 main，主函数.zh 产物写自身名致 cargo 找不到目标）
        断言相等!(
            入口产物路径(根, Path::new("/proj/src/主函数.zh"), &管理),
            PathBuf::from("/proj/src/main.rs")
        );
        // 项目根的 build.zh（词干非入口）→ 同目录 build.rs，绝不触碰 src/main.rs
        断言相等!(
            入口产物路径(根, Path::new("/proj/build.zh"), &管理),
            PathBuf::from("/proj/build.rs")
        );
        // src 下非入口模块（如 helper.zh）→ src/helper.rs
        断言相等!(
            入口产物路径(根, Path::new("/proj/src/helper.zh"), &管理),
            PathBuf::from("/proj/src/helper.rs")
        );
    }

    /// 越界写出回归：入口词干但**不在 project_root/src 直属**的文件（子目录/示例
    /// 里恰好名为 main）不得聚合覆盖宿主 src/main.rs，产物须留在自身目录。
    #[测试]
    函数 测试_入口产物路径不越界覆盖src外() {
        使用 std::path::{Path, PathBuf};
        让 根 = Path::new("/proj");
        让 管理 = 中文管理器();
        // src/sub/main.zh（词干 main 但在子目录）→ src/sub/main.rs，不覆盖 src/main.rs
        断言相等!(
            入口产物路径(根, Path::new("/proj/src/sub/main.zh"), &管理),
            PathBuf::from("/proj/src/sub/main.rs")
        );
        // examples/main.zh（示例入口）→ examples/main.rs，不占用宿主 src/main.rs
        断言相等!(
            入口产物路径(根, Path::new("/proj/examples/main.zh"), &管理),
            PathBuf::from("/proj/examples/main.rs")
        );
        // 母语主函数词但位于子目录（src/sub/主函数.zh）同样不越界
        断言相等!(
            入口产物路径(根, Path::new("/proj/src/sub/主函数.zh"), &管理),
            PathBuf::from("/proj/src/sub/主函数.rs")
        );
    }

    /// 正向聚合：真实磁盘项目的 src 直属入口（英文词干与母语词干）都聚合到
    /// src/main.rs；相对词法路径（新建未落盘项目）按词法比较同样判定
    #[测试]
    函数 测试_入口产物路径聚合src直属入口() {
        让 管理 = 中文管理器();
        让 临时 = tempfile::tempdir().unwrap();
        让 根 = 临时.path().join("proj");
        std::fs::create_dir_all(根.join("src/sub")).unwrap();

        // 已落盘：真实目录的 canonicalize 比较
        断言相等!(
            入口产物路径(&根, &根.join("src/main.zh"), &管理),
            根.join("src/main.rs")
        );
        断言相等!(
            入口产物路径(&根, &根.join("src/主函数.zh"), &管理),
            根.join("src/main.rs")
        );
        // 同目录的非入口模块不聚合
        断言相等!(
            入口产物路径(&根, &根.join("src/工具.zh"), &管理),
            根.join("src/工具.rs")
        );

        // 未落盘：root/src 尚不存在，canonicalize 双双失败退回词法路径，
        // 词干为入口时仍应聚合（编辑器里新建项目骨架的场景）
        让 幽灵 = 临时.path().join("ghost-proj");
        断言相等!(
            入口产物路径(&幽灵, &幽灵.join("src/main.zh"), &管理),
            幽灵.join("src/main.rs")
        );
        断言相等!(
            入口产物路径(&幽灵, &幽灵.join("src/sub/main.zh"), &管理),
            幽灵.join("src/sub/main.rs")
        );
    }

    /// 工具链通道探测：开发/CI 环境必有 rustc；主次版本号形如 `1.98`，通道词原样
    #[测试]
    函数 测试_探测工具链通道() {
        让 通道 = 探测工具链通道().expect("测试环境应有 rustc");
        让 是版本 = 通道.split_once('.').is_some_and(|(前, 后)| {
            !前.is_empty() && !后.is_empty() && 前.chars().chain(后.chars()).all(|字符| 字符.is_ascii_digit())
        });
        断言!(
            是版本 || matches!(通道.as_str(), "nightly" | "beta"),
            "意外的通道格式：{通道}"
        );
    }

    /// 已内置的语言包扩展名可解析出语言代码
    ///
    /// 持环境变量锁：扩展名映射会扫描全局语言包目录（受 RZ_LANG_DIR 影响），
    /// 语言包工具 的环境变量测试并发修改该变量时会污染本测试
    #[测试]
    函数 测试_语言代码从扩展名_内置() {
        让 _锁 = crate::语言包工具::单元测试::环境锁();
        断言相等!(按扩展名取语言代码("zh").as_deref(), 有值("zh"));
        // 单语分支：仅 zh 为内置扩展名；他语扩展名不再走内置映射
        //（用户自带旧包的静态回退由 语言包工具 专项测试覆盖）
    }

    /// 未知扩展名返回 None（同样受 RZ_LANG_DIR 影响，需持锁）
    #[测试]
    函数 测试_语言代码从扩展名_未知() {
        让 _锁 = crate::语言包工具::单元测试::环境锁();
        断言相等!(按扩展名取语言代码("xyz"), 无);
    }

    /// 统一转译管线：中文关键字转为标准 Rust
    #[测试]
    函数 测试_转译英文_中文关键字() {
        让 管理 = 中文管理器();
        让 产物 = 转译为英文("公开 函数 help() {}\n", &管理);
        断言!(产物.contains("pub fn help()"), "实际输出：{产物}");
    }

    /// 多文件转译：src/ 下的其他方言文件生成同名 .rs，入口与手写 .rs 不受影响；
    /// 跨文件声明豁免（#8）：其他文件声明的与映射词同名的成员不被替换
    #[测试]
    函数 测试_转译项目文件() {
        让 临时 = tempfile::tempdir().unwrap();
        让 根 = 临时.path();
        std::fs::create_dir_all(根.join("src")).unwrap();
        让 入口 = 根.join("src/main.zh");
        // 跨文件调用本项目的 `函数 新建()`（撞 `新建`=new 映射）：
        // 项目上下文让调用位与声明侧一致（不被替换出 `new`）
        std::fs::write(
            &入口,
            "模组 辅助;\n\n函数 main() {\n    让 x = 辅助::r#新建();\n}\n",
        )
        .unwrap();
        std::fs::write(根.join("src/辅助.zh"), "公开 函数 新建() {}\n").unwrap();
        std::fs::write(根.join("src/manual.rs"), "// 手写文件不覆盖\n").unwrap();

        让 管理 = 中文管理器();
        让 缓存 = std::sync::Mutex::new(i18n_rust_engine::缓存::转译缓存::新建缓存(8));
        // 项目级声明上下文：模块名（文件词干）+ 声明名（入口+src/ 全扫）
        让 上下文 = 收集项目上下文(根, &入口, &管理);
        断言!(上下文.模块名集.contains("辅助"), "模块名应含文件名词干");
        断言!(上下文.声明名.contains("新建"), "声明名应含其他文件的函数名");
        转译项目文件(根, &入口, &管理, &缓存, &上下文).unwrap();

        // 其他方言文件已转译为同名 .rs
        让 辅助rs = std::fs::read_to_string(根.join("src/辅助.rs")).unwrap();
        断言!(辅助rs.contains("pub fn 新建()"), "实际输出：{辅助rs}");
        // 手写 .rs 不被触碰
        让 手写rs = std::fs::read_to_string(根.join("src/manual.rs")).unwrap();
        断言!(手写rs.contains("手写文件不覆盖"));
        // 入口文件未被重复转译（无 main.rs 产生，由调用方单独写入）
        断言!(!根.join("src/main.rs").exists());

        // 入口转译（带项目上下文）：跨文件调用位 `新建` 不被替换（#8）
        让 入口产物 = 项目转译映射带缓存(
            &std::fs::read_to_string(&入口).unwrap(),
            &管理,
            &可变 缓存.lock().unwrap(),
            有值(&上下文),
        )
        .产出;
        断言!(
            入口产物.contains("辅助::r#新建()"),
            "跨文件调用位应与声明侧一致：{入口产物}"
        );
    }

    /// write_transpiled 备份语义（let-chain 守卫）：目标存在且内容不同才备份为 .rs.bak；
    /// 内容相同（幂等重跑）不产生备份，绝不静默覆盖用户文件
    #[测试]
    函数 测试_写入转译产物仅变更时备份() {
        让 目录 = tempfile::tempdir().unwrap();
        让 路径 = 目录.path().join("main.rs");
        让 界面 = crate::本地化::界面::按语言加载("zh");

        // 首次写入：文件不存在，直接写盘，无备份
        写入转译产物(&路径, "v1", &界面).unwrap();
        断言相等!(std::fs::read_to_string(&路径).unwrap(), "v1");
        断言!(!路径.with_extension("rs.bak").exists());

        // 内容相同：幂等重跑，不产生备份，文件保持 v1
        写入转译产物(&路径, "v1", &界面).unwrap();
        断言!(!路径.with_extension("rs.bak").exists());

        // 内容不同：旧内容备份为 .rs.bak，文件更新为新内容
        写入转译产物(&路径, "v2", &界面).unwrap();
        断言相等!(std::fs::read_to_string(&路径).unwrap(), "v2");
        断言相等!(
            std::fs::read_to_string(路径.with_extension("rs.bak")).unwrap(),
            "v1"
        );
    }

    /// 非 ASCII 文件式 mod 声明补 #[path] 注解（绕过 rustc E0754）
    #[测试]
    函数 测试_标注非西文模块_基础() {
        让 产物 = 标注非西文模块("mod 数学;");
        断言相等!(产物, "#[path = \"数学.rs\"]\nmod 数学;");
    }

    /// 带 pub 可见性时注解插在 pub 之前
    #[测试]
    函数 测试_标注非西文模块_带pub() {
        让 产物 = 标注非西文模块("pub mod 数学;");
        断言相等!(产物, "#[path = \"数学.rs\"]\npub mod 数学;");
    }

    /// ASCII 模块名与内联模块块不处理
    #[测试]
    函数 测试_标注非西文模块_跳过ascii和内联() {
        断言相等!(标注非西文模块("mod math;"), "mod math;");
        断言相等!(标注非西文模块("mod 数学 { }"), "mod 数学 { }");
    }

    /// 已有 #[path] 注解时不重复添加；缩进保持
    #[测试]
    函数 测试_标注非西文模块_已存在与缩进() {
        让 源 = "#[path = \"数学.rs\"]\nmod 数学;";
        断言相等!(标注非西文模块(源), 源);
        让 产物 = 标注非西文模块("函数 main() {\n    mod 数学;\n}");
        断言相等!(
            产物,
            "函数 main() {\n    #[path = \"数学.rs\"]\n    mod 数学;\n}"
        );
    }

    /// 注解行映射：磁盘行 → 引擎直出行（0-based），注解行归属其 mod 声明行，
    /// 多处注解时偏移逐处累积（对应多模块入口 main.zh 的诊断行号换算）
    #[测试]
    函数 测试_标注非西文模块_行映射() {
        // 单处注解：磁盘 0/1 行（#[path] 与 mod）均归属引擎第 0 行
        让 (产物, 行映射) = 标注非西文模块并行号("mod 数学;\nfn main() {}");
        断言相等!(产物, "#[path = \"数学.rs\"]\nmod 数学;\nfn main() {}");
        断言相等!(行映射, 向量![0, 0, 1]);

        // 无注解时映射恒等
        让 (_, 行映射) = 标注非西文模块并行号("fn main() {}\nfn f() {}");
        断言相等!(行映射, 向量![0, 1]);

        // 两处注解：后续行偏移为 2
        让 两处 = "mod 数学;\nmod 物理;\nfn main() {}";
        让 (产物, 行映射) = 标注非西文模块并行号(两处);
        断言相等!(
            产物,
            "#[path = \"数学.rs\"]\nmod 数学;\n#[path = \"物理.rs\"]\nmod 物理;\nfn main() {}"
        );
        断言相等!(行映射, 向量![0, 0, 1, 1, 2]);
    }

    /// 映射 TOML 中按 crate 首段查找母语别名；连字符 crate 名归一匹配
    #[测试]
    函数 测试_解析映射别名() {
        让 toml文本 = "[\"模块路径\"]\n\"HTTP客户端\" = \"reqwest\"\n\"时间\" = \"chrono::prelude\"\n";
        断言相等!(
            解析映射别名(toml文本, "reqwest").as_deref(),
            有值("HTTP客户端")
        );
        断言相等!(解析映射别名(toml文本, "chrono").as_deref(), 有值("时间"));
        断言相等!(解析映射别名(toml文本, "tokio"), 无);
        断言相等!(
            解析映射别名(
                "[\"模块路径\"]\n\"序列化\" = \"serde-json\"\n",
                "serde_json"
            )
            .as_deref(),
            有值("序列化")
        );
    }
}
