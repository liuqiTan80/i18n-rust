//! rzc 命令行入口 —— 多语言 Rust 教学方言编译器
//!
//! 提供初始化、运行、检查、导出、语言包、映射等子命令，
//! 将母语 Rust 源码实时转译为标准 Rust 并调用 cargo 编译或运行。

使用 命令行::{从参数匹配, 子命令, 解析器};
使用 引擎库::映射管理器::映射管理器;
使用 引擎库::缓存::转译缓存;
使用 标准库::集合::{有序映射, 哈希映射, 哈希集合};
使用 标准库::环境;
使用 标准库::文件系统;
使用 标准库::输入输出::{缓冲读取器, 缓冲读取特征};
使用 标准库::路径::{路径类型, 路径缓冲};
使用 标准库::进程::{命令, 标准流, 退出码};
使用 标准库::同步::{互斥锁, 中毒错误};
使用 标准库::时间::持续时间;
使用 标准库::线程::{线程作用域, 睡眠, 生成};

#[路径属性 = "内置语言.rs"]
模块 内置语言;
#[路径属性 = "包仓库.rs"]
模块 包仓库;
#[路径属性 = "诊断输出.rs"]
模块 诊断输出;
#[路径属性 = "安装.rs"]
模块 安装;
#[路径属性 = "语言管理.rs"]
模块 语言管理;
#[路径属性 = "映射检查.rs"]
模块 映射检查;
#[路径属性 = "映射覆盖.rs"]
模块 映射覆盖;
#[路径属性 = "映射生成/mod.rs"]
模块 映射生成;
#[路径属性 = "翻译缺口.rs"]
模块 翻译缺口;
#[路径属性 = "界面.rs"]
模块 界面;
#[路径属性 = "临时守卫.rs"]
模块 临时守卫;

使用 安装::{安装语言服务, 安装工具链, 诊断环境, 显示安装向导, 语言服务发布标签};
使用 诊断输出::{
    诊断上下文, 流翻译器, 可用直接编译, 检查直接编译, 运行直接编译, 翻译编译诊断,
    诊断语言代码, 载入错误管理器, 报告翻译缺口,
};
使用 内置语言::{获取内置数据, 有内置语言包, 内置语言清单};
使用 语言管理::{
    全部可用扩展名, 全局语言目录, 列出语言, 安装语言, 移除语言, 搜索远程语言,
    查询扩展名映射, 静态扩展名映射, 全局语言包子目录名, 语言来源,
};
使用 映射生成::{探测系统语言, 版本需求, 运行自动生成};
使用 映射检查::{运行检查, 运行生成骨架};
使用 映射覆盖::运行覆盖检查;
使用 引擎库::模块路径::注解非母语模块;

// 非 ASCII 模块名 #[路径属性] 注解：命令行与语言服务共享同一引擎实现
// 语言服务镜像复用同一引擎入口

#[派生(解析器)]
#[命令属性(命令名 = "rzc", 版本标志)]
// 兜底文案（本地化命令行时会按界面语言覆盖）；用英文避免硬编码中文
#[命令属性(简介 = "Multi-language Rust teaching dialect compiler")]
公开 结构体 参数组 {
    /// 静默教学检查提示（初学者代码风格告警；Unicode 混淆字符与全角标点告警不受影响）
    #[参数属性(长参数 = "no-lint", 全局参数 = 真)]
    公开 无教学检查: 布尔,
    #[命令属性(子命令字段)]
    公开 子命令值: 命令组,
}

#[派生(子命令)]
公开 枚举 命令组 {
    #[命令属性(命令名 = "init")]
    初始化 {
        #[参数属性(值名 = "PROJECT_NAME")]
        项目名: 字符串,
        // 缺省跟随系统区域设置（LC_ALL/LANG）：全球用户的第一个项目应是自己的母语。
        // 不用参数默认值类型：需要区分「用户显式指定」与「自动检测失败」，
        // 后者要提示回退或在终端里列出菜单
        #[参数属性(短参数, 长参数 = "lang")]
        语言: 选项<字符串>,
        /// 同时生成 AGENTS.md（面向 AI 助手的母语编程指南，由当前语言包渲染）
        #[参数属性(长参数 = "ai")]
        助手: 布尔,
    },
    #[命令属性(命令名 = "run")]
    运行 {
        #[参数属性(值名 = "FILE")]
        源文件值: 路径缓冲,
        #[参数属性(短参数, 长参数 = "lang-pack")]
        语言包: 选项<路径缓冲>,
    },
    #[命令属性(命令名 = "check")]
    检查 {
        #[参数属性(值名 = "FILE")]
        源文件值: 路径缓冲,
        #[参数属性(短参数, 长参数 = "lang-pack")]
        语言包: 选项<路径缓冲>,
        /// 自动修正全角标点（写回源文件；仅转换存在半角对应字符的那些）
        #[参数属性(长参数 = "fix")]
        修复: 布尔,
    },
    #[命令属性(命令名 = "eject")]
    导出 {
        /// 要导出的方言源文件或目录；可重复（批量导出，失败项汇总报告）
        #[参数属性(值名 = "FILES", 必需 = 真, 参数个数 = 1..)]
        文件们: 向量<路径缓冲>,
        #[参数属性(短参数, 长参数 = "lang-pack")]
        语言包: 选项<路径缓冲>,
    },
    /// 转译预览：将方言源码转为标准 Rust 并打印到标准输出（不写任何文件）
    #[命令属性(命令名 = "transpile")]
    转译预览 {
        #[参数属性(值名 = "FILE")]
        源文件值: 路径缓冲,
        #[参数属性(短参数, 长参数 = "lang-pack")]
        语言包: 选项<路径缓冲>,
    },
    /// 为当前项目添加第三方依赖（封装 cargo 添加命令，并给出母语映射提示）
    #[命令属性(命令名 = "add")]
    添加依赖 {
        /// 第三方库名称或 名称@版本，可重复（例如可一次写多个第三方库名）
        #[参数属性(值名 = "CRATES", 必需 = 真)]
        依赖们: 向量<字符串>,
    },
    /// 语言包管理（列出 / 安装 / 移除）
    #[命令属性(命令名 = "lang")]
    语言包管理 {
        #[命令属性(子命令字段)]
        子命令值: 语言子命令,
    },
    /// 生成第三方库映射（从已安装的库中抽取接口）
    #[命令属性(命令名 = "mapping")]
    映射管理 {
        #[命令属性(子命令字段)]
        子命令值: 映射子命令,
    },
    /// 共享第三方库注册中心（搜索 / 安装 / 列出 / 移除 / 更新 / 发布）
    #[命令属性(命令名 = "crate")]
    库注册 {
        #[命令属性(子命令字段)]
        子命令值: 库子命令,
    },
    /// 安装配套组件（语言服务器等）
    #[命令属性(命令名 = "install")]
    安装组件 {
        #[命令属性(子命令字段)]
        子命令值: 选项<安装子命令>,
    },
    /// 诊断工具链环境：内置工具链 / 环境变量路径 / 版本对比
    #[命令属性(命令名 = "doctor")]
    诊断环境,
    /// 查看 / 导出 / 清空待译清单（尚无母语翻译的编译器与 cargo 消息）
    #[命令属性(命令名 = "gaps")]
    待译清单 {
        /// 语言代码（默认为检测到的界面语言）
        #[参数属性(长参数 = "lang")]
        语言: 选项<字符串>,
        /// 将清单以三列形式（层级、代码、消息）导出到指定路径
        #[参数属性(长参数 = "export")]
        导出路径: 选项<路径缓冲>,
        /// 清空清单（填完消息表后使用）
        #[参数属性(长参数 = "clear")]
        清空清单: 布尔,
    },
    /// 母语与 Rust 映射速查表（关键字 / 模块路径 / 别名 / 派生特征）
    #[命令属性(命令名 = "cheat")]
    速查 {
        /// 内置语言代码（例如 zh）或语言包目录路径；省略时从系统语言自动检测
        #[参数属性(值名 = "LANG")]
        语言: 选项<字符串>,
        /// 以 Markdown 表格输出，便于嵌入文档
        #[参数属性(长参数 = "markdown")]
        标记: 布尔,
    },
    /// 母语编程指南：面向学习者与 AI 助手的写作规则与完整术语表
    #[命令属性(命令名 = "guide")]
    指南 {
        /// 内置语言代码（例如 zh）；省略时从系统语言自动检测
        #[参数属性(短参数, 长参数 = "lang")]
        语言: 选项<字符串>,
        /// 将指南写入指定文件（例如 AGENTS.md）而非标准输出
        #[参数属性(短参数, 长参数 = "out")]
        输出文件: 选项<路径缓冲>,
    },
    /// 跨母语阅读：将方言或标准 Rust 项目重新转译为另一种方言
    ///（先把每个源文件转成标准 Rust，再本地化为目标方言；镜像出的项目保持
    /// 结构忠实，可用 `rzc run` 重新构建）。缺失的目标术语保留英文原文
    ///（登记为待翻译项）；一对多的反向查询会挑选一个确定的候选，
    /// 因此跨母语「阅读」无需与原词逐字一致。
    #[命令属性(命令名 = "relocalize")]
    反译重生 {
        /// 目标方言语言代码（必填，例如 ja）；即输出项目所使用的语言
        #[参数属性(长参数 = "to")]
        目标语言: 字符串,
        /// 源方言语言代码；省略时按每个文件的扩展名自动检测
        #[参数属性(长参数 = "from")]
        源语言: 选项<字符串>,
        /// 输出目录（镜像源布局并换用目标扩展名）；默认为源项目根旁的镜像目录
        #[参数属性(长参数 = "out-dir")]
        输出目录: 选项<路径缓冲>,
        /// 覆盖源语言包目录（目标始终从目标语言参数解析）
        #[参数属性(短参数, 长参数 = "lang-pack")]
        语言包: 选项<路径缓冲>,
        /// 待转换的项目目录或源文件；默认为当前目录
        #[参数属性(值名 = "FILES", 参数个数 = 0..)]
        文件们: 向量<路径缓冲>,
    },
}

#[派生(子命令)]
公开 枚举 安装子命令 {
    /// 安装语言服务器（编辑器扩展的补全与诊断后端）
    #[命令属性(命令名 = "lsp")]
    语言服务 {
        /// 若已安装则强制覆盖
        #[参数属性(短参数 = 'f', 长参数 = "force")]
        强制: 布尔,
    },
    /// 一键安装内置工具链（独立编译器与构建工具，无需 rustup）
    #[命令属性(命令名 = "toolchain")]
    工具链 {
        /// 工具链版本（默认为 rzc 锁定的版本，例如 1.98.0）
        #[参数属性(长参数 = "version", 参数默认值 = 引擎库::工具链::锁定版本)]
        版本: 字符串,
        /// 官方文档分析器发布标签（默认为锁定版本）
        #[参数属性(长参数 = "ra-tag", 参数默认值 = 语言服务发布标签)]
        发布标签: 字符串,
        /// 仅升级文档分析器（跳过约 300 兆字节的编译器与构建工具重新下载）
        #[参数属性(长参数 = "ra-only")]
        仅分析器: 布尔,
        /// 若已安装则强制重装
        #[参数属性(短参数 = 'f', 长参数 = "force")]
        强制: 布尔,
    },
}

#[派生(子命令)]
公开 枚举 映射子命令 {
    /// 自动生成第三方库映射文件：抽取库的公开接口；由 AI 或规则以目标语言生成名称与释义
    #[命令属性(命令名 = "auto")]
    自动生成 {
        /// 目标第三方库名称（须已安装或在注册源上可用）
        #[参数属性(值名 = "CRATE_NAME")]
        包名: 字符串,
        /// 目标语言（语言包目录名，例如 zh、ru；默认从系统语言自动检测）
        #[参数属性(长参数 = "lang")]
        语言: 选项<字符串>,
        /// AI 提供方：深度求索（默认）/ 开放人工智能 / 兼容端点——三者均遵循开放人工智能协议，端点、密钥与模型通过 RZ_AI_BASE_URL / RZ_AI_API_KEY / RZ_AI_MODEL 设置——或规则（离线规则模式）
        #[参数属性(长参数 = "provider", 参数默认值 = "deepseek")]
        服务商: 字符串,
        /// 固定目标库版本（例如 2.11.5 精确；2.11 / 2 = 该系列最新）；省略时用最新版（不可复现）
        #[参数属性(长参数 = "target-version")]
        目标版本: 选项<字符串>,
        /// 输出文件路径（默认为项目语言包根目录：<lang>/crates/<crate_name>.toml）
        #[参数属性(长参数 = "output")]
        输出路径: 选项<路径缓冲>,
        /// 生成映射后同时把该库加入当前项目的依赖清单
        #[参数属性(长参数 = "install")]
        安装依赖: 布尔,
    },
    /// 校验第三方库映射质量：重复键 / 关键字规避 / 跨文件冲突 / 条目数一致性
    #[命令属性(命令名 = "check")]
    校验 {
        /// 内置语言代码（例如 zh）或语言包目录路径；省略时校验所有内置语言
        #[参数属性(值名 = "TARGET")]
        目标: 选项<字符串>,
    },
    /// 语料覆盖率矩阵：对照真实后端源码校验语言包关键字与接口覆盖率；列出缺失的母语映射
    #[命令属性(命令名 = "coverage")]
    覆盖检查 {
        /// 内置语言代码（例如 zh）；省略时检查所有内置语言
        #[参数属性(长参数 = "lang")]
        语言: 选项<字符串>,
    },
    /// 从源语言的第三方库映射生成目标语言的翻译骨架（保留键待翻译，英文值不变）
    #[命令属性(命令名 = "scaffold")]
    脚手架 {
        /// 源语言代码（内置语言，例如 zh）
        #[参数属性(值名 = "SOURCE")]
        源语言: 字符串,
        /// 目标语言代码（新语言包目录名，例如某语言代码）
        #[参数属性(值名 = "TARGET")]
        目标语言: 字符串,
        /// 输出目录（默认为项目语言包根目录：<target>/crates/）
        #[参数属性(长参数 = "output")]
        输出路径: 选项<路径缓冲>,
        /// 翻译模式：规则（默认；生成待办骨架供人工翻译）或深度求索 / 开放人工智能 / 兼容端点（AI 翻译键；端点、密钥与模型来自 AI 端点环境变量）
        #[参数属性(长参数 = "provider", 参数默认值 = "rule")]
        服务商: 字符串,
    },
}

#[派生(子命令)]
公开 枚举 库子命令 {
    /// 搜索注册中心里已发布的第三方库映射（可选关键字过滤）
    #[命令属性(命令名 = "search")]
    检索 {
        /// 关键字（匹配库名 / 语言 / 作者）；省略时列出全部（按下载量排序）
        #[参数属性(值名 = "KEYWORD")]
        关键词: 选项<字符串>,
    },
    /// 安装单个第三方库映射：从注册中心复制到全局语言包
    #[命令属性(命令名 = "install")]
    安装映射 {
        /// 第三方库名称（连字符归一化为下划线）
        #[参数属性(值名 = "CRATE_NAME")]
        包名: 字符串,
        /// 目标语言代码（例如 zh）
        #[参数属性(长参数 = "lang")]
        语言: 字符串,
        /// 若已安装则强制覆盖
        #[参数属性(短参数 = 'f', 长参数 = "force")]
        强制: 布尔,
    },
    /// 列出已安装的社区映射
    #[命令属性(命令名 = "list")]
    列表,
    /// 移除已安装的社区映射（从全局语言包与清单中删除）
    #[命令属性(命令名 = "remove")]
    移除映射 {
        /// 第三方库名称
        #[参数属性(值名 = "CRATE_NAME")]
        包名: 字符串,
        /// 语言代码
        #[参数属性(长参数 = "lang")]
        语言: 字符串,
    },
    /// 按已安装清单重新拉取全部映射（获取他人更新）
    #[命令属性(命令名 = "update")]
    重新拉取,
    /// 将本地映射发布到注册中心（先进行质量校验）
    #[命令属性(命令名 = "publish")]
    发布映射 {
        /// 第三方库名称
        #[参数属性(值名 = "CRATE_NAME")]
        包名: 字符串,
        /// 语言代码
        #[参数属性(长参数 = "lang")]
        语言: 字符串,
        /// 映射文件路径（省略时在常见位置搜索：全局或项目语言包或当前目录）
        #[参数属性(长参数 = "file")]
        映射文件: 选项<路径缓冲>,
        /// 译者署名（默认为 git 用户名）
        #[参数属性(长参数 = "author")]
        作者: 选项<字符串>,
    },
}

#[派生(子命令)]
公开 枚举 语言子命令 {
    /// 列出所有已安装的语言包（内置 + 用户安装）
    #[命令属性(命令名 = "list")]
    列表,
    /// 安装语言包：本地目录路径直接复制；语言代码从远程仓库下载
    #[命令属性(命令名 = "install")]
    安装语言 {
        /// 本地语言包目录路径，或远程语言代码
        #[参数属性(值名 = "SOURCE")]
        源: 字符串,
        /// 若已安装则强制覆盖
        #[参数属性(短参数 = 'f', 长参数 = "force")]
        强制: 布尔,
    },
    /// 移除用户安装的语言包（内置语言包不可移除）
    #[命令属性(命令名 = "remove")]
    移除语言 {
        /// 语言代码（语言包目录名）
        #[参数属性(值名 = "LANG_CODE")]
        语言代码: 字符串,
    },
    /// 浏览远程语言包市场（扫描远程仓库；可选关键字过滤）
    #[命令属性(命令名 = "search")]
    检索 {
        /// 关键字（匹配语言代码或显示名）；省略时列出所有远程语言包
        #[参数属性(值名 = "KEYWORD")]
        关键词: 选项<字符串>,
    },
}

函数 主函数() -> 退出码 {
    使用 标准库::输入输出::{是否终端特征, 读取特征};
    // 双击 rzc 可执行文件（无参数且标准输出是终端）：显示环境安装向导（逐项检查
    // 组件状态与解决方式）并停留，避免黑窗一闪而过。用标准输出检测（双击时标准输出
    // 连控制台）而非标准输入（双击场景标准输入句柄可能无效，读取立即结束导致秒关）；
    // 标准输入读取失败时停留数秒兜底。管道或重定向场景标准输出非终端，走正常流程。
    如果 环境::参数们().长度() == 1 && 标准库::输入输出::标准输出().是否为终端() {
        显示安装向导();
        打印行!();
        打印行!("按任意键退出...");
        让 可变 缓冲 = [0无符号微整数; 1];
        如果 标准库::输入输出::标准输入().读取精确(&可变 缓冲).是否为错误() {
            睡眠(持续时间::从秒(8));
        }
        返回 退出码::成功退出码;
    }
    匹配 运行() {
        成功(退出码值) => 退出码值,
        错误(错误值) => {
            // 错误正文已由各处按界面语言生成，硬编码英文前缀会是教学
            // 输出里最后一处英文（清单预检等走的就是这条出口）
            错误打印行!(
                "{}",
                界面::界面消息表::全局表()
                    .取带参消息("cli_error_prefix", &[&格式化!("{错误值:#}")])
            );
            退出码::失败退出码
        }
    }
}

函数 运行() -> 错误处理::结果<退出码> {
    // 按当前界面语言本地化命令行帮助文本
    让 界面表 = 界面::界面消息表::全局表();
    // 同步引擎全局语言（错误、诊断、日志随界面语言输出）
    引擎库::语言::设定语言(&界面::探测界面语言());
    让 命令行实例 = 本地化命令行(&界面表);
    // 命令行框架自身错误（帮助、版本输出、非法参数等）按其退出码直接退出
    让 参数值 = 匹配 参数组::从参数匹配方法(&命令行实例.获取参数匹配()) {
        成功(已匹配参数) => 已匹配参数,
        错误(命令行错误) => 命令行错误.退出(),
    };

    // 无教学检查：项目开发（非教学）场景静默教学检查（初学者代码风格提示，
    // 每次转译刷屏）；Unicode 混淆与全角标点告警不受影响
    如果 参数值.无教学检查 {
        引擎库::校验::设教学告警启用(假);
    }

    // 首次运行引导：终端交互场景下，首次执行教学核心命令时打印
    // 欢迎语与环境检查（编译器缺失提示与下一步建议），仅一次
    //（主目录下的首次运行标记文件）；持续集成或管道等非终端场景自动跳过。
    匹配 &参数值.子命令值 {
        命令组::运行 { .. } | 命令组::检查 { .. } | 命令组::初始化 { .. } => {
            也许显示首次运行(&界面表);
        }
        _ => {}
    }

    匹配 参数值.子命令值 {
        命令组::初始化 {
            项目名,
            语言,
            助手,
        } => {
            让 语言值 = 解析初始化语言(语言)?;
            引擎库::语言::设定语言(&语言值);
            创建项目(&项目名, &语言值, 助手)?;
            成功(退出码::成功退出码)
        }
        命令组::运行 { 源文件值, 语言包 } => {
            让 界面表 = 按文件取界面(&源文件值, &语言包);
            确保源文件(&界面表, &源文件值)?;
            让 源码文本 = 文件系统::读取字符串(&源文件值)?;
            让 映射管理器值 = 加载映射(语言包.克隆值(), 有值(&源文件值))?;
            让 项目根 = 查找项目根(&源文件值)?;
            // 项目级声明上下文（跨文件声明豁免）：扫描源码目录全部方言文件与
            // 入口，收集模块名与声明名；入口文件、项目内文件与诊断重放
            // 共享同一上下文（否则跨文件调用的成员名被当库别名替换，报 E0599）
            让 项目上下文值 = 收集项目上下文(&项目根, &源文件值, &映射管理器值);
            // 入口文件写入源码目录的主程序产物作为编译目标；会话缓存贯穿入口文件与
            // 项目内其他文件（并行转译共享命中，见转译项目文件）
            让 源路径 = 入口产物路径(&项目根, &源文件值, &映射管理器值);
            // 经构建工具运行时只能运行默认入口：非默认入口
            //（示例目录、源码目录下其他文件、根目录脚本）的产物写在自身路径，
            // 无参数的运行会静默运行另一个程序，必须先明确提示
            让 直接编译 = 可用直接编译(&项目根, &源文件值);
            如果 !直接编译 && 源路径 != 项目根.连接(主程序产物路径) {
                // 库入口单列一条消息：它不是「入口文件认错了吧」，而是库
                // 压根没有可执行程序。指人家用带名称参数的方式是让人去找一个
                // 不存在的程序，故这里给的实际动作只有「校验」与「补主程序」。
                如果 入口产物默认(&源文件值, &项目根, &映射管理器值) == 有值(库产物路径) {
                    让 路径文本 = 源文件值.展示().转字符串();
                    错误处理::错误中止!("{}", 界面表.取带参消息("run_lib_no_bin", &[&路径文本, &路径文本]));
                }
                错误处理::错误中止!(
                    "{}",
                    界面表.取带参消息(
                        "run_not_default_entry",
                        &[&源文件值.展示().转字符串(), &源路径.展示().转字符串()]
                    )
                );
            }
            让 缓存 = 互斥锁::新建(引擎库::缓存::转译缓存::默认持久化());
            让 转译结果 = 项目缓存转译(
                &源码文本,
                &映射管理器值,
                &可变 缓存.加锁().解包或用否则(中毒错误::取内层),
                有值(&项目上下文值),
                &教学显示名(&源文件值, &项目根),
            );
            // 列映射：把编译器诊断的英文产物列号回译到母语源码列号
            让 列位映射 = 引擎库::列位映射::列位映射表::回放生成(
                &源码文本,
                &转译结果.流程映射,
            );
            // 写盘产物含模块路径注解插入行：保留行映射供诊断回译先行换算
            //（注解落点按托管布局解析：子模块产物在托管镜像目录下）
            让 入口扩展名 = 全部可用扩展名();
            让 是否入口 = 是否入口源(&源文件值, &项目根, &映射管理器值);
            让 (注解后产物, 入口行映射) = 注解产物(
                &转译结果.转译产物文本,
                &项目根,
                &源文件值,
                &源路径,
                是否入口,
                &入口扩展名,
            );
            写出产物(&项目根, &源路径, &注解后产物, &界面表)?;
            // 入口产物落构建工具 包根，清托管目录里的旧布局残留；非入口产物已从
            // 源文件旁迁到托管目录，清掉迁走后同目录的遗留文件
            让 旧产物 = 源文件值.设扩展名("rs");
            如果 是否入口 {
                清理入口生成副本(&项目根, &源文件值, &源路径);
            } 否则 {
                迁移旧产物(&旧产物, &源路径, &注解后产物, &界面表);
            }
            // 同步转译项目内其他方言文件，保证多文件项目的模块引用链可用
            转译项目文件(&项目根, &源文件值, &映射管理器值, &缓存, &项目上下文值)?;

            // 单文件项目直调编译器：绕开构建工具的索引与项目结构（教学单文件
            // 场景编译更快、无网络索引问题）；多文件或有依赖项目回退构建工具
            如果 直接编译 {
                返回 运行直接编译(
                    &界面表,
                    &项目根,
                    &源路径,
                    &语言包,
                    &映射管理器值,
                    &源码文本,
                    &源文件值,
                    &列位映射,
                    &入口行映射,
                    &项目上下文值,
                );
            }

            // 编译诊断（警告与错误）走 JSON 行翻译，
            // 程序自身标准输出与标准错误原样透传（构建工具不包装子进程输出），
            // 避免英文警告与程序输出混淆，也无需二次编译。
            清单预检(&项目根, &界面表)?;
            让 可变 子进程 = 命令::新建(解析cargo())
                .参数(["run", "--message-format=json"])
                .当前目录(&项目根)
                .标准输入(标准流::继承())
                .标准输出(标准流::管道化())
                .标准错误(标准流::管道化())
                .生成()
                .映射错误(|错误值| {
                    错误处理::错误处理!(
                        "{}",
                        界面表.取带参消息(
                            "cargo_run_failed",
                            &[&项目根.展示().转字符串(), &错误值.转字符串()]
                        )
                    )
                })?;
            让 标准输出管道 = 子进程
                .标准输出
                .取值()
                .缺值转错(|| 错误处理::错误处理!("cargo run stdout 管道不可用"))?;
            // 标准错误线程逐行翻译：构建进度与程序
            // 恐慌输出本地化，其余行（程序普通标准错误）原样透传
            让 标准错误管道 = 子进程
                .标准错误
                .取值()
                .缺值转错(|| 错误处理::错误处理!("cargo run stderr 管道不可用"))?;
            // 构建工具自身错误（清单、无目标、依赖拉不到等）是纯文本，
            // 逐行过消息表本地化；未命中行仍走原有进度行翻译，行为不劣于旧版
            让 工具根 = 项目根.克隆值();
            让 工具语言包 = 语言包.克隆值();
            让 缺口语言 = 诊断语言代码(&源文件值);
            让 标准错误句柄 = 生成(移动 || {
                让 界面表 = 界面::界面消息表::全局表();
                让 基础翻译器 = 流翻译器::新建();
                让 可变 翻译器 =
                    匹配 载入错误管理器(&界面表, &工具语言包, &工具根, &缺口语言) {
                        有值(管理器值) => 基础翻译器.带工具文本(管理器值, 缺口语言),
                        无 => 基础翻译器,
                    };
                让 读取器 = 缓冲读取器::新建(标准错误管道);
                对于 行结果 在 读取器.逐行() {
                    匹配 行结果 {
                        成功(行文本) => 错误打印行!("{}", 翻译器.翻译(&行文本, &界面表)),
                        错误(_) => 中断,
                    }
                }
                // 流式线程里登记的英文残留也要落盘：无 JSON 诊断时主链路不报告
                报告翻译缺口(&界面表);
            });
            让 读取器 = 缓冲读取器::新建(标准输出管道);
            // 收集构建工具 JSON 诊断行（含原因字段），其余行视为程序输出原样透传
            让 可变 诊断行文本 = 字符串::新建();
            对于 行结果 在 读取器.逐行() {
                让 行文本 = 行结果.映射错误(|错误值| {
                    错误处理::错误处理!(
                        "{}",
                        界面表.取带参消息(
                            "cargo_run_failed",
                            &[&项目根.展示().转字符串(), &错误值.转字符串()]
                        )
                    )
                })?;
                如果 行文本.以开头('{')
                    && 让 成功(解析结果) = JSON序列化::解析字符串::<JSON序列化::JSON值>(&行文本)
                    && 解析结果.获取("reason").是否为有值()
                {
                    诊断行文本.推入字符串(&行文本);
                    诊断行文本.推入('\n');
                    继续;
                }
                打印行!("{行文本}");
            }
            让 进程状态值 = 子进程.等待进程().映射错误(|错误值| {
                错误处理::错误处理!(
                    "{}",
                    界面表.取带参消息(
                        "cargo_run_failed",
                        &[&项目根.展示().转字符串(), &错误值.转字符串()]
                    )
                )
            })?;
            让 _ = 标准错误句柄.连接();

            // 编译诊断翻译（警告与错误均覆盖）；
            // 无诊断且成功时静默（程序已运行，不再提示编译状态）
            如果 !诊断行文本.是否为空() {
                让 _ = 翻译编译诊断(
                    &诊断行文本,
                    "",
                    &诊断上下文 {
                        界面表: &界面表,
                        语言包参数: &语言包,
                        项目根: &项目根,
                        映射器: &映射管理器值,
                        源码: &源码文本,
                        源文件: &源文件值,
                        入口产物: 源路径.克隆值(),
                        列位映射: 有值(&列位映射),
                        入口行映射: 有值(&入口行映射),
                        项目上下文: 有值(&项目上下文值),
                    },
                    进程状态值.退出成功(),
                    真,
                    // 输出已实时透传：构建成功而程序运行失败（如恐慌）时
                    // 不补打「编译错误」标签
                    真,
                );
            }

            // 传播被运行程序的退出码（信号终止等无码场景回退失败码）
            成功(
                进程状态值
                    .代码()
                    .映射(|代码值| 退出码::从(代码值 作为 字节))
                    .解包或用(退出码::失败退出码)
            )
        }
        命令组::检查 {
            源文件值,
            语言包,
            修复,
        } => {
            让 界面表 = 按文件取界面(&源文件值, &语言包);
            确保源文件(&界面表, &源文件值)?;
            让 可变 源码文本 = 文件系统::读取字符串(&源文件值)?;
            // 全角标点教学修复：中文输入法下最常见的编译错误来源之一。
            // 修复开关打开时自动将代码位置（字符串与注释内除外）的全角标点改写为半角，
            // 并提示剩余需人工修改的字符（顿号、全角空格等）；
            // 不带修复开关时警告由转译管线自动输出。
            如果 修复 {
                让 (修正后文本, 修正数) = 引擎库::全角标点::修复全角标点(&源码文本);
                如果 修正数 > 0 {
                    文件系统::写入(&源文件值, &修正后文本)?;
                    源码文本 = 修正后文本;
                    打印行!(
                        "{}",
                        界面表.取带参消息(
                            "fullwidth_fix_done",
                            &[&修正数.转字符串(), &源文件值.展示().转字符串()]
                        )
                    );
                }
                让 剩余数 = 引擎库::全角标点::检测全角标点(&源码文本).元素数();
                如果 剩余数 > 0 {
                    打印行!(
                        "{}",
                        界面表.取带参消息("fullwidth_fix_remaining", &[&剩余数.转字符串()])
                    );
                }
            }
            让 映射管理器值 = 加载映射(语言包.克隆值(), 有值(&源文件值))?;
            让 项目根 = 查找项目根(&源文件值)?;
            // 项目级声明上下文（跨文件声明豁免，同运行）
            让 项目上下文值 = 收集项目上下文(&项目根, &源文件值, &映射管理器值);
            让 源路径 = 入口产物路径(&项目根, &源文件值, &映射管理器值);
            让 缓存 = 互斥锁::新建(引擎库::缓存::转译缓存::默认持久化());
            让 转译结果 = 项目缓存转译(
                &源码文本,
                &映射管理器值,
                &可变 缓存.加锁().解包或用否则(中毒错误::取内层),
                有值(&项目上下文值),
                &教学显示名(&源文件值, &项目根),
            );
            // 列映射：把编译器诊断的英文产物列号回译到母语源码列号
            让 列位映射 = 引擎库::列位映射::列位映射表::回放生成(
                &源码文本,
                &转译结果.流程映射,
            );
            // 写盘产物含模块路径注解插入行：保留行映射供诊断回译先行换算
            //（注解落点按托管布局解析：子模块产物在托管镜像目录下）
            让 入口扩展名 = 全部可用扩展名();
            让 是否入口 = 是否入口源(&源文件值, &项目根, &映射管理器值);
            让 (注解后产物, 入口行映射) = 注解产物(
                &转译结果.转译产物文本,
                &项目根,
                &源文件值,
                &源路径,
                是否入口,
                &入口扩展名,
            );
            写出产物(&项目根, &源路径, &注解后产物, &界面表)?;
            // 入口产物落构建工具 包根，清托管目录里的旧布局残留；非入口产物已从
            // 源文件旁迁到托管目录，清掉迁走后同目录的遗留文件
            让 旧产物 = 源文件值.设扩展名("rs");
            如果 是否入口 {
                清理入口生成副本(&项目根, &源文件值, &源路径);
            } 否则 {
                迁移旧产物(&旧产物, &源路径, &注解后产物, &界面表);
            }
            // 同步转译项目内其他方言文件，保证多文件项目的模块引用链可用
            转译项目文件(&项目根, &源文件值, &映射管理器值, &缓存, &项目上下文值)?;

            // 单文件项目直调编译器（绕开构建工具）；多文件或有依赖项目回退构建工具
            如果 可用直接编译(&项目根, &源文件值) {
                返回 检查直接编译(
                    &界面表,
                    &项目根,
                    &源路径,
                    &语言包,
                    &映射管理器值,
                    &源码文本,
                    &源文件值,
                    &列位映射,
                    &入口行映射,
                    &项目上下文值,
                );
            }

            清单预检(&项目根, &界面表)?;
            让 输出值 = 命令::新建(解析cargo())
                .单参数("check")
                .单参数("--message-format=json")
                .当前目录(&项目根)
                .取输出()
                .映射错误(|错误值| {
                    错误处理::错误处理!(
                        "{}",
                        界面表.取带参消息(
                            "cargo_check_failed",
                            &[&项目根.展示().转字符串(), &错误值.转字符串()]
                        )
                    )
                })?;
            // 构建工具整体是否成功（决定最终退出码）
            让 退出码值 = 如果 输出值.进程状态.退出成功() {
                退出码::成功退出码
            } 否则 {
                退出码::失败退出码
            };

            // 结构化诊断翻译（与运行编译失败路径共用同一管线）
            让 标准错误文本 = 字符串::从utf8宽松(&输出值.标准错误).转字符串();
            让 编译输出文本 = 格式化!(
                "{}\n{}",
                字符串::从utf8宽松(&输出值.标准输出),
                标准错误文本
            );
            让 _ = 翻译编译诊断(
                &编译输出文本,
                &标准错误文本,
                &诊断上下文 {
                    界面表: &界面表,
                    语言包参数: &语言包,
                    项目根: &项目根,
                    映射器: &映射管理器值,
                    源码: &源码文本,
                    源文件: &源文件值,
                    入口产物: 源路径.克隆值(),
                    列位映射: 有值(&列位映射),
                    入口行映射: 有值(&入口行映射),
                    项目上下文: 有值(&项目上下文值),
                },
                输出值.进程状态.退出成功(),
                假, // 检查场景：无诊断且成功时提示「编译成功」
                假, // 检查：诊断输出由本函数负责（非流式透传）
            );
            成功(退出码值)
        }
        命令组::导出 { 文件们, 语言包 } => 导出目标们(&文件们, &语言包),
        命令组::转译预览 { 源文件值, 语言包 } => {
            // 转译预览：仅输出到标准输出，不产生任何文件（与导出互补）
            让 界面表 = 按文件取界面(&源文件值, &语言包);
            确保源文件(&界面表, &源文件值)?;
            让 源码文本 = 文件系统::读取字符串(&源文件值)?;
            让 映射管理器值 = 加载映射(语言包, 有值(&源文件值))?;
            // 与导出同一管线（项目上下文与模块注解）：预览产物即导出产物
            让 项目上下文值 = 收集导出上下文(&源文件值, &映射管理器值);
            让 可变 缓存 = 引擎库::缓存::转译缓存::默认持久化();
            让 英文代码 = 导出转译(
                &源文件值,
                &源码文本,
                &映射管理器值,
                &项目上下文值,
                &可变 缓存,
                假,
                &源文件值.展示().转字符串(),
            );
            打印!("{英文代码}");
            让 _ = 界面表; // 标准输出模式无需额外提示
            成功(退出码::成功退出码)
        }
        命令组::反译重生 {
            目标语言,
            源语言,
            输出目录,
            语言包,
            文件们,
        } => 反译重生目标们(&目标语言, &源语言, &输出目录, &语言包, &文件们),
        命令组::安装组件 { 子命令值 } => {
            // 省略子命令时默认安装全部组件（当前仅语言服务器）
            匹配 子命令值.解包或用(安装子命令::语言服务 { 强制: 假 }) {
                安装子命令::语言服务 { 强制 } => 安装语言服务(&界面表, 强制)?,
                安装子命令::工具链 {
                    版本,
                    发布标签,
                    仅分析器,
                    强制,
                } => 安装工具链(&界面表, &版本, &发布标签, 强制, 仅分析器)?,
            }
            成功(退出码::成功退出码)
        }
        命令组::诊断环境 => 诊断环境().映射(|()| 退出码::成功退出码),
        命令组::待译清单 {
            语言,
            导出路径,
            清空清单,
        } => {
            // 待译清单（未译全的编译器与构建工具消息）查看、导出、清零：
            // 参数文案保持英文（维护者命令，不占用语言包界面键）
            让 界面表 = 界面::界面消息表::全局表();
            翻译缺口::清单命令(&界面表, 语言, 导出路径, 清空清单)?;
            成功(退出码::成功退出码)
        }
        命令组::速查 { 语言, 标记 } => {
            让 语言码 = 语言
                .克隆值()
                .解包或用否则(探测系统语言);
            // 速查表标题固定英文：全球用户的第一张卡不依赖界面语言
            引擎库::语言::设定语言(&语言码);
            让 虚拟源 = 路径缓冲::从(格式化!("main.{语言码}"));
            // 借虚拟扩展名让映射加载走既有解析链（项目内、全局、内置语言包）
            让 映射管理器值 = 加载映射(无, 有值(&虚拟源))?;
            打印!(
                "{}",
                引擎库::指南::渲染速查表(&映射管理器值, &语言码, 标记)
            );
            成功(退出码::成功退出码)
        }
        命令组::指南 { 语言, 输出文件 } => {
            让 语言码 = 语言
                .克隆值()
                .解包或用否则(探测系统语言);
            // 指南正文随语言包界面消息切换，先同步引擎全局语言
            引擎库::语言::设定语言(&语言码);
            让 虚拟源 = 路径缓冲::从(格式化!("main.{语言码}"));
            让 映射管理器值 = 加载映射(无, 有值(&虚拟源))?;
            让 指南文本 = 引擎库::指南::渲染母语指南(&映射管理器值, &语言码);
            匹配 输出文件 {
                有值(输出路径) => {
                    // 写盘成功才报「已生成」：失败时让异常冒泡到顶层母语错误出口
                    文件系统::写入(&输出路径, 指南文本)?;
                    打印行!(
                        "{}",
                        界面::界面消息表::全局表()
                            .取带参消息("agents_generated", &[&输出路径.展示().转字符串()])
                    );
                }
                无 => 打印!("{指南文本}"),
            }
            成功(退出码::成功退出码)
        }
        命令组::语言包管理 { 子命令值 } => {
            处理语言子命令(子命令值).映射(|()| 退出码::成功退出码)
        }
        命令组::添加依赖 { 依赖们 } => 处理添加子命令(&依赖们),
        命令组::映射管理 { 子命令值 } => 匹配 子命令值 {
            映射子命令::自动生成 {
                包名,
                语言,
                服务商,
                目标版本,
                输出路径,
                安装依赖,
            } => {
                让 语言值 = 语言.解包或用否则(探测系统语言);
                引擎库::语言::设定语言(&语言值);
                让 输出路径 = 输出路径.解包或用否则(|| {
                    // 默认写入项目语言包根：从当前目录向上找清单，
                    // 保证任意子目录下执行都落到项目本地语言包；
                    // 主仓库内落到引擎语言包目录（单一数据源），用户项目落语言包目录
                    让 基目录 = 环境::当前目录()
                        .转选项()
                        .而后映射(|当前目录值| 向上查找项目根(&当前目录值))
                        .解包或用否则(|| 路径缓冲::从("."));
                    语言包根目录(&基目录).连接(格式化!("{}/crates/{}.toml", 语言值, 包名))
                });
                运行自动生成(
                    &包名,
                    &语言值,
                    &服务商,
                    &输出路径,
                    目标版本.作为解引用(),
                )
                .映射(|()| 退出码::成功退出码)
                .检视(|_| {
                    // 安装依赖：生成成功后把库加入当前项目依赖（用户项目内执行时）
                    如果 安装依赖 {
                        安装库到当前项目(&包名, 目标版本.作为解引用());
                    }
                    // 生成后自动对所在语言包跑一次冲突检测（仅提示，不改变退出码：
                    // 语言包可能存在历史遗留问题，生成成功与否以写入结果为准）
                    如果让 有值(语言目录) = 输出路径.父目录().而后映射(|上级| 上级.父目录())
                        && 语言目录.连接("keywords.toml").存在()
                        && 让 有值(目录文本) = 语言目录.取字符串引用()
                    {
                        让 _ = 运行检查(有值(目录文本));
                    }
                })
            }
            映射子命令::校验 { 目标 } => {
                // 校验输出的语言默认跟随系统语言
                让 语言值 = 探测系统语言();
                引擎库::语言::设定语言(&语言值);
                匹配 运行检查(目标.作为解引用()) {
                    成功(检查通过) => {
                        让 结果码 = 如果 检查通过 {
                            退出码::成功退出码
                        } 否则 {
                            退出码::失败退出码
                        };
                        成功(结果码)
                    }
                    错误(错误值) => 错误(错误值),
                }
            }
            映射子命令::覆盖检查 { 语言 } => {
                // 覆盖率输出的语言默认跟随系统语言
                让 界面语言值 = 探测系统语言();
                引擎库::语言::设定语言(&界面语言值);
                匹配 运行覆盖检查(语言.作为解引用()) {
                    成功(覆盖通过) => {
                        让 覆盖码 = 如果 覆盖通过 {
                            退出码::成功退出码
                        } 否则 {
                            退出码::失败退出码
                        };
                        成功(覆盖码)
                    }
                    错误(错误值) => 错误(错误值),
                }
            }
            映射子命令::脚手架 {
                源语言,
                目标语言,
                输出路径,
                服务商,
            } => {
                让 语言值 = 探测系统语言();
                引擎库::语言::设定语言(&语言值);
                运行生成骨架(&源语言, &目标语言, 输出路径.作为解引用(), &服务商)
                    .映射(|()| 退出码::成功退出码)
            }
        },
        命令组::库注册 { 子命令值 } => 匹配 子命令值 {
            库子命令::检索 { 关键词 } => {
                包仓库::检索(关键词.作为解引用()).映射(|()| 退出码::成功退出码)
            }
            库子命令::安装映射 {
                包名,
                语言,
                强制,
            } => 包仓库::安装(&包名, &语言, 强制)
                .映射(|()| 退出码::成功退出码),
            库子命令::列表 => 包仓库::列出().映射(|()| 退出码::成功退出码),
            库子命令::移除映射 { 包名, 语言 } => {
                包仓库::移除已装(&包名, &语言).映射(|()| 退出码::成功退出码)
            }
            库子命令::重新拉取 => {
                包仓库::更新().映射(|()| 退出码::成功退出码)
            }
            库子命令::发布映射 {
                包名,
                语言,
                映射文件,
                作者,
            } => 包仓库::发布(&包名, &语言, 映射文件, 作者.作为解引用())
                .映射(|()| 退出码::成功退出码),
        },
    }
}

/// 首次运行引导：欢迎、编译器缺失提示与下一步建议
///
/// 仅交互终端（标准输出是终端）且标记文件不存在时显示；
/// 显示后写入标记文件，保证每个用户只看到一次。
函数 也许显示首次运行(界面表: &界面::界面消息表) {
    使用 标准库::输入输出::是否终端特征;
    如果 !标准库::输入输出::标准输出().是否为终端() {
        返回;
    }
    // 与语言管理的全局语言目录相同的跨平台主目录解析
    让 主目录 = 环境::环境变量("HOME")
        .或用否则(|_| 环境::环境变量("USERPROFILE"))
        .转选项();
    让 标记文件 = 主目录.映射(|主目录值| 路径缓冲::从(主目录值).连接(".rz").连接("first-run"));
    如果让 有值(标记值) = &标记文件
        && 标记值.存在()
    {
        返回;
    }
    打印行!();
    打印行!("{}", 界面表.取消息("first_run_hello"));
    // 编译器检测：内置工具链目录或环境变量路径（含可执行文件名）任一命中
    让 编译工具可用 = 引擎库::工具链::查找工具链程序("rustc").是否为有值()
        || 环境::选项环境变量("PATH").有值且(|路径值| {
            环境::切分路径(&路径值).任意(|目录| {
                让 程序名 = 如果 配置!(窗口) { "rustc.exe" } 否则 { "rustc" };
                目录.连接(程序名).存在()
            })
        });
    如果 !编译工具可用 {
        打印行!("{}", 界面表.取消息("first_run_rustc_missing"));
    }
    打印行!("{}", 界面表.取消息("first_run_next_steps"));
    打印行!();
    如果让 有值(标记值) = 标记文件 {
        如果让 有值(父级) = 标记值.父目录() {
            让 _ = 标准库::文件系统::递归创建目录(父级);
        }
        让 _ = 标准库::文件系统::写入(标记值, "");
    }
}

/// 处理语言包子命令
函数 处理语言子命令(子命令值: 语言子命令) -> 错误处理::结果<空> {
    让 界面表 = 界面::界面消息表::全局表();
    匹配 子命令值 {
        语言子命令::列表 => {
            让 清单 = 列出语言();
            如果 清单.是否为空() {
                打印行!("{}", 界面表.取消息("no_lang_installed"));
                返回 成功(());
            }
            打印行!(
                "{}",
                界面表.取带参消息("installed_langs_count", &[&清单.元素数().转字符串()])
            );
            对于 信息项 在 &清单 {
                让 标签 = 匹配 信息项.语言来源 {
                    语言来源::内置 => 界面表.取消息("tag_builtin"),
                    语言来源::用户安装 => 界面表.取消息("tag_user"),
                };
                让 扩展文本 = 信息项
                    .扩展名
                    .作为解引用()
                    .映射(|扩展值| 格式化!(".{}", 扩展值))
                    .解包或用否则(|| 界面表.取消息("unknown"));
                让 版本文本 = 匹配 信息项.版本.作为解引用() {
                    有值(版本值) => 版本值.转字符串(),
                    无 => 界面表.取消息("unknown"),
                };
                让 可移除文本 = 如果 信息项.语言来源 == 语言来源::内置 {
                    界面表.取消息("not_removable")
                } 否则 {
                    字符串::新建()
                };
                让 显示文本 = 信息项
                    .显示名称
                    .作为解引用()
                    .映射(|名称值| 格式化!("{} ({})", 名称值, 信息项.语言代码))
                    .解包或用否则(|| 信息项.语言代码.克隆值());
                打印行!(
                    "{}",
                    界面表.取带参消息(
                        "lang_list_display",
                        &[&标签, &显示文本, &扩展文本, &版本文本, &可移除文本]
                    )
                );
            }
            打印行!(
                "{}",
                界面表.取带参消息(
                    "global_lang_dir",
                    &[&全局语言目录().展示().转字符串()]
                )
            );
            成功(())
        }
        语言子命令::安装语言 { 源, 强制 } => 安装语言(&源, 强制),
        语言子命令::检索 { 关键词 } => {
            // 市场浏览：下载仓库压缩包扫描语言包（含显示名与版本），
            // 可选关键词过滤；与安装共用同一远程源回退策略
            打印行!(
                "{}",
                界面表.取带参消息("lang_search_header", &[&界面表.取消息("lang_search_source")])
            );
            让 找到 = 搜索远程语言(关键词.作为解引用())?;
            如果 找到.是否为空() {
                让 关键词文本 = 关键词.作为解引用();
                如果让 有值(关键词值) = 关键词文本 {
                    如果 !关键词值.裁剪().是否为空() {
                        打印行!("{}", 界面表.取带参消息("lang_search_empty", &[关键词值]));
                    } 否则 {
                        打印行!("{}", 界面表.取消息("lang_search_empty_all"));
                    }
                } 否则 {
                    打印行!("{}", 界面表.取消息("lang_search_empty_all"));
                }
                返回 成功(());
            }
            对于 信息项 在 &找到 {
                让 名称值 = 信息项.显示名称.作为解引用().解包或用("—");
                让 版本文本 = 信息项.版本.作为解引用().解包或用("—");
                打印行!("  {:<12} {:<16} {}", 信息项.语言代码, 名称值, 版本文本);
            }
            打印行!();
            打印行!("{}", 界面表.取消息("lang_search_hint"));
            成功(())
        }
        语言子命令::移除语言 { 语言代码 } => 移除语言(&语言代码),
    }
}

/// 处理添加依赖子命令：封装构建工具的添加命令，成功后提示母语映射可用性
///
/// 失败时捕获构建工具的标准错误而非直接透传：初始化只生成方言入口
///（源码目录下的母语主文件），而构建工具只认标准 Rust 入口与清单里的目标声明，
/// 于是新建项目后第一条添加依赖命令必然在清单解析阶段失败，原文是构建器
/// 内部术语且不含任何可执行动作。
///
/// 命中提示要同时满足两个条件：项目确实无目标（[`有货物目标`]，与运行和
/// 检查的阻断同源）且构建工具确实报在清单解析上
///（[`清单错误判定`]）。缺后半个条件，包名为空这类真清单错误也会被
/// 指向检查子命令；缺前半个条件，网络失败、库名拼错都会多出一句无关指引。命中后
/// 先打母语指引，再把构建工具的标准输出与标准错误原样回显——不隐藏它的信息，退出码不变。
函数 处理添加子命令(依赖们: &[字符串]) -> 错误处理::结果<退出码> {
    让 界面表 = 界面::界面消息表::全局表();
    让 当前目录值 = 环境::当前目录()?;
    让 项目根 = 向上查找项目根(&当前目录值)
        .缺值转错(|| 错误处理::错误处理!("{}", 界面表.取消息("add_no_project")))?;
    让 输出值 = 命令::新建(解析cargo())
        .单参数("add")
        .参数(依赖们)
        .当前目录(&项目根)
        .取输出()
        .映射错误(|错误值| 错误处理::错误处理!("{}", 界面表.取带参消息("add_cargo_failed", &[&错误值.转字符串()])))?;
    如果 !输出值.进程状态.退出成功() {
        让 标准错误文本 = 字符串::从utf8宽松(&输出值.标准错误);
        如果 !有货物目标(&项目根) && 清单错误判定(&标准错误文本) {
            让 入口名 = 入口提示名(&项目根);
            // 模板里入口名出现两次（「缺哪个主文件」与「该检查哪个文件」），
            // 故同一实参传两次，与映射缺失提示的写法一致
            错误打印行!("{}", 界面表.取带参消息("add_no_targets_hint", &[&入口名, &入口名]));
        }
        // 构建工具自身的错误详情原样回显，保持既有输出可见
        让 标准输出文本 = 字符串::从utf8宽松(&输出值.标准输出);
        打印!("{标准输出文本}");
        错误打印!("{标准错误文本}");
        返回 成功(退出码::失败退出码);
    }
    让 标准输出文本 = 字符串::从utf8宽松(&输出值.标准输出);
    打印!("{标准输出文本}");
    让 语言码 = 界面::探测界面语言();
    对于 依赖项 在 依赖们 {
        // 依赖名取版本分隔符前段，并将连字符归一为下划线（代码中导入路径用下划线）
        让 包名 = 依赖项.分割('@').下一个().取值或(依赖项).替换('-', "_");
        匹配 查找库映射别名(&语言码, &项目根, &包名) {
            有值(别名) => 打印行!("{}", 界面表.取带参消息("add_mapping_ready", &[&包名, &别名])),
            无 => 打印行!(
                "{}",
                界面表.取带参消息("add_mapping_missing", &[&包名, &包名])
            ),
        }
    }
    成功(退出码::成功退出码)
}

/// 构建工具的失败是否报在清单解析上（其输出不随界面语言本地化，故按英文特征）
函数 清单错误判定(标准错误文本: &文本) -> 布尔 {
    标准错误文本.包含("no targets specified in the manifest")
        || 标准错误文本.包含("failed to parse manifest")
}

/// 面向读者的方言入口名（源码目录下的母语主文件之类），仅用于提示文案
///
/// 优先入口主文件，其次按文件名排序取源码目录直属的第一个方言文件——不能依赖
/// 目录读取的任意顺序，否则同一项目两次失败可能指向不同文件。母语入口别名需要
/// 映射表才能识别，此处按排序结果给一个确定值，读者照着跑同样会生成入口产物。
函数 入口提示名(项目根: &路径类型) -> 字符串 {
    让 扩展名序列 = 全部可用扩展名();
    让 源码目录 = 项目根.连接("src");
    让 成功(目录项集) = 文件系统::读取目录(&源码目录) 否则 {
        返回 "src/main.rs".转字符串();
    };
    让 可变 候选们: 向量<路径缓冲> = 目录项集
        .展平()
        .映射(|目录项| 目录项.文件路径方法())
        .过滤(|路径值| 路径值.是否为文件() && 是否方言文件(路径值, &扩展名序列))
        .收集();
    候选们.排序();
    让 首选 = 候选们
        .迭代()
        .查找(|路径值| 路径值.文件名干().而后映射(|词干值| 词干值.取字符串引用()) == 有值("main"))
        .或用否则(|| 候选们.第一个());
    匹配 首选 {
        有值(路径值) => 路径值
            .去前缀(项目根)
            .解包或用(路径值.转路径())
            .展示()
            .转字符串()
            .替换('\\', "/"),
        无 => "src/main.rs".转字符串(),
    }
}

/// 查找第三方库在当前语言映射中的母语别名（项目或全局语言包优先于内置）
///
/// 扫描库映射目录的模块路径节：值的首段（双冒号分隔）与库名
/// 匹配即命中；命中时返回对应母语键作为示例提示。
函数 查找库映射别名(
    语言码: &文本,
    项目根: &路径类型,
    包名: &文本,
) -> 选项<字符串> {
    // 1. 项目内语言包与全局用户语言包的库映射目录
    让 目录们 = [
        语言包根目录(项目根).连接(语言码).连接("crates"),
        全局语言目录().连接(语言码).连接("crates"),
    ];
    对于 目录 在 &目录们 {
        让 成功(目录项集) = 文件系统::读取目录(目录) 否则 {
            继续;
        };
        对于 目录项 在 目录项集.展平() {
            让 路径值 = 目录项.文件路径方法();
            如果 路径值.扩展名().而后映射(|扩展值| 扩展值.取字符串引用()) != 有值("toml") {
                继续;
            }
            如果让 成功(内容文本) = 文件系统::读取字符串(&路径值)
                && 让 有值(别名) = 查找映射别名(&内容文本, 包名)
            {
                返回 有值(别名);
            }
        }
    }
    // 2. 内置语言包（未知语言代码自动回退中文）
    让 内置数据 = 获取内置数据(语言码);
    对于 (_, 内容文本) 在 内置数据.三方库数据 {
        如果让 有值(别名) = 查找映射别名(内容文本, 包名) {
            返回 有值(别名);
        }
    }
    无
}

/// 在单个映射内容中查找第三方库对应的母语别名
函数 查找映射别名(内容文本: &文本, 包名: &文本) -> 选项<字符串> {
    让 值对象: TOML处理::TOML值 = TOML处理::解析字符串(内容文本).转选项()?;
    让 路径表 = 值对象.获取("模块路径")?.作为表格()?;
    对于 (键名, 值项) 在 路径表 {
        让 有值(英文路径) = 值项.作为字符串() 否则 {
            继续;
        };
        让 首段 = 英文路径.分割("::").下一个().取值或(英文路径);
        如果 首段.替换('-', "_") == 包名 {
            返回 有值(键名.克隆值());
        }
    }
    无
}

/// 映射自动生成时的安装依赖：把库加入当前项目依赖（找不到项目时仅告警）
///
/// 指定目标版本时按同一版本需求添加（精确锁定或前缀），保证应用依赖与映射生成基准一致。
函数 安装库到当前项目(包名: &文本, 目标版本: 选项<&文本>) {
    让 界面表 = 界面::界面消息表::全局表();
    让 有值(根目录) = 环境::当前目录()
        .转选项()
        .而后映射(|当前目录值| 向上查找项目根(&当前目录值))
    否则 {
        打印行!("{}", 界面表.取消息("mapping_auto_install_no_project"));
        返回;
    };
    让 规格文本 = 匹配 目标版本.而后映射(版本需求) {
        有值(需求值) => 格式化!("{}@{}", 包名, 需求值),
        无 => 包名.转字符串(),
    };
    匹配 命令::新建(解析cargo())
        .单参数("add")
        .单参数(&规格文本)
        .当前目录(&根目录)
        .进程状态()
    {
        成功(进程状态值) => {
            如果 进程状态值.退出成功() {
                打印行!("{}", 界面表.取带参消息("mapping_auto_installed", &[包名]))
            } 否则 {
                打印行!(
                    "{}",
                    界面表.取带参消息(
                        "mapping_auto_install_failed",
                        &[包名, &进程状态值.转字符串()]
                    )
                )
            }
        }
        错误(错误值) => 打印行!(
            "{}",
            界面表.取带参消息("mapping_auto_install_failed", &[包名, &错误值.转字符串()])
        ),
    }
}

/// 根据源码文件定位项目根（包含清单文件的目录）
函数 查找项目根(源文件值: &路径类型) -> 错误处理::结果<路径缓冲> {
    让 文件目录 = 如果 源文件值.是否绝对() {
        源文件值
            .父目录()
            .映射(|父级| 父级.转路径缓冲())
            .解包或用否则(|| 路径缓冲::从("."))
    } 否则 {
        环境::当前目录()?
            .连接(源文件值)
            .父目录()
            .映射(|父级| 父级.转路径缓冲())
            .解包或用否则(|| 路径缓冲::从("."))
    };

    如果让 有值(根目录) = 向上查找项目根(&文件目录) {
        返回 成功(根目录);
    }
    // 未找到清单时明确报错：静默回退当前目录会在无关目录写入入口产物
    错误处理::错误中止!(
        "{}",
        界面::界面消息表::全局表().取带参消息("no_project_root", &[&源文件值.展示().转字符串()])
    )
}

/// 计算运行与检查的入口产物路径。
///
/// 仅当源文件确为项目源码目录直属入口（父目录恰为项目的源码目录，且词干为
/// [`入口产物名`]，即主函数词或库词）时才写入构建工具自动
/// 发现的 包根——构建工具只认这两个默认位置，入口产物无法移出源码目录：
/// - 项目根的构建脚本入口则进托管目录，不把构建脚本覆盖为入口；
/// - 子目录或示例里恰好名为入口的文件，产物进托管目录，不越界覆盖宿主入口；
/// - 其余非入口文件一律进 [`托管目录`](引擎库::产物布局::托管目录)
///   镜像源码布局，教学源码目录里只留母语源文件与入口产物；源文件在项目之外时
///   退回旧行为（产物写在自身旁边）。
///
/// 库入口有一个例外：清单里显式声明了库路径时以声明为准
///（[`声明的库路径`]），否则升级后那些项目会静默编译一份不再更新的托管产物。
函数 入口产物路径(项目根: &路径类型, 源文件值: &路径类型, 管理器值: &映射管理器) -> 路径缓冲 {
    让 默认产物 = 入口产物默认(源文件值, 项目根, 管理器值);
    如果 默认产物 == 有值(库产物路径) {
        声明的库路径(项目根).解包或用否则(|| 项目根.连接(库产物路径))
    } 否则 如果 让 有值(产物名) = 默认产物 {
        项目根.连接(产物名)
    } 否则 {
        引擎库::产物布局::产物路径(项目根, 源文件值)
    }
}

/// 源文件是否为项目的固定入口（[`入口产物路径`] 的判定条件，
/// 产物注解需按同一条件选择子模块目录，故单独暴露）
函数 是否入口源(源文件值: &路径类型, 项目根: &路径类型, 管理器值: &映射管理器) -> 布尔 {
    入口产物默认(源文件值, 项目根, 管理器值).是否为有值()
}

/// 按托管布局为方言源文件的产物补模块路径注解，并返回磁盘行到引擎直行映射
///
/// `是否根` 取 [`是否入口源`]：包根的子模块与源文件同目录，
/// 非根文件的子模块位于 `<自身词干>/`（编译器文件式布局）。
/// 落点解析（方言子模块到托管产物、手写标准 Rust 子模块到原地）由引擎统一
/// 实现，命令行写盘与诊断行映射重算必须走同一函数，否则注解行数不同、行号回译错位。
公开(包) 函数 注解产物(
    代码: &文本,
    项目根: &路径类型,
    源文件: &路径类型,
    产物: &路径类型,
    是否根: 布尔,
    扩展名序列: &[字符串],
) -> (字符串, 向量<无符号机器整数>) {
    让 父级 = 源文件.父目录().解包或用(路径类型::新建("."));
    让 子目录 = 如果 是否根 {
        父级.转路径缓冲()
    } 否则 {
        匹配 源文件.文件名干().而后映射(|词干值| 词干值.取字符串引用()) {
            有值(词干值) => 父级.连接(词干值),
            无 => 父级.转路径缓冲(),
        }
    };
    让 产物目录 = 产物.父目录().解包或用(路径类型::新建("."));
    引擎库::产物布局::注解产物模块路径并返回行映射(
        代码,
        &子目录,
        产物目录,
        项目根,
        扩展名序列,
    )
}

/// 旧布局遗留在源文件旁边的产物迁走后，清理同目录同名产物
///
/// 升级到托管布局后，源码目录里的旧产物已无人引用：留在母语目录里
/// 正是本次要解决的问题。安全口径与 [`写入转译产物`] 一致——内容与本次
/// 产物相同（就是我们的生成物）才删；不同则可能是用户手改过，备份为备份文件
/// 再删，绝不静默丢弃。
函数 迁移旧产物(旧产物: &路径类型, 产物: &路径类型, 内容文本: &文本, 界面表: &包::界面::界面消息表) {
    如果 旧产物 == 产物 || !旧产物.是否为文件() {
        返回;
    }
    让 相同 = 文件系统::读取字符串(旧产物).成功且(|旧内容| 旧内容 == 内容文本);
    如果 相同 {
        让 _ = 文件系统::删除文件(旧产物);
        返回;
    }
    让 备份 = 旧产物.设扩展名("rs.bak");
    如果 文件系统::重命名(旧产物, &备份).是否为成功() {
        打印行!(
            "{}",
            界面表.取带参消息(
                "legacy_product_moved",
                &[&旧产物.展示().转字符串(), &备份.展示().转字符串()]
            )
        );
    }
}

/// 入口文件写完后，清掉托管目录里同一源文件的旧产物
///
/// 库入口被纳入入口集合之前，产物落在托管目录；入口规则改后
/// 它写到 包根，托管目录里那份残留已无任何模块路径注解引用，却仍可能被
/// 编译器的默认模块查找命中——代码改了却不报错，比报错更糟。只删托管目录内、
/// 且不等于本次落点的那一个文件：清单用库路径指着托管路径时两者相同，不能删。
函数 清理入口生成副本(项目根: &路径类型, 源文件: &路径类型, 产物: &路径类型) {
    让 陈旧产物 = 引擎库::产物布局::产物路径(项目根, 源文件);
    如果 陈旧产物 != 产物 && 陈旧产物.是否为文件() {
        让 _ = 文件系统::删除文件(陈旧产物);
    }
}

/// 文件父目录（规范化为绝对路径，纯比较不依赖文件必已存在）是否恰为
/// 项目源码目录——即该文件是否为项目真正的源码目录直属入口，用于防止子目录
/// 里恰好名为入口的文件越界聚合、覆盖宿主入口产物。
函数 直属源码目录(源文件值: &路径类型, 项目根: &路径类型) -> 布尔 {
    让 有值(父级) = 源文件值.父目录() 否则 {
        返回 假;
    };
    // 相对路径按当前目录补齐为绝对，再与已规范化的项目根对齐比较；
    // 路径可能尚未落盘（单元测试、新建文件），规范化失败时退回词法路径。
    让 绝对父级 = 如果 父级.是否绝对() {
        父级.转路径缓冲()
    } 否则 {
        环境::当前目录()
            .映射(|当前目录值| 当前目录值.连接(父级))
            .解包或用否则(|_| 父级.转路径缓冲())
    };
    让 规范父级 = 绝对父级
        .规范路径()
        .解包或用否则(|_| 绝对父级.克隆值());
    让 源码目录 = 项目根.连接("src");
    让 规范源码 = 源码目录.规范路径().解包或用否则(|_| 源码目录.克隆值());
    规范父级 == 规范源码
}

/// 构建工具自动发现的两个 包根产物路径（相对项目根）
常量 主程序产物路径: &文本 = "src/main.rs";
常量 库产物路径: &文本 = "src/lib.rs";

/// 词干是否为项目入口主函数名：字面主函数名，或语言包中映射到主函数名的
/// 母语词（中文的主函数、日文的主函数、俄文的主函数等）。
///
/// 初始化生成源码目录下的母语主文件，教程与示例同样使用该命名；
/// 早期项目还可能有母语词干入口——都须聚合到
/// 固定入口产物，否则构建工具报「没有可构建目标」。
函数 是否入口词干(词干: &文本, 管理器值: &映射管理器) -> 布尔 {
    词干 == "main"
        || 管理器值
            .取关键词表()
            .迭代()
            .任意(|(母语词, 英文)| 英文 == "main" && 母语词 == 词干)
}

/// 入口词干对应的默认 包根产物路径（相对项目根）；非入口词干返回 `无`
///
/// 构建工具只自动发现两个 包根：可执行程序与库。方言侧对应两组词干：
/// 主函数词及其语言包主函数词，和字面库词。
/// 库词不是 Rust 关键字、各语言包都不翻译它，因此它没有母语别名——写
/// 母语库文件仍然只是普通模块，这一点与主函数不对称，但正是构建工具的
/// 命名要求，造库要的是零配置而不是文件名本地化。
函数 入口产物名(词干: &文本, 管理器值: &映射管理器) -> 选项<静态字符串引用> {
    如果 是否入口词干(词干, 管理器值) {
        有值(主程序产物路径)
    } 否则 如果 词干 == "lib" {
        有值(库产物路径)
    } 否则 {
        无
    }
}

/// 源文件按其词干应落到的默认 包根路径（[`入口产物名`] 与
/// [`直属源码目录`] 两级判定合一）；非入口返回 `无`
函数 入口产物默认(
    源文件值: &路径类型,
    项目根: &路径类型,
    管理器值: &映射管理器,
) -> 选项<静态字符串引用> {
    让 词干 = 源文件值.文件名干().而后映射(|词干值| 词干值.取字符串引用())?;
    入口产物名(词干, 管理器值).过滤(|_| 直属源码目录(源文件值, 项目根))
}

/// 清单中库路径显式声明的库产物路径（绝对形式，项目内才返回）
///
/// 纳管库入口之前，造方言库的唯一配方是在清单里手写库路径
///（当时库入口的产物落在托管目录）。入口集合纳入库词后 rzc 默认改写
/// 包根，若无视既有声明，那些项目会继续编译一份不再被更新的托管产物——
/// 代码改了却不报错，比报错更糟。声明是用户意图的唯一来源，故以它为准；
/// 无声明、内容非法、或声明指向项目外时返回 `无` 回退默认位置，不猜意图、
/// 不往项目外写文件。
函数 声明的库路径(项目根: &路径类型) -> 选项<路径缓冲> {
    让 文本内容 = 文件系统::读取字符串(项目根.连接("Cargo.toml")).转选项()?;
    让 清单值: TOML处理::TOML值 = TOML处理::解析字符串(&文本内容).转选项()?;
    让 相对路径 = 清单值.获取("lib")?.获取("path")?.作为字符串()?;
    // 词法归一后仍要在项目根内：前缀判断不消解上级目录，
    // 字面拼接看起来像在项目里，实际写到了项目外
    让 拼接路径 = 项目根.连接(相对路径);
    让 内部路径 = 引擎库::产物布局::相对项目根路径(项目根, &拼接路径)?;
    有值(项目根.连接(内部路径))
}

/// 从指定目录向上查找项目根（含清单文件的目录），未找到返回 `无`
公开(包) 函数 向上查找项目根(起始目录: &路径类型) -> 选项<路径缓冲> {
    让 可变 当前目录值 = 起始目录.规范路径().解包或用否则(|_| 起始目录.转路径缓冲());
    循环 {
        如果 当前目录值.连接("Cargo.toml").存在() {
            返回 有值(当前目录值);
        }
        当前目录值 = 当前目录值.父目录()?.转路径缓冲();
    }
}

/// 同 [`向上查找项目根`]（兄弟模块使用的等价入口名）
公开(包) 函数 查找项目根向上(起始目录: &路径类型) -> 选项<路径缓冲> {
    向上查找项目根(起始目录)
}

/// 调用构建工具前的清单预检：把其自身高频新手错误（非 JSON 通道）拦在
/// 本地，用母语报出并给出下一步命令。
///
/// 只拦「构建工具一定会失败」且原因确定的两种形态：
/// - 清单不是合法配置（括号、引号、缩进写坏）；
/// - 未声明编译目标且两个默认入口都不存在（初始化被跳过，
///   或入口文件不在源码目录直属时最常见）。
///
/// 其余构建工具错误（依赖解析、工作区等）仍由翻译链处理。
函数 清单预检(项目根: &路径类型, 界面表: &界面::界面消息表) -> 错误处理::结果<空> {
    让 路径值 = 项目根.连接("Cargo.toml");
    让 文本内容 = 文件系统::读取字符串(&路径值)?;
    TOML处理::解析字符串::<TOML处理::TOML值>(&文本内容).映射错误(|错误值| {
        错误处理::错误处理!(
            "{}",
            界面表.取带参消息(
                "manifest_parse_error",
                &[&路径值.展示().转字符串(), &错误值.转字符串()]
            )
        )
    })?;
    如果 !有货物目标(项目根) {
        错误处理::错误中止!("{}", 界面表.取消息("manifest_no_target"));
    }
    成功(())
}

/// 项目是否有构建工具能读取的构建目标（[`清单预检`] 的判定核心）
///
/// 判定规则的唯一来源：运行与检查的阻断、添加依赖的「先跑一次检查」提示都走这里，
/// 两处语义不许分叉。
///
/// 目标声明：库、可执行程序、示例任一存在；或默认发现位置
/// 有内容——两个默认入口，或二进制、测试、基准目录非空
///（里面可能是子目录入口，故只判空不判后缀：误报会阻断正常项目，漏报仅退化为
/// 翻译链处理构建工具英文错）。清单读不到或不是合法内容时按「有目标」返回，
/// 让调用方去报各自更准确的错（解析失败不等于无目标）。
///
/// 诊断子命令的项目自检也走这里，判定口径不许分叉。
公开(包) 函数 有货物目标(项目根: &路径类型) -> 布尔 {
    让 成功(文本内容) = 文件系统::读取字符串(项目根.连接("Cargo.toml")) 否则 {
        返回 真;
    };
    让 成功(清单值) = TOML处理::解析字符串::<TOML处理::TOML值>(&文本内容) 否则 {
        返回 真;
    };
    让 已声明 = 清单值.获取("lib").是否为有值()
        || 清单值.获取("bin").是否为有值()
        || 清单值.获取("example").是否为有值();
    已声明
        || ["src/main.rs", "src/lib.rs"]
            .迭代()
            .任意(|相对路径段| 项目根.连接(相对路径段).存在())
        || ["src/bin", "tests", "benches"].迭代().任意(|目录名| {
            让 路径值 = 项目根.连接(目录名);
            路径值.是否为目录()
                && 文件系统::读取目录(&路径值)
                    .转选项()
                    .有值且(|可变 目录项集| 目录项集.下一个().是否为有值())
        })
}

/// 项目内语言包根目录：主仓库为单副本结构，引擎语言包目录；
/// 普通用户项目仍沿用项目语言包目录约定（自定义覆盖）
公开(包) 函数 语言包根目录(基目录: &路径类型) -> 路径缓冲 {
    让 引擎包目录 = 基目录.连接("crates/engine/lang-packs");
    如果 引擎包目录.是否为目录() {
        引擎包目录
    } 否则 {
        基目录.连接("lang-packs")
    }
}

/// 测试辅助：无项目上下文的单文件转译（关键字与别名管线，非 ASCII 模块注解）
#[配置(测试)]
函数 转译为英文(源文本: &文本, 管理器值: &映射管理器) -> 字符串 {
    注解非母语模块(&引擎库::转译管线(源文本, 管理器值).转译产物文本)
}

/// 收集待导出源文件所在范围的声明上下文（导出与预览共用）
///
/// 单文件且能定位项目根时复用 [`收集项目上下文`]（扫描整个
/// 源码目录，跨文件声明豁免与运行、检查一致）；目录或项目外文件按「待导出文件
/// 集合」收集——导出的契约是零锁定毕业，可在任意目录导出教材示例，
/// 不要求目标位于项目内。
函数 收集导出上下文(
    源文件值: &路径类型,
    管理器值: &映射管理器,
) -> 引擎库::别名::项目上下文 {
    让 扩展名序列 = 全部可用扩展名();
    如果 源文件值.是否为目录() {
        返回 按文件收集上下文(收集方言文件(源文件值, &扩展名序列), 管理器值);
    }
    如果让 成功(项目根) = 查找项目根(源文件值) {
        让 可变 上下文值 = 收集项目上下文(&项目根, 源文件值, 管理器值);
        // 导出可在源码目录之外（示例目录、项目根）：项目扫描只覆盖源码目录，
        // 用文件所在目录补齐兄弟文件（模块名与声明名，否则跨文件字段
        // 访问仍会被别名改写）
        让 扫描根 = 源文件值.父目录().解包或用(路径类型::新建("."));
        如果 !扫描根.以开头(项目根.连接("src")) {
            // 单文件补齐只扫同目录兄弟（不递归），避免遍历大目录子树
            让 额外 = 按文件收集上下文(
                收集同级方言文件(扫描根, &扩展名序列),
                管理器值,
            );
            上下文值.模块集.扩展(额外.模块集);
            上下文值.名字集.扩展(额外.名字集);
            上下文值.条目集.扩展(额外.条目集);
        }
        返回 上下文值;
    }
    让 扫描根 = 源文件值.父目录().解包或用(路径类型::新建("."));
    // 项目外单文件：上下文只看同目录兄弟（不递归整个父目录子树）
    让 可变 文件们 = 收集同级方言文件(扫描根, &扩展名序列);
    // 目标文件必须纳入（父目录无方言文件等边界）
    如果 !文件们.迭代().任意(|路径值| 路径值 == 源文件值) {
        文件们.推入(源文件值.转路径缓冲());
    }
    按文件收集上下文(文件们, 管理器值)
}

/// 从给定源文件集合收集项目级声明上下文
///
/// 模块名取文件词干（路径段豁免的保守近似），声明名由引擎扫描各文件内容。
函数 按文件收集上下文(
    文件们: 实现 可迭代<货物类型 = 路径缓冲>,
    管理器值: &映射管理器,
) -> 引擎库::别名::项目上下文 {
    让 可变 模块集 = 哈希集合::新建();
    让 可变 源集合: 向量<字符串> = 向量::新建();
    对于 路径值 在 文件们 {
        如果让 有值(词干) = 路径值.文件名干().而后映射(|词干值| 词干值.取字符串引用()) {
            模块集.置入(词干.转字符串());
        }
        如果让 成功(源文本) = 文件系统::读取字符串(&路径值) {
            源集合.推入(源文本);
        }
    }
    引擎库::别名::项目上下文::从源集合(
        模块集,
        源集合.迭代().映射(字符串::作为文本切片),
        管理器值,
    )
}

/// 转译单个源文件为可导出的标准 Rust（项目上下文与模块路径注解）
///
/// 显示名是教学告警的文件归属名（导出与预览按调用方给的路径显示）。
/// 目录模式区分导出形态：目录批量导出时非入口文件的子模块位于
/// 自身词干目录下（编译器默认查找规则），注解须带词干前缀；单文件导出
/// 按 包根处理（与既有导出产物一致）。
函数 导出转译(
    路径值: &路径类型,
    源文本: &文本,
    管理器值: &映射管理器,
    项目: &引擎库::别名::项目上下文,
    缓存: &可变 转译缓存,
    目录模式: 布尔,
    显示名: &文本,
) -> 字符串 {
    让 转译结果 =
        项目缓存转译(源文本, 管理器值, 缓存, 有值(项目), 显示名);
    注解导出模块(&转译结果.转译产物文本, 路径值, 管理器值, 目录模式)
}

/// 给导出产物的非 ASCII 模块名补模块路径注解
///
/// 仅 包根（主函数词或库词）与单文件导出按当前目录解析；
/// 目录模式的其他文件是子模块，须按自身词干下的子名注解。
函数 注解导出模块(
    代码: &文本,
    路径值: &路径类型,
    管理器值: &映射管理器,
    目录模式: 布尔,
) -> 字符串 {
    让 词干 = 路径值.文件名干().而后映射(|词干值| 词干值.取字符串引用()).取值或("");
    // 包根词干按当前目录解析子模块，口径与 [`入口产物名`] 统一，
    // 不在注解侧另立一套入口判定
    如果 !目录模式 || 入口产物名(词干, 管理器值).是否为有值() {
        注解非母语模块(代码)
    } 否则 {
        引擎库::模块路径::注解嵌套模块并返回行映射(代码, 词干).0
    }
}

/// 校验输入是单个源文件（运行、检查、预览共用）
///
/// 目录输入在这三个子命令里无意义，且在某些平台上直接读取目录
/// 只会报拒绝访问；路径不存在
/// 时则只暴露系统层「文件不存在」错误。两者都给出可操作提示，把目录
/// 批量导出指向导出子命令。
函数 确保源文件(界面表: &包::界面::界面消息表, 源文件值: &路径类型) -> 错误处理::结果<空> {
    如果 !源文件值.存在() {
        错误处理::错误中止!("{}", 界面表.取带参消息("input_missing", &[&源文件值.展示().转字符串()]));
    }
    如果 源文件值.是否为目录() {
        错误处理::错误中止!(
            "{}",
            界面表.取带参消息("input_is_directory", &[&源文件值.展示().转字符串()])
        );
    }
    成功(())
}

/// 按语言分组待导出文件（组与组内均保持排序稳定）
///
/// 目录可能混有多种方言：按扩展名检测语言并分组，
/// 每组用自身语言包转译——单锚点管理器会把其他语言的关键字原样留在
/// 产物里。显式指定语言包目录时尊重用户选择，不分组。
函数 按语言分组文件<'甲>(
    文件们: &'甲 [路径缓冲],
    显式语言包: 选项<&路径类型>,
) -> 向量<向量<&'甲 路径缓冲>> {
    如果 显式语言包.是否为有值() {
        返回 向量![文件们.迭代().收集()];
    }
    让 可变 分组表: 有序映射<字符串, 向量<&路径缓冲>> = 有序映射::新建();
    对于 路径值 在 文件们 {
        让 扩展值 = 路径值.扩展名().而后映射(|扩展段| 扩展段.取字符串引用()).取值或("");
        让 语言码 = 扩展名转语言代码(扩展值).解包或用否则(|| 扩展值.转字符串());
        分组表.取条目(语言码).或用缺省().推入(路径值);
    }
    分组表.取全部值().收集()
}

/// 导出单处方言源码（单目标与批量共用的唯一入口）
///
/// 路径不存在时直接给可操作提示：否则锚点落到无扩展名路径，
/// 映射加载会报「无法识别源文件扩展名」这类无关错误。
函数 导出单个(源文件值: &路径类型, 语言包: 选项<&路径类型>) -> 错误处理::结果<向量<路径缓冲>> {
    如果 !源文件值.存在() {
        让 界面表 = 按文件取界面(源文件值, &语言包.映射(路径类型::转路径缓冲));
        错误处理::错误中止!("{}", 界面表.取带参消息("input_missing", &[&源文件值.展示().转字符串()]));
    }
    // 目录模式的语言包解析锚点：目录内第一个方言文件（目录本身无
    // 扩展名，直接用于映射加载会报「无法识别源文件扩展名」）
    让 锚点 = 如果 源文件值.是否为目录() {
        让 扩展名序列 = 全部可用扩展名();
        收集方言文件(源文件值, &扩展名序列)
            .消费迭代()
            .下一个()
            .解包或用否则(|| 源文件值.转路径缓冲())
    } 否则 {
        源文件值.转路径缓冲()
    };
    让 界面表 = 按文件取界面(&锚点, &语言包.映射(路径类型::转路径缓冲));
    // 目录可能混有多种方言：导出源们内按扩展名分组、每组用
    // 自身语言包（单锚点管理器会把其他语言的关键字原样留在
    // 产物里）；显式指定语言包时统一使用指定语言包目录
    导出源们(&界面表, 源文件值, 语言包)
}

/// 导出子命令入口：单目标保持历史行为，多目标批量导出并汇总
///
/// 批量模式复用 [`导出单个`] 逐目标导出：单个目标失败不中断其余目标，
/// 最后打印成功与失败汇总并以非零码退出，减少逐个手动导出造成的遗漏
/// 与滞后事故。单目标失败仍直接冒泡为顶层错误（与历史行为一致）。
函数 导出目标们(
    文件们: &[路径缓冲],
    语言包: &选项<路径缓冲>,
) -> 错误处理::结果<退出码> {
    让 界面表 = 文件们
        .第一个()
        .映射(|单个文件| 按文件取界面(单个文件, 语言包))
        .解包或用否则(界面::界面消息表::全局表);
    // 参数校验：同一目标重复出现只会重复写同一份产物（后写覆盖前写），
    // 多半是命令拼写失误，直接报错而非静默去重
    让 可变 已见 = 哈希集合::新建();
    如果让 有值(重复项) = 文件们
        .迭代()
        .查找(|单个文件| !已见.置入(单个文件.作为系统串().转拥有()))
    {
        错误处理::错误中止!(
            "{}",
            界面表.取带参消息("eject_args_duplicate", &[&重复项.展示().转字符串()])
        );
    }

    如果让 有值(单个目标) = 文件们.第一个().过滤(|_| 文件们.长度() == 1) {
        对于 输出路径 在 导出单个(单个目标, 语言包.作为解引用())? {
            打印行!(
                "{}",
                界面表.取带参消息("exported_to", &[&输出路径.展示().转字符串()])
            );
        }
        返回 成功(退出码::成功退出码);
    }

    让 可变 成功数 = 0无符号机器整数;
    让 可变 失败数 = 0无符号机器整数;
    对于 单个文件 在 文件们 {
        匹配 导出单个(单个文件, 语言包.作为解引用()) {
            成功(输出们) => {
                成功数 += 1;
                对于 输出路径 在 输出们 {
                    打印行!(
                        "{}",
                        界面表.取带参消息("exported_to", &[&输出路径.展示().转字符串()])
                    );
                }
            }
            错误(错误值) => {
                失败数 += 1;
                错误打印行!(
                    "{}",
                    界面表.取带参消息(
                        "eject_failed",
                        &[&单个文件.展示().转字符串(), &格式化!("{错误值:#}")]
                    )
                );
            }
        }
    }
    如果 失败数 == 0 {
        打印行!("{}", 界面表.取带参消息("eject_summary_ok", &[&成功数.转字符串()]));
        成功(退出码::成功退出码)
    } 否则 {
        错误打印行!(
            "{}",
            界面表.取带参消息(
                "eject_summary_partial",
                &[&成功数.转字符串(), &失败数.转字符串()]
            )
        );
        成功(退出码::失败退出码)
    }
}

/// 导出一处方言源码为标准 Rust 文件，返回全部产物路径
///
/// 目录模式：递归导出目录下全部方言文件（直接读取目录在某些平台会报
/// 拒绝访问，必须先按文件与目录分流）。单文件与目录共用项目级声明上下文：否则
/// 模块声明的声明位受保护而导入路径段与字段访问被别名改写，声明与
/// 引用错位。
///
/// 混合语言目录按扩展名分组，每组独立加载语言包与上下文。写盘统一走
/// [`写入转译产物`]：已有同名产物且内容不同时先备份
///（与运行、检查同口径），避免渐进迁移中手写产物被静默覆盖。
函数 导出源们(
    界面表: &包::界面::界面消息表,
    源文件值: &路径类型,
    显式语言包: 选项<&路径类型>,
) -> 错误处理::结果<向量<路径缓冲>> {
    让 目录模式 = 源文件值.是否为目录();
    让 文件们 = 如果 目录模式 {
        收集方言文件(源文件值, &全部可用扩展名())
    } 否则 {
        向量![源文件值.转路径缓冲()]
    };
    如果 文件们.是否为空() {
        错误处理::错误中止!(
            "{}",
            界面表.取带参消息("eject_no_source", &[&源文件值.展示().转字符串()])
        );
    }
    让 可变 缓存 = 引擎库::缓存::转译缓存::默认持久化();
    让 可变 输出们 = 向量::带容量(文件们.元素数());
    对于 分组 在 按语言分组文件(&文件们, 显式语言包) {
        让 锚点: &路径类型 = 分组.第一个().映射(|路径值| 路径值.转路径()).解包或用(源文件值);
        让 映射管理器值 = 加载映射(显式语言包.映射(路径类型::转路径缓冲), 有值(锚点))?;
        // 目录模式：组内文件共享上下文；单文件：项目级上下文（含 包根探测）
        让 项目上下文值 = 如果 目录模式 {
            按文件收集上下文(分组.迭代().映射(|路径值| (*路径值).转路径缓冲()), &映射管理器值)
        } 否则 {
            收集导出上下文(源文件值, &映射管理器值)
        };
        对于 路径值 在 分组 {
            让 源文本 = 文件系统::读取字符串(路径值)?;
            // 导出前扫一遍冲突（无教学检查时一并关闭）：字段名与声明名命中词条会被
            // 改写、会恐慌的词条被当文本用——只提示不阻断，避免导出后才发现语义已变
            如果 引擎库::校验::教学告警已启用() {
                对于 提示 在 引擎库::导出冲突提示::扫描冲突(&源文本, &映射管理器值) {
                    引擎库::警告日志!(
                        "eject_hint",
                        "{}：{}",
                        路径值.展示(),
                        提示.转提示文本()
                    );
                }
            }
            让 代码 = 导出转译(
                路径值,
                &源文本,
                &映射管理器值,
                &项目上下文值,
                &可变 缓存,
                目录模式,
                &路径值.展示().转字符串(),
            );
            让 输出路径 = 路径值.设扩展名("rs");
            写入转译产物(&输出路径, &代码, 界面表)?;
            输出们.推入(输出路径);
        }
    }
    成功(输出们)
}

/// 反译重生命令：把方言或标准 Rust 工程反译重生为目标方言（跨母语阅读）
///
/// 逐文件管线与导出同源但更纯粹：源方言经正向转译管线到
/// 标准 Rust，再经引擎反译重生到目标方言；镜像写出到输出目录（默认源工程
/// 根旁的镜像目录），复制清单与工具链锁定文件，并用目标
/// 语言包渲染 AGENTS.md。
///
/// 产物是纯方言源（不含模块路径注解——那些由 rzc 正向构建时按托管布局
/// 再补），结构随源保持一致，可再次构建编译。保真边界：目标语言包缺该
/// 词条（尤其带双冒号的多段模块路径）时该段保留英文；一词多母语反查取排序最小
/// 的确定候选，故跨母语「阅读」不保证逐字节还原某一种子方言的原词。
函数 反译重生目标们(
    目标语言: &文本,
    源语言: &选项<字符串>,
    输出目录: &选项<路径缓冲>,
    语言包: &选项<路径缓冲>,
    文件们: &[路径缓冲],
) -> 错误处理::结果<退出码> {
    // 锚点：优先显式路径，否则当前目录（默认整目录遍历）
    让 锚点 = 文件们
        .第一个()
        .克隆副本()
        .解包或用否则(|| 环境::当前目录().解包或用否则(|_| 路径缓冲::从(".")));
    让 界面表 = 按文件取界面(&路径缓冲::从(格式化!("main.{目标语言}")), &无);
    如果 !锚点.存在() {
        错误处理::错误中止!(
            "{}",
            界面表.取带参消息("input_missing", &[&锚点.展示().转字符串()])
        );
    }
    // 源工程根：目录即扫描根（并向上定位项目根），文件则定位其项目根
    让 (扫描根, 项目根) = 如果 锚点.是否为目录() {
        让 根目录 = 向上查找项目根(&锚点).解包或用否则(|| 锚点.克隆值());
        (锚点.克隆值(), 根目录)
    } 否则 {
        让 根目录 = 查找项目根(&锚点)?;
        (根目录.克隆值(), 根目录)
    };
    // 目标语言包管理器（英文到目标母语反查），借虚拟扩展名走既有解析链
    让 目标管理器 = 加载映射(无, 有值(&路径缓冲::从(格式化!("main.{目标语言}"))))?;
    // 输出目录：显式优先，否则源工程根旁的镜像目录
    让 输出根 = 输出目录
        .克隆值()
        .解包或用否则(|| 项目根.连接(格式化!("relocalized.{目标语言}")));

    // 收集候选源文件：方言文件与标准 Rust 文件（把标准扩展名临时登记为方言扩展名以复用遍历）
    让 可变 扩展名序列 = 全部可用扩展名();
    扩展名序列.推入("rs".转字符串());
    让 源文件们 = 收集方言文件(&扫描根, &扩展名序列);
    如果 源文件们.是否为空() {
        错误处理::错误中止!(
            "{}",
            界面表.取带参消息("eject_no_source", &[&扫描根.展示().转字符串()])
        );
    }

    // 源语言管理器缓存（按语言代码）；显式源语言时统一用该语言
    让 可变 管理器缓存: 哈希映射<字符串, 映射管理器> = 哈希映射::新建();
    让 可变 计数 = 0无符号机器整数;
    让 可变 写了入口 = 假;
    对于 路径值 在 &源文件们 {
        如果 输出根.是否绝对() && 路径值.以开头(&输出根) {
            继续; // 跳过上一次运行写出的目录（幂等重跑不自我吞噬）
        }
        让 扩展值 = 路径值.扩展名().而后映射(|扩展段| 扩展段.取字符串引用()).取值或("");
        让 源文本 = 文件系统::读取字符串(路径值)?;
        让 英文文本 = 如果 扩展值 == "rs" {
            源文本 // 已是标准 Rust：正向不转译，直接反译
        } 否则 {
            // 方言源：按其语言（或显式源语言）正向转译到标准 Rust
            让 语言码 = 源语言.克隆值().解包或用否则(|| {
                扩展名转语言代码(扩展值).解包或用否则(|| 扩展值.转字符串())
            });
            如果 !管理器缓存.包含键(&语言码) {
                让 虚拟源 = 路径缓冲::从(格式化!("main.{语言码}"));
                让 管理器值 = 加载映射(语言包.克隆值(), 有值(&虚拟源))?;
                管理器缓存.置入(语言码.克隆值(), 管理器值);
            }
            引擎库::转译管线(&源文本, &管理器缓存[&语言码]).转译产物文本
        };
        让 方言文本 = 引擎库::反译重生::反译重生(&英文文本, &目标管理器);
        // 镜像写出：相对扫描根的路径，扩展名换为目标语言代码
        让 相对路径 = 路径值.去前缀(&扫描根).解包或用(路径值.转路径());
        让 输出路径 = 输出根.连接(相对路径).设扩展名(目标语言);
        如果让 有值(父级) = 输出路径.父目录() {
            文件系统::递归创建目录(父级)?;
        }
        文件系统::写入(&输出路径, 方言文本)?;
        计数 += 1;
        让 词干 = 输出路径.文件名干().而后映射(|词干值| 词干值.取字符串引用()).取值或("");
        如果 是否入口词干(词干, &目标管理器) {
            写了入口 = 真;
        }
    }

    // 复制清单与工具链锁定（源工程根存在才复制）
    对于 清单名 在 ["Cargo.toml", "rust-toolchain.toml", "rust-toolchain"] {
        让 源路径 = 项目根.连接(清单名);
        如果 源路径.是否为文件() {
            让 _ = 文件系统::复制文件(&源路径, 输出根.连接(清单名));
        }
    }
    // 目标方言的协作说明书（与指南打通，复用引擎渲染；失败不阻断产物写出）
    让 _ = 文件系统::写入(
        输出根.连接("AGENTS.md"),
        引擎库::指南::渲染母语指南(&目标管理器, 目标语言),
    );

    如果 !写了入口 {
        引擎库::警告日志!("relocalize", "{}", 界面表.取消息("relocalize_no_module_entry"));
    }
    打印行!(
        "{}",
        界面表.取带参消息(
            "relocalize_done",
            &[&计数.转字符串(), &输出根.展示().转字符串()]
        )
    );
    成功(退出码::成功退出码)
}

/// 带项目上下文的缓存转译，附项目级声明上下文（跨文件声明豁免），
/// 教学告警按文件归属输出
///
/// 缓存语境指纹由引擎并入项目上下文指纹：
/// 项目声明集合变化时相关缓存自动失效。
函数 项目缓存转译(
    源文本: &文本,
    管理器值: &映射管理器,
    缓存: &可变 引擎库::缓存::转译缓存,
    项目: 选项<&引擎库::别名::项目上下文>,
    显示名: &文本,
) -> 引擎库::缓存::转译输出 {
    让 产物 = 引擎库::静默带项目转译源文本(源文本, 管理器值, 缓存, 项目)
        .解包或用否则(|_错误值| {
            // 缓存失败不阻断转译：回退无缓存静默管线（告警统一由下方输出，不重复）
            引擎库::警告日志!(
                "cli",
                "{}",
                引擎库::语言::取消息("log_transpile_cache_fallback")
            );
            引擎库::静默带项目转译管线(源文本, 管理器值, 项目)
        });
    按文件输出教学告警(源文本, 显示名, 管理器值);
    产物
}

/// 教学告警的文件归属名：项目内文件相对源码目录显示，与 [`转译项目文件`]
/// 给兄弟文件算的显示名同口径；源码目录之外（根目录脚本、目录导出）按给定路径显示
函数 教学显示名(源文件值: &路径类型, 项目根: &路径类型) -> 字符串 {
    让 绝对路径 = 源文件值.规范路径().解包或用否则(|_| 源文件值.转路径缓冲());
    让 源码目录 = 项目根.连接("src");
    绝对路径
        .去前缀(&源码目录)
        .或用否则(|_| 绝对路径.去前缀(项目根))
        .解包或用(绝对路径.转路径())
        .展示()
        .转字符串()
}

/// 解析构建工具可执行文件：内置工具链优先，环境变量路径回退；
/// 找不到时返回其命令名由系统报错（保持与旧行为一致的报错信息）
公开 函数 解析cargo() -> 路径缓冲 {
    引擎库::工具链::查找工具链程序("cargo").解包或用否则(|| 路径缓冲::从("cargo"))
}

/// 解析编译器可执行文件：内置工具链优先，环境变量路径回退
公开 函数 解析rustc() -> 路径缓冲 {
    引擎库::工具链::查找工具链程序("rustc").解包或用否则(|| 路径缓冲::从("rustc"))
}

/// 解析与 [`解析rustc`] 同工具链的文档工具：优先内建或环境变量路径的独立文档工具，
/// 缺失时改用编译器的系统根精确定位其配套文档工具（两者同
/// 系统根，版本一致），否则回退环境变量路径的文档工具名由系统报错。
///
/// 映射自动生成时手动调用文档工具生成 JSON 必须与构建工具编译库文件用同一
/// 编译器，否则跨版本链接触发版本不匹配错误。
公开 函数 解析文档工具() -> 路径缓冲 {
    如果让 有值(路径值) = 引擎库::工具链::查找工具链程序("rustdoc") {
        返回 路径值;
    }
    如果让 成功(输出值) = 命令::新建(解析rustc())
        .单参数("--print")
        .单参数("sysroot")
        .取输出()
    {
        让 系统根 = 字符串::从utf8宽松(&输出值.标准输出).裁剪().转字符串();
        如果 !系统根.是否为空() {
            让 程序路径 = 路径缓冲::从(系统根)
                .连接("bin")
                .连接(格式化!("rustdoc{}", 环境::平台常量::可执行后缀));
            如果 程序路径.是否为文件() {
                返回 程序路径;
            }
        }
    }
    路径缓冲::从("rustdoc")
}

/// 递归收集目录下全部方言源文件（路径排序保证确定性）
///
/// 支持多层模块布局：模块文件可放在以父模块
/// 命名的子目录中，与编译器的「父模块文件加父模块目录」规则一致。
函数 收集方言文件(目录: &路径类型, 扩展名序列: &[字符串]) -> 向量<路径缓冲> {
    让 可变 输出们 = 向量::新建();
    递归收集方言文件(目录, 扩展名序列, &可变 输出们);
    输出们.排序();
    输出们
}

函数 递归收集方言文件(目录: &路径类型, 扩展名序列: &[字符串], 输出们: &可变 向量<路径缓冲>) {
    让 成功(目录项集) = 文件系统::读取目录(目录) 否则 {
        返回;
    };
    对于 目录项 在 目录项集.展平() {
        让 路径值 = 目录项.文件路径方法();
        让 成功(文件类型值) = 目录项.文件类型() 否则 {
            继续;
        };
        如果 文件类型值.是否为目录() {
            // 构建产物目录不会出现在源码树内；无特殊排除
            递归收集方言文件(&路径值, 扩展名序列, 输出们);
        } 否则 如果 文件类型值.是否为文件() && 是否方言文件(&路径值, 扩展名序列) {
            输出们.推入(路径值);
        }
    }
}

/// 判断路径是否是已注册的方言源文件（扩展名可带点或不带点）
函数 是否方言文件(路径值: &路径类型, 扩展名序列: &[字符串]) -> 布尔 {
    路径值
        .扩展名()
        .而后映射(|扩展段| 扩展段.取字符串引用())
        .有值且(|扩展段| {
            扩展名序列
                .迭代()
                .任意(|单个| 单个 == 扩展段 || 单个 == &格式化!(".{扩展段}"))
        })
}

/// 收集目录直接子文件中的方言源文件（不递归，路径排序保证确定性）
///
/// 单文件导出的上下文补齐只关心同目录兄弟模块；若沿用递归收集，在用户
/// 主目录等大目录下会无谓遍历整棵子树。
函数 收集同级方言文件(目录: &路径类型, 扩展名序列: &[字符串]) -> 向量<路径缓冲> {
    让 成功(目录项集) = 文件系统::读取目录(目录) 否则 {
        返回 向量::新建();
    };
    让 可变 输出们: 向量<路径缓冲> = 目录项集
        .展平()
        .过滤映射(|目录项| {
            让 路径值 = 目录项.文件路径方法();
            让 文件类型值 = 目录项.文件类型().转选项()?;
            (文件类型值.是否为文件() && 是否方言文件(&路径值, 扩展名序列)).然后有值(路径值)
        })
        .收集();
    输出们.排序();
    输出们
}

/// 收集项目级声明上下文（跨文件声明豁免）
///
/// 递归扫描源码目录下全部层级的方言文件与入口文件（可能在项目根），收集：
/// - 模块名：各方言文件词干（含嵌套层级，供多层路径链豁免）；
/// - 声明名：各文件的项名与结构体字段（裸使用处豁免）。
///
/// 与 [`转译项目文件`] 扫描范围保持一致（源码目录全层级递归），
/// 入口文件不在源码目录时单独补扫；读取失败的文件跳过（转译阶段会报错）。
函数 收集项目上下文(
    项目根: &路径类型,
    入口文件: &路径类型,
    管理器值: &映射管理器,
) -> 引擎库::别名::项目上下文 {
    使用 标准库::集合::哈希集合;
    让 扩展名序列 = 全部可用扩展名();
    让 入口规范 = 入口文件.规范路径().转选项();
    让 可变 模块集 = 哈希集合::新建();
    让 可变 源集合: 向量<字符串> = 向量::新建();
    让 可变 入口已见 = 假;

    让 源码目录 = 项目根.连接("src");
    对于 路径值 在 收集方言文件(&源码目录, &扩展名序列) {
        如果让 有值(词干) = 路径值.文件名干().而后映射(|词干值| 词干值.取字符串引用()) {
            模块集.置入(词干.转字符串());
        }
        如果 入口规范.是否为有值() && 路径值.规范路径().转选项() == 入口规范 {
            入口已见 = 真;
        }
        如果让 成功(源文本) = 文件系统::读取字符串(&路径值) {
            源集合.推入(源文本);
        }
    }
    // 入口文件不在源码目录（如项目根的自定义路径）时单独补扫
    如果 !入口已见 && 入口文件.是否为文件() {
        如果让 有值(词干) = 入口文件.文件名干().而后映射(|词干值| 词干值.取字符串引用()) {
            模块集.置入(词干.转字符串());
        }
        如果让 成功(源文本) = 文件系统::读取字符串(入口文件) {
            源集合.推入(源文本);
        }
    }

    引擎库::别名::项目上下文::从源集合(
        模块集,
        源集合.迭代().映射(字符串::作为文本切片),
        管理器值,
    )
}

/// 同步转译项目源码目录下的全部方言源文件（入口文件除外）为对应产物文件，
/// 使多文件项目的模块引用链可用；非已注册方言扩展名的文件（如手写标准 Rust）跳过。
///
/// 转译在线程作用域中并行执行（教学项目文件相互独立，无共享可变
/// 状态）；共享缓存用互斥锁保护——查询与插入为短临界区，转译本身在锁外
/// 并行，文件多时与串行相比显著提速（缓存命中时仅查表，开销可忽略）。
函数 转译项目文件(
    项目根: &路径类型,
    入口文件: &路径类型,
    管理器值: &映射管理器,
    缓存: &互斥锁<引擎库::缓存::转译缓存>,
    项目: &引擎库::别名::项目上下文,
) -> 错误处理::结果<空> {
    让 界面表 = 界面::界面消息表::全局表();
    让 源码目录 = 项目根.连接("src");
    让 扩展名序列 = 全部可用扩展名();
    // 无源码目录时没有项目内模块要转译（由构建工具自行报错），但根目录方言文件
    // 的产物也写在托管目录，失效残留的清理照旧要跑
    如果 !源码目录.是否为目录() {
        清理失效产物(项目根, &扩展名序列, &界面表);
        返回 成功(());
    }
    // 源码目录顶层的主函数入口词干在这里跳过：
    // 入口产物只由本次请求的文件写到自动发现的 包根，而所有主函数入口
    // 共用同一份入口产物——兄弟入口也走一遍会互相覆盖刚写好的那份。
    // 库入口不跳过：它的产物是托管目录里自己那份，与主程序产物
    // 无冲突；纳管库之前它就是这么转译的，而清单用库路径指着托管
    // 路径的老项目仍要靠这条路径拿到新鲜产物（跳过的话构建工具会编译一份陈旧的）。
    // 嵌套层级中的同名文件不是入口（编译器模块树按路径区分），照常转译。
    让 入口绝对 = 入口文件.规范路径().转选项();
    让 可变 文件们 = 向量::新建();
    对于 路径值 在 收集方言文件(&源码目录, &扩展名序列) {
        如果 入口绝对.作为引用方法() == 有值(&路径值) {
            继续;
        }
        让 位于源码顶层 = 路径值.父目录() == 有值(源码目录.转路径());
        如果 位于源码顶层
            && 路径值
                .文件名干()
                .而后映射(|词干值| 词干值.取字符串引用())
                .有值且(|词干| 是否入口词干(词干, 管理器值))
        {
            继续;
        }
        让 有值(扩展值) = 路径值.扩展名().而后映射(|扩展段| 扩展段.取字符串引用()) 否则 {
            继续;
        };
        如果 扩展名转语言代码(扩展值).是否为无() {
            继续;
        }
        文件们.推入(路径值);
    }

    // 语境指纹只算一次（全部文件共享同一语言包与项目上下文）；
    // 项目上下文指纹并入后，跨文件声明变化时旧缓存自动失效。
    // 必须与引擎静默带项目转译源文本使用同一组合函数：
    // 入口文件与项目内其它文件共用同一个缓存实例，
    // 两处指纹算法若不同，同一语境会算出两个键，缓存互相不可见。
    让 指纹值 = 引擎库::缓存::转译缓存::组合指纹(
        管理器值.取语境指纹(),
        有值(项目.指纹()),
    );
    让 首个错误: 互斥锁<选项<错误处理::任意错误>> = 互斥锁::新建(无);
    线程作用域(|作用域句柄| {
        让 可变 句柄们 = 向量::带容量(文件们.元素数());
        对于 路径值 在 文件们 {
            // 界面表与首个错误遮蔽为引用：移动闭包捕获的是可复制的共享引用
            让 界面引用 = &界面表;
            让 错误引用 = &首个错误;
            让 扩展名引用: &[字符串] = &扩展名序列;
            // 相对源码目录的显示名在闭包外算好（避免路径缓冲被移动进线程）
            让 显示名 = 路径值
                .去前缀(&源码目录)
                .解包或用(&路径值)
                .展示()
                .转字符串();
            让 句柄 = 作用域句柄.生成(移动 || {
                如果 错误引用
                    .加锁()
                    .解包或用否则(中毒错误::取内层)
                    .是否为有值()
                {
                    返回; // 已有失败文件：跳过剩余工作
                }
                让 源文本 = 匹配 文件系统::读取字符串(&路径值) {
                    成功(内容文本) => 内容文本,
                    错误(错误值) => {
                        *错误引用
                            .加锁()
                            .解包或用否则(中毒错误::取内层) =
                            有值(错误处理::错误处理!(
                                "{}",
                                界面引用.取带参消息(
                                    "transpile_file_failed",
                                    &[&路径值.展示().转字符串(), &错误值.转字符串()]
                                )
                            ));
                        返回;
                    }
                };
                // 短临界区：查询缓存（命中直接复用产物）
                让 已缓存 = 缓存
                    .加锁()
                    .解包或用否则(中毒错误::取内层)
                    .缓存查询(&源文本, 指纹值)
                    .克隆副本();
                让 产物 = 匹配 已缓存 {
                    有值(缓存产物) => 缓存产物,
                    无 => {
                        // 锁外并行转译，完成后短临界区写回缓存；
                        // 静默管线：教学告警由匹配之外带文件名输出（多文件项目
                        // 中裸行列无法定位到具体文件）；项目上下文保证
                        // 跨文件调用的成员名与声明侧一致
                        让 新产物 = 引擎库::静默带项目转译管线(
                            &源文本,
                            管理器值,
                            有值(项目),
                        );
                        缓存
                            .加锁()
                            .解包或用否则(中毒错误::取内层)
                            .缓存插入(&源文本, 指纹值, 新产物.克隆值());
                        新产物
                    }
                };
                // 告警挂在匹配之外：命中缓存同样要提示。旧版把它放在「未命中」
                // 分支里，同一份源码第二次检查一条告警都不出
                按文件输出教学告警(&源文本, &显示名, 管理器值);
                // 非入口产物写入托管目录并镜像源码布局：模块路径注解落点按同一布局解析，
                // 托管树内的相对位置与旧布局逐字一致（子模块在自身词干目录
                // 下，注解相对当前文件所在目录解析），手写标准 Rust 子模块
                // 则跨出托管目录指回源码目录。
                // 这里不按入口规则落 包根：兄弟入口若也落 包根，等于
                // 替用户凭空造出一个编译目标。
                // 主函数词干已在收集阶段跳过；库词干没跳过，产物照旧落托管目录，
                // 声明库路径的老项目靠它拿新鲜产物。
                让 产物路径值 = 引擎库::产物布局::产物路径(项目根, &路径值);
                让 产物文本 = 注解产物(
                    &产物.转译产物文本,
                    项目根,
                    &路径值,
                    &产物路径值,
                    假,
                    扩展名引用,
                )
                .0;
                如果让 错误(错误值) = 写出产物(项目根, &产物路径值, &产物文本, 界面引用) {
                    *错误引用
                        .加锁()
                        .解包或用否则(中毒错误::取内层) = 有值(错误值);
                } 否则 如果 入口产物默认(&路径值, 项目根, 管理器值).是否为无() {
                    // 旧布局把产物写在源文件旁：已迁走，
                    // 同目录遗留文件删掉后源码目录才真的只剩母语源文件。
                    // 入口源文件除外：库入口旁边的产物不是旧布局
                    // 遗留，而是 包根产物。
                    // 当兄弟文件顺带清理会把库产物删掉，可执行程序加库项目于是变成
                    // 「先检查库、再检查主程序，库产物消失，主程序报导入失败」，
                    // 恰好废掉库入口指的那条路（实机复现过）。
                    迁移旧产物(
                        &路径值.设扩展名("rs"),
                        &产物路径值,
                        &产物文本,
                        界面引用,
                    );
                }
            });
            句柄们.推入(句柄);
        }
        对于 句柄 在 句柄们 {
            让 _ = 句柄.连接();
        }
    });
    匹配 首个错误.取内层().解包或用(无) {
        有值(错误值) => 错误(错误值),
        无 => {
            // 全部产物写入完成后清失效残留
            清理失效产物(项目根, &扩展名序列, &界面表);
            成功(())
        }
    }
}

/// 清走托管目录中失去源文件的产物，有清理时向用户报一句数量
///
/// 判定只看源文件在不在（且不碰托管目录以外路径），实现见引擎
/// [`清理失效产物`](引擎库::产物布局::清理失效产物)：
/// 残留会让编译器按默认模块查找命中旧产物，被删掉的代码仍在参与编译。
函数 清理失效产物(项目根: &路径类型, 扩展名序列: &[字符串], 界面表: &界面::界面消息表) {
    让 已清理 = 引擎库::产物布局::清理失效产物(项目根, 扩展名序列);
    如果 !已清理.是否为空() {
        打印行!(
            "{}",
            界面表.取带参消息("stale_products_pruned", &[&已清理.元素数().转字符串()])
        );
    }
}

/// 输出单个方言文件的教学告警（Unicode 混淆、全角标点、教学检查），带文件名归属
///
/// 多文件项目中项目内文件分散在多个方言文件，裸行列无法定位具体文件。扫描集合
/// 与出口都在引擎（[`引擎库::输出教学告警`]），入口文件与
/// 兄弟文件共用同一份口径——早先这里自己拼了一遍扫描器，少调英文回落与保留字
/// 撞名两类：同一份代码走入口路径会提示、走兄弟路径不提示。
/// 输出时机与缓存无关（每次转译都提示）。
函数 按文件输出教学告警(源文本: &文本, 显示名: &文本, 管理器值: &映射管理器) {
    引擎库::输出教学告警(源文本, 管理器值, 有值(显示名));
}

/// 写转译产物，写入语义按落点分道
///
/// 托管目录是 rzc 专属地盘（用户在此无手写内容，源码目录的手写标准 Rust 也
/// 不会被复制进来），改版覆盖就是正常状态，备份只会在托管目录里留下
/// 无人认领的备份文件；而入口产物（可能是学习者手写
/// 英文 Rust）与项目外源文件旁的产物仍走 [`写入转译产物`] 的
/// 「内容不同先备份」护栏。
函数 写出产物(
    项目根: &路径类型,
    路径值: &路径类型,
    内容文本: &文本,
    界面表: &包::界面::界面消息表,
) -> 错误处理::结果<空> {
    如果 引擎库::产物布局::是否为托管产物(项目根, 路径值) {
        如果让 有值(父级) = 路径值.父目录() {
            文件系统::递归创建目录(父级)?;
        }
        返回 成功(文件系统::写入(路径值, 内容文本)?);
    }
    写入转译产物(路径值, 内容文本, 界面表)
}

/// 写转译产物：目标已存在且内容不同时先备份为备份文件，绝不静默覆盖用户文件。
///
/// 幂等重跑（内容一致）不产生备份；无同名手写文件时行为与直接写入完全一致。
函数 写入转译产物(路径值: &路径类型, 内容文本: &文本, 界面表: &包::界面::界面消息表) -> 错误处理::结果<空> {
    // 方言文件直接放在项目根等场景下源码目录可能尚不存在，先创建父目录
    //（否则写入报底层的「文件不存在」错误，语言服务侧翻译缓存已有同款处理）
    如果让 有值(父级) = 路径值.父目录() {
        文件系统::递归创建目录(父级)?;
    }
    如果让 成功(既有内容) = 文件系统::读取字符串(路径值)
        && 既有内容 != 内容文本
    {
        让 备份 = 路径值.设扩展名("rs.bak");
        文件系统::重命名(路径值, &备份)?;
        打印行!(
            "{}",
            界面表.取带参消息(
                "transpile_backup",
                &[&路径值.展示().转字符串(), &备份.展示().转字符串()]
            )
        );
    }
    文件系统::写入(路径值, 内容文本)?;
    成功(())
}

/// 探测本机当前生效工具链的通道号（如版本号或每夜版）
///
/// 解析编译器版本输出的第二段，取主次版本号作为通道；每夜版与测试版通道原样返回。
/// 编译器不在环境变量路径或输出格式异常时返回 `无`（调用方跳过生成锁定文件）。
函数 探测工具链通道() -> 选项<字符串> {
    让 输出值 = 命令::新建(解析rustc())
        .单参数("--version")
        .取输出()
        .转选项()?;
    如果 !输出值.进程状态.退出成功() {
        返回 无;
    }
    让 标准输出文本 = 字符串::从utf8宽松(&输出值.标准输出);
    让 版本文本 = 标准输出文本.分割空白().取第项(1)?;
    如果 版本文本.包含("nightly") {
        返回 有值("nightly".转字符串());
    }
    如果 版本文本.包含("beta") {
        返回 有值("beta".转字符串());
    }
    // 版本号取主次版本（通道只保留主次版本，补丁版本由工具链自行解析）
    让 可变 分段 = 版本文本.分割('.');
    让 主版本 = 分段.下一个()?;
    让 次版本 = 分段.下一个()?;
    如果 主版本.逐字符().全部(|单字| 单字.是数字字符()) && 次版本.逐字符().全部(|单字| 单字.是数字字符()) {
        有值(格式化!("{主版本}.{次版本}"))
    } 否则 {
        无
    }
}

/// 初始化子命令无法识别系统语言时的回退语言（也是语言菜单的回车默认值）
常量 初始化缺省语言: &文本 = "zh";

/// 解析初始化子命令的目标语言
///
/// 显式语言参数必须对应可用语言包：内置、项目内语言包目录
/// 或全局安装包；否则直接报错——静默回退会生成扩展名未知的主文件，
/// 而用户已经看到「创建成功」，首次运行才报「未知扩展名」。
///
/// 未显式指定时跟随系统区域设置；区域设置不在已支持列表时，终端交互
/// 场景列出菜单让用户自选（回车默认中文），非交互场景（持续集成或管道）
/// 打印回退提示后使用中文，不再静默降级。
函数 解析初始化语言(显式: 选项<字符串>) -> 错误处理::结果<字符串> {
    让 界面表 = 界面::界面消息表::全局表();
    如果让 有值(语言码) = 显式 {
        让 语言值 = 语言码.裁剪().转小写();
        如果 !语言值.是否为空() {
            如果 语言包可用(&语言值) {
                返回 成功(语言值);
            }
            错误处理::错误中止!(
                "{}",
                界面表.取带参消息("init_unknown_lang", &[&语言值, &可用语言代码文本()])
            );
        }
    }
    如果让 有值(语言码) = 界面::探测系统语言标签() {
        返回 成功(语言码);
    }
    如果让 有值(语言码) = 语言菜单提示(&界面表) {
        返回 成功(语言码);
    }
    让 区域原文 = 界面::系统区域标签().解包或用否则(|| "-".转字符串());
    打印行!("{}", 界面表.取带参消息("init_lang_fallback", &[&区域原文, 初始化缺省语言]));
    成功(初始化缺省语言.转字符串())
}

/// 语言参数是否可用：内置、全局安装、当前目录的项目内覆盖包
函数 语言包可用(语言码: &文本) -> 布尔 {
    如果 有内置语言包(语言码) {
        返回 真;
    }
    如果 全局语言包子目录名()
        .迭代()
        .任意(|名称值| 名称值 == 语言码)
    {
        返回 真;
    }
    让 当前目录值 = 环境::当前目录().解包或用否则(|_| 路径缓冲::从("."));
    语言包根目录(&当前目录值)
        .连接(语言码)
        .连接("keywords.toml")
        .是否为文件()
}

/// 错误提示里的候选语言列表（内置与已安装，按字母序）
函数 可用语言代码文本() -> 字符串 {
    让 可变 代码们: 向量<字符串> = 内置语言清单()
        .迭代()
        .映射(|代码| 代码.转字符串())
        .收集();
    对于 名称值 在 全局语言包子目录名() {
        如果 !代码们.包含(&名称值) {
            代码们.推入(名称值);
        }
    }
    代码们.排序();
    代码们.连接(", ")
}

/// 交互式语言菜单：序号、语言代码或空行（默认中文），最多重试 3 次
///
/// 仅在标准输入与标准输出都是终端时调用（非交互场景下读不到输入）
函数 语言菜单提示(界面表: &界面::界面消息表) -> 选项<字符串> {
    使用 标准库::输入输出::{是否终端特征, 写入特征};
    如果 !标准库::输入输出::标准输入().是否为终端() || !标准库::输入输出::标准输出().是否为终端() {
        返回 无;
    }
    让 代码们: 向量<字符串> = 内置语言清单()
        .迭代()
        .映射(|代码| 代码.转字符串())
        .收集();
    打印行!();
    打印行!("{}", 界面表.取消息("init_lang_menu_title"));
    对于 (序号, 代码) 在 代码们.迭代().枚举() {
        让 名称值 = 界面::母语语言名(代码).解包或用(代码);
        打印行!("  {:>2}) {} ({})", 序号 + 1, 名称值, 代码);
    }
    对于 _ 在 0..3 {
        让 缺省提示 = 格式化!(
            "{} ({})",
            界面::母语语言名(初始化缺省语言).解包或用(初始化缺省语言),
            初始化缺省语言
        );
        打印!("{}", 界面表.取带参消息("init_lang_menu_prompt", &[&缺省提示]));
        让 _ = 标准库::输入输出::标准输出().刷新();
        让 可变 行文本 = 字符串::新建();
        如果 标准库::输入输出::标准输入().读取行(&可变 行文本).解包或用(0) == 0 {
            // 输入结束（组合键）：交给调用方回退，不再重复提问
            打印行!();
            返回 无;
        }
        如果让 有值(语言码) = 界面::解析语言选择(&行文本, &代码们, 初始化缺省语言) {
            返回 有值(语言码);
        }
        打印行!("{}", 界面表.取消息("init_lang_menu_invalid"));
    }
    无
}

函数 创建项目(项目名: &文本, 语言码: &文本, 生成助手: 布尔) -> 错误处理::结果<空> {
    让 界面表 = 界面::界面消息表::按语言建表(语言码);
    引擎库::语言::设定语言(语言码);
    让 项目路径 = 路径缓冲::从(项目名);
    如果 项目路径.存在() {
        错误处理::错误中止!("{}", 界面表.取带参消息("dir_exists", &[项目名]));
    }
    // 包名取路径最后一段（支持传入绝对或相对路径），并将构建工具不允许的字符替换为下划线
    让 原始包名 = 项目路径
        .文件名()
        .而后映射(|名称值| 名称值.取字符串引用())
        .取值或(项目名);
    让 包名: 字符串 = 原始包名
        .逐字符()
        .映射(|单字| {
            如果 单字.是ASCII字母数字() || 单字 == '-' || 单字 == '_' {
                单字
            } 否则 {
                '_'
            }
        })
        .收集();
    文件系统::递归创建目录(项目路径.连接("src"))?;
    // 版本锁定：固定到本机当前工具链版本（动态探测，避免硬编码随时间过时，
    // 导致文档分析器等工具报「工具链过于陈旧」）；探测失败时不生成锁定文件，
    // 项目跟随系统默认工具链。组件含文档分析器与源码供编辑器使用。
    如果让 有值(通道值) = 探测工具链通道() {
        文件系统::写入(
            项目路径.连接("rust-toolchain.toml"),
            格式化!(
                "[toolchain]\nchannel = \"{通道值}\"\ncomponents = [\"rustc\", \"cargo\", \"rust-analyzer\", \"rust-src\"]\n"
            ),
        )?;
    }

    文件系统::写入(
        项目路径.连接("Cargo.toml"),
        格式化!(
            "[package]\nname = \"{}\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\n\n[workspace]\n",
            包名
        ),
    )?;
    // 语言包已内置到 rzc 可执行文件中，无需复制；主文件模板随语言参数变化
    文件系统::写入(
        项目路径.连接(格式化!("src/main.{}", 语言码)),
        界面表.取消息("template_main"),
    )?;
    文件系统::写入(
        项目路径.连接("README.md"),
        界面表.取带参消息("readme_template", &[项目名, 语言码]),
    )?;
    // 生成物不入库：托管目录收托管产物（模块转译结果），备份文件是旧布局
    // 产物迁移时的安全备份——两者都是机器产物而非源码；入口产物
    // 不列入（标准目标，让克隆后不改方言直接构建也能跑）
    文件系统::写入(
        项目路径.连接(".gitignore"),
        "/target\n.rz/gen/\n*.rs.bak\n",
    )?;
    // AI 协作说明书：由当前语言包实时渲染（书写规则与全量词条表），
    // 不是一次性静态文案——语言包更新后可刷新；
    // 主流 AI 编程助手会阅读 AGENTS.md 作为项目上下文
    如果 生成助手 {
        让 映射管理器值 = 加载映射(无, 有值(&路径缓冲::从(格式化!("main.{语言码}"))))?;
        文件系统::写入(
            项目路径.连接("AGENTS.md"),
            引擎库::指南::渲染母语指南(&映射管理器值, 语言码),
        )?;
        打印行!("{}", 界面表.取带参消息("agents_generated", &["AGENTS.md"]));
    }
    打印行!("{}", 界面表.取带参消息("project_created", &[项目名]));
    打印行!("{}", 界面表.取带参消息("project_created_hint", &[语言码]));
    打印行!("{}", 界面表.取带参消息("project_run_hint", &[语言码]));
    成功(())
}

函数 加载映射(
    语言包路径: 选项<路径缓冲>,
    源文件: 选项<&路径类型>,
) -> 错误处理::结果<映射管理器> {
    // 映射数据来源日志（语言包开发调试：设置日志环境变量后可见）
    // 注意：映射加载先于转译管线执行，日志需在此提前初始化（幂等）
    引擎库::日志::日志初始化();
    让 界面表 = 按文件取界面(源文件.解包或用(路径类型::新建("")), &语言包路径);
    // 1. 如果用户通过语言包参数指定了外部目录，强制使用
    如果让 有值(路径值) = 语言包路径 {
        引擎库::信息日志!(
            "映射加载",
            "{}",
            界面表.取带参消息("mapping_source_explicit", &[&路径值.展示().转字符串()])
        );
        返回 映射管理器::从目录载入(&路径值)
            .映射错误(|错误值| 错误处理::错误处理!("{}", 界面表.取带参消息("load_lang_pack_failed", &[&错误值.转字符串()])));
    }
    // 2. 根据源文件扩展名确定语言代码
    让 扩展值 = 源文件
        .而后映射(|文件值| 文件值.扩展名())
        .而后映射(|扩展段| 扩展段.取字符串引用())
        .取值或("");
    让 语言码 = 扩展名转语言代码(扩展值).缺值转错(|| {
        让 可用列表 = 全部可用扩展名();
        让 可用文本 = 如果 可用列表.是否为空() {
            界面表.取消息("no_available_ext")
        } 否则 {
            可用列表
                .迭代()
                .映射(|扩展段| 格式化!(".{}", 扩展段))
                .收集::<向量<字符串>>()
                .连接(", ")
        };
        错误处理::错误处理!(
            "{}",
            界面表.取带参消息("unknown_extension", &[扩展值, &可用文本])
        )
    })?;
    // 3. 项目内语言包目录存在时优先使用（自定义覆盖）：
    //    主仓库为引擎语言包目录（单一数据源），用户项目为项目语言包目录；
    //    项目根从源文件向上查找；源文件不在项目内时回退当前目录，兼容旧用法
    让 可变 本地候选们: 向量<路径缓冲> = 向量::新建();
    如果让 有值(文件值) = 源文件
        && 让 有值(父级) = 文件值.父目录()
        && 让 有值(根目录) = 向上查找项目根(父级)
    {
        本地候选们.推入(语言包根目录(&根目录).连接(&语言码));
    }
    让 当前目录值 = 环境::当前目录().解包或用否则(|_| 路径缓冲::从("."));
    本地候选们.推入(语言包根目录(&当前目录值).连接(&语言码));
    对于 本地路径 在 &本地候选们 {
        如果 本地路径.存在() {
            引擎库::信息日志!(
                "映射加载",
                "{}",
                界面表.取带参消息("mapping_source_project", &[&本地路径.展示().转字符串()])
            );
            返回 映射管理器::从目录载入(本地路径).映射错误(|错误值| {
                错误处理::错误处理!("{}", 界面表.取带参消息("load_local_lang_pack_failed", &[&错误值.转字符串()]))
            });
        }
    }
    // 4. 全局用户语言包目录
    让 全局路径 = 全局语言目录().连接(&语言码);
    如果 全局路径.存在() {
        引擎库::信息日志!(
            "映射加载",
            "{}",
            界面表.取带参消息("mapping_source_global", &[&全局路径.展示().转字符串()])
        );
        返回 映射管理器::从目录载入(&全局路径).映射错误(|错误值| {
            错误处理::错误处理!(
                "{}",
                界面表.取带参消息("load_global_lang_pack_failed", &[&错误值.转字符串()])
            )
        });
    }
    // 5. 回退到内置语言包（未内置的语言提示用户安装，避免静默使用中文）
    如果 !有内置语言包(&语言码) {
        返回 错误(错误处理::错误处理!(
            "{}",
            界面表.取带参消息("lang_not_builtin", &[&语言码, &语言码])
        ));
    }
    让 内置数据 = 获取内置数据(&语言码);
    引擎库::信息日志!(
        "映射加载",
        "{}",
        界面表.取带参消息("mapping_source_builtin", &[&语言码])
    );
    映射管理器::从内置载入(
        内置数据.关键字内容,
        内置数据.模块路径内容,
        内置数据.标准库内容,
        内置数据.三方库数据,
    )
    .映射错误(|错误值| {
        错误处理::错误处理!(
            "{}",
            界面表.取带参消息("load_builtin_lang_pack_failed", &[&错误值.转字符串()])
        )
    })
}

/// 根据源文件与语言包参数选择界面消息语言
///
/// 显式语言包目录优先；否则按源文件扩展名确定语言代码；
/// 无法识别时回退界面语言环境变量、系统语言或中文。
函数 按文件取界面(源文件值: &路径类型, 语言包: &选项<路径缓冲>) -> 界面::界面消息表 {
    如果让 有值(路径值) = 语言包 {
        让 界面表 = 界面::界面消息表::按显式目录建表(路径值);
        // 同步引擎全局语言（目录名即语言代码）
        让 语言码 = 路径值
            .文件名()
            .而后映射(|名称值| 名称值.取字符串引用())
            .取值或("zh")
            .转字符串();
        引擎库::语言::设定语言(&语言码);
        返回 界面表;
    }
    让 语言码 = 源文件值
        .扩展名()
        .而后映射(|扩展段| 扩展段.取字符串引用())
        .而后映射(扩展名转语言代码)
        .解包或用否则(界面::探测界面语言);
    引擎库::语言::设定语言(&语言码);
    界面::界面消息表::按语言建表(&语言码)
}

/// 按当前界面语言本地化命令行帮助文本
///
/// 利用命令工厂生成命令后逐项覆盖简介与帮助，
/// 使帮助输出与各子命令帮助均使用目标语言。
函数 本地化命令行(界面表: &界面::界面消息表) -> 命令行::命令行解析器 {
    使用 命令行::命令工厂;
    参数组::命令工厂方法()
        .简介(界面表.取消息("cli_about"))
        .改参数("无教学检查", |参数值| 参数值.帮助(界面表.取消息("arg_no_lint_help")))
        .改子命令("init", |命令值| {
            命令值.简介(界面表.取消息("cmd_init_about"))
                .改参数("语言", |参数值| 参数值.帮助(界面表.取消息("arg_lang_help")))
                .改参数("助手", |参数值| 参数值.帮助(界面表.取消息("cmd_init_ai_help")))
        })
        .改子命令("run", |命令值| 命令值.简介(界面表.取消息("cmd_run_about")))
        .改子命令("check", |命令值| {
            命令值.简介(界面表.取消息("cmd_check_about"))
                .改参数("修复", |参数值| 参数值.帮助(界面表.取消息("arg_check_fix_help")))
        })
        .改子命令("eject", |命令值| {
            命令值.简介(界面表.取消息("cmd_eject_about"))
                .改参数("文件们", |参数值| 参数值.帮助(界面表.取消息("arg_eject_files_help")))
        })
        .改子命令("transpile", |命令值| 命令值.简介(界面表.取消息("cmd_transpile_about")))
        .改子命令("add", |命令值| {
            命令值.简介(界面表.取消息("cmd_add_about"))
                .改参数("依赖们", |参数值| 参数值.帮助(界面表.取消息("arg_add_crates_help")))
        })
        .改子命令("install", |命令值| {
            命令值.简介(界面表.取消息("cmd_install_about"))
                .改子命令("lsp", |子命令实例| {
                    子命令实例.简介(界面表.取消息("cmd_install_lsp_about"))
                        .改参数("强制", |参数值| 参数值.帮助(界面表.取消息("arg_force_help")))
                })
                .改子命令("toolchain", |子命令实例| {
                    子命令实例.简介(界面表.取消息("tc_install_help"))
                        .改参数("版本", |参数值| 参数值.帮助(界面表.取消息("arg_tc_version_help")))
                        .改参数("发布标签", |参数值| 参数值.帮助(界面表.取消息("arg_tc_ra_tag_help")))
                        .改参数("仅分析器", |参数值| 参数值.帮助(界面表.取消息("arg_tc_ra_only_help")))
                        .改参数("强制", |参数值| 参数值.帮助(界面表.取消息("arg_force_help")))
                })
        })
        .改子命令("doctor", |命令值| 命令值.简介(界面表.取消息("tc_doctor_help")))
