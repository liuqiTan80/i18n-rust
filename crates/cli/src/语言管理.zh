    #[测试]
    函数 解压压缩包并查找() {
        使用 标准库::输入输出::写入特征;
        让 _锁 = 环境锁();
        让 临时根 = 临时文件::建临时目录().解包();

        让 压缩包路径 = 临时根.条目路径().连接("lang_pack.zip");
        让 可变 写入器 = 拉链::压缩包写入器::新建(标准库::输入输出::游标::新建(向量::新建()));
        让 选项值 = 拉链::写出::简单文件选项::默认值();
        写入器
            .开始文件("language-packs-main/中文/keywords.toml", 选项值)
            .解包();
        写入器
            .写入全部("[\"声明\"]\n\"函数\" = \"fn\"\n".转为字节())
            .解包();
        写入器
            .开始文件("language-packs-main/中文/errors.toml", 选项值)
            .解包();
        写入器
            .写入全部("[示例]\n\"a\" = \"b\"\n".转为字节())
            .解包();
        文件系统::写入(&压缩包路径, 写入器.完成().解包().取内层()).解包();

        让 解压目录 = 临时根.条目路径().连接("extracted");
        解压压缩包(&压缩包路径, &解压目录).解包();
        断言!(
            解压目录
                .连接("language-packs-main/中文/keywords.toml")
                .是否为文件()
        );

        让 中文项 = 在解压目录查找语言(&解压目录, "中文").期望("应找到中文");
        断言!(中文项.连接("keywords.toml").是否为文件());
        断言!(在解压目录查找语言(&解压目录, "俄语").是否为无());
    }

