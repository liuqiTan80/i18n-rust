    /// 第三方语言包扩展名不得覆盖 Rust/配置源码后缀
    #[测试]
    函数 扩展名安全规则() {
        断言!(扩展名安全("zh"));
        断言!(扩展名安全("ja"));
        断言!(扩展名安全("py2"));
        断言!(!扩展名安全(""));
        断言!(!扩展名安全("rs"));
        断言!(!扩展名安全("RS"));
        断言!(!扩展名安全("toml"));
        断言!(!扩展名安全("json"));
        断言!(!扩展名安全("lock"));
        断言!(!扩展名安全("a/b"));
        断言!(!扩展名安全("../x"));
        断言!(!扩展名安全("x.y"));
        断言!(!扩展名安全("中文"));
    }

    #[测试]
    函数 解析语言信息用例() {
        让 元数据 = 解析语言信息(
            "[\"语言包\"]\n\"名称\" = \"俄语\"\n\"扩展名\" = \"ru\"\n\"版本\" = \"1.0\"\n",
        )
        .解包();
        断言相等!(元数据.名称, "俄语");
        断言相等!(元数据.扩展名, "ru");
        断言相等!(元数据.版本, "1.0");

        让 元数据 = 解析语言信息("[语言包]\n名称 = \"日语\"\n扩展名 = \"ja\"\n").解包();
        断言相等!(元数据.名称, "日语");
        断言相等!(元数据.扩展名, "ja");
        断言相等!(元数据.版本, "1.0");

        断言!(解析语言信息("[语言包]\n名称 = \"俄语\"\n").是否为无());
        断言!(解析语言信息("[其他]\n名称 = \"俄语\"\n扩展名 = \"ru\"\n").是否为无());
        断言!(解析语言信息("这不是 TOML").是否为无());
    }

    #[测试]
    函数 动态扩展名映射用例() {
        让 _锁 = 环境锁();
        让 临时根 = 临时文件::建临时目录().解包();
        制作临时语言包(临时根.条目路径(), "日语");
        不安全 {
            标准库::环境::设置环境变量("RZ_LANG_DIR", 临时根.条目路径().连接("global"));
        }
        安装语言(临时根.条目路径().连接("日语").取字符串引用().解包(), 假).解包();

        断言相等!(查询扩展名映射("ja").作为解引用(), 有值("日语"));
        让 清单 = 列出语言();
        让 日语项 = 清单
            .迭代器()
            .查找(|信息值| 信息值.语言代码 == "日语")
            .期望("日语应被列出");
        断言相等!(日语项.扩展名.作为解引用(), 有值("ja"));
        断言!(日语项.版本.是否为无());

        断言相等!(查询扩展名映射("zh").作为解引用(), 有值("zh"));
        让 中文项 = 清单
            .迭代器()
            .查找(|信息值| 信息值.语言代码 == "zh")
            .期望("zh应被列出");
        断言相等!(中文项.扩展名.作为解引用(), 有值("zh"));
        断言相等!(中文项.版本.作为解引用(), 有值("1.0"));

        // 补写 lang_info.toml
        文件系统::写入(
            临时根.条目路径().连接("global/日语/lang_info.toml"),
            "[语言包]\n名称 = \"日语\"\n扩展名 = \"ja\"\n版本 = \"2.1\"\n",
        )
        .解包();
        断言相等!(查询扩展名映射("ja").作为解引用(), 有值("日语"));
        让 清单 = 列出语言();
        让 日语项 = 清单
            .迭代器()
            .查找(|信息值| 信息值.语言代码 == "日语")
            .期望("日语应被列出");
        断言相等!(日语项.版本.作为解引用(), 有值("2.1"));

        断言相等!(
            静态扩展名映射().获取("ru").映射(|值项| 值项.作为文本切片()),
            有值("俄语")
        );

        不安全 {
            标准库::环境::移除环境变量("RZ_LANG_DIR");
        }
    }

