//! 语言包管理模块
//!
//! 实现 `rzc lang list / install / remove` 子命令的底层逻辑：
//! 管理用户全局语言包目录（默认 `~/.rz/lang-packs/`，可用语言目录环境变量覆盖）。
//!
//! 每个语言包是一个目录，目录名即语言代码（如 `zh`、`ru`），
//! 内含 `keywords.toml`、`errors.toml`、`module_paths.toml` 及可选的第三方库子目录。
//!
//! 远程安装：默认依次尝试 [`默认仓库源列表`]（主平台首选，失败自动回退备用平台），
//! 每个源优先克隆仓库，克隆工具不存在或克隆失败时回退下载命令取压缩包并解压；
//! 设置仓库地址环境变量后完全使用用户指定地址（不再尝试默认源）。

使用 标准库::集合::哈希映射;
使用 标准库::文件系统;
使用 标准库::路径::{路径类型, 路径缓冲};
使用 标准库::进程::命令;
使用 标准库::输入输出::读取特征;

/// 默认远程语言包源列表（按顺序依次尝试）
///
/// 首选主平台（国内用户访问速度快），失败自动回退备用平台（海外用户可用）。
/// 仓库结构：每个语言包一个目录，目录名即语言代码，内含
/// `keywords.toml`、`errors.toml`、`module_paths.toml` 及可选第三方库子目录。
///
/// 注意：占位符使用前请替换为实际的主平台/备用平台用户名。
/// 设置仓库地址环境变量后完全使用用户指定地址，不再尝试默认源。
公开 常量 默认仓库源列表: [&文本; 2] = [
    "https://gitcode.com/tan80/i18n-rust",
    "https://github.com/liuqiTan80/i18n-rust",
];

/// 远程仓库源：克隆地址与下载命令取压缩包的地址
#[派生(可调试, 克隆)]
公开(包) 结构体 仓库源项 {
    /// 克隆使用的仓库地址
    公开(包) 仓库地址: 字符串,
    /// 下载命令取压缩包的地址
    公开(包) 压缩包地址: 字符串,
}

实现 仓库源项 {
    /// 从仓库地址生成克隆与压缩包下载地址
    ///
    /// - 主平台：仓库归档接口地址（默认分支的压缩包）
    /// - 备用平台：仓库源码归档接口地址（默认分支的压缩包）
    /// - 其他平台（含本地回环服务测试）：按备用平台风格生成
    公开(包) 函数 从地址(地址: &文本) -> 自身 {
        让 规范地址 = 地址.裁剪右侧匹配('/');
        让 压缩包地址 = 如果 规范地址.包含("gitcode.com") {
            格式化!("{}/repository/archive/master.zip", 规范地址)
        } 否则 {
            格式化!("{}/archive/refs/heads/main.zip", 规范地址)
        };
        自身 {
            仓库地址: 规范地址.转字符串(),
            压缩包地址,
        }
    }
}

/// 收集本次安装要尝试的仓库源列表
///
/// 若设置了仓库地址环境变量，完全使用用户指定的地址；
/// 否则依次尝试 [`默认仓库源列表`]（主平台首选，备用平台备用）。
函数 收集仓库源() -> 向量<仓库源项> {
    如果让 成功(自定义值) = 标准库::环境::环境变量("RZ_LANG_REPO") {
        让 规范值 = 自定义值.裁剪().裁剪右侧匹配('/').转字符串();
        如果 !规范值.是否为空() {
            返回 向量![仓库源项::从地址(&规范值)];
        }
    }
    默认仓库源列表
        .迭代器()
        .映射(|地址值| 仓库源项::从地址(地址值))
        .收集()
}

/// 语言包来源
#[派生(可调试, 克隆, 复制, 部分相等, 全等)]
公开 枚举 语言来源 {
    /// 内置在 rzc 可执行文件中（不可删除）
    内置,
    /// 用户通过 `rzc lang install` 安装到全局目录
    用户安装,
}

/// 单个已安装语言包的信息
公开 结构体 语言信息 {
    /// 语言代码（目录名）
    公开 语言代码: 字符串,
    /// 来源
    公开 语言来源: 语言来源,
    /// 扩展名（不含点）；旧语言包无 lang_info.toml 时从静态映射推断
    公开 扩展名: 选项<字符串>,
    /// 版本号；旧语言包无 lang_info.toml 时为空值
    公开 版本: 选项<字符串>,
    /// 语言显示名称（来自 lang_info.toml；旧语言包为空值）
    公开 显示名称: 选项<字符串>,
}

/// 语言包元数据（来自 lang_info.toml）
公开 结构体 语言元数据 {
    /// 语言名称
    公开 名称: 字符串,
    /// 源码文件扩展名（不含点）
    公开 扩展名: 字符串,
    /// 版本号
    公开 版本: 字符串,
}

/// 远程地址是否允许用于克隆/下载：https、ssh、git@，或本机回环 http
///
/// 明文 http 只放行 localhost / 127.x / ::1（测试与本机仓库服务）；
/// 远程明文地址会暴露仓库内容并允许中间人篡改语言包映射。
公开(包) 函数 地址安全(地址: &文本) -> 布尔 {
    让 小写地址 = 地址.转小写();
    如果 小写地址.以开头("https://")
        || 小写地址.以开头("ssh://")
        || 小写地址.以开头("git@")
        || 小写地址.以开头("file://")
        || !小写地址.包含("://")
    {
        返回 真;
    }
    如果 !小写地址.以开头("http://") {
        返回 假;
    }
    让 主机部分 = 小写地址.去前缀("http://").解包或用("");
    让 主机 = 主机部分.分割('/').下一个().解包或用("");
    主机 == "localhost"
        || 主机.以开头("localhost:")
        || 主机.以开头("127.")
        || 主机 == "[::1]"
        || 主机.以开头("[::1]:")
}

/// 下载远程文件：协议/重定向限制 + 连接与总时长上限 + 大小上限
///
/// curl 的 `--max-filesize` 在服务端未声明长度时不能完全兜底，但能挡住
/// 常见的大文件/压缩炸弹；协议限制与 [`地址安全`] 共同阻断降级到远程 http。
函数 下载到(地址: &文本, 目标: &路径类型) -> 错误处理::结果<空> {
    如果 !地址安全(地址) {
        错误处理::错误中止!(
            "下载地址必须使用 https 或 ssh（本机回环可用 http）：{}",
            地址
        );
    }
    让 协议参数 = 如果 地址.转小写().以开头("https://") {
        "=https"
    } 否则 {
        "=http"
    };
    让 输出值 = 命令::新建("curl")
        .单参数("-L")
        .单参数("--fail")
        .单参数("--connect-timeout")
        .单参数("15")
        .单参数("--max-time")
        .单参数("300")
        .单参数("--max-filesize")
        .单参数("67108864")
        .单参数("--proto")
        .单参数(协议参数)
        .单参数("--proto-redir")
        .单参数(协议参数)
        .单参数("-o")
        .单参数(目标)
        .单参数(地址)
        .标准输出(标准库::进程::标准流::空流())
        .标准错误(标准库::进程::标准流::管道化())
        .取输出()
        .映射错误(|错误值| {
            错误处理::错误处理!(
                "{}",
                包::界面::界面消息表::全局表().取带参消息("lc_err_curl_run", &[&错误值.转字符串()])
            )
        })?;
    如果 !包::界面::命令成功(&输出值) {
        让 明细 = 字符串::从utf8宽松(&输出值.标准错误);
        错误处理::错误中止!(
            "{}",
            包::界面::界面消息表::全局表().取带参消息("lc_err_curl_download", &[地址, 明细.裁剪()])
        );
    }
    成功(())
}

/// 解析 lang_info.toml 内容
///
/// 格式（引号包裹键，符合 TOML 规范——裸键仅允许 ASCII）：
/// ```toml
/// ["语言包"]
/// "名称" = "俄语"
/// "扩展名" = "ru"
/// "版本" = "1.0"
/// ```
/// 版本缺省时为 "1.0"；名称或扩展名缺失/为空时返回空值。
/// 兼容用户手写的裸键写法：标准解析失败时回退手工解析。
函数 解析语言信息(内容串: &文本) -> 选项<语言元数据> {
    // 1. 标准 TOML 解析：兼容引号包裹的键
    如果让 成功(值项) = TOML处理::解析字符串::<TOML处理::TOML值>(内容串)
        && 让 有值(节表) = 值项.获取("语言包")
        && 让 有值(元数据) = 从节表提取(节表)
    {
        返回 有值(元数据);
    }
    // 2. 回退手工解析：兼容中文裸键的用户示例写法
    手工解析(内容串)
}

/// 从解析出的 [语言包] 节表提取元数据
函数 从节表提取(节表: &TOML处理::TOML值) -> 选项<语言元数据> {
    让 名称值 = 节表.获取("名称")?.作为文本切片()?.裁剪();
    让 扩展名值 = 节表.获取("扩展名")?.作为文本切片()?.裁剪();
    如果 名称值.是否为空() || 扩展名值.是否为空() {
        返回 空值;
    }
    让 版本值 = 节表
        .获取("版本")
        .而后映射(|值内容| 值内容.作为文本切片())
        .解包或用("1.0")
        .裁剪()
        .转字符串();
    有值(语言元数据 {
        名称: 名称值.转字符串(),
        扩展名: 扩展名值.转字符串(),
        版本: 版本值,
    })
}

/// 手工逐行解析 `键 = "值"`，兼容标准 TOML 不允许的非 ASCII 裸键
///
/// 只识别 名称 / 扩展名 / 版本 三个字段，忽略注释与节头。
函数 手工解析(内容串: &文本) -> 选项<语言元数据> {
    让 可变 名称值: 选项<字符串> = 空值;
    让 可变 扩展名值: 选项<字符串> = 空值;
    让 可变 版本值: 选项<字符串> = 空值;
    让 可变 有语言节 = 假;
    对于 行文本 在 内容串.逐行() {
        让 行文本 = 行文本.裁剪();
        如果 行文本.是否为空() || 行文本.以开头('#') {
            继续;
        }
        如果 行文本.以开头('[') {
            让 节名 = 行文本
                .裁剪左侧匹配('[')
                .裁剪右侧匹配(']')
                .裁剪匹配('"')
                .裁剪();
            如果 节名 == "语言包" {
                有语言节 = 真;
            }
            继续;
        }
        让 (键名, 原始值) = 行文本.分割一次('=')?;
        让 键名 = 键名.裁剪().裁剪匹配('"').裁剪();
        让 原始值 = 原始值.裁剪().裁剪匹配('"').裁剪();
        如果 原始值.是否为空() {
            返回 空值;
        }
        匹配 键名 {
            "名称" => 名称值 = 有值(原始值.转字符串()),
            "扩展名" => 扩展名值 = 有值(原始值.转字符串()),
            "版本" => 版本值 = 有值(原始值.转字符串()),
            _ => {}
        }
    }
    如果 !有语言节 {
        返回 空值;
    }
    让 扩展名值 = 扩展名值?;
    如果 !扩展名安全(&扩展名值) {
        返回 空值;
    }
    有值(语言元数据 {
        名称: 名称值?,
        扩展名: 扩展名值,
        版本: 版本值.解包或用否则(|| "1.0".转字符串()),
    })
}

/// 语言包声明的扩展名是否可安全用于用户源码
///
/// 第三方语言包可自定义扩展名：若声明成 `rs`，`rzc` 会把用户的 `.rs` 当方言源
/// 转译并覆盖；`toml/json/lock` 等配置后缀同理。仅允许 ASCII 字母数字短后缀。
函数 扩展名安全(扩展名值: &文本) -> 布尔 {
    如果 扩展名值.是否为空() || 扩展名值.元素数() > 16 {
        返回 假;
    }
    如果 !扩展名值.逐字符().全部(|本字| 本字.是ASCII字母数字()) {
        返回 假;
    }
    让 小写值 = 扩展名值.转小写();
    !["rs", "toml", "json", "lock", "txt"].包含(&小写值.作为文本切片())
}

/// 读取目录中语言包的元数据（读取并解析 lang_info.toml）
公开 函数 读取语言信息(目录值: &路径类型) -> 选项<语言元数据> {
    让 内容串 = 文件系统::读取字符串(目录值.连接("lang_info.toml")).转选项()?;
    解析语言信息(&内容串)
}

/// 获取内置语言包的元数据（来自嵌入可执行文件的 lang_info.toml）
公开 函数 获取内置元数据(语言码: &文本) -> 选项<语言元数据> {
    // 内置代码列表内的语言必然存在；未知代码回退到中文不影响元数据查询
    让 数据项 = 包::内置语言::获取内置数据(语言码);
    解析语言信息(数据项.语言信息内容)
}

/// 获取全局语言包根目录
///
/// 优先使用语言目录环境变量，否则默认 `~/.rz/lang-packs/`。
公开 函数 全局语言目录() -> 路径缓冲 {
    如果让 成功(目录值) = 标准库::环境::环境变量("RZ_LANG_DIR")
        && !目录值.是否为空()
    {
        返回 路径缓冲::从(目录值);
    }
    // HOME（Unix）优先，USERPROFILE（Windows）回退，保证跨平台安装目录正确
    让 主目录 = 标准库::环境::环境变量("HOME")
        .或用否则(|_| 标准库::环境::环境变量("USERPROFILE"))
        .解包或用否则(|_| ".".转字符串());
    路径缓冲::从(主目录).连接(".rz").连接("lang-packs")
}

/// 列出所有已安装的语言包（内置 + 用户安装）
///
/// 内置语言包固定在前，用户安装的按名称排序在后。
/// 扩展名/版本来自 lang_info.toml；旧语言包无该文件时扩展名回退静态映射推断。
公开 函数 列出语言() -> 向量<语言信息> {
    让 可变 清单: 向量<语言信息> = 包::内置语言::内置语言清单()
        .消费迭代()
        .映射(|代码值| {
            让 元数据 = 获取内置元数据(代码值);
            语言信息 {
                语言代码: 代码值.转字符串(),
                语言来源: 语言来源::内置,
                扩展名: 元数据
                    .作为引用方法()
                    .映射(|元项| 元项.扩展名.克隆值())
                    .或用否则(|| 静态代码转扩展名(代码值)),
                版本: 元数据.作为引用方法().映射(|元项| 元项.版本.克隆值()),
                显示名称: 元数据.映射(|元项| 元项.名称.克隆值()),
            }
        })
        .收集();

    // 扫描全局目录：含 keywords.toml 的子目录视为语言包
    让 根目录 = 全局语言目录();
    让 可变 用户安装: 向量<(字符串, 选项<语言元数据>)> = 向量::新建();
    如果让 成功(目录读) = 文件系统::读取目录(&根目录) {
        对于 条目值 在 目录读.展平() {
            让 路径值 = 条目值.条目路径();
            如果 路径值.是否为目录()
                && 路径值.连接("keywords.toml").是否为文件()
                && 让 有值(名称值) = 路径值.取文件名().而后映射(|本名| 本名.取字符串引用())
            {
                用户安装.推入((名称值.转字符串(), 读取语言信息(&路径值)));
            }
        }
    }
    用户安装.排序_by(|甲, 乙| 甲.0.比较(&乙.0));
    对于 (代码值, 元数据) 在 用户安装 {
        清单.推入(语言信息 {
            扩展名: 元数据
                .作为引用方法()
                .映射(|元项| 元项.扩展名.克隆值())
                .或用否则(|| 静态代码转扩展名(&代码值)),
            版本: 元数据.作为引用方法().映射(|元项| 元项.版本.克隆值()),
            显示名称: 元数据.映射(|元项| 元项.名称.克隆值()),
            语言代码: 代码值,
            语言来源: 语言来源::用户安装,
        });
    }
    清单
}

/// 静态扩展名映射（扩展名 → 语言代码）
///
/// 作为动态映射的回退，保证无 lang_info.toml 的旧语言包向后兼容。
公开 函数 静态扩展名映射() -> 哈希映射<字符串, 字符串> {
    [
        ("zh", "中文"),
        ("ru", "俄语"),
        ("ja", "日语"),
        ("ko", "韩语"),
    ]
    .消费迭代()
    .映射(|(后缀, 代码值)| (后缀.转字符串(), 代码值.转字符串()))
    .收集()
}

/// 静态映射反查：语言代码 → 扩展名（旧语言包推断用）
函数 静态代码转扩展名(语言码: &文本) -> 选项<字符串> {
    静态扩展名映射()
        .消费迭代()
        .查找(|(_, 代码值)| 代码值 == 语言码)
        .映射(|(后缀, _)| 后缀)
}

/// 构建 扩展名 → 语言代码 的动态映射表
///
/// 来源：内置语言包元数据 + 全局用户语言包目录。
/// 用户安装的语言包优先于内置（同名扩展名时覆盖）；
/// 无 lang_info.toml 的旧语言包回退静态映射推断。
公开 函数 构建扩展名映射() -> 哈希映射<字符串, 字符串> {
    让 可变 映射表 = 哈希映射::新建();

    // 1. 内置语言包
    对于 代码值 在 包::内置语言::内置语言清单() {
        如果让 有值(元数据) = 获取内置元数据(代码值) {
            映射表.置入(元数据.扩展名, 代码值.转字符串());
        } 否则 如果让 有值(后缀) = 静态代码转扩展名(代码值) {
            映射表.置入(后缀, 代码值.转字符串());
        }
    }

    // 2. 全局用户语言包（覆盖内置）
    让 根目录 = 全局语言目录();
    如果让 成功(目录读) = 文件系统::读取目录(&根目录) {
        对于 条目值 在 目录读.展平() {
            让 路径值 = 条目值.条目路径();
            如果 !路径值.是否为目录() || !路径值.连接("keywords.toml").是否为文件() {
                继续;
            }
            让 有值(代码值) = 路径值.取文件名().而后映射(|本名| 本名.取字符串引用()).映射(字符串::从)
            否则 {
                继续;
            };
            如果让 有值(元数据) = 读取语言信息(&路径值) {
                映射表.置入(元数据.扩展名, 代码值.克隆值());
            } 否则 如果让 有值(后缀) = 静态代码转扩展名(&代码值) {
                映射表.置入(后缀, 代码值);
            }
        }
    }
    映射表
}

/// 查询 扩展名 → 语言代码 的动态映射
公开 函数 查询扩展名映射(扩展名值: &文本) -> 选项<字符串> {
    构建扩展名映射().移除(扩展名值)
}

/// 全局语言包目录中的一个候选条目
///
/// 只要子目录内含 `keywords.toml` 就视为语言包（与 `构建扩展名映射` 同口径），
/// `目录名` 为目录名（语言代码即取此名）。
公开 结构体 全局语言包 {
    公开 目录名: 字符串,
    /// lang_info.toml 元数据；缺失或不可解析时为空值（扩展名回退静态映射推断）
    公开 元数据: 选项<语言元数据>,
}

/// 扫描全局语言包目录（`~/.rz/lang-packs/`，语言目录环境变量可改）
///
/// 供 `rzc doctor` 做语言包健康检查：定位陈旧副本遮蔽内置表、备份/杂项目录
/// 被当语言包吃掉等问题（这类问题只在用户环境发生，静态门检查不和）。
/// 目录不存在或不可读时返回空列表（不报错）。
公开 函数 扫描全局语言包() -> 向量<全局语言包> {
    让 可变 包列表 = 向量::新建();
    如果让 成功(目录读) = 文件系统::读取目录(全局语言目录()) {
        对于 条目值 在 目录读.展平() {
            让 路径值 = 条目值.条目路径();
            如果 !路径值.是否为目录() || !路径值.连接("keywords.toml").是否为文件() {
                继续;
            }
            让 有值(名称值) = 路径值.取文件名().而后映射(|本名| 本名.取字符串引用()) 否则 {
                继续;
            };
            包列表.推入(全局语言包 {
                目录名: 名称值.转字符串(),
                元数据: 读取语言信息(&路径值),
            });
        }
    }
    包列表.排序_by(|甲, 乙| 甲.目录名.比较(&乙.目录名));
    包列表
}

/// 全局语言包目录下的子目录名（含不具备 `keywords.toml` 的）
///
/// 用于识别改名后仍留在 `lang-packs/` 内的备份目录（它们仍会被当语言包吃掉）。
公开 函数 全局语言包子目录名() -> 向量<字符串> {
    让 可变 名称们 = 向量::新建();
    如果让 成功(目录读) = 文件系统::读取目录(全局语言目录()) {
        对于 条目值 在 目录读.展平() {
            让 路径值 = 条目值.条目路径();
            如果 !路径值.是否为目录() {
                继续;
            }
            如果让 有值(名称值) = 路径值.取文件名().而后映射(|本名| 本名.取字符串引用()) {
                名称们.推入(名称值.转字符串());
            }
        }
    }
    名称们.排序();
    名称们
}

/// 所有当前可用的扩展名（按名称排序）
公开 函数 全部可用扩展名() -> 向量<字符串> {
    让 可变 清单: 向量<字符串> = 构建扩展名映射().取全部键().克隆副本().收集();
    清单.排序();
    清单
}

/// 安装语言包
///
/// - `<source>` 是本地存在的目录路径：校验结构后整体复制到全局语言包目录。
/// - 否则视为语言代码：从远程仓库下载安装。
/// - 目标已存在时默认报错；强制参数为真时覆盖安装。
公开 函数 安装语言(来源值: &文本, 强制: 布尔) -> 错误处理::结果<空> {
    让 源路径 = 路径缓冲::从(来源值);
    如果 源路径.是否为目录() {
        校验语言包目录(&源路径)?;
        让 语言码 = 源路径
            .取文件名()
            .而后映射(|本名| 本名.取字符串引用())
            .缺值转错(|| {
                错误处理::错误处理!(
                    "{}",
                    包::界面::界面消息表::全局表().取带参消息(
                        "lc_err_lang_code_from_path",
                        &[&源路径.展示().转字符串()]
                    )
                )
            })?;
        返回 复制到全局目录(&源路径, 语言码, 强制);
    }
    安装远程语言(来源值, 强制)
}

/// 删除用户安装的语言包
///
/// 内置语言包不可删除；同名用户安装包存在时优先删除用户安装的。
公开 函数 移除语言(语言码: &文本) -> 错误处理::结果<空> {
    让 界面表 = 包::界面::界面消息表::全局表();
    // 校验语言代码，防止 ../ 等路径遍历导致删除语言包目录之外的目录
    如果 !校验语言代码(语言码) {
        错误处理::错误中止!("{}", 界面表.取带参消息("invalid_lang_code", &[语言码]));
    }
    让 目标目录 = 全局语言目录().连接(语言码);
    如果 目标目录.是否为目录() {
        文件系统::删除所有目录(&目标目录)?;
        打印行!("{}", 界面表.取带参消息("lang_removed", &[语言码]));
        返回 成功(());
    }

    如果 包::内置语言::内置语言清单().包含(&语言码) {
        错误处理::错误中止!("{}", 界面表.取带参消息("lang_builtin_not_removable", &[语言码]));
    }

    错误处理::错误中止!(
        "{}",
        界面表.取带参消息(
            "lang_not_found",
            &[语言码, &目标目录.展示().转字符串()]
        )
    );
}

/// 从远程仓库安装语言包
函数 安装远程语言(语言码: &文本, 强制: 布尔) -> 错误处理::结果<空> {
    让 界面表 = 包::界面::界面消息表::全局表();
    如果 !校验语言代码(语言码) {
        错误处理::错误中止!("{}", 界面表.取带参消息("invalid_lang_code", &[语言码]));
    }
    让 源列表 = 收集仓库源();
    让 临时 = 临时目录句柄::新建()?;
    尝试全部源(语言码, &源列表, &临时, 强制)
}

/// 远程语言包市场条目（`rzc lang search` 的浏览结果）
#[派生(可调试, 克隆)]
公开 结构体 远程语言信息 {
    /// 语言代码（目录名）
    公开 语言代码: 字符串,
    /// 显示名称（来自 lang_info.toml；旧语言包为空值）
    公开 显示名称: 选项<字符串>,
    /// 版本号（来自 lang_info.toml；旧语言包为空值）
    公开 版本: 选项<字符串>,
}

/// 浏览远程语言包市场：下载仓库压缩包后扫描可用语言包
///
/// 依次尝试 [`收集仓库源`] 中的源，首个成功下载并解析的源即返回其
/// 语言包列表（与安装的源回退策略一致）；关键词参数为有值时按
/// 语言代码或显示名称模糊过滤（不区分大小写）。全部失败时聚合错误。
公开 函数 搜索远程语言(关键词: 选项<&文本>) -> 错误处理::结果<向量<远程语言信息>> {
    让 源列表 = 收集仓库源();
    让 临时 = 临时目录句柄::新建()?;
    让 可变 错误明细 = 向量::新建();
    对于 (序号, 源项) 在 源列表.迭代器().枚举() {
        匹配 拉取仓库压缩包(源项, &临时) {
            成功(仓库目录) => {
                让 可变 已找到 = 扫描仓库语言(&仓库目录);
                已找到.排序_by(|甲, 乙| 甲.语言代码.比较(&乙.语言代码));
                返回 成功(过滤远程语言(已找到, 关键词.解包或用("")));
            }
            错误(错误值) => 错误明细.推入(包::界面::界面消息表::全局表().取带参消息(
                "lc_err_source_detail",
                &[&(序号 + 1).转字符串(), &源项.仓库地址, &错误值.转字符串()],
            )),
        }
    }
    让 界面表 = 包::界面::界面消息表::全局表();
    错误处理::错误中止!(
        "{}",
        界面表.取带参消息(
            "lang_search_failed",
            &[
                关键词.解包或用(""),
                &源列表.元素数().转字符串(),
                &错误明细.连接("\n"),
            ]
        )
    )
}

/// 按关键词过滤远程语言包（匹配语言代码或显示名称，不区分大小写）
函数 过滤远程语言(已找到: 向量<远程语言信息>, 关键词: &文本) -> 向量<远程语言信息> {
    让 小写关键词 = 关键词.裁剪().转小写();
    如果 小写关键词.是否为空() {
        返回 已找到;
    }
    已找到
        .消费迭代()
        .过滤(|信息值| {
            信息值.语言代码.转小写().包含(&小写关键词)
                || 信息值
                    .显示名称
                    .作为解引用()
                    .有值且(|名称值| 名称值.转小写().包含(&小写关键词))
        })
        .收集()
}

/// 下载仓库压缩包并解压，返回仓库根目录（自动下沉单层根目录）
///
/// 设为公开(包)以便第三方包仓库模块复用同一套下载/解压逻辑。
公开(包) 函数 拉取仓库压缩包(源项: &仓库源项, 临时: &临时目录句柄) -> 错误处理::结果<路径缓冲> {
    // 复用下载命令（与安装回退路径一致）；主平台/备用平台的压缩包顶层均为
    // `<仓库>-<分支>/` 目录，解压后若仅含一个目录则以其为仓库根。
    让 下载路径 = 临时.存放路径().连接("lang_market.zip");
    下载到(&源项.压缩包地址, &下载路径)?;
    让 解压目录 = 临时.存放路径().连接("market_extracted");
    解压压缩包(&下载路径, &解压目录)?;
    让 可变 条目们: 向量<路径缓冲> = 文件系统::读取目录(&解压目录)
        .转选项()
        .映射(|目录读| 目录读.展平().映射(|条目值| 条目值.条目路径()).收集())
        .取值或默认();
    如果 条目们.元素数() == 1 && 条目们[0].是否为目录() {
        成功(条目们.移除(0))
    } 否则 {
        成功(解压目录)
    }
}

/// 扫描仓库目录中的语言包（三种布局全部覆盖）
///
/// 1. 仓库根 `<语言码>/`（自建语言包仓库的约定结构）；
/// 2. `lang-packs/<语言码>/`（兼容旧版双副本结构与第三方仓库）；
/// 3. `crates/engine/lang-packs/<语言码>/`（主仓库单副本结构）。
函数 扫描仓库语言(仓库目录: &路径类型) -> 向量<远程语言信息> {
    让 可变 已找到: 向量<远程语言信息> = 向量::新建();
    扫描目录语言(仓库目录, &可变 已找到);
    扫描目录语言(&仓库目录.连接("lang-packs"), &可变 已找到);
    扫描目录语言(&仓库目录.连接("crates/engine/lang-packs"), &可变 已找到);
    已找到
}

/// 扫描单个目录下的语言包子目录（含 keywords.toml 即视为语言包）
函数 扫描目录语言(目录值: &路径类型, 已找到: &可变 向量<远程语言信息>) {
    让 成功(目录读) = 文件系统::读取目录(目录值) 否则 {
        返回;
    };
    对于 条目值 在 目录读.展平() {
        让 路径值 = 条目值.条目路径();
        如果 !路径值.是否为目录() || !路径值.连接("keywords.toml").是否为文件() {
            继续;
        }
        让 有值(代码值) = 路径值.取文件名().而后映射(|本名| 本名.取字符串引用()) 否则 {
            继续;
        };
        // 布局间同名去重（保留先发现的；自建仓库根与 lang-packs 并存时）
        如果 已找到.迭代器().任意(|信息值| 信息值.语言代码 == 代码值) {
            继续;
        }
        让 元数据 = 读取语言信息(&路径值);
        已找到.推入(远程语言信息 {
            语言代码: 代码值.转字符串(),
            显示名称: 元数据.作为引用方法().映射(|元项| 元项.名称.克隆值()),
            版本: 元数据.作为引用方法().映射(|元项| 元项.版本.克隆值()),
        });
    }
}

/// 依次尝试多个源，全部失败时聚合错误并建议仓库地址环境变量
函数 尝试全部源(
    语言码: &文本,
    源列表: &[仓库源项],
    临时: &临时目录句柄,
    强制: 布尔,
) -> 错误处理::结果<空> {
    让 可变 错误明细 = 向量::新建();
    对于 (序号, 源项) 在 源列表.迭代器().枚举() {
        匹配 尝试单个源(语言码, 源项, 临时, 强制) {
            成功(()) => 返回 成功(()),
            错误(错误值) => 错误明细.推入(包::界面::界面消息表::全局表().取带参消息(
                "lc_err_source_detail",
                &[&(序号 + 1).转字符串(), &源项.仓库地址, &错误值.转字符串()],
            )),
        }
    }
    让 界面表 = 包::界面::界面消息表::全局表();
    错误处理::错误中止!(
        "{}",
        界面表.取带参消息(
            "remote_install_failed",
            &[
                语言码,
                &源列表.元素数().转字符串(),
                &错误明细.连接("\n"),
            ]
        )
    )
}

/// 尝试从单个源安装：优先克隆仓库，失败回退下载命令取压缩包
函数 尝试单个源(
    语言码: &文本,
    源项: &仓库源项,
    临时: &临时目录句柄,
    强制: 布尔,
) -> 错误处理::结果<空> {
    让 克隆目录 = 临时.存放路径().连接("repo");
    如果 !地址安全(&源项.仓库地址) || !地址安全(&源项.压缩包地址) {
        错误处理::错误中止!(
            "语言包仓库地址必须使用 https 或 ssh（本机回环可用 http）：{}",
            源项.仓库地址
        );
    }
    让 克隆结果 = 命令::新建("git")
        .单参数("clone")
        .单参数("--depth")
        .单参数("1")
        .单参数(&源项.仓库地址)
        .单参数(&克隆目录)
        .标准输出(标准库::进程::标准流::空流())
        .标准错误(标准库::进程::标准流::管道化())
        .取输出();
    匹配 克隆结果 {
        成功(输出值) 如果 包::界面::命令成功(&输出值) => {
            从仓库目录安装(语言码, &克隆目录, 强制)
        }
        成功(输出值) => {
            让 克隆错误 = 字符串::从utf8宽松(&输出值.标准错误).裁剪().转字符串();
            匹配 尝试下载安装(语言码, &源项.压缩包地址, 临时, 强制) {
                成功(()) => 成功(()),
                错误(下载错误) => {
                    如果 克隆错误.是否为空() {
                        错误(下载错误)
                    } 否则 {
                        错误处理::错误中止!(
                            "{}",
                            包::界面::界面消息表::全局表().取带参消息(
                                "lc_err_git_curl_both",
                                &[&克隆错误, &下载错误.转字符串()]
                            )
                        )
                    }
                }
            }
        }
        错误(错误值) => {
            如果 错误值.类别值() == 标准库::输入输出::错误种类::未寻得 {
                返回 尝试下载安装(语言码, &源项.压缩包地址, 临时, 强制);
            }
            错误(错误处理::错误处理!(
                "{}",
                包::界面::界面消息表::全局表().取带参消息("lc_err_git_run", &[&错误值.转字符串()])
            ))
        }
    }
}

/// 从仓库目录安装指定语言包
///
/// 依次探测三个位置：
/// 1. 仓库根 `<语言码>/`（自建语言包仓库的约定结构）；
/// 2. 仓库根 `lang-packs/<语言码>/`（兼容旧版双副本结构与第三方仓库）；
/// 3. `crates/engine/lang-packs/<语言码>/`（主仓库单副本结构，
///    使 `rzc lang install <码>` 可直接从主仓库安装）。
函数 从仓库目录安装(语言码: &文本, 仓库目录: &路径类型, 强制: 布尔) -> 错误处理::结果<空> {
    让 语言源 = 仓库目录.连接(语言码);
    让 语言源 = 如果 语言源.是否为目录() {
        语言源
    } 否则 如果 仓库目录.连接("lang-packs").连接(语言码).是否为目录() {
        仓库目录.连接("lang-packs").连接(语言码)
    } 否则 如果 仓库目录
        .连接("crates/engine/lang-packs")
        .连接(语言码)
        .是否为目录()
    {
        仓库目录.连接("crates/engine/lang-packs").连接(语言码)
    } 否则 {
        让 界面表 = 包::界面::界面消息表::全局表();
        错误处理::错误中止!("{}", 界面表.取带参消息("remote_lang_not_found", &[语言码]));
    };
    校验语言包目录(&语言源)?;
    复制到全局目录(&语言源, 语言码, 强制)
}

/// 回退方案：下载命令取压缩包并解压安装
函数 尝试下载安装(
    语言码: &文本,
    压缩包地址: &文本,
    临时: &临时目录句柄,
    强制: 布尔,
) -> 错误处理::结果<空> {
    让 下载路径 = 临时.存放路径().连接("lang_pack.zip");
    下载到(压缩包地址, &下载路径)?;
    让 解压目录 = 临时.存放路径().连接("extracted");
    解压压缩包(&下载路径, &解压目录)?;
    让 语言源 = 在解压目录查找语言(&解压目录, 语言码).缺值转错(|| {
        让 界面表 = 包::界面::界面消息表::全局表();
        错误处理::错误处理!("{}", 界面表.取带参消息("remote_lang_not_found", &[语言码]))
    })?;
    校验语言包目录(&语言源)?;
    复制到全局目录(&语言源, 语言码, 强制)
}

/// 解压压缩包到目标目录（保留完整条目路径）
///
/// 每个条目名先经 [`安全条目路径`] 校验，命中穿越向量的条目直接跳过。
函数 解压压缩包(压缩包路径: &路径类型, 解压目录: &路径类型) -> 错误处理::结果<空> {
    让 压缩数据 = 文件系统::读取(压缩包路径).映射错误(|错误值| {
        错误处理::错误处理!(
            "{}",
            包::界面::界面消息表::全局表().取带参消息(
                "lc_err_open_zip",
                &[&压缩包路径.展示().转字符串(), &错误值.转字符串()]
            )
        )
    })?;
    让 文件游标 = 标准库::输入输出::游标::新建(压缩数据);
    让 可变 归档 = 拉链::压缩包归档::新建(文件游标).映射错误(|错误值| {
        错误处理::错误处理!(
            "{}",
            包::界面::界面消息表::全局表().取带参消息("lc_err_read_zip", &[&错误值.转字符串()])
        )
    })?;
    对于 序号 在 0..归档.元素数() {
        让 可变 条目值 = 归档.按序号(序号).映射错误(|错误值| {
            错误处理::错误处理!(
                "{}",
                包::界面::界面消息表::全局表().取带参消息("lc_err_read_zip_entry", &[&错误值.转字符串()])
            )
        })?;
        // 条目名解码可能失败（非 UTF-8/无效编码），失败条目跳过；
        // 取拥有形态以免与下方可变借用的拷贝借用冲突
        让 成功(条目名) = 条目值.线程名().映射(|名称值| 名称值.转所有权()) 否则 {
            继续;
        };
        // 条目名安全校验：拒绝绝对路径、盘符前缀与 `..` 上跳（详见函数文档）
        让 有值(目标路径) = 安全条目路径(&条目名).映射(|相对值| 解压目录.连接(相对值)) 否则 {
            继续;
        };
        如果 条目值.是否为目录() {
            文件系统::递归创建目录(&目标路径)?;
        } 否则 {
            如果让 有值(父级) = 目标路径.父目录() {
                文件系统::递归创建目录(父级)?;
            }
            让 可变 条目内容 = 向量::新建();
            条目值.读取全部(&可变 条目内容).映射错误(|错误值| {
                错误处理::错误处理!(
                    "{}",
                    包::界面::界面消息表::全局表().取带参消息(
                        "lc_err_write_file",
                        &[&目标路径.展示().转字符串(), &错误值.转字符串()]
                    )
                )
            })?;
            文件系统::写入(&目标路径, &条目内容)?;
        }
    }
    成功(())
}

/// 校验压缩包条目名，返回可安全拼接到解压根目录的相对路径
///
/// 拒绝三类条目（均为路径穿越向量，命中返回空值）：
/// - **空名**：无有效路径段；
/// - **绝对路径**：以斜杠或反斜杠开头的路径。反斜杠须先归一化为斜杠——压缩包规范
///   要求 `/` 分隔，但 Windows 打包工具会写入 `\`，而 Unix 的
///   `路径类型::组件` 不把 `\` 当分隔符，只按平台原生规则判断会漏拦；
/// - **`..` 上跳段**：`a/../../x`；
/// - **Windows 盘符前缀**：`C:/Users/x/...`。`路径类型::连接` 遇带前缀的路径会
///   **整体替换**基准目录（而非拼接），解压会写到 `解压目录` 之外；该前缀
///   在 Unix 上不被 `路径类型::组件` 识别为前缀，故必须显式判断，
///   仅检查 `..` 会完全漏掉这一向量。
公开(包) 函数 安全条目路径(条目名: &文本) -> 选项<路径缓冲> {
    让 归一化 = 条目名.替换('\\', "/");
    如果 归一化.是否为空() || 归一化.以开头('/') {
        返回 空值;
    }
    如果 归一化.分割('/').任意(|段值| 段值 == "..") {
        返回 空值;
    }
    // 盘符前缀：首两字节为「ASCII 字母 + 冒号」即判定（`C:/x` 与盘符相对路径
    // `c:foo` 都属带前缀路径，`路径类型::连接` 都会整体替换基准目录）
    让 字节项 = 归一化.转为字节();
    如果 字节项.元素数() >= 2 && 字节项[0].是ASCII字母() && 字节项[1] == b':' {
        返回 空值;
    }
    有值(路径缓冲::从(归一化))
}

/// 在解压目录中查找语言包目录
函数 在解压目录查找语言(解压目录: &路径类型, 语言码: &文本) -> 选项<路径缓冲> {
    让 直达路径 = 解压目录.连接(语言码);
    如果 直达路径.是否为目录() {
        返回 有值(直达路径);
    }
    对于 条目值 在 文件系统::读取目录(解压目录).转选项()?.展平() {
        让 路径值 = 条目值.条目路径();
        如果 路径值.是否为目录() {
            让 嵌套路径 = 路径值.连接(语言码);
            如果 嵌套路径.是否为目录() {
                返回 有值(嵌套路径);
            }
        }
    }
    空值
}

/// 将源语言包目录复制到全局目录
///
/// 复制前后维护一份首次信任内容指纹：对本次取回的源码
/// 目录计算确定性摘要，与该语言包上次安装时记录的指纹比对——
/// - 首装（无记录）：直接信任并写入指纹；
/// - 重装（强制参数为真）且内容变化：向标准错误打出显著告警（附新旧指纹）但**不
///   阻断**——合法的内容更新是常态，硬失败不可用；此告警的价值在于把「同一
///   源静默返回不同字节」（无论是上游迭代还是分发被篡改）从不可见变为可见。
///
/// 完整性/篡改类告警沿用安装模块惯例（硬编码中文、不走界面消息表）。
/// 指纹以旁路文件存于语言包目录内，卸载时随整目录一并清除，不留孤儿状态。
函数 复制到全局目录(源目录: &路径类型, 语言码: &文本, 强制: 布尔) -> 错误处理::结果<空> {
    让 界面表 = 包::界面::界面消息表::全局表();
    让 目标目录 = 全局语言目录().连接(语言码);
    让 新指纹 = 内容指纹(源目录)?;
    如果 目标目录.存在() {
        如果 !强制 {
            错误处理::错误中止!(
                "{}",
                界面表.取带参消息(
                    "lang_already_installed",
                    &[语言码, &目标目录.展示().转字符串(), 语言码]
                )
            );
        }
        如果让 有值(旧指纹) = 读取记录指纹(&目标目录)
            && 旧指纹 != 新指纹
        {
            错误打印行!(
                "⚠️ 语言包「{语言码}」内容自上次安装后发生变化（可能源已更新或分发遭篡改）：上次指纹 {旧指纹}，本次指纹 {新指纹}。如非有意更新，请核实源仓库后再使用。"
            );
        }
        文件系统::删除所有目录(&目标目录)?;
    }
    如果 目标目录.以开头(&引擎库::工具链::安装根目录()) {
        // 默认安装根目录 ~/.rz 可能由旧版本以 0755 创建
        让 _ = 引擎库::工具链::确保安装根目录();
    }
    复制目录递归(源目录, &目标目录)?;
    写入记录指纹(&目标目录, &新指纹)?;
    打印行!(
        "{}",
        界面表.取带参消息(
            "lang_installed",
            &[语言码, &目标目录.展示().转字符串()]
        )
    );
    打印行!("{}", 界面表.取消息("lang_install_hint"));
    成功(())
}

/// 语言包内容指纹旁路文件名（存于语言包目录内，卸载随目录一并清除）
常量 完整性文件: &文本 = ".rzc-integrity";

/// 计算语言包目录的内容指纹。
///
/// 对目录内全部文件递归求摘要，按相对路径排序后逐项拼合
/// 「相对路径\0文件摘要\n」再整体取摘要（十六进制小写）。与文件
/// 时间戳、磁盘遍历顺序无关，保证「内容相同→指纹相同、内容变动→指纹
/// 变动」，是首次信任变更检测的基础。排除旁路文件自身，避免记录动作污染后续计算。
函数 内容指纹(目录值: &路径类型) -> 错误处理::结果<字符串> {
    使用 SHA2哈希::{摘要算法, SHA256哈希};
    让 可变 文件对们: 向量<(字符串, 字符串)> = 向量::新建();
    收集指纹文件(目录值, 目录值, &可变 文件对们)?;
    文件对们.排序_by(|甲, 乙| 甲.0.比较(&乙.0));
    让 可变 摘要器 = SHA256哈希::新建();
    对于 (相对值, 摘要值) 在 文件对们 {
        摘要器.追加输入(相对值.转为字节());
        摘要器.追加输入(b"\0");
        摘要器.追加输入(摘要值.转为字节());
        摘要器.追加输入(b"\n");
    }
    成功(格式化!("{:x}", 摘要器.完成摘要()))
}

/// 递归收集（相对路径，单文件摘要），跳过旁路文件。
函数 收集指纹文件(
    根路径: &路径类型,
    当前路径: &路径类型,
    输出项: &可变 向量<(字符串, 字符串)>,
) -> 错误处理::结果<空> {
    对于 条目值 在 文件系统::读取目录(当前路径)? {
        让 条目值 = 条目值?;
        让 路径值 = 条目值.条目路径();
        如果 路径值.是否为目录() {
            收集指纹文件(根路径, &路径值, 输出项)?;
        } 否则 如果 条目值.取文件名() != 完整性文件 {
            让 相对值 = 路径值
                .去前缀(根路径)
                .解包或用(&路径值)
                .转有损字符串()
                .替换('\\', "/");
            输出项.推入((相对值, 文件摘要(&路径值)?));
        }
    }
    成功(())
}

/// 单文件摘要（十六进制小写）。
函数 文件摘要(路径值: &路径类型) -> 错误处理::结果<字符串> {
    使用 SHA2哈希::{摘要算法, SHA256哈希};
    让 数据项 = 文件系统::读取(路径值)?;
    让 可变 摘要器 = SHA256哈希::新建();
    摘要器.追加输入(&数据项);
    成功(格式化!("{:x}", 摘要器.完成摘要()))
}

/// 判断文本是否为 64 位十六进制串（小写或大写字母均认）。
函数 是十六进制串(文本串: &文本) -> 布尔 {
    文本串.元素数() == 64 && 文本串.逐字符().全部(是十六进制位)
}

/// 单个字符是否为十六进制位（数字或大小写字母）。
函数 是十六进制位(字符值: 字符) -> 布尔 {
    字符值.是数字字符() || ('a'..='f').包含(&字符值.转ASCII小写())
}

/// 读取语言包目录中已记录的内容指纹；缺失或格式非法时返回空值
///（空值视为「无历史可比较」——旧版本安装或首装，降级为静默记录，不误报）。
函数 读取记录指纹(目标目录: &路径类型) -> 选项<字符串> {
    让 文本串 = 文件系统::读取字符串(目标目录.连接(完整性文件)).转选项()?;
    让 十六进制值 = 文本串.裁剪().转字符串();
    如果 是十六进制串(&十六进制值) {
        有值(十六进制值)
    } 否则 {
        空值
    }
}

/// 将本次内容指纹写入语言包目录的旁路文件。
函数 写入记录指纹(目标目录: &路径类型, 指纹: &文本) -> 错误处理::结果<空> {
    文件系统::写入(目标目录.连接(完整性文件), 格式化!("{指纹}\n"))?;
    成功(())
}

/// 校验语言包目录结构：必须包含 keywords.toml
函数 校验语言包目录(路径值: &路径类型) -> 错误处理::结果<空> {
    如果 !路径值.连接("keywords.toml").是否为文件() {
        让 界面表 = 包::界面::界面消息表::全局表();
        错误处理::错误中止!(
            "{}",
            界面表.取带参消息("invalid_lang_dir", &[&路径值.展示().转字符串()])
        );
    }
    成功(())
}

/// 校验语言代码可作为安全目录名（防止路径穿越）
公开(包) 函数 校验语言代码(代码值: &文本) -> 布尔 {
    !代码值.是否为空() && !代码值.包含(['/', '\\']) && 代码值 != "." && 代码值 != ".."
}

/// 递归复制目录
函数 复制目录递归(源目录: &路径类型, 目标目录: &路径类型) -> 错误处理::结果<空> {
    文件系统::递归创建目录(目标目录)?;
    对于 条目值 在 文件系统::读取目录(源目录)? {
        让 条目值 = 条目值?;
        让 源路径 = 条目值.条目路径();
        让 目标路径 = 目标目录.连接(条目值.取文件名());
        如果 源路径.是否为目录() {
            复制目录递归(&源路径, &目标路径)?;
        } 否则 {
            文件系统::复制文件(&源路径, &目标路径)?;
        }
    }
    成功(())
}

/// 临时目录句柄：释放时递归清理
///
/// 设为公开(包)以便第三方包仓库模块持有临时仓库目录的生命周期。
公开(包) 结构体 临时目录句柄(路径缓冲);

实现 临时目录句柄 {
    公开(包) 函数 新建() -> 错误处理::结果<自身> {
        让 时间戳 = 标准库::时间模块::系统时间::现在()
            .自纪元(标准库::时间模块::历元)
            .映射(|持续值| 持续值.总纳秒数())
            .解包或用(0);
        // 用户隔离 + 符号链接校验（与临时守卫/语言服务虚拟目录同一威胁模型）
        让 路径值 = 包::临时守卫::安全临时路径(&格式化!(
            "rzc-lang-{}-{}-{}",
            包::临时守卫::安全用户段(),
            标准库::进程::进程号(),
            时间戳
        ))?;
        文件系统::递归创建目录(&路径值)?;
        引擎库::工具链::收紧目录权限(&路径值);
        成功(自身(路径值))
    }

    公开(包) 函数 存放路径(&自我) -> &路径类型 {
        &自我.0
    }
}

实现 可丢弃 对于 临时目录句柄 {
    函数 丢弃(&可变 自我) {
        让 _ = 文件系统::删除所有目录(&自我.0);
    }
}

#[配置(测试)]
公开(包) 使用 自我::母语测试 作为 测试模块;
#[配置(测试)]
公开(包) 模块 母语测试 {
    使用 超级::*;

    /// 环境变量互斥锁：测试并行运行时保护语言目录等全局环境变量。
    /// 包级共享（而非模块私有）：其他模块（main/ui）中依赖环境变量状态、
    /// 或修改环境变量的测试同样必须持有本锁，否则并发执行时互相污染。
    静态 环境互斥锁: 标准库::同步模块::互斥锁<空> = 标准库::同步模块::互斥锁::新建(());

    /// 获取环境变量互斥锁（供其他测试模块复用）。
    ///
    /// 锁被毒化时（持锁测试断言失败恐慌）取回内部数据继续运行，
    /// 避免一次失败级联成后续所有持锁测试的中毒假故障。
    公开(包) 函数 环境锁<'甲>() -> 标准库::同步模块::互斥守卫<'甲, 空> {
        环境互斥锁.加锁().解包或用否则(|错误值| 错误值.取内层())
    }

    /// 环境变量临时接管守卫（供其他测试模块复用）：保存指定变量原值并从
    /// 环境移除，释放时恢复——断言失败恐慌时也不污染后续测试。
    公开(包) 结构体 环境还原(向量<(静态字符串引用, 选项<字符串>)>);

    实现 环境还原 {
        /// 接管（保存并移除）指定环境变量；调用方须持有环境锁
        公开(包) 函数 接管(键们: &[静态字符串引用]) -> 自身 {
            让 已保存 = 键们.迭代器().映射(|键值| (*键值, 标准库::环境::环境变量(键值).转选项())).收集();
            对于 键值 在 键们 {
                // Rust 2024：读写进程级环境变量为不安全，须由环境锁串行化
                不安全 {
                    标准库::环境::移除环境变量(键值);
                }
            }
            自身(已保存)
        }
    }

    实现 可丢弃 对于 环境还原 {
        函数 丢弃(&可变 自我) {
            对于 (键值, 值项) 在 &自我.0 {
                匹配 值项 {
                    有值(值内容) => 不安全 {
                        标准库::环境::设置环境变量(键值, 值内容);
                    },
                    无 => 不安全 {
                        标准库::环境::移除环境变量(键值);
                    },
                }
            }
        }
    }

    /// 在临时根下制作一个最小语言包目录（含第三方库子目录）
    函数 制作临时语言包(根目录: &路径类型, 名称值: &文本) {
        让 目录值 = 根目录.连接(名称值);
        文件系统::递归创建目录(目录值.连接("crates")).解包();
        文件系统::写入(目录值.连接("keywords.toml"), "[\"声明\"]\n\"函数\" = \"fn\"\n").解包();
        文件系统::写入(目录值.连接("errors.toml"), "[示例]\n\"a\" = \"b\"\n").解包();
        文件系统::写入(目录值.连接("module_paths.toml"), "[示例]\n\"a\" = \"b\"\n").解包();
        文件系统::写入(目录值.连接("crates/test.toml"), "[示例]\n\"a\" = \"b\"\n").解包();
    }

    #[测试]
    函数 安全条目路径拒绝穿越() {
        // 正常相对路径放行
        断言相等!(
            安全条目路径("zh/keywords.toml"),
            有值(路径缓冲::从("zh/keywords.toml"))
        );
        断言相等!(
            安全条目路径("zh\\keywords.toml"),
            有值(路径缓冲::从("zh/keywords.toml")),
            "反斜杠应归一化为正斜杠"
        );
        // 绝对路径（含反斜杠形态）
        断言!(安全条目路径("/etc/passwd").是否为无());
        断言!(安全条目路径("\\etc\\passwd").是否为无());
        // `..` 上跳
        断言!(安全条目路径("../x").是否为无());
        断言!(安全条目路径("a/../../x").是否为无());
        断言!(安全条目路径("..\\..\\x").是否为无());
        // Windows 盘符前缀：`路径类型::连接` 会整体替换基准目录，务必拒绝
        断言!(安全条目路径("C:/Users/x/Startup/y.cmd").是否为无());
        断言!(安全条目路径("c:relative").是否为无());
        // 空名
        断言!(安全条目路径("").是否为无());
        // 首段含冒号但非盘符（首字符非 ASCII 字母）仍放行
        断言!(安全条目路径("1b:c/x").是否为有值());
    }

    #[测试]
    函数 本地安装与删除流程() {
        让 _锁 = 环境锁();
        让 临时根 = 临时文件::建临时目录().解包();
        制作临时语言包(临时根.条目路径(), "日语");
        让 源目录 = 临时根.条目路径().连接("日语");
        不安全 {
            标准库::环境::设置环境变量("RZ_LANG_DIR", 临时根.条目路径().连接("global"));
        }
        让 全局目录 = 全局语言目录();

        // 1. 安装前：只有内置
        让 清单甲 = 列出语言();
        断言!(清单甲.迭代器().全部(|信息值| 信息值.语言来源 == 语言来源::内置));

        // 2. 安装
        安装语言(源目录.取字符串引用().解包(), 假).解包();
        断言!(全局目录.连接("日语/keywords.toml").是否为文件());
        断言!(全局目录.连接("日语/crates/test.toml").是否为文件());

        // 3. 列表中出现用户安装的
        让 清单乙 = 列出语言();
        让 日语项 = 清单乙
            .迭代器()
            .查找(|信息值| 信息值.语言代码 == "日语")
            .期望("日语应被列出");
        断言相等!(日语项.语言来源, 语言来源::用户安装);

        // 4. 重复安装报错
        断言!(安装语言(源目录.取字符串引用().解包(), 假).是否为错误());
        // 4b. 强制覆盖成功
        安装语言(源目录.取字符串引用().解包(), 真).解包();
        断言!(全局目录.连接("日语/keywords.toml").是否为文件());

        // 5. 删除内置报错
        断言!(移除语言("zh").是否为错误());

        // 6. 删除成功
        移除语言("日语").解包();
        让 清单丙 = 列出语言();
        断言!(清单丙.迭代器().全部(|信息值| 信息值.语言代码 != "日语"));

        // 7. 删除不存在报错
        断言!(移除语言("不存在").是否为错误());

        不安全 {
            标准库::环境::移除环境变量("RZ_LANG_DIR");
        }
    }

