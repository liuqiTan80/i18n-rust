    #[测试]
    函数 多源回退安装() {
        让 _锁 = 环境锁();
        让 临时根 = 临时文件::建临时目录().解包();
        让 备用仓库 = 临时根.条目路径().连接("lang_repo");
        文件系统::递归创建目录(&备用仓库).解包();
        制作临时语言包(&备用仓库, "中文");
        对于 参数值 在 [
            &["init", "-b", "main"][..],
            &["add", "."][..],
            &["commit", "-m", "init"][..],
        ] {
            让 结果值 = 命令::新建("git")
                .参数们(参数值)
                .当前目录(&备用仓库)
                .编译环境("GIT_AUTHOR_NAME", "测试")
                .编译环境("GIT_AUTHOR_EMAIL", "test@example.com")
                .编译环境("GIT_COMMITTER_NAME", "测试")
                .编译环境("GIT_COMMITTER_EMAIL", "test@example.com")
                .标准输出(标准库::进程::标准流::空流())
                .标准错误(标准库::进程::标准流::空流())
                .取输出();
            让 状态值 = 结果值.期望("执行 git 失败").命令状态;
            断言!(状态值.退出成功(), "git 子命令 {:?} 失败", 参数值[0]);
        }

        让 首选源 = 仓库源项::从地址("file:///不存在的仓库路径");
        让 备用源 = 仓库源项::从地址(备用仓库.取字符串引用().解包());
        不安全 {
            标准库::环境::设置环境变量("RZ_LANG_DIR", 临时根.条目路径().连接("global"));
        }

        让 临时 = 临时目录句柄::新建().解包();
        让 结果值 = 尝试全部源("中文", &[首选源, 备用源], &临时, 假);
        断言!(
            结果值.是否为成功(),
            "首选源失败后应自动回退备用源：{}",
            结果值.转错误选项().映射(|错误值| 错误值.转字符串()).取值或默认()
        );
        断言!(全局语言目录().连接("中文/keywords.toml").是否为文件());

        不安全 {
            标准库::环境::移除环境变量("RZ_LANG_DIR");
        }
    }

    #[测试]
    函数 全部源失败错误信息() {
        让 _锁 = 环境锁();
        让 临时根 = 临时文件::建临时目录().解包();
        不安全 {
            标准库::环境::设置环境变量("RZ_LANG_DIR", 临时根.条目路径().连接("global"));
            // 固定界面语言为中文，保证错误消息断言稳定（系统语言无关）
            标准库::环境::设置环境变量("RZ_LANG", "zh");
        }
        让 坏源甲 = 仓库源项::从地址("file:///不存在的仓库1");
        让 坏源乙 = 仓库源项::从地址("file:///不存在的仓库2");
        让 临时 = 临时目录句柄::新建().解包();
        让 错误文本 = 尝试全部源("中文", &[坏源甲, 坏源乙], &临时, 假)
            .期望错误("两个源都失败应报错")
            .转字符串();
        断言!(
            错误文本.包含("已依次尝试 2 个源"),
            "应报告尝试的源数量：{}",
            错误文本
        );
        断言!(
            错误文本.包含("file:///不存在的仓库1"),
            "应列出源1：{}",
            错误文本
        );
        断言!(
            错误文本.包含("file:///不存在的仓库2"),
            "应列出源2：{}",
            错误文本
        );
        断言!(
            错误文本.包含("RZ_LANG_REPO"),
            "应建议 RZ_LANG_REPO：{}",
            错误文本
        );
        不安全 {
            标准库::环境::移除环境变量("RZ_LANG_DIR");
            标准库::环境::移除环境变量("RZ_LANG");
        }
    }

    /// 市场扫描：三种仓库布局全部覆盖，无 keywords.toml 的目录不误报
    #[测试]
    函数 扫描仓库语言三种布局() {
        让 临时根 = 临时文件::建临时目录().解包();
        // 1. 仓库根直接是语言包（自建语言包仓库约定）
        制作临时语言包(临时根.条目路径(), "中文");
        // 2. lang-packs/ 布局
        制作临时语言包(&临时根.条目路径().连接("lang-packs"), "日语");
        // 3. crates/engine/lang-packs/ 布局（主仓库单副本）
        制作临时语言包(&临时根.条目路径().连接("crates/engine/lang-packs"), "俄语");
        // 非语言包目录（无 keywords.toml）不应列出
        文件系统::递归创建目录(临时根.条目路径().连接("docs")).解包();

        让 已找到 = 扫描仓库语言(临时根.条目路径());
        // 扫描顺序：根 → lang-packs → crates/engine（排序在搜索入口完成）
        让 代码们: 向量<&文本> = 已找到.迭代器().映射(|信息值| 信息值.语言代码.作为文本切片()).收集();
        断言相等!(代码们, ["中文", "日语", "俄语"]);
        断言!(已找到.迭代器().全部(|信息值| 信息值.显示名称.是否为无()));
    }

    /// 市场扫描：布局间同名去重（保留先发现的根目录版本）
    #[测试]
    函数 扫描仓库语言去重() {
        让 临时根 = 临时文件::建临时目录().解包();
        制作临时语言包(临时根.条目路径(), "中文");
        制作临时语言包(&临时根.条目路径().连接("lang-packs"), "中文");

        让 已找到 = 扫描仓库语言(临时根.条目路径());
        断言相等!(已找到.元素数(), 1, "同名语言包应去重：{:?}", 已找到);
    }

    /// 关键词过滤：匹配语言代码或显示名称，不区分大小写
    #[测试]
    函数 过滤远程语言用例() {
        让 已找到 = 向量![
            远程语言信息 {
                语言代码: "vi".转字符串(),
                显示名称: 有值("越南语".转字符串()),
                版本: 有值("1.0".转字符串()),
            },
            远程语言信息 {
                语言代码: "zh".转字符串(),
                显示名称: 有值("中文".转字符串()),
                版本: 空值,
            },
        ];

        // 匹配代码（小写关键词）
        让 按代码 = 过滤远程语言(已找到.克隆值(), "VI");
        断言相等!(按代码.元素数(), 1);
        断言相等!(按代码[0].语言代码, "vi");
        // 匹配显示名称
        让 按名称 = 过滤远程语言(已找到.克隆值(), "越南");
        断言相等!(按名称.元素数(), 1);
        // 空关键词返回全部
        断言相等!(过滤远程语言(已找到.克隆值(), "  ").元素数(), 2);
        // 无匹配返回空
        断言!(过滤远程语言(已找到, "英语").是否为空());
    }

    // ==================== 网络下载层回环服务集成测试 ====================
    //
    // 安装链路（下载命令取压缩包 → 解压 → 单层根目录下沉 → 源回退）是
    // 语言管理对外不确定性最大的面，此前仅有本地文件形态与纯函数
    // 单测，网络传输段只能手动触达。以下用本机回环服务 + 内存压缩包
    // 复现真实链路（真下载子进程，无外网依赖）：网络错误码必须响亮失败
    // （失败即停语义，不得拿半坏文件继续）、成功路径下沉与解压精确、
    // 克隆在回环源上失败时必须由压缩包回退兜底。

    /// 制作带"单一顶层目录"的仓库归档压缩包（主平台/备用平台归档布局）
    函数 制作仓库归档(顶层目录: &文本, 语言码: &文本) -> 向量<无符号微整数> {
        使用 标准库::输入输出::写入特征 作为 _;
        使用 拉链::写出::文件选项;
        让 可变 写入器 = 拉链::压缩包写入器::新建(标准库::输入输出::游标::新建(向量::新建()));
        让 选项值: 文件选项<'_, '_, 空> =
            文件选项::默认值().设置压缩方法(拉链::压缩方法::存储);
        写入器
            .开始文件(格式化!("{顶层目录}/{语言码}/keywords.toml"), 选项值)
            .解包();
        写入器
            .写入全部("[\"声明\"]\n\"函数\" = \"fn\"\n".转为字节())
            .解包();
        写入器
            .开始文件(格式化!("{顶层目录}/{语言码}/errors.toml"), 选项值)
            .解包();
        写入器
            .写入全部("[示例]\n\"a\" = \"b\"\n".转为字节())
            .解包();
        写入器.完成().解包().取内层()
    }

    /// 启动回环服务：对至多 `次数` 个连接应答固定状态码与正文后退出
    ///
    /// 绑定临时端口返回给调用方；请求无正文，读一次即应答；
    /// 应答完即关连接（连接即关），克隆/下载解析失败均为快速失败不会挂起。
    函数 启动回环服务(状态码: 无符号短整数, 响应体: 向量<无符号微整数>, 次数: 无符号机器整数) -> 无符号短整数 {
        使用 标准库::输入输出::{读取特征 作为 _, 写入特征 作为 _};
        让 监听器 = 标准库::网络::TCP监听器::绑定("127.0.0.1:0").解包();
        让 端口值 = 监听器.本地地址().解包().端口();
        让 原因值 = 如果 状态码 == 200 { "OK" } 否则 { "Not Found" };
        标准库::线程::生成(移动 || {
            对于 流值 在 监听器.接入().取值(次数) {
                让 成功(可变 流内容) = 流值 否则 { 继续 };
                让 可变 缓冲值 = [0; 4096];
                让 _ = 流内容.读取(&可变 缓冲值);
                让 头部 = 格式化!(
                    "HTTP/1.1 {状态码} {原因值}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
                    响应体.元素数()
                );
                让 _ = 流内容.写入全部(头部.转为字节());
                让 _ = 流内容.写入全部(&响应体);
                让 _ = 流内容.刷新();
            }
        });
        端口值
    }

    /// 成功路径：下载→解压→单一顶层目录自动下沉，语言包目录完整可见
    #[测试]
    函数 回环下载成功并下沉() {
        让 压缩包 = 制作仓库归档("i18n-rust-main", "xy");
        让 端口值 = 启动回环服务(200, 压缩包, 1);
        让 源项 = 仓库源项::从地址(&格式化!("http://127.0.0.1:{端口值}/repo"));
        断言相等!(
            源项.压缩包地址,
            格式化!("http://127.0.0.1:{端口值}/repo/archive/refs/heads/main.zip")
        );
        让 临时 = 临时目录句柄::新建().解包();
        让 根目录 = 拉取仓库压缩包(&源项, &临时).期望("回环压缩包下载解压应成功");
        断言相等!(根目录.取文件名().解包(), "i18n-rust-main");
        断言!(
            根目录.连接("xy/keywords.toml").是否为文件(),
            "单一顶层目录应自动下沉：{:?}",
            根目录
        );
    }

    /// 网络错误码必须响亮失败：错误消息含失败地址，不得留下半坏文件继续解压
    #[测试]
    函数 回环下载错误响亮失败() {
        让 端口值 = 启动回环服务(404, 向量::新建(), 1);
        让 源项 = 仓库源项::从地址(&格式化!("http://127.0.0.1:{端口值}/repo"));
        让 临时 = 临时目录句柄::新建().解包();
        让 错误值 = 拉取仓库压缩包(&源项, &临时).期望错误("网络 404 必须失败");
        断言!(
            错误值.转字符串().包含(&源项.压缩包地址),
            "错误应包含失败地址：{错误值}"
        );
    }

    /// 真实回环源的克隆失败→下载兜底链路（本地文件形态已有测试，这里覆盖
    /// 回环形态）：模拟服务对任何请求都回压缩包字节，克隆必失败，
    /// 尝试单个源必须回退到下载压缩包并安装成功
    #[测试]
    函数 克隆失败回退下载() {
        让 _锁 = 环境锁();
        让 临时根 = 临时文件::建临时目录().解包();
        // Rust 2024：进程级环境变量读写为不安全，由环境锁串行化
        不安全 {
            标准库::环境::设置环境变量("RZ_LANG_DIR", 临时根.条目路径().连接("global"));
        }
        让 压缩包 = 制作仓库归档("repo-main", "xy");
        // 应答预算充裕：克隆失败前可能发 1~2 个请求，下载再取一次压缩包
        让 端口值 = 启动回环服务(200, 压缩包, 6);
        让 源项 = 仓库源项::从地址(&格式化!("http://127.0.0.1:{端口值}/repo"));
        让 临时 = 临时目录句柄::新建().解包();
        尝试单个源("xy", &源项, &临时, 假)
            .期望("克隆失败应由压缩包回退兜底");
        断言!(
            全局语言目录().连接("xy/keywords.toml").是否为文件(),
            "回退安装应落盘到全局语言目录"
        );
        不安全 {
            标准库::环境::移除环境变量("RZ_LANG_DIR");
        }
    }

    // ==================== 首次信任内容指纹 ====================

    #[测试]
    函数 内容指纹确定性() {
        让 临时 = 临时文件::建临时目录().解包();
        让 目录值 = 临时.条目路径();
        文件系统::写入(目录值.连接("keywords.toml"), "[a]\nb = 1\n").解包();
        文件系统::递归创建目录(目录值.连接("crates")).解包();
        文件系统::写入(目录值.连接("crates/rand.toml"), "x = 2\n").解包();
        让 甲 = 内容指纹(目录值).解包();
        让 乙 = 内容指纹(目录值).解包();
        断言相等!(甲, 乙, "相同内容应产生相同指纹");
        断言相等!(甲.元素数(), 64);
        断言!(甲.逐字符().全部(是十六进制位));
    }

    #[测试]
    函数 内容指纹检测变化() {
        让 临时 = 临时文件::建临时目录().解包();
        让 目录值 = 临时.条目路径();
        文件系统::写入(目录值.连接("keywords.toml"), "v = 1\n").解包();
        让 前值 = 内容指纹(目录值).解包();
        文件系统::写入(目录值.连接("keywords.toml"), "v = 2\n").解包();
        让 后值 = 内容指纹(目录值).解包();
        断言不等!(前值, 后值, "内容变化应改变指纹");
    }

    #[测试]
    函数 内容指纹忽略旁路文件() {
        让 临时 = 临时文件::建临时目录().解包();
        让 目录值 = 临时.条目路径();
        文件系统::写入(目录值.连接("keywords.toml"), "v = 1\n").解包();
        让 无旁路值 = 内容指纹(目录值).解包();
        写入记录指纹(目录值, &无旁路值).解包();
        让 有旁路值 = 内容指纹(目录值).解包();
        断言相等!(无旁路值, 有旁路值, "旁路文件不应计入指纹");
    }

    #[测试]
    函数 记录指纹往返与畸形() {
        让 临时 = 临时文件::建临时目录().解包();
        让 目录值 = 临时.条目路径();
        断言相等!(读取记录指纹(目录值), 空值, "缺失 -> 空值");
        让 有效值 = "a".重复(64);
        写入记录指纹(目录值, &有效值).解包();
        断言相等!(
            读取记录指纹(目录值).作为解引用(),
            有值(有效值.作为文本切片())
        );
        文件系统::写入(目录值.连接(完整性文件), "not-a-hash\n").解包();
        断言相等!(读取记录指纹(目录值), 空值, "畸形 -> 空值");
    }
}

