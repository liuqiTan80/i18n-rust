        断言!(!校验语言代码("a/b"));
        断言!(!校验语言代码(".."));
        断言!(!校验语言代码("."));
    }

    /// 远程地址只允许 https/ssh/git@ 与本机回环 http
    #[测试]
    函数 地址安全规则() {
        断言!(地址安全("https://github.com/x/y"));
        断言!(地址安全("ssh://git@github.com/x/y"));
        断言!(地址安全("git@github.com:x/y.git"));
        断言!(地址安全("http://localhost:18080/x"));
        断言!(地址安全("http://127.0.0.1:18080/x"));
        断言!(地址安全("http://[::1]:18080/x"));
        断言!(!地址安全("http://example.com/x"));
        断言!(!地址安全("ftp://example.com/x"));
        断言!(地址安全("file:///tmp/repo"));
        断言!(地址安全("/tmp/repo"));
        断言!(地址安全("git@github.com:x/y.git"));
    }

