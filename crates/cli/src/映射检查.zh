//! 第三方库映射校验与脚手架模块
//!
//! 提供 `rzc mapping check` 与 `rzc mapping scaffold` 的核心逻辑：
//! - 校验：校验单个语言包的三方库映射文本质量
//!   （配置格式可解析 / 无重复键 / 关键字避让 / 跨文件同键冲突 / 条目数统计），
//!   以及跨内置语言的条目数一致性对比。
//! - 脚手架：从源语言的三方库映射生成目标语言的翻译骨架（保留英文值，母语键留待翻译）。
//!
//! 校验规则来自翻译实践：
//! 1. 关键字避让：三方库键与关键字配置的键相撞时，关键字先替换，三方库键永不生效 → 错误
//! 2. 三方库文件之间同键不同值：读取目录顺序未定义，合并非确定 → 错误
//! 3. 三方库键与标准库标识符同键不同值：标准库最后加载优先，三方库键被覆盖失效 → 警告

使用 标准库::集合::{哈希映射, 哈希集合};
使用 标准库::路径::{路径类型, 路径缓冲};

使用 引擎库::映射源;

/// 「母语词 → 英文」映射表
使用 错误处理::错误处理;

类型 名称映射 = 哈希映射<字符串, 字符串>;

/// 语言包映射数据的统一视图（内置数据与外部目录两种来源归一化）
公开 结构体 语言包视图 {
    /// 语言代码（如 zh / ru）
    公开 语言代码: 字符串,
    /// 关键字配置文本
    公开 关键字内容: 字符串,
    /// 标准库配置文本
    公开 标准库内容: 字符串,
    /// 错误配置文本（错误码/消息翻译）
    公开 错误内容: 字符串,
    /// 三方库映射（文件名, 配置文本），按文件名排序保证确定性
    公开 三方库表: 向量<(字符串, 字符串)>,
}

实现 语言包视图 {
    /// 从内置语言包数据构造视图
    公开 函数 从内置(语言代码: &文本) -> 自身 {
        让 数据 = 包::内置语言::获取内置数据(语言代码);
        让 可变 三方库表: 向量<(字符串, 字符串)> = 数据
            .三方库数据
            .迭代()
            .映射(|(包名, 内容串)| (包名.转字符串(), 内容串.转字符串()))
            .收集();
        三方库表.排序();
        自身 {
            语言代码: 语言代码.转字符串(),
            关键字内容: 数据.关键字内容.转字符串(),
            标准库内容: 数据.标准库内容.转字符串(),
            错误内容: 数据.错误内容.转字符串(),
            三方库表,
        }
    }

    /// 从外部语言包目录构造视图（读取关键字、标准库与三方库映射）
    公开 函数 从目录(目录值: &路径类型) -> 错误处理::结果<自身> {
        让 语言代码 = 目录值
            .取文件名()
            .而后映射(|本名| 本名.取字符串引用())
            .解包或用("unknown")
            .转字符串();
        让 关键字内容 = 标准库::文件系统::读取全部字符串(目录值.连接("keywords.toml"))
            .映射错误(|错误值| 错误处理!("读取 keywords.toml 失败: {}", 错误值))?;
        // 标准库文件可选（部分语言包可能未提供）
        让 标准库内容 =
            标准库::文件系统::读取全部字符串(目录值.连接("stdlib.toml")).取值或默认();
        // 错误文件可选（英文等母语即英文的语言无此文件）
        让 错误内容 =
            标准库::文件系统::读取全部字符串(目录值.连接("errors.toml")).取值或默认();
        让 可变 三方库表 = 向量::新建();
        让 三方库目录 = 目录值.连接("crates");
        如果 三方库目录.是否为目录() {
            让 可变 文件清单: 向量<路径缓冲> = 标准库::文件系统::读取目录(&三方库目录)
                .映射错误(|错误值| 错误处理!("读取 crates 目录失败: {}", 错误值))?
                .过滤映射(|目录条目| 目录条目.转选项())
                .映射(|目录条目| 目录条目.条目路径())
                .过滤(|路径值| {
                    路径值.取扩展名().而后映射(|后缀| 后缀.取字符串引用()) == 有值("toml")
                })
                .收集();
            文件清单.排序();
            对于 路径值 在 文件清单 {
                让 文件本名 = 路径值
                    .取文件名()
                    .而后映射(|本名| 本名.取字符串引用())
                    .解包或用("unknown.toml")
                    .转字符串();
                让 内容串 = 标准库::文件系统::读取全部字符串(&路径值)
                    .映射错误(|错误值| 错误处理!("读取 {} 失败: {}", 路径值.展示(), 错误值))?;
                三方库表.推入((文件本名, 内容串));
            }
        }
        成功(自身 {
            语言代码,
            关键字内容,
            标准库内容,
            错误内容,
            三方库表,
        })
    }
}

/// 校验统计信息
#[派生(调试, 默认, 克隆)]
公开 结构体 校验统计 {
    /// 三方库文件数
    公开 包文件数: 无符号机器整数,
    /// 模块路径节条目总数
    公开 模块路径条目数: 无符号机器整数,
    /// 标识符节条目总数
    公开 标识符条目数: 无符号机器整数,
}

/// 校验报告
#[派生(调试, 默认)]
公开 结构体 校验报告 {
    /// 必须修复的错误
    公开 错误列表: 向量<字符串>,
    /// 建议修复的警告
    公开 警告列表: 向量<字符串>,
    /// 统计信息
    公开 统计: 校验统计,
}

实现 校验报告 {
    /// 是否通过（无错误；警告不阻断）
    公开 函数 是否通过(&自我) -> 布尔 {
        自我.错误列表.是否为空()
    }
}

/// 提取配置文本中「模块路径」与「标识符」两节的键值对
///
/// 返回（模块路径表, 标识符表）。配置解析失败（含重复键）时返回错误。
函数 提取各节(内容文本: &文本) -> 结果<(名称映射, 名称映射), 字符串> {
    让 节表值 = 映射源::解析映射节(内容文本).映射错误(|错误值| 错误值.转字符串())?;
    让 模块路径表 = 节表值.获取("模块路径").克隆副本().解包或用(哈希映射::新建());
    让 标识符表 = 节表值.获取("标识符").克隆副本().解包或用(哈希映射::新建());
    成功((模块路径表, 标识符表))
}

/// 提取关键字配置中所有节的「母语词 → 英文」映射
///
/// 复用引擎权威语义（摊平节表：按节名升序合并，后到覆盖），
/// 与运行时实际生效的关键字映射保持一致，避免校验误报。
/// 「派生特征」节仅在派生属性内生效（不并入关键字表），
/// 此处同步排除，否则与标准库/三方库的同键异值（如调试在派生特征与
/// 标准库中的取值不同）会被误报为冲突。
///
/// 用于关键字避让检测：需比较三方库键与关键字的值是否一致，
/// 同值视为安全冗余（关键字替换与三方库替换结果相同），不同值才是真冲突。
函数 提取关键字映射(内容文本: &文本) -> 哈希映射<字符串, 字符串> {
    匹配 映射源::解析映射节(内容文本) {
        成功(各节) => {
            让 可变 映射表 = 映射源::摊平节表(&各节);
            如果让 有值(派生节) = 各节.获取("派生特征") {
                对于 键名 在 派生节.键() {
                    映射表.移除(键名);
                }
            }
            映射表
        }
        错误(_) => 哈希映射::新建(),
    }
}

/// 关键字配置必需节（引擎按节名取表，缺节不会报错，只会让整类词条静默失效）
///
/// - `宏`：宏名 → 英文宏名，供宏调用自动补 `!`。缺失则宏映射为空、
///   宏调用不再补 `!`，产物非法却仍报「转译成功」，最难排查；
/// - `派生特征`：派生属性参数。缺失则派生参数不替换；
/// - 其余节经摊平节表合并进关键字表，缺节即整类方言词不可用。
常量 必需关键字节: &[&文本] = &[
    "声明",
    "控制流",
    "类型",
    "逻辑值",
    "特殊值",
    "内存",
    "不安全",
    "错误处理",
    "宏",
    "派生特征",
    "标准库成员",
];

/// 校验单个映射文件的危险等级元数据
///
/// 规则（均为错误，防止回归为「隐式崩溃 / 误标纯安全」）：
/// - 等级值只允许会恐慌、会改写、纯安全（多风险用 `+` 连接）；
/// - 元数据键必须对应本文件已声明的词条（防止改名后元数据失效）；
/// - 映射目标属于一定会恐慌的集合时，显式标注不得漏掉恐慌；
/// - 关键字/宏词条带改写风险，显式标注不得漏掉改写。
函数 检查危险元数据(
    报告值: &可变 校验报告,
    文件本名: &文本,
    内容文本: &文本,
    目标表: &名称映射,
    是关键字: 布尔,
) {
    使用 引擎库::映射源::{危险等级节, 危险备注节, 危险等级, 恒恐慌目标};

    让 成功(各节) = 映射源::解析映射节(内容文本) 否则 {
        返回; // 配置解析错误已由其他检查项报告
    };
    让 可变 已声明 = 哈希集合::新建();
    对于 (词条, 原始文本) 在 各节.获取(危险等级节).转迭代().展平() {
        已声明.置入(词条.作为文本切片());
        让 有值(等级值) = 危险等级::解析等级(原始文本) 否则 {
            报告值
                .错误列表
                .推入(格式化!("mc_danger_invalid|{}|{}|{}", 文件本名, 词条, 原始文本));
            继续;
        };
        让 有值(目标) = 目标表.获取(词条) 否则 {
            报告值
                .错误列表
                .推入(格式化!("mc_danger_orphan|{}|{}", 文件本名, 词条));
            继续;
        };
        如果 恒恐慌目标(目标) && !等级值.会恐慌 {
            报告值
                .错误列表
                .推入(格式化!("mc_danger_understated|{}|{}|{}", 文件本名, 词条, 目标));
        }
        如果 是关键字 && !等级值.会改写 {
            报告值
                .错误列表
                .推入(格式化!("mc_danger_understated_rewrite|{}|{}", 文件本名, 词条));
        }
    }
    // 只写备注不写等级同样算孤立元数据（两节必须成对维护）
    对于 词条 在 各节
        .获取(危险备注节)
        .转迭代()
        .展平()
        .映射(|(词条名, _)| 词条名)
    {
        如果 !已声明.包含(词条.作为文本切片()) && !目标表.包含键(词条) {
            报告值
                .错误列表
                .推入(格式化!("mc_danger_orphan|{}|{}", 文件本名, 词条));
        }
    }
}

/// 校验单个语言包的三方库映射质量
///
/// 检查项（按严重级别）：
/// - 错误：配置解析失败（含重复键）
/// - 错误：标准库配置解析失败（重复键等——标准库整体加载失败，
///   运行时标准库映射全部丢失，此前静默吞掉导致德语与葡萄牙语重复键长期潜伏）
/// - 错误：三方库键与关键字配置的键相撞（关键字先替换，三方库键永不生效）
/// - 错误：三方库文件之间模块路径/标识符同键不同值（合并非确定）
/// - 警告：三方库标识符键与标准库标识符同键不同值（标准库优先，三方库键失效）
///
/// 设计约定（不检查）：同一文件内「模块路径」与「标识符」两节
/// 双节同键不同值是合法模式（模块路径为三方库名的小写形式，
/// 标识符为类型名的大写形式，两表在词法/语义阶段独立查询，互不干扰），
/// 不视为冲突；同键同值则为安全冗余。
公开 函数 校验语言包(视图: &语言包视图) -> 校验报告 {
    让 可变 报告值 = 校验报告::默认值();
    让 关键字映射 = 提取关键字映射(&视图.关键字内容);

    // 0. 关键字配置的可解析性与必需节完整性。
    // 解析失败（如重复键）会让关键字表整体失效（全部方言词不可用）；
    // 缺节不会报错——引擎按节名取表，缺节返回空表，整类词条静默失效。
    // 其中缺「宏」最危险：宏调用不再自动补 `!`，产物非法却仍报「转译成功」。
    匹配 TOML处理::解析字符串::<TOML处理::表格>(&视图.关键字内容) {
        成功(表值) => {
            对于 节名 在 必需关键字节 {
                如果 !表值.包含键(*节名) {
                    报告值
                        .错误列表
                        .推入(格式化!("mc_missing_section|{}|{}", 视图.语言代码, 节名));
                }
            }
        }
        错误(错误值) => 报告值
            .错误列表
            .推入(格式化!("mc_parse_failed|keywords.toml|{}", 错误值)),
    }

    // 标准库解析失败必须报错（重复键等会让标准库整体加载失败）；
    // 空内容（无标准库文件）解析为空表，不会误报
    让 (_, 标准库标识符表) = 匹配 提取各节(&视图.标准库内容) {
        成功(各节) => 各节,
        错误(错误值) => {
            报告值
                .错误列表
                .推入(格式化!("mc_stdlib_parse_failed|{}", 错误值));
            (哈希映射::新建(), 哈希映射::新建())
        }
    };

    // 危险等级元数据：值合法性 / 孤立键 / 漏标恐慌与改写
    // （关键字默认改写、解包类目标默认恐慌，显式标注不得降级）
    {
        让 可变 关键字目标表 = 关键字映射.克隆值();
        如果让 成功(各节) = 映射源::解析映射节(&视图.关键字内容)
            && 让 有值(派生节) = 各节.获取("派生特征")
        {
            关键字目标表.扩展(派生节.迭代().映射(|(键名, 值项)| {
                (键名.克隆值(), 值项.克隆值())
            }));
        }
        检查危险元数据(
            &可变 报告值,
            "keywords.toml",
            &视图.关键字内容,
            &关键字目标表,
            真,
        );
        让 (可变 标准库目标表, 标准库标识符目标表) =
            提取各节(&视图.标准库内容).取值或默认();
        标准库目标表.扩展(标准库标识符目标表);
        检查危险元数据(
            &可变 报告值,
            "stdlib.toml",
            &视图.标准库内容,
            &标准库目标表,
            假,
        );
    }

    // 跨文件键追踪（模块路径与标识符分别维护）：键 -> (值, 首次出现的文件)
    让 可变 已见模块路径: 哈希映射<字符串, (字符串, 字符串)> = 哈希映射::新建();
    让 可变 已见标识符: 哈希映射<字符串, (字符串, 字符串)> = 哈希映射::新建();

    对于 (文件本名, 内容文本) 在 &视图.三方库表 {
        报告值.统计.包文件数 += 1;
        // 1. 配置解析（重复键 / 格式错误在此暴露）
        让 (模块路径表, 标识符表) = 匹配 提取各节(内容文本) {
            成功(各节) => 各节,
            错误(错误值) => {
                报告值
                    .错误列表
                    .推入(格式化!("mc_parse_failed|{}|{}", 文件本名, 错误值));
                继续;
            }
        };
        报告值.统计.模块路径条目数 += 模块路径表.长度();
        报告值.统计.标识符条目数 += 标识符表.长度();
        // 危险等级元数据：键必须对应本文件词条，且不得漏标恐慌
        让 可变 危险目标表 = 模块路径表.克隆值();
        危险目标表.扩展(标识符表.迭代().映射(|(键名, 值项)| {
            (键名.克隆值(), 值项.克隆值())
        }));
        检查危险元数据(&可变 报告值, 文件本名, 内容文本, &危险目标表, 假);

        // 2. 关键字避让（对模块路径节与标识符节的键都检查）
        // 3. 跨文件同键不同值（两节对称：合并结果由文件名排序决定，
        //    同键不同值意味着覆盖语义取决于排序，属确定性歧义）
        对于 节名 在 ["模块路径", "标识符"] {
            让 (条目表, 已见表, 错误码) = 如果 节名 == "模块路径" {
                (&模块路径表, &可变 已见模块路径, "mc_cross_conflict_mp")
            } 否则 {
                (&标识符表, &可变 已见标识符, "mc_cross_conflict")
            };
            对于 (键名, 值项) 在 条目表 {
                // 关键字避让：仅当三方库键与关键字值不同时报错；
                // 同值时关键字替换与三方库替换结果一致，属安全冗余不报错
                如果 关键字映射.获取(键名).有值且(|关键字值| 关键字值 != 值项) {
                    报告值.错误列表.推入(格式化!(
                        "mc_keyword_collision|{}|{}|{}|{}|{}",
                        文件本名,
                        节名,
                        键名,
                        值项,
                        关键字映射[键名]
                    ));
                }
                // 跨文件同键不同值
                如果让 有值((前值, 前来源)) = 已见表.获取(键名) {
                    如果 前值 != 值项 {
                        报告值.错误列表.推入(格式化!(
                            "{}|{}|{}|{}|{}|{}",
                            错误码, 键名, 前来源, 前值, 文件本名, 值项
                        ));
                    }
                } 否则 {
                    已见表.置入(键名.克隆值(), (值项.克隆值(), 文件本名.克隆值()));
                }
                // 标准库覆盖检测（标识符节；标准库后加载优先）
                如果 节名 == "标识符"
                    && 标准库标识符表.获取(键名).有值且(|标准库值| 标准库值 != 值项)
                {
                    报告值.警告列表.推入(格式化!(
                        "mc_stdlib_shadow|{}|{}|{}|{}",
                        文件本名,
                        键名,
                        值项,
                        标准库标识符表[键名]
                    ));
                }
            }
        }
    }
    报告值
}

/// 从源语言的三方库映射生成目标语言的翻译骨架
///
/// 保留配置结构与英文值，在每个含母语键的行后追加待办注释提示翻译。
/// 返回生成的文件数。目标目录不存在时自动创建。
公开 函数 生成骨架(
    源视图: &语言包视图,
    目标语言: &文本,
    输出目录: &路径类型,
) -> 错误处理::结果<(无符号机器整数, 无符号机器整数)> {
    标准库::文件系统::创建所有目录(输出目录).映射错误(|错误值| {
        错误处理!("创建目录 {} 失败: {}", 输出目录.展示(), 错误值)
    })?;
    让 可变 已创建数 = 0;
    让 可变 已跳过数 = 0;
    对于 (文件本名, 内容文本) 在 &源视图.三方库表 {
        让 目标路径 = 输出目录.连接(文件本名);
        // 已存在的文件跳过：保留既有翻译成果，保证重跑幂等
        如果 目标路径.存在() {
            已跳过数 += 1;
            继续;
        }
        让 骨架文本 = 追加骨架待办(内容文本, &源视图.语言代码, 目标语言);
        标准库::文件系统::写入(&目标路径, 骨架文本).映射错误(|错误值| {
            错误处理!("写入 {} 失败: {}", 目标路径.展示(), 错误值)
        })?;
        已创建数 += 1;
    }
    成功((已创建数, 已跳过数))
}

/// 为配置文本中每个「母语键 = 英文值」行追加待办翻译注释
///
/// 仅处理「模块路径」与「标识符」节内的键值行；节标题、注释、空行原样保留。
函数 追加骨架待办(内容文本: &文本, 源语言: &文本, 目标语言: &文本) -> 字符串 {
    让 可变 输出文本 = 字符串::新建();
    让 可变 是否目标节 = 假;
    对于 行文本 在 内容文本.逐行() {
        让 裁剪行 = 行文本.裁剪();
        // 节标题检测：进入/离开目标节
        如果 裁剪行.以开头('[') {
            是否目标节 = 裁剪行 == "[\"模块路径\"]" || 裁剪行 == "[\"标识符\"]";
            输出文本.推入字符串(行文本);
            输出文本.推入('\n');
            继续;
        }
        // 目标节内的键值行（含 `=` 且非注释）追加待办
        如果 是否目标节 && 裁剪行.包含('=') && !裁剪行.以开头('#') {
            // 已有行尾注释时不重复追加
            如果 !裁剪行.包含("TODO") {
                输出文本.推入字符串(行文本);
                输出文本.推入字符串(&格式化!(
                    "  # TODO({}): 将键从 {} 翻译",
                    目标语言,
                    源语言
                ));
                输出文本.推入('\n');
                继续;
            }
        }
        输出文本.推入字符串(行文本);
        输出文本.推入('\n');
    }
    输出文本
}

/// 打印单个语言包的校验报告（本地化输出）
///
/// 报告条目格式为 `code|arg1|arg2...`，按消息码查界面模板渲染。
函数 打印报告(语言代码: &文本, 报告值: &校验报告) {
    让 界面表 = 包::界面::界面消息表::全局表();
    打印行!("{}", 界面表.取带参消息("mc_header", &[语言代码]));
    打印行!(
        "{}",
        界面表.取带参消息(
            "mc_stats",
            &[
                &报告值.统计.包文件数.转字符串(),
                &报告值.统计.模块路径条目数.转字符串(),
                &报告值.统计.标识符条目数.转字符串()
            ]
        )
    );
    对于 错误项 在 &报告值.错误列表 {
        打印行!("{}", 渲染问题(错误项));
    }
    对于 警告项 在 &报告值.警告列表 {
        打印行!("{}", 渲染问题(警告项));
    }
    如果 报告值.是否通过() {
        打印行!(
            "{}",
            如果 报告值.警告列表.是否为空() {
                界面表.取消息("mc_ok")
            } 否则 {
                界面表
                    .取带参消息("mc_ok_with_warnings", &[&报告值.警告列表.长度().转字符串()])
            }
        );
    } 否则 {
        打印行!(
            "{}",
            界面表.取带参消息(
                "mc_failed",
                &[
                    &报告值.错误列表.长度().转字符串(),
                    &报告值.警告列表.长度().转字符串()
                ]
            )
        );
    }
}

/// 将 `code|arg1|arg2...` 格式的问题条目渲染为本地化消息
函数 渲染问题(问题文本: &文本) -> 字符串 {
    让 界面表 = 包::界面::界面消息表::全局表();
    让 可变 片段表 = 问题文本.分割('|');
    让 消息码 = 片段表.下一个().解包或用(问题文本);
    让 参数表: 向量<&文本> = 片段表.收集();
    界面表.取带参消息(消息码, &参数表)
}

/// 「映射校验」命令入口
///
/// - 目标为空值：校验全部内置语言并输出跨语言条目数一致性对比
/// - 目标为已存在的目录路径：按外部语言包目录校验
/// - 否则按内置语言代码校验
公开 函数 运行检查(目标: 选项<&文本>) -> 错误处理::结果<布尔> {
    让 界面表 = 包::界面::界面消息表::全局表();
    让 有值(目标值) = 目标 否则 {
        // 全部内置语言 + 跨语言一致性对比 + 跨语言完整性门禁
        让 可变 全部通过 = 真;
        对于 语言代码 在 包::内置语言::内置语言清单() {
            让 视图 = 语言包视图::从内置(语言代码);
            让 报告值 = 校验语言包(&视图);
            全部通过 &= 报告值.是否通过();
            打印报告(语言代码, &报告值);
        }
        打印跨语言数量();
        全部通过 &= 打印跨语言完整性();
        返回 成功(全部通过);
    };
    让 路径值 = 路径类型::新建(目标值);
    如果 路径值.是否为目录() {
        让 视图 = 语言包视图::从目录(路径值)?;
        让 报告值 = 校验语言包(&视图);
        让 通过 = 报告值.是否通过();
        打印报告(&视图.语言代码, &报告值);
        成功(通过)
    } 否则 如果 包::内置语言::有内置语言包(目标值) {
        让 视图 = 语言包视图::从内置(目标值);
        让 报告值 = 校验语言包(&视图);
        让 通过 = 报告值.是否通过();
        打印报告(目标值, &报告值);
        成功(通过)
    } 否则 {
        错误处理::错误中止!("{}", 界面表.取带参消息("mc_unknown_target", &[目标值]));
    }
}

/// 跨语言完整性检查报告
#[派生(调试, 默认)]
公开 结构体 跨语言报告 {
    /// 必须修复的错误（方言词缺失，功能缺口）
    公开 错误列表: 向量<字符串>,
    /// 建议补齐的警告（有回退机制，不阻断）
    公开 警告列表: 向量<字符串>,
}

实现 跨语言报告 {
    /// 是否通过（无错误；警告不阻断）
    公开 函数 是否通过(&自我) -> 布尔 {
        自我.错误列表.是否为空()
    }
}

/// 提取关键字配置的扁平化关键字值集合与派生特征值集合
///
/// 与引擎运行时语义一致（摊平节表 + 派生特征节单独存放），
/// 按英文值对齐而非母语键：各语言母语词不同（日语用日语、德语用德语），
/// 只有英文值是跨语言可比的方言能力。
函数 提取关键字值集合(内容文本: &文本) -> (哈希集合<字符串>, 哈希集合<字符串>) {
    匹配 映射源::解析映射节(内容文本) {
        成功(各节) => {
            让 可变 关键字集 = 哈希集合::新建();
            让 可变 派生集 = 哈希集合::新建();
            对于 (节名, 映射表) 在 &各节 {
                // 危险等级/备注是元数据节（值不是 Rust 名称），
                // 并入值集合会把恐慌等标记当成缺失词条误报
                如果 映射源::是否元数据节(节名) {
                    继续;
                }
                让 目标集 = 如果 节名 == "派生特征" {
                    &可变 派生集
                } 否则 {
                    &可变 关键字集
                };
                对于 值项 在 映射表.值() {
                    目标集.置入(值项.克隆值());
                }
            }
            (关键字集, 派生集)
        }
        错误(_) => (哈希集合::新建(), 哈希集合::新建()),
    }
}

/// 提取错误配置的错误码节集合（如 E0425）与消息翻译键集合
函数 错误组成(内容文本: &文本) -> (哈希集合<字符串>, 哈希集合<字符串>) {
    // 配置解析入口必须是整文档，不能按单个值解析，否则会静默退化为空集合
    让 成功(值对象) = TOML处理::解析字符串::<TOML处理::TOML值>(内容文本) 否则 {
        返回 (哈希集合::新建(), 哈希集合::新建());
    };
    让 有值(表值) = 值对象.作为表格() 否则 {
        返回 (哈希集合::新建(), 哈希集合::新建());
    };
    让 可变 错误码集 = 哈希集合::新建();
    让 可变 消息键集 = 哈希集合::新建();
    对于 (键名, 值项) 在 表值 {
        如果 键名.以开头('E')
            && 键名.长度() == 5
            && 键名[1..].逐字符().全部(|单字| 单字.是数字字符())
        {
            错误码集.置入(键名.克隆值());
        } 否则 如果 键名 == "消息翻译"
            && 让 有值(消息表) = 值项.作为表格()
        {
            对于 消息键 在 消息表.键() {
                消息键集.置入(消息键.克隆值());
            }
        }
    }
    (错误码集, 消息键集)
}

/// 单对基准/目标语言包的跨语言完整性检查
///
/// 规则（基准 = 语言包维护语言，当前为 zh）：
/// - 错误：目标语言缺少基准语言拥有的关键字英文值（方言词不可用，功能缺口）
/// - 错误：目标语言缺少派生特征值（派生属性参数不可用）
/// - 错误：目标语言缺少基准语言的错误码节（该错误码无母语教学提示）
/// - 警告：目标语言缺少消息翻译键（无错误码时回退英文原文，可工作）
公开 函数 校验跨语言对(基准: &语言包视图, 目标: &语言包视图) -> 跨语言报告 {
    让 可变 报告值 = 跨语言报告::默认值();
    让 (基准关键字, 基准派生) = 提取关键字值集合(&基准.关键字内容);
    让 (目标关键字, 目标派生) = 提取关键字值集合(&目标.关键字内容);
    让 (基准错误码, 基准消息键) = 错误组成(&基准.错误内容);
    让 (目标错误码, 目标消息键) = 错误组成(&目标.错误内容);

    // 关键字值缺失：合并输出，避免每个词一条噪音
    让 可变 缺失关键字: 向量<字符串> = 基准关键字
        .迭代()
        .过滤(|值项| !目标关键字.包含(*值项))
        .克隆副本()
        .收集();
    缺失关键字.排序();
    如果 !缺失关键字.是否为空() {
        报告值.错误列表.推入(格式化!(
            "mc_cross_kw_missing|{}|{}|{}",
            目标.语言代码,
            缺失关键字.长度(),
            缺失关键字.连接("/")
        ));
    }
    // 派生特征值缺失（语法上在关键字配置的派生特征节）
    让 可变 缺失派生: 向量<字符串> = 基准派生
        .迭代()
        .过滤(|值项| !目标派生.包含(*值项))
        .克隆副本()
        .收集();
    缺失派生.排序();
    如果 !缺失派生.是否为空() {
        报告值.错误列表.推入(格式化!(
            "mc_cross_derive_missing|{}|{}|{}",
            目标.语言代码,
            缺失派生.长度(),
            缺失派生.连接("/")
        ));
    }
    // 错误码节缺失
    让 可变 缺失错误码: 向量<字符串> = 基准错误码
        .迭代()
        .过滤(|值项| !目标错误码.包含(*值项))
        .克隆副本()
        .收集();
    缺失错误码.排序();
    如果 !缺失错误码.是否为空() {
        报告值.错误列表.推入(格式化!(
            "mc_cross_err_missing|{}|{}|{}",
            目标.语言代码,
            缺失错误码.长度(),
            缺失错误码.连接("/")
        ));
    }
    // 消息翻译键缺失（警告：无错误码匹配时回退英文原文）
    让 可变 缺失消息: 向量<字符串> = 基准消息键
        .迭代()
        .过滤(|值项| !目标消息键.包含(*值项))
        .克隆副本()
        .收集();
    缺失消息.排序();
    如果 !缺失消息.是否为空() {
        报告值.警告列表.推入(格式化!(
            "mc_cross_msg_missing|{}|{}|{}",
            目标.语言代码,
            缺失消息.长度(),
            缺失消息
                .迭代()
                .取值(5)
                .克隆副本()
                .收集::<向量<_>>()
                .连接(" / ")
        ));
    }
    报告值
}

/// 打印跨内置语言的完整性检查（以 zh 为基准，错误阻断）
///
/// 英文等母语即英文的语言包无关键字/错误文件，跳过不参与比较。
/// 返回是否全部通过（供运行检查汇总退出码）。
公开 函数 打印跨语言完整性() -> 布尔 {
    让 界面表 = 包::界面::界面消息表::全局表();
    打印行!("{}", 界面表.取消息("mc_cross_integrity_header"));
    让 基准 = 语言包视图::从内置("zh");
    让 可变 全部通过 = 真;
    让 可变 有检查 = 假;
    对于 语言代码 在 包::内置语言::内置语言清单() {
        如果 语言代码 == "zh" {
            继续;
        }
        让 视图 = 语言包视图::从内置(语言代码);
        // 无关键字/错误数据（母语即英文）的语言不参与比较
        如果 视图.关键字内容.是否为空() && 视图.错误内容.是否为空() {
            继续;
        }
        有检查 = 真;
        让 报告值 = 校验跨语言对(&基准, &视图);
        全部通过 &= 报告值.是否通过();
        对于 错误项 在 &报告值.错误列表 {
            打印行!("  {}", 渲染问题(错误项));
        }
        对于 警告项 在 &报告值.警告列表 {
            打印行!("  {}", 渲染问题(警告项));
        }
        如果 报告值.是否通过() && 报告值.警告列表.是否为空() {
            打印行!("  {}: {}", 语言代码, 界面表.取消息("mc_cross_integrity_ok"));
        } 否则 如果 报告值.是否通过() {
            打印行!(
                "  {}: {}",
                语言代码,
                界面表.取带参消息(
                    "mc_cross_integrity_warn",
                    &[&报告值.警告列表.长度().转字符串()]
                )
            );
        }
    }
    如果 !有检查 {
        打印行!("  {}", 界面表.取消息("mc_cross_integrity_none"));
    }
    全部通过
}

函数 打印跨语言数量() {
    让 界面表 = 包::界面::界面消息表::全局表();
    让 语言清单 = 包::内置语言::内置语言清单();
    让 可变 数量表: 向量<(字符串, 无符号机器整数, 无符号机器整数)> = 向量::新建();
    对于 语言代码 在 语言清单 {
        让 视图 = 语言包视图::从内置(语言代码);
        让 报告值 = 校验语言包(&视图);
        数量表.推入((
            语言代码.转字符串(),
            报告值.统计.包文件数,
            报告值.统计.标识符条目数,
        ));
    }
    数量表.排序_by(|甲, 乙| 甲.0.比较(&乙.0));
    打印行!("{}", 界面表.取消息("mc_cross_lang_header"));
    对于 (语言代码, _, 条目数) 在 &数量表 {
        打印行!("  {}: {}", 语言代码, 条目数);
    }
    // 仅对有包文件的语言比较条目数
    让 有包清单: 向量<无符号机器整数> = 数量表
        .迭代()
        .过滤(|(_, 包数, _)| *包数 > 0)
        .映射(|(_, _, 条目数)| *条目数)
        .收集();
    让 首值 = 有包清单.第一个().复制值();
    让 不一致 = 有包清单.迭代().任意(|条目数| 有值(*条目数) != 首值);
    如果 不一致 {
        打印行!("{}", 界面表.取消息("mc_cross_lang_inconsistent"));
    } 否则 {
        打印行!("{}", 界面表.取消息("mc_cross_lang_consistent"));
    }
}

/// 「映射脚手架」命令入口
///
/// 源语言必须是内置语言代码；输出为空值时默认写入
/// 项目语言包根 `<目标>/crates/`（主仓库内为 crates/engine/lang-packs/，
/// 用户项目为 lang-packs/）。
/// 服务商：规则（默认，生成待办骨架待人工翻译）或
/// 深度求索 / 开放人工智能 / 兼容端点（智能服务自动翻译键名，需配好密钥环境变量）。
公开 函数 运行生成骨架(
    源语言: &文本,
    目标语言: &文本,
    输出参数: 选项<&路径类型>,
    服务商: &文本,
) -> 错误处理::结果<空> {
    让 界面表 = 包::界面::界面消息表::全局表();
    如果 !包::内置语言::有内置语言包(源语言) {
        错误处理::错误中止!("{}", 界面表.取带参消息("mc_unknown_source", &[源语言]));
    }
    // 先判定服务商与凭据再动手：拼错的服务商选项、没配的密钥都不该
    // 先生成一堆骨架文件再报错
    让 可变 用智能 = 假;
    匹配 包::映射生成::解析服务商(服务商) {
        有值(服务商模式) => 匹配 服务商模式 {
            包::映射生成::服务商::智能 => {
                包::映射生成::确保凭据()?;
                用智能 = 真;
            }
            包::映射生成::服务商::规则 => {}
        },
        无 => 错误处理::错误中止!(
            "{}",
            界面表.取带参消息("mapping_unknown_provider", &[服务商])
        ),
    };
    让 视图 = 语言包视图::从内置(源语言);
    如果 视图.三方库表.是否为空() {
        错误处理::错误中止!("{}", 界面表.取带参消息("mc_no_crates", &[源语言]));
    }
    让 输出目录 = 匹配 输出参数 {
        有值(目录值) => 目录值.转路径缓冲(),
        无 => {
            让 基准目录 = 标准库::环境::当前目录()
                .转选项()
                .而后映射(|工作目录| 包::查找项目根向上(&工作目录))
                .解包或用否则(|| 路径缓冲::从("."));
            包::语言包根目录(&基准目录).连接(格式化!("{}/crates", 目标语言))
        }
    };
    让 (已创建数, 已跳过数) = 生成骨架(&视图, 目标语言, &输出目录)?;
    如果 已创建数 > 0 {
        打印行!(
            "{}",
            界面表.取带参消息(
                "mc_scaffold_generated",
                &[&已创建数.转字符串(), &输出目录.展示().转字符串()]
            )
        );
    }
    如果 已跳过数 > 0 {
        打印行!(
            "{}",
            界面表.取带参消息("mc_scaffold_skip_existing", &[&已跳过数.转字符串()])
        );
    }
    如果 用智能 {
        智能翻译骨架(&视图, 源语言, 目标语言, &输出目录)?;
    } 否则 {
        打印行!("{}", 界面表.取带参消息("mc_scaffold_hint", &[目标语言]));
    }
    成功(())
}

// ==================== 智能翻译（服务商：深度求索 / 开放人工智能 / 兼容端点） ====================

/// 每批送智能服务的键数上限
常量 智能批量上限: 无符号机器整数 = 60;
/// 冲突改名最大重试轮数
常量 智能最大重试轮数: 无符号机器整数 = 2;

/// 智能翻译脚手架：提取待办键 → 批量翻译 → 写回 → 校验冲突 → 改名重试
函数 智能翻译骨架(
    源视图: &语言包视图,
    源语言: &文本,
    目标语言: &文本,
    输出目录: &路径类型,
) -> 错误处理::结果<空> {
    让 界面表 = 包::界面::界面消息表::全局表();
    // 禁用词：源包关键字配置的键（译名撞关键字会永不生效）
    让 禁用词表: 向量<字符串> = 提取关键字映射(&源视图.关键字内容)
        .键()
        .克隆副本()
        .收集();

    让 项列表 = 收集待办键(输出目录, 目标语言)?;
    如果 项列表.是否为空() {
        返回 成功(());
    }
    // 按（键, 英文值）去重，保证跨文件同键翻译一致
    让 可变 唯一项: 向量<(字符串, 字符串)> = 向量::新建();
    对于 (_, 键名, 值项) 在 &项列表 {
        如果 !唯一项
            .迭代()
            .任意(|(已有键, 已有值)| 已有键 == 键名 && 已有值 == 值项)
        {
            唯一项.推入((键名.克隆值(), 值项.克隆值()));
        }
    }

    // 批量翻译
    让 可变 翻译表: 哈希映射<字符串, 字符串> = 哈希映射::新建();
    让 总批数 = 唯一项.分块(智能批量上限).计数();
    对于 (批序, 批次) 在 唯一项.分块(智能批量上限).枚举() {
        打印行!(
            "{}",
            界面表.取带参消息(
                "mc_scaffold_ai_batch",
                &[&(批序 + 1).转字符串(), &总批数.转字符串()]
            )
        );
        让 已用词: 向量<字符串> = 翻译表.值().克隆副本().收集();
        让 批次映射 = 智能翻译键(源语言, 目标语言, 批次, &禁用词表, &已用词)?;
        翻译表.扩展(批次映射);
    }
    让 替换数 = 应用翻译(输出目录, &翻译表, 目标语言)?;
    打印行!(
        "{}",
        界面表.取带参消息(
            "mc_scaffold_ai_done",
            &[&替换数.转字符串(), &项列表.长度().转字符串()]
        )
    );
    如果 替换数 < 项列表.长度() {
        打印行!(
            "{}",
            界面表.取带参消息(
                "mc_scaffold_ai_partial",
                &[&(项列表.长度() - 替换数).转字符串()]
            )
        );
    }

    // 校验回环：对生成的三方库目录重新校验，冲突键送智能服务改名重试
    对于 轮次 在 1..=智能最大重试轮数 {
        让 报告值 = 校验语言包(&从三方库目录构建视图(输出目录, 源视图));
        让 冲突项 = 收集冲突项(&报告值, 输出目录);
        如果 冲突项.是否为空() {
            如果 !报告值.警告列表.是否为空() {
                打印行!(
                    "{}",
                    界面表.取带参消息("mc_ok_with_warnings", &[&报告值.警告列表.长度().转字符串()])
                );
            } 否则 {
                打印行!("{}", 界面表.取消息("mc_ok"));
            }
            返回 成功(());
        }
        打印行!(
            "{}",
            界面表.取带参消息(
                "mc_scaffold_ai_retry",
                &[
                    &冲突项.长度().转字符串(),
                    &轮次.转字符串(),
                    &智能最大重试轮数.转字符串()
                ]
            )
        );
        让 改名表 = 智能重命名冲突(目标语言, &冲突项, &禁用词表)?;
        应用改名(输出目录, &改名表, 目标语言)?;
    }
    // 重试后仍可能有残留冲突：输出最终报告供人工处理
    让 视图 = 从三方库目录构建视图(输出目录, 源视图);
    让 报告值 = 校验语言包(&视图);
    如果 !报告值.是否通过() {
        打印报告(目标语言, &报告值);
        打印行!("{}", 界面表.取带参消息("mc_scaffold_ai_retry_left", &[目标语言]));
    } 否则 {
        打印行!("{}", 界面表.取消息("mc_ok"));
    }
    成功(())
}

/// 扫描输出目录中含目标语言待办标记的行，返回（文件名, 键, 英文值）
函数 收集待办键(
    输出目录: &路径类型,
    目标语言: &文本,
) -> 错误处理::结果<向量<(字符串, 字符串, 字符串)>> {
    让 可变 项列表 = 向量::新建();
    让 待办标记 = 格式化!("TODO({})", 目标语言);
    对于 目录条目 在 列出配置清单(输出目录)? {
        让 文件本名 = 目录条目
            .取文件名()
            .而后映射(|本名| 本名.取字符串引用())
            .取值或默认()
            .转字符串();
        让 内容文本 = 标准库::文件系统::读取全部字符串(&目录条目)?;
        对于 行文本 在 内容文本.逐行() {
            如果 !行文本.包含(&待办标记) {
                继续;
            }
            如果让 有值((键名, 值项)) = 解析键值行(行文本) {
                项列表.推入((文件本名.克隆值(), 键名, 值项));
            }
        }
    }
    成功(项列表)
}

/// 列出目录下的配置文本（按名排序保证确定性）
函数 列出配置清单(目录值: &路径类型) -> 错误处理::结果<向量<路径缓冲>> {
    让 可变 文件清单: 向量<路径缓冲> = 标准库::文件系统::读取目录(目录值)?
        .过滤映射(|目录条目| 目录条目.转选项())
        .映射(|目录条目| 目录条目.条目路径())
        .过滤(|路径值| {
            路径值.取扩展名().而后映射(|后缀| 后缀.取字符串引用()) == 有值("toml")
        })
        .收集();
    文件清单.排序();
    成功(文件清单)
}

/// 解析 `"键" = "值" ...` 行，返回（键, 值）
///
/// 键与值均支持转义引号（`\"`），避免在转义处错误截断。
函数 解析键值行(行文本: &文本) -> 选项<(字符串, 字符串)> {
    让 裁剪行 = 行文本.裁剪();
    让 (键部分, 值部分) = 裁剪行.分割一次('=')?;
    让 键名 = 解析引号内容(键部分.裁剪())?;
    让 值项 = 解析引号内容(值部分.裁剪())?;
    有值((键名, 值项))
}

/// 解析带转义的引号内容：剥离前缀引号后逐字符扫描，
/// 转义序列取下一字符原样保留，遇未转义引号即结束
函数 解析引号内容(片段: &文本) -> 选项<字符串> {
    让 内部文本 = 片段.去前缀('"')?;
    让 可变 输出文本 = 字符串::新建();
    让 可变 字符流 = 内部文本.逐字符();
    当让 有值(单字) = 字符流.下一个() {
        如果 单字 == '\\' {
            // 转义序列：取下一个字符原样保留
            如果让 有值(下一字) = 字符流.下一个() {
                输出文本.推入(下一字);
            }
        } 否则 如果 单字 == '"' {
            // 未转义的引号：内容结束
            中断;
        } 否则 {
            输出文本.推入(单字);
        }
    }
    有值(输出文本)
}

/// 调用智能服务批量翻译键名，返回 源键→目标语言键
函数 智能翻译键(
    源语言: &文本,
    目标语言: &文本,
    项列表: &[(字符串, 字符串)],
    禁用词表: &[字符串],
    已用词: &[字符串],
) -> 错误处理::结果<哈希映射<字符串, 字符串>> {
    让 系统提示 = "You are a programming terminology translation engine for a \
Rust teaching dialect. Translate mapping keys from the source language into the \
target language. Rules:\n\
1. Output ONLY a JSON object {\"source_key\": \"translated_key\"}, no explanation.\n\
2. Translations must be natural programming terms in the target language.\n\
3. Never reuse words from the forbidden list (language keywords) or the used list.\n\
4. Different source keys must map to different translations.\n\
5. Keep the same style as existing pack keys (single word or short phrase).";
    让 键清单 = 项列表
        .迭代()
        .映射(|(键名, 值项)| 格式化!("{} = {}", 键名, 值项))
        .收集::<向量<_>>()
        .连接("\n");
    让 用户提示 = 格式化!(
        "source language: {}\ntarget language: {}\nforbidden words: {}\n\
used words: {}\nkeys to translate (key = its English API):\n{}",
        源语言,
        目标语言,
        禁用词表.连接(", "),
        已用词.连接(", "),
        键清单
    );
    让 内容文本 = 包::映射生成::智能对话(系统提示, &用户提示)?;
    解析结构化映射(&内容文本)
}

/// 从校验报告提取冲突项（文件名, 键），供改名重试
函数 收集冲突项(报告值: &校验报告, 输出目录: &路径类型) -> 向量<(字符串, 字符串)> {
    让 可变 项列表: 向量<(字符串, 字符串)> = 向量::新建();
    对于 错误项 在 &报告值.错误列表 {
        让 片段表: 向量<&文本> = 错误项.分割('|').收集();
        匹配 片段表.第一个().复制值() {
            有值("mc_keyword_collision") 如果 片段表.长度() >= 4 => {
                项列表.推入((片段表[1].转字符串(), 片段表[3].转字符串()));
            }
            有值("mc_cross_conflict") 如果 片段表.长度() >= 6 => {
                让 键名 = 片段表[1];
                项列表.推入((片段表[2].转字符串(), 键名.转字符串()));
                项列表.推入((片段表[4].转字符串(), 键名.转字符串()));
            }
            有值("mc_cross_conflict_mp") 如果 片段表.长度() >= 6 => {
                让 键名 = 片段表[1];
                项列表.推入((片段表[2].转字符串(), 键名.转字符串()));
                项列表.推入((片段表[4].转字符串(), 键名.转字符串()));
            }
            _ => {}
        }
    }
    // 去重并确认文件仍存在
    项列表.保留(|(文件本名, _)| 输出目录.连接(文件本名).是否为文件());
    项列表.排序();
    项列表.去重();
    项列表
}

/// 调用智能服务为冲突键改名，返回（文件名, 旧键）→新键
函数 智能重命名冲突(
    目标语言: &文本,
    项列表: &[(字符串, 字符串)],
    禁用词表: &[字符串],
) -> 错误处理::结果<哈希映射<(字符串, 字符串), 字符串>> {
    让 系统提示 = "You rename conflicting mapping keys of a Rust teaching \
dialect language pack. Rules:\n\
1. Output ONLY a JSON object {\"file|key\": \"new_key\"}, no explanation.\n\
2. New keys must be multi-word terms in the target language, avoiding the forbidden \
list and all other existing keys.\n\
3. Keep the technical meaning of the original key.";
    让 清单 = 项列表
        .迭代()
        .映射(|(文件本名, 键名)| 格式化!("{}|{}", 文件本名, 键名))
        .收集::<向量<_>>()
        .连接("\n");
    让 用户提示 = 格式化!(
        "target language: {}\nforbidden words: {}\n\
conflicting entries (file|key) to rename:\n{}",
        目标语言,
        禁用词表.连接(", "),
        清单
    );
    让 内容文本 = 包::映射生成::智能对话(系统提示, &用户提示)?;
    让 原始映射 = 解析结构化映射(&内容文本)?;
    让 可变 改名表 = 哈希映射::新建();
    对于 (组合键, 新键名) 在 原始映射 {
        如果让 有值((文件本名, 旧键名)) = 组合键.分割一次('|') {
            改名表.置入(
                (文件本名.转字符串(), 旧键名.转字符串()),
                新键名,
            );
        }
    }
    成功(改名表)
}

/// 解析智能服务返回文本中的 JSON 对象（容忍 ```json 围栏与前后杂讯）
函数 解析结构化映射(文本串: &文本) -> 错误处理::结果<哈希映射<字符串, 字符串>> {
    让 起始位 = 文本串
        .查找('{')
        .缺值转错(|| 错误处理!("AI 返回中未找到 JSON 对象"))?;
    让 终位 = 文本串[起始位..]
        .反向查找('}')
        .映射(|位置值| 起始位 + 位置值 + 1)
        .缺值转错(|| 错误处理!("AI 返回的 JSON 不完整"))?;
    让 值对象: JSON序列化::JSON值 = JSON序列化::解析字符串(&文本串[起始位..终位])?;
    让 可变 映射表 = 哈希映射::新建();
    如果让 有值(对象表) = 值对象.作为对象() {
        对于 (键名, 值项) 在 对象表 {
            如果让 有值(内容值) = 值项.作为字符串()
                && !键名.是否为空()
                && !内容值.是否为空()
            {
                映射表.置入(键名.克隆值(), 内容值.转字符串());
            }
        }
    }
    成功(映射表)
}

/// 将翻译结果写回：替换待办行的键并移除待办注释；未命中键保留待人工
函数 应用翻译(
    输出目录: &路径类型,
    翻译表: &哈希映射<字符串, 字符串>,
    目标语言: &文本,
) -> 错误处理::结果<无符号机器整数> {
    让 可变 替换数 = 0;
    让 待办标记 = 格式化!("TODO({})", 目标语言);
    对于 目录条目 在 列出配置清单(输出目录).取值或默认() {
        让 内容文本 = 匹配 标准库::文件系统::读取全部字符串(&目录条目) {
            成功(文本串) => 文本串,
            错误(_) => 继续,
        };
        让 可变 输出文本 = 字符串::新建();
        对于 行文本 在 内容文本.逐行() {
            如果 行文本.包含(&待办标记)
                && 让 有值((键名, 值项)) = 解析键值行(行文本)
                && 让 有值(新键名) = 翻译表.获取(&键名)
            {
                // 重写为无待办的行（丢弃原行尾注释中的待办部分）
                输出文本.推入字符串(&格式化!("\"{}\" = \"{}\"\n", 新键名, 值项));
                替换数 += 1;
                继续;
            }
            输出文本.推入字符串(行文本);
            输出文本.推入('\n');
        }
        // 写回失败必须上抛（此前静默吞掉会让用户看到成功但文件未更新）
        标准库::文件系统::写入(&目录条目, 输出文本).映射错误(|错误值| {
            错误处理!("翻译结果写回失败: {}: {}", 目录条目.展示(), 错误值)
        })?;
    }
    成功(替换数)
}

/// 按（文件名, 旧键）精确改名（冲突重试轮次用）
函数 应用改名(
    输出目录: &路径类型,
    改名表: &哈希映射<(字符串, 字符串), 字符串>,
    目标语言: &文本,
) -> 错误处理::结果<空> {
    对于 目录条目 在 列出配置清单(输出目录).取值或默认() {
        让 文件本名 = 目录条目
            .取文件名()
            .而后映射(|本名| 本名.取字符串引用())
            .取值或默认()
            .转字符串();
        让 内容文本 = 匹配 标准库::文件系统::读取全部字符串(&目录条目) {
            成功(文本串) => 文本串,
            错误(_) => 继续,
        };
        让 可变 输出文本 = 字符串::新建();
        对于 行文本 在 内容文本.逐行() {
            让 可变 已写入 = 假;
            如果让 有值((键名, 值项)) = 解析键值行(行文本)
                && 让 有值(新键名) = 改名表.获取(&(文件本名.克隆值(), 键名.克隆值()))
            {
                让 后缀 = 如果 行文本.包含(&格式化!("TODO({})", 目标语言)) {
                    字符串::新建()
                } 否则 {
                    // 保留原有行尾注释（非待办部分）
                    行文本
                        .分割('#')
                        .取第项(1)
                        .映射(|注释文本| 格式化!("  # {}", 注释文本.裁剪()))
                        .取值或默认()
                };
                输出文本.推入字符串(&格式化!("\"{}\" = \"{}\"{}\n", 新键名, 值项, 后缀));
                已写入 = 真;
            }
            如果 !已写入 {
                输出文本.推入字符串(行文本);
                输出文本.推入('\n');
            }
        }
        标准库::文件系统::写入(&目录条目, 输出文本).映射错误(|错误值| {
            错误处理!("改名结果写回失败: {}: {}", 目录条目.展示(), 错误值)
        })?;
    }
    成功(())
}

/// 从已生成的三方库目录构造校验视图（关键字/标准库取自源包）
函数 从三方库目录构建视图(三方库目录: &路径类型, 源视图: &语言包视图) -> 语言包视图 {
    让 可变 三方库表 = 向量::新建();
    对于 目录条目 在 列出配置清单(三方库目录).取值或默认() {
        让 文件本名 = 目录条目
            .取文件名()
            .而后映射(|本名| 本名.取字符串引用())
            .解包或用("unknown.toml")
            .转字符串();
        如果让 成功(内容文本) = 标准库::文件系统::读取全部字符串(&目录条目) {
            三方库表.推入((文件本名, 内容文本));
        }
    }
    // 目标语言包目录（三方库的父目录）若已有关键字/标准库则优先用它们
    让 语言包目录 = 三方库目录.父目录().映射(|路径值| 路径值.转路径缓冲());
    让 关键字内容 = 语言包目录
        .作为引用方法()
        .映射(|目录值| {
            标准库::文件系统::读取全部字符串(目录值.连接("keywords.toml")).取值或默认()
        })
        .过滤(|内容值| !内容值.是否为空())
        .解包或用否则(|| 源视图.关键字内容.克隆值());
    让 标准库内容 = 语言包目录
        .作为引用方法()
        .映射(|目录值| {
            标准库::文件系统::读取全部字符串(目录值.连接("stdlib.toml")).取值或默认()
        })
        .过滤(|内容值| !内容值.是否为空())
        .解包或用否则(|| 源视图.标准库内容.克隆值());
    让 错误内容 = 语言包目录
        .作为引用方法()
        .映射(|目录值| {
            标准库::文件系统::读取全部字符串(目录值.连接("errors.toml")).取值或默认()
        })
        .过滤(|内容值| !内容值.是否为空())
        .解包或用否则(|| 源视图.错误内容.克隆值());
    语言包视图 {
        语言代码: 三方库目录
            .父目录()
            .而后映射(|路径值| 路径值.取文件名())
            .而后映射(|本名| 本名.取字符串引用())
            .解包或用("unknown")
            .转字符串(),
        关键字内容,
        标准库内容,
        错误内容,
        三方库表,
    }
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    /// 构造最小视图用于测试
    函数 视图含三方库(三方库表: 向量<(&文本, &文本)>) -> 语言包视图 {
        语言包视图 {
            语言代码: "zh".转字符串(),
            // 含全部必需节：本组用例聚焦三方库冲突检测，
            // 缺节会额外触发缺节错误干扰断言
            关键字内容: 拼接!(
                "[\"声明\"]\n\"函数\" = \"fn\"\n\"让\" = \"let\"\n",
                "[\"控制流\"]\n[\"类型\"]\n[\"逻辑值\"]\n[\"特殊值\"]\n[\"内存\"]\n",
                "[\"不安全\"]\n[\"错误处理\"]\n[\"宏\"]\n[\"派生特征\"]\n[\"标准库成员\"]\n",
            )
            .转字符串(),
            标准库内容: "[\"标识符\"]\n\"字符串\" = \"String\"\n".转字符串(),
            错误内容: 字符串::新建(),
            三方库表: 三方库表
                .消费迭代()
                .映射(|(包名, 内容串)| (包名.转字符串(), 内容串.转字符串()))
                .收集(),
        }
    }

    /// 正常映射通过校验
    #[测试]
    函数 测试干净映射通过() {
        让 视图 = 视图含三方库(向量![(
            "a.toml",
            "[\"标识符\"]\n\"服务器\" = \"Server\"\n\"路由\" = \"Router\"\n",
        )]);
        让 报告值 = 校验语言包(&视图);
        断言!(报告值.是否通过(), "干净映射应通过: {:?}", 报告值.错误列表);
        断言相等!(报告值.统计.标识符条目数, 2);
        断言相等!(报告值.统计.包文件数, 1);
    }

    /// 危险等级校验：会恐慌的目标标成纯安全必须报错
    ///
    /// 回归保护（「要恐慌必须显式写」）：映射到解包类目标的词条
    /// 若标成纯安全，调用方会当默认路径使用，运行即崩。
    #[测试]
    函数 测试危险等级漏标恐慌() {
        让 视图 = 视图含三方库(向量![(
            "a.toml",
            r#"
["标识符"]
"取列" = "get_unwrap"

["危险等级"]
"取列" = "safe"
"#,
        )]);
        让 报告值 = 校验语言包(&视图);
        断言!(
            报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_danger_understated|a.toml|取列")),
            "恐慌目标标成纯安全必须报错: {:?}",
            报告值.错误列表
        );
    }

    /// 危险等级校验：关键字/宏词条默认改写，显式标纯安全也不得降级
    #[测试]
    函数 测试危险等级关键字漏标改写() {
        让 视图 = 语言包视图 {
            语言代码: "zh".转字符串(),
            关键字内容: r#"
["声明"]
"函数" = "fn"
["控制流"]
["类型"]
["逻辑值"]
["特殊值"]
["内存"]
["不安全"]
["错误处理"]
["宏"]
["派生特征"]
["标准库成员"]

["危险等级"]
"函数" = "safe"
"#
            .转字符串(),
            标准库内容: 字符串::新建(),
            错误内容: 字符串::新建(),
            三方库表: 向量::新建(),
        };
        让 报告值 = 校验语言包(&视图);
        断言!(
            报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_danger_understated_rewrite|keywords.toml|函数")),
            "关键字标成纯安全必须报错: {:?}",
            报告值.错误列表
        );
    }

    /// 危险等级校验：非法值与孤立元数据都要报错
    ///
    /// 拼写错误会让整条标注静默失效；词条改名后旧标注同样
    /// 静默失效——两者都不能只靠人工审查。
    #[测试]
    函数 测试危险等级非法与孤立() {
        让 视图 = 视图含三方库(向量![(
            "a.toml",
            r#"
["标识符"]
"服务器" = "Server"

["危险等级"]
"服务器" = "panik"
"已改名" = "panic"
"#,
        )]);
        让 报告值 = 校验语言包(&视图);
        断言!(
            报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_danger_invalid|a.toml|服务器|panik")),
            "非法等级值应报错: {:?}",
            报告值.错误列表
        );
        断言!(
            报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_danger_orphan|a.toml|已改名")),
            "孤立元数据应报错: {:?}",
            报告值.错误列表
        );
    }

    /// 缺少必需节报错误（缺节不报错但整类词条静默失效）
    ///
    /// 回归：缺「宏」节时宏映射返回空表，宏调用不再自动补 `!`，
    /// 产物非法却仍显示「转译成功」——最难排查的一类静默降级。
    #[测试]
    函数 测试缺必需节() {
        让 视图 = 语言包视图 {
            语言代码: "xx".转字符串(),
            // 仅保留「声明」与「宏」，缺少其余必需节
            关键字内容: "[\"声明\"]\n\"函数\" = \"fn\"\n[\"宏\"]\n\"打印行\" = \"println\"\n"
                .转字符串(),
            标准库内容: 字符串::新建(),
            错误内容: 字符串::新建(),
            三方库表: 向量::新建(),
        };
        让 报告值 = 校验语言包(&视图);
        断言!(!报告值.是否通过(), "缺必需节应校验失败");
        让 缺失节: 向量<&字符串> = 报告值
            .错误列表
            .迭代()
            .过滤(|错误项| 错误项.以开头("mc_missing_section"))
            .收集();
        断言相等!(缺失节.长度(), 必需关键字节.长度() - 2, "应报出全部缺失节");
        断言!(
            缺失节.迭代().任意(|错误项| 错误项.以结尾("|派生特征")),
            "缺「派生特征」应被检出: {缺失节:?}"
        );
        // 含全部必需节的视图不应报缺节
        让 完整 = 视图含三方库(向量::新建());
        断言!(
            !校验语言包(&完整)
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_missing_section")),
            "节齐全时不应报缺节"
        );
    }

    /// 关键字配置解析失败（重复键）报错误：关键字表整体失效
    #[测试]
    函数 测试关键字解析失败() {
        让 视图 = 语言包视图 {
            语言代码: "xx".转字符串(),
            // 同一节内重复键 → 配置解析失败
            关键字内容: "[\"声明\"]\n\"函数\" = \"fn\"\n\"函数\" = \"fn2\"\n".转字符串(),
            标准库内容: 字符串::新建(),
            错误内容: 字符串::新建(),
            三方库表: 向量::新建(),
        };
        让 报告值 = 校验语言包(&视图);
        断言!(
            报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_parse_failed|keywords.toml")),
            "关键字配置重复键应报解析失败: {:?}",
            报告值.错误列表
        );
    }

    /// 三方库键与关键字键相撞报错误
    #[测试]
    函数 测试关键字冲突() {
        让 视图 = 视图含三方库(向量![(
            "a.toml",
            "[\"标识符\"]\n\"函数\" = \"some_fn\"\n", // 「函数」是关键字
        )]);
        让 报告值 = 校验语言包(&视图);
        断言!(!报告值.是否通过());
        断言!(
            报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_keyword_collision"))
        );
    }

    /// 三方库文件之间同键不同值报错误
    #[测试]
    函数 测试跨文件冲突() {
        让 视图 = 视图含三方库(向量![
            ("a.toml", "[\"标识符\"]\n\"连接\" = \"connect_a\"\n"),
            ("b.toml", "[\"标识符\"]\n\"连接\" = \"connect_b\"\n"),
        ]);
        让 报告值 = 校验语言包(&视图);
        断言!(!报告值.是否通过());
        断言!(
            报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_cross_conflict"))
        );
    }

    /// 三方库文件之间同键同值不报错
    #[测试]
    函数 测试跨文件同值通过() {
        让 视图 = 视图含三方库(向量![
            ("a.toml", "[\"标识符\"]\n\"连接\" = \"connect\"\n"),
            ("b.toml", "[\"标识符\"]\n\"连接\" = \"connect\"\n"),
        ]);
        让 报告值 = 校验语言包(&视图);
        断言!(
            !报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_cross_conflict")),
            "同键同值不应报冲突: {:?}",
            报告值.错误列表
        );
    }

    /// 三方库键与标准库标识符同键不同值报警告（不阻断）
    #[测试]
    函数 测试标准库覆盖警告() {
        让 视图 = 视图含三方库(向量![(
            "a.toml",
            "[\"标识符\"]\n\"字符串\" = \"MyString\"\n", // 标准库中「字符串」词条指向字符串类型名
        )]);
        让 报告值 = 校验语言包(&视图);
        断言!(报告值.是否通过(), "标准库覆盖只是警告不阻断");
        断言!(
            报告值
                .警告列表
                .迭代()
                .任意(|警告项| 警告项.以开头("mc_stdlib_shadow"))
        );
    }

    /// 重复键导致配置解析失败，报错误
    #[测试]
    函数 测试重复键解析错误() {
        让 视图 = 视图含三方库(向量![(
            "a.toml",
            "[\"标识符\"]\n\"连接\" = \"connect\"\n\"连接\" = \"link\"\n",
        )]);
        让 报告值 = 校验语言包(&视图);
        断言!(!报告值.是否通过());
        断言!(
            报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_parse_failed"))
        );
    }

    /// 标准库配置解析失败（重复键）报错误，不再静默吞掉
    #[测试]
    函数 测试标准库解析失败() {
        让 视图 = 语言包视图 {
            语言代码: "zh".转字符串(),
            关键字内容: "[\"声明\"]\n\"函数\" = \"fn\"\n".转字符串(),
            标准库内容: "[\"标识符\"]\n\"连接\" = \"link\"\n\"连接\" = \"net\"\n".转字符串(),
            错误内容: 字符串::新建(),
            三方库表: 向量![(
                "a.toml".转字符串(),
                "[\"标识符\"]\n\"服务器\" = \"Server\"\n".转字符串(),
            )],
        };
        让 报告值 = 校验语言包(&视图);
        断言!(
            报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_stdlib_parse_failed")),
            "标准库解析失败应报错误: {:?}",
            报告值.错误列表
        );
    }

    /// 无标准库文件（空内容）不应误报解析失败
    #[测试]
    函数 测试空标准库不误报() {
        让 视图 = 语言包视图 {
            语言代码: "zh".转字符串(),
            关键字内容: "[\"声明\"]\n\"函数\" = \"fn\"\n".转字符串(),
            标准库内容: 字符串::新建(),
            错误内容: 字符串::新建(),
            三方库表: 向量![(
                "a.toml".转字符串(),
                "[\"标识符\"]\n\"服务器\" = \"Server\"\n".转字符串(),
            )],
        };
        让 报告值 = 校验语言包(&视图);
        断言!(
            !报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_stdlib_parse_failed")),
            "空标准库不应误报: {:?}",
            报告值.错误列表
        );
    }

    /// 模块路径节跨文件同键不同值报错误（与标识符节对称）
    #[测试]
    函数 测试模块路径跨文件冲突() {
        让 视图 = 视图含三方库(向量![
            ("a.toml", "[\"模块路径\"]\n\"网络库\" = \"reqwest\"\n"),
            ("b.toml", "[\"模块路径\"]\n\"网络库\" = \"hyper\"\n"),
        ]);
        让 报告值 = 校验语言包(&视图);
        断言!(
            报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_cross_conflict_mp")),
            "模块路径跨文件冲突应报错误: {:?}",
            报告值.错误列表
        );
    }

    /// 模块路径节跨文件同键同值不报错
    #[测试]
    函数 测试模块路径跨文件同值通过() {
        让 视图 = 视图含三方库(向量![
            ("a.toml", "[\"模块路径\"]\n\"网络库\" = \"reqwest\"\n"),
            ("b.toml", "[\"模块路径\"]\n\"网络库\" = \"reqwest\"\n"),
        ]);
        让 报告值 = 校验语言包(&视图);
        断言!(
            !报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_cross_conflict_mp")),
            "模块路径同键同值不应报冲突: {:?}",
            报告值.错误列表
        );
    }

    /// 同一文件内双节同键不同值（模块路径为三方库名、标识符为类型名）
    /// 是合法设计，不应报错
    #[测试]
    函数 测试双节同键不同值通过() {
        让 视图 = 视图含三方库(向量![(
            "a.toml",
            "[\"模块路径\"]\n\"火箭\" = \"rocket\"\n[\"标识符\"]\n\"火箭\" = \"Rocket\"\n",
        )]);
        让 报告值 = 校验语言包(&视图);
        断言!(
            报告值.是否通过(),
            "双节同键不同值（包名/类型名）应通过: {:?}",
            报告值.错误列表
        );
    }

    /// 骨架为键值行追加待办注释，节标题与注释保留
    #[测试]
    函数 测试骨架追加待办() {
        让 内容文本 = "[\"标识符\"]\n# 注释行\n\"服务器\" = \"Server\"\n";
        让 结果值 = 追加骨架待办(内容文本, "zh", "vi");
        断言!(结果值.包含("TODO(vi)"));
        断言!(结果值.包含("# 注释行"));
        断言!(结果值.包含("\"服务器\" = \"Server\""));
    }

    /// 内置中文包自检：历史冲突已清理，校验应完全通过。
    #[测试]
    函数 测试内置中文包通过() {
        让 视图 = 语言包视图::从内置("zh");
        让 报告值 = 校验语言包(&视图);
        // 工具正常运行，统计数据合理（包数动态取内置清单，随语言包目录自动纳入）
        断言相等!(
            报告值.统计.包文件数,
            包::内置语言::获取内置数据("zh").三方库数据.长度()
        );
        断言!(报告值.统计.标识符条目数 > 0);
        // 历史冲突（关键字避让/跨文件同键不同值）已清理完毕
        断言!(
            报告值.是否通过(),
            "内置 zh 包应无错误: {:?}",
            报告值.错误列表
        );
    }

    /// 各内置语言的标识符条目数均可统计
    #[测试]
    函数 测试各语言条目数() {
        对于 语言代码 在 ["zh", "ru", "de"] {
            让 视图 = 语言包视图::从内置(语言代码);
            让 报告值 = 校验语言包(&视图);
            断言!(报告值.统计.标识符条目数 > 0, "{语言代码} 应有条目");
        }
    }

    /// 全部内置语言均应通过校验（持续集成门禁的测试层基线）
    #[测试]
    函数 测试全部内置语言通过() {
        对于 语言代码 在 包::内置语言::内置语言清单() {
            让 视图 = 语言包视图::从内置(语言代码);
            让 报告值 = 校验语言包(&视图);
            断言!(
                报告值.是否通过(),
                "内置包 {语言代码} 应通过校验: {:?}",
                报告值.错误列表
            );
        }
    }

    /// 键值行解析：提取引号内键与值，忽略行尾注释
    #[测试]
    函数 测试解析键值行() {
        让 (键名, 值项) =
            解析键值行("\"服务器\" = \"Server\"  # TODO(vi): 将键从 zh 翻译").解包();
        断言相等!(键名, "服务器");
        断言相等!(值项, "Server");
        断言!(解析键值行("# 注释行").是否为无());
        断言!(解析键值行("[\"标识符\"]").是否为无());
    }

    /// 键与值两侧的转义引号都应正确还原（此前键侧不处理转义）
    #[测试]
    函数 测试解析键值行转义引号() {
        让 (键名, 值项) = 解析键值行("\"foo\\\"bar\" = \"va\\\"lue\"").解包();
        断言相等!(键名, "foo\"bar");
        断言相等!(值项, "va\"lue");
    }

    /// 智能服务返回 JSON 解析：容忍围栏与杂讯，丢弃空条目
    #[测试]
    函数 测试解析结构化映射() {
        让 文本串 =
            "好的，以下是翻译结果：\n```json\n{\"服务器\": \"Máy chủ\", \"空\": \"\"}\n```\n";
        让 映射表 = 解析结构化映射(文本串).解包();
        断言相等!(映射表.获取("服务器").解包(), "Máy chủ");
        断言!(!映射表.包含键("空"), "空值条目应丢弃");
        断言!(解析结构化映射("没有任何 JSON").是否为错误());
    }

    /// 待办键提取 + 翻译写回：替换键并移除待办标记，未命中键保留
    #[测试]
    函数 测试收集与应用翻译() {
        让 目录值 = 临时文件::建临时目录().解包();
        让 文件路径 = 目录值.条目路径().连接("a.toml");
        标准库::文件系统::写入(
            &文件路径,
            "[\"标识符\"]\n\"服务器\" = \"Server\"  # TODO(vi): 将键从 zh 翻译\n\
             \"路由\" = \"Router\"  # TODO(vi): 将键从 zh 翻译\n",
        )
        .解包();

        让 项列表 = 收集待办键(目录值.条目路径(), "vi").解包();
        断言相等!(项列表.长度(), 2);
        断言相等!(项列表[0].1, "服务器");

        让 可变 翻译表 = 哈希映射::新建();
        翻译表.置入("服务器".转字符串(), "Máy chủ".转字符串());
        让 替换数 = 应用翻译(目录值.条目路径(), &翻译表, "vi").解包();
        断言相等!(替换数, 1);

        让 内容文本 = 标准库::文件系统::读取全部字符串(&文件路径).解包();
        断言!(内容文本.包含("\"Máy chủ\" = \"Server\""));
        断言!(
            !内容文本.包含("Máy chủ\" = \"Server\"  # TODO"),
            "已译键不应带待办"
        );
        断言!(内容文本.包含("TODO(vi)"), "未命中键应保留待办");
    }

    /// 冲突项提取：关键字冲突与跨文件冲突均能定位到（文件, 键）
    #[测试]
    函数 测试收集冲突项() {
        让 目录值 = 临时文件::建临时目录().解包();
        标准库::文件系统::写入(目录值.条目路径().连接("a.toml"), "").解包();
        标准库::文件系统::写入(目录值.条目路径().连接("b.toml"), "").解包();
        让 可变 报告值 = 校验报告::默认值();
        报告值
            .错误列表
            .推入("mc_keyword_collision|a.toml|标识符|错误|bail|Err".转字符串());
        报告值
            .错误列表
            .推入("mc_cross_conflict|连接|a.toml|join|b.toml|Connection".转字符串());
        让 项列表 = 收集冲突项(&报告值, 目录值.条目路径());
        断言!(项列表.包含(&("a.toml".转字符串(), "错误".转字符串())));
        断言!(项列表.包含(&("a.toml".转字符串(), "连接".转字符串())));
        断言!(项列表.包含(&("b.toml".转字符串(), "连接".转字符串())));
    }

    /// 按文件精确改名：保留行尾注释，仅替换目标键
    #[测试]
    函数 测试应用改名() {
        让 目录值 = 临时文件::建临时目录().解包();
        让 文件路径 = 目录值.条目路径().连接("a.toml");
        标准库::文件系统::写入(
            &文件路径,
            "\"连接\" = \"join\"\n\"其他\" = \"other\"  # 注释保留\n",
        )
        .解包();
        让 可变 改名表 = 哈希映射::新建();
        改名表.置入(
            ("a.toml".转字符串(), "连接".转字符串()),
            "连接等待".转字符串(),
        );
        应用改名(目录值.条目路径(), &改名表, "vi").解包();
        让 内容文本 = 标准库::文件系统::读取全部字符串(&文件路径).解包();
        断言!(内容文本.包含("\"连接等待\" = \"join\""));
        断言!(内容文本.包含("\"其他\" = \"other\"  # 注释保留"));
    }

    // ---------- 跨语言完整性检查 ----------

    /// 构造含完整关键字/错误数据的视图（zh 基准样）
    函数 视图含语言数据(语言代码: &文本, 关键字文本: &文本, 错误文本: &文本) -> 语言包视图 {
        语言包视图 {
            语言代码: 语言代码.转字符串(),
            关键字内容: 关键字文本.转字符串(),
            标准库内容: 字符串::新建(),
            错误内容: 错误文本.转字符串(),
            三方库表: 向量::新建(),
        }
    }

    常量 基础关键字: &文本 =
        "[\"声明\"]\n\"函数\" = \"fn\"\n\"让\" = \"let\"\n[\"派生特征\"]\n\"克隆\" = \"Clone\"\n";
    常量 基础错误: &文本 = "[E0425]\n\"消息模板\" = \"x\"\n\"教学提示\" = \"y\"\n[\"消息翻译\"]\n\"mismatched types\" = { \"消息模板\" = \"t\" }\n";

    /// 语言包完整时跨语言检查通过
    #[测试]
    函数 测试跨语言对完整() {
        让 基准 = 视图含语言数据("zh", 基础关键字, 基础错误);
        让 目标 = 视图含语言数据("ja", 基础关键字, 基础错误);
        让 报告值 = 校验跨语言对(&基准, &目标);
        断言!(报告值.是否通过(), "完整包应通过: {:?}", 报告值.错误列表);
        断言!(报告值.警告列表.是否为空(), "无警告: {:?}", 报告值.警告列表);
    }

    /// 缺少派生特征节报错误（方言特性不可用）
    #[测试]
    函数 测试跨语言缺派生() {
        让 基准 = 视图含语言数据("zh", 基础关键字, 基础错误);
        让 目标 = 视图含语言数据(
            "ja",
            "[\"声明\"]\n\"函数\" = \"fn\"\n\"让\" = \"let\"\n",
            基础错误,
        );
        让 报告值 = 校验跨语言对(&基准, &目标);
        断言!(
            报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_cross_derive_missing")),
            "缺派生特征应报错误: {:?}",
            报告值.错误列表
        );
    }

    /// 缺少关键字值报错误（方言词不可用）
    #[测试]
    函数 测试跨语言缺关键字() {
        让 基准 = 视图含语言数据("zh", 基础关键字, 基础错误);
        让 目标 = 视图含语言数据(
            "ja",
            "[\"声明\"]\n\"函数\" = \"fn\"\n\"让\" = \"let\"\n[\"派生特征\"]\n\"克隆\" = \"Clone\"\n",
            基础错误,
        );
        // 与基准语言相同的母语键（值相同），故意改成不同的值
        让 报告值 = 校验跨语言对(&基准, &目标);
        // 该用例下目标与基准值集合一致，应通过
        断言!(报告值.是否通过());
        // 缺少某个关键字值的情况
        让 贫乏 = 视图含语言数据(
            "ja",
            "[\"声明\"]\n\"函数\" = \"fn\"\n[\"派生特征\"]\n\"克隆\" = \"Clone\"\n",
            基础错误,
        );
        让 报告值 = 校验跨语言对(&基准, &贫乏);
        断言!(
            报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_cross_kw_missing")),
            "缺关键字值应报错误: {:?}",
            报告值.错误列表
        );
    }

    /// 缺少错误码节报错误，缺消息翻译键报警告
    #[测试]
    函数 测试跨语言缺错误() {
        让 基准 = 视图含语言数据("zh", 基础关键字, 基础错误);
        // 缺错误码节 E0425
        让 目标 = 视图含语言数据(
            "ja",
            基础关键字,
            "[\"消息翻译\"]\n\"mismatched types\" = { \"消息模板\" = \"t\" }\n",
        );
        让 报告值 = 校验跨语言对(&基准, &目标);
        断言!(
            报告值
                .错误列表
                .迭代()
                .任意(|错误项| 错误项.以开头("mc_cross_err_missing")),
            "缺错误码节应报错误: {:?}",
            报告值.错误列表
        );
        // 缺消息翻译键
        让 目标 = 视图含语言数据(
            "ja",
            基础关键字,
            "[E0425]\n\"消息模板\" = \"x\"\n\"教学提示\" = \"y\"\n",
        );
        让 报告值 = 校验跨语言对(&基准, &目标);
        断言!(报告值.是否通过(), "缺消息翻译键不应阻断: {:?}", 报告值.错误列表);
        断言!(
            报告值
                .警告列表
                .迭代()
                .任意(|警告项| 警告项.以开头("mc_cross_msg_missing")),
            "缺消息翻译键应报警告: {:?}",
            报告值.警告列表
        );
    }

    /// 内置全部语言通过跨语言完整性检查（zh 基准）
    #[测试]
    函数 测试全部内置跨语言完整性() {
        让 基准 = 语言包视图::从内置("zh");
        对于 语言代码 在 包::内置语言::内置语言清单() {
            如果 语言代码 == "zh" {
                继续;
            }
            让 视图 = 语言包视图::从内置(语言代码);
            如果 视图.关键字内容.是否为空() && 视图.错误内容.是否为空() {
                继续;
            }
            让 报告值 = 校验跨语言对(&基准, &视图);
            断言!(
                报告值.是否通过(),
                "内置包 {语言代码} 跨语言完整性应通过: {:?}",
                报告值.错误列表
            );
        }
    }

    /// 提取各节：两节正常提取；配置非法（含重复键）返回错误
    #[测试]
    函数 测试提取各节基础与错误() {
        让 (模块路径表, 标识符表) = 提取各节(
            "[\"模块路径\"]\n\"序列化\" = \"serde\"\n[\"标识符\"]\n\"向量\" = \"Vec\"\n",
        )
        .期望("合法配置应解析成功");
        断言相等!(模块路径表.获取("序列化").映射(字符串::作为文本切片), 有值("serde"));
        断言相等!(标识符表.获取("向量").映射(字符串::作为文本切片), 有值("Vec"));
        断言!(提取各节("[\"标识符\"]\n\"a\" = \"1\"\n\"a\" = \"2\"\n").是否为错误());
    }

    /// 报告渲染三分支：干净通过 / 仅警告通过 / 错误失败；
    /// 渲染问题对无参数消息码与未知消息码均不崩溃
    ///
    /// 打印报告三调用只验证「不崩溃」（输出到标准输出，本单元不做捕获），
    /// 真正的不变量在渲染问题的消息码→模板链路上，逐条钉住。
    #[测试]
    函数 测试打印报告全分支() {
        // 渲染问题走全局界面表，语言取自环境变量：这里持环境锁并钉住
        // RZ_LANG=zh，免得用户目录里的界面配置文件或持续集成预设的英文让结果时好时坏
        让 _锁 = 包::语言管理::测试模块::环境锁();
        让 _环境 = 包::语言管理::测试模块::环境还原::接管(&[
            "RZ_LANG",
            "LC_ALL",
            "LC_MESSAGES",
            "LANG",
        ]);
        // Rust 2024：进程级环境变量写入为不安全，由上面的环境锁串行化
        不安全 {
            标准库::环境::设置环境变量("RZ_LANG", "zh");
        }

        让 干净 = 校验报告::默认值();
        打印报告("zh", &干净);
        让 可变 仅警告 = 校验报告::默认值();
        仅警告
            .警告列表
            .推入("mc_stdlib_shadow|a.toml|键|a|b".转字符串());
        打印报告("zh", &仅警告);
        让 可变 失败 = 校验报告::默认值();
        失败
            .错误列表
            .推入("mc_parse_failed|a.toml|重复键".转字符串());
        失败
            .警告列表
            .推入("mc_stdlib_shadow|a.toml|键|a|b".转字符串());
        打印报告("zh", &失败);

        // 以下断言只看「结构」，不比对译文文字：界面文案随语言与系统语言变化，
        // 钉死中文串会让用例在别的区域设置下随机失败。
        // 无 `|` 参数：整串作为消息码查模板，命中时必须拿到译文而不是键名
        断言不等!(渲染问题("mc_ok"), "mc_ok", "mc_ok 应有界面模板");
        断言!(!渲染问题("mc_ok").是否为空(), "模板不得渲染成空串");
        // 带参数：`|` 后的各段要真的进到渲染结果里，否则等于参数被默默丢掉
        让 带参结果 = 渲染问题("mc_ok_with_warnings|3");
        断言不等!(带参结果, "mc_ok_with_warnings", "应有模板而非回退键名");
        断言!(带参结果.包含("3"), "警告数未注入模板：{带参结果:?}");
        让 阴影结果 = 渲染问题("mc_stdlib_shadow|a.toml|键|a|b");
        对于 参数项 在 ["a.toml", "键", "a", "b"] {
            断言!(阴影结果.包含(参数项), "参数 {参数项:?} 被丢弃：{阴影结果:?}");
        }
        // 未知消息码：回退键本身（既不崩溃，也不渲染成空串吞掉整行）
        断言相等!(渲染问题("not_a_real_code|x"), "not_a_real_code");
        // 空串：不崩溃，按模板回退链返回空（分割的首段就是整串）
        断言相等!(渲染问题(""), "");
    }

    /// 骨架：首次写入并带目标语待办注释（英文值保留）；重跑跳过已存在文件
    #[测试]
    函数 测试骨架写入后跳过() {
        让 目录值 = 临时文件::建临时目录().解包();
        让 输出目录 = 目录值.条目路径().连接("fr");
        让 源视图 = 视图含三方库(向量![(
            "a.toml",
            "[\"标识符\"]\n\"服务器\" = \"Server\"\n",
        )]);
        让 (已创建数, 已跳过数) = 生成骨架(&源视图, "fr", &输出目录).期望("首次生成应成功");
        断言相等!((已创建数, 已跳过数), (1, 0));
        让 内容文本 = 标准库::文件系统::读取全部字符串(输出目录.连接("a.toml")).解包();
        断言!(内容文本.包含("TODO(fr)"), "应追加目标语待办：{内容文本}");
        断言!(内容文本.包含("\"Server\""), "英文值必须保留：{内容文本}");
        让 (已创建二, 已跳过二) = 生成骨架(&源视图, "fr", &输出目录).期望("重跑应成功");
        断言相等!((已创建二, 已跳过二), (0, 1), "重跑必须幂等跳过");
    }

    /// 从三方库目录构建视图：目录内关键字/标准库优先；
    /// 缺省时回退源视图（三方库内容始终从目标目录读取）
    #[测试]
    函数 测试视图从三方库目录覆盖与回退() {
        让 源视图 = 视图含三方库(向量![(
            "src.toml",
            "[\"标识符\"]\n\"源\" = \"Src\"\n",
        )]);
        // 覆盖路径：目标目录自带关键字配置
        让 目录值 = 临时文件::建临时目录().解包();
        让 语言包目录 = 目录值.条目路径().连接("de");
        让 三方库目录 = 语言包目录.连接("crates");
        标准库::文件系统::创建所有目录(&三方库目录).解包();
        标准库::文件系统::写入(
            三方库目录.连接("a.toml"),
            "[\"标识符\"]\n\"服务器\" = \"Server\"\n",
        )
        .解包();
        标准库::文件系统::写入(语言包目录.连接("keywords.toml"), "# 自定义关键字\n").解包();
        让 视图 = 从三方库目录构建视图(&三方库目录, &源视图);
        断言相等!(视图.语言代码, "de");
        断言相等!(视图.三方库表.长度(), 1);
        断言相等!(视图.关键字内容, "# 自定义关键字\n");
        // 回退路径：空语言包目录（无三方库、无关键字）→ 回退源视图语言表
        让 目录二 = 临时文件::建临时目录().解包();
        让 语言包目录二 = 目录二.条目路径().连接("xx");
        让 三方库目录二 = 语言包目录二.连接("crates");
        标准库::文件系统::创建所有目录(&三方库目录二).解包();
        让 回退 = 从三方库目录构建视图(&三方库目录二, &源视图);
        断言相等!(回退.语言代码, "xx");
        断言!(回退.三方库表.是否为空());
        断言!(回退.关键字内容.包含("函数"));
    }

    /// 运行检查：内置语言代码走内置视图（zh 干净 → 真）；
    /// 未知目标（非目录非内置）报错；外部目录缺关键字配置报错
    #[测试]
    函数 测试运行检查目标分支() {
        断言!(
            运行检查(有值("zh")).期望("内置 zh 应可校验"),
            "内置 zh 基线必须通过"
        );
        断言!(运行检查(有值("no-such-lang-xyz")).是否为错误());
        让 目录值 = 临时文件::建临时目录().解包();
        断言!(
            运行检查(目录值.条目路径().取字符串引用()).是否为错误(),
            "缺关键字配置应报错"
        );
    }
}
