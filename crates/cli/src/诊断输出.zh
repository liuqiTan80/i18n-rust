//! CLI 侧诊断翻译子系统：cargo/rustc 编译诊断的教学化翻译管线
//!
//! 与 LSP 侧 `response_map/diag_text.rs` 是姊妹职责：从 rustc JSON 诊断
//! 解析 → 教学化翻译（错误消息 + 类型/模块路径中文化）→ 位置回译
//!（英文产物坐标 → 母语源码坐标，含子模块与 `#[path]` 注解行换算）。
//!
//! 供运行与检查子命令共用：单文件项目走 [`运行直接编译`] /
//! [`检查直接编译`] 直调 rustc 快速路径（绕开 cargo 索引开销），
//! 多文件或有依赖的项目回退 cargo（[`翻译进度行`] 翻译进度行、
//! [`翻译编译诊断`] 翻译 JSON 诊断）。
//!
//! 模块边界：本模块只消费转译结果（源码 + 列映射 + 行映射 + 项目上下文），
//! 不负责转译编排（见 `main.rs` 的 `transpile_project_files()` 等）。

使用 包::{
    内置语言, 扩展名转语言代码, 语言管理, 语言包根目录, 解析rustc, 界面, 临时守卫,
};
使用 引擎库::映射管理器::映射管理器;
使用 标准库::集合::{哈希集合, 哈希映射};
使用 标准库::文件系统;
使用 标准库::路径::{路径类型, 路径缓冲};
使用 标准库::进程::命令;

/// 判断是否可单文件直调 rustc：源码目录下仅一个方言文件且 Cargo.toml 无依赖
///
/// 教学单文件项目（仅 main.zh）直调 rustc 绕开 cargo：无索引网络开销、
/// 无需 Cargo.lock 预生成，编译诊断格式与 cargo 完全一致；
/// 多文件（模块声明引用）或有依赖的项目回退 cargo 流程。
公开(包) 函数 可用直接编译(项目根: &路径类型, 源文件: &路径类型) -> 布尔 {
    // 动态方言扩展名（内置 + 用户安装），避免硬编码列表与
    // `rzc lang install` 安装的新语言包脱节（新增语言走不了快速路径）
    让 扩展名序列 = 语言管理::全部可用扩展名();
    让 是方言文件 = |名称: &文本| 扩展名序列.迭代().任意(|单个| 名称.以结尾(&格式化!(".{单个}")));
    // 方言文件计数：源码目录全层级递归（多层模块布局）+ 项目根顶层
    //（教学项目 src/main.zh 为主，项目根也可能放 main.zh）；
    // 超过 1 个视为多文件项目
    让 可变 方言计数 =
        包::收集方言文件(&项目根.连接("src"), &扩展名序列).元素数();
    如果让 成功(目录项集) = 文件系统::读取目录(项目根) {
        对于 目录项 在 目录项集.展平() {
            如果 目录项.文件类型().成功且(|类型值| 类型值.是否为文件()) {
                让 名称 = 目录项.文件名().转有损字符串().转字符串();
                如果 是方言文件(&名称) {
                    方言计数 += 1;
                }
            }
        }
    }
    如果 方言计数 != 1 {
        返回 假;
    }
    // 入口文件必须是 src/main.<方言扩展名>（聚合 main.rs 已写入）
    让 是主入口 = 源文件
        .文件名()
        .而后映射(|片段| 片段.取字符串引用())
        .有值且(|名称| {
            让 (主名, 后缀) = 名称.逆分割一次('.').取值或((名称, ""));
            主名 == "main" && 扩展名序列.迭代().任意(|单个| 单个 == 后缀)
        });
    如果 !是主入口 {
        返回 假;
    }
    // Cargo.toml 的依赖节非空（有第三方依赖）时回退 cargo
    让 清单文件 = 项目根.连接("Cargo.toml");
    如果 让 成功(清单内容) = 文件系统::读取字符串(&清单文件)
        && 让 有值(依赖段) = 清单内容.分割("[dependencies]").取第项(1)
    {
        // 依赖行形如 `rand = "0.8"`；注释/空行/子表头不算依赖
        让 有依赖 = 依赖段.逐行().任意(|原始行| {
            让 裁剪后 = 原始行.裁剪();
            !裁剪后.是否为空() && !裁剪后.以开头('#') && !裁剪后.以开头('[') && 裁剪后.包含('=')
        });
        如果 有依赖 {
            返回 假;
        }
    }
    真
}

/// 单文件直调 rustc 运行：编译（--error-format=json）→ 翻译诊断 → 运行 exe
#[允许(检查工具::太多参数)]
公开(包) 函数 运行直接编译(
    界面表: &界面::界面消息表,
    项目根: &路径类型,
    源路径: &路径类型,
    语言包参数: &选项<路径缓冲>,
    映射器: &映射管理器,
    源码: &文本,
    源文件: &路径类型,
    列位映射参数: &引擎库::列位映射::列位映射表,
    入口行映射参数: &[无符号机器整数],
    项目上下文参数: &引擎库::别名::项目上下文,
) -> 错误处理::结果<标准库::进程::退出码> {
    让 可执行文件 = 临时守卫::安全临时路径(&格式化!(
        "rzc-run-{}-{}.exe",
        临时守卫::安全用户段(),
        标准库::进程::进程号()
    ))?;
    让 输出 = 命令::新建(解析rustc())
        .参数(["--edition", "2024", "--error-format=json"])
        .单参数(源路径)
        .单参数("-o")
        .单参数(&可执行文件)
        .取输出()
        .映射错误(|错误值| 错误处理::错误处理!("rustc 启动失败: {错误值}"))?;
    让 标准错误文本 = 字符串::从utf8宽松(&输出.标准错误).转字符串();
    让 编译输出 = 格式化!(
        "{}\n{}",
        字符串::从utf8宽松(&输出.标准输出),
        标准错误文本
    );
    让 编译成功 = 输出.进程状态.退出成功();
    如果 !编译输出.裁剪().是否为空() {
        让 _ = 翻译编译诊断(
            &编译输出,
            &标准错误文本,
            &诊断上下文 {
                界面表,
                语言包参数,
                项目根,
                映射器,
                源码,
                源文件,
                入口产物: 源路径.转路径缓冲(),
                列位映射: 有值(列位映射参数),
                入口行映射: 有值(入口行映射参数),
                项目上下文: 有值(项目上下文参数),
            },
            编译成功,
            真,
            // 直调 rustc：编译失败文本由本函数输出（非流式透传）
            假,
        );
    }
    如果 !编译成功 {
        返回 成功(标准库::进程::退出码::失败退出码);
    }
    // 编译成功：运行程序并传播退出码（无论成败都清理临时 exe）。
    // 标准错误流改为管道逐行过滤：恐慌框头/消息与 cargo 进度本地化，
    // 其余字节原样透传（有损解码，不因非 UTF-8 输出中断）；
    // 标准输出/标准输入保持继承，交互式程序不受影响
    让 可变 进程句柄 = 命令::新建(&可执行文件)
        .标准输出(标准库::进程::标准流::继承())
        .标准错误(标准库::进程::标准流::管道化())
        .生成()
        .映射错误(|错误值| {
            让 _ = 文件系统::删除文件(&可执行文件);
            错误处理::错误处理!("运行失败: {错误值}")
        })?;
    如果让 有值(错误管道) = 进程句柄.标准错误.取走() {
        使用 标准库::输入输出::{缓冲读取特征, 缓冲读取器};
        让 可变 读取器 = 缓冲读取器::新建(错误管道);
        让 可变 翻译器 = 流翻译器::新建();
        让 可变 行缓冲: 向量<字节> = 向量::新建();
        循环 {
            行缓冲.清空();
            如果 让 成功(读取数) = 读取器.读取至(b'\n', &可变 行缓冲) {
                如果 读取数 == 0 {
                    中断;
                }
                让 原始片段 = 字符串::从utf8宽松(&行缓冲);
                让 文本行 = 原始片段.裁剪右侧匹配(['\n', '\r']);
                错误打印行!("{}", 翻译器.翻译(文本行, 界面表));
            } 否则 {
                中断;
            }
        }
    }
    让 进程状态值 = 进程句柄.等待进程().映射错误(|错误值| {
        让 _ = 文件系统::删除文件(&可执行文件);
        错误处理::错误处理!("运行失败: {错误值}")
    })?;
    让 _ = 文件系统::删除文件(&可执行文件);
    成功(进程状态值
        .代码()
        .映射(|代码值| 标准库::进程::退出码::从(代码值 作为 字节))
        .解包或用否则(|| 标准库::进程::退出码::失败退出码))
}

/// 单文件直调 rustc 检查：只生成编译元数据，不生成可执行文件
#[允许(检查工具::太多参数)]
公开(包) 函数 检查直接编译(
    界面表: &界面::界面消息表,
    项目根: &路径类型,
    源路径: &路径类型,
    语言包参数: &选项<路径缓冲>,
    映射器: &映射管理器,
    源码: &文本,
    源文件: &路径类型,
    列位映射参数: &引擎库::列位映射::列位映射表,
    入口行映射参数: &[无符号机器整数],
    项目上下文参数: &引擎库::别名::项目上下文,
) -> 错误处理::结果<标准库::进程::退出码> {
    让 输出 = 命令::新建(解析rustc())
        .参数([
            "--edition",
            "2024",
            "--error-format=json",
            "--emit=metadata",
        ])
        .单参数(源路径)
        .取输出()
        .映射错误(|错误值| 错误处理::错误处理!("rustc 启动失败: {错误值}"))?;
    让 进程退出码 = 如果 输出.进程状态.退出成功() {
        标准库::进程::退出码::成功退出码
    } 否则 {
        标准库::进程::退出码::失败退出码
    };
    让 标准错误文本 = 字符串::从utf8宽松(&输出.标准错误).转字符串();
    让 编译输出 = 格式化!(
        "{}\n{}",
        字符串::从utf8宽松(&输出.标准输出),
        标准错误文本
    );
    让 _ = 翻译编译诊断(
        &编译输出,
        &标准错误文本,
        &诊断上下文 {
            界面表,
            语言包参数,
            项目根,
            映射器,
            源码,
            源文件,
            入口产物: 源路径.转路径缓冲(),
            列位映射: 有值(列位映射参数),
            入口行映射: 有值(入口行映射参数),
            项目上下文: 有值(项目上下文参数),
        },
        输出.进程状态.退出成功(),
        假,
        // 直调 rustc 检查：诊断输出由本函数负责（非流式透传）
        假,
    );
    成功(进程退出码)
}

/// 翻译 cargo 的人类可读进度行（JSON 模式下这些行仍输出到标准错误流）
///
/// 命中固定前缀（编译/完成/运行等）时翻译；
/// 其余行（程序标准错误流等）原样返回。
公开(包) 函数 翻译进度行(行文本: &文本, 界面表: &界面::界面消息表) -> 字符串 {
    // cargo 进度行带行首缩进（如 `   Compiling ...`），先去除空白再匹配前缀
    让 裁剪后 = 行文本.裁剪左侧();
    对于 (前缀, 键名) 在 [
        ("Compiling ", "cargo_progress_compiling"),
        ("Checking ", "cargo_progress_checking"),
        ("Finished ", "cargo_progress_finished"),
        ("Running ", "cargo_progress_running"),
        ("error: ", "cargo_progress_error"),
    ] {
        如果让 有值(剩余) = 裁剪后.去前缀(前缀) {
            // 错误摘要（如「无法编译某包，因 N 个先前的错误」）
            // 二次翻译固定短语，其余保留原文
            如果 键名 == "cargo_progress_error" {
                让 剩余文本 = 剩余
                    .去前缀("could not compile ")
                    .映射(|片段| {
                        // 尾部「因 N 个先前的错误」一并本地化：
                        // 如 `abc (bin "abc") due to 9 previous errors`
                        让 片段裁剪 = 片段.裁剪左侧();
                        如果让 有值((主段, 因由段)) = 片段裁剪.分割一次(" due to ") {
                            让 数量 = 因由段.分割空白().下一个().取值或("");
                            格式化!(
                                "{}{}",
                                界面表.取带参消息("cargo_progress_could_not_compile", &[主段]),
                                界面表.取带参消息("cargo_progress_due_to", &[数量])
                            )
                        } 否则 {
                            界面表.取带参消息("cargo_progress_could_not_compile", &[片段裁剪])
                        }
                    })
                    .解包或用否则(|| 剩余.转字符串());
                返回 界面表.取带参消息(键名, &[&剩余文本]);
            }
            返回 界面表.取带参消息(键名, &[剩余.裁剪左侧()]);
        }
    }
    行文本.转字符串()
}

/// 程序标准错误流式翻译器：cargo 进度行 + 运行时恐慌输出的本地化
///
/// rustc 1.98 实测的程序恐慌输出形态（框头 → 消息 → 提示三行）：
/// ```
/// `thread 'main' (621725) panicked at src/main.rs:8:5:`
/// `index out of bounds: the len is 3 but the index is 5`
/// `note: run with RUST_BACKTRACE=1 environment variable to display a backtrace`
/// ```
/// 框头：主线程名映射为各语言主函数词（尖括号自定义名保留）、
/// 线程标识 `(621725) ` 剥离；消息六型（下标越界 / 字节索引越界 ×2 /
/// 字符边界 / 引用单元格借用冲突 ×2）按 ui.toml 模板本地化；提示行固定翻译；
/// 其余行回退 cargo 进度翻译（无匹配则原样返回）。
公开(包) 结构体 流翻译器 {
    /// 上一行是恐慌框头：下一行按恐慌消息匹配
    期待恐慌消息: 布尔,
    /// cargo 纯文本错误行本地化用消息表（无值 = 只处理恐慌/进度行）
    ///
    /// 直调 rustc 运行时管道里只有被运行程序的标准错误流，无消息表时
    /// 不得拿 `error:` 行去查表（会把程序自己打印的错误误当 cargo 错误）。
    工具管理器: 选项<引擎库::诊断::错误消息管理器>,
    /// 待译清单登记语言（空串取当前界面语言）
    缺口语言: 字符串,
    /// 程序已开始运行（见过运行标记行）：之后的错误行属于程序输出
    程序已启动: 布尔,
}

实现 流翻译器 {
    公开(包) 函数 新建() -> 自身 {
        自身 {
            期待恐慌消息: 假,
            工具管理器: 无,
            缺口语言: 字符串::新建(),
            程序已启动: 假,
        }
    }

    /// 启用 cargo 纯文本错误行本地化（仅 `cargo run` 流式透传通道使用）
    公开(包) 函数 带工具文本(
        可变 自我,
        管理器: 引擎库::诊断::错误消息管理器,
        语言码: 实现 转换为<字符串>,
    ) -> 自身 {
        自我.工具管理器 = 有值(管理器);
        自我.缺口语言 = 语言码.转入();
        自我
    }

    /// 翻译一行程序或 cargo 标准错误流（无匹配时原样返回）
    公开(包) 函数 翻译(&可变 自我, 行文本: &文本, 界面表: &界面::界面消息表) -> 字符串 {
        // 框头之后的第一行是恐慌消息；无论命中与否都退出该状态
        如果 标准库::内存::取(&可变 自我.期待恐慌消息)
            && 让 有值(消息文本) = 翻译恐慌消息(行文本, 界面表)
        {
            返回 消息文本;
        }
        如果让 有值(框头) = 翻译恐慌框头(行文本, 界面表) {
            自我.期待恐慌消息 = 真;
            返回 框头;
        }
        如果 行文本.裁剪右侧() == 恐慌提示行 {
            返回 界面表.取消息("panic_note");
        }
        // cargo 的运行标记之后，标准错误流属于被运行的程序：
        // 不再按 cargo 自身错误处理（避免误译程序打印的 `error:` 行）
        如果 行文本.裁剪左侧().以开头("Running ") {
            自我.程序已启动 = 真;
        } 否则 如果 !自我.程序已启动
            && 让 有值(本地化文本) =
                本地化工具行(行文本, 自我.工具管理器.作为引用方法(), 界面表, &自我.缺口语言)
        {
            返回 本地化文本;
        }
        翻译进度行(行文本, 界面表)
    }
}

/// 程序恐慌输出末尾的提示行（rustc 稳定文本，原样匹配）
常量 恐慌提示行: &文本 =
    "note: run with `RUST_BACKTRACE=1` environment variable to display a backtrace";

///
/// 返回无值表示该行不是恐慌框头（由调用方原样透传）。
函数 翻译恐慌框头(行文本: &文本, 界面表: &界面::界面消息表) -> 选项<字符串> {
    让 剩余 = 行文本.裁剪左侧().去前缀("thread '")?;
    让 (线程标签, 名称后续) = 剩余.分割一次('\'')?;
    // rustc 1.98 起框头含线程标识（如 `thread 'main' (621725) panicked at ...`），
    // 旧格式无标识；两种形态都归一为「线程名 + 恐慌位置」
    让 名称之后 = 如果让 有值(编号及后续) = 名称后续.去前缀(" (") {
        编号及后续
            .分割一次(") ")
            .映射(|(_, 尾段)| 尾段)
            .解包或用否则(|| 名称后续)
    } 否则 {
        名称后续
    };
    // 剥离线程标识后剩余文本以「恐慌位置」开头（无标识时带前导空格），
    // 先统一裁剪左侧再匹配
    让 定位文本 = 名称之后.裁剪左侧().去前缀("panicked at ")?;
    让 定位文本 = 定位文本.裁剪右侧().去后缀(':')?;
    如果 线程标签.是否为空() || 定位文本.是否为空() {
        返回 无;
    }
    让 显示名 = 如果 线程标签 == "main" {
        界面表.取消息("panic_thread_main")
    } 否则 {
        线程标签.转字符串()
    };
    有值(界面表.取带参消息("panic_header", &[&显示名, 定位文本]))
}

/// 翻译恐慌消息（六型；未识别返回无值由调用方原样透传）
函数 翻译恐慌消息(行文本: &文本, 界面表: &界面::界面消息表) -> 选项<字符串> {
    让 消息行 = 行文本.裁剪();
    如果 消息行 == "RefCell already borrowed" {
        返回 有值(界面表.取消息("panic_msg_borrow"));
    }
    如果 消息行 == "RefCell already mutably borrowed" {
        返回 有值(界面表.取消息("panic_msg_borrow_mut"));
    }
    如果让 有值(剩余) = 消息行.去前缀("index out of bounds: the len is ") {
        让 (长度段, 索引段) = 剩余.分割一次(" but the index is ")?;
        返回 有值(界面表.取带参消息("panic_msg_index_oob", &[长度段.裁剪(), 索引段.裁剪()]));
    }
    如果让 有值(剩余) = 消息行.去前缀("start byte index ") {
        返回 翻译字节索引消息(剩余, 界面表, 真);
    }
    如果让 有值(剩余) = 消息行.去前缀("end byte index ") {
        返回 翻译字节索引消息(剩余, 界面表, 假);
    }
    无
}

/// 字节索引恐慌消息：越界（`... is out of bounds for string of length N`）或
/// 非字符边界（`... is not a char boundary; it is inside 'C' (bytes A..B of string)`）
函数 翻译字节索引消息(剩余: &文本, 界面表: &界面::界面消息表, 是否起点: 布尔) -> 选项<字符串> {
    让 (索引段, 尾部) = 剩余.分割一次(' ')?;
    如果让 有值(长度段) = 尾部.去前缀("is out of bounds for string of length ") {
        让 键名 = 如果 是否起点 {
            "panic_msg_byte_start_oob"
        } 否则 {
            "panic_msg_byte_end_oob"
        };
        返回 有值(界面表.取带参消息(键名, &[索引段.裁剪(), 长度段.裁剪()]));
    }
    如果让 有值(内部段) = 尾部.去前缀("is not a char boundary; it is inside '") {
        让 (字符值, 区段) = 内部段.分割一次("' (bytes ")?;
        让 (起点段, 终点段) = 区段.分割一次("..")?;
        让 终点段 = 终点段.去后缀(" of string)")?;
        返回 有值(界面表.取带参消息(
            "panic_msg_char_boundary",
            &[索引段.裁剪(), 字符值, 起点段.裁剪(), 终点段.裁剪()],
        ));
    }
    无
}

/// 诊断翻译上下文：封装 `翻译编译诊断` 的共享引用参数，
/// 避免 8+ 位置参数的可读性灾难
公开(包) 结构体 诊断上下文<'甲> {
    公开(包) 界面表: &'甲 界面::界面消息表,
    公开(包) 语言包参数: &'甲 选项<路径缓冲>,
    公开(包) 项目根: &'甲 路径类型,
    公开(包) 映射器: &'甲 映射管理器,
    公开(包) 源码: &'甲 文本,
    公开(包) 源文件: &'甲 路径类型,
    /// 本次实际编译的**入口产物**路径（请求文件的转译产物，如 `src/main.rs`、
    /// `src/工具.rs`、`examples/演示.rs`）。
    ///
    /// 诊断归属按「被编译目标」而非「请求文件」判定：`rzc check src/工具.zh`
    /// 时 cargo 仍编译整个目标，`src/main.rs` 里的报错属于 `main.zh`，
    /// 不能因为用户请求的是 `工具.zh` 就把它标成 `工具.zh`（旧实现硬编码
    /// `src/main.rs` 作入口，等于把入口钉死在默认主入口名上）。
    公开(包) 入口产物: 路径缓冲,
    /// 转译产物的列映射：把 rustc 诊断的（英文产物）列号回译到母语源码列号。
    ///
    /// rustc 看到的是转译后的英文源码，其列号对母语源码无效
    ///（如母语关键字换成英文关键字后整行右移）。无值表示不做映射，保持旧行为。
    公开(包) 列位映射: 选项<&'甲 引擎库::列位映射::列位映射表>,
    /// 入口磁盘产物行 → 引擎直出行映射（见
    /// [`注解产物`](包::注解产物)）。
    ///
    /// 入口产物写盘前经 `#[path]` 注解插入整行（每个非 ASCII `模块 xxx;`
    /// 一行），而 `列映射` 以未注解的引擎直出产物为基准；
    /// 回译前须先用本映射把 rustc 的磁盘行号换算回引擎直出行号。
    /// 无值表示无注解（磁盘产物与引擎直出逐行一致）。
    公开(包) 入口行映射: 选项<&'甲 [无符号机器整数]>,
    /// 项目级声明上下文：诊断重放（[`解析方言上下文`]）须与
    /// 写盘转译共享同一上下文，否则列映射与磁盘产物不一致（#8）
    公开(包) 项目上下文: 选项<&'甲 引擎库::别名::项目上下文>,
}

/// 解析 cargo --message-format=json 输出并翻译为教学化诊断（检查与运行共用）
///
/// 返回是否成功输出了翻译后的教学诊断；调用方据此决定是否回退原始文本。
/// `cargo_ok=false` 且无可解析诊断时原样输出 cargo 消息，绝不虚报“编译成功”。
/// `silent_success=true`（运行场景）时，无诊断且编译成功保持静默——
/// 程序已运行，不再提示“编译成功”。
/// `streamed_output=true`（cargo 运行场景）时，cargo 消息与程序输出均已实时
/// 透传：「失败且无可解析诊断」不再补打“编译错误”标签——构建可能已成功，
/// 失败发生在程序运行阶段（如恐慌退出），补打空标签会误导。
公开(包) 函数 翻译编译诊断(
    编译输出: &文本,
    标准错误文本: &文本,
    共享上下文: &诊断上下文<'_>,
    编译成功: 布尔,
    静默成功: 布尔,
    流式输出: 布尔,
) -> 布尔 {
    让 已处理 = 翻译编译诊断实现(
        编译输出,
        标准错误文本,
        共享上下文,
        编译成功,
        静默成功,
        流式输出,
    );
    // 本轮若有英文残留（未命中消息表），统一提示一次并落盘待译清单；
    // 逐条加标记会污染诊断输出，故只在本轮结束时汇总
    报告翻译缺口(共享上下文.界面表);
    已处理
}

/// 提示并持久化本轮登记的英文残留（无登记时静默）
///
/// 单元测试进程只清空登记表不落盘：测试用样例语言代码登记的残留不该写进
/// 用户主目录（落盘/读取/去重逻辑另有临时目录用例覆盖，见 `诊断::待译清单`）。
公开(包) 函数 报告翻译缺口(界面表: &界面::界面消息表) {
    使用 引擎库::诊断::待译清单;
    让 已记录 = 待译清单::取出缺口();
    如果 已记录.是否为空() {
        返回;
    }
    如果 配置!(测试) {
        返回;
    }
    让 目录 = 待译清单::清单目录();
    待译清单::落盘缺口至目录(&目录, &已记录);
    错误打印行!(
        "{}",
        界面表.取带参消息(
            "translation_gap_notice",
            &[&已记录.元素数().转字符串(), &目录.展示().转字符串()]
        )
    );
}

/// cargo 纯文本错误行的前缀与本地化模板（模板含 `{}` 占位符，与进度行同源）
///
/// `help:` 是工具给的可执行下一步（如 rustup 未配默认工具链时的
/// `run 'rustup default stable'`），不接就只剩一行英文指引留在母语输出里
常量 工具行标记表: [(&文本, &文本); 5] = [
    ("error:", "cargo_progress_error"),
    ("warning:", "tool_prefix_warning"),
    ("note:", "tool_prefix_note"),
    ("help:", "tool_prefix_help"),
    ("Caused by:", "tool_prefix_caused_by"),
];

/// 交回进度行翻译器处理的 cargo 固定句（已有专门本地化，补表无意义）
常量 工具行跳过表: [&文本; 2] = ["could not compile ", "aborting due to "];

/// 按请求文件扩展名取诊断语言代码（无扩展名/未知时跟随界面语言）
公开(包) 函数 诊断语言代码(源文件: &路径类型) -> 字符串 {
    源文件.扩展名()
        .而后映射(|扩展| 扩展.取字符串引用())
        .而后映射(扩展名转语言代码)
        .解包或用否则(界面::探测界面语言)
}

/// 加载消息表：`--lang-pack` 目录 > 项目内 `lang-packs/<lang>/` > 全局语言目录 > 内置
///
/// 文件不存在或加载失败时降级到内置表（只警告不阻断）；返回无值
/// 意味着连内置表都无法解析。
公开(包) 函数 载入错误管理器(
    界面表: &界面::界面消息表,
    语言包参数: &选项<路径缓冲>,
    项目根: &路径类型,
    语言码: &文本,
) -> 选项<引擎库::诊断::错误消息管理器> {
    使用 引擎库::诊断::错误消息管理器;
    让 错误消息路径 = 如果让 有值(路径段) = 语言包参数 {
        路径段.连接("errors.toml")
    } 否则 如果 语言包根目录(项目根)
        .连接(语言码)
        .连接("errors.toml")
        .存在()
    {
        语言包根目录(项目根)
            .连接(语言码)
            .连接("errors.toml")
    } 否则 {
        语言管理::全局语言目录()
            .连接(语言码)
            .连接("errors.toml")
    };
    如果 错误消息路径.存在() {
        // 加载失败时降级到内置表，不因错误消息文件损坏阻断诊断展示
        让 文件载入 = 错误消息管理器::从文件载入(&错误消息路径);
        如果 文件载入.是否为成功() {
            返回 文件载入.转选项();
        }
        如果让 错误(错误值) = 文件载入 {
            错误打印行!("{}", 界面表.取带参消息("load_error_msg_failed", &[&错误值.转字符串()]));
        }
    }
    // 文件路径不可用/加载失败时回退内置语言包（未知语言代码自动回退中文）
    让 内置数据 = 内置语言::获取内置数据(语言码);
    让 字符串载入 = 错误消息管理器::从字符串载入(内置数据.错误内容);
    如果 字符串载入.是否为成功() {
        返回 字符串载入.转选项();
    }
    如果让 错误(错误值) = 字符串载入 {
        错误打印行!("{}", 界面表.取带参消息("warn_builtin_errors_failed", &[&错误值.转字符串()]));
    }
    无
}

/// 用消息表渲染一句工具错误正文
///
/// 返回无值表示未命中且不兜底（调用方继续原流程）；「未命中即登记」为真时
/// 未命中返回原文（绝不吞诊断）并登记待译清单。判「是否已译」只看消息表
/// 是否命中，不看渲染后还剩多少英文词：德/法/西/葡等拉丁语系译文里夹着
/// 路径与包名是常态，按词串判会把已译好的句子打回英文。JSON 通道的
/// 登记点同此口径（见翻译器的缺口登记：未命中或残段未被 `{qN}` 消费才记）。
函数 渲染工具详情(
    详情: &文本,
    管理器: &引擎库::诊断::错误消息管理器,
    缺口语言: &文本,
    记录未命中: 布尔,
) -> 选项<字符串> {
    使用 引擎库::诊断::{填充动态占位, 待译清单};
    让 有值((消息条目, 残段)) = 管理器.按消息查询(详情) 否则 {
        如果 !记录未命中 {
            返回 无;
        }
        待译清单::登记缺口(缺口语言, 待译清单::工具级, "", 详情);
        返回 有值(详情.转字符串());
    };
    让 可变 成品文本 = 消息条目.消息模板.克隆();
    如果让 有值(尾部) = 残段 {
        让 (填充后, 已消费) = 填充动态占位(&成品文本, &尾部);
        成品文本 = 填充后;
        如果 !已消费 {
            // 模板没有对应占位符，英文残段拼回尾巴（兜底）→ 记待译
            成品文本.推入字符串(尾部.文字());
            待译清单::登记缺口(缺口语言, 待译清单::工具级, "", 详情);
        }
    }
    有值(成品文本)
}

/// 本地化单行 cargo 纯文本错误；非错误形态行返回无值（调用方继续原流程）
///
/// 保留行首缩进；映射器为无值（无消息表）时不处理，避免把
/// 被运行程序自己打印的 `error:` 行误标。已知固定汇总句返回无值，
/// 由调用方交给进度行翻译器（那里已有「无法编译」的专门处理）。
函数 本地化工具行(
    行文本: &文本,
    管理器: 选项<&引擎库::诊断::错误消息管理器>,
    界面表: &界面::界面消息表,
    缺口语言: &文本,
) -> 选项<字符串> {
    让 管理器 = 管理器?;
    让 缩进量 = 行文本.元素数() - 行文本.裁剪左侧().元素数();
    让 正文 = 行文本.裁剪左侧();
    让 命中 = 工具行标记表
        .迭代()
        .查找(|(前缀, _)| 正文.以开头(前缀));
    让 (标记, 键名) = 如果让 有值((标记值, 键值)) = 命中 {
        (*标记值, *键值)
    } 否则 {
        // 无标记的缩进行：cargo 把错误链的因由正文写在 `Caused by:` 下一行。
        // 只在消息表命中时换译，未命中交回进度行翻译（缩进输出也可能是
        // 被运行程序自己的打印，不能当成工具错误登记待译）
        如果 缩进量 > 0 {
            返回 渲染工具详情(正文, 管理器, 缺口语言, 假)
                .映射(|译文| 格式化!("{}{}", " ".重复(缩进量), 译文));
        }
        返回 无;
    };
    让 详情 = 正文[标记.元素数()..].裁剪左侧();
    如果 详情.是否为空() {
        // 光杆标记行（cargo 的 `Caused by:` 单独占一行）：只换标签，正文在缩进续行
        返回 有值(界面表.取带参消息(键名, &[""]).裁剪右侧().转字符串());
    }
    如果 工具行跳过表.迭代().任意(|跳过句| 详情.以开头(跳过句)) {
        返回 无;
    }
    让 已渲染 = 渲染工具详情(详情, 管理器, 缺口语言, 真)?;
    有值(格式化!(
        "{}{}",
        " ".重复(缩进量),
        界面表.取带参消息(键名, &[&已渲染])
    ))
}

/// 本地化 cargo 自身错误（非 JSON 通道：清单解析、无编译目标、依赖拉不到等）
///
/// rustc 诊断走 JSON 翻译链，cargo 自己的报错是纯文本，旧行为原样输出英文——
/// 新手最先撞的就是这一类（不在项目里、Cargo.toml 写坏、没声明编译目标）。
///
/// 逐行交给 [`本地化工具行`]：命中消息表则换本地化前缀输出译文，
/// 未命中保留原文并登记待译清单（工具通道）。无标记前缀的辅助行
///（如缩进后的补充说明）不单独登记，避免把进度行刷进清单。
公开(包) 函数 本地化工具文本(
    全文: &文本,
    管理器: &引擎库::诊断::错误消息管理器,
    界面表: &界面::界面消息表,
    缺口语言: &文本,
) -> 字符串 {
    让 可变 成品 = 字符串::带容量(全文.元素数());
    对于 (序号, 原始行) 在 全文.逐行().枚举() {
        如果 序号 > 0 {
            成品.推入('\n');
        }
        如果让 有值(本地化文本) = 本地化工具行(原始行, 有值(管理器), 界面表, 缺口语言) {
            成品.推入字符串(&本地化文本);
        } 否则 {
            成品.推入字符串(&翻译进度行(原始行, 界面表));
        }
    }
    成品
}

函数 翻译编译诊断实现(
    编译输出: &文本,
    标准错误文本: &文本,
    共享上下文: &诊断上下文<'_>,
    编译成功: 布尔,
    静默成功: 布尔,
    流式输出: 布尔,
) -> 布尔 {
    使用 引擎库::诊断::{诊断翻译器, 构建类型映射, 解析诊断输出, 建议包名};
    让 界面表 = 共享上下文.界面表;
    让 语言包参数 = 共享上下文.语言包参数;
    让 项目根 = 共享上下文.项目根;
    让 映射器 = 共享上下文.映射器;
    让 源文件 = 共享上下文.源文件;

    // 未解析导入提取：诊断展示后附带 `rzc add` 加依赖提示（教学化引导）
    让 未解析包集 = 提取未解析包(编译输出);
    // 本项目自身可引入的包名（包名 / 库节名）：命中它的候选不能
    // 建议 `rzc add`（Cargo 拒绝包依赖自己），见 [`输出依赖提示`]
    让 本地名集 = 本地包名集(项目根);
    // 库入口源文件按请求文件的扩展名推断（`src/main.zh` → `src/lib.zh`）：
    // 同项目内的方言文件通常同一种语言，且库入口正是方言入口名之一
    让 库入口 = 源文件.扩展名().而后映射(|扩展| 扩展.取字符串引用()).映射(|扩展| {
        让 库源 = 项目根.连接("src").连接(格式化!("lib.{扩展}"));
        (格式化!("src/lib.{扩展}"), 库源.是否为文件())
    });
    让 依赖提示 = || {
        输出依赖提示(
            &未解析包集,
            界面表,
            &本地名集,
            库入口
                .作为引用方法()
                .映射(|(路径段, 是否存在)| (路径段.作为文本切片(), *是否存在)),
        )
    };

    // 按语言代码选择错误消息表（与 cargo 纯文本通道共用同一张表）
    让 语言码 = 诊断语言代码(源文件);
    // 类型映射（英文 → 母语）：供诊断消息中的类型/特征名中文化（如
    // `std::fmt::Display` → `标准库::格式化::可显示`）。构建逻辑下沉引擎，
    // 与 LSP 共用同一来源，避免两侧漂移（关键字表类型节反转为主，别名/模块路径补充）。
    让 反向映射 = 构建类型映射(映射器);
    让 翻译器 =
        载入错误管理器(界面表, 语言包参数, 项目根, &语言码).映射(|翻译管理器| {
            诊断翻译器::新建诊断翻译器(翻译管理器, 反向映射.克隆()).带待译语言(语言码.克隆())
        });

    // cargo 自身错误（纯文本通道）本地化：清单写坏、不在项目里、
    // 未声明编译目标这类新手高频错误旧行为是直接喷英文
    让 编译错误文本 = || {
        如果让 有值(译器) = &翻译器 {
            本地化工具文本(标准错误文本.裁剪(), 译器.取译表(), 界面表, &语言码)
        } 否则 {
            标准错误文本.裁剪().转字符串()
        }
    };

    让 原文件名 = 源文件
        .文件名()
        .取值或默认()
        .转有损字符串()
        .转字符串();
    让 可变 诊断集 = 解析诊断输出(编译输出);
    // 保留 error/warning；不要求有错误码——无码的解析错误（如缺括号）
    // 也必须显示，否则会被静默吞掉导致假“编译成功”
    诊断集.保留(|单条| 单条.级别 == "error" || 单条.级别 == "warning");
    // rustc 的汇总元消息（`aborting due to N previous error(s)`）：无代码位置、
    // 无教学内容，具体错误已逐条列出；省略它可以避免英文残句与伪“错误”行
    // 混入诊断列表（数字无法用消息表占位符捕获，故不在翻译层处理）
    诊断集.保留(|单条| !单条.诊断消息.以开头("aborting due to "));
    让 可变 已见码集 = 哈希集合::新建();
    诊断集.保留(|单条| {
        如果让 有值(码) = &单条.诊断码 {
            已见码集.置入(码.码值.克隆())
        } 否则 {
            真 // 无错误码的诊断（解析错误等）不去重，直接保留
        }
    });

    // rustc 的「若要使用名为 X 的第三方库，请 `cargo add X`」建议：X 命中本项目
    // 包名时是**错建议**——Cargo 不允许一个包依赖自己，读者照着做只会撞
    // `cannot add "calc" as a dependency to itself`。引擎侧没有项目上下文（不知道
    // 包名），故在 CLI 按本地包名剔除这条子诊断；真能走通的动作由
    // 依赖提示函数给出。引擎已按同一形状丢弃非 ASCII 名（母语模块误提取），
    // 这里复用它的提取函数，不另写一套解析。
    如果 !本地名集.是否为空() {
        对于 单条 在 &可变 诊断集 {
            单条.子诊断.保留(|子项| {
                !建议包名(&子项.诊断消息)
                    .有值且(|候选名| 本地名集.迭代().任意(|本地名| 本地名 == 候选名))
            });
        }
    }

    如果 诊断集.是否为空() {
        如果 编译成功 {
            如果 !静默成功 {
                打印行!("{}", 界面表.取消息("success_compile"));
            }
        } 否则 如果 !流式输出 {
            // cargo 失败但无可解析的 JSON 诊断（Cargo.toml 语法错误、
            // 链接错误等）：本地化后输出 cargo 消息，绝不虚报“编译成功”；
            // 流式输出场景跳过（见函数文档，避免运行时失败被误标）
            错误打印行!("{}", 界面表.取带参消息("compile_error", &[&编译错误文本()]));
        }
        依赖提示();
        返回 假;
    }

    如果让 有值(译器) = &翻译器 {
        让 可变 教学列表 = 译器.批量翻译(&诊断集);
        让 可变 已见教学码集 = 哈希集合::新建();
        教学列表.保留(|单条| {
            单条.错误码
                .作为引用方法()
                .是否为无或(|码| 已见教学码集.置入(码.克隆()))
        });
        // 诊断定位回译：入口产物（src/main.rs）用调用方传入的源码与列映射；
        // 多文件项目的子模块产物（如 src/接口.rs）解析回母语源文件
        // （src/接口.zh）后用其源码与列映射单独回译——修复子模块错误被统一
        // 误标为入口文件且源码行/列号错位的问题。
        让 方言扩展名文本 = 源文件
            .扩展名()
            .而后映射(|扩展| 扩展.取字符串引用())
            .取值或("zh");
        让 可变 修复器 = 诊断定位修复器::新建(共享上下文, &原文件名, 方言扩展名文本);
        对于 单条 在 &可变 教学列表 {
            修复器.修复(单条);
        }
        如果 教学列表.是否为空() {
            如果 编译成功 {
                如果 !静默成功 {
                    打印行!("{}", 界面表.取消息("success_compile"));
                }
            } 否则 如果 !流式输出 {
                错误打印行!("{}", 界面表.取带参消息("compile_error", &[&编译错误文本()]));
            }
            依赖提示();
            返回 假;
        }
        打印行!(
            "{}",
            引擎库::诊断::教学诊断::批量作为文字输出(&教学列表)
        );
        依赖提示();
        真
    } 否则 {
        // 无翻译表：输出 JSON 中的原始消息，保证诊断不丢失
        对于 行文本 在 编译输出.逐行() {
            如果让 成功(原始值) = JSON序列化::解析字符串::<JSON序列化::JSON值>(行文本) {
                如果让 有值(消息值) = 原始值.获取("message") {
                    打印行!("{}", 消息值.作为文本切片().取值或(""));
                }
            } 否则 如果 !行文本.裁剪().是否为空() {
                打印行!("{}", 行文本);
            }
        }
        依赖提示();
        假
    }
}

/// 诊断文件上下文：rustc 报告的（英文产物）文件解析回母语源文件后
/// 得到的显示名、源码与列映射，供行号/列号/源行统一回译
结构体 诊断文件上下文 {
    显示名称: 字符串,
    源码: 字符串,
    列位映射: 引擎库::列位映射::列位映射表,
    /// 磁盘产物行 → 引擎直出行映射（`#[path]` 注解插入行时非恒等）。
    ///
    /// 托管布局下入口与子模块产物都由
    /// [`注解产物模块路径并返回行映射`](引擎库::产物布局::注解产物模块路径并返回行映射)
    /// 注解，插入行数随该文件的模块声明而异，故按产物自身重算。
    行映射: 向量<无符号机器整数>,
}

/// 解析 rustc 报告的诊断文件路径为实际路径：
/// 绝对路径原样；相对路径先相对项目根（cargo 的当前目录），再相对当前目录。
/// 无法定位时返回无值。
函数 解析产物路径(项目根: &路径类型, 名称: &文本) -> 选项<路径缓冲> {
    让 候选路径 = 路径类型::新建(名称);
    如果 候选路径.是否绝对() {
        返回 有值(候选路径.转路径缓冲());
    }
    让 根下路径 = 项目根.连接(候选路径);
    如果 根下路径.存在() {
        返回 有值(根下路径);
    }
    标准库::环境::当前目录().转选项().映射(|目录| 目录.连接(候选路径))
}

/// 把 rustc 报告的诊断文件（转译产物路径）解析为母语源文件上下文。
///
/// 多文件项目中 rustc 报告的是子模块转译产物（如 src/接口.rs），其行列是
/// 英文产物的坐标、源码行也是英文；须找到同名方言源文件（src/接口.zh）并用
/// 其源码重建列映射。对应方言文件不存在（手写 .rs、第三方库源码等）时
/// 返回无值，调用方保持 rustc 原始定位，绝不误标成入口文件。
函数 解析方言上下文(
    项目根: &路径类型,
    方言扩展名: &文本,
    产物文件: &文本,
    映射器: &映射管理器,
    项目上下文参数: 选项<&引擎库::别名::项目上下文>,
) -> 选项<诊断文件上下文> {
    让 绝对产物 = 解析产物路径(项目根, 产物文件)?;
    // 托管布局：rustc 报的是 `.rz/gen/src/接口.rs`（且父目录与 `#[path]` 值
    // 直接拼接，形如 `src/../.rz/gen/src/接口.rs`），剥掉托管前缀才是源文件
    // 所在的源码树位置，否则同名方言源文件永远找不到（诊断停在英文坐标）
    让 绝对产物 = 引擎库::产物布局::去托管前缀(项目根, &绝对产物).取值或(绝对产物);
    // 产物名以 .rs 结尾时换成方言扩展名（src/接口.rs → src/接口.zh）
    让 源路径 = 如果 绝对产物.扩展名().有值且(|扩展| 扩展 == "rs") {
        绝对产物.设扩展名(方言扩展名)
    } 否则 {
        绝对产物
    };
    让 源码 = 文件系统::读取字符串(&源路径).转选项()?;
    // 现场重放转译管线取列映射：与写盘时同一管线（同一项目上下文，
    // 确定性输出），保证列号回译与磁盘上的转译产物一致；静默重放：
    // 教学告警（lint/全角/Unicode）已在写盘转译时输出过，此处重放不得重复告警
    让 转译结果 = 引擎库::静默带项目转译管线(&源码, 映射器, 项目上下文参数);
    让 列位映射 = 引擎库::列位映射::列位映射表::回放生成(&源码, &转译结果.流程映射);
    // 子模块产物写盘时按托管布局插入了 `#[path]` 行：列映射以未注解的引擎
    // 直出产物为基准，须先用同一函数的行映射换算回直出行号，否则注解越多、
    // 行号偏移越大（多文件项目下的错行）。产物路径按同一规则重算，
    // 与 `transpile_project_files()` 写盘时的注解保持一致。
    让 产物 = 引擎库::产物布局::产物路径(项目根, &源路径);
    让 行映射 = {
        让 扩展名序列 = 语言管理::全部可用扩展名();
        包::注解产物(&转译结果.输出, 项目根, &源路径, &产物, 假, &扩展名序列).1
    };
    有值(诊断文件上下文 {
        显示名称: 源路径
            .文件名()
            .取值或默认()
            .转有损字符串()
            .转字符串(),
        源码,
        列位映射,
        行映射,
    })
}

/// 诊断定位回译器：把教学诊断的位置从英文产物坐标回译到母语源码坐标
///
/// 入口产物用调用方传入的源码/列映射；项目内其他方言文件的转译产物按
/// 文件名解析回母语源文件，用其源码与列映射单独回译；非方言文件保持
/// rustc 原始定位。
公开(包) 结构体 诊断定位修复器<'甲> {
    /// 入口文件的母语源码
    源码: &'甲 文本,
    /// 入口产物的列映射（rustc 列号 → 母语列号）
    列位映射: 选项<&'甲 引擎库::列位映射::列位映射表>,
    /// 入口磁盘产物行 → 引擎直出行映射（含 `#[path]` 注解插入行时非恒等）
    入口行映射: 选项<&'甲 [无符号机器整数]>,
    项目根: &'甲 路径类型,
    映射器: &'甲 映射管理器,
    /// 入口文件名（如 main.zh）
    原文件名: &'甲 文本,
    /// 被编译入口产物的规范路径（本次请求文件的产物），用于识别入口产物的诊断
    入口规范路径: 选项<路径缓冲>,
    /// 入口文件的方言扩展名（如中文扩展名），用于把产物 .rs 还原为源文件
    方言扩展名: &'甲 文本,
    /// 项目级声明上下文（诊断重放与写盘转译一致，见 [`诊断上下文::项目上下文`]）
    项目上下文: 选项<&'甲 引擎库::别名::项目上下文>,
    /// 诊断文件 → 母语源文件上下文缓存（无值表示非方言文件）
    文件上下文缓存: 哈希映射<字符串, 选项<诊断文件上下文>>,
}

实现<'甲> 诊断定位修复器<'甲> {
    公开(包) 函数 新建(
        共享上下文: &'甲 诊断上下文<'甲>,
        原文件名: &'甲 文本,
        方言扩展名: &'甲 文本,
    ) -> 自身 {
        自身 {
            源码: 共享上下文.源码,
            列位映射: 共享上下文.列位映射,
            入口行映射: 共享上下文.入口行映射,
            项目根: 共享上下文.项目根,
            映射器: 共享上下文.映射器,
            原文件名,
            // 按被编译目标而非固定 `src/main.rs`：请求文件非入口时（如
            // `rzc check src/工具.zh`，产物 src/工具.rs），入口产物是它自己
            入口规范路径: 共享上下文.入口产物.规范路径().转选项(),
            方言扩展名,
            项目上下文: 共享上下文.项目上下文,
            文件上下文缓存: 哈希映射::新建(),
        }
    }

    /// 回译一条教学诊断的全部位置（含子诊断）
    函数 修复(&可变 自我, 教学项: &可变 引擎库::诊断::教学诊断) {
        对于 定位项 在 &可变 教学项.位置集 {
            自我.修复位置(定位项);
        }
        对于 子项 在 &可变 教学项.子诊断 {
            自我.修复(子项);
        }
    }

    公开(包) 函数 修复位置(&可变 自我, 定位项: &可变 引擎库::诊断::诊断位置) {
        如果 自我.是入口产物(&定位项.文件名称) {
            定位项.文件名称 = 自我.原文件名.转字符串();
            // 先把 rustc 的（英文产物）行列回译到母语源码坐标，
            // 再用回译后的行号取源码行——顺序不可颠倒，否则源码行与列号错位。
            如果让 有值(列映射表) = 自我.列位映射 {
                // 磁盘产物含 `#[path]` 注解插入行时，行号先换算回引擎直出行
                //（列映射以引擎直出产物为基准，从 1 开始计数换算后传入）
                让 直出行号 = 自我.入口行映射
                    .而后映射(|映射| 映射.获取(定位项.起始行号.饱和减(1) 作为 无符号机器整数).复制值())
                    .映射(|直出行| 直出行 作为 无符号整数 + 1)
                    .取值或(定位项.起始行号);
                让 (回译行, 回译列) = 列映射表.回译坐标(直出行号, 定位项.起始列号);
                定位项.起始行号 = 回译行;
                定位项.起始列号 = 回译列;
            }
            定位项.源码文本 = 取中文源码行(自我.源码, 定位项.起始行号);
            返回;
        }
        让 缓存值 = 自我.文件上下文缓存
            .取条目(定位项.文件名称.克隆())
            .或用插入(|| {
                解析方言上下文(
                    自我.项目根,
                    自我.方言扩展名,
                    &定位项.文件名称,
                    自我.映射器,
                    自我.项目上下文,
                )
            });
        让 有值(文件上下文) = 缓存值 否则 {
            // 非方言文件（手写 .rs、第三方源码等）：保持 rustc 原始定位
            返回;
        };
        定位项.文件名称 = 文件上下文.显示名称.克隆();
        // 注解插入行先行换算（映射从 1 开始计数），再回译列号
        让 直出行号 = 文件上下文
            .行映射
            .获取(定位项.起始行号.饱和减(1) 作为 无符号机器整数)
            .复制值()
            .映射(|直出行| 直出行 作为 无符号整数 + 1)
            .取值或(定位项.起始行号);
        让 (回译行, 回译列) = 文件上下文.列位映射.回译坐标(直出行号, 定位项.起始列号);
        定位项.起始行号 = 回译行;
        定位项.起始列号 = 回译列;
        定位项.源码文本 = 取中文源码行(&文件上下文.源码, 定位项.起始行号);
    }

    /// 判断诊断文件是否为本次编译入口（请求文件）的转译产物
    函数 是入口产物(&自我, 名称: &文本) -> 布尔 {
        让 有值(入口规范) = 自我.入口规范路径.作为引用方法() 否则 {
            返回 假;
        };
        解析产物路径(自我.项目根, 名称)
            .而后映射(|绝对产物| 绝对产物.规范路径().转选项())
            .有值且(|绝对产物| &绝对产物 == 入口规范)
    }
}

/// 从 cargo --message-format=json 输出提取未声明的包名
///
/// 识别未解析导入（E0432）与解析失败（E0433）诊断，
/// 候选提取复用引擎共享逻辑（已去重，排除标准库与保留路径）。
公开(包) 函数 提取未解析包(编译输出: &文本) -> 向量<字符串> {
    使用 引擎库::诊断::{是否未解析导入消息, 未解析包候选};
    让 可变 汇集结果: 向量<字符串> = 向量::新建();
    对于 行文本 在 编译输出.逐行() {
        让 成功(条目值) = JSON序列化::解析字符串::<JSON序列化::JSON值>(行文本) 否则 {
            继续;
        };
        // cargo JSON 流中诊断嵌套在 compiler-message 条目里；
        // 兼容直接的诊断对象两种形态
        让 消息对象 = 如果 条目值.获取("reason").是否为有值() {
            条目值.获取("message")
        } 否则 {
            有值(&条目值)
        };
        让 有值(消息值) = 消息对象 否则 { 继续; };
        让 级别值 = 消息值.获取("level").而后映射(|内部值| 内部值.作为文本切片()).取值或("");
        如果 级别值 != "error" {
            继续;
        }
        让 代码值 = 消息值
            .获取("code")
            .而后映射(|编码项| 编码项.获取("code"))
            .而后映射(|内部值| 内部值.作为文本切片())
            .取值或("");
        让 消息文本 = 消息值
            .获取("message")
            .而后映射(|内部值| 内部值.作为文本切片())
            .取值或("");
        如果 !模式匹配!(代码值, "E0432" | "E0433") && !是否未解析导入消息(消息文本) {
            继续;
        }
        对于 段 在 未解析包候选(消息文本) {
            如果 !汇集结果.包含(&段) {
                汇集结果.推入(段);
            }
        }
        // 码命中但消息文本未命中时（消息格式变化），退化到纯首段提取
        如果 模式匹配!(代码值, "E0432" | "E0433") && 未解析包候选(消息文本).是否为空() {
            使用 引擎库::诊断::取反引号首段;
            对于 段 在 取反引号首段(消息文本) {
                // 非 ASCII 段不是包名（母语标识符误提取），
                // 与 未解析包候选 的过滤保持一致
                如果 !模式匹配!(
                    段.作为文本切片(),
                    "std" | "core" | "alloc" | "self" | "super" | "crate" | "proc_macro"
                ) && !段.逐字符().下一个().有值且(|字符值| 字符值.是数字字符())
                    && 段.是否为ASCII()
                    && !汇集结果.包含(&段)
                {
                    汇集结果.推入(段);
                }
            }
        }
    }
    汇集结果
}

/// 本项目自身可被引入的包名（包名与库节名）
///
/// Cargo 把包名里的 `-` 换成 `_` 当作包名，库节名可再覆盖一次。
/// rustc 分不出「自己的库还没生成产物」和「没声明的第三方库」，两种情况都报
/// E0432 并建议 `cargo add`——拿包名去加依赖会被 Cargo 直接拒绝
/// （实测会提示「不能把包加为自身依赖」），所以这条建议
/// 在本地包名上**必然失败**。无 Cargo.toml 或 TOML 非法时返回空，不改任何行为。
函数 本地包名集(项目根: &路径类型) -> 向量<字符串> {
    让 可变 名称集 = 向量::新建();
    让 成功(清单文本) = 文件系统::读取字符串(项目根.连接("Cargo.toml")) 否则 {
        返回 名称集;
    };
    让 成功(清单值) = TOML处理::解析字符串::<TOML处理::TOML值>(&清单文本) 否则 {
        返回 名称集;
    };
    让 原始名集 = [
        清单值
            .获取("package")
            .而后映射(|包项| 包项.获取("name"))
            .而后映射(|内部值| 内部值.作为文本切片()),
        清单值
            .获取("lib")
            .而后映射(|库项| 库项.获取("name"))
            .而后映射(|内部值| 内部值.作为文本切片()),
    ];
    对于 名称 在 原始名集.迭代().展平() {
        让 包名 = 名称.替换('-', "_");
        如果 !名称集.包含(&包名) {
            名称集.推入(包名);
        }
    }
    名称集
}

/// 输出未解析导入的加依赖提示（无候选时静默）
///
/// 候选命中本项目包名时**不能**建议 `rzc add`（见 [`本地包名集`]）：
/// 那样只会把读者引向一条 Cargo 必然拒绝的命令。此时按库入口在不在分两种说法——
/// 有 `src/lib.<扩展名>` 就指向「先检查它生成 src/lib.rs」，没有就点明这个文件
/// 还不存在、`use 包名::…` 引用的正是它编译出的库。其余候选照旧走第三方库提示。
函数 输出依赖提示(
    包清单: &[字符串],
    界面表: &界面::界面消息表,
    本地名集: &[字符串],
    库入口: 选项<(&文本, 布尔)>,
) {
    对于 名称 在 包清单 {
        如果 !本地名集.迭代().任意(|本地名| 本地名 == 名称) {
            错误打印行!("{}", 界面表.取带参消息("hint_add_dependency", &[名称, 名称]));
            继续;
        }
        // 本地包名：只给「生成/新建库入口」这一条真能走通的路。拿不到扩展名
        // （无从推断 `src/lib.<ext>`）时宁可不说话，也不给一条 Cargo 会拒绝的命令。
        让 有值((路径段, 是否存在)) = 库入口 否则 {
            继续;
        };
        如果 是否存在 {
            错误打印行!("{}", 界面表.取带参消息("hint_own_crate_lib", &[名称, 名称, 路径段]));
        } 否则 {
            错误打印行!(
                "{}",
                界面表.取带参消息("hint_own_crate_no_lib", &[名称, 名称, 路径段, 路径段])
            );
        }
    }
}

函数 取中文源码行(源码: &文本, 行号: 无符号整数) -> 选项<字符串> {
    如果 行号 == 0 {
        返回 无;
    }
    源码
        .逐行()
        .取第项((行号 - 1) 作为 无符号机器整数)
        .映射(|单行| 单行.转字符串())
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;
    使用 引擎库::模块路径::注解非母语模块并返回行映射;

    /// 测试用界面消息：直接读仓库语言包（绕开用户主目录全局安装副本的
    /// 缺键干扰，保证断言与仓库内容一致）
    函数 取测试界面(语言码: &文本) -> 界面::界面消息表 {
        让 目录 = 路径类型::新建(编译环境!("CARGO_MANIFEST_DIR"))
            .连接("../engine/lang-packs")
            .连接(语言码);
        界面::界面消息表::按显式目录建表(&目录)
    }

    /// 加载内置中文映射管理器（测试诊断回译用）
    函数 中文映射器() -> 映射管理器 {
        让 内置数据 = 内置语言::获取内置数据("zh");
        映射管理器::从内置载入(
            内置数据.关键字内容,
            内置数据.模块路径内容,
            内置数据.标准库内容,
            内置数据.三方库数据,
        )
        .期望("内置中文语言包应可加载")
    }

    /// 单文件直调编译的启用条件：仅 main.zh 且无依赖
    #[测试]
    函数 可用直接编译单文件无依赖() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.条目路径();
        文件系统::创建所有目录(根.连接("src")).解包();
        文件系统::写入(
            根.连接("Cargo.toml"),
            "[package]\nname = \"t\"\nversion = \"0.1.0\"\n",
        )
        .解包();
        文件系统::写入(根.连接("src/main.zh"), "函数 主函数() {}\n").解包();
        断言!(可用直接编译(根, &根.连接("src/main.zh")));
    }

    /// 有第三方依赖时回退 cargo（依赖行 `rand = "0.8"`）
    #[测试]
    函数 可用直接编译有依赖时回退() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.条目路径();
        文件系统::创建所有目录(根.连接("src")).解包();
        文件系统::写入(
            根.连接("Cargo.toml"),
            "[package]\nname = \"t\"\nversion = \"0.1.0\"\n[dependencies]\nrand = \"0.8\"\n",
        )
        .解包();
        文件系统::写入(根.连接("src/main.zh"), "函数 主函数() {}\n").解包();
        断言!(!可用直接编译(根, &根.连接("src/main.zh")));
    }

    /// 多文件项目（源码目录下有第二个方言文件）回退 cargo
    #[测试]
    函数 可用直接编译多方言文件时回退() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.条目路径();
        文件系统::创建所有目录(根.连接("src")).解包();
        文件系统::写入(
            根.连接("Cargo.toml"),
            "[package]\nname = \"t\"\nversion = \"0.1.0\"\n",
        )
        .解包();
        文件系统::写入(根.连接("src/main.zh"), "函数 主函数() {}\n").解包();
        文件系统::写入(
            根.连接("src/数学.zh"),
            "函数 加(甲: 整数, 乙: 整数) -> 整数 { 甲 + 乙 }\n",
        )
        .解包();
        断言!(!可用直接编译(根, &根.连接("src/main.zh")));
    }

    /// 入口产物含 #[path] 注解时，诊断回译先换算行号再列映射
    ///（回归：多模块入口中所有诊断行号被注解行整体顶偏移）
    #[测试]
    函数 定位修复器入口行映射() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.条目路径();
        文件系统::创建所有目录(根.连接("src")).解包();
        让 源码 = "// 头\n模块 数学;\n\n函数 主函数() {\n    让 _ = 未定义的名字;\n}\n";
        让 入口 = 根.连接("src/main.zh");
        文件系统::写入(&入口, 源码).解包();

        让 映射器 = 中文映射器();
        让 转译成品 = 引擎库::转译管线(源码, &映射器);
        让 列位映射 = 引擎库::列位映射::列位映射表::回放生成(
            源码,
            &转译成品.流程映射,
        );
        让 (产物文本, 行映射) = 注解非母语模块并返回行映射(&转译成品.输出);
        // 磁盘产物（编译器看到的就是它）：注解插在第 2 行，其后行号 +1
        文件系统::写入(根.连接("src/main.rs"), &产物文本).解包();

        让 界面表 = 界面::界面消息表::按语言建表("zh");
        让 共享上下文 = 诊断上下文 {
            界面表: &界面表,
            语言包参数: &无,
            项目根: 根,
            映射器: &映射器,
            源码,
            源文件: &入口,
            入口产物: 入口.设扩展名("rs"),
            列位映射: 有值(&列位映射),
            入口行映射: 有值(&行映射),
            项目上下文: 无,
        };
        让 可变 修复器 = 诊断定位修复器::新建(&共享上下文, "main.zh", "zh");
        // 编译器报磁盘第 6 行第 13 列（`未定义的名字` 首字符）
        让 可变 定位项 = 引擎库::诊断::诊断位置 {
            文件名称: "src/main.rs".转字符串(),
            起始行号: 6,
            起始列号: 13,
            结束行号: 6,
            结束列号: 18,
            源码文本: 无,
            标签文本: 无,
            是否主因: 真,
        };
        修复器.修复位置(&可变 定位项);

        // 回译到母语源码：第 5 行第 11 列（母语关键字与英文关键字的列差已补回）
        断言相等!(定位项.文件名称, "main.zh");
        断言相等!(定位项.起始行号, 5);
        断言相等!(定位项.起始列号, 11);
        断言相等!(
            定位项.源码文本.作为解引用(),
            有值("    让 _ = 未定义的名字;")
        );
    }

    /// 托管布局子模块产物（`.rz/gen/src/…`）的诊断仍须回译到母语源文件
    ///
    /// 回归：④ 生成物迁出源码目录后，编译器报的是托管产物路径，且是父目录与
    /// `#[path]` 值的未规整拼接（`src/../.rz/gen/src/数学.rs`）；剥前缀 +
    /// 按产物自身重算行映射缺一不可，否则诊断停在英文坐标。
    #[测试]
    函数 定位修复器托管产物回译() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.条目路径();
        文件系统::创建所有目录(根.连接("src/数学")).解包();
        文件系统::创建所有目录(根.连接(".rz/gen/src")).解包();
        // 子模块自己还有子模块：产物会插入 `#[path]` 行，行映射非恒等
        文件系统::写入(
            根.连接("src/数学/工具.zh"),
            "函数 恒等(甲: 整数) -> 整数 { 甲 }\n",
        )
        .解包();
        让 模块源码 = "模块 工具;\n\n函数 加(甲: 整数, 乙: 整数) -> 整数 {\n    让 _ = 未定义的名字;\n    甲 + 乙\n}\n";
        让 模块文件 = 根.连接("src/数学.zh");
        文件系统::写入(&模块文件, 模块源码).解包();

        让 映射器 = 中文映射器();
        让 转译成品 = 引擎库::转译管线(模块源码, &映射器);
        让 产物 = 引擎库::产物布局::产物路径(根, &模块文件);
        断言相等!(产物, 根.连接(".rz/gen/src/数学.rs"));
        让 扩展名序列 = 语言管理::全部可用扩展名();
        让 (产物文本, 行映射) = 包::注解产物(
            &转译成品.输出,
            根,
            &模块文件,
            &产物,
            假,
            &扩展名序列,
        );
        // 托管目录镜像源码布局：子模块之间仍与旧布局逐字一致（`数学/工具.rs`）
        断言!(
            产物文本.包含("#[path = \"数学/工具.rs\"]"),
            "{产物文本}"
        );
        文件系统::写入(&产物, &产物文本).解包();
        // 源文件里报错在第 4 行，磁盘产物被 `#[path]` 顶到第 5 行
        让 磁盘行号 = 产物文本
            .逐行()
            .取位置(|单行| 单行.包含("未定义的名字"))
            .期望("产物应含报错行")
            + 1;
        断言相等!(磁盘行号, 5);
        断言不等!(行映射[4], 5, "行映射应把磁盘行换算回直出行");

        让 入口 = 根.连接("src/main.zh");
        文件系统::写入(&入口, "函数 主函数() {}\n").解包();
        让 入口源码 = "函数 主函数() {}\n";
        让 界面表 = 界面::界面消息表::按语言建表("zh");
        让 共享上下文 = 诊断上下文 {
            界面表: &界面表,
            语言包参数: &无,
            项目根: 根,
            映射器: &映射器,
            源码: 入口源码,
            源文件: &入口,
            入口产物: 入口.设扩展名("rs"),
            列位映射: 无,
            入口行映射: 无,
            项目上下文: 无,
        };
        让 可变 修复器 = 诊断定位修复器::新建(&共享上下文, "main.zh", "zh");
        让 可变 定位项 = 引擎库::诊断::诊断位置 {
            文件名称: "src/../.rz/gen/src/数学.rs".转字符串(),
            起始行号: 磁盘行号 作为 无符号整数,
            起始列号: 13,
            结束行号: 磁盘行号 作为 无符号整数,
            结束列号: 18,
            源码文本: 无,
            标签文本: 无,
            是否主因: 真,
        };
        修复器.修复位置(&可变 定位项);

        断言相等!(定位项.文件名称, "数学.zh");
        断言相等!(定位项.起始行号, 4);
        断言相等!(定位项.起始列号, 11);
        断言相等!(
            定位项.源码文本.作为解引用(),
            有值("    让 _ = 未定义的名字;")
        );
    }

    /// 编译输出流中提取未声明包：E0432/E0433 命中，标准库与重复项排除
    #[测试]
    函数 提取未解析包规则() {
        让 首行 = r#"{"reason":"compiler-message","message":{"message":"unresolved import `serde_json`","code":{"code":"E0432"},"level":"error"}}"#;
        让 次行 = r#"{"reason":"compiler-message","message":{"message":"failed to resolve: use of undeclared crate or module `tokio`","code":{"code":"E0433"},"level":"error"}}"#;
        让 三行 = r#"{"reason":"compiler-message","message":{"message":"unresolved import `std::collections`","code":{"code":"E0432"},"level":"error"}}"#;
        让 四行 = r#"{"reason":"compiler-message","message":{"message":"unresolved import `serde_json`","code":{"code":"E0432"},"level":"error"}}"#;
        让 五行 = r#"{"reason":"compiler-message","message":{"message":"unused variable `x`","code":{"code":"E0432"},"level":"warning"}}"#;
        让 输出文本 = [首行, 次行, 三行, 四行, 五行].连接("\n");
        断言相等!(提取未解析包(&输出文本), 向量!["serde_json", "tokio"]);
    }

    /// 本项目可引入的包名：包名按 Cargo 规则把 `-` 换成 `_`，库节名另计
    ///
    /// 这组名决定「`use X::…` 解析失败」该不该建议 `rzc add X`：Cargo 不允许一个包
    /// 依赖自己，命中本地名时那条命令必然失败。清单读不出来（无清单、格式
    /// 非法）时返回空，等于不改任何既有行为，而不是猜一个名字去压制正确提示。
    #[测试]
    函数 本地包名集规则() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.条目路径();

        文件系统::写入(
            根.连接("Cargo.toml"),
            "[package]\nname = \"my-calc\"\nversion = \"0.1.0\"\n\n[lib]\nname = \"calc_lib\"\n",
        )
        .解包();
        断言相等!(本地包名集(根), 向量!["my_calc", "calc_lib"]);

        // 无库节时只有包名一种叫法
        文件系统::写入(
            根.连接("Cargo.toml"),
            "[package]\nname = \"calc\"\nversion = \"0.1.0\"\n",
        )
        .解包();
        断言相等!(本地包名集(根), 向量!["calc"]);

        文件系统::写入(根.连接("Cargo.toml"), "[package]\nname = ").解包();
        断言!(
            本地包名集(根).是否为空(),
            "非法配置不该给出任何名字"
        );
        断言!(
            本地包名集(&根.连接("nope")).是否为空(),
            "无清单不该报错"
        );
    }

    /// 流式翻译器：恐慌三行序列（含线程标识框头 → 消息 → 提示）本地化
    #[测试]
    函数 流翻译器恐慌序列() {
        让 界面表 = 取测试界面("zh");
        让 可变 翻译器实例 = 流翻译器::新建();
        断言相等!(
            翻译器实例.翻译("thread 'main' (621725) panicked at a.rs:1:50:", &界面表),
            "线程 '主函数' 恐慌于 a.rs:1:50:"
        );
        断言相等!(
            翻译器实例.翻译(
                "index out of bounds: the len is 3 but the index is 5",
                &界面表
            ),
            "下标越界：长度是 3，但下标是 5"
        );
        断言相等!(
            翻译器实例.翻译(
                "note: run with `RUST_BACKTRACE=1` environment variable to display a backtrace",
                &界面表
            ),
            "提示：设置 RUST_BACKTRACE=1 环境变量可显示回溯"
        );
    }

    /// 框头变体：旧格式（无线程标识）与命名线程（`<unnamed>` 保留不译）
    #[测试]
    函数 流翻译器框头变体() {
        让 界面表 = 取测试界面("zh");
        让 可变 翻译器实例 = 流翻译器::新建();
        断言相等!(
            翻译器实例.翻译("thread 'main' panicked at b.rs:2:3:", &界面表),
            "线程 '主函数' 恐慌于 b.rs:2:3:"
        );
        断言相等!(
            翻译器实例.翻译("thread '<unnamed>' (42) panicked at c.rs:9:9:", &界面表),
            "线程 '<unnamed>' 恐慌于 c.rs:9:9:"
        );
        // 消息未识别（如解包无值）：原样透传，且不残留状态影响后续行
        断言相等!(
            翻译器实例.翻译("called `Option::unwrap()` on a `None` value", &界面表),
            "called `Option::unwrap()` on a `None` value"
        );
    }

    /// 六型恐慌消息：越界起点/终点、字符边界、引用单元格借用冲突两向
    #[测试]
    函数 流翻译器恐慌消息文本() {
        让 界面表 = 取测试界面("zh");
        让 框头 = "thread 'main' panicked at a.rs:1:1:";
        让 可变 翻译器实例 = 流翻译器::新建();
        让 _ = 翻译器实例.翻译(框头, &界面表);
        断言相等!(
            翻译器实例.翻译(
                "start byte index 10 is out of bounds for string of length 6",
                &界面表
            ),
            "切片起点字节索引 10 超出字符串长度 6"
        );
        让 可变 翻译器实例 = 流翻译器::新建();
        让 _ = 翻译器实例.翻译(框头, &界面表);
        断言相等!(
            翻译器实例.翻译(
                "end byte index 10 is out of bounds for string of length 6",
                &界面表
            ),
            "切片终点字节索引 10 超出字符串长度 6"
        );
        让 可变 翻译器实例 = 流翻译器::新建();
        让 _ = 翻译器实例.翻译(框头, &界面表);
        断言相等!(
            翻译器实例.翻译(
                "start byte index 1 is not a char boundary; it is inside '你' (bytes 0..3 of string)",
                &界面表
            ),
            "字节索引 1 不是字符边界；它位于 '你'（字节 0..3）内部"
        );
        让 可变 翻译器实例 = 流翻译器::新建();
        让 _ = 翻译器实例.翻译(框头, &界面表);
        断言相等!(
            翻译器实例.翻译("RefCell already borrowed", &界面表),
            "引用单元格已被借用"
        );
        让 可变 翻译器实例 = 流翻译器::新建();
        让 _ = 翻译器实例.翻译(框头, &界面表);
        断言相等!(
            翻译器实例.翻译("RefCell already mutably borrowed", &界面表),
            "引用单元格已被可变借用"
        );
    }

    /// 英文界面：恐慌输出除线程标识剥离外保持英文原文（不引入本地化偏差）
    #[测试]
    函数 流翻译器英文不变() {
        让 界面表 = 取测试界面("en");
        让 可变 翻译器实例 = 流翻译器::新建();
        断言相等!(
            翻译器实例.翻译("thread 'main' (621725) panicked at a.rs:1:50:", &界面表),
            "thread 'main' panicked at a.rs:1:50:"
        );
        断言相等!(
            翻译器实例.翻译(
                "index out of bounds: the len is 3 but the index is 5",
                &界面表
            ),
            "index out of bounds: the len is 3 but the index is 5"
        );
    }

    /// 非恐慌行回退进度翻译（完成行等本地化）
    #[测试]
    函数 流翻译器回退进度行() {
        让 界面表 = 取测试界面("zh");
        让 可变 翻译器实例 = 流翻译器::新建();
        让 输出文本 = 翻译器实例.翻译("    Finished `dev` profile [unoptimized]", &界面表);
        断言!(输出文本.包含("编译完成"), "应本地化进度行：{输出文本}");
    }

    /// 进度五种前缀：编译/检查/完成/运行/错误摘要均本地化，
    /// 错误摘要的 `could not compile … due to N` 二段短语也翻译；
    /// 无匹配行与非「无法编译」的错误行原样透传
    #[测试]
    函数 翻译进度行各前缀() {
        让 界面表 = 取测试界面("zh");
        断言!(
            翻译进度行("   Compiling serde v1.0.0", &界面表).包含("正在编译 serde")
        );
        断言!(
            翻译进度行("    Checking myapp v0.1.0", &界面表).包含("正在检查 myapp")
        );
        断言!(翻译进度行("Running `target/debug/t`", &界面表).包含("正在运行"));
        让 汇总行 = 翻译进度行(
            "error: could not compile `myapp` (bin \"myapp\") due to 2 previous errors",
            &界面表,
        );
        断言!(汇总行.包含("无法编译"), "应翻译无法编译：{汇总行}");
        断言!(汇总行.包含("2"), "应保留错误数量：{汇总行}");
        // 无法编译且无「因」尾段
        断言!(
            翻译进度行("error: could not compile `myapp`", &界面表).包含("无法编译")
        );
        // 错误行但不是「无法编译」：其余部分原样保留
        让 原样行 = 翻译进度行("error: some custom failure", &界面表);
        断言!(
            原样行.包含("some custom failure"),
            "未识别错误摘要应保留：{原样行}"
        );
        // 完全无匹配：原样返回
        断言相等!(翻译进度行("hello world", &界面表), "hello world");
    }

    /// 英文的工具通道逐字保留构建工具自己的措辞（恒等语言不得改写英文原话）
    ///
    /// 同一条链上的五个前缀键里，`warning:`/`note:`/`help:`/`Caused by:` 本来就是
    /// 构建工具原话，只有 `cargo_progress_error 键` 曾写作大写 `Error:`、
    /// `cargo_progress_finished 键` 曾写作 `Build finished {}`——两者都发生在「构建工具的
    /// 英文行被换成另一句英文」这条路径上：英语读者对照构建工具自己的输出与文档时对不上，
    /// 英文教程第十八章贴的 `Finished dev profile …` 也和实机输出不一致。
    /// 现统一为原话，此测试把口径钉住（新增前缀键时同样要能对上）。
    #[测试]
    函数 英文工具通道保留原措辞() {
        让 英文界面 = 取测试界面("en");
        让 用例集 = [
            (
                "error: could not compile `myapp`",
                "error: could not compile `myapp`",
            ),
            (
                "error: the trait bound `i32`: `MyTrait` is not satisfied",
                "error: the trait bound `i32`: `MyTrait` is not satisfied",
            ),
            (
                "    Finished `dev` profile [unoptimized + debuginfo] target(s) in 3.57s",
                "Finished `dev` profile [unoptimized + debuginfo] target(s) in 3.57s",
            ),
            ("   Compiling serde v1.0.0", "Compiling serde v1.0.0"),
            ("    Checking myapp v0.1.0", "Checking myapp v0.1.0"),
            ("Running `target/debug/t`", "Running `target/debug/t`"),
        ];
        对于 (输入行, 预期行) 在 用例集 {
            让 实得 = 翻译进度行(输入行, &英文界面);
            断言相等!(实得, 预期行, "英文进度行应保持原有措辞：{输入行}");
        }

        // 工具通道其余前缀（错误前缀之外的四个）同样逐字
        让 管理器 = 引擎库::诊断::错误消息管理器::从字符串载入(
            内置语言::获取内置数据("en").错误内容,
        )
        .期望("内置英文错误消息表应可加载");
        对于 行文本 在 [
            "warning: unused variable: `x`",
            "note: the lint level is defined here",
            "help: consider using a `let` binding",
            "Caused by: no targets specified in the manifest",
        ] {
            让 实得 = 本地化工具行(行文本, 有值(&管理器), &英文界面, "en")
                .期望("标记行应被处理");
            断言相等!(
                实得, 行文本,
                "英文工具通道不得改写已有前缀：{行文本} → {实得}"
            );
        }

        // 对照：中文仍走母语前缀（这条链不是只对英文生效）
        让 中文界面 = 取测试界面("zh");
        断言!(
            翻译进度行("error: some custom failure", &中文界面).以开头("错误："),
            "中文前缀应仍为母语"
        );
        断言!(
            翻译进度行("    Finished `dev` profile", &中文界面).包含("编译完成"),
            "中文完成行应仍为母语"
        );
    }

    /// 框头无值分支：缺尾冒号 / 空线程名 / 非框头行均不匹配，原样透传
    #[测试]
    函数 恐慌框头拒绝畸形() {
        让 界面表 = 取测试界面("zh");
        断言!(
            翻译恐慌框头("thread 'main' panicked at a.rs:1:1", &界面表).是否为无()
        );
        断言!(
            翻译恐慌框头("thread '' panicked at a.rs:1:1:", &界面表).是否为无()
        );
        断言!(翻译恐慌框头("not a panic line", &界面表).是否为无());
        // 字节索引消息：缺尾结构时返回无（不硬译半截）
        断言!(翻译字节索引消息("10 unexpected tail", &界面表, 真).是否为无());
        断言!(翻译恐慌消息("totally unknown message", &界面表).是否为无());
    }

    /// 源码行取值：0 行与越界返回无，正常行返回原文
    #[测试]
    函数 取中文源码行边界() {
        让 源码 = "第一行\n第二行\n";
        断言相等!(取中文源码行(源码, 0), 无);
        断言相等!(取中文源码行(源码, 1).作为解引用(), 有值("第一行"));
        断言相等!(取中文源码行(源码, 3), 无);
    }

    /// 产物路径解析：绝对路径原样；相对路径先查项目根；不存在再回退当前目录
    #[测试]
    函数 解析产物路径顺序() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.条目路径();
        让 绝对路径 = 如果 配置!(窗口) {
            路径缓冲::从("C:/abs/main.rs")
        } 否则 {
            路径缓冲::从("/abs/main.rs")
        };
        断言相等!(
            解析产物路径(根, &绝对路径.转有损字符串()),
            有值(绝对路径)
        );
        文件系统::写入(根.连接("in-root.rs"), b"").解包();
        断言相等!(
            解析产物路径(根, "in-root.rs"),
            有值(根.连接("in-root.rs"))
        );
        // 项目根下不存在：回退当前工作目录拼接（始终有值）
        让 实得 = 解析产物路径(根, "nowhere-12345.rs").期望("应回退当前目录");
        断言!(实得.以结尾("nowhere-12345.rs"));
    }

    /// 构造最小诊断回译上下文（列映射/行映射均为无）
    函数 最小上下文<'甲>(
        界面表: &'甲 界面::界面消息表,
        根: &'甲 路径类型,
        映射器: &'甲 映射管理器,
        源文件: &'甲 路径类型,
        源码: &'甲 文本,
    ) -> 诊断上下文<'甲> {
        诊断上下文 {
            界面表,
            语言包参数: &无,
            项目根: 根,
            映射器,
            源码,
            源文件,
            入口产物: 源文件.设扩展名("rs"),
            列位映射: 无,
            入口行映射: 无,
            项目上下文: 无,
        }
    }

    /// 非方言产物（不存在的第三方 .rs）：定位保持编译器原样，绝不误标入口文件
    #[测试]
    函数 修复位置非方言直传() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.条目路径();
        文件系统::创建所有目录(根.连接("src")).解包();
        文件系统::写入(根.连接("src/main.zh"), "函数 主函数() {}\n").解包();
        文件系统::写入(根.连接("src/main.rs"), "fn main() {}\n").解包();
        让 入口 = 根.连接("src/main.zh");
        让 映射器 = 中文映射器();
        让 界面表 = 界面::界面消息表::按语言建表("zh");
        让 共享上下文 = 最小上下文(&界面表, 根, &映射器, &入口, "函数 主函数() {}\n");
        让 可变 修复器 = 诊断定位修复器::新建(&共享上下文, "main.zh", "zh");
        让 外部路径 = 如果 配置!(窗口) {
            "C:/nonexistent-crate-9f3/src/lib.rs".转字符串()
        } 否则 {
            "/nonexistent-crate-9f3/src/lib.rs".转字符串()
        };
        让 可变 定位项 = 引擎库::诊断::诊断位置 {
            文件名称: 外部路径.克隆(),
            起始行号: 7,
            起始列号: 3,
            结束行号: 7,
            结束列号: 9,
            源码文本: 有值("orig".转字符串()),
            标签文本: 无,
            是否主因: 真,
        };
        修复器.修复位置(&可变 定位项);
        断言相等!(定位项.文件名称, 外部路径);
        断言相等!(定位项.起始行号, 7);
        断言相等!(定位项.起始列号, 3);
        断言相等!(定位项.源码文本.作为解引用(), 有值("orig"));
    }

    /// 子模块方言产物（src/数学.rs）：解析回同名 .zh 源文件并重建坐标/源码行
    #[测试]
    函数 修复位置子模块方言() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.条目路径();
        文件系统::创建所有目录(根.连接("src")).解包();
        让 子源码 = "函数 加(甲: 整数, 乙: 整数) -> 整数 { 甲 + 乙 }\n";
        文件系统::写入(根.连接("src/数学.zh"), 子源码).解包();
        文件系统::写入(根.连接("src/main.zh"), "函数 主函数() {}\n").解包();
        让 映射器 = 中文映射器();
        让 子成品 = 引擎库::转译管线(子源码, &映射器);
        文件系统::写入(根.连接("src/数学.rs"), &子成品.输出).解包();
        文件系统::写入(根.连接("src/main.rs"), "fn main() {}\n").解包();
        让 入口 = 根.连接("src/main.zh");
        让 界面表 = 界面::界面消息表::按语言建表("zh");
        让 共享上下文 = 最小上下文(&界面表, 根, &映射器, &入口, "函数 主函数() {}\n");
        让 可变 修复器 = 诊断定位修复器::新建(&共享上下文, "main.zh", "zh");
        让 可变 定位项 = 引擎库::诊断::诊断位置 {
            文件名称: "src/数学.rs".转字符串(),
            起始行号: 1,
            起始列号: 1,
            结束行号: 1,
            结束列号: 1,
            源码文本: 无,
            标签文本: 无,
            是否主因: 真,
        };
        修复器.修复位置(&可变 定位项);
        断言相等!(定位项.文件名称, "数学.zh");
        断言相等!(
            定位项.源码文本.作为解引用(),
            有值(子源码.裁剪右侧())
        );
    }

    /// 诊断归属按**被编译目标**而非请求文件：请求工具文件时
    /// 构建仍编译入口产物，那里的报错属于主入口，
    /// 不得因为请求的是工具文件就标成工具文件（旧实现硬编码入口为
    /// 入口产物，反过来把非入口请求的其他文件报错全部误归入口）
    #[测试]
    函数 修复位置按编译目标归属() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.条目路径();
        文件系统::创建所有目录(根.连接("src")).解包();
        让 主源码 = "函数 主函数() { 让 甲 = 1; }\n";
        让 工具源码 = "函数 加(甲: 整数) -> 整数 { 甲 }\n";
        文件系统::写入(根.连接("src/main.zh"), 主源码).解包();
        文件系统::写入(根.连接("src/main.rs"), "fn main() { let a = 1; }\n").解包();
        文件系统::写入(根.连接("src/工具.zh"), 工具源码).解包();
        文件系统::写入(根.连接("src/工具.rs"), "fn add(a: i32) -> i32 { a }\n").解包();
        // 请求的是工具源文件（其产物为入口），主产物的报错属于另一个目标文件
        让 入口 = 根.连接("src/工具.zh");
        让 映射器 = 中文映射器();
        让 界面表 = 界面::界面消息表::按语言建表("zh");
        让 共享上下文 = 最小上下文(&界面表, 根, &映射器, &入口, 工具源码);
        让 可变 修复器 = 诊断定位修复器::新建(&共享上下文, "工具.zh", "zh");
        让 可变 定位项 = 引擎库::诊断::诊断位置 {
            文件名称: "src/main.rs".转字符串(),
            起始行号: 1,
            起始列号: 19,
            结束行号: 1,
            结束列号: 20,
            源码文本: 无,
            标签文本: 无,
            是否主因: 真,
        };
        修复器.修复位置(&可变 定位项);
        断言相等!(
            定位项.文件名称, "main.zh",
            "应归到报错所在的源文件"
        );
        断言相等!(
            定位项.源码文本.作为解引用(),
            有值(主源码.裁剪右侧()),
            "源码行取自主入口而非工具文件"
        );
    }

    /// 未解析导入的构建 JSON：翻译器返回存在教学诊断（真），并提取未声明包
    #[测试]
    函数 翻译诊断未解析导入教学() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.条目路径();
        文件系统::创建所有目录(根.连接("src")).解包();
        文件系统::写入(根.连接("src/main.zh"), "函数 主函数() {}\n").解包();
        文件系统::写入(根.连接("src/main.rs"), "fn main() {}\n").解包();
        让 入口 = 根.连接("src/main.zh");
        让 映射器 = 中文映射器();
        让 界面表 = 界面::界面消息表::按语言建表("zh");
        让 共享上下文 = 最小上下文(&界面表, 根, &映射器, &入口, "函数 主函数() {}\n");
        让 诊断文本 = r#"{"reason":"compiler-message","message":{"message":"unresolved import `serde_json`","code":{"code":"E0432"},"level":"error","spans":[],"children":[]}}"#;
        断言!(翻译编译诊断(
            诊断文本, "", &共享上下文, 假, 真, 假
        ));
    }

    /// 项目内语言包消息表损坏：打印加载警告后降级内置表，
    /// 诊断仍正常展示（不因消息文件损坏阻断）
    #[测试]
    函数 本地错误表损坏回退() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.条目路径();
        文件系统::创建所有目录(根.连接("src")).解包();
        文件系统::创建所有目录(根.连接("lang-packs/zh")).解包();
        文件系统::写入(
            根.连接("lang-packs/zh/errors.toml"),
            "this is = = not valid toml [[[\n",
        )
        .解包();
        文件系统::写入(根.连接("src/main.zh"), "函数 主函数() {}\n").解包();
        文件系统::写入(根.连接("src/main.rs"), "fn main() {}\n").解包();
        让 入口 = 根.连接("src/main.zh");
        让 映射器 = 中文映射器();
        让 界面表 = 界面::界面消息表::按语言建表("zh");
        让 共享上下文 = 最小上下文(&界面表, 根, &映射器, &入口, "函数 主函数() {}\n");
        让 诊断文本 = r#"{"reason":"compiler-message","message":{"message":"unresolved import `serde_json`","code":{"code":"E0432"},"level":"error","spans":[],"children":[]}}"#;
        断言!(翻译编译诊断(
            诊断文本, "", &共享上下文, 假, 真, 假
        ));
    }

    /// 无可解析诊断时：编译成功打印成功行（静默时不出声）；
    /// 编译失败输出原始构建摘要（流式时跳过，避免运行时失败误标）
    #[测试]
    函数 翻译诊断空分支() {
        让 临时 = 临时文件::建临时目录().解包();
        让 根 = 临时.条目路径();
        文件系统::创建所有目录(根.连接("src")).解包();
        文件系统::写入(根.连接("src/main.zh"), "函数 主函数() {}\n").解包();
        文件系统::写入(根.连接("src/main.rs"), "fn main() {}\n").解包();
        让 入口 = 根.连接("src/main.zh");
        让 映射器 = 中文映射器();
        让 界面表 = 界面::界面消息表::按语言建表("zh");
        让 共享上下文 = 最小上下文(&界面表, 根, &映射器, &入口, "函数 主函数() {}\n");
        // 成功 + 非静默
        断言!(!翻译编译诊断(
            "", "", &共享上下文, 真, 假, 假
        ));
        // 成功 + 静默
        断言!(!翻译编译诊断(
            "", "", &共享上下文, 真, 真, 假
        ));
        // 失败 + 非流式：输出构建摘要
        断言!(!翻译编译诊断(
            "",
            "linker `cc` not found",
            &共享上下文,
            假,
            真,
            假
        ));
        // 失败 + 流式：跳过摘要
        断言!(!翻译编译诊断(
            "",
            "should not appear",
            &共享上下文,
            假,
            真,
            真
        ));
        // 非 JSON 杂讯不构成诊断：成功路径
        断言!(!翻译编译诊断(
            "   Compiling t v0.1.0",
            "",
            &共享上下文,
            真,
            真,
            假
        ));
    }

    /// 内置中文消息表（纯文本通道与 JSON 通道共用同一张表）
    函数 中文错误管理器() -> 引擎库::诊断::错误消息管理器 {
        引擎库::诊断::错误消息管理器::从字符串载入(
            内置语言::获取内置数据("zh").错误内容,
        )
        .期望("内置中文错误消息表应可加载")
    }

    /// 构建工具自身错误（纯文本通道）本地化：新手高频的四类都要换译
    #[测试]
    函数 本地化工具行翻译编译错误() {
        让 管理器 = 中文错误管理器();
        让 界面表 = 取测试界面("zh");
        让 用例集 = [
            (
                "error: could not find `Cargo.toml` in `/home/oop` or any parent directory",
                "错误：在「/home/oop」及其上级目录中都未找到 `Cargo.toml`",
            ),
            (
                "error: failed to parse manifest at `/x/Cargo.toml`",
                "错误：解析清单文件失败：「/x/Cargo.toml」",
            ),
            (
                "error: no targets specified in the manifest",
                "错误：清单中没有指定编译目标",
            ),
            (
                "error: no matching package named `foo` found",
                "错误：找不到名为「foo」的包",
            ),
            (
                "error: current package believes it's in a workspace when it's not:",
                "错误：当前包以为自己在某个工作空间内，但实际不是：",
            ),
            // 工具链包装器未配默认工具链：新手装完 Rust 后撞上的第一句，
            // 工具名走通配段捕获，行首前缀同样要本地化
            (
                "error: rustup could not choose a version of cargo to run, because one wasn't specified explicitly, and no default is configured.",
                "错误：rustup 无法为「cargo」选出要运行的版本：未显式指定，且没有配置默认工具链。",
            ),
            (
                "help: run 'rustup default stable' to download the latest stable release of Rust and set it as your default toolchain.",
                "提示：运行「rustup default stable」下载最新的 Rust 稳定版，并把它设为默认工具链。",
            ),
        ];
        对于 (输入行, 预期行) 在 用例集 {
            让 实得 = 本地化工具行(输入行, 有值(&管理器), &界面表, "zh")
                .解包或用否则(|| 恐慌!("应命中消息表：{输入行}"));
            断言相等!(实得, 预期行, "行：{输入行}");
        }
    }

    /// 未命中的构建错误行：原文照旧输出（绝不吞诊断）+ 前缀本地化 + 登记待译
    #[测试]
    函数 本地化工具行回退并记录缺口() {
        使用 引擎库::诊断::待译清单;
        让 管理器 = 中文错误管理器();
        让 界面表 = 取测试界面("zh");
        // 独占语言代码：登记表是进程全局的，避免与其他并行测试互相干扰
        让 缺口语言 = "tool-gap-test-lang";
        让 输入行 = "error: unsupported subfeatures in target `x86_64-unknown-linux`";
        让 实得 = 本地化工具行(输入行, 有值(&管理器), &界面表, 缺口语言)
            .期望("标记行应被处理");
        断言相等!(
            实得,
            格式化!("错误：{}", 输入行.裁剪左侧匹配("error: ")),
            "未译句子应保留原文，仅换行首前缀"
        );
        断言!(
            待译清单::查看缺口()
                .迭代()
                .任意(|(语言码, 通道, _, 消息原文)| 语言码 == 缺口语言
                    && 通道 == 待译清单::工具级
                    && 消息原文.以开头("unsupported subfeatures")),
            "未命中应登记工具通道待译清单"
        );
        // 无消息表时完全不介入：避免把被运行程序自己打印的错误行误标
        断言相等!(
            本地化工具行(输入行, 无, &界面表, 缺口语言),
            无,
            "映射器为无时应交回原有流程"
        );
        // 已有专门处理的固定汇总句：交回进度行翻译器
        断言相等!(
            本地化工具行(
                "error: could not compile `t` (bin \"t\") due to 1 previous error",
                有值(&管理器),
                &界面表,
                缺口语言,
            ),
            无
        );
    }

    /// 英文（恒等语言）未命中消息表：原句就是母语输出，不得登记待译
    ///
    /// 起因：英文包不携带「消息翻译」节，按消息查询在英文下永远未命中。
    /// 旧行为于是给每句英文都记一条缺口：英语用户每次报错都多看到一行
    /// 待译提示（它在英文下恒为真），同时往用户主目录的待译清单堆英文原句
    ///（实测积到 1000+ 行且永远补不动）。
    /// 对照分支拿同一张英文消息表只换登记语言：非恒等语言必须照记，
    /// 证明「不登记」只源于语言判定，不是这句消息本身被过滤。
    #[测试]
    函数 恒等语言不记录缺口() {
        使用 引擎库::诊断::待译清单;
        让 英文管理器 = 引擎库::诊断::错误消息管理器::从字符串载入(
            内置语言::获取内置数据("en").错误内容,
        )
        .期望("内置英文错误消息表应可加载");
        让 英文界面 = 取测试界面("en");
        让 输入行 = "error: crate name `计算器` passed to `--extern` is not a valid ASCII identifier";

        让 实得 = 本地化工具行(输入行, 有值(&英文管理器), &英文界面, "en")
            .期望("标记行应被处理");
        // 正文与前缀都逐字保留构建工具原句：英文的错误前缀与
        // 同路径的警告/提示前缀一样是原话的小写形
        断言相等!(
            实得, "error: crate name `计算器` passed to `--extern` is not a valid ASCII identifier",
            "英文下应逐字保留原有句子"
        );
        断言!(
            !待译清单::查看缺口()
                .迭代()
                .任意(|(语言码, _, _, 消息原文)| 语言码 == "en"
                    && 消息原文.包含("--extern")),
            "恒等语言未命中不算待译，否则英语用户被告知去补一份不存在的译文"
        );

        // 对照：同一张表、同一句，只把登记语言换成非恒等→必须入库
        让 对照语言 = "tool-identity-contrast";
        本地化工具行(输入行, 有值(&英文管理器), &英文界面, 对照语言)
            .期望("标记行应被处理");
        断言!(
            待译清单::查看缺口()
                .迭代()
                .任意(|(语言码, 通道, _, _)| 语言码 == 对照语言
                    && 通道 == 待译清单::工具级),
            "非恒等语言未命中仍应登记工具通道待译清单"
        );

        // 中文已补该条译文：命中消息表，既不回退原文也不记待译
        让 中文实得 =
            本地化工具行(输入行, 有值(&中文错误管理器()), &取测试界面("zh"), "zh")
                .期望("中文应命中消息表");
        断言!(
            中文实得.包含("不是合法的 ASCII 标识符"),
            "中文应给母语译文：{中文实得}"
        );
    }

    /// 构建错误链：`Caused by:` 标签行与缩进续行都要换译
    ///
    /// 构建工具把因由拆成「标记行 + 缩进行」两行输出，只处理标记行会留下
    /// 整段英文尾巴；而缩进行的查表只在命中时换译，未命中不得登记待译
    ///（缩进输出也可能是被运行程序自己的打印）。
    #[测试]
    函数 本地化工具行处理原因链() {
        使用 引擎库::诊断::待译清单;
        让 管理器 = 中文错误管理器();
        让 界面表 = 取测试界面("zh");
        断言相等!(
            本地化工具行("Caused by:", 有值(&管理器), &界面表, "zh").作为解引用(),
            有值("原因："),
            "光杆标记行也应换标签（正文在下一行）"
        );
        断言相等!(
            本地化工具行(
                "  failed to read `/no/such/dir/Cargo.toml`",
                有值(&管理器),
                &界面表,
                "zh"
            )
            .作为解引用(),
            有值("  读取「/no/such/dir/Cargo.toml」失败"),
            "缩进续行命中时应换译并保留缩进"
        );
        让 缺口语言 = "tool-indent-gap-lang";
        断言相等!(
            本地化工具行(
                "  some indented program output",
                有值(&管理器),
                &界面表,
                缺口语言
            ),
            无,
            "未命中的缩进行应交回原有流程"
        );
        断言!(
            !待译清单::查看缺口()
                .迭代()
                .任意(|(语言码, _, _, _)| 语言码 == 缺口语言),
            "缩进行未命中不得登记待译清单"
        );
    }

    /// 整段构建输出：标记行走消息表，进度行仍走进度翻译，其他行原样
    #[测试]
    函数 本地化工具文本保留进度与普通行() {
        让 管理器 = 中文错误管理器();
        让 界面表 = 取测试界面("zh");
        让 原文 = "error: no targets specified in the manifest\n\
                    note: this sentence is definitely not in any message table\n\
                    未命中的普通说明行";
        让 实得 = 本地化工具文本(原文, &管理器, &界面表, "zh");
        让 行列表: 向量<&文本> = 实得.逐行().收集();
        断言相等!(行列表[0], "错误：清单中没有指定编译目标");
        // 提示句不在表内：保留原文，只换前缀
        断言相等!(
            行列表[1],
            "说明：this sentence is definitely not in any message table"
        );
        断言相等!(行列表[2], "未命中的普通说明行");
    }
}


