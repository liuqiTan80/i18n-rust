//! 第三方库共享注册中心模块
//!
//! 实现 `rzc crate` 子命令：检索、安装、列出、移除、更新、发布。
//! 注册中心即一个版本控制仓库（代码托管平台或任意版本控制可达地址 / 本地路径），
//! 根含索引文件，映射按语言与库名分层存放
//! （与语言包内的映射目录结构一致）。
//!
//! 远程获取复用语言管理器的仓库源 / 临时目录 / 压缩包拉取能力；
//! 本地路径注册中心直接复用目录，无需网络。

使用 序列化属性::{可反序列化, 可序列化};
使用 标准库::集合::有序映射;
使用 标准库::路径::{路径类型, 路径缓冲};
使用 标准库::进程::命令;

使用 包::界面;
使用 包::语言管理::{仓库源项, 临时目录句柄, 校验语言代码};

/// 默认注册中心地址（可用专门的环境变量覆盖）。
/// 注册中心已合并进主仓库，位于 `third-party/` 子目录；
/// 故默认即指向主仓库，克隆后从 `third-party/index.json` 读取。
常量 默认包仓库地址: &文本 = "https://gitcode.com/tan80/i18n-rust";

/// 单条映射在注册中心的索引条目
#[派生(可序列化, 可反序列化, 克隆, 可调试)]
公开 结构体 映射条目 {
    /// 库名（连字符归一为下划线）
    #[序列化属性(重命名 = "crate_name")]
    公开 包名: 字符串,
    /// 语言代码
    #[序列化属性(重命名 = "lang")]
    公开 语言代码: 字符串,
    /// 映射版本（语义自定，默认 1.0）
    #[序列化属性(重命名 = "version")]
    公开 版本: 字符串,
    /// 译者署名
    #[序列化属性(重命名 = "author")]
    公开 作者: 字符串,
    /// 映射文件许可证（默认宽松许可证）
    #[序列化属性(重命名 = "license")]
    公开 许可证: 字符串,
    /// 质量分（0–1，发布校验通过即 1.0）
    #[序列化属性(重命名 = "quality")]
    公开 质量分: 浮点数,
    /// 下载计数
    #[序列化属性(重命名 = "downloads")]
    公开 下载计数: 无符号长整数,
    /// 映射文件在仓库内的相对路径
    #[序列化属性(重命名 = "file")]
    公开 映射文件: 字符串,
    /// 最后更新日期
    #[序列化属性(重命名 = "updated")]
    公开 更新日期: 字符串,
}

/// 注册中心索引文件结构
#[派生(可序列化, 可反序列化, 默认)]
公开 结构体 包索引 {
    #[序列化属性(重命名 = "registry")]
    公开 仓库名: 字符串,
    #[序列化属性(重命名 = "updated")]
    公开 更新日期: 字符串,
    #[序列化属性(重命名 = "mappings")]
    公开 映射清单: 向量<映射条目>,
}

/// 注册中心仓库地址：专门的环境变量优先，否则默认地址。
///
/// 默认情况下，若当前工作目录是主仓库源码树（存在 `third-party/index.json`），
/// 则直接使用该本地子目录，离线即可检索/安装；否则回退到远端主仓库。
函数 仓库地址() -> 字符串 {
    如果让 成功(环境值) = 标准库::环境::环境变量("RZ_CRATE_REPO") {
        让 规范值 = 环境值.裁剪().裁剪右侧匹配('/').转字符串();
        如果 !规范值.是否为空() {
            返回 规范值;
        }
    }
    如果 路径类型::新建("third-party").连接("index.json").是否为文件() {
        返回 "third-party".转字符串();
    }
    默认包仓库地址.转字符串()
}

/// 构造注册中心源（与语言安装同源回退策略一致）
函数 收集仓库源() -> 向量<仓库源项> {
    向量![仓库源项::从地址(&仓库地址())]
}

/// 注册中心在仓库内的实际目录。合并进主仓库后位于 `third-party/` 子目录，
/// 独立仓库则直接在根；两种布局都兼容。
函数 仓库子目录(仓库根: &路径类型) -> 路径缓冲 {
    让 嵌套目录 = 仓库根.连接("third-party");
    如果 嵌套目录.连接("index.json").是否为文件() {
        嵌套目录
    } 否则 {
        仓库根.转路径缓冲()
    }
}

/// 拉取注册中心仓库到可访问的本地路径
///
/// - 本地路径注册中心：直接复用，无需下载；
/// - 远程地址：优先浅克隆，失败回退压缩包下载。
///
/// 返回临时句柄（持有生命周期）与仓库根路径。
函数 拉取仓库() -> 错误处理::结果<(临时目录句柄, 路径缓冲)> {
    让 地址 = 仓库地址();
    // 本地路径注册中心：直接复用（返回的临时句柄为占位，不影响真实目录）
    如果 路径类型::新建(&地址).是否为目录() {
        让 临时 = 临时目录句柄::新建()?;
        返回 成功((临时, 路径缓冲::从(&地址)));
    }
    让 临时 = 临时目录句柄::新建()?;
    让 源项 = &收集仓库源()[0];
    让 克隆目录 = 临时.存放路径().连接("repo");
    让 克隆成功 = 命令::新建("git")
        .单参数("clone")
        .单参数("--depth")
        .单参数("1")
        .单参数(&地址)
        .单参数(&克隆目录)
        .标准输出(标准库::进程::标准流::空流())
        .标准错误(标准库::进程::标准流::空流())
        .进程状态()
        .映射(|退出状态值| 退出状态值.退出成功())
        .解包或用(假);
    如果 克隆成功 && 仓库子目录(&克隆目录).连接("index.json").是否为文件() {
        返回 成功((临时, 克隆目录));
    }
    // 回退压缩包下载（压缩包拉取已处理单层根目录下沉）
    让 仓库目录 = 包::语言管理::拉取仓库压缩包(源项, &临时)?;
    如果 仓库子目录(&仓库目录).连接("index.json").是否为文件() {
        返回 成功((临时, 仓库目录));
    }
    错误处理::错误中止!(
        "注册中心索引 index.json 未找到（仓库：{}）",
        仓库地址()
    )
}

/// 读取索引文件（缺失时返回空索引）
函数 读取索引(路径: &路径类型) -> 错误处理::结果<包索引> {
    如果 !路径.是否为文件() {
        返回 成功(包索引::默认值());
    }
    让 内容串 = 标准库::文件系统::读取字符串(路径)?;
    让 索引对象: 包索引 = JSON序列化::解析字符串(&内容串).映射错误(|错误值| {
        错误处理::错误处理!(
            "{}",
            界面::界面消息表::全局表().取带参消息(
                "crate_index_parse_failed",
                &[&错误值.转字符串()]
            )
        )
    })?;
    成功(索引对象)
}

/// 写入索引文件（美化格式）
函数 写入索引(路径: &路径类型, 索引对象: &包索引) -> 错误处理::结果<空> {
    如果让 有值(父级) = 路径.父目录() {
        标准库::文件系统::递归创建目录(父级)?;
    }
    标准库::文件系统::写入(路径, JSON序列化::美化输出(索引对象)?)?;
    成功(())
}

/// 已安装清单路径：~/.rz/crate-registry.json
函数 已装清单路径() -> 路径缓冲 {
    包::语言管理::全局语言目录()
        .父目录()
        .映射(|父级| 父级.连接("crate-registry.json"))
        .解包或用否则(|| 路径缓冲::从("crate-registry.json"))
}

/// 读取已安装清单（(库, 语言) → 条目）
函数 读取已装清单() -> 有序映射<(字符串, 字符串), 映射条目> {
    让 路径 = 已装清单路径();
    如果让 成功(内容串) = 标准库::文件系统::读取字符串(&路径)
        && 让 成功(清单) = JSON序列化::解析字符串::<向量<映射条目>>(&内容串)
    {
        返回 清单
            .消费迭代()
            .映射(|条目值| ((条目值.包名.克隆值(), 条目值.语言代码.克隆值()), 条目值))
            .收集();
    }
    有序映射::新建()
}

/// 写入已安装清单
函数 写入已装清单(清单映射: &有序映射<(字符串, 字符串), 映射条目>) -> 错误处理::结果<空> {
    让 路径 = 已装清单路径();
    如果让 有值(父级) = 路径.父目录() {
        标准库::文件系统::递归创建目录(父级)?;
    }
    让 列表: 向量<映射条目> = 清单映射.值().克隆副本().收集();
    标准库::文件系统::写入(路径, JSON序列化::美化输出(&列表)?)?;
    成功(())
}

/// `rzc crate search [关键词]`：检索注册中心索引
公开 函数 检索(关键词: 选项<&文本>) -> 错误处理::结果<空> {
    让 界面表 = 界面::界面消息表::全局表();
    让 (_临时, 根目录) = 拉取仓库()?;
    让 注册根 = 仓库子目录(&根目录);
    让 索引对象 = 读取索引(&注册根.连接("index.json"))?;
    让 小写关键词 = 关键词.映射(|原文| 原文.转小写()).取值或默认();
    让 可变 匹配项: 向量<&映射条目> = 索引对象
        .映射清单
        .迭代()
        .过滤(|条目值| {
            小写关键词.是否为空()
                || 条目值.包名.转小写().包含(&小写关键词)
                || 条目值.语言代码.转小写().包含(&小写关键词)
                || 条目值.作者.转小写().包含(&小写关键词)
        })
        .收集();
    匹配项.排序_by(|甲, 乙| {
        乙.下载计数
            .比较(&甲.下载计数)
            .然后(甲.包名.比较(&乙.包名))
    });
    如果 匹配项.是否为空() {
        打印行!("{}", 界面表.取消息("crate_search_empty"));
        返回 成功(());
    }
    对于 条目值 在 &匹配项 {
        打印行!(
            "  {:<18} {:<6} v{:<6} 下载 {:>5}  {}",
            条目值.包名,
            条目值.语言代码,
            条目值.版本,
            条目值.下载计数,
            条目值.作者
        );
    }
    打印行!();
    打印行!("{}", 界面表.取消息("crate_search_hint"));
    成功(())
}

/// 校验库名可作为全局语言包内 `crates/<库名>.toml` 的文件名
///
/// 只允许 ASCII 字母、数字、连字符与下划线，拒绝空名与前导 `-`
/// （避免被后续命令当作选项），长度上限 64 与官方注册中心的包名规则一致。
/// 库名参与路径拼接：未校验时 `../` 可写/删全局语言目录外的任意 `.toml`。
函数 校验库名(包名: &文本) -> 错误处理::结果<空> {
    让 界面表 = 界面::界面消息表::全局表();
    如果 包名.是否为空() {
        错误处理::错误中止!("{}", 界面表.取消息("mapping_crate_empty"));
    }
    让 合法 = 包名.元素数() <= 64
        && !包名.以开头("-")
        && 包名
            .逐字符()
            .全部(|本字| 本字.是ASCII字母数字() || 本字 == '-' || 本字 == '_');
    如果 !合法 {
        错误处理::错误中止!("{}", 界面表.取带参消息("mapping_crate_invalid", &[包名]));
    }
    成功(())
}

/// 校验语言代码与库名（`rzc crate` 各子命令的公共入口校验）
函数 校验语言与库名(语言代码: &文本, 包名: &文本) -> 错误处理::结果<空> {
    让 界面表 = 界面::界面消息表::全局表();
    如果 !校验语言代码(语言代码) {
        错误处理::错误中止!("{}", 界面表.取带参消息("invalid_lang_code", &[语言代码]));
    }
    校验库名(包名)
}

/// 全局语言包内某语言的社区映射目录
函数 映射目录(语言代码: &文本) -> 路径缓冲 {
    包::语言管理::全局语言目录().连接(语言代码).连接("crates")
}

/// 全局语言包内的映射安装路径
函数 映射安装路径(语言代码: &文本, 包名: &文本) -> 路径缓冲 {
    映射目录(语言代码).连接(格式化!("{}.toml", 包名))
}

/// 相对路径按当前目录补成绝对路径（取不到当前目录时原样返回）
函数 绝对化路径(路径值: &路径类型) -> 路径缓冲 {
    如果 路径值.是否绝对() {
        返回 路径值.转路径缓冲();
    }
    标准库::环境::当前目录()
        .映射(|当前目录| 当前目录.连接(路径值))
        .解包或用否则(|_| 路径值.转路径缓冲())
}

/// 目标路径（含尚未创建的末段）是否仍在全局语言目录子树内
///
/// 词法校验已拒绝 `..`；这里再解析真实路径做纵深防御，防止语言目录本身
/// 被替换为指向别处的符号链接。路径尚不存在时回退到父目录的规范路径。
函数 在全局语言目录内(路径值: &路径类型) -> 布尔 {
    让 根 = 绝对化路径(&包::语言管理::全局语言目录());
    让 规范根 = 根.规范路径().解包或用否则(|_| 根.克隆值());
    让 目标 = 绝对化路径(路径值);
    让 规范值 = 目标.规范路径().解包或用否则(|_| {
        目标
            .父目录()
            .映射(|父级| 父级.规范路径().解包或用否则(|_| 父级.转路径缓冲()))
            .解包或用否则(|| 目标.克隆值())
    });
    规范值.以开头(&规范根)
}

/// 将索引文件中（第三方可控）的映射相对路径安全解析到注册中心根下。
///
/// 复用语言管理器的安全条目路径校验（拒空/绝对/上跳/盘符，
/// 与压缩包条目名同一已审清洗器），并二次确认结果仍在注册根子树内——防恶意
/// 索引的映射文件字段借复制文件把仓库外的任意本地文件读入安装位。非法即 `无`。
函数 解析映射源(注册根: &路径类型, 映射文件: &文本) -> 选项<路径缓冲> {
    让 相对路径 = 包::语言管理::安全条目路径(映射文件)?;
    让 源路径 = 注册根.连接(相对路径);
    源路径.以开头(注册根).然后有值(源路径)
}

/// `rzc crate install <库> --lang <语言> [--force]`：拉取单个映射
公开 函数 安装(包名: &文本, 语言代码: &文本, 强制: 布尔) -> 错误处理::结果<空> {
    让 界面表 = 界面::界面消息表::全局表();
    校验语言与库名(语言代码, 包名)?;
    让 (_临时, 根目录) = 拉取仓库()?;
    让 注册根 = 仓库子目录(&根目录);
    让 索引对象 = 读取索引(&注册根.连接("index.json"))?;
    让 条目值 = 索引对象
        .映射清单
        .迭代()
        .查找(|候选条目| 候选条目.包名 == 包名 && 候选条目.语言代码 == 语言代码)
        .缺值转错(|| {
            错误处理::错误处理!(
                "{}",
                界面表.取带参消息("crate_not_found", &[包名, 语言代码])
            )
        })?;
    让 源路径 = 解析映射源(&注册根, &条目值.映射文件).缺值转错(|| {
        错误处理::错误处理!(
            "{}",
            界面表.取带参消息("crate_file_missing", &[&条目值.映射文件])
        )
    })?;
    如果 !源路径.是否为文件() {
        错误处理::错误中止!(
            "{}",
            界面表.取带参消息("crate_file_missing", &[&条目值.映射文件])
        );
    }
    让 目标目录 = 映射目录(语言代码);
    让 目标路径 = 映射安装路径(语言代码, 包名);
    如果 !在全局语言目录内(&目标路径) {
        错误处理::错误中止!(
            "{}",
            界面表.取带参消息("mapping_crate_invalid", &[包名])
        );
    }
    标准库::文件系统::递归创建目录(&目标目录)?;
    如果 目标路径.存在() && !强制 {
        错误处理::错误中止!(
            "{}",
            界面表.取带参消息("crate_already_installed", &[包名, 语言代码])
        );
    }
    标准库::文件系统::复制文件(&源路径, &目标路径)?;
    让 可变 已装清单 = 读取已装清单();
    已装清单.置入((包名.转字符串(), 语言代码.转字符串()), 条目值.克隆值());
    写入已装清单(&已装清单)?;
    打印行!(
        "{}",
        界面表.取带参消息(
            "crate_installed",
            &[包名, 语言代码, &目标路径.展示().转字符串()]
        )
    );
    成功(())
}

/// `rzc crate list`：列出已安装的社区映射
公开 函数 列出() -> 错误处理::结果<空> {
    让 界面表 = 界面::界面消息表::全局表();
    让 已装清单 = 读取已装清单();
    如果 已装清单.是否为空() {
        打印行!("{}", 界面表.取消息("crate_list_empty"));
        返回 成功(());
    }
    打印行!(
        "{}",
        界面表.取带参消息("crate_list_header", &[&已装清单.长度().转字符串()])
    );
    对于 ((包名, 语言代码), 条目值) 在 &已装清单 {
        打印行!(
            "  {:<18} {:<6} v{}  {}",
            包名,
            语言代码,
            条目值.版本,
            条目值.作者
        );
    }
    成功(())
}

/// `rzc crate remove <库> --lang <语言>`：删除已安装映射
公开 函数 移除已装(包名: &文本, 语言代码: &文本) -> 错误处理::结果<空> {
    让 界面表 = 界面::界面消息表::全局表();
    校验语言与库名(语言代码, 包名)?;
    让 目标路径 = 映射安装路径(语言代码, 包名);
    如果 !在全局语言目录内(&目标路径) {
        错误处理::错误中止!(
            "{}",
            界面表.取带参消息("mapping_crate_invalid", &[包名])
        );
    }
    如果 目标路径.存在() {
        标准库::文件系统::删除文件(&目标路径)?;
    }
    让 可变 已装清单 = 读取已装清单();
    如果 已装清单
        .移除(&(包名.转字符串(), 语言代码.转字符串()))
        .是否为有值()
    {
        写入已装清单(&已装清单)?;
    }
    打印行!(
        "{}",
        界面表.取带参消息("crate_removed", &[包名, 语言代码])
    );
    成功(())
}

/// `rzc crate update`：按清单重新拉取所有已安装映射（获取他人更新）
公开 函数 更新() -> 错误处理::结果<空> {
    让 界面表 = 界面::界面消息表::全局表();
    让 已装清单 = 读取已装清单();
    如果 已装清单.是否为空() {
        打印行!("{}", 界面表.取消息("crate_list_empty"));
        返回 成功(());
    }
    让 (_临时, 根目录) = 拉取仓库()?;
    让 注册根 = 仓库子目录(&根目录);
    让 索引对象 = 读取索引(&注册根.连接("index.json"))?;
    让 可变 计数: 无符号机器整数 = 0;
    对于 (包名, 语言代码) 在 已装清单.键() {
        // 清单是本地文件，可能被篡改：非法条目跳过而不是拼出目录外路径
        如果 校验语言与库名(语言代码, 包名).是否为错误() {
            继续;
        }
        如果让 有值(条目值) = 索引对象
            .映射清单
            .迭代()
            .查找(|候选条目| &候选条目.包名 == 包名 && &候选条目.语言代码 == 语言代码)
        {
            让 有值(源路径) = 解析映射源(&注册根, &条目值.映射文件) 否则 {
                继续;
            };
            如果 源路径.是否为文件() {
                让 目标目录 = 映射目录(语言代码);
                让 目标路径 = 映射安装路径(语言代码, 包名);
                如果 !在全局语言目录内(&目标路径) {
                    继续;
                }
                标准库::文件系统::递归创建目录(&目标目录)?;
                标准库::文件系统::复制文件(&源路径, 目标路径)?;
                计数 += 1;
            }
        }
    }
    打印行!(
        "{}",
        界面表.取带参消息(
            "crate_updated",
            &[&计数.转字符串(), &已装清单.长度().转字符串()]
        )
    );
    成功(())
}

/// `rzc crate publish <库> --lang <语言> [--file <路径>] [--author <名>]`：上传映射
公开 函数 发布(
    包名: &文本,
    语言代码: &文本,
    指定文件: 选项<路径缓冲>,
    作者: 选项<&文本>,
) -> 错误处理::结果<空> {
    让 界面表 = 界面::界面消息表::全局表();
    // 发布路径同样由库名/语言代码拼接（本地注册中心直写），入口统一校验
    校验语言与库名(语言代码, 包名)?;
    // 1. 定位待发布的映射文件
    让 源路径 = 解析发布文件(包名, 语言代码, 指定文件)?;
    // 2. 质量门禁：配置可解析 + 节名合法（重复键解析即失败）
    让 内容串 = 标准库::文件系统::读取字符串(&源路径)?;
    校验映射表(&内容串)?;
    // 3. 写入注册中心（本地路径直写；远程地址克隆后提交推送）
    让 仓库地址值 = 仓库地址();
    让 署名 = 作者
        .映射(字符串::从)
        .或用否则(取提交者名)
        .解包或用否则(|| "anonymous".转字符串());
    如果 路径类型::新建(&仓库地址值).是否为目录() {
        写入本地仓库(
            路径类型::新建(&仓库地址值),
            包名,
            语言代码,
            &内容串,
            &署名,
        )?;
    } 否则 {
        写入远程仓库(&仓库地址值, 包名, 语言代码, &内容串, &署名)?;
    }
    打印行!(
        "{}",
        界面表.取带参消息("crate_published", &[包名, 语言代码])
    );
    成功(())
}

/// 解析待发布文件：显式文件优先，否则按常见位置查找
函数 解析发布文件(
    包名: &文本,
    语言代码: &文本,
    指定文件: 选项<路径缓冲>,
) -> 错误处理::结果<路径缓冲> {
    让 界面表 = 界面::界面消息表::全局表();
    如果让 有值(文件值) = 指定文件 {
        如果 文件值.是否为文件() {
            返回 成功(文件值);
        }
        错误处理::错误中止!(
            "{}",
            界面表.取带参消息(
                "crate_publish_file_missing",
                &[&文件值.展示().转字符串()]
            )
        );
    }
    让 候选路径 = [
        包::语言管理::全局语言目录()
            .连接(语言代码)
            .连接("crates")
            .连接(格式化!("{}.toml", 包名)),
        包::语言包根目录(路径类型::新建("."))
            .连接(语言代码)
            .连接("crates")
            .连接(格式化!("{}.toml", 包名)),
        路径缓冲::从(格式化!("{}.toml", 包名)),
        路径缓冲::从(语言代码)
            .连接("crates")
            .连接(格式化!("{}.toml", 包名)),
    ];
    对于 候选 在 &候选路径 {
        如果 候选.是否为文件() {
            返回 成功(候选.克隆值());
        }
    }
    错误处理::错误中止!(
        "{}",
        界面表.取带参消息("crate_publish_not_found", &[包名, 语言代码])
    );
}

/// 质量门禁：映射文件必须是合法配置表格，且仅含允许的节
函数 校验映射表(内容串: &文本) -> 错误处理::结果<空> {
    让 界面表 = 界面::界面消息表::全局表();
    让 值对象: TOML处理::TOML值 = TOML处理::解析字符串(内容串).映射错误(|错误值| {
        错误处理::错误处理!(
            "{}",
            界面表.取带参消息("crate_publish_invalid_toml", &[&错误值.转字符串()])
        )
    })?;
    让 表格 = 值对象.作为表格().缺值转错(|| {
        错误处理::错误处理!("{}", 界面表.取消息("crate_publish_not_table"))
    })?;
    让 允许节 = ["模块路径", "标识符", "解释"];
    对于 节名 在 表格.键() {
        如果 !允许节.包含(&节名.作为文本切片()) {
            错误处理::错误中止!(
                "{}",
                界面表.取带参消息("crate_publish_bad_section", &[节名.作为文本切片()])
            );
        }
    }
    成功(())
}

/// 取版本控制用户名（发布署名用）
函数 取提交者名() -> 选项<字符串> {
    命令::新建("git")
        .单参数("config")
        .单参数("user.name")
        .取输出()
        .转选项()
        .过滤(|子进程输出| 子进程输出.进程状态.退出成功())
        .而后映射(|子进程输出| 字符串::从字节(子进程输出.标准输出).转选项())
        .映射(|文本值| 文本值.裁剪().转字符串())
        .过滤(|文本值| !文本值.是否为空())
}

/// 写入本地路径注册中心并提交（尽力而为）
函数 写入本地仓库(
    仓库目录: &路径类型,
    包名: &文本,
    语言代码: &文本,
    内容串: &文本,
    署名: &文本,
) -> 错误处理::结果<空> {
    让 界面表 = 界面::界面消息表::全局表();
    让 注册根 = 仓库子目录(仓库目录);
    让 目标路径 = 注册根
        .连接(语言代码)
        .连接("crates")
        .连接(格式化!("{}.toml", 包名));
    如果让 有值(父级) = 目标路径.父目录() {
        标准库::文件系统::递归创建目录(父级)?;
    }
    标准库::文件系统::写入(&目标路径, 内容串)?;
    让 索引路径 = 注册根.连接("index.json");
    让 可变 索引对象 = 读取索引(&索引路径)?;
    置入或更新条目(&可变 索引对象, 包名, 语言代码, 署名);
    写入索引(&索引路径, &索引对象)?;
    提交改动(仓库目录, &格式化!("publish {} ({})", 包名, 语言代码));
    打印行!(
        "{}",
        界面表.取带参消息("crate_publish_wrote_local", &[&仓库目录.展示().转字符串()])
    );
    成功(())
}

/// 写入远程注册中心：克隆 → 写文件与索引 → 提交 → 推送
函数 写入远程仓库(
    地址: &文本,
    包名: &文本,
    语言代码: &文本,
    内容串: &文本,
    署名: &文本,
) -> 错误处理::结果<空> {
    让 界面表 = 界面::界面消息表::全局表();
    让 临时 = 临时目录句柄::新建()?;
    让 克隆目录 = 临时.存放路径().连接("repo");
    让 克隆成功 = 命令::新建("git")
        .单参数("clone")
        .单参数(地址)
        .单参数(&克隆目录)
        .标准输出(标准库::进程::标准流::空流())
        .标准错误(标准库::进程::标准流::空流())
        .进程状态()
        .映射(|退出状态值| 退出状态值.退出成功())
        .解包或用(假);
    如果 !克隆成功 {
        错误处理::错误中止!(
            "{}",
            界面表.取带参消息("crate_publish_clone_failed", &[地址])
        );
    }
    让 注册根 = 仓库子目录(&克隆目录);
    让 目标路径 = 注册根
        .连接(语言代码)
        .连接("crates")
        .连接(格式化!("{}.toml", 包名));
    如果让 有值(父级) = 目标路径.父目录() {
        标准库::文件系统::递归创建目录(父级)?;
    }
    标准库::文件系统::写入(&目标路径, 内容串)?;
    让 索引路径 = 注册根.连接("index.json");
    让 可变 索引对象 = 读取索引(&索引路径)?;
    置入或更新条目(&可变 索引对象, 包名, 语言代码, 署名);
    写入索引(&索引路径, &索引对象)?;
    提交改动(&克隆目录, &格式化!("publish {} ({})", 包名, 语言代码));
    让 推送结果 = 命令::新建("git")
        .单参数("push")
        .当前目录(&克隆目录)
        .标准输出(标准库::进程::标准流::空流())
        .标准错误(标准库::进程::标准流::管道化())
        .取输出();
    如果让 成功(输出值) = &推送结果 {
        如果 !输出值.进程状态.退出成功() {
            让 错误文本 = 字符串::从utf8宽松(&输出值.标准错误);
            错误处理::错误中止!(
                "{}",
                界面表.取带参消息("crate_publish_push_failed", &[错误文本.裁剪()])
            );
        }
    } 否则 如果让 错误(错误值) = &推送结果 {
        错误处理::错误中止!(
            "{}",
            界面表.取带参消息("crate_publish_push_failed", &[&错误值.转字符串()])
        );
    }
    成功(())
}

/// 在索引中置入或更新一条映射条目
函数 置入或更新条目(
    索引对象: &可变 包索引,
    包名: &文本,
    语言代码: &文本,
    署名: &文本,
) {
    让 今日 = 今日世界标准时();
    让 映射文件 = 格式化!("{}/crates/{}.toml", 语言代码, 包名);
    如果让 有值(既有条目) = 索引对象
        .映射清单
        .可变迭代()
        .查找(|候选条目| 候选条目.包名 == 包名 && 候选条目.语言代码 == 语言代码)
    {
        既有条目.版本 = 递增版本(&既有条目.版本);
        既有条目.作者 = 署名.转字符串();
        既有条目.更新日期 = 今日.克隆值();
        既有条目.映射文件 = 映射文件;
    } 否则 {
        索引对象.映射清单.推入(映射条目 {
            包名: 包名.转字符串(),
            语言代码: 语言代码.转字符串(),
            版本: "1.0".转字符串(),
            作者: 署名.转字符串(),
            许可证: "MIT".转字符串(),
            质量分: 1.0,
            下载计数: 0,
            映射文件,
            更新日期: 今日.克隆值(),
        });
    }
    索引对象.更新日期 = 今日.克隆值();
    索引对象.映射清单.排序_by(|甲, 乙| {
        甲.包名
            .比较(&乙.包名)
            .然后(甲.语言代码.比较(&乙.语言代码))
    });
}

/// 版本号末段加一（1.0 → 1.1；无法解析则回退 1.0）
函数 递增版本(版本串: &文本) -> 字符串 {
    如果让 有值((主段, 尾段)) = 版本串.分割一次('.')
        && 让 成功(尾号) = 尾段.解析::<无符号整数>()
    {
        返回 格式化!("{}.{}", 主段, 尾号 + 1);
    }
    "1.0".转字符串()
}

/// 提交改动（尽力而为，失败不影响文件写入结果）
函数 提交改动(仓库目录: &路径类型, 提交消息: &文本) {
    让 _ = 命令::新建("git")
        .单参数("add")
        .单参数("-A")
        .当前目录(仓库目录)
        .标准输出(标准库::进程::标准流::空流())
        .标准错误(标准库::进程::标准流::空流())
        .进程状态();
    让 _ = 命令::新建("git")
        .单参数("commit")
        .单参数("-m")
        .单参数(提交消息)
        .当前目录(仓库目录)
        .标准输出(标准库::进程::标准流::空流())
        .标准错误(标准库::进程::标准流::空流())
        .进程状态();
}

/// 当前世界标准时日期，无外部时间依赖
函数 今日世界标准时() -> 字符串 {
    让 总秒数 = 标准库::时间模块::系统时间::现在()
        .自纪元(标准库::时间模块::UNIX纪元)
        .映射(|时长| 时长.总秒数())
        .解包或用(0);
    让 可变 剩余日数 = (总秒数 / 86_400) 作为 长整数;
    让 可变 年份: 长整数 = 1970;
    循环 {
        让 闰日数 = 如果 (年份 % 4 == 0 && 年份 % 100 != 0) || 年份 % 400 == 0 {
            366
        } 否则 {
            365
        };
        如果 剩余日数 < 闰日数 {
            中断;
        }
        剩余日数 -= 闰日数;
        年份 += 1;
    }
    让 月天数 = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    让 闰年 = (年份 % 4 == 0 && 年份 % 100 != 0) || 年份 % 400 == 0;
    让 可变 月份索引: 无符号机器整数 = 0;
    让 可变 余日 = 剩余日数;
    循环 {
        让 本月天数 = 月天数[月份索引] + 如果 月份索引 == 1 && 闰年 { 1 } 否则 { 0 };
        如果 余日 < 本月天数 {
            中断;
        }
        余日 -= 本月天数;
        月份索引 += 1;
    }
    格式化!(
        "{:04}-{:02}-{:02}",
        年份,
        月份索引 + 1,
        余日 + 1
    )
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    #[测试]
    函数 今日日期格式正确() {
        让 日期串 = 今日世界标准时();
        断言相等!(日期串.长度(), 10);
        断言!(日期串.以开头("20")); // 二十一世纪
        断言相等!(日期串.转为字节()[4], b'-');
        断言相等!(日期串.转为字节()[7], b'-');
    }

    /// 索引文件的映射文件字段是第三方可控数据：合法相对路径解析到注册根下，
    /// 上跳/绝对/盘符均拒绝（防复制文件读仓库外任意本地文件）。
    #[测试]
    函数 解析映射源拒绝路径穿越() {
        让 注册根 = 路径类型::新建("/repo/third-party");
        让 合法结果 = 解析映射源(注册根, "zh/crates/foo.toml");
        让 合法结果 = 合法结果.期望("合法相对路径应解析成功");
        断言!(合法结果.以开头(注册根), "解析结果应在注册根子树内：{合法结果:?}");
        断言!(
            合法结果.以结尾(路径类型::新建("zh").连接("crates").连接("foo.toml")),
            "应保留完整相对段：{合法结果:?}"
        );
        断言!(解析映射源(注册根, "../secret").是否为无(), "上跳应拒");
        断言!(
            解析映射源(注册根, "a/../../b").是否为无(),
            "内嵌上跳应拒"
        );
        断言!(
            解析映射源(注册根, "/etc/passwd").是否为无(),
            "绝对路径应拒"
        );
        断言!(
            解析映射源(注册根, "C:/Windows/x").是否为无(),
            "盘符应拒（连接会整体替换根路径）"
        );
        断言!(解析映射源(注册根, "").是否为无(), "空名应拒");
    }

    /// 库名/语言代码是路径段：`../`、分隔符、前导 `-` 与空名必须拒绝，
    /// 否则 `rzc crate install/remove` 可写/删全局语言目录外的任意 `.toml`
    #[测试]
    函数 库名与语言代码拒绝路径穿越() {
        断言!(校验库名("serde").是否为成功());
        断言!(校验库名("serde_json").是否为成功());
        断言!(校验库名("serde-json2").是否为成功());
        断言!(校验库名("").是否为错误(), "空名应拒");
        断言!(校验库名("..").是否为错误(), "上跳应拒");
        断言!(校验库名("../../.cargo/config").是否为错误(), "路径穿越应拒");
        断言!(校验库名("a/b").是否为错误(), "正斜杠应拒");
        断言!(校验库名("a\\b").是否为错误(), "反斜杠应拒");
        断言!(校验库名("中文").是否为错误(), "非 ASCII 应拒");
        断言!(校验库名("-evil").是否为错误(), "前导连字符应拒");
        断言!(校验库名(&"a".重复(65)).是否为错误(), "超长应拒");
        断言!(校验语言代码("../zh") == 假);
        断言!(校验语言代码("..") == 假);
        断言!(校验语言代码("zh") == 真);
    }

    /// 安装路径始终落在全局语言目录内（纵深防御的规范路径检查）
    #[测试]
    函数 映射安装路径限制在全局语言目录内() {
        断言!(在全局语言目录内(&映射安装路径("zh", "serde")));
        断言!(!在全局语言目录内(&路径类型::新建("/etc/passwd")));
    }

    #[测试]
    函数 版本号递增规则() {
        断言相等!(递增版本("1.0"), "1.1");
        断言相等!(递增版本("2.3"), "2.4");
        断言相等!(递增版本("garbage"), "1.0");
    }

    #[测试]
    函数 校验映射表各分支() {
        // 合法：仅含允许的节
        断言!(校验映射表("[\"标识符\"]\n\"服务器\" = \"Server\"\n").是否为成功());
        // 非法节名
        断言!(校验映射表("[\"未知节\"]\n\"a\" = \"b\"\n").是否为错误());
        // 重复键：配置解析失败
        断言!(校验映射表("[\"标识符\"]\n\"a\" = \"b\"\n\"a\" = \"c\"\n").是否为错误());
    }

    #[测试]
    函数 索引往返序列化() {
        让 可变 索引对象 = 包索引::默认值();
        置入或更新条目(&可变 索引对象, "serde", "zh", "tan80");
        置入或更新条目(&可变 索引对象, "tokio", "zh", "alice");
        断言相等!(索引对象.映射清单.长度(), 2);
        // 重复置入应更新版本而非新增
        置入或更新条目(&可变 索引对象, "serde", "zh", "bob");
        断言相等!(索引对象.映射清单.长度(), 2);
        让 序列化条目 = 索引对象
            .映射清单
            .迭代()
            .查找(|候选条目| 候选条目.包名 == "serde" && 候选条目.语言代码 == "zh")
            .解包();
        断言相等!(序列化条目.版本, "1.1");
        断言相等!(序列化条目.作者, "bob");
        // 序列化再反序列化
        让 索引文本 = JSON序列化::美化输出(&索引对象).解包();
        让 回读索引: 包索引 = JSON序列化::解析字符串(&索引文本).解包();
        断言相等!(回读索引.映射清单.长度(), 2);
    }

    /// 注册中心子目录两种布局：合并进主仓库后在 `third-party/`，独立仓库在根
    #[测试]
    函数 注册中心子目录两种布局() {
        让 临时 = 临时文件::建临时目录().解包();
        // 平铺布局：索引文件在根
        让 平铺根 = 临时.条目路径().连接("flat");
        标准库::文件系统::递归创建目录(&平铺根).解包();
        标准库::文件系统::写入(平铺根.连接("index.json"), "{}").解包();
        断言相等!(仓库子目录(&平铺根), 平铺根);

        // 嵌套布局：third-party/index.json
        让 嵌套根 = 临时.条目路径().连接("nested");
        让 嵌套子目录 = 嵌套根.连接("third-party");
        标准库::文件系统::递归创建目录(&嵌套子目录).解包();
        标准库::文件系统::写入(嵌套子目录.连接("index.json"), "{}").解包();
        断言相等!(仓库子目录(&嵌套根), 嵌套子目录);
    }

    /// 读取索引：缺失 → 空索引；合法 → 解析；损坏文件 → 报错
    #[测试]
    函数 读取索引缺失合法损坏() {
        让 临时 = 临时文件::建临时目录().解包();
        让 缺失路径 = 临时.条目路径().连接("absent.json");
        断言!(读取索引(&缺失路径).解包().映射清单.是否为空());

        让 正常文件 = 临时.条目路径().连接("good.json");
        让 可变 索引对象 = 包索引::默认值();
        置入或更新条目(&可变 索引对象, "serde", "zh", "tan80");
        写入索引(&正常文件, &索引对象).解包();
        断言相等!(读取索引(&正常文件).解包().映射清单.长度(), 1);

        让 损坏文件 = 临时.条目路径().连接("bad.json");
        标准库::文件系统::写入(&损坏文件, "{ 不是合法 JSON").解包();
        断言!(读取索引(&损坏文件).是否为错误());
    }

    /// 写入索引：父目录不存在时逐级创建，可回读
    #[测试]
    函数 写入索引自动创建父目录() {
        让 临时 = 临时文件::建临时目录().解包();
        让 深层路径 = 临时.条目路径().连接("a").连接("b").连接("index.json");
        写入索引(&深层路径, &包索引::默认值()).解包();
        断言!(深层路径.是否为文件());
        断言相等!(读取索引(&深层路径).解包().映射清单.长度(), 0);
    }

    /// 新条目默认字段齐全且按 (库, 语言) 排序；映射文件路径与注册中心布局一致
    #[测试]
    函数 置入条目默认值与排序() {
        让 可变 索引对象 = 包索引::默认值();
        置入或更新条目(&可变 索引对象, "tokio", "zh", "alice");
        置入或更新条目(&可变 索引对象, "serde", "ja", "bob");
        置入或更新条目(&可变 索引对象, "serde", "zh", "carol");
        让 键列表: 向量<_> = 索引对象
            .映射清单
            .迭代()
            .映射(|条目值| (条目值.包名.作为文本切片(), 条目值.语言代码.作为文本切片()))
            .收集();
        断言相等!(
            键列表,
            向量![("serde", "ja"), ("serde", "zh"), ("tokio", "zh")]
        );
        让 首项 = &索引对象.映射清单[0];
        断言相等!(首项.版本, "1.0");
        断言相等!(首项.许可证, "MIT");
        断言相等!(首项.质量分, 1.0);
        断言相等!(首项.下载计数, 0);
        断言相等!(首项.映射文件, "ja/crates/serde.toml");
        断言相等!(首项.更新日期.长度(), 10);
        断言相等!(索引对象.更新日期, 首项.更新日期);
    }

    /// 显式指定文件：存在即采用；不存在报错（不进入候选路径扫描）
    #[测试]
    函数 解析发布文件显式分支() {
        让 临时 = 临时文件::建临时目录().解包();
        让 已存在文件 = 临时.条目路径().连接("mine.toml");
        标准库::文件系统::写入(&已存在文件, "[\"标识符\"]\n\"a\" = \"b\"\n").解包();
        断言相等!(
            解析发布文件("serde", "zh", 有值(已存在文件.克隆值())).解包(),
            已存在文件
        );
        让 缺失文件 = 临时.条目路径().连接("absent.toml");
        断言!(解析发布文件("serde", "zh", 有值(缺失文件)).是否为错误());
    }

    /// 写入本地（嵌套 `third-party` 布局，即并入主仓库后的布局）：
    /// 映射文件 + 索引条目一并落盘，版本控制提交尽力而为（非仓库目录静默失败）
    #[测试]
    函数 写入本地仓库嵌套布局() {
        让 临时 = 临时文件::建临时目录().解包();
        让 仓库目录 = 临时.条目路径().连接("repo");
        // 真实主仓库中 `third-party/index.json` 已存在，写入方据此识别嵌套布局
        让 第三方目录 = 仓库目录.连接("third-party");
        标准库::文件系统::递归创建目录(&第三方目录).解包();
        写入索引(&第三方目录.连接("index.json"), &包索引::默认值()).解包();

        让 内容串 = "[\"标识符\"]\n\"服务器\" = \"Server\"\n";
        写入本地仓库(&仓库目录, "serde", "zh", 内容串, "tan80").解包();

        让 映射路径 = 第三方目录.连接("zh/crates/serde.toml");
        断言相等!(标准库::文件系统::读取字符串(&映射路径).解包(), 内容串);
        让 索引对象 = 读取索引(&第三方目录.连接("index.json")).解包();
        断言相等!(索引对象.映射清单.长度(), 1);
        让 条目值 = &索引对象.映射清单[0];
        断言相等!(条目值.包名, "serde");
        断言相等!(条目值.语言代码, "zh");
        断言相等!(条目值.版本, "1.0");
        断言相等!(条目值.映射文件, "zh/crates/serde.toml");
    }

    /// 写入本地（独立注册中心仓库的平铺布局）：映射文件直接落在 <语言>/crates/
    #[测试]
    函数 写入本地仓库平铺布局() {
        让 临时 = 临时文件::建临时目录().解包();
        让 仓库目录 = 临时.条目路径().连接("repo");
        标准库::文件系统::递归创建目录(&仓库目录).解包();
        写入索引(&仓库目录.连接("index.json"), &包索引::默认值()).解包();
        写入本地仓库(
            &仓库目录,
            "tokio",
            "ja",
            "[\"标识符\"]\n\"a\"=\"b\"\n",
            "alice",
        )
        .解包();
        断言!(仓库目录.连接("ja/crates/tokio.toml").是否为文件());
        让 索引对象 = 读取索引(&仓库目录.连接("index.json")).解包();
        断言相等!(索引对象.映射清单.长度(), 1);
        断言相等!(索引对象.映射清单[0].映射文件, "ja/crates/tokio.toml");
    }

    /// 已安装清单：缺失 → 空表；写入 → 按 (库, 语言) 键回读；损坏 → 回退空表
    #[测试]
    函数 已装清单往返与损坏回退() {
        让 _守卫 = 包::语言管理::测试模块::环境锁();
        让 临时 = 临时文件::建临时目录().解包();
        让 已存值 = 标准库::环境::环境变量("RZ_LANG_DIR").转选项();
        不安全 {
            标准库::环境::设置环境变量("RZ_LANG_DIR", 临时.条目路径().连接("lang-packs"));
        }
        让 还原 = || 不安全 {
            如果让 有值(原值) = &已存值 {
                标准库::环境::设置环境变量("RZ_LANG_DIR", 原值);
            } 否则 {
                标准库::环境::移除环境变量("RZ_LANG_DIR");
            }
        };

        // 首次读取：清单不存在 → 空表（不报错）
        断言!(读取已装清单().是否为空());

        // 经置入条目构造一条真实条目并写清单
        让 可变 索引对象 = 包索引::默认值();
        置入或更新条目(&可变 索引对象, "serde", "zh", "tan80");
        让 条目值 = 索引对象.映射清单[0].克隆值();
        让 可变 清单映射 = 有序映射::新建();
        清单映射.置入(
            ("serde".转字符串(), "zh".转字符串()),
            条目值.克隆值(),
        );
        写入已装清单(&清单映射).解包();
        // 清单位于语言包目录的上一级（全局根）
        断言!(临时.条目路径().连接("crate-registry.json").是否为文件());
        让 回读清单 = 读取已装清单();
        // 索引条目未派生部分相等特征（生产无等值比较需求），逐字段核对
        让 读回条目 = 回读清单
            .获取(&("serde".转字符串(), "zh".转字符串()))
            .期望("回读清单应含 serde/zh");
        断言相等!(读回条目.版本, 条目值.版本);
        断言相等!(读回条目.作者, 条目值.作者);
        断言相等!(读回条目.映射文件, 条目值.映射文件);

        // 清单损坏（手工改坏 JSON）→ 回退空表，不传播错误
        标准库::文件系统::写入(临时.条目路径().连接("crate-registry.json"), "[坏").解包();
        断言!(读取已装清单().是否为空());

        还原();
    }
}
