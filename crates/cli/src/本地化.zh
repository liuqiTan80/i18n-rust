//! 界面消息本地化模块
//!
//! 每个语言包的 ui.toml 提供 ["界面消息"] 节，
//! 内含 CLI（clap 帮助 + 运行时消息）与 LSP 帮助的全部用户可见文本。
//! 占位符 `{}` 在运行时按出现顺序替换为具体参数。
//!
//! 语言包目录加载优先级：
//! 1. 当前目录 lang-packs/<语言>/（项目内自定义覆盖）
//! 2. 全局 ~/.rz/lang-packs/<语言>/
//! 3. 内置语言包
//!
//! 语言选择优先级：
//! RZ_LANG 环境变量 > 系统语言（LANG/LC_ALL） > zh
//!
//! 再生成方式见 tools/zh-selfhost/regen.sh；请勿手改同目录下的 ui.rs。
//! 注：外部 ABI 走透传——`std::path::Path`/`std::collections::HashMap`/`toml::from_str`/
//! `std::fs::read_to_string`/`std::env::var`/`i18n_rust_engine::语言::内置语言代码`/
//! `crate::语言包根目录`（crate 根 `main.zh` 已翻转）、`crate::语言包工具::全局语言目录`/
//! `crate::内置语言::获取内置数据/内置语言代码`、`crate::语言包工具::单元测试::{环境锁, 环境恢复::接管}`
//! 为已翻转的中文 ABI 或稳定外部名；本模块自身类型、方法、函数、局部与控制流全中文化，
//! 所有数据串（ui.toml 键、环境变量名、语言标签、断言文案）逐字保真。

使用 std::collections::HashMap;
使用 std::path::Path;

/// 界面消息表：语言代码 + 消息模板
公开 结构体 界面 {
    /// 消息模板（键 → 含 `{}` 占位符的模板）
    消息表: HashMap<String, String>,
}

实现 界面 {
    /// 从 TOML 内容构造消息表（["界面消息"] 节）
    函数 从文本构造(内容: &文本) -> 自身 {
        让 可变 消息表 = HashMap::新建();
        如果 让 成功(值) = toml::from_str::<toml::Value>(内容)
            && 让 有值(表) = 值.获取("界面消息").and_then(|节| 节.as_table())
        {
            对于 (键, 项) in 表 {
                如果 让 有值(文本串) = 项.as_str() {
                    消息表.insert(键.clone(), 文本串.to_string());
                }
            }
        }
        界面 { 消息表 }
    }

    /// 加载指定语言的界面消息（项目内 > 全局 > 内置）
    公开 函数 按语言加载(语言代码: &文本) -> 自身 {
        // 1. 当前目录项目语言包根 <lang>/ui.toml（项目内自定义覆盖；
        //    主仓库为 crates/engine/lang-packs/，用户项目为 lang-packs/）
        让 本地 = crate::语言包根目录(Path::新建("."))
            .join(语言代码)
            .join("ui.toml");
        如果 本地.is_file()
            && 让 成功(内容) = std::fs::read_to_string(&本地)
        {
            返回 自身::从文本构造(&内容);
        }
        // 2. 全局用户语言包目录
        让 全局 = crate::语言包工具::全局语言目录()
            .join(语言代码)
            .join("ui.toml");
        如果 全局.is_file()
            && 让 成功(内容) = std::fs::read_to_string(&全局)
        {
            返回 自身::从文本构造(&内容);
        }
        // 3. 内置语言包（未知语言代码自动回退中文）
        让 内置 = crate::内置语言::获取内置数据(语言代码);
        自身::从文本构造(内置.界面文本)
    }

    /// 加载 --lang-pack 显式指定目录的界面消息
    ///
    /// 目录含 ui.toml 时直接使用；否则按目录名回退常规加载链。
    公开 函数 按显式目录加载(路径: &Path) -> 自身 {
        让 语言代码 = 路径
            .file_name()
            .and_then(|名| 名.to_str())
            .unwrap_or("zh")
            .to_string();
        让 界面文件 = 路径.join("ui.toml");
        如果 界面文件.is_file()
            && 让 成功(内容) = std::fs::read_to_string(&界面文件)
        {
            返回 自身::从文本构造(&内容);
        }
        自身::按语言加载(&语言代码)
    }

    /// 全局界面消息：用于 clap 帮助等无文件上下文的场景
    ///
    /// 每次调用重新解析（模板仅 60 余键，开销可忽略），
    /// 避免全局缓存导致环境变量变化后语言不切换。
    公开 函数 全局() -> 自身 {
        自身::按语言加载(&检测界面语言())
    }

    /// 取消息模板（缺失时回退键名本身，便于定位遗漏）
    公开 函数 取文(&自我, 键: &文本) -> 字符串 {
        自我.消息表
            .获取(键)
            .cloned()
            .unwrap_or_else(|| 键.to_string())
    }

    /// 取消息模板并替换 `{}` 占位符（按出现顺序）
    公开 函数 取文带参(&自我, 键: &文本, 参数: &[&文本]) -> 字符串 {
        替换占位(&自我.取文(键), 参数)
    }
}

/// 按出现顺序把 `{}` 替换为参数；参数多于占位符时忽略多余参数，
/// 参数不足时保留未替换的 `{}`（模板兜底，避免 panic）。
函数 替换占位(模板: &文本, 参数: &[&文本]) -> 字符串 {
    让 可变 结果串 = String::with_capacity(模板.len());
    让 可变 剩余 = 模板;
    对于 参数项 in 参数 {
        匹配 剩余.find("{}") {
            有值(序号) => {
                结果串.push_str(&剩余[..序号]);
                结果串.push_str(参数项);
                剩余 = &剩余[序号 + 2..];
            }
            无 => {
                // 占位符已耗尽：剩余模板原样保留
                结果串.push_str(剩余);
                返回 结果串;
            }
        }
    }
    结果串.push_str(剩余);
    结果串
}

/// 界面语言选择：RZ_LANG 环境变量 > 系统语言 > zh
公开 函数 检测界面语言() -> 字符串 {
    如果 让 成功(语言) = std::env::var("RZ_LANG") {
        让 语言 = 语言.trim().to_lowercase();
        如果 !语言.is_empty() {
            返回 语言;
        }
    }
    检测系统语言()
}

/// 检测系统语言（用于 --lang 缺省值与界面语言回退）
///
/// 读取 LC_ALL / LC_MESSAGES / LANG 环境变量，取首段语言标签
/// （如 `zh_CN.UTF-8` → `zh`）匹配已支持语言；无法识别时默认中文。
/// 语言集合来自引擎 lang-packs 目录（单一事实源），不在此处维护匹配表。
公开 函数 检测系统语言() -> 字符串 {
    对于 变量名 in ["LC_ALL", "LC_MESSAGES", "LANG"] {
        如果 让 成功(值) = std::env::var(变量名) {
            让 小写 = 值.to_lowercase();
            让 标签 = 小写.split(['_', '-', '.']).next().unwrap_or("").trim();
            // 普通话标签 cmn 归入中文（其余标签按内置语言代码集合精确匹配）
            让 代码 = 如果 标签 == "cmn" { "zh" } 否则 { 标签 };
            如果 i18n_rust_engine::语言::内置语言代码().contains(&代码) {
                返回 代码.to_string();
            }
        }
    }
    "zh".to_string()
}

#[配置(测试)]
模块 单元测试 {
    使用 超级::*;
    使用 std::path::Path;

    #[测试]
    函数 测试替换占位按序() {
        断言相等!(替换占位("已导出到 {}", &["a.rs"]), "已导出到 a.rs");
        断言相等!(
            替换占位("项目根: {}，错误: {}", &["/p", "boom"]),
            "项目根: /p，错误: boom"
        );
    }

    #[测试]
    函数 测试替换占位多余参数忽略() {
        断言相等!(替换占位("只有 {}", &["a", "b"]), "只有 a");
    }

    #[测试]
    函数 测试替换占位缺参保留() {
        断言相等!(替换占位("{} 和 {}", &["a"]), "a 和 {}");
        断言相等!(替换占位("无占位符", &[]), "无占位符");
    }

    #[测试]
    函数 测试按语言加载内置中文() {
        让 界面 = 界面::按语言加载("zh");
        断言相等!(界面.取文("cli_about"), "多语言 Rust 教学方言编译器");
        // 缺失键回退键名
        断言相等!(界面.取文("不存在的键"), "不存在的键");
    }

    #[测试]
    函数 测试按语言加载全部内置含界面() {
        对于 代码 in crate::内置语言::内置语言代码() {
            让 界面 = 界面::按语言加载(代码);
            断言!(!界面.消息表.is_empty(), "{代码} 的 ui 消息为空");
            断言相等!(界面.取文("cli_about"), 界面.取文("cli_about"));
        }
    }

    #[测试]
    函数 测试按语言加载未知回退中文() {
        让 界面 = 界面::按语言加载("xx");
        断言相等!(界面.取文("cli_about"), "多语言 Rust 教学方言编译器");
    }

    #[测试]
    函数 测试按显式目录加载回退() {
        让 界面 = 界面::按显式目录加载(Path::新建("/不存在的目录/de"));
        断言相等!(
            界面.取文("cli_about"),
            "Ein mehrsprachiger Rust-Lehrdialekt-Compiler"
        );
    }

    #[测试]
    函数 测试检测系统语言标签() {
        // 修改全局环境变量（LANG），需持环境变量锁避免污染并发测试；
        // 同时临时接管清除 LC_ALL / LC_MESSAGES——其检测优先级高于 LANG，
        // CI 的 macos runner 预设 en 区域设置，不清除会覆盖本测试设置的 LANG
        让 _锁 = crate::语言包工具::单元测试::环境锁();
        让 _环境 =
            crate::语言包工具::单元测试::环境恢复::接管(
                &["LC_ALL", "LC_MESSAGES", "LANG"],
            );
        对于 (区域, 期望) in [
            ("zh_CN.UTF-8", "zh"),
            // en 语言包已恢复（恒等映射），en 区域设置直接命中 en
            ("en_US.UTF-8", "en"),
            ("de_DE.UTF-8", "de"),
            ("ja_JP.UTF-8", "ja"),
            ("ru_RU.UTF-8", "ru"),
            ("es_ES.UTF-8", "es"),
            ("fr_FR.UTF-8", "fr"),
            ("pt_BR.UTF-8", "pt"),
            ("ko_KR.UTF-8", "ko"),
            ("ar_SA.UTF-8", "ar"),
            ("hi_IN.UTF-8", "hi"),
            // 普通话标签 cmn 归入中文
            ("cmn_CN.UTF-8", "zh"),
        ] {
            不安全 {
                std::env::set_var("LANG", 区域);
            }
            断言相等!(检测系统语言(), 期望, "locale: {区域}");
        }
        不安全 {
            std::env::remove_var("LANG");
        }
        断言相等!(检测系统语言(), "zh");
    }

    #[测试]
    函数 测试检测界面语言环境优先() {
        // 修改全局环境变量（RZ_LANG），需持环境变量锁避免污染并发测试
        让 _锁 = crate::语言包工具::单元测试::环境锁();
        不安全 {
            std::env::set_var("RZ_LANG", "ru");
        }
        断言相等!(检测界面语言(), "ru");
        不安全 {
            std::env::remove_var("RZ_LANG");
        }
        断言相等!(检测界面语言(), 检测系统语言());
    }
}
