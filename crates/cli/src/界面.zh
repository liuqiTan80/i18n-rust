//! 界面消息本地化模块
//!
//! 每个语言包的界面消息文件提供「界面消息」节，
//! 内含命令行帮助（含运行时消息）与语言服务的全部用户可见文本。
//! 占位符 `{}` 在运行时按出现顺序替换为具体参数。
//!
//! 语言包目录加载优先级：
//! 1. 当前目录 lang-packs/<语言>/（项目内自定义覆盖）
//! 2. 全局 ~/.rz/lang-packs/<语言>/
//! 3. 内置语言包
//!
//! 语言选择优先级：
//! RZ_LANG 环境变量 > 系统语言（LANG/LC_ALL） > 默认中文

使用 标准库::路径::路径类型;

使用 引擎库::界面消息::消息表;
使用 引擎库::语言::内置消息表;

/// 命令是否成功退出（统一取进程状态，供各模块复用，避免各处重复字段访问写法）
公开(包) 函数 命令成功(命令输出: &标准库::进程::输出) -> 布尔 {
    命令输出.进程状态.退出成功()
}

/// 界面消息表
///
/// 磁盘覆盖命中时持有解析结果；否则只记语言代码、查询时按引用直取引擎
/// 内置静态表，避免每次 [`界面消息表::全局表`] 都重新解析一遍界面消息文件
/// （调用点上百处）。语言选择仍是「每次调用重算」：环境变量变化后
/// [`界面消息表::全局表`] 立即切换。
公开 结构体 界面消息表 {
    /// 落盘命中的自定义表（项目内 / 全局 / 显式目录）
    自定义表: 选项<消息表>,
    /// 内置回退语言代码（`自定义表` 为 `无` 时生效，未知代码由引擎路由回中文）
    语言代码: 字符串,
}

实现 界面消息表 {
    /// 用已读入的界面消息内容构造自定义表
    函数 从内容建表(内容: 字符串, 语言码: &文本) -> 自身 {
        自身 {
            自定义表: 有值(消息表::成表(&内容)),
            语言代码: 语言码.转字符串(),
        }
    }

    /// 内置表路径：只记语言代码，查询时按引用直取引擎静态表
    函数 内置表(语言码: &文本) -> 自身 {
        自身 {
            自定义表: 无,
            语言代码: 语言码.转字符串(),
        }
    }

    /// 加载指定语言的界面消息（项目内 > 全局 > 内置）
    公开 函数 按语言建表(语言码: &文本) -> 自身 {
        // 1. 当前目录项目语言包根 <语言>/界面消息文件（项目内自定义覆盖；
        //    主仓库为 crates/engine/lang-packs/，用户项目为 lang-packs/）
        让 本地路径 = 包::语言包根目录(路径类型::新建("."))
            .连接(语言码)
            .连接("ui.toml");
        如果 本地路径.是否为文件()
            && 让 成功(内容) = 标准库::文件系统::读取字符串(&本地路径)
        {
            返回 自身::从内容建表(内容, 语言码);
        }
        // 2. 全局用户语言包目录
        让 全局路径 = 包::语言管理::全局语言目录()
            .连接(语言码)
            .连接("ui.toml");
        如果 全局路径.是否为文件()
            && 让 成功(内容) = 标准库::文件系统::读取字符串(&全局路径)
        {
            返回 自身::从内容建表(内容, 语言码);
        }
        // 3. 内置语言包：只记语言代码，查询时按引用直取引擎静态表
        自身::内置表(语言码)
    }

    /// 加载 --lang-pack 显式指定目录的界面消息
    ///
    /// 目录含界面消息文件时直接使用；否则按目录名回退常规加载链。
    公开 函数 按显式目录建表(目录: &路径类型) -> 自身 {
        让 语言码 = 目录
            .文件名()
            .而后映射(|本名| 本名.取字符串引用())
            .取值或("zh");
        让 界面文件 = 目录.连接("ui.toml");
        如果 界面文件.是否为文件()
            && 让 成功(内容) = 标准库::文件系统::读取字符串(&界面文件)
        {
            返回 自身::从内容建表(内容, 语言码);
        }
        自身::按语言建表(语言码)
    }

    /// 全局界面消息：用于命令行帮助等无文件上下文的场景
    ///
    /// 每次调用重算语言与磁盘覆盖，避免全局缓存导致环境变量变化后语言不切换；
    /// 内置表按引用直取，不重复解析界面消息文件。
    公开 函数 全局表() -> 自身 {
        自身::按语言建表(&探测界面语言())
    }

    /// 取消息模板：自定义表 → 内置中文表 → 键名本身
    公开 函数 取消息(&自我, 键名: &文本) -> 字符串 {
        如果让 有值(自定义内容) = &自我.自定义表 {
            自定义内容.取消息(键名)
        } 否则 {
            引擎库::界面消息::取模板(内置消息表(&自我.语言代码), 键名)
        }
    }

    /// 取消息模板并替换 `{}` 占位符（按出现顺序）
    公开 函数 取带参消息(&自我, 键名: &文本, 参数切片: &[&文本]) -> 字符串 {
        引擎库::界面消息::代入参数(&自我.取消息(键名), 参数切片)
    }
}

/// 界面语言选择：RZ_LANG 环境变量 > 系统语言 > 默认中文
公开 函数 探测界面语言() -> 字符串 {
    如果让 成功(语言值) = 标准库::环境::环境变量("RZ_LANG") {
        让 规范值 = 语言值.裁剪().转小写();
        如果 !规范值.是否为空() {
            返回 规范值;
        }
    }
    探测系统语言()
}

/// 检测系统语言（用于 --lang 缺省值与界面语言回退）
///
/// 读取 LC_ALL / LC_MESSAGES / LANG 环境变量，取首段语言标签
/// （如中文区域的区域串 → 语言代码）匹配已支持语言；无法识别时默认中文。
/// 语言集合来自引擎语言包目录（单一事实源），不在此处维护匹配表。
公开 函数 探测系统语言() -> 字符串 {
    探测系统语言标签().解包或用否则(|| "zh".转字符串())
}

/// 检测系统语言标签：命中已支持语言时返回语言代码，无法识别时返回 `无`
///
/// 与 [`探测系统语言`] 的唯一区别是不吞掉「未识别」这一事实：
/// 初始化命令需要据此决定是提示回退、还是列出菜单让用户自选语言。
公开 函数 探测系统语言标签() -> 选项<字符串> {
    对于 区域变量 在 ["LC_ALL", "LC_MESSAGES", "LANG"] {
        如果让 成功(区域值) = 标准库::环境::环境变量(区域变量) {
            让 小写区域 = 区域值.转小写();
            让 标签 = 小写区域.分割(['_', '-', '.']).下一个().取值或("").裁剪();
            // 普通话标签归入中文（其余标签按内置语言代码集合精确匹配）
            让 语言码 = 如果 标签 == "cmn" { "zh" } 否则 { 标签 };
            如果 引擎库::语言::内置语言代码().包含(&语言码) {
                返回 有值(语言码.转字符串());
            }
        }
    }
    无
}

/// 读取系统区域设置的语言标签原文（LC_ALL > LC_MESSAGES > LANG 的首段）
///
/// 只做语法拆分（例如某区域串拆出语言代码），不判断是否为已支持语言；
/// 供「未识别系统语言」提示回显用户实际的区域设置。
公开 函数 系统区域标签() -> 选项<字符串> {
    对于 区域变量 在 ["LC_ALL", "LC_MESSAGES", "LANG"] {
        如果让 成功(区域值) = 标准库::环境::环境变量(区域变量) {
            让 小写区域 = 区域值.转小写();
            让 标签 = 小写区域.分割(['_', '-', '.']).下一个().取值或("").裁剪();
            如果 !标签.是否为空() {
                返回 有值(标签.转字符串());
            }
        }
    }
    无
}

/// 语言代码 → 该语言的自称（交互式菜单里每种语言以自身文字呈现）
///
/// 未收录的代码返回 `无`，调用方直接回退显示代码本身；
/// 新增语言包时覆盖性测试会失败提醒补表。
公开 函数 母语语言名(代码: &文本) -> 选项<静态字符串引用> {
    如果 代码 == "ar" {
        返回 有值("العربية");
    }
    如果 代码 == "de" {
        返回 有值("Deutsch");
    }
    如果 代码 == "en" {
        返回 有值("English");
    }
    如果 代码 == "es" {
        返回 有值("Español");
    }
    如果 代码 == "fr" {
        返回 有值("Français");
    }
    如果 代码 == "hi" {
        返回 有值("हिन्दी");
    }
    如果 代码 == "ja" {
        返回 有值("日本語");
    }
    如果 代码 == "ko" {
        返回 有值("한국어");
    }
    如果 代码 == "pt" {
        返回 有值("Português");
    }
    如果 代码 == "ru" {
        返回 有值("Русский");
    }
    如果 代码 == "zh" {
        返回 有值("中文");
    }
    无
}

/// 解析交互式语言菜单的选择
///
/// 接受序号（如 3）、语言代码（大小写不敏感）或空行（取默认值）；
/// 其余输入返回 `无`，由调用方提示重新输入。
公开 函数 解析语言选择(
    输入: &文本,
    代码表: &[字符串],
    缺省值: &文本,
) -> 选项<字符串> {
    让 裁剪值 = 输入.裁剪();
    如果 裁剪值.是否为空() {
        返回 有值(缺省值.转字符串());
    }
    如果让 成功(序号) = 裁剪值.解析::<无符号机器整数>()
        && (1..=代码表.长度()).包含(&序号)
    {
        返回 有值(代码表[序号 - 1].克隆值());
    }
    让 小写输入 = 裁剪值.转小写();
    代码表
        .迭代()
        .查找(|本代码| 本代码.作为文本切片() == 小写输入)
        .克隆副本()
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    /// 占位符替换走向引擎统一实现（顺序填充、多余参数忽略、缺参保留）
    #[测试]
    函数 取带参消息替换占位符() {
        让 界面表 = 界面消息表::按语言建表("zh");
        断言相等!(界面表.取带参消息("err_line_col", &["3", "7"]), "第 3 行第 7 列");
        断言相等!(
            界面表.取带参消息("cli_about", &[]),
            界面表.取消息("cli_about")
        );
    }

    #[测试]
    函数 中文内置表可用() {
        让 界面表 = 界面消息表::按语言建表("zh");
        断言相等!(界面表.取消息("cli_about"), "多语言 Rust 教学方言编译器");
        // 缺失键回退键名
        断言相等!(界面表.取消息("不存在的键"), "不存在的键");
    }

    #[测试]
    函数 全部内置语言都有界面消息() {
        对于 语言码 在 包::内置语言::内置语言清单() {
            让 界面表 = 界面消息表::按语言建表(语言码);
            // 键名原样返回说明该语言缺这条消息（已回退过中文仍没有）
            断言不等!(
                界面表.取消息("cli_about"),
                "cli_about",
                "{语言码} 的界面消息缺失 cli_about"
            );
        }
    }

    #[测试]
    函数 未知语言回退中文() {
        让 界面表 = 界面消息表::按语言建表("xx");
        断言相等!(界面表.取消息("cli_about"), "多语言 Rust 教学方言编译器");
    }

    #[测试]
    函数 显式目录不可用则回退() {
        让 界面表 = 界面消息表::按显式目录建表(路径类型::新建("/不存在的目录/de"));
        断言相等!(
            界面表.取消息("cli_about"),
            "Ein mehrsprachiger Rust-Lehrdialekt-Compiler"
        );
    }

    #[测试]
    函数 系统语言标签识别() {
        // 修改全局环境变量（LANG），需持环境变量锁避免污染并发测试；
        // 同时临时接管清除 LC_ALL / LC_MESSAGES——其检测优先级高于 LANG，
        // 持续集成环境的区域设置会覆盖本测试设置的 LANG
        让 _锁 = 包::语言管理::测试模块::环境锁();
        让 _环境 = 包::语言管理::测试模块::环境还原::接管(&[
            "LC_ALL",
            "LC_MESSAGES",
            "LANG",
        ]);
        对于 (区域值, 预期值) 在 [
            ("zh_CN.UTF-8", "zh"),
            // 英文语言包已恢复（恒等映射），英文区域设置直接命中英文
            ("en_US.UTF-8", "en"),
            ("de_DE.UTF-8", "de"),
            ("ja_JP.UTF-8", "ja"),
            ("ru_RU.UTF-8", "ru"),
            ("es_ES.UTF-8", "es"),
            ("fr_FR.UTF-8", "fr"),
            ("pt_BR.UTF-8", "pt"),
            ("ko_KR.UTF-8", "ko"),
            ("ar_SA.UTF-8", "ar"),
            ("hi_IN.UTF-8", "hi"),
            // 普通话标签归入中文
            ("cmn_CN.UTF-8", "zh"),
        ] {
            不安全 {
                标准库::环境::设置环境变量("LANG", 区域值);
            }
            断言相等!(探测系统语言(), 预期值, "区域设置：{区域值}");
        }
        不安全 {
            标准库::环境::移除环境变量("LANG");
        }
        断言相等!(探测系统语言(), "zh");
    }

    /// 新增内置语言包时菜单自称表必须同步（否则菜单里显示裸代码）
    #[测试]
    函数 母语语言名覆盖内置清单() {
        对于 语言码 在 包::内置语言::内置语言清单() {
            断言!(
                母语语言名(语言码).是否为有值(),
                "语言包 {语言码} 缺少菜单自称，请补母语语言名"
            );
        }
        断言相等!(母语语言名("xx"), 无);
    }

    /// 菜单输入：序号 / 语言代码（大小写不敏感）/ 空行取默认 / 其余拒绝
    #[测试]
    函数 解析语言选择各分支() {
        让 代码表: 向量<字符串> = ["de", "ja", "zh"]
            .迭代()
            .映射(|本代码| 本代码.转字符串())
            .收集();
        断言相等!(
            解析语言选择("2\n", &代码表, "zh").作为解引用(),
            有值("ja")
        );
        断言相等!(
            解析语言选择(" 3 ", &代码表, "zh").作为解引用(),
            有值("zh")
        );
        断言相等!(
            解析语言选择("JA", &代码表, "zh").作为解引用(),
            有值("ja")
        );
        断言相等!(
            解析语言选择("", &代码表, "zh").作为解引用(),
            有值("zh")
        );
        // 越界序号 / 未支持代码 / 乱输入都交给调用方重试
        断言相等!(解析语言选择("0", &代码表, "zh"), 无);
        断言相等!(解析语言选择("4", &代码表, "zh"), 无);
        断言相等!(解析语言选择("it", &代码表, "zh"), 无);
    }

    /// 未识别区域设置时保留原文标签，供回退提示回显
    #[测试]
    函数 系统区域标签保留原文() {
        让 _锁 = 包::语言管理::测试模块::环境锁();
        让 _环境 = 包::语言管理::测试模块::环境还原::接管(&[
            "LC_ALL",
            "LC_MESSAGES",
            "LANG",
        ]);
        不安全 {
            标准库::环境::设置环境变量("LANG", "it_IT.UTF-8");
        }
        断言相等!(探测系统语言标签(), 无);
        断言相等!(系统区域标签().作为解引用(), 有值("it"));
    }

    #[测试]
    函数 界面语言环境变量优先() {
        // 修改全局环境变量（RZ_LANG），需持环境变量锁避免污染并发测试
        让 _锁 = 包::语言管理::测试模块::环境锁();
        不安全 {
            标准库::环境::设置环境变量("RZ_LANG", "ru");
        }
        断言相等!(探测界面语言(), "ru");
        不安全 {
            标准库::环境::移除环境变量("RZ_LANG");
        }
        断言相等!(探测界面语言(), 探测系统语言());
    }
}
