//! 内置语言包 - 把默认语言包嵌入可执行文件
//!
//! 语言包 TOML 数据由引擎包在编译期嵌入，本模块通过 [`引擎库::语言::内置文件`]
//! 获取，使得 rzc 可执行文件无需附带语言包目录即可独立运行。
//! 通过 [`获取内置数据`] 按语言代码获取对应的内置语言包，未知语言代码自动回退到中文。

使用 标准库::同步::懒静态;

/// 单个语言的完整内置数据
公开 结构体 内置语言数据 {
    /// 关键字映射 TOML
    公开 关键字内容: 静态字符串引用,
    /// 模块路径映射 TOML
    公开 模块路径内容: 静态字符串引用,
    /// 标准库映射 TOML（模块路径 + 标识符别名）
    公开 标准库内容: 静态字符串引用,
    /// 错误消息翻译 TOML
    公开 错误内容: 静态字符串引用,
    /// 语言包信息 TOML（名称 / 扩展名 / 版本）
    公开 语言信息内容: 静态字符串引用,
    /// 第三方库映射文件列表（文件名, 内容）
    公开 三方库数据: 静态字符串对切片,
}

/// 定义内置语言包的宏
///
/// 参数：
/// - `$名字`：生成的 `静态` 变量名
/// - `$目录`：语言包目录名（如 中文、德语 对应目录）
///
/// 第三方库映射清单不再手工维护：从引擎编译期扫描结果
/// （[`引擎库::语言::内置语言包文件`]，构建脚本生成）动态过滤
/// 第三方库子目录前缀条目，与语言包目录（单一数据源）天然一致，
/// 新增/删除 第三方库映射文件后无需修改本文件。
宏规则! 定义内置语言 {
    ($名字:标识符, $目录:字面量) => {
        静态 $名字: 懒静态<内置语言数据> = 懒静态::新建(|| {
            // 第三方库映射数组需静态寿命引用，用 盒子::泄露 提升（仅初始化一次）
            让 三方库数据: 静态字符串对切片 = 盒子::泄露(盒子::新建(
                引擎库::语言::内置语言包文件($目录)
                    .消费迭代()
                    .过滤映射(|(文件条目, 内容)| {
                        文件条目.去前缀("crates/").变换(|名称| (名称, 内容))
                    })
                    .收集::<静态字符串对向量>(),
            ));
            内置语言数据 {
                关键字内容: 内置文件或恐慌($目录, "keywords.toml"),
                模块路径内容: 内置文件或恐慌($目录, "module_paths.toml"),
                标准库内容: 内置文件或恐慌($目录, "stdlib.toml"),
                错误内容: 内置文件或恐慌($目录, "errors.toml"),
                语言信息内容: 内置文件或恐慌($目录, "lang_info.toml"),
                三方库数据,
            }
        });
    };
}

/// 从引擎内置语言包取文件内容（缺失时恐慌，内置数据必须完整）
函数 内置文件或恐慌(语言码: &文本, 目标文件: &文本) -> 静态字符串引用 {
    引擎库::语言::内置文件(语言码, 目标文件).期望("内置语言包文件缺失：引擎未嵌入该文件")
}

// 英文内置语言包（恒等映射：Rust 本以英文书写；教程验证管线依赖英文扩展名）
定义内置语言!(英文数据, "en");

// 中文内置语言包（完整翻译映射；第三方库映射清单自动纳入）
定义内置语言!(中文数据, "zh");

// 德语内置语言包（德语错误教学提示；第三方库映射清单自动纳入）
定义内置语言!(德文数据, "de");

// 日语内置语言包
定义内置语言!(日文数据, "ja");

// 俄语内置语言包
定义内置语言!(俄文数据, "ru");

// 西班牙语内置语言包
定义内置语言!(西班牙文数据, "es");

// 法语内置语言包
定义内置语言!(法文数据, "fr");

// 葡萄牙语内置语言包
定义内置语言!(葡萄牙文数据, "pt");

// 韩语内置语言包
定义内置语言!(韩文数据, "ko");

// 阿拉伯语内置语言包
定义内置语言!(阿拉伯文数据, "ar");

// 印地语内置语言包
定义内置语言!(印地文数据, "hi");

/// 根据语言代码获取内置语言包数据
///
/// 已知语言代码（如 中文 / 德语）返回对应语言包；
/// **未知语言代码自动回退到中文**，保证任何语言设置下都有可用数据。
///
/// 内部数据由构建脚本从 `crates/engine/lang-packs/` 扫描生成，新增语言包后需
/// 重新构建；删除语言包（如英文，Rust 本就以英文书写，恒等映射无教学价值）时
/// 同步更新本文件与各引用点。新增语言时：在 [`获取内置数据`] 与 [`有内置语言包`]
/// 中增加分支，用 [`定义内置语言!`] 添加对应 静态 数据，并更新 [`内置语言清单`]。
公开 函数 获取内置数据(语言码: &文本) -> &内置语言数据 {
    匹配 语言码 {
        "zh" => &中文数据,
        "en" => &英文数据,
        "de" => &德文数据,
        "ja" => &日文数据,
        "ru" => &俄文数据,
        "es" => &西班牙文数据,
        "fr" => &法文数据,
        "pt" => &葡萄牙文数据,
        "ko" => &韩文数据,
        "ar" => &阿拉伯文数据,
        "hi" => &印地文数据,
        // 未知语言代码回退到中文（教学语言默认值）
        _ => &中文数据,
    }
}

/// 判断语言代码是否有对应的内置语言包
///
/// 用于区分"已内置的语言"与"需通过 `rzc lang install` 远程安装的语言"，
/// 避免未知语言被静默回退到中文时用户无感知。
/// 单一事实源：引擎 lang-packs 目录（构建脚本自动生成）。
公开 函数 有内置语言包(语言码: &文本) -> 布尔 {
    引擎库::语言::有内置语言(语言码)
}

/// 所有内置语言包的代码列表
///
/// 供 `rzc lang list` 展示与 `rzc lang remove` 的内置保护使用。
/// 其他语言通过 `rzc lang install` 从远程仓库安装。
/// 单一事实源：引擎 lang-packs 目录（构建脚本自动生成），
/// 避免代码清单与语言包目录、扩展名清单并行维护而漂移。
公开 函数 内置语言清单() -> 向量<静态字符串引用> {
    引擎库::语言::内置语言代码()
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    /// 全部内置语言均能获取到数据，且 TOML 内容非空
    #[测试]
    函数 已知语言均有数据() {
        对于 代码 在 ["zh", "en", "de", "ja", "ru", "es", "fr", "pt", "ko", "ar", "hi"] {
            让 数据 = 获取内置数据(代码);
            断言(!数据.关键字内容.是否为空(), "{代码} 关键字 为空");
            断言(!数据.模块路径内容.是否为空(), "{代码} 模块路径 为空");
            断言(!数据.标准库内容.是否为空(), "{代码} 标准库 为空");
            断言(!数据.错误内容.是否为空(), "{代码} 错误 为空");
            断言(!数据.语言信息内容.是否为空(), "{代码} 语言信息 为空");
        }
    }

    /// 未知语言代码回退到中文（回退数据与中文包内容一致）
    #[测试]
    函数 未知语言回退到中文() {
        让 数据 = 获取内置数据("xx");
        让 中文 = 获取内置数据("zh");
        断言相等!(数据.关键字内容, 中文.关键字内容, "未知语言应回退到中文包");
    }

    /// 三方库 清单与引擎编译期扫描结果逐项一致（单一数据源，杜绝手工清单漂移）；
    /// 标准库内容 两节齐全（模块路径 + 标识符）
    #[测试]
    函数 各语言三方库清单一致() {
        对于 代码 在 ["zh", "de", "ja", "ru", "es", "fr", "pt", "ko", "ar", "hi"] {
            让 扫描: 向量<&文本> = 引擎库::语言::内置语言包文件(代码)
                .消费迭代()
                .过滤映射(|(文件条目, _)| 文件条目.去前缀("crates/"))
                .收集();
            让 清单: 向量<&文本> = 获取内置数据(代码)
                .三方库数据
                .迭代()
                .变换(|(名称, _)| *名称)
                .收集();
            断言相等!(清单, 扫描, "{代码} 三方库 清单应与引擎扫描一致");
            断言(!清单.是否为空(), "{代码} 应含第三方库映射");
        }
        // 中文 已内置 tauri 映射（桌面应用常用），防止清单再次遗漏
        断言(
            获取内置数据("zh")
                .三方库数据
                .迭代()
                .任意(|(名称, _)| *名称 == "tauri.toml"),
            "中文 内置清单应包含 tauri.toml"
        );
        // 标准库内容 中模块路径与标识符两节均存在
        对于 数据 在 [获取内置数据("zh"), 获取内置数据("de")] {
            断言(数据.标准库内容.包含("[\"模块路径\"]"));
            断言(数据.标准库内容.包含("[\"标识符\"]"));
        }
    }

    /// 各语言包元数据互相独立（名称不同）
    #[测试]
    函数 各语言元信息互异() {
        让 代码表 = 内置语言清单();
        让 信息表: 向量<&文本> = 代码表
            .迭代()
            .变换(|代码| 获取内置数据(代码).语言信息内容)
            .收集();
        对于 (序, 甲) 在 信息表.迭代().枚举() {
            对于 (乙序, 乙) 在 信息表[序 + 1..].迭代().枚举() {
                断言不等!(
                    甲,
                    乙,
                    "{} 与 {} 的语言信息 相同",
                    代码表[序],
                    代码表[序 + 1 + 乙序]
                );
            }
        }
    }

    /// 内置代码列表与 有内置语言包 一致
    #[测试]
    函数 内置代码清单自洽() {
        对于 代码 在 内置语言清单() {
            断言(有内置语言包(代码), "{代码} 应在内置列表中");
        }
        断言(!有内置语言包("xx"));
    }
}
