        断言相等!(默认源列表[1].仓库地址, 默认仓库源列表[1]);
    }

    #[测试]
    函数 测试多源回退安装() {
        让 _锁 = 环境锁();
        让 临时根 = tempfile::tempdir().unwrap();
        让 备份仓库 = 临时根.path().join("lang_repo");
        fs::create_dir_all(&备份仓库).unwrap();
        制作临时语言包(&备份仓库, "中文");
        对于 命令参数 in [
            &["init", "-b", "main"][..],
            &["add", "."][..],
            &["commit", "-m", "init"][..],
        ] {
            让 返回结果 = Command::new("git")
                .args(命令参数)
                .current_dir(&备份仓库)
                .env("GIT_AUTHOR_NAME", "测试")
                .env("GIT_AUTHOR_EMAIL", "test@example.com")
                .env("GIT_COMMITTER_NAME", "测试")
                .env("GIT_COMMITTER_EMAIL", "test@example.com")
                .stdout(std::process::Stdio::null())
                .stderr(std::process::Stdio::null())
                .output();
            让 返回状态 = 返回结果.期望("执行 git 失败").status;
            断言!(返回状态.success(), "git 子命令 {:?} 失败", 命令参数[0]);
        }

        让 主源 = 仓库源::自地址构造("file:///不存在的仓库路径");
        让 备用源 = 仓库源::自地址构造(备份仓库.to_str().unwrap());
        不安全 {
            std::env::set_var("RZ_LANG_DIR", 临时根.path().join("global"));
        }

        让 临时句柄 = 临时目录句柄::创建().unwrap();
        让 返回结果 = 尝试全部源("中文", &[主源, 备用源], &临时句柄, 假);
        断言!(
            返回结果.is_ok(),
            "首选源失败后应自动回退备用源：{}",
            返回结果.err().map(|错| 错.to_string()).unwrap_or_default()
        );
        断言!(全局语言目录().join("中文/keywords.toml").is_file());

        不安全 {
            std::env::remove_var("RZ_LANG_DIR");
        }
    }

    #[测试]
    函数 测试全部源失败错误消息() {
        让 _锁 = 环境锁();
        让 临时根 = tempfile::tempdir().unwrap();
        不安全 {
            std::env::set_var("RZ_LANG_DIR", 临时根.path().join("global"));
            // 固定界面语言为中文，保证错误消息断言稳定（系统语言无关）
            std::env::set_var("RZ_LANG", "zh");
        }
        让 坏源甲 = 仓库源::自地址构造("file:///不存在的仓库1");
        让 坏源乙 = 仓库源::自地址构造("file:///不存在的仓库2");
        让 临时句柄 = 临时目录句柄::创建().unwrap();
        让 错误文本 = 尝试全部源("中文", &[坏源甲, 坏源乙], &临时句柄, 假)
            .expect_err("两个源都失败应报错")
            .to_string();
        断言!(
            错误文本.contains("已依次尝试 2 个源"),
            "应报告尝试的源数量：{}",
            错误文本
        );
        断言!(
            错误文本.contains("file:///不存在的仓库1"),
            "应列出源1：{}",
            错误文本
        );
        断言!(
            错误文本.contains("file:///不存在的仓库2"),
            "应列出源2：{}",
            错误文本
        );
        断言!(
            错误文本.contains("RZ_LANG_REPO"),
            "应建议 RZ_LANG_REPO：{}",
            错误文本
        );
        不安全 {
            std::env::remove_var("RZ_LANG_DIR");
            std::env::remove_var("RZ_LANG");
        }
    }

    /// 市场扫描：三种仓库布局全部覆盖，无 keywords.toml 的目录不误报
    #[测试]
    函数 测试扫描仓库三种布局() {
        让 临时根 = tempfile::tempdir().unwrap();
        // 1. 仓库根直接是语言包（自建语言包仓库约定）
        制作临时语言包(临时根.path(), "中文");
        // 2. lang-packs/ 布局
        制作临时语言包(&临时根.path().join("lang-packs"), "日语");
        // 3. crates/engine/lang-packs/ 布局（主仓库单副本）
        制作临时语言包(&临时根.path().join("crates/engine/lang-packs"), "俄语");
        // 非语言包目录（无 keywords.toml）不应列出
        fs::create_dir_all(临时根.path().join("docs")).unwrap();

        让 命中项 = 扫描仓库语言(临时根.path());
        // 扫描顺序：根 → lang-packs → crates/engine（排序在 search 入口完成）
        让 代码列表: Vec<&文本> = 命中项.iter().map(|项| 项.语言代码.as_str()).collect();
        断言相等!(代码列表, ["中文", "日语", "俄语"]);
        断言!(命中项.iter().all(|项| 项.显示名称.is_none()));
    }

    /// 市场扫描：布局间同名去重（保留先发现的根目录版本）
    #[测试]
    函数 测试扫描仓库同名去重() {
        让 临时根 = tempfile::tempdir().unwrap();
        制作临时语言包(临时根.path(), "中文");
        制作临时语言包(&临时根.path().join("lang-packs"), "中文");

        让 命中项 = 扫描仓库语言(临时根.path());
        断言相等!(命中项.len(), 1, "同名语言包应去重：{:?}", 命中项);
    }

    /// 关键词过滤：匹配语言代码或显示名称，不区分大小写
    #[测试]
    函数 测试过滤远程语言() {
        让 命中项 = vec![
            远程语言信息 {
                语言代码: "vi".to_string(),
                显示名称: 有值("越南语".to_string()),
                版本号: 有值("1.0".to_string()),
            },
            远程语言信息 {
                语言代码: "zh".to_string(),
                显示名称: 有值("中文".to_string()),
                版本号: 无,
            },
        ];

        // 匹配代码（小写关键词）
        让 按代码 = 过滤远程语言(命中项.clone(), "VI");
        断言相等!(按代码.len(), 1);
        断言相等!(按代码[0].语言代码, "vi");
        // 匹配显示名称
        让 按名称 = 过滤远程语言(命中项.clone(), "越南");
        断言相等!(按名称.len(), 1);
        // 空关键词返回全部
        断言相等!(过滤远程语言(命中项.clone(), "  ").len(), 2);
        // 无匹配返回空
        断言!(过滤远程语言(命中项, "英语").is_empty());
    }
}
