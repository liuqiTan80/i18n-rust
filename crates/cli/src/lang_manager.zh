//! 语言包管理模块
//!
//! 实现 `rzc lang list / install / remove` 子命令的底层逻辑：
//! 管理用户全局语言包目录（默认 `~/.rz/lang-packs/`，可用 `RZ_LANG_DIR` 环境变量覆盖）。
//!
//! 每个语言包是一个目录，目录名即语言代码（如 `zh`、`ru`），
//! 内含 `keywords.toml`、`errors.toml`、`module_paths.toml` 及可选的 `crates/` 子目录。
//!
//! 远程安装：默认依次尝试 [`默认仓库源列表`]（GitCode 首选，失败自动回退 GitHub），
//! 每个源优先 `git clone`，git 不存在或克隆失败时回退 `curl` 下载 ZIP 压缩包并解压；
//! 设置 `RZ_LANG_REPO` 环境变量后完全使用用户指定地址（不再尝试默认源）。

使用 std::collections::HashMap;
使用 std::fs;
使用 std::path::{Path, PathBuf};
使用 std::process::Command;

/// 默认远程语言包源列表（按顺序依次尝试）
///
/// 首选 GitCode（中国用户访问速度快），失败自动回退 GitHub（海外用户可用）。
/// 仓库结构：每个语言包一个目录，目录名即语言代码，内含
/// `keywords.toml`、`errors.toml`、`module_paths.toml` 及可选 `crates/` 子目录。
///
/// 注意：占位符使用前请替换为实际的 GitCode/GitHub 用户名。
/// 设置 `RZ_LANG_REPO` 环境变量后完全使用用户指定地址，不再尝试默认源。
公开 常量 默认仓库源列表: [&文本; 2] = [
    "https://gitcode.com/tan80/i18n-rust",
    "https://github.com/liuqiTan80/i18n-rust",
];

/// 远程仓库源：git clone 地址与 curl 下载 ZIP 的地址
#[派生(调试, 克隆)]
公开(crate) 结构体 仓库源 {
    /// git clone 使用的仓库地址
    公开(crate) 仓库地址: 字符串,
    /// curl 下载 ZIP 压缩包的地址
    公开(crate) 压缩包地址: 字符串,
}

实现 仓库源 {
    /// 从仓库地址生成 git 与 ZIP 下载地址
    ///
    /// - GitCode：`<仓库>/repository/archive/master.zip`（默认分支 master）
    /// - GitHub：`<仓库>/archive/refs/heads/main.zip`（默认分支 main）
    /// - 其他平台（含本地 HTTP 服务器测试）：按 GitHub 风格生成
    公开(crate) 函数 自地址构造(地址: &文本) -> 自身 {
        让 地址 = 地址.trim_end_matches('/');
        让 压缩包地址 = 如果 地址.contains("gitcode.com") {
            格式化!("{}/repository/archive/master.zip", 地址)
        } 否则 {
            格式化!("{}/archive/refs/heads/main.zip", 地址)
        };
        自身 {
            仓库地址: 地址.to_string(),
            压缩包地址,
        }
    }
}

/// 收集本次安装要尝试的仓库源列表
///
/// 若设置了 `RZ_LANG_REPO` 环境变量，完全使用用户指定的地址；
/// 否则依次尝试 [`默认仓库源列表`]（GitCode 首选，GitHub 备用）。
函数 收集源() -> Vec<仓库源> {
    如果 让 成功(自定义) = std::env::var("RZ_LANG_REPO") {
        让 自定义 = 自定义.trim().trim_end_matches('/').to_string();
        如果 !自定义.is_empty() {
            返回 vec![仓库源::自地址构造(&自定义)];
        }
    }
    默认仓库源列表
        .iter()
        .map(|地址| 仓库源::自地址构造(地址))
        .collect()
}

/// 语言包来源
#[派生(调试, 克隆, 复制, 部分相等, 相等)]
公开 枚举 语言来源 {
    /// 内置在 rzc 可执行文件中（不可删除）
    内置,
    /// 用户通过 `rzc lang install` 安装到全局目录
    用户安装,
}

/// 单个已安装语言包的信息
公开 结构体 语言信息 {
    /// 语言代码（目录名）
    公开 语言代码: 字符串,
    /// 来源
    公开 语言来源: 语言来源,
    /// 扩展名（不含点）；旧语言包无 lang_info.toml 时从静态映射推断
    公开 文件扩展名: 选项<字符串>,
    /// 版本号；旧语言包无 lang_info.toml 时为 None
    公开 版本号: 选项<字符串>,
    /// 语言显示名称（来自 lang_info.toml；旧语言包为 None）
    公开 显示名称: 选项<字符串>,
}

/// 语言包元数据（来自 lang_info.toml）
公开 结构体 语言元数据 {
    /// 语言名称
    公开 语言名称: 字符串,
    /// 源码文件扩展名（不含点）
    公开 文件扩展名: 字符串,
    /// 版本号
    公开 版本号: 字符串,
}

/// 解析 lang_info.toml 内容
///
/// 格式（引号包裹键，符合 TOML 规范——裸键仅允许 ASCII）：
/// ```toml
/// ["语言包"]
/// "名称" = "俄语"
/// "扩展名" = "ru"
/// "版本" = "1.0"
/// ```
/// 版本缺省时为 "1.0"；名称或扩展名缺失/为空时返回 None。
/// 兼容用户手写的裸键写法：标准解析失败时回退手工解析。
函数 解析语言信息(内容文本: &文本) -> 选项<语言元数据> {
    // 1. 标准 TOML 解析：兼容引号包裹的键
    如果 让 成功(根表) = toml::from_str::<toml::Value>(内容文本)
        && 让 有值(节表) = 根表.get("语言包")
        && 让 有值(元数据项) = 提取自表(节表)
    {
        返回 有值(元数据项);
    }
    // 2. 回退手工解析：兼容中文裸键的用户示例写法
    手工解析(内容文本)
}

/// 从解析出的 [语言包] 节表提取元数据
函数 提取自表(节表: &toml::Value) -> 选项<语言元数据> {
    让 语言名称 = 节表.get("名称")?.as_str()?.trim();
    让 文件扩展名 = 节表.get("扩展名")?.as_str()?.trim();
    如果 语言名称.is_empty() || 文件扩展名.is_empty() {
        返回 无;
    }
    让 版本号 = 节表
        .get("版本")
        .and_then(|当前值| 当前值.as_str())
        .unwrap_or("1.0")
        .trim()
        .to_string();
    有值(语言元数据 {
        语言名称: 语言名称.to_string(),
        文件扩展名: 文件扩展名.to_string(),
        版本号,
    })
}

/// 手工逐行解析 `键 = "值"`，兼容标准 TOML 不允许的非 ASCII 裸键
///
/// 只识别 名称 / 扩展名 / 版本 三个字段，忽略注释与节头。
函数 手工解析(内容文本: &文本) -> 选项<语言元数据> {
    让 可变 语言名称: 选项<字符串> = 无;
    让 可变 文件扩展名: 选项<字符串> = 无;
    让 可变 版本号: 选项<字符串> = 无;
    让 可变 含语言节 = 假;
    对于 每行 in 内容文本.lines() {
        让 每行 = 每行.trim();
        如果 每行.is_empty() || 每行.starts_with('#') {
            继续;
        }
        如果 每行.starts_with('[') {
            让 节名 = 每行
                .trim_start_matches('[')
                .trim_end_matches(']')
                .trim_matches('"')
                .trim();
            如果 节名 == "语言包" {
                含语言节 = 真;
            }
            继续;
        }
        让 (键名, 值文本) = 每行.split_once('=')?;
        让 键名 = 键名.trim().trim_matches('"').trim();
        让 值文本 = 值文本.trim().trim_matches('"').trim();
        如果 值文本.is_empty() {
            返回 无;
        }
        匹配 键名 {
            "名称" => 语言名称 = 有值(值文本.to_string()),
            "扩展名" => 文件扩展名 = 有值(值文本.to_string()),
            "版本" => 版本号 = 有值(值文本.to_string()),
            _ => {}
        }
    }
    如果 !含语言节 {
        返回 无;
    }
    有值(语言元数据 {
        语言名称: 语言名称?,
        文件扩展名: 文件扩展名?,
        版本号: 版本号.unwrap_or_else(|| "1.0".to_string()),
    })
}

/// 读取目录中语言包的元数据（读取并解析 lang_info.toml）
公开 函数 读语言信息(目录: &Path) -> 选项<语言元数据> {
    让 内容文本 = fs::read_to_string(目录.join("lang_info.toml")).ok()?;
    解析语言信息(&内容文本)
}

/// 获取内置语言包的元数据（来自嵌入可执行文件的 lang_info.toml）
公开 函数 取内置元数据(语言代码: &文本) -> 选项<语言元数据> {
    // 内置代码列表内的语言必然存在；未知代码回退到中文不影响元数据查询
    让 内置数据 = crate::builtin_lang::获取内置数据(语言代码);
    解析语言信息(内置数据.语言信息文本)
}

/// 获取全局语言包根目录
///
/// 优先使用 `RZ_LANG_DIR` 环境变量，否则默认 `~/.rz/lang-packs/`。
公开 函数 全局语言目录() -> PathBuf {
    如果 让 成功(目录) = std::env::var("RZ_LANG_DIR")
        && !目录.is_empty()
    {
        返回 PathBuf::from(目录);
    }
    // HOME（Unix）优先，USERPROFILE（Windows）回退，保证跨平台安装目录正确
    让 主目录 = std::env::var("HOME")
        .or_else(|_| std::env::var("USERPROFILE"))
        .unwrap_or_else(|_| ".".to_string());
    PathBuf::from(主目录).join(".rz").join("lang-packs")
}

/// 列出所有已安装的语言包（内置 + 用户安装）
///
/// 内置语言包固定在前，用户安装的按名称排序在后。
/// 扩展名/版本来自 lang_info.toml；旧语言包无该文件时扩展名回退静态映射推断。
公开 函数 列语言() -> Vec<语言信息> {
    让 可变 列表: Vec<语言信息> = crate::builtin_lang::内置语言代码()
        .into_iter()
        .map(|语言代码| {
            让 元数据项 = 取内置元数据(语言代码);
            语言信息 {
                语言代码: 语言代码.to_string(),
                语言来源: 语言来源::内置,
                文件扩展名: 元数据项
                    .as_ref()
                    .map(|项| 项.文件扩展名.clone())
                    .or_else(|| 静态代码转扩展名(语言代码)),
                版本号: 元数据项.as_ref().map(|项| 项.版本号.clone()),
                显示名称: 元数据项.map(|项| 项.语言名称.clone()),
            }
        })
        .collect();

    // 扫描全局目录：含 keywords.toml 的子目录视为语言包
    让 根目录 = 全局语言目录();
    让 可变 用户安装项: Vec<(字符串, 选项<语言元数据>)> = Vec::new();
    如果 让 成功(读取结果) = fs::read_dir(&根目录) {
        对于 每个条目 in 读取结果.flatten() {
            让 目标路径 = 每个条目.path();
            如果 目标路径.is_dir()
                && 目标路径.join("keywords.toml").is_file()
                && 让 有值(目录名) = 目标路径.file_name().and_then(|原始名| 原始名.to_str())
            {
                用户安装项.push((目录名.to_string(), 读语言信息(&目标路径)));
            }
        }
    }
    用户安装项.sort_by(|甲, 乙| 甲.0.cmp(&乙.0));
    对于 (语言代码, 元数据项) in 用户安装项 {
        列表.push(语言信息 {
            文件扩展名: 元数据项
                .as_ref()
                .map(|项| 项.文件扩展名.clone())
                .or_else(|| 静态代码转扩展名(&语言代码)),
            版本号: 元数据项.as_ref().map(|项| 项.版本号.clone()),
            显示名称: 元数据项.map(|项| 项.语言名称.clone()),
            语言代码,
            语言来源: 语言来源::用户安装,
        });
    }
    列表
}

/// 静态扩展名映射（扩展名 → 语言代码）
///
/// 作为动态映射的回退，保证无 lang_info.toml 的旧语言包向后兼容。
公开 函数 静态扩展名映射() -> HashMap<字符串, 字符串> {
    [
        ("zh", "中文"),
        ("ru", "俄语"),
        ("ja", "日语"),
        ("ko", "韩语"),
    ]
    .into_iter()
    .map(|(扩展名, 语言代码)| (扩展名.to_string(), 语言代码.to_string()))
    .collect()
}

/// 静态映射反查：语言代码 → 扩展名（旧语言包推断用）
函数 静态代码转扩展名(语言代码: &文本) -> 选项<字符串> {
    静态扩展名映射()
        .into_iter()
        .find(|(_, 代码)| 代码 == 语言代码)
        .map(|(扩展名, _)| 扩展名)
}

/// 构建 扩展名 → 语言代码 的动态映射表
///
/// 来源：内置语言包元数据 + 全局用户语言包目录。
/// 用户安装的语言包优先于内置（同名扩展名时覆盖）；
/// 无 lang_info.toml 的旧语言包回退静态映射推断。
公开 函数 构建扩展名映射() -> HashMap<字符串, 字符串> {
    让 可变 映射表 = HashMap::new();

    // 1. 内置语言包
    对于 语言代码 in crate::builtin_lang::内置语言代码() {
        如果 让 有值(元数据项) = 取内置元数据(语言代码) {
            映射表.insert(元数据项.文件扩展名, 语言代码.to_string());
        } 否则 如果 让 有值(扩展名) = 静态代码转扩展名(语言代码) {
            映射表.insert(扩展名, 语言代码.to_string());
        }
    }

    // 2. 全局用户语言包（覆盖内置）
    让 根目录 = 全局语言目录();
    如果 让 成功(读取结果) = fs::read_dir(&根目录) {
        对于 每个条目 in 读取结果.flatten() {
            让 目标路径 = 每个条目.path();
            如果 !目标路径.is_dir() || !目标路径.join("keywords.toml").is_file() {
                继续;
            }
            让 有值(语言代码) = 目标路径.file_name().and_then(|原始名| 原始名.to_str()).map(字符串::from) 否则 {
                继续;
            };
            如果 让 有值(元数据项) = 读语言信息(&目标路径) {
                映射表.insert(元数据项.文件扩展名, 语言代码.clone());
            } 否则 如果 让 有值(扩展名) = 静态代码转扩展名(&语言代码) {
                映射表.insert(扩展名, 语言代码);
            }
        }
    }
    映射表
}

/// 查询 扩展名 → 语言代码 的动态映射
公开 函数 查询扩展名映射(文件扩展名: &文本) -> 选项<字符串> {
    构建扩展名映射().remove(文件扩展名)
}

/// 全局语言包目录中的一个候选条目
///
/// 只要子目录内含 `keywords.toml` 就视为语言包（与 `构建扩展名映射` 同口径），
/// `目录名` 为目录名（语言 code 即取此名）。
公开 结构体 全局语言包 {
    公开 目录名: 字符串,
    /// lang_info.toml 元数据；缺失或不可解析时为 None（扩展名回退静态映射推断）
    公开 包元数据: 选项<语言元数据>,
}

/// 扫描全局语言包目录（`~/.rz/lang-packs/`，`RZ_LANG_DIR` 可改）
///
/// 供 `rzc doctor` 做语言包健康检查：定位陈旧副本遮蔽内置表、备份/杂项目录
/// 被当语言包吃掉等问题（这类问题只在用户环境发生，静态门检查和不了）。
/// 目录不存在或不可读时返回空列表（不报错）。
公开 函数 扫描全局包() -> Vec<全局语言包> {
    让 可变 包列表 = Vec::new();
    如果 让 成功(读取结果) = fs::read_dir(全局语言目录()) {
        对于 每个条目 in 读取结果.flatten() {
            让 目标路径 = 每个条目.path();
            如果 !目标路径.is_dir() || !目标路径.join("keywords.toml").is_file() {
                继续;
            }
            让 有值(目录名) = 目标路径.file_name().and_then(|原始名| 原始名.to_str()) 否则 {
                继续;
            };
            包列表.push(全局语言包 {
                目录名: 目录名.to_string(),
                包元数据: 读语言信息(&目标路径),
            });
        }
    }
    包列表.sort_by(|甲, 乙| 甲.目录名.cmp(&乙.目录名));
    包列表
}

/// 全局语言包目录下的子目录名（含不具备 `keywords.toml` 的）
///
/// 用于识别改名后仍留在 `lang-packs/` 内的备份目录（它们仍会被当语言包吃掉）。
公开 函数 全局包子目录名() -> Vec<字符串> {
    让 可变 名列表 = Vec::new();
    如果 让 成功(读取结果) = fs::read_dir(全局语言目录()) {
        对于 每个条目 in 读取结果.flatten() {
            让 目标路径 = 每个条目.path();
            如果 !目标路径.is_dir() {
                继续;
            }
            如果 让 有值(目录名) = 目标路径.file_name().and_then(|原始名| 原始名.to_str()) {
                名列表.push(目录名.to_string());
            }
        }
    }
    名列表.sort();
    名列表
}

/// 所有当前可用的扩展名（按名称排序）
公开 函数 全部可用扩展名() -> Vec<字符串> {
    让 可变 列表: Vec<字符串> = 构建扩展名映射().into_keys().collect();
    列表.sort();
    列表
}

/// 安装语言包
///
/// - `<source>` 是本地存在的目录路径：校验结构后整体复制到全局语言包目录。
/// - 否则视为语言代码：从远程仓库下载安装。
/// - 目标已存在时默认报错；`force` 为 true 时覆盖安装。
公开 函数 安装语言(源地址: &文本, 强制: 布尔) -> anyhow::结果<()> {
    让 源路径 = PathBuf::from(源地址);
    如果 源路径.is_dir() {
        校验语言包目录(&源路径)?;
        让 语言代码 = 源路径
            .file_name()
            .and_then(|原始名| 原始名.to_str())
            .ok_or_else(|| {
                anyhow::anyhow!(
                    "{}",
                    crate::ui::界面::全局().取文带参(
                        "lc_err_lang_code_from_path",
                        &[&源路径.display().to_string()]
                    )
                )
            })?;
        返回 复制到全局目录(&源路径, 语言代码, 强制);
    }
    安装远程语言(源地址, 强制)
}

/// 删除用户安装的语言包
///
/// 内置语言包不可删除；同名用户安装包存在时优先删除用户安装的。
公开 函数 删除语言(语言代码: &文本) -> anyhow::结果<()> {
    让 界面 = crate::ui::界面::全局();
    // 校验语言代码，防止 ../ 等路径遍历导致删除语言包目录之外的目录
    如果 !校验语言代码(语言代码) {
        anyhow::bail!("{}", 界面.取文带参("invalid_lang_code", &[语言代码]));
    }
    让 目标目录 = 全局语言目录().join(语言代码);
    如果 目标目录.is_dir() {
        fs::remove_dir_all(&目标目录)?;
        println!("{}", 界面.取文带参("lang_removed", &[语言代码]));
        返回 成功(());
    }

    如果 crate::builtin_lang::内置语言代码().contains(&语言代码) {
        anyhow::bail!("{}", 界面.取文带参("lang_builtin_not_removable", &[语言代码]));
    }

    anyhow::bail!(
        "{}",
        界面.取文带参(
            "lang_not_found",
            &[语言代码, &目标目录.display().to_string()]
        )
    );
}

/// 从远程仓库安装语言包
函数 安装远程语言(语言代码: &文本, 强制: 布尔) -> anyhow::结果<()> {
    让 界面 = crate::ui::界面::全局();
    如果 !校验语言代码(语言代码) {
        anyhow::bail!("{}", 界面.取文带参("invalid_lang_code", &[语言代码]));
    }
    让 源列表 = 收集源();
    让 临时句柄 = 临时目录句柄::创建()?;
    尝试全部源(语言代码, &源列表, &临时句柄, 强制)
}

/// 远程语言包市场条目（`rzc lang search` 的浏览结果）
#[派生(调试, 克隆)]
公开 结构体 远程语言信息 {
    /// 语言代码（目录名）
    公开 语言代码: 字符串,
    /// 显示名称（来自 lang_info.toml；旧语言包为 None）
    公开 显示名称: 选项<字符串>,
    /// 版本号（来自 lang_info.toml；旧语言包为 None）
    公开 版本号: 选项<字符串>,
}

/// 浏览远程语言包市场：下载仓库 ZIP 后扫描可用语言包
///
/// 依次尝试 [`收集源`] 中的源，首个成功下载并解析的源即返回其
/// 语言包列表（与 install 的源回退策略一致）；`关键词` 为 Some 时按
/// 语言代码或显示名称模糊过滤（不区分大小写）。全部失败时聚合错误。
公开 函数 搜索远程语言(关键词: 选项<&文本>) -> anyhow::结果<Vec<远程语言信息>> {
    让 源列表 = 收集源();
    让 临时句柄 = 临时目录句柄::创建()?;
    让 可变 错误详情 = Vec::new();
    对于 (索引号, 源项) in 源列表.iter().enumerate() {
        匹配 取仓库压缩(源项, &临时句柄) {
            成功(仓库目录) => {
                让 可变 命中项 = 扫描仓库语言(&仓库目录);
                命中项.sort_by(|甲, 乙| 甲.语言代码.cmp(&乙.语言代码));
                返回 成功(过滤远程语言(命中项, 关键词.unwrap_or("")));
            }
            错误(错) => 错误详情.push(crate::ui::界面::全局().取文带参(
                "lc_err_source_detail",
                &[&(索引号 + 1).to_string(), &源项.仓库地址, &错.to_string()],
            )),
        }
    }
    让 界面 = crate::ui::界面::全局();
    anyhow::bail!(
        "{}",
        界面.取文带参(
            "lang_search_failed",
            &[
                关键词.unwrap_or(""),
                &源列表.len().to_string(),
                &错误详情.join("\n"),
            ]
        )
    )
}

/// 按关键词过滤远程语言包（匹配语言代码或显示名称，不区分大小写）
函数 过滤远程语言(命中项: Vec<远程语言信息>, 关键词: &文本) -> Vec<远程语言信息> {
    让 小写关键词 = 关键词.trim().to_lowercase();
    如果 小写关键词.is_empty() {
        返回 命中项;
    }
    命中项
        .into_iter()
        .filter(|项| {
            项.语言代码.to_lowercase().contains(&小写关键词)
                || 项
                    .显示名称
                    .as_deref()
                    .is_some_and(|名| 名.to_lowercase().contains(&小写关键词))
        })
        .collect()
}

/// 下载仓库 ZIP 并解压，返回仓库根目录（自动下沉单层根目录）
///
/// 设为 `pub(crate)` 以便 `crate_registry` 模块复用同一套 curl 下载/解压逻辑。
公开(crate) 函数 取仓库压缩(源项: &仓库源, 临时句柄: &临时目录句柄) -> anyhow::结果<PathBuf> {
    // 复用 curl 下载（与安装回退路径一致）；GitHub/GitCode 的 ZIP 顶层均为
    // `<仓库>-<分支>/` 目录，解压后若仅含一个目录则以其为仓库根。
    让 下载路径 = 临时句柄.目录路径().join("lang_market.zip");
    让 命令输出 = Command::new("curl")
        .arg("-L")
        .arg("--fail")
        .arg("-o")
        .arg(&下载路径)
        .arg(&源项.压缩包地址)
        .stdout(std::process::Stdio::null())
        .stderr(std::process::Stdio::piped())
        .output()
        .map_err(|错| {
            anyhow::anyhow!(
                "{}",
                crate::ui::界面::全局().取文带参("lc_err_curl_run", &[&错.to_string()])
            )
        })?;
    如果 !命令输出.status.success() {
        让 输出明细 = 字符串::from_utf8_lossy(&命令输出.stderr);
        anyhow::bail!(
            "{}",
            crate::ui::界面::全局().取文带参("lc_err_curl_download", &[&源项.压缩包地址, 输出明细.trim()])
        );
    }
    让 解压目录 = 临时句柄.目录路径().join("market_extracted");
    解压压缩包(&下载路径, &解压目录)?;
    让 可变 解压项: Vec<PathBuf> = fs::read_dir(&解压目录)
        .ok()
        .map(|读取结果| 读取结果.flatten().map(|每项| 每项.path()).collect())
        .unwrap_or_default();
    如果 解压项.len() == 1 && 解压项[0].is_dir() {
        成功(解压项.remove(0))
    } 否则 {
        成功(解压目录)
    }
}

/// 扫描仓库目录中的语言包（三种布局全部覆盖）
///
/// 1. 仓库根 `<语言码>/`（自建语言包仓库的约定结构）；
/// 2. `lang-packs/<语言码>/`（兼容旧版双副本结构与第三方仓库）；
/// 3. `crates/engine/lang-packs/<语言码>/`（主仓库 zrRust 单副本结构）。
函数 扫描仓库语言(仓库目录: &Path) -> Vec<远程语言信息> {
    让 可变 命中项: Vec<远程语言信息> = Vec::new();
    扫描目录语言(仓库目录, &可变 命中项);
    扫描目录语言(&仓库目录.join("lang-packs"), &可变 命中项);
    扫描目录语言(&仓库目录.join("crates/engine/lang-packs"), &可变 命中项);
    命中项
}

/// 扫描单个目录下的语言包子目录（含 keywords.toml 即视为语言包）
函数 扫描目录语言(目录: &Path, 命中项: &可变 Vec<远程语言信息>) {
    让 成功(读取结果) = fs::read_dir(目录) 否则 {
        返回;
    };
    对于 每个条目 in 读取结果.flatten() {
        让 目标路径 = 每个条目.path();
        如果 !目标路径.is_dir() || !目标路径.join("keywords.toml").is_file() {
            继续;
        }
        让 有值(语言代码) = 目标路径.file_name().and_then(|原始名| 原始名.to_str()) 否则 {
            继续;
        };
        // 布局间同名去重（保留先发现的；自建仓库根与 lang-packs 并存时）
        如果 命中项.iter().any(|项| 项.语言代码 == 语言代码) {
            继续;
        }
        让 元数据项 = 读语言信息(&目标路径);
        命中项.push(远程语言信息 {
            语言代码: 语言代码.to_string(),
            显示名称: 元数据项.as_ref().map(|项| 项.语言名称.clone()),
            版本号: 元数据项.as_ref().map(|项| 项.版本号.clone()),
        });
    }
}

/// 依次尝试多个源，全部失败时聚合错误并建议 `RZ_LANG_REPO`
函数 尝试全部源(语言代码: &文本, 源列表: &[仓库源], 临时句柄: &临时目录句柄, 强制: 布尔) -> anyhow::结果<()> {
    让 可变 错误详情 = Vec::new();
    对于 (索引号, 源项) in 源列表.iter().enumerate() {
        匹配 尝试单个源(语言代码, 源项, 临时句柄, 强制) {
            成功(()) => 返回 成功(()),
            错误(错) => 错误详情.push(crate::ui::界面::全局().取文带参(
                "lc_err_source_detail",
                &[&(索引号 + 1).to_string(), &源项.仓库地址, &错.to_string()],
            )),
        }
    }
    让 界面 = crate::ui::界面::全局();
    anyhow::bail!(
        "{}",
        界面.取文带参(
            "remote_install_failed",
            &[
                语言代码,
                &源列表.len().to_string(),
                &错误详情.join("\n"),
            ]
        )
    )
}

/// 尝试从单个源安装：优先 git clone，失败回退 curl 下载 ZIP
函数 尝试单个源(语言代码: &文本, 源项: &仓库源, 临时句柄: &临时目录句柄, 强制: 布尔) -> anyhow::结果<()> {
    让 克隆目录 = 临时句柄.目录路径().join("repo");
    让 git结果 = Command::new("git")
        .arg("clone")
        .arg("--depth")
        .arg("1")
        .arg(&源项.仓库地址)
        .arg(&克隆目录)
        .stdout(std::process::Stdio::null())
        .stderr(std::process::Stdio::piped())
        .output();
    匹配 git结果 {
        成功(命令输出) 如果 命令输出.status.success() => {
            自仓库目录安装(语言代码, &克隆目录, 强制)
        }
        成功(命令输出) => {
            让 git错误 = 字符串::from_utf8_lossy(&命令输出.stderr).trim().to_string();
            匹配 尝试curl安装(语言代码, &源项.压缩包地址, 临时句柄, 强制) {
                成功(()) => 成功(()),
                错误(curl错误) => {
                    如果 git错误.is_empty() {
                        错误(curl错误)
                    } 否则 {
                        anyhow::bail!(
                            "{}",
                            crate::ui::界面::全局().取文带参(
                                "lc_err_git_curl_both",
                                &[&git错误, &curl错误.to_string()]
                            )
                        )
                    }
                }
            }
        }
        错误(错) => {
            如果 错.kind() == std::io::ErrorKind::NotFound {
                返回 尝试curl安装(语言代码, &源项.压缩包地址, 临时句柄, 强制);
            }
            错误(anyhow::anyhow!(
                "{}",
                crate::ui::界面::全局().取文带参("lc_err_git_run", &[&错.to_string()])
            ))
        }
    }
}

/// 从仓库目录安装指定语言包
///
/// 依次探测三个位置：
/// 1. 仓库根 `<语言码>/`（自建语言包仓库的约定结构）；
/// 2. 仓库根 `lang-packs/<语言码>/`（兼容旧版双副本结构与第三方仓库）；
/// 3. `crates/engine/lang-packs/<语言码>/`（主仓库 zrRust 单副本结构，
///    使 `rzc lang install <码>` 可直接从主仓库安装）。
函数 自仓库目录安装(语言代码: &文本, 仓库目录: &Path, 强制: 布尔) -> anyhow::结果<()> {
    让 语言源 = 仓库目录.join(语言代码);
    让 语言源 = 如果 语言源.is_dir() {
        语言源
    } 否则 如果 仓库目录.join("lang-packs").join(语言代码).is_dir() {
        仓库目录.join("lang-packs").join(语言代码)
    } 否则 如果 仓库目录
        .join("crates/engine/lang-packs")
        .join(语言代码)
        .is_dir()
    {
        仓库目录.join("crates/engine/lang-packs").join(语言代码)
    } 否则 {
        让 界面 = crate::ui::界面::全局();
        anyhow::bail!("{}", 界面.取文带参("remote_lang_not_found", &[语言代码]));
    };
    校验语言包目录(&语言源)?;
    复制到全局目录(&语言源, 语言代码, 强制)
}

/// 回退方案：curl 下载 ZIP 压缩包并解压安装
函数 尝试curl安装(语言代码: &文本, 压缩包地址: &文本, 临时句柄: &临时目录句柄, 强制: 布尔) -> anyhow::结果<()> {
    让 下载路径 = 临时句柄.目录路径().join("lang_pack.zip");
    让 命令输出 = Command::new("curl")
        .arg("-L")
        .arg("--fail")
        .arg("-o")
        .arg(&下载路径)
        .arg(压缩包地址)
        .stdout(std::process::Stdio::null())
        .stderr(std::process::Stdio::piped())
        .output()
        .map_err(|错| {
            anyhow::anyhow!(
                "{}",
                crate::ui::界面::全局().取文带参("lc_err_curl_run", &[&错.to_string()])
            )
        })?;
    如果 !命令输出.status.success() {
        让 输出明细 = 字符串::from_utf8_lossy(&命令输出.stderr);
        anyhow::bail!(
            "{}",
            crate::ui::界面::全局().取文带参("lc_err_curl_download", &[压缩包地址, 输出明细.trim()])
        );
    }
    让 解压目录 = 临时句柄.目录路径().join("extracted");
    解压压缩包(&下载路径, &解压目录)?;
    让 语言源 = 在解压目录找语言(&解压目录, 语言代码).ok_or_else(|| {
        让 界面 = crate::ui::界面::全局();
        anyhow::anyhow!("{}", 界面.取文带参("remote_lang_not_found", &[语言代码]))
    })?;
    校验语言包目录(&语言源)?;
    复制到全局目录(&语言源, 语言代码, 强制)
}

/// 解压 ZIP 压缩包到目标目录（保留完整条目路径）
///
/// 每个条目名先经 [`安全压缩条目路径`] 校验，命中穿越向量的条目直接跳过。
函数 解压压缩包(压缩文件路径: &Path, 解压目录: &Path) -> anyhow::结果<()> {
    让 压缩文件 = fs::File::open(压缩文件路径).map_err(|错| {
        anyhow::anyhow!(
            "{}",
            crate::ui::界面::全局().取文带参(
                "lc_err_open_zip",
                &[&压缩文件路径.display().to_string(), &错.to_string()]
            )
        )
    })?;
    让 可变 归档 = zip::ZipArchive::new(压缩文件).map_err(|错| {
        anyhow::anyhow!(
            "{}",
            crate::ui::界面::全局().取文带参("lc_err_read_zip", &[&错.to_string()])
        )
    })?;
    对于 序号 in 0..归档.len() {
        让 可变 每个条目 = 归档.by_index(序号).map_err(|错| {
            anyhow::anyhow!(
                "{}",
                crate::ui::界面::全局().取文带参("lc_err_read_zip_entry", &[&错.to_string()])
            )
        })?;
        让 条目名 = 每个条目.name();
        // 条目名安全校验：拒绝绝对路径、盘符前缀与 `..` 上跳（详见函数文档）
        让 有值(目标路径) = 安全压缩条目路径(条目名).map(|相对路径| 解压目录.join(相对路径)) 否则 {
            继续;
        };
        如果 每个条目.is_dir() {
            fs::create_dir_all(&目标路径)?;
        } 否则 {
            如果 让 有值(上级目录) = 目标路径.parent() {
                fs::create_dir_all(上级目录)?;
            }
            让 可变 目标文件 = fs::File::create(&目标路径).map_err(|错| {
                anyhow::anyhow!(
                    "{}",
                    crate::ui::界面::全局().取文带参(
                        "lc_err_write_file",
                        &[&目标路径.display().to_string(), &错.to_string()]
                    )
                )
            })?;
            std::io::copy(&可变 每个条目, &可变 目标文件)?;
        }
    }
    成功(())
}

/// 校验 ZIP 条目名，返回可安全拼接到解压根目录的相对路径
///
/// 拒绝三类条目（均为路径穿越向量，命中返回 `None`）：
/// - **空名**：无有效路径段；
/// - **绝对路径**：`/etc/x`、`\etc\x`。反斜杠须先归一化为 `/`——ZIP 规范
///   要求 `/` 分隔，但 Windows 打包工具会写入 `\`，而 Unix 的
///   `Path::components` 不把 `\` 当分隔符，只按平台原生规则判断会漏拦；
/// - **`..` 上跳段**：`a/../../x`；
/// - **Windows 盘符前缀**：`C:/Users/x/...`。`Path::join` 遇带前缀的路径会
///   **整体替换** base（而非拼接），解压会写到 `extract_dir` 之外；该前缀
///   在 Unix 上不被 `Path::components` 识别为 `Prefix`，故必须显式判断，
///   仅检查 `..` 会完全漏掉这一向量。
函数 安全压缩条目路径(条目名: &文本) -> 选项<PathBuf> {
    让 归一化 = 条目名.replace('\\', "/");
    如果 归一化.is_empty() || 归一化.starts_with('/') {
        返回 无;
    }
    如果 归一化.split('/').any(|段| 段 == "..") {
        返回 无;
    }
    // 盘符前缀：首两字节为「ASCII 字母 + 冒号」即判定（`C:/x` 与盘符相对路径
    // `c:foo` 都属带前缀路径，`Path::join` 都会整体替换 base）
    让 字节数组 = 归一化.as_bytes();
    如果 字节数组.len() >= 2 && 字节数组[0].is_ascii_alphabetic() && 字节数组[1] == b':' {
        返回 无;
    }
    有值(PathBuf::from(归一化))
}

/// 在解压目录中查找语言包目录
函数 在解压目录找语言(解压目录: &Path, 语言代码: &文本) -> 选项<PathBuf> {
    让 直接路径 = 解压目录.join(语言代码);
    如果 直接路径.is_dir() {
        返回 有值(直接路径);
    }
    对于 每个条目 in fs::read_dir(解压目录).ok()?.flatten() {
        让 目标路径 = 每个条目.path();
        如果 目标路径.is_dir() {
            让 嵌套路径 = 目标路径.join(语言代码);
            如果 嵌套路径.is_dir() {
                返回 有值(嵌套路径);
            }
        }
    }
    无
}

/// 将源语言包目录复制到全局目录
函数 复制到全局目录(源目录: &Path, 语言代码: &文本, 强制: 布尔) -> anyhow::结果<()> {
    让 界面 = crate::ui::界面::全局();
    让 目标目录 = 全局语言目录().join(语言代码);
    如果 目标目录.exists() {
        如果 !强制 {
            anyhow::bail!(
                "{}",
                界面.取文带参(
                    "lang_already_installed",
                    &[语言代码, &目标目录.display().to_string(), 语言代码]
                )
            );
        }
        fs::remove_dir_all(&目标目录)?;
    }
    递归复制目录(源目录, &目标目录)?;
    println!(
        "{}",
        界面.取文带参(
            "lang_installed",
            &[语言代码, &目标目录.display().to_string()]
        )
    );
    println!("{}", 界面.取文("lang_install_hint"));
    成功(())
}

/// 校验语言包目录结构：必须包含 keywords.toml
函数 校验语言包目录(目标路径: &Path) -> anyhow::结果<()> {
    如果 !目标路径.join("keywords.toml").is_file() {
        让 界面 = crate::ui::界面::全局();
        anyhow::bail!(
            "{}",
            界面.取文带参("invalid_lang_dir", &[&目标路径.display().to_string()])
        );
    }
    成功(())
}

/// 校验语言代码可作为安全目录名（防止路径穿越）
函数 校验语言代码(语言代码: &文本) -> 布尔 {
    !语言代码.is_empty() && !语言代码.contains(['/', '\\']) && 语言代码 != "." && 语言代码 != ".."
}

/// 递归复制目录
函数 递归复制目录(源目录: &Path, 目标目录: &Path) -> anyhow::结果<()> {
    fs::create_dir_all(目标目录)?;
    对于 每个条目 in fs::read_dir(源目录)? {
        让 每个条目 = 每个条目?;
        让 源路径 = 每个条目.path();
        让 目标路径 = 目标目录.join(每个条目.file_name());
        如果 源路径.is_dir() {
            递归复制目录(&源路径, &目标路径)?;
        } 否则 {
            fs::copy(&源路径, &目标路径)?;
        }
    }
    成功(())
}

/// 临时目录句柄：Drop 时递归清理
///
/// 设为 `pub(crate)` 以便 `crate_registry` 模块持有临时仓库目录的生命周期。
公开(crate) 结构体 临时目录句柄(PathBuf);

实现 临时目录句柄 {
    公开(crate) 函数 创建() -> anyhow::结果<自身> {
        让 时间戳值 = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .map(|时长| 时长.as_nanos())
            .unwrap_or(0);
        // 用户隔离 + 符号链接校验（与 temp_guard/LSP 虚拟目录同一威胁模型）
        让 目标路径 = crate::temp_guard::安全临时路径(&格式化!(
            "rzc-lang-{}-{}-{}",
            crate::temp_guard::安全用户段(),
            std::process::id(),
            时间戳值
        ))?;
        fs::create_dir_all(&目标路径)?;
        成功(自身(目标路径))
    }

    公开(crate) 函数 目录路径(&自我) -> &Path {
        &自我.0
    }
}

实现 Drop for 临时目录句柄 {
    fn drop(&可变 自我) {
        让 _ = fs::remove_dir_all(&自我.0);
    }
}

#[配置(测试)]
公开(crate) 模块 单元测试 {
    使用 超级::*;

    /// 环境变量互斥锁：测试并行运行时保护 RZ_LANG_DIR 等全局环境变量。
    /// crate 级共享（而非模块私有）：其他模块（main/ui）中依赖环境变量状态、
    /// 或修改环境变量的测试同样必须持有本锁，否则并发执行时互相污染。
    静态 环境互斥锁: std::sync::Mutex<()> = std::sync::Mutex::new(());

    /// 获取环境变量互斥锁（供其他测试模块复用）。
    ///
    /// 锁被毒化时（持锁测试断言失败 panic）取回内部数据继续运行，
    /// 避免一次失败级联成后续所有持锁测试的 PoisonError 假故障。
    公开(crate) 函数 环境锁() -> std::sync::MutexGuard<'static, ()> {
        环境互斥锁.lock().unwrap_or_else(|错| 错.into_inner())
    }

    /// 环境变量临时接管守卫（供其他测试模块复用）：保存指定变量原值并从
    /// 环境移除，Drop 时恢复——断言失败 panic 时也不污染后续测试。
    公开(crate) 结构体 环境恢复(Vec<(&'static 文本, 选项<字符串>)>);

    实现 环境恢复 {
        /// 接管（保存并移除）指定环境变量；调用方须持有 环境锁
        公开(crate) 函数 接管(变量键: &[&'static 文本]) -> 自身 {
            让 保存值 = 变量键.iter().map(|本键| (*本键, std::env::var(本键).ok())).collect();
            对于 本键 in 变量键 {
                // Rust 2024：读写进程级环境变量为 unsafe，须由 环境锁 串行化
                不安全 {
                    std::env::remove_var(本键);
                }
            }
            自身(保存值)
        }
    }

    实现 Drop for 环境恢复 {
        fn drop(&可变 自我) {
            对于 (本键, 本值) in &自我.0 {
                匹配 本值 {
                    有值(变量值) => 不安全 {
                        std::env::set_var(本键, 变量值);
                    },
                    无 => 不安全 {
                        std::env::remove_var(本键);
                    },
                }
            }
        }
    }

    /// 在临时根下制作一个最小语言包目录（含 crates/ 子目录）
    函数 制作临时语言包(临时根: &Path, 目录名: &文本) {
        让 目录 = 临时根.join(目录名);
        fs::create_dir_all(目录.join("crates")).unwrap();
        fs::write(目录.join("keywords.toml"), "[\"声明\"]\n\"函数\" = \"fn\"\n").unwrap();
        fs::write(目录.join("errors.toml"), "[示例]\n\"a\" = \"b\"\n").unwrap();
        fs::write(目录.join("module_paths.toml"), "[示例]\n\"a\" = \"b\"\n").unwrap();
        fs::write(目录.join("crates/test.toml"), "[示例]\n\"a\" = \"b\"\n").unwrap();
    }

    #[测试]
    函数 测试安全条目路径拒绝穿越() {
        // 正常相对路径放行
        断言相等!(安全压缩条目路径("zh/keywords.toml"), 有值(PathBuf::from("zh/keywords.toml")));
        断言相等!(
            安全压缩条目路径("zh\\keywords.toml"),
            有值(PathBuf::from("zh/keywords.toml")),
            "反斜杠应归一化为正斜杠"
        );
        // 绝对路径（含反斜杠形态）
        断言!(安全压缩条目路径("/etc/passwd").is_none());
        断言!(安全压缩条目路径("\\etc\\passwd").is_none());
        // `..` 上跳
        断言!(安全压缩条目路径("../x").is_none());
        断言!(安全压缩条目路径("a/../../x").is_none());
        断言!(安全压缩条目路径("..\\..\\x").is_none());
        // Windows 盘符前缀：`Path::join` 会整体替换 base，务必拒绝
        断言!(安全压缩条目路径("C:/Users/x/Startup/y.cmd").is_none());
        断言!(安全压缩条目路径("c:relative").is_none());
        // 空名
        断言!(安全压缩条目路径("").is_none());
        // 首段含冒号但非盘符（首字符非 ASCII 字母）仍放行
        断言!(安全压缩条目路径("1b:c/x").is_some());
    }

    #[测试]
    函数 测试本地安装与删除流程() {
        让 _锁 = 环境锁();
        让 临时根 = tempfile::tempdir().unwrap();
        制作临时语言包(临时根.path(), "日语");
        让 源目录 = 临时根.path().join("日语");
        不安全 {
            std::env::set_var("RZ_LANG_DIR", 临时根.path().join("global"));
        }
        让 全局目录 = 全局语言目录();

        // 1. 安装前：只有内置
        让 列表1 = 列语言();
        断言!(列表1.iter().all(|项| 项.语言来源 == 语言来源::内置));

        // 2. 安装
        安装语言(源目录.to_str().unwrap(), 假).unwrap();
        断言!(全局目录.join("日语/keywords.toml").is_file());
        断言!(全局目录.join("日语/crates/test.toml").is_file());

        // 3. 列表中出现用户安装的
        让 列表2 = 列语言();
        让 日语项 = 列表2
            .iter()
            .find(|项| 项.语言代码 == "日语")
            .期望("日语应被列出");
        断言相等!(日语项.语言来源, 语言来源::用户安装);

        // 4. 重复安装报错
        断言!(安装语言(源目录.to_str().unwrap(), 假).is_err());
        // 4b. --force 覆盖成功
        安装语言(源目录.to_str().unwrap(), 真).unwrap();
        断言!(全局目录.join("日语/keywords.toml").is_file());

        // 5. 删除内置报错
        断言!(删除语言("zh").is_err());

        // 6. 删除成功
        删除语言("日语").unwrap();
        让 列表3 = 列语言();
        断言!(列表3.iter().all(|项| 项.语言代码 != "日语"));

        // 7. 删除不存在报错
        断言!(删除语言("不存在").is_err());

        不安全 {
            std::env::remove_var("RZ_LANG_DIR");
        }
    }

