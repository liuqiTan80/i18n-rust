//! 后端源码语料覆盖矩阵（`rzc mapping coverage`）
//!
//! 将仓库内后端真实 Rust 源码（engine / cli / lsp 的 src/*.rs）作为真实语料，
//! 对每个语言包检验「用户写代码时会遇到的名字」的覆盖度，自动列出缺失的母语映射：
//! - 关键字（fn/let/...）：缺失时用户无法用母语写出该语法结构（error 级）
//! - API 名（std/core/alloc 路径段、use 导入、首字母大写类型名）：缺失时只能
//!   写英文原名，全母语体验打折（warning 级）
//!
//! 用法：在仓库根目录运行 `rzc mapping coverage [--lang <代码>]`（默认全部内置语言）。
//! 语料来自仓库内 crates/{engine,cli,lsp}/src/*.rs；发布版（无源码）环境下不可用，
//! 此命令面向语言包维护者与 CI 门禁。

使用 std::collections::哈希映射;
使用 std::path::Path;

/// 一个名字的出现统计（出现次数 + 示例文件）
类型 名字统计 = (usize, 字符串);

/// 语料提取结果：四类名字 → (出现次数, 示例文件)
#[派生(默认)]
结构体 语料 {
    /// 关键字（fn/let/...）
    关键字表: 哈希映射<字符串, 名字统计>,
    /// std/core/alloc 路径段（模块名与类型名）
    标准库段表: 哈希映射<字符串, 名字统计>,
    /// use 导入的第三方 crate 名
    外部库表: 哈希映射<字符串, 名字统计>,
    /// 首字母大写标识符（类型名，路径链之外）
    类型名表: 哈希映射<字符串, 名字统计>,
}

/// Rust 稳定关键字全集（方言母语映射应覆盖；rustc_lexer 不区分关键字，需自行匹配）
常量 关键字全集: &[&文本] = &[
    "as", "break", "const", "continue", "crate", "dyn", "else", "enum", "extern", "false", "fn",
    "for", "if", "impl", "in", "let", "loop", "match", "mod", "move", "mut", "pub", "ref",
    "return", "self", "Self", "static", "struct", "super", "trait", "true", "type", "unsafe",
    "use", "where", "while", "async", "await", "union",
];

实现 语料 {
    函数 记录(表: &可变 哈希映射<字符串, 名字统计>, 名字: &文本, 文件: &文本) {
        表.entry(名字.to_string())
            .and_modify(|(计数, _)| *计数 += 1)
            .or_insert((1, 文件.to_string()));
    }
}

/// 收集仓库内后端源码（engine/cli/lsp 的 src/*.rs），返回 (相对路径, 内容)
函数 收集后端源码(根: &Path) -> Vec<(字符串, 字符串)> {
    让 可变 文件表 = Vec::新建();
    对于 目录名 in ["engine", "cli", "lsp"] {
        让 源目录 = 根.join("crates").join(目录名).join("src");
        让 成功(项序列) = std::fs::read_dir(&源目录) 否则 {
            继续;
        };
        对于 项 in 项序列.flatten() {
            让 路径值 = 项.path();
            如果 路径值.extension().and_then(|扩展| 扩展.to_str()) != 有值("rs") {
                继续;
            }
            如果 让 成功(内容) = std::fs::read_to_string(&路径值) {
                文件表.push((
                    格式化!(
                        "crates/{目录名}/src/{}",
                        路径值.file_name().unwrap_or_default().to_string_lossy()
                    ),
                    内容,
                ));
            }
        }
    }
    文件表.sort();
    文件表
}

/// 下一个非空白 token 的种类（rustc_lexer 将 `::` 拆为两个 Colon，中间允许空白）
函数 下个非空白种类(
    令牌: &[rustc_lexer::Token],
    从: usize,
) -> 选项<rustc_lexer::TokenKind> {
    令牌[从..]
        .iter()
        .映射(|词元项| 词元项.kind)
        .查找(|词元类别| !matches!(词元类别, rustc_lexer::TokenKind::Whitespace))
}

/// 前一个非空白 token 的种类（从 为当前 token 索引）
函数 上个非空白种类(
    令牌: &[rustc_lexer::Token],
    从: usize,
) -> 选项<rustc_lexer::TokenKind> {
    令牌[..从]
        .iter()
        .逆序()
        .映射(|词元项| 词元项.kind)
        .查找(|词元类别| !matches!(词元类别, rustc_lexer::TokenKind::Whitespace))
}

/// 从单个源文件提取语料名字（单遍 rustc_lexer 扫描，无语法树依赖）
///
/// 状态机：
/// - `处于导入`：use 语句内（到 `;` 结束）
/// - `路径链` / `路径态`：当前 `::` 路径链（含暂存的首段）；
///   标识符先暂存进链，遇到 `::` 才确认是路径（否则按普通标识符处理）
/// - use 内的 `as X` 别名跳过；`crate::`/`super::`/`self::` 内部路径忽略
函数 从源提取名字(文件: &文本, 源: &文本, 语料: &可变 语料) {
    让 令牌流: Vec<rustc_lexer::Token> = rustc_lexer::tokenize(源).收集();
    // 逐 token 的字节偏移（rustc_lexer 词法流覆盖全源，偏移连续）
    让 可变 偏移表: Vec<usize> = Vec::with_capacity(令牌流.len());
    让 可变 累计 = 0usize;
    对于 令牌项 in &令牌流 {
        偏移表.push(累计);
        累计 += 令牌项.len;
    }

    让 可变 处于导入 = 假;
    让 可变 路径链: Vec<字符串> = Vec::新建();
    让 可变 路径态 = 假;
    让 可变 跳过下个导入名 = 假;

    对于 (索引, 令牌) in 令牌流.iter().enumerate() {
        让 字串 = &源[偏移表[索引]..偏移表[索引] + 令牌.len];
        匹配 令牌.kind {
            rustc_lexer::TokenKind::Ident => {
                如果 关键字全集.contains(&字串) {
                    匹配 字串 {
                        "use" 如果 !处于导入 => {
                            处于导入 = 真;
                            路径链.clear();
                            路径态 = 假;
                        }
                        "as" 如果 处于导入 => {
                            跳过下个导入名 = 真;
                        }
                        // 内部路径首段（crate::/super::/self::）：入链整体忽略，
                        // 避免 crate 被 flush 后其后的内部模块名（本地化/内置语言 等）
                        // 误入 外部库表；单独出现的 self 仍按普通关键字处理
                        "crate" | "super" | "self" | "Self"
                            如果 matches!(
                                下个非空白种类(&令牌流, 索引 + 1),
                                有值(rustc_lexer::TokenKind::Colon)
                            ) =>
                        {
                            路径链.push(字串.to_string());
                            路径态 = 假;
                        }
                        // 普通关键字：结束当前链
                        _ => {
                            如果 !处于导入 && !matches!(字串, "crate" | "super" | "self" | "Self") {
                                语料::记录(&可变 语料.关键字表, 字串, 文件);
                            }
                            冲刷路径(&可变 路径链, 路径态, 处于导入, 语料, 文件);
                            处于导入 = 假;
                            路径态 = 假;
                        }
                    }
                } 否则 如果 跳过下个导入名 {
                    跳过下个导入名 = 假;
                    路径链.clear();
                    路径态 = 假;
                } 否则 如果 处于导入 || 路径态 {
                    路径链.push(字串.to_string());
                } 否则 {
                    // 暂存：等下一个 token 决定是路径链还是普通标识符
                    路径链.push(字串.to_string());
                    路径态 = 假;
                }
            }
            rustc_lexer::TokenKind::Colon => {
                // rustc_lexer 将 `::` 拆为两个 Colon（中间允许空白）：
                // 第一半前瞻下一个非空白仍是 Colon；第二半（前一个非空白
                // 是 Colon）保持路径链，仅单冒号（类型标注等）结束当前链
                让 前一冒号 = matches!(
                    上个非空白种类(&令牌流, 索引),
                    有值(rustc_lexer::TokenKind::Colon)
                );
                让 后一冒号 = matches!(
                    下个非空白种类(&令牌流, 索引 + 1),
                    有值(rustc_lexer::TokenKind::Colon)
                );
                如果 前一冒号 {
                    // `::` 第二半：路径链继续（路径态 已由第一半设置）
                } 否则 如果 后一冒号 {
                    路径态 = 真;
                } 否则 {
                    // 单个冒号（类型标注等）：结束当前链
                    冲刷路径(&可变 路径链, 路径态, 处于导入, 语料, 文件);
                    路径态 = 假;
                }
            }
            rustc_lexer::TokenKind::Semi => {
                冲刷路径(&可变 路径链, 路径态, 处于导入, 语料, 文件);
                处于导入 = 假;
                路径态 = 假;
            }
            _ => {
                // 其他 token：结束当前链；若链中只有一个暂存标识符，按普通标识符处理
                冲刷路径(&可变 路径链, 路径态, 处于导入, 语料, 文件);
                路径态 = 假;
            }
        }
    }
    冲刷路径(&可变 路径链, 路径态, 处于导入, 语料, 文件);
}

/// 结束当前路径链：按 use/非 use 与首段归属分类记录到语料
函数 冲刷路径(
    路径链: &可变 Vec<字符串>,
    路径态: 布尔,
    处于导入: 布尔,
    语料: &可变 语料,
    文件: &文本,
) {
    如果 路径链.is_empty() {
        返回;
    }
    // 非路径链的单个暂存标识符：首字母大写且非单字符 → 类型名
    如果 !路径态 && !处于导入 {
        让 名字 = &路径链[0];
        让 首字符 = 名字.chars().next().unwrap_or('a');
        如果 首字符.is_uppercase() && 名字.len() > 1 {
            语料::记录(&可变 语料.类型名表, 名字, 文件);
        }
        路径链.clear();
        返回;
    }
    让 首段 = &路径链[0];
    让 是内部 = matches!(首段.as_str(), "crate" | "super" | "self");
    让 是标准库 = matches!(首段.as_str(), "std" | "core" | "alloc");
    如果 !是内部 {
        如果 是标准库 || 处于导入 {
            // std 路径引用 / use 导入：段全部记录（模块名与类型名）
            对于 段 in 路径链.iter() {
                如果 是标准库 {
                    语料::记录(&可变 语料.标准库段表, 段, 文件);
                }
            }
        }
        // 首段（crate 名）：use 导入或路径引用的第三方 crate；
        // 惯例上 crate 名小写、类型名大写（如 MyServer::new() 的 MyServer）
        如果 !是标准库 {
            让 首字符 = 首段.chars().next().unwrap_or('a');
            如果 首字符.is_uppercase() {
                语料::记录(&可变 语料.类型名表, 首段, 文件);
            } 否则 {
                语料::记录(&可变 语料.外部库表, 首段, 文件);
            }
        }
        // use 内的非首段：大写段是类型名（如 use serde::Serialize 的 Serialize）
        如果 处于导入 && !是标准库 {
            对于 段 in 路径链.iter().skip(1) {
                让 首字符项 = 段.chars().next().unwrap_or('a');
                如果 首字符项.is_uppercase() && 段.len() > 1 {
                    语料::记录(&可变 语料.类型名表, 段, 文件);
                }
            }
        }
        // 非 use 的第三方路径引用（如 ureq::get）：后续段按类型名/忽略
        如果 !处于导入 && !是标准库 {
            对于 段 in 路径链.iter().skip(1) {
                让 首字符项 = 段.chars().next().unwrap_or('a');
                如果 首字符项.is_uppercase() && 段.len() > 1 {
                    语料::记录(&可变 语料.类型名表, 段, 文件);
                }
            }
        }
    }
    路径链.clear();
}

/// 构建语言包反向索引：英文原名 → 母语键
///
/// 合并 keywords.toml（排除派生特征节，与运行时语义一致）、module_paths.toml、
/// stdlib.toml、crates/*.toml 的全部映射值；同值多键时保留首个（报告无需区分）。
函数 构建反向索引(
    关键字文本: &文本,
    模块路径文本: &文本,
    标准库文本: &文本,
    三方库数据: &[(&文本, &文本)],
) -> 哈希映射<字符串, 字符串> {
    让 可变 反向索引: 哈希映射<字符串, 字符串> = 哈希映射::新建();
    让 反向插入 = |反向: &可变 哈希映射<字符串, 字符串>, 英文名: &文本, 母语键: &文本| {
        如果 !英文名.is_empty() {
            反向
                .entry(英文名.to_string())
                .or_insert_with(|| 母语键.to_string());
        }
    };
    如果 让 成功(节表) = i18n_rust_engine::映射源::解析配置节(关键字文本) {
        对于 (节名, 映射表) in &节表 {
            如果 节名 == "派生特征" {
                继续;
            }
            对于 (母语键, 英文名) in 映射表 {
                反向插入(&可变 反向索引, 英文名, 母语键);
            }
        }
    }
    对于 文本内容 in [模块路径文本, 标准库文本] {
        如果 让 成功(节表) = i18n_rust_engine::映射源::解析配置节(文本内容) {
            对于 映射表 in 节表.values() {
                对于 (母语键, 英文名) in 映射表 {
                    反向插入(&可变 反向索引, 英文名, 母语键);
                }
            }
        }
    }
    对于 (_, 内容) in 三方库数据 {
        如果 让 成功(节表) = i18n_rust_engine::映射源::解析配置节(内容) {
            对于 映射表 in 节表.values() {
                对于 (母语键, 英文名) in 映射表 {
                    反向插入(&可变 反向索引, 英文名, 母语键);
                }
            }
        }
    }
    反向索引
}

/// 单个语言包的覆盖报告
公开 结构体 覆盖报告 {
    /// 语言代码
    公开 语言代码: 字符串,
    /// 缺失关键字（error 级）：(名字, 出现次数, 示例文件)
    公开 缺失关键字: Vec<(字符串, usize, 字符串)>,
    /// 缺失 std/core/alloc 段（warning 级，用户写代码最常遇到）
    公开 缺失标准库: Vec<(字符串, usize, 字符串)>,
    /// 缺失第三方 crate 名（warning 级，用外部库时需要）
    公开 缺失外部库: Vec<(字符串, usize, 字符串)>,
    /// 缺失类型名（warning 级，多为编译器内部实现，可按需忽略）
    公开 缺失类型: Vec<(字符串, usize, 字符串)>,
    /// 覆盖统计
    公开 名字总数: usize,
    公开 覆盖数: usize,
}

/// 按出现次数降序排序缺失清单（同次数按名字升序，稳定输出）
函数 排序缺失(清单: &可变 [(字符串, usize, 字符串)]) {
    清单.sort_by(|甲, 乙| 乙.1.cmp(&甲.1).then(甲.0.cmp(&乙.0)));
}

/// 用反向索引检测语料覆盖，产出报告
函数 计算覆盖(语料: &语料, 反向索引: &哈希映射<字符串, 字符串>, 语言代码: &文本) -> 覆盖报告 {
    让 可变 报告 = 覆盖报告 {
        语言代码: 语言代码.to_string(),
        缺失关键字: Vec::新建(),
        缺失标准库: Vec::新建(),
        缺失外部库: Vec::新建(),
        缺失类型: Vec::新建(),
        名字总数: 0,
        覆盖数: 0,
    };
    // 关键字缺失（error 级）
    对于 (名字, (次数, 文件)) in &语料.关键字表 {
        报告.名字总数 += 1;
        如果 !反向索引.contains_key(名字) {
            报告
                .缺失关键字
                .push((名字.clone(), *次数, 文件.clone()));
        } 否则 {
            报告.覆盖数 += 1;
        }
    }
    // API 缺失（warning 级）：std 段 / 外部 crate / 类型名分三组
    对于 (名字, (次数, 文件)) in &语料.标准库段表 {
        报告.名字总数 += 1;
        如果 !反向索引.contains_key(名字) {
            报告
                .缺失标准库
                .push((名字.clone(), *次数, 文件.clone()));
        } 否则 {
            报告.覆盖数 += 1;
        }
    }
    对于 (名字, (次数, 文件)) in &语料.外部库表 {
        报告.名字总数 += 1;
        如果 !反向索引.contains_key(名字) {
            报告
                .缺失外部库
                .push((名字.clone(), *次数, 文件.clone()));
        } 否则 {
            报告.覆盖数 += 1;
        }
    }
    对于 (名字, (次数, 文件)) in &语料.类型名表 {
        报告.名字总数 += 1;
        如果 !反向索引.contains_key(名字) {
            报告
                .缺失类型
                .push((名字.clone(), *次数, 文件.clone()));
        } 否则 {
            报告.覆盖数 += 1;
        }
    }
    排序缺失(&可变 报告.缺失关键字);
    排序缺失(&可变 报告.缺失标准库);
    排序缺失(&可变 报告.缺失外部库);
    排序缺失(&可变 报告.缺失类型);
    报告
}

/// 打印单个语言包的覆盖报告（本地化输出）
函数 打印报告(报告: &覆盖报告, 源文件数: usize) {
    让 界面 = crate::本地化::界面::全局();
    println!("{}", 界面.取文带参("mc_cov_header", &[&报告.语言代码]));
    让 百分比 = 报告
        .覆盖数
        .checked_mul(100)
        .and_then(|比值项| 比值项.checked_div(报告.名字总数))
        .unwrap_or(0);
    println!(
        "{}",
        界面.取文带参(
            "mc_cov_stats",
            &[
                &报告.覆盖数.to_string(),
                &报告.名字总数.to_string(),
                &百分比.to_string(),
                &源文件数.to_string()
            ]
        )
    );
    // 关键字缺失（error 级，最多展示 30 条）
    让 关键字总数 = 报告.缺失关键字.len();
    对于 (名字, 次数, 文件) in 报告.缺失关键字.iter().take(30) {
        println!(
            "{}",
            界面.取文带参("mc_cov_kw_missing", &[名字, &次数.to_string(), 文件])
        );
    }
    如果 关键字总数 > 30 {
        println!("{}", 界面.取文带参("mc_cov_more", &[&(关键字总数 - 30).to_string()]));
    }
    // std 段缺失（warning 级，最多展示 25 条）：用户写代码最常遇到，优先补齐
    让 标准库总数 = 报告.缺失标准库.len();
    对于 (名字, 次数, 文件) in 报告.缺失标准库.iter().take(25) {
        println!(
            "{}",
            界面.取文带参("mc_cov_std_missing", &[名字, &次数.to_string(), 文件])
        );
    }
    如果 标准库总数 > 25 {
        println!("{}", 界面.取文带参("mc_cov_more", &[&(标准库总数 - 25).to_string()]));
    }
    // 第三方 crate 缺失（warning 级，最多展示 15 条）
    让 库总数 = 报告.缺失外部库.len();
    对于 (名字, 次数, 文件) in 报告.缺失外部库.iter().take(15) {
        println!(
            "{}",
            界面.取文带参("mc_cov_crate_missing", &[名字, &次数.to_string(), 文件])
        );
    }
    如果 库总数 > 15 {
        println!(
            "{}",
            界面.取文带参("mc_cov_more", &[&(库总数 - 15).to_string()])
        );
    }
    // 类型名缺失（warning 级，最多展示 15 条；多为编译器内部实现，可按需忽略）
    让 类型总数 = 报告.缺失类型.len();
    对于 (名字, 次数, 文件) in 报告.缺失类型.iter().take(15) {
        println!(
            "{}",
            界面.取文带参("mc_cov_type_missing", &[名字, &次数.to_string(), 文件])
        );
    }
    如果 类型总数 > 15 {
        println!("{}", 界面.取文带参("mc_cov_more", &[&(类型总数 - 15).to_string()]));
    }
    如果 关键字总数 == 0 {
        println!("{}", 界面.取文("mc_cov_kw_ok"));
    }
    println!();
}

/// `rzc mapping coverage` 入口
///
/// - 语言代码 为 无：检测全部内置语言
/// - 语言代码 为内置语言代码：仅检测该语言
///
/// 返回是否全部语言关键字覆盖（error 级）通过。
公开 函数 运行覆盖(语言代码: 选项<&文本>) -> anyhow::结果<布尔> {
    让 界面 = crate::本地化::界面::全局();
    // 语料必须来自源码仓库（发布版无 crates/{engine,cli,lsp}/src 结构）
    让 当前目录 = std::env::current_dir().map_err(|首错| anyhow::anyhow!("获取当前目录失败: {首错}"))?;
    让 根 = crate::向上定位项目根(&当前目录)
        .ok_or_else(|| anyhow::anyhow!("{}", 界面.取文("mc_cov_no_repo")))?;
    让 源文件表 = 收集后端源码(&根);
    如果 源文件表.is_empty() {
        anyhow::bail!("{}", 界面.取文("mc_cov_no_repo"));
    }
    // 提取语料（一次，供所有语言包复用）
    让 可变 语料 = 语料::default();
    对于 (文件, 内容) in &源文件表 {
        从源提取名字(文件, 内容, &可变 语料);
    }
    println!("{}", 界面.取文("mc_cov_corpus_intro"));
    让 语言列表: Vec<&文本> = 匹配 语言代码 {
        有值(单码) => vec![单码],
        无 => crate::内置语言::内置语言代码(),
    };
    让 可变 全部通过 = 真;
    对于 语言 in 语言列表 {
        如果 !crate::内置语言::拥有内置语言(语言) {
            anyhow::bail!(界面.取文带参("mc_unknown_target", &[语言]));
        }
        让 数据 = crate::内置语言::获取内置数据(语言);
        让 反向索引 = 构建反向索引(
            数据.关键字文本,
            数据.模块路径文本,
            数据.标准库文本,
            数据.三方库数据,
        );
        让 报告 = 计算覆盖(&语料, &反向索引, 语言);
        全部通过 &= 报告.缺失关键字.is_empty();
        打印报告(&报告, 源文件表.len());
    }
    如果 全部通过 {
        println!("{}", 界面.取文("mc_cov_all_ok"));
    }
    成功(全部通过)
}

#[配置(测试)]
模块 单元测试 {
    使用 超级::*;

    /// 单文件语料提取：关键字 / std 路径段 / 第三方 crate / 类型名
    #[测试]
    函数 测试提取名字基础() {
        让 源 = r#"
use std::collections::HashMap;
use serde::Serialize;
use crate::toolchain::find_toolchain;

pub fn main() -> Result<(), Box<dyn Error>> {
    let map: HashMap<String, Vec<u8>> = HashMap::new();
    std::fs::read_to_string("x")?;
    ureq::get("https://x").call()?;
    let server = MyServer::new();
    Ok(())
}
"#;
        让 可变 语料 = 语料::default();
        从源提取名字("t.rs", 源, &可变 语料);
        // 关键字
        对于 关键字 in ["fn", "let", "pub", "dyn"] {
            断言!(语料.关键字表.contains_key(关键字), "缺少关键字 {关键字}");
        }
        断言!(
            !语料.关键字表.contains_key("use"),
            "use 不应作为关键字语料"
        );
        // std 路径段
        对于 段 in ["std", "collections", "HashMap", "fs", "read_to_string"] {
            断言!(语料.标准库段表.contains_key(段), "缺少 std 段 {段}");
        }
        // 第三方 crate 名
        对于 包名项 in ["serde", "ureq"] {
            断言!(语料.外部库表.contains_key(包名项), "缺少 crate {包名项}");
        }
        // 内部路径忽略：i18n_rust_engine 是 crate 名（外部），crate:: 内部忽略
        断言!(
            !语料.外部库表.contains_key("crate"),
            "crate:: 不应计入"
        );
        // 类型名：use 段中的大写 + 普通大写标识符
        断言!(语料.类型名表.contains_key("Serialize"));
        断言!(语料.类型名表.contains_key("MyServer"));
        断言!(
            语料.类型名表.contains_key("Error"),
            "Box<dyn Error> 的 Error"
        );
        断言!(
            !语料.外部库表.contains_key("HashMap"),
            "裸 HashMap::new() 是类型引用而非 crate"
        );
        断言!(
            语料.标准库段表.contains_key("HashMap"),
            "use 路径链中的 HashMap 计入 std 段"
        );
        // 非 use 的内部路径调用（crate::本地化::界面）整体忽略，内部模块名不入 外部库表
        让 源2 = "fn f() { crate::本地化::界面::全局(); super::helper::run(); self::x::y(); }\n";
        让 可变 语料2 = 语料::default();
        从源提取名字("t2.rs", 源2, &可变 语料2);
        对于 名字项 in ["ui", "Ui", "helper", "run", "x", "y"] {
            断言!(
                !语料2.外部库表.contains_key(名字项) && !语料2.类型名表.contains_key(名字项),
                "内部路径段 {名字项} 不应计入"
            );
        }
    }

    /// use as 别名与泛型单字符不进入语料
    #[测试]
    函数 测试提取名字别名与泛型() {
        让 源 = "use std::fmt::Result as FmtResult;\nfn foo<T>(x: T) -> Result<T> { Ok(x) }\n";
        让 可变 语料 = 语料::default();
        从源提取名字("t.rs", 源, &可变 语料);
        断言!(
            !语料.类型名表.contains_key("FmtResult"),
            "as 别名应跳过"
        );
        断言!(
            !语料.类型名表.contains_key("T"),
            "单字符泛型参数不应计入"
        );
        断言!(语料.标准库段表.contains_key("fmt"));
        断言!(语料.关键字表.contains_key("fn"));
        断言!(
            语料.类型名表.contains_key("Result"),
            "返回类型中的真实类型引用应记录"
        );
    }

    /// 反向索引：合并 keywords/stdlib/module_paths/crates 的值
    #[测试]
    函数 测试构建反向索引() {
        让 关键字 = "[\"声明\"]\n\"函数\" = \"fn\"\n\"让\" = \"let\"\n[\"派生特征\"]\n\"调试\" = \"Debug\"\n";
        让 模块路径 = "[\"模块路径\"]\n\"标准库\" = \"std\"\n";
        让 标准库 = "[\"标识符\"]\n\"字符串\" = \"String\"\n";
        让 三方库 = [(
            "serde.toml",
            "[\"模块路径\"]\n\"序列化\" = \"serde\"\n[\"标识符\"]\n\"序列化特征\" = \"Serialize\"\n",
        )];
        让 反转 = 构建反向索引(关键字, 模块路径, 标准库, &三方库);
        断言相等!(反转.get("fn").映射(字符串::as_str), 有值("函数"));
        断言相等!(反转.get("let").映射(字符串::as_str), 有值("让"));
        断言相等!(反转.get("std").映射(字符串::as_str), 有值("标准库"));
        断言相等!(反转.get("String").映射(字符串::as_str), 有值("字符串"));
        断言相等!(反转.get("serde").映射(字符串::as_str), 有值("序列化"));
        断言相等!(反转.get("Serialize").映射(字符串::as_str), 有值("序列化特征"));
        断言!(!反转.contains_key("Debug"), "派生特征节不应并入关键字索引");
    }

    /// 覆盖检测：关键字缺失入 error 列表，API 缺失入 warning 列表
    #[测试]
    函数 测试计算覆盖() {
        让 关键字 = "[\"声明\"]\n\"函数\" = \"fn\"\n";
        让 模块路径 = "[\"模块路径\"]\n\"标准库\" = \"std\"\n";
        让 反转 = 构建反向索引(关键字, 模块路径, "", &[]);
        让 可变 语料 = 语料::default();
        语料.关键字表.insert("fn".into(), (3, "a.rs".into()));
        语料.关键字表.insert("unsafe".into(), (1, "b.rs".into()));
        语料.标准库段表.insert("std".into(), (9, "a.rs".into()));
        语料
            .类型名表
            .insert("NotCovered".into(), (2, "b.rs".into()));
        让 报告 = 计算覆盖(&语料, &反转, "zh");
        断言!(报告.缺失关键字.iter().any(|(名字项, ..)| 名字项 == "unsafe"));
        断言!(!报告.缺失关键字.iter().any(|(名字项, ..)| 名字项 == "fn"));
        断言!(报告.缺失类型.iter().any(|(名字项, ..)| 名字项 == "NotCovered"));
        断言!(!报告.缺失标准库.iter().any(|(名字项, ..)| 名字项 == "std"));
        断言相等!(报告.名字总数, 4);
        断言相等!(报告.覆盖数, 2);
    }

    /// 关键字门禁：全部内置语言包必须覆盖 Rust 稳定关键字全集（error 级）——
    /// 任一门语言缺任一关键字（用户无法用母语写出该语法结构）都会在此失败
    #[测试]
    函数 测试全部内置语言关键字完备() {
        让 可变 失败表: Vec<字符串> = Vec::新建();
        对于 语言 in crate::内置语言::内置语言代码() {
            让 数据 = crate::内置语言::获取内置数据(语言);
            让 反转 = 构建反向索引(数据.关键字文本, "", "", &[]);
            让 缺失: Vec<&文本> = 关键字全集
                .iter()
                .copied()
                .filter(|键名项| !反转.contains_key(*键名项))
                .收集();
            如果 !缺失.is_empty() {
                失败表.push(格式化!("{语言} 缺 {缺失:?}", ));
            }
        }
        断言!(失败表.is_empty(), "关键字门禁失败: {失败表:?}");
    }

    /// 全内置语言跑一遍覆盖检测（不 panic、有统计）
    #[测试]
    函数 测试运行覆盖全语言不崩溃() {
        对于 语言 in crate::内置语言::内置语言代码() {
            让 数据 = crate::内置语言::获取内置数据(语言);
            让 反转 = 构建反向索引(
                数据.关键字文本,
                数据.模块路径文本,
                数据.标准库文本,
                数据.三方库数据,
            );
            // 用最小语料冒烟：语料为空时统计为 0 即可
            让 语料 = 语料::default();
            让 报告 = 计算覆盖(&语料, &反转, 语言);
            断言相等!(报告.名字总数, 0, "{语言} 空语料统计应为 0");
            断言!(报告.缺失关键字.is_empty());
        }
    }
}
