#[配置(测试)]
模块 母语测试 {
    使用 超级::{示例文档, *};

    #[测试]
    函数 提取公开接口正确() {
        让 条目表 = 提取公开接口(&示例文档()).期望("应能解析");
        // 顶层七类 + 递归子模块中的公开项
        让 名称清单: 向量<(&文本, 接口种类)> = 条目表
            .迭代器()
            .映射(|条目| (条目.英文名.作为文本切片(), 条目.种类))
            .收集();
        断言!(名称清单.包含(&("new", 接口种类::函数项)));
        断言!(名称清单.包含(&("Foo", 接口种类::结构体项)));
        断言!(名称清单.包含(&("State", 接口种类::枚举项)));
        断言!(名称清单.包含(&("Behavior", 接口种类::特征项)));
        断言!(名称清单.包含(&("Count", 接口种类::类型别名项)));
        断言!(名称清单.包含(&("MAX", 接口种类::常量项)));
        断言!(名称清单.包含(&("print", 接口种类::宏项)));
        // 重导出：名称在内部值里，按类型别名（类型名 = 来源路径）提取
        断言!(名称清单.包含(&("Deserialize", 接口种类::类型别名项)));
        让 反序列化条目 = 条目表
            .迭代器()
            .查找(|条目| 条目.英文名 == "Deserialize")
            .解包();
        断言相等!(
            反序列化条目.签名,
            "type Deserialize = serde_core::Deserialize"
        );
        // 模块重导出递归跟随（公开 使用 包::子模块）
        断言!(名称清单.包含(&("子函数", 接口种类::函数项)));
        // 整批导入（公开 使用 内核::*）跳过、私有模块项跳过
        断言!(!名称清单.包含(&("hidden_fn", 接口种类::函数项)));
        // 私有模块（可见性为包内）不提取；实现块里的方法不提取
        断言!(!名称清单.迭代器().任意(|(名字, _)| *名字 == "hidden_fn"));
        断言!(!名称清单.迭代器().任意(|(名字, _)| *名字 == "实例方法"));
    }

    #[测试]
    函数 签名渲染() {
        让 条目表 = 提取公开接口(&示例文档()).解包();
        让 新建条目 = 条目表.迭代器().查找(|条目| 条目.英文名 == "new").解包();
        // 异步函数 新建<T>(甲: 无符号整数) -> 结果<T, 字符串>
        断言相等!(
            新建条目.签名,
            "async fn new<T>(x: u32) -> Result<T, String>"
        );
        让 别名条目 = 条目表.迭代器().查找(|条目| 条目.英文名 == "Count").解包();
        断言相等!(别名条目.签名, "type Count = u32");
        让 常量条目 = 条目表.迭代器().查找(|条目| 条目.英文名 == "MAX").解包();
        断言相等!(常量条目.签名, "const MAX: u32");
    }
}
