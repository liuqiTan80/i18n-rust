//! rustdoc JSON 解析：提取公开接口（仅名称与签名，绝不读取文档字段）
//! 并渲染为可读的类型签名。

使用 JSON序列化::JSON值;
使用 标准库::集合::哈希集合;

使用 超级::{接口条目, 接口种类};

/// 解析 rustdoc JSON，提取所有公开接口（仅名称与签名，绝不读取文档字段）
使用 错误处理::错误处理;

公开 函数 提取公开接口(文档文本: &文本) -> 错误处理::结果<向量<接口条目>> {
    成功(提取公开接口带通配源(文档文本)?.0)
}

/// 同 [`提取公开接口`]，额外返回整批重导出（`公开 使用 依赖::*`）指向的
/// 依赖包名列表：薄壳包（转发包）的公开接口全部来自这些重导出，
/// 调用方需对这些依赖包单独生成 rustdoc JSON 并合并提取
公开 函数 提取公开接口带通配源(
    文档文本: &文本,
) -> 错误处理::结果<(向量<接口条目>, 向量<字符串>)> {
    让 界面表 = 包::界面::界面消息表::全局表();
    让 文档: JSON值 = JSON序列化::解析字符串(文档文本).映射错误(|错误值| {
        错误处理!("{}", 界面表.取带参消息("mg_err_parse_rustdoc", &[&错误值.转字符串()]))
    })?;
    让 索引 = 文档
        .获取("index")
        .过滤(|值| 值.是对象())
        .缺值转错(|| 错误处理!("{}", 界面表.取消息("mg_err_no_index")))?;
    让 根标识 = 文档
        .获取("root")
        .映射(|值| {
            值.作为字符串()
                .映射(字符串::从)
                .解包或用否则(|| 值.转字符串())
        })
        .解包或用否则(|| "0".转字符串());
    让 可变 结果表 = 向量::新建();
    让 可变 通配源表 = 向量::新建();
    让 可变 已访问 = 哈希集合::新建();
    收集模块条目(索引, &根标识, &可变 已访问, &可变 结果表, &可变 通配源表);
    成功((结果表, 通配源表))
}

/// 深度优先收集模块树中的公开项（跳过实现方法、私有项、结构体字段等）
///
/// 通配源表收集整批重导出指向的依赖包名，供薄壳包追踪。
函数 收集模块条目(
    索引: &JSON值,
    标识: &文本,
    已访问: &可变 哈希集合<字符串>,
    结果表: &可变 向量<接口条目>,
    通配源表: &可变 向量<字符串>,
) {
    如果 !已访问.置入(标识.转字符串()) {
        返回;
    }
    让 有值(条目值) = 索引.获取(标识) 否则 { 返回 };
    如果 条目值.获取("visibility").而后映射(JSON值::作为字符串) != 有值("public") {
        返回;
    }
    让 有值((类别键, 内部值)) = 条目值
        .获取("inner")
        .而后映射(JSON值::作为对象)
        .而后映射(|对象值| 对象值.迭代器().下一个())
    否则 {
        返回;
    };
    让 名称 = 条目值
        .获取("name")
        .而后映射(JSON值::作为字符串)
        .解包或用("")
        .转字符串();
    匹配 类别键.作为字符串() {
        "module" => {
            如果让 有值(子项表) = 内部值.获取("items").而后映射(JSON值::作为数组) {
                对于 子项 在 子项表 {
                    收集模块条目(
                        索引,
                        &子项.转字符串(),
                        已访问,
                        结果表,
                        通配源表,
                    );
                }
            }
        }
        "function" => {
            结果表.推入(接口条目 {
                种类: 接口种类::函数项,
                英文名: 名称.克隆值(),
                签名: 渲染函数签名(&名称, 条目值),
            });
        }
        "struct" => {
            让 泛型文本 = 渲染泛型(内部值.获取("generics").解包或用(&JSON值::空值节点));
            结果表.推入(接口条目 {
                种类: 接口种类::结构体项,
                英文名: 名称.克隆值(),
                签名: 格式化!("struct {}{}", 名称, 泛型文本),
            });
        }
        "enum" => {
            让 泛型文本 = 渲染泛型(内部值.获取("generics").解包或用(&JSON值::空值节点));
            结果表.推入(接口条目 {
                种类: 接口种类::枚举项,
                英文名: 名称.克隆值(),
                签名: 格式化!("enum {}{}", 名称, 泛型文本),
            });
        }
        "trait" => {
            让 泛型文本 = 渲染泛型(内部值.获取("generics").解包或用(&JSON值::空值节点));
            结果表.推入(接口条目 {
                种类: 接口种类::特征项,
                英文名: 名称.克隆值(),
                签名: 格式化!("trait {}{}", 名称, 泛型文本),
            });
        }
        "type_alias" => {
            让 类型文本 = 渲染类型(内部值.获取("type").解包或用(&JSON值::空值节点));
            结果表.推入(接口条目 {
                种类: 接口种类::类型别名项,
                英文名: 名称.克隆值(),
                签名: 格式化!("type {} = {}", 名称, 类型文本),
            });
        }
        "constant" => {
            让 类型文本 = 渲染类型(内部值.获取("type").解包或用(&JSON值::空值节点));
            结果表.推入(接口条目 {
                种类: 接口种类::常量项,
                英文名: 名称.克隆值(),
                签名: 格式化!("const {}: {}", 名称, 类型文本),
            });
        }
        // rustdoc JSON 当前工具链不输出声明式宏（官方格式限制），预留支持
        "macro" => {
            结果表.推入(接口条目 {
                种类: 接口种类::宏项,
                英文名: 名称.克隆值(),
                签名: 格式化!("{}!", 名称),
            });
        }
        // 重导出（公开 使用）：薄壳包的公开接口全部是重导出。
        // 名称在内部值的名称字段（顶层名称为空）。
        "use" => {
            让 使用对象 = 内部值; // 内部值即使用对象（单键解构结果）
            如果 使用对象
                .获取("is_glob")
                .而后映射(JSON值::转布尔)
                .取值或(假)
            {
                // 整批重导出（公开 使用 依赖::*）：外部包的项不在本 JSON 的
                // 索引里，无法枚举名称；记录来源路径的首段（被重导出的
                // 包名），由调用方对该依赖包单独生成文档后合并提取（薄壳包追踪）。
                // 以 包、自身、超级 开头的内部整批重导出无法枚举，跳过。
                如果让 有值(来源) = 使用对象.获取("source").而后映射(JSON值::作为字符串) {
                    让 来源 = 来源.裁剪左侧匹配("::");
                    让 依赖名 = 来源.分割("::").下一个().解包或用("");
                    如果 !依赖名.是否为空()
                        && 依赖名 != "crate"
                        && 依赖名 != "self"
                        && 依赖名 != "super"
                    {
                        通配源表.推入(依赖名.转字符串());
                    }
                }
                返回;
            }
            让 有值(英文名) = 使用对象.获取("name").而后映射(JSON值::作为字符串) 否则 {
                返回;
            };
            // 若指向本包内的模块（公开 使用 包::模块），递归跟随收集其公开项
            如果让 有值(目标标识) = 使用对象.获取("id").映射(|值| 值.转字符串())
                && 目标标识 != 标识
                && 索引.获取(目标标识.作为文本切片()).是否为有值()
                && 索引
                    .获取(目标标识.作为文本切片())
                    .而后映射(|节点值| 节点值.获取("inner"))
                    .而后映射(|内部项| 内部项.获取("module"))
                    .是否为有值()
            {
                收集模块条目(
                    索引,
                    目标标识.作为文本切片(),
                    已访问,
                    结果表,
                    通配源表,
                );
                返回;
            }
            让 来源 = 使用对象
                .获取("source")
                .而后映射(JSON值::作为字符串)
                .解包或用("?");
            结果表.推入(接口条目 {
                种类: 接口种类::类型别名项,
                英文名: 英文名.转字符串(),
                签名: 格式化!("type {} = {}", 英文名, 来源),
            });
        }
        // 实现块 / 导入 / 结构体字段 / 枚举变体 / 关联类型等跳过
        _ => {}
    }
}

/// 渲染函数签名：`async fn 名称<T>(甲: u32) -> Result<T>`
函数 渲染函数签名(名称: &文本, 条目值: &JSON值) -> 字符串 {
    让 函数值 = 条目值
        .获取("inner")
        .而后映射(|内部项| 内部项.获取("function"))
        .解包或用(&JSON值::空值节点);
    让 签名值 = 函数值.获取("sig").解包或用(&JSON值::空值节点);
    让 头部 = 函数值.获取("header").解包或用(&JSON值::空值节点);
    让 可变 签名文本 = 字符串::新建();
    如果 头部
        .获取("is_const")
        .而后映射(JSON值::转布尔)
        .取值或(假)
    {
        签名文本.推入字符串("const ");
    }
    如果 头部
        .获取("is_unsafe")
        .而后映射(JSON值::转布尔)
        .取值或(假)
    {
        签名文本.推入字符串("unsafe ");
    }
    如果 头部
        .获取("is_async")
        .而后映射(JSON值::转布尔)
        .取值或(假)
    {
        签名文本.推入字符串("async ");
    }
    签名文本.推入字符串("fn ");
    签名文本.推入字符串(名称);
    签名文本.推入字符串(&渲染泛型(函数值.获取("generics").解包或用(&JSON值::空值节点)));
    签名文本.推入字符串(&渲染入出参(
        签名值.获取("inputs").解包或用(&JSON值::空值节点),
        签名值.获取("output"),
    ));
    签名文本
}

/// 渲染参数列表与返回类型：`(甲: u32, 乙: String) -> Result<T>`
函数 渲染入出参(输入表: &JSON值, 输出值: 选项<&JSON值>) -> 字符串 {
    让 参数表: 向量<字符串> = 输入表
        .作为数组()
        .映射(|列表| {
            列表.迭代器()
                .映射(|元素| {
                    如果让 有值(成对项) = 元素.作为数组() {
                        让 名称 = 成对项.第一个().而后映射(JSON值::作为字符串).解包或用("_");
                        让 类型值 = 成对项.获取(1).解包或用(&JSON值::空值节点);
                        格式化!("{}: {}", 名称, 渲染类型(类型值))
                    } 否则 {
                        渲染类型(元素)
                    }
                })
                .收集()
        })
        .取值或默认();
    让 返回文本 = 输出值.映射(渲染类型).过滤(|文本值| 文本值 != "()");
    匹配 返回文本 {
        有值(返回项) => 格式化!("({}) -> {}", 参数表.连接(", "), 返回项),
        无 => 格式化!("({})", 参数表.连接(", ")),
    }
}

/// 渲染泛型参数：`<T, U>` 或空串
函数 渲染泛型(泛型值: &JSON值) -> 字符串 {
    让 参数表: 向量<字符串> = 泛型值
        .获取("params")
        .而后映射(JSON值::作为数组)
        .映射(|列表| {
            列表.迭代器()
                .映射(|单项| {
                    让 名称 = 单项.获取("name").而后映射(JSON值::作为字符串).解包或用("?");
                    如果 单项.获取("kind").而后映射(|类值| 类值.获取("lifetime")).是否为有值() {
                        如果 名称.以开头('\'') {
                            名称.转字符串()
                        } 否则 {
                            格式化!("'{}'", 名称)
                        }
                    } 否则 如果 单项
                        .获取("kind")
                        .而后映射(|类值| 类值.获取("const"))
                        .是否为有值()
                    {
                        格式化!("const {}", 名称)
                    } 否则 {
                        名称.转字符串()
                    }
                })
                .收集()
        })
        .取值或默认();
    如果 参数表.是否为空() {
        字符串::新建()
    } 否则 {
        格式化!("<{}>", 参数表.连接(", "))
    }
}

/// 递归渲染 rustdoc 类型节点为可读签名（不支持的类型显示 `?`）
函数 渲染类型(类型值: &JSON值) -> 字符串 {
    如果让 有值(原语名) = 类型值.获取("primitive").而后映射(JSON值::作为字符串) {
        返回 如果 原语名 == "unit" {
            "()".转字符串()
        } 否则 {
            原语名.转字符串()
        };
    }
    如果让 有值(泛型名) = 类型值.获取("generic").而后映射(JSON值::作为字符串) {
        返回 泛型名.转字符串();
    }
    如果让 有值(解引用路径) = 类型值.获取("resolved_path") {
        让 名称 = 解引用路径
            .获取("path")
            .而后映射(JSON值::作为字符串)
            .解包或用("?");
        如果让 有值(尖括号参数) = 解引用路径
            .获取("args")
            .而后映射(|参数值| 参数值.获取("angle_bracketed"))
        {
            让 参数表: 向量<字符串> = 尖括号参数
                .获取("args")
                .而后映射(JSON值::作为数组)
                .映射(|列表| {
                    列表.迭代器()
                        .映射(|元素| {
                            如果让 有值(类型节点) = 元素.获取("type") {
                                渲染类型(类型节点)
                            } 否则 如果让 有值(寿命节点) = 元素.获取("lifetime") {
                                格式化!("'{}'", 寿命节点.作为字符串().解包或用("?"))
                            } 否则 {
                                "?".转字符串()
                            }
                        })
                        .收集()
                })
                .取值或默认();
            返回 如果 参数表.是否为空() {
                名称.转字符串()
            } 否则 {
                格式化!("{}<{}>", 名称, 参数表.连接(", "))
            };
        }
        返回 名称.转字符串();
    }
    如果让 有值(借用引用) = 类型值.获取("borrowed_ref") {
        让 可变 签名文本 = 字符串::从("&");
        如果让 有值(寿命值) = 借用引用.获取("lifetime").而后映射(JSON值::作为字符串) {
            签名文本.推入('\'');
            签名文本.推入字符串(寿命值);
            签名文本.推入(' ');
        }
        如果 借用引用
            .获取("mutable")
            .而后映射(JSON值::转布尔)
            .取值或(假)
        {
            签名文本.推入字符串("mut ");
        }
        签名文本.推入字符串(&渲染类型(借用引用.获取("type").解包或用(&JSON值::空值节点)));
        返回 签名文本;
    }
    如果让 有值(元组值) = 类型值.获取("tuple") {
        让 元素表: 向量<字符串> = 元组值
            .作为数组()
            .映射(|列表| 列表.迭代器().映射(渲染类型).收集())
            .取值或默认();
        返回 格式化!("({})", 元素表.连接(", "));
    }
    如果让 有值(切片值) = 类型值.获取("slice") {
        返回 格式化!("[{}]", 渲染类型(切片值.获取("type").解包或用(&JSON值::空值节点)));
    }
    如果让 有值(数组值) = 类型值.获取("array") {
        让 长度文本 = 数组值
            .获取("len")
            .而后映射(|长度值| 长度值.获取("expr"))
            .而后映射(JSON值::作为字符串)
            .解包或用("?");
        返回 格式化!(
            "[{}; {}]",
            渲染类型(数组值.获取("type").解包或用(&JSON值::空值节点)),
            长度文本
        );
    }
    如果让 有值(实现特征) = 类型值.获取("impl_trait") {
        返回 格式化!("impl {}", 渲染边界(实现特征.获取("bounds")));
    }
    如果让 有值(动态特征) = 类型值.获取("dyn_trait") {
        返回 格式化!("dyn {}", 渲染边界(动态特征.获取("bounds")));
    }
    如果让 有值(限定路径) = 类型值.获取("qualified_path") {
        让 类型名 = 限定路径
            .获取("name")
            .而后映射(JSON值::作为字符串)
            .解包或用("?");
        返回 格式化!(
            "{}::{}",
            渲染类型(限定路径.获取("self_type").解包或用(&JSON值::空值节点)),
            类型名
        );
    }
    如果让 有值(函数指针) = 类型值.获取("function_pointer")
        && 让 有值(签名段) = 函数指针.获取("sig")
    {
        返回 格式化!("fn{}", 渲染入出参(&签名段["inputs"], 签名段.获取("output")));
    }
    如果让 有值(裸指针) = 类型值.获取("raw_pointer") {
        让 指针可变 = 裸指针
            .获取("mutable")
            .而后映射(JSON值::转布尔)
            .取值或(假);
        让 前缀符号 = 如果 指针可变 { "*mut " } 否则 { "*const " };
        返回 格式化!(
            "{}{}",
            前缀符号,
            渲染类型(裸指针.获取("type").解包或用(&JSON值::空值节点))
        );
    }
    "?".转字符串()
}

/// 渲染特征边界列表：`A + B`
函数 渲染边界(边界值: 选项<&JSON值>) -> 字符串 {
    边界值
        .而后映射(JSON值::作为数组)
        .映射(|列表| {
            列表.迭代器()
                .映射(|边界项| {
                    边界项
                        .获取("trait_bound")
                        .而后映射(|约束项| 约束项.获取("trait"))
                        .而后映射(|特征值| 特征值.获取("resolved_path"))
                        .而后映射(|路径值| 路径值.获取("path"))
                        .而后映射(JSON值::作为字符串)
                        .解包或用("?")
                        .转字符串()
                })
                .收集::<向量<_>>()
                .连接(" + ")
        })
        .解包或用否则(|| "?".转字符串())
}

/// 迷你 rustdoc JSON 样本（结构与真实输出一致：索引/根/内部节点等）。
/// 供本模块与映射输出、文档结构的测试共用。
#[配置(测试)]
公开(包) 函数 示例文档() -> 字符串 {
    r#"{
  "root": "100",
  "index": {
    "100": { "id": 100, "name": "sample", "visibility": "public", "inner": { "module": { "items": [101, 102, 103, 104, 105, 106, 107, 108, 111, 112, 115] } } },
