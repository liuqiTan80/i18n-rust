//! 映射 TOML 构建：与现有 crates/*.toml 格式一致，含免责声明与生成时间戳。

使用 标准库::集合::哈希映射;

使用 引擎库::映射源;

使用 超级::{接口条目, 免责声明文本};

/// 映射文本转义（含回车与其余控制字符，避免生成非法映射表）
函数 转义映射文本(文本值: &文本) -> 字符串 {
    让 已转义 = 文本值
        .替换('\\', "\\\\")
        .替换('"', "\\\"")
        .替换('\n', "\\n")
        .替换('\t', "\\t")
        .替换('\r', "\\r");
    已转义
        .逐字符()
        .映射(|本字| 如果 (本字 作为 无符号整数) < 32 {
            格式化!("\\u{:04X}", 本字 作为 无符号整数)
        } 否则 {
            本字.转字符串()
        })
        .收集()
}

/// 当前时间字符串（世界标准时，`年-月-日 时:分:秒`）
函数 当前时间戳() -> 字符串 {
    让 总秒数 = 标准库::时间模块::系统时间::现在()
        .自纪元(标准库::时间模块::UNIX纪元)
        .映射(|时长| 时长.总秒数())
        .取值或默认();
    让 天数 = (总秒数 / 86_400) 作为 长整数;
    让 日内秒数 = 总秒数 % 86_400;
    让 (年份, 月份, 日号) = 拆分日期(天数);
    格式化!(
        "{:04}-{:02}-{:02} {:02}:{:02}:{:02}",
        年份,
        月份,
        日号,
        日内秒数 / 3_600,
        (日内秒数 % 3_600) / 60,
        日内秒数 % 60
    )
}

/// 天数 → (年, 月, 日)（民用历反算，与引擎日志模块同一算法）
函数 拆分日期(天数: 长整数) -> (长整数, 无符号整数, 无符号整数) {
    让 移位日 = 天数 + 719_468;
    让 纪元 = 移位日.欧几里得除(146_097);
    让 纪元内日 = 移位日 - 纪元 * 146_097;
    让 纪元内年 =
        (纪元内日 - 纪元内日 / 1_460 + 纪元内日 / 36_524 - 纪元内日 / 146_096) / 365;
    让 年份 = 纪元内年 + 纪元 * 400;
    让 年内日 = 纪元内日 - (365 * 纪元内年 + 纪元内年 / 4 - 纪元内年 / 100);
    让 年内月 = (5 * 年内日 + 2) / 153;
    让 日号 = (年内日 - (153 * 年内月 + 2) / 5 + 1) 作为 无符号整数;
    让 月份 = (年内月 + 如果 年内月 < 10 { 3 } 否则 { -9 }) 作为 无符号整数;
    让 年份 = 如果 月份 <= 2 { 年份 + 1 } 否则 { 年份 };
    (年份, 月份, 日号)
}

/// 构建语言包映射表（与现有 crates/*.toml 格式一致：
/// `模块路径` 与 `标识符` 两节为映射管理器识别的字符串值格式，
/// `解释` 节为扩展，映射管理器加载时自动忽略，保持兼容）。
/// 目标版本为提取时实际解析到的基准版本（写入文件头，供复现与比对）。
公开 函数 构建映射表(
    语言代码: &文本,
    包名: &文本,
    包中文名: &文本,
    目标版本: 选项<&文本>,
    条目表: &[接口条目],
    中文名表: &[(字符串, 字符串)],
    解释表: &哈希映射<字符串, 字符串>,
) -> 字符串 {
    让 界面表 = 包::界面::界面消息表::按语言建表(语言代码);
    让 可变 输出 = 字符串::新建();
    输出.推入字符串(&格式化!("{}\n", 界面表.取消息("mg_header_title")));
    输出.推入字符串(&格式化!(
        "{}\n",
        界面表.取带参消息("mg_header_crate", &[包名])
    ));
    // 生成基准版本（目标版本参数锁定依据；解析不到版本时省略整行）
    如果让 有值(版本文) = 目标版本 {
        输出.推入字符串(&格式化!(
            "{}\n",
            界面表.取带参消息("mg_header_target_version", &[版本文])
        ));
    }
    输出.推入字符串(&格式化!(
        "{}\n",
        界面表.取带参消息("mg_header_generated_at", &[&当前时间戳()])
    ));
    输出.推入字符串(&格式化!("# {}\n\n", 免责声明文本(语言代码)));

    输出.推入字符串("[\"模块路径\"]\n");
    输出.推入字符串(&格式化!(
        "\"{}\" = \"{}\"\n\n",
        转义映射文本(包中文名),
        转义映射文本(包名)
    ));

    输出.推入字符串("[\"标识符\"]\n");
    // 预构建英文名→签名索引，避免二次方线性查找
    让 签名索引: 哈希映射<&文本, &文本> = 条目表
        .迭代器()
        .映射(|条目| (条目.英文名.作为文本切片(), 条目.签名.作为文本切片()))
        .收集();
    对于 (中文名, 英文名) 在 中文名表 {
        让 签名 = 签名索引
            .获取(英文名.作为文本切片())
            .复制()
            .解包或用("");
        输出.推入字符串(&格式化!(
            "\"{}\" = \"{}\"  # {}\n",
            转义映射文本(中文名),
            转义映射文本(英文名),
            签名
        ));
    }
    输出.推入('\n');

    输出.推入字符串("[\"解释\"]\n");
    对于 (中文名, _) 在 中文名表 {
        让 解释 = 解释表
            .获取(中文名)
            .映射(字符串::作为文本切片)
            .解包或用("");
        输出.推入字符串(&格式化!(
            "\"{}\" = \"{}\"\n",
            转义映射文本(中文名),
            转义映射文本(解释)
        ));
    }

    // 危险等级：解包/期待 等目标调用即恐慌，必须显式写进映射文件，
    // 否则调用方会把它当纯安全接口（词条表也据此逐条标注）
    让 可变 恐慌条目: 向量<&文本> = 向量::新建();
    对于 (中文名, 英文名) 在 中文名表 {
        如果 映射源::恒恐慌目标(英文名) && !恐慌条目.包含(&中文名.作为文本切片()) {
            恐慌条目.推入(中文名.作为文本切片());
        }
    }
    如果 !恐慌条目.是否为空() {
        输出.推入字符串("\n[\"危险等级\"]\n");
        对于 名称 在 恐慌条目 {
            输出.推入字符串(&格式化!("\"{}\" = \"panic\"\n", 转义映射文本(名称)));
        }
    }
    输出
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::超级::规则::规则生成中文名;
    使用 超级::超级::文档抽取::{提取公开接口, 示例文档};
    使用 超级::*;

    #[测试]
    函数 映射输出与免责声明() {
        让 条目表 = 提取公开接口(&示例文档()).解包();
        让 中文名表: 向量<(字符串, 字符串)> = 条目表
            .迭代器()
            .映射(|条目| (规则生成中文名(&条目.英文名), 条目.英文名.克隆值()))
            .收集();
        让 可变 解释表 = 哈希映射::新建();
        解释表.置入("新建".转字符串(), "创建新的值".转字符串());
        让 映射文本 = 构建映射表(
            "zh",
            "示例",
            "示例库",
            有值("1.2.3"),
            &条目表,
            &中文名表,
            &解释表,
        );
        // 免责声明必须存在
        断言!(映射文本.包含(&免责声明文本("zh")), "缺少免责声明");
        断言!(映射文本.包含("# crate: 示例"));
        // 生成基准版本写入文件头（目标版本参数锁定依据）
        断言!(映射文本.包含("# 基准版本: 1.2.3"));
        // 可被标准映射解析
        让 值: TOML处理::TOML值 = TOML处理::解析字符串(&映射文本).期望("映射表应可解析");
        断言!(!值.获取("模块路径").是否为无());
        断言!(!值.获取("标识符").是否为无());
        断言!(!值.获取("解释").是否为无());
        断言相等!(值["模块路径"]["示例库"].作为文本切片(), 有值("示例"));
        断言相等!(值["标识符"]["新建"].作为文本切片(), 有值("new"));
        断言相等!(值["标识符"]["状态"].作为文本切片(), 有值("State"));
        断言相等!(值["解释"]["新建"].作为文本切片(), 有值("创建新的值"));
    }

    #[测试]
    函数 映射输出标注恐慌目标() {
        让 条目表 = 提取公开接口(&示例文档()).解包();
        // 生成物里的解包类目标（调用即恐慌）必须显式标注危险等级
        让 中文名表 = 向量![
            ("解包".转字符串(), "unwrap".转字符串()),
            ("新建".转字符串(), "new".转字符串()),
        ];
        让 映射文本 = 构建映射表(
            "zh",
            "示例",
            "示例库",
            无,
            &条目表,
            &中文名表,
            &哈希映射::新建(),
        );
        让 值: TOML处理::TOML值 = TOML处理::解析字符串(&映射文本).期望("映射表应可解析");
        断言相等!(
            值["危险等级"]["解包"].作为文本切片(),
            有值("panic"),
            "会恐慌的目标必须显式标注: {映射文本}"
        );
        断言!(
            值["危险等级"].获取("新建").是否为无(),
            "安全目标不应被标注危险: {映射文本}"
        );
    }

    #[测试]
    函数 映射可被映射管理器载入() {
        让 条目表 = 提取公开接口(&示例文档()).解包();
        让 中文名表: 向量<(字符串, 字符串)> = 条目表
            .迭代器()
            .映射(|条目| (规则生成中文名(&条目.英文名), 条目.英文名.克隆值()))
            .收集();
        让 映射文本 = 构建映射表(
            "zh",
            "示例",
            "示例库",
            无,
            &条目表,
            &中文名表,
            &哈希映射::新建(),
        );
        让 临时目录 = 临时文件::建临时目录().解包();
        // 模拟语言包目录结构：关键字表 + crates/示例.toml（映射管理器要求关键字表存在）
        标准库::文件系统::写入(
            临时目录.条目路径().连接("keywords.toml"),
            "[\"声明\"]\n\"函数\" = \"fn\"\n",
        )
        .解包();
        让 包目录 = 临时目录.条目路径().连接("crates");
        标准库::文件系统::创建所有目录(&包目录).解包();
        标准库::文件系统::写入(包目录.连接("示例.toml"), 映射文本).解包();
        让 管理器 = 引擎库::映射管理器::映射管理器::从目录载入(临时目录.条目路径())
            .期望("映射管理器应能加载");
        // 解释节被忽略，标识符与模块路径正常生效
        断言相等!(
            管理器.模块路径表.获取("示例库").映射(字符串::作为文本切片),
            有值("示例")
        );
        断言相等!(
            管理器.标识符别名.获取("新建").映射(字符串::作为文本切片),
            有值("new")
        );
        断言相等!(
            管理器.标识符别名.获取("状态").映射(字符串::作为文本切片),
            有值("State")
        );
    }
}
