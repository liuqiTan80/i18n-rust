//! 工具链集成：在临时项目中把目标包作为依赖编译，手动调用 rustdoc
//! 生成 JSON 文档（含薄壳包的整批重导出追踪、构建脚本产物与
//! 包元数据标准环境变量注入）。

使用 JSON序列化::JSON值;
使用 标准库::集合::{哈希映射, 哈希集合};
使用 标准库::文件系统;
使用 标准库::路径::{路径类型, 路径缓冲};
使用 标准库::进程::命令;

使用 错误处理::{错误处理, 错误上下文特征};

使用 超级::文档抽取::提取公开接口带通配源;

/// rustdoc JSON 文本列表：(包名, JSON 文档文本)
类型 文档列表 = 向量<(字符串, 字符串)>;

/// 提取结果：(JSON 文本列表, 目标包实际解析版本)
类型 包文档提取结果 = (文档列表, 选项<字符串>);

/// 临时项目目录守卫（释放时自动清理）
结构体 临时项目(路径缓冲);

实现 临时项目 {
    /// 创建临时项目目录
    函数 新建(包名: &文本) -> 错误处理::结果<自身> {
        // 用户隔离 + 符号链接校验（包名已由运行自动生成校验为
        // 字母数字标识符字符；仍拼接用户/进程号段保证路径不可预测）
        让 目录 = 包::临时守卫::安全临时路径(&格式化!(
            "rzc-mapping-{}-{}-{}",
            包名,
            包::临时守卫::安全用户段(),
            标准库::进程::进程号()
        ))?;
        让 _ = 文件系统::删除所有目录(&目录);
        文件系统::创建所有目录(目录.连接("src")).映射错误(|错误值| {
            错误处理!(
                "{}",
                包::界面::界面消息表::全局表().取带参消息("mg_err_tempdir", &[&错误值.转字符串()])
            )
        })?;
        成功(临时项目(目录))
    }

    /// 获取临时项目路径
    函数 存放路径(&自我) -> &路径类型 {
        &自我.0
    }
}

实现 可丢弃 对于 临时项目 {
    函数 丢弃(&可变 自我) {
        让 _ = 文件系统::删除所有目录(&自我.0);
    }
}

/// 提取目标包及其整批重导出链上依赖包的 rustdoc JSON 文本列表
///
/// 首个元素为目标包本身；后续元素为被整批重导出（`公开 使用 依赖::*`）
/// 的依赖包——薄壳包（如转发层）的公开接口全部来自这些包。
/// 第二个返回值为目标包的实际解析版本（来自 cargo 元数据），
/// 供映射文件头记录生成基准。
///
/// - 版本需求：包管理器版本需求（`=x.y.z` 精确锁定 / `x.y.*` 前缀）；
///   空值时用 `*`（解析到当时最新版，结果不可复现，调用方已提示）
公开 函数 提取包文档(
    包名: &文本,
    版本需求值: 选项<&文本>,
) -> 错误处理::结果<包文档提取结果> {
    让 临时 = 临时项目::新建(包名)?;
    // 1. 临时项目：把目标包作为唯一依赖；版本需求由目标版本参数转换
    //    （未指定时 * 允许任意已发布版本，生成基准不可复现）
    文件系统::写入(
        临时.存放路径().连接("Cargo.toml"),
        格式化!(
            "[package]\nname = \"rzc-mapping-temp\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\n\"{}\" = \"{}\"\n\n[workspace]\n",
            包名,
            版本需求值.解包或用("*")
        ),
    )?;
    文件系统::写入(
        临时.存放路径().连接("src/lib.rs"),
        "// 仅供提取依赖接口的空库\n",
    )?;
    提取文档结构内部(&临时, 包名)
}

/// 工具链核心（对测试开放）：在给定临时项目中定位包并生成其 rustdoc JSON
///
/// 1. `cargo metadata` 定位目标包的源码目录（注册仓库或本地路径依赖均可）
/// 2. `cargo build` 编译依赖树，解析每个依赖的库文件路径
/// 3. 手动调用 `rustdoc -Z unstable-options --output-format json` 文档化目标包
/// 4. 薄壳包（转发包）的公开接口来自整批重导出：解析每个包的整批重导出
///    来源路径，对被重导出的依赖包也生成文档并继续追踪，直至闭环。
///    返回 ((包名, JSON 文本) 列表（首个为目标包本身）, 实际解析版本)。
函数 提取文档结构内部(
    临时: &临时项目,
    包名: &文本,
) -> 错误处理::结果<包文档提取结果> {
    让 项目根 = 临时.存放路径();
    让 界面表 = 包::界面::界面消息表::全局表();

    // 1. 元数据：定位目标包的清单文件
    让 元数据输出 = 运行命令(
        命令::新建(包::解析cargo())
            .单参数("metadata")
            .单参数("--format-version")
            .单参数("1")
            .当前目录(项目根),
        &界面表.取消息("mg_cmd_parse_deps"),
    )?;
    让 元数据: JSON值 = JSON序列化::解析字符串(&元数据输出)
        .映射错误(|错误值| 错误处理!("{}", 界面表.取带参消息("mg_err_parse_meta", &[&错误值.转字符串()])))?;
    // 包元数据索引（清单路径 / 特性 / 版次），供整批重导出链上的
    // 依赖包查询（薄壳包的接口在其依赖中）。同时索引包名
    // （命令行参数）与库目标的包名（文档整批重导出来源），
    // 两者在连字符/下划线写法上可能不同。
    让 可变 包索引: 哈希映射<字符串, JSON值> = 哈希映射::新建();
    让 空包表: 向量<JSON值> = 向量::新建();
    对于 包项 在 元数据["packages"].作为数组().解包或用(&空包表) {
        如果让 有值(包名称) = 包项.获取("name").而后映射(JSON值::作为字符串) {
            包索引.置入(包名称.转字符串(), 包项.克隆值());
        }
        如果让 有值(库名称) = 包项
            .获取("targets")
            .而后映射(JSON值::作为数组)
            .而后映射(|目标表| {
                目标表.迭代器().查找(|目标项| {
                    目标项
                        .获取("kind")
                        .而后映射(JSON值::作为数组)
                        .映射(|种类表| 种类表.迭代器().任意(|值| 值.作为字符串() == 有值("lib")))
                        .取值或(假)
                })
            })
            .而后映射(|目标项| 目标项.获取("name"))
            .而后映射(JSON值::作为字符串)
        {
            包索引.置入(库名称.转字符串(), 包项.克隆值());
        }
    }
    如果 !包索引.包含键(包名) {
        错误处理::错误中止!("{}", 界面表.取带参消息("mg_err_crate_not_found", &[包名]));
    }
    // 目标包的实际解析版本（映射文件头基准版本来源；本地路径依赖
    // 取路径包声明版本，注册仓库依赖取本次解析命中版本）
    让 解析版本 = 包索引
        .获取(包名)
        .而后映射(|包项| 包项.获取("version"))
        .而后映射(JSON值::作为字符串)
        .映射(字符串::从);

    // 解析节点：完整依赖解析图（含多版本共存时的精确解析），按
    // 包标识索引每个包的直接依赖（别名, 依赖包标识）。
    // 外部库参数只传直接依赖的精确版本；传递依赖由编译器按库文件元数据
    // 散列在库目录中自动解析（同名多版本包无法从库目录手动解析）
    让 可变 直接依赖表: 哈希映射<字符串, 向量<(字符串, 字符串)>> = 哈希映射::新建();
    如果让 有值(节点表) = 元数据
        .获取("resolve")
        .而后映射(|解析值| 解析值.获取("nodes"))
        .而后映射(JSON值::作为数组)
    {
        对于 节点 在 节点表 {
            让 有值(节点标识) = 节点.获取("id").而后映射(JSON值::作为字符串) 否则 {
                继续;
            };
            让 可变 依赖表: 向量<(字符串, 字符串)> = 向量::新建();
            如果让 有值(依赖清单) = 节点.获取("deps").而后映射(JSON值::作为数组) {
                对于 依赖项 在 依赖清单 {
                    让 有值(依赖名) = 依赖项.获取("name").而后映射(JSON值::作为字符串) 否则 {
                        继续;
                    };
                    让 有值(依赖包) = 依赖项.获取("pkg").而后映射(JSON值::作为字符串) 否则 {
                        继续;
                    };
                    // 只保留普通依赖（开发/构建依赖不进入库的外部预导入表）；
                    // 目标特定依赖无法静态判定，保守保留
                    让 是普通依赖 = 依赖项
                        .获取("dep_kinds")
                        .而后映射(JSON值::作为数组)
                        .映射(|种类表| {
                            种类表
                                .迭代器()
                                .任意(|种类项| 种类项.获取("kind").映射(|值| 值.是空值()).取值或(真))
                        })
                        .取值或(真);
                    如果 是普通依赖 {
                        依赖表.推入((依赖名.转字符串(), 依赖包.转字符串()));
                    }
                }
            }
            直接依赖表.置入(节点标识.转字符串(), 依赖表);
        }
    }

    // 2. 编译依赖树，解析依赖库文件路径。
    //    统一工具链：显式指定编译器为解析到的同一编译器，保证库文件与后续
    //    手调文档生成（同系统根）版本一致，根治跨版本链接错误。
    让 可变 编译命令值 = 命令::新建(包::解析cargo());
    编译命令值
        .单参数("build")
        .单参数("--message-format=json")
        .环境("RUSTC", 包::解析rustc())
        .当前目录(项目根);
    让 编译输出 = 运行命令(&可变 编译命令值, &界面表.取消息("mg_cmd_build_deps"))?;
    // 包标识 -> (库目标名, 库文件路径, 实际启用的特性)。
    // 按包标识索引而非目标名：依赖树中同名不同版本的包共存时，
    // 按名字覆盖会链接错误版本；特性取编译时的统一解析结果而非包声明的
    // 默认特性——依赖方可能未启用部分默认特性，注入不一致的条件编译项
    // 会导致编译失败（缺依赖）。
    让 可变 产物表: 哈希映射<字符串, (字符串, 字符串, 向量<字符串>)> = 哈希映射::新建();
    // 已编译库的包名集合（整批重导出链入队检查用）
    让 可变 已编译库名: 哈希集合<字符串> = 哈希集合::新建();
    // 包标识 -> 构建脚本产物（见模块级构建脚本信息类型注释）
    让 可变 构建脚本表: 哈希映射<字符串, 构建脚本信息> = 哈希映射::新建();
    对于 行文本 在 编译输出.逐行() {
        让 成功(消息值) = JSON序列化::解析字符串::<JSON值>(行文本) 否则 {
            继续;
        };
        让 有值(原因) = 消息值.获取("reason").而后映射(JSON值::作为字符串) 否则 {
            继续;
        };
        如果 原因 != "compiler-artifact" && 原因 != "build-script-executed" {
            继续;
        }
        让 有值(包标识) = 消息值.获取("package_id").而后映射(JSON值::作为字符串) 否则 {
            继续;
        };
        如果 原因 == "build-script-executed" {
            让 输出目录 = 消息值
                .获取("out_dir")
                .而后映射(JSON值::作为字符串)
                .映射(字符串::从);
            让 条件项表 = 消息值
                .获取("cfgs")
                .而后映射(JSON值::作为数组)
                .映射(|列表| {
                    列表.迭代器()
                        .过滤映射(JSON值::作为字符串)
                        .映射(字符串::从)
                        .收集()
                })
                .取值或默认();
            让 环境项表 = 消息值
                .获取("env")
                .而后映射(JSON值::作为数组)
                .映射(|列表| {
                    列表.迭代器()
                        .过滤映射(JSON值::作为字符串)
                        .映射(字符串::从)
                        .收集()
                })
                .取值或默认();
            构建脚本表.置入(包标识.转字符串(), (输出目录, 条件项表, 环境项表));
            继续;
        }
        // 编译产物：按包标识索引（与元数据里的包标识一致），
        // 多版本共存时精确关联到具体版本；目标名仅作为库名记录
        让 有值(目标名) = 消息值
            .获取("target")
            .而后映射(|目标项| 目标项.获取("name"))
            .而后映射(JSON值::作为字符串)
        否则 {
            继续;
        };
        // 只保留合法标识符的包名（本地工作区成员如中文名项目会被排除）
        如果 目标名.是否为空()
            || 目标名 == "rzc-mapping-temp"
            || !目标名
                .逐字符()
                .全部(|本字| 本字.是ASCII字母数字() || 本字 == '_')
        {
            继续;
        }
        如果让 有值(文件名表) = 消息值.获取("filenames").而后映射(JSON值::作为数组)
            && 让 有值(库文件) = 文件名表
                .迭代器()
                .过滤映射(JSON值::作为字符串)
                .查找(|文件名| 文件名.以结尾(".rlib") || 文件名.以结尾(".so"))
        {
            让 特性表 = 消息值
                .获取("features")
                .而后映射(JSON值::作为数组)
                .映射(|列表| {
                    列表.迭代器()
                        .过滤映射(JSON值::作为字符串)
                        .映射(字符串::从)
                        .收集()
                })
                .取值或默认();
            产物表.置入(
                包标识.转字符串(),
                (目标名.转字符串(), 库文件.转字符串(), 特性表),
            );
            已编译库名.置入(目标名.转字符串());
        }
    }
    如果 产物表.是否为空() {
        错误处理::错误中止!("{}", 界面表.取带参消息("mg_err_build_failed", &[包名]));
    }

    // 3. 文档生成队列：目标包 → 整批重导出链上的依赖包。
    //    薄壳包的索引只有重导出节点，公开接口全部来自被重导出的依赖包，
    //    逐个生成文档后合并提取。
    让 可变 待办队列: 向量<字符串> = 向量![包名.转字符串()];
    让 可变 已访问: 哈希集合<字符串> = 哈希集合::新建();
    让 可变 结果表: 向量<(字符串, 字符串)> = 向量::新建();
    当让 有值(当前名) = 待办队列.弹出() {
        如果 !已访问.置入(当前名.克隆值()) {
            继续;
        }
        让 有值(包项) = 包索引.获取(&当前名) 否则 {
            继续;
        };
        让 包标识 = 包项
            .获取("id")
            .而后映射(JSON值::作为字符串)
            .解包或用("")
            .转字符串();
        // 直接依赖（别名, 精确版本包标识）：外部库参数只传这些
        让 直接依赖项 = 直接依赖表.获取(&包标识).克隆副本().取值或默认();
        让 文档文本 = 单包文档(
            项目根,
            包项,
            &当前名,
            &包标识,
            &产物表,
            &直接依赖项,
            &构建脚本表,
        )?;
        // 整批重导出（公开 使用 依赖::*）→ 被重导出包名（来源首段），
        // 若在依赖树中则入队继续提取；特性未启用而未编译的依赖自动跳过
        让 (_, 通配源表) = 提取公开接口带通配源(&文档文本)?;
        对于 来源 在 通配源表 {
            如果 已编译库名.包含(&来源) && !已访问.包含(&来源) {
                待办队列.推入(来源);
            }
        }
        结果表.推入((当前名, 文档文本));
    }
    成功((结果表, 解析版本))
}

/// 构建脚本产物：输出目录（内联生成代码）、条件编译项、编译期环境变量列表。
/// 部分包的构建脚本会生成被内联的源码或声明条件编译项，
/// 手动文档生成时必须注入，否则编译失败。
类型 构建脚本信息 = (选项<字符串>, 向量<字符串>, 向量<字符串>);

/// 包管理器编译时注入的标准包元数据环境变量：(键, 值) 列表
///
/// 手动文档生成不经过包管理器，过程宏在展开期读取这些变量
/// 会因缺失直接恐慌；未声明的包字段与包管理器一致地给出空字符串
/// （最低编译器版本 / 说明文件仅在清单中声明时才提供）。
函数 构建环境变量(
    包项: &JSON值,
    清单: &TOML处理::TOML值,
    包名: &文本,
    包名下划线: &文本,
    源码目录: &路径类型,
    清单路径: &路径类型,
) -> 向量<(字符串, 字符串)> {
    让 包节 = 清单.获取("package");
    让 元数据文本 = |键名: &文本| -> 字符串 {
        包项
            .获取(键名)
            .而后映射(JSON值::作为字符串)
            .解包或用("")
            .转字符串()
    };
    让 清单文本 = |键名: &文本| -> 字符串 {
        包节
            .而后映射(|包值| 包值.获取(键名))
            .而后映射(TOML处理::TOML值::作为字符串)
            .解包或用("")
            .转字符串()
    };
    让 名称 = {
        让 元数据名称 = 元数据文本("name");
        如果 元数据名称.是否为空() {
            包名.转字符串()
        } 否则 {
            元数据名称
        }
    };
    让 版本 = 元数据文本("version");
    // 版本分段（先剥离构建元数据，再拆预发布；缺失段为空串）
    让 无构建段 = 版本.分割一次('+').映射或默认(版本.作为文本切片(), |(前段, _)| 前段);
    让 (核心段, 预发布段) = 无构建段
        .分割一次('-')
        .映射或默认((无构建段, ""), |(前段, 后段)| (前段, 后段));
    让 可变 段迭代器 = 核心段.分割('.');
    让 主版本 = 段迭代器.下一个().解包或用("").转字符串();
    让 次版本 = 段迭代器.下一个().解包或用("").转字符串();
    让 修订版本 = 段迭代器.下一个().解包或用("").转字符串();
    让 预发布版本 = 预发布段.转字符串();
    // 作者：包管理器以冒号连接多作者
    让 作者 = 匹配 包节.而后映射(|包值| 包值.获取("authors")) {
        有值(TOML处理::TOML值::数组值(列表)) => 列表
            .迭代器()
            .过滤映射(TOML处理::TOML值::作为字符串)
            .收集::<向量<_>>()
            .连接(":"),
        有值(TOML处理::TOML值::字符串值(文本值)) => 文本值.克隆值(),
        _ => 字符串::新建(),
    };
    让 可变 变量表 = 向量![
        ("CARGO_PKG_NAME".转字符串(), 名称),
        ("CARGO_PKG_VERSION".转字符串(), 版本),
        ("CARGO_PKG_VERSION_MAJOR".转字符串(), 主版本),
        ("CARGO_PKG_VERSION_MINOR".转字符串(), 次版本),
        ("CARGO_PKG_VERSION_PATCH".转字符串(), 修订版本),
        ("CARGO_PKG_VERSION_PRE".转字符串(), 预发布版本),
        ("CARGO_CRATE_NAME".转字符串(), 包名下划线.转字符串()),
        (
            "CARGO_MANIFEST_DIR".转字符串(),
            源码目录.展示().转字符串(),
        ),
        (
            "CARGO_MANIFEST_PATH".转字符串(),
            清单路径.展示().转字符串(),
        ),
        ("CARGO_PKG_AUTHORS".转字符串(), 作者),
        ("CARGO_PKG_DESCRIPTION".转字符串(), 清单文本("description")),
        ("CARGO_PKG_HOMEPAGE".转字符串(), 清单文本("homepage")),
        ("CARGO_PKG_REPOSITORY".转字符串(), 清单文本("repository")),
        ("CARGO_PKG_LICENSE".转字符串(), 清单文本("license")),
        ("CARGO_PKG_LICENSE_FILE".转字符串(), 清单文本("license-file")),
    ];
    如果让 有值(最低版本) = 包节
        .而后映射(|包值| 包值.获取("rust-version"))
        .而后映射(TOML处理::TOML值::作为字符串)
    {
        变量表.推入(("CARGO_PKG_RUST_VERSION".转字符串(), 最低版本.转字符串()));
    }
    如果让 有值(说明文件) = 包节
        .而后映射(|包值| 包值.获取("readme"))
        .而后映射(TOML处理::TOML值::作为字符串)
    {
        变量表.推入(("CARGO_PKG_README".转字符串(), 说明文件.转字符串()));
    }
    变量表
}

/// 对单个包手动调用文档工具生成 JSON 文档
///
/// 注入目标包实际启用的特性、构建脚本产物（输出目录 / 条件编译项 /
/// 编译期环境变量）、标准包元数据环境变量与直接依赖的库文件路径
/// （按包标识精确版本），保证条件编译与内联生成出的接口不缺失。
函数 单包文档(
    项目根: &路径类型,
    包项: &JSON值,
    包名: &文本,
    包标识: &文本,
    产物表: &哈希映射<字符串, (字符串, 字符串, 向量<字符串>)>,
    直接依赖项: &[(字符串, 字符串)],
    构建脚本表: &哈希映射<字符串, 构建脚本信息>,
) -> 错误处理::结果<字符串> {
    让 界面表 = 包::界面::界面消息表::全局表();
    让 清单路径 = 路径缓冲::从(
        包项
            .获取("manifest_path")
            .而后映射(JSON值::作为字符串)
            .缺值转错(|| 错误处理!("{}", 界面表.取带参消息("mg_err_no_manifest", &[包名])))?,
    );
    让 源码目录 = 清单路径
        .父目录()
        .缺值转错(|| 错误处理!("{}", 界面表.取带参消息("mg_err_no_src_dir", &[包名])))?;
    让 库文件 = 源码目录.连接("src/lib.rs");
    如果 !库文件.存在() {
        错误处理::错误中止!("{}", 界面表.取带参消息("mg_err_no_lib", &[包名]));
    }
    // 默认特性：包管理器直接传给编译器，不经过构建脚本，
    // 手动文档生成时必须显式补传，否则被条件编译裁掉的接口会缺失
    让 默认特性 = 包项
        .获取("features")
        .而后映射(|特性值| 特性值.获取("default"))
        .而后映射(JSON值::作为数组)
        .映射(|列表| {
            列表.迭代器()
                .过滤映射(JSON值::作为字符串)
                .映射(字符串::从)
                .收集::<向量<_>>()
        })
        .取值或默认();

    让 清单内容 = 文件系统::读取全部字符串(&清单路径).带错误上下文(|| {
        界面表.取带参消息("mg_err_read_manifest", &[&清单路径.展示().转字符串()])
    })?;
    让 清单: TOML处理::TOML值 = TOML处理::解析字符串(&清单内容).映射错误(|错误值| {
        错误处理!(
            "{}",
            界面表.取带参消息(
                "mg_err_parse_manifest",
                &[&清单路径.展示().转字符串(), &错误值.转字符串()]
            )
        )
    })?;
    让 版次 = 清单
        .获取("package")
        .而后映射(|包值| 包值.获取("edition"))
        .而后映射(TOML处理::TOML值::作为字符串)
        .解包或用("2015")
        .转字符串();
    让 过程宏 = 清单
        .获取("lib")
        .而后映射(|库节| 库节.获取("proc-macro"))
        .而后映射(TOML处理::TOML值::转布尔)
        .取值或(假);

    让 包名下划线 = 包名.替换('-', "_");
    让 文档目录 = 项目根.连接("mapping-json");
    文件系统::创建所有目录(&文档目录)?;
    让 可变 命令值 = 命令::新建(包::解析文档工具());
    命令值
        .单参数(&库文件)
        .单参数("--crate-name")
        .单参数(&包名下划线)
        .单参数("--crate-type")
        .单参数(如果 过程宏 { "proc-macro" } 否则 { "lib" })
        .单参数("--edition")
        .单参数(&版次)
        .单参数("-L")
        .单参数(格式化!(
            "dependency={}",
            项目根.连接("target/debug/deps").展示()
        ))
        .环境("RUSTC_BOOTSTRAP", "1");
    // 补全包管理器编译时注入的标准环境变量：过程宏在展开期读取包名，
    // 缺失会直接恐慌
    对于 (键名, 键值) 在 构建环境变量(
        包项,
        &清单,
        包名,
        &包名下划线,
        源码目录,
        &清单路径,
    ) {
        命令值.环境(键名, 键值);
    }
    // 外部库参数只传直接依赖的精确版本：同名多版本包无法从库目录自动解析，
    // 编译器可能链接错误版本；传递依赖由编译器按库文件元数据散列自动解析
    对于 (依赖名, 依赖包标识) 在 直接依赖项 {
        如果让 有值((_, 库路径, _)) = 产物表.获取(依赖包标识) {
            命令值
                .单参数("--extern")
                .单参数(格式化!("{}={}", 依赖名, 库路径));
        }
    }
    // 注入编译时实际启用的特性作为条件编译项，与编译产物保持一致；
    // 未命中时回退包声明的默认特性
    让 特性表 = 产物表
        .获取(包标识)
        .映射(|(_, _, 已启用)| 已启用.克隆值())
        .取值或(默认特性);
    对于 特性名 在 &特性表 {
        命令值
            .单参数("--cfg")
            .单参数(格式化!("feature=\"{}\"", 特性名));
    }
    // 注入目标包构建脚本产物：输出目录、条件编译项、编译期环境变量
    如果让 有值((输出目录, 条件项表, 环境项表)) = 构建脚本表.获取(包标识) {
        如果让 有值(目录值) = 输出目录 {
            命令值.环境("OUT_DIR", 目录值);
        }
        对于 条件项 在 条件项表 {
            命令值.单参数("--cfg").单参数(条件项);
        }
        对于 环境项 在 环境项表 {
            如果让 有值((键名, 键值)) = 环境项.分割一次('=') {
                命令值.环境(键名, 键值);
            }
        }
    }
    命令值
        .单参数("-Z")
        .单参数("unstable-options")
        .单参数("--output-format")
        .单参数("json")
        .单参数("--output")
        .单参数(&文档目录);
    运行命令(&可变 命令值, &界面表.取消息("mg_cmd_gen_doc"))?;

    让 文档路径 = 文档目录.连接(格式化!("{}.json", 包名下划线));
    文件系统::读取全部字符串(&文档路径)
        .带错误上下文(|| 界面表.取带参消息("mg_err_no_doc_json", &[&文档路径.展示().转字符串()]))
}

/// 运行命令并返回标准输出；失败时附加标准错误摘要
常量 错误摘要行数: 无符号机器整数 = 15;
函数 运行命令(命令值: &可变 命令, 说明: &文本) -> 错误处理::结果<字符串> {
    让 输出值 = 命令值
        .取输出()
        .带错误上下文(|| 包::界面::界面消息表::全局表().取带参消息("mg_err_run_failed", &[说明]))?;
    如果 !输出值.进程状态.退出成功() {
        让 错误输出 = 字符串::从utf8宽松(&输出值.标准错误);
        让 摘要 = 错误输出
            .逐行()
            .取值(错误摘要行数)
            .收集::<向量<_>>()
            .连接("\n");
        错误处理::错误中止!(
            "{}",
            包::界面::界面消息表::全局表().取带参消息("mg_err_failed", &[说明, &摘要])
        );
    }
    让 标准输出文本 = 字符串::从utf8宽松(&输出值.标准输出).转字符串();
    成功(标准输出文本)
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::超级::文档抽取::{提取公开接口, 示例文档};
    使用 超级::*;

    #[测试]
    函数 真实工具链提取() {
        让 临时 = 临时文件::建临时目录().解包();
        让 迷你 = 临时.条目路径().连接("mini-crate");
        文件系统::创建所有目录(迷你.连接("src")).解包();
        文件系统::写入(
            迷你.连接("Cargo.toml"),
            "[package]\nname = \"mini-crate\"\nversion = \"0.1.0\"\nedition = \"2024\"\n[workspace]\n",
        )
        .解包();
        文件系统::写入(
            迷你.连接("src/lib.rs"),
            "pub fn 新建(x: u32) -> Result<Foo, String> { Ok(Foo) }\npub struct Foo;\npub enum 颜色 { 红, 蓝 }\npub trait 行为 {}\npub type 数量 = u32;\npub const 最大值: u32 = 100;\nfn 私有函数() {}\n",
        )
        .解包();
        让 外壳 = 临时.条目路径().连接("外壳");
        文件系统::创建所有目录(外壳.连接("src")).解包();
        文件系统::写入(
            外壳.连接("Cargo.toml"),
            "[package]\nname = \"外壳\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\nmini-crate = { path = \"../mini-crate\" }\n\n[workspace]\n",
        )
        .解包();
        文件系统::写入(外壳.连接("src/lib.rs"), "// 空库\n").解包();

        让 临时守卫 = 临时项目::新建("mini-crate").期望("创建临时项目失败");
        // 覆盖临时项目路径为外壳项目
        让 _ = 文件系统::删除所有目录(临时守卫.存放路径());
        文件系统::创建所有目录(外壳.连接("src")).解包();
        让 (文档列表值, 解析版本) =
            提取文档结构内部(&临时项目(外壳.克隆值()), "mini-crate")
                .期望("工具链应能提取文档");
        // 本地路径依赖 0.1.0：解析版本应被捕获（映射文件头基准来源）
        断言相等!(解析版本.作为解引用(), 有值("0.1.0"));
        让 条目表 = 提取公开接口(&文档列表值[0].1).解包();
        让 名称清单: 向量<&文本> =
            条目表.迭代器().映射(|条目| 条目.英文名.作为文本切片()).收集();
        断言!(名称清单.包含(&"新建"), "应提取到函数 新建: {:?}", 名称清单);
        断言!(名称清单.包含(&"Foo"));
        断言!(名称清单.包含(&"颜色"));
        断言!(名称清单.包含(&"行为"));
        断言!(名称清单.包含(&"数量"));
        断言!(名称清单.包含(&"最大值"));
        断言!(!名称清单.包含(&"私有函数"), "私有函数不应被提取");
        // 签名包含类型信息
        让 新建条目 = 条目表.迭代器().查找(|条目| 条目.英文名 == "新建").解包();
        断言!(
            新建条目.签名.包含("u32"),
            "签名应含参数类型: {}",
            新建条目.签名
        );
    }

    /// 不存在的包应报错（含未找到提示）
    #[测试]
    函数 不存在包报错() {
        // 错误文案按界面语言渲染，语言又取自环境变量：临时接管清除
        // 区域设置与界面语言，保证命中中文模板
        让 _锁 = 包::语言管理::母语测试::环境锁();
        让 _环境 = 包::语言管理::母语测试::环境还原::接管(&[
            "RZ_LANG",
            "LC_ALL",
            "LC_MESSAGES",
            "LANG",
        ]);
        让 临时 = 临时项目::新建("rzc-不存在的crate-xyz-123").期望("创建临时项目失败");
        // 写入不含目标包的有效最小项目：让元数据查询成功，
        // 从而命中产品逻辑的包未找到映射（否则包管理器先因缺
        // 清单文件报通用错误，根本走不到该分支）
        文件系统::写入(
            临时.存放路径().连接("Cargo.toml"),
            "[package]\nname = \"rzc-mapping-temp\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[workspace]\n",
        )
        .解包();
        文件系统::写入(临时.存放路径().连接("src/lib.rs"), "// 空库\n").解包();
        让 提取结果 = 提取文档结构内部(&临时, "rzc-不存在的crate-xyz-123");
        让 错误值 = 提取结果.期望错误("应报错");
        断言!(
            错误值.转字符串().包含("未找到"),
            "错误应提示未找到: {}",
            错误值
        );
    }

    /// 真实工具链 + 构建脚本（生成被内联的源码）：
    /// 验证输出目录注入，覆盖依赖构建脚本的包
    #[测试]
    函数 构建脚本输出目录注入() {
        让 临时 = 临时文件::建临时目录().解包();
        让 迷你 = 临时.条目路径().连接("mini-gen");
        文件系统::创建所有目录(迷你.连接("src")).解包();
        文件系统::写入(
            迷你.连接("Cargo.toml"),
            "[package]\nname = \"mini-gen\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[build-dependencies]\n[workspace]\n",
        )
        .解包();
        文件系统::写入(
            迷你.连接("build.rs"),
            "fn main() {\n    let dir = std::env::var(\"OUT_DIR\").unwrap();\n    std::fs::write(std::path::Path::new(&dir).join(\"generated.rs\"), \"pub const GENERATED_VALUE: u32 = 42;\\n\").unwrap();\n}\n",
        )
        .解包();
        文件系统::写入(
            迷你.连接("src/lib.rs"),
            "include!(concat!(env!(\"OUT_DIR\"), \"/generated.rs\"));\npub fn use_generated_value() -> u32 { GENERATED_VALUE }\n",
        )
        .解包();
        让 外壳 = 临时.条目路径().连接("外壳2");
        文件系统::创建所有目录(外壳.连接("src")).解包();
        文件系统::写入(
            外壳.连接("Cargo.toml"),
            "[package]\nname = \"外壳2\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\nmini-gen = { path = \"../mini-gen\" }\n\n[workspace]\n",
        )
        .解包();
        文件系统::写入(外壳.连接("src/lib.rs"), "// 空库\n").解包();

        让 (文档列表值, _) = 提取文档结构内部(&临时项目(外壳.克隆值()), "mini-gen")
            .期望("输出目录注入后应能生成文档");
        让 条目表 = 提取公开接口(&文档列表值[0].1).解包();
        让 名称清单: 向量<&文本> =
            条目表.迭代器().映射(|条目| 条目.英文名.作为文本切片()).收集();
        断言!(
            名称清单.包含(&"use_generated_value"),
            "应提取到内联生成代码后的函数: {:?}",
            名称清单
        );
    }

    /// 默认特性注入：被条件编译裁掉的接口需通过条件编译参数恢复
    #[测试]
    函数 默认特性注入() {
        让 临时 = 临时文件::建临时目录().解包();
        让 迷你 = 临时.条目路径().连接("mini-feat");
        文件系统::创建所有目录(迷你.连接("src")).解包();
        文件系统::写入(
            迷你.连接("Cargo.toml"),
            "[package]\nname = \"mini-feat\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[features]\ndefault = [\"magic\"]\n\"magic\" = []\n[workspace]\n",
        )
        .解包();
        文件系统::写入(
            迷你.连接("src/lib.rs"),
            "pub fn normal_fn() {}\n#[cfg(feature = \"magic\")]\npub fn magic_fn() {}\n",
        )
        .解包();
        让 外壳 = 临时.条目路径().连接("外壳3");
        文件系统::创建所有目录(外壳.连接("src")).解包();
        文件系统::写入(
            外壳.连接("Cargo.toml"),
            "[package]\nname = \"外壳3\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\nmini-feat = { path = \"../mini-feat\" }\n\n[workspace]\n",
        )
        .解包();
        文件系统::写入(外壳.连接("src/lib.rs"), "// 空库\n").解包();

        让 (文档列表值, _) = 提取文档结构内部(&临时项目(外壳.克隆值()), "mini-feat")
            .期望("应能生成文档");
        让 条目表 = 提取公开接口(&文档列表值[0].1).解包();
        让 名称清单: 向量<&文本> =
            条目表.迭代器().映射(|条目| 条目.英文名.作为文本切片()).收集();
        断言!(
            名称清单.包含(&"magic_fn"),
            "默认特性下的接口应被提取: {:?}",
            名称清单
        );
        断言!(名称清单.包含(&"normal_fn"));
    }

    /// 薄壳包整批重导出追踪：目标包仅做整批重导出，
    /// 其公开接口应通过追踪被重导出的依赖包提取到
    #[测试]
    函数 整批重导出追踪() {
        让 临时 = 临时文件::建临时目录().解包();
        // 真实包：提供全部接口
        让 核心 = 临时.条目路径().连接("mini-core");
        文件系统::创建所有目录(核心.连接("src")).解包();
        文件系统::写入(
            核心.连接("Cargo.toml"),
            "[package]\nname = \"mini-core\"\nversion = \"0.1.0\"\nedition = \"2024\"\n[workspace]\n",
        )
        .解包();
        文件系统::写入(
            核心.连接("src/lib.rs"),
            "pub fn handle_request() -> Result<Response, Error> { Ok(Response) }\npub struct Response;\npub enum Error { E }\npub trait Handler {}\n",
        )
        .解包();
        // 薄壳包：全部接口来自整批重导出
        让 外壳包 = 临时.条目路径().连接("mini-facade");
        文件系统::创建所有目录(外壳包.连接("src")).解包();
        文件系统::写入(
            外壳包.连接("Cargo.toml"),
            "[package]\nname = \"mini-facade\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\nmini-core = { path = \"../mini-core\" }\n\n[workspace]\n",
        )
        .解包();
        文件系统::写入(
            外壳包.连接("src/lib.rs"),
            "pub use mini_core::*;\npub use mini_core as core;\n",
        )
        .解包();
        让 外壳 = 临时.条目路径().连接("外壳4");
        文件系统::创建所有目录(外壳.连接("src")).解包();
        文件系统::写入(
            外壳.连接("Cargo.toml"),
            "[package]\nname = \"外壳4\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\nmini-facade = { path = \"../mini-facade\" }\n\n[workspace]\n",
        )
        .解包();
        文件系统::写入(外壳.连接("src/lib.rs"), "// 空库\n").解包();

        让 (文档列表值, _) = 提取文档结构内部(&临时项目(外壳.克隆值()), "mini-facade")
            .期望("工具链应能提取文档");
        // 目标包 + 被整批重导出的依赖包
        让 包名清单: 向量<&文本> =
            文档列表值.迭代器().映射(|(名称, _)| 名称.作为文本切片()).收集();
        断言!(
            文档列表值.长度() >= 2,
            "应追踪到被重导出的依赖包: {:?}",
            包名清单
        );
        断言!(
            包名清单.包含(&"mini_core"),
            "整批重导出链应包含 mini_core（包名下划线形式）: {:?}",
            包名清单
        );
        // 合并全部 JSON 提取，薄壳包的接口应全部到位
        让 可变 条目表 = 向量::新建();
        让 可变 已见名称 = 哈希集合::新建();
        对于 (_, 文档文本) 在 &文档列表值 {
            对于 条目值 在 提取公开接口(文档文本).解包() {
                如果 已见名称.置入(条目值.英文名.克隆值()) {
                    条目表.推入(条目值);
                }
            }
        }
        让 名称清单: 向量<&文本> =
            条目表.迭代器().映射(|条目| 条目.英文名.作为文本切片()).收集();
        断言!(名称清单.包含(&"handle_request"));
        断言!(名称清单.包含(&"Response"));
        断言!(名称清单.包含(&"Error"));
        断言!(名称清单.包含(&"Handler"));
    }

    /// 构建环境变量：名称/版本分段/作者拼接与空值兜底（包管理器语义）
    #[测试]
    函数 构建环境变量取值() {
        让 包项 = JSON序列化::JSON格式!({ "name": "tauri", "version": "2.11.5" });
        让 清单: TOML处理::TOML值 = TOML处理::解析字符串(
            "[package]\nname = \"tauri\"\nversion = \"2.11.5\"\nauthors = [\"A\", \"B\"]\nlicense = \"MIT\"\nrust-version = \"1.77\"\n",
        )
        .解包();
        让 变量表 = 构建环境变量(
            &包项,
            &清单,
            "tauri",
            "tauri",
            路径类型::新建("/src/tauri-2.11.5"),
            路径类型::新建("/src/tauri-2.11.5/Cargo.toml"),
        );
        让 取值 = |键名: &文本| {
            变量表
                .迭代器()
                .查找(|(键, _)| 键 == 键名)
                .映射(|(_, 值)| 值.作为文本切片())
        };
        断言相等!(取值("CARGO_PKG_NAME"), 有值("tauri"));
        断言相等!(取值("CARGO_PKG_VERSION"), 有值("2.11.5"));
        断言相等!(取值("CARGO_PKG_VERSION_MAJOR"), 有值("2"));
        断言相等!(取值("CARGO_PKG_VERSION_MINOR"), 有值("11"));
        断言相等!(取值("CARGO_PKG_VERSION_PATCH"), 有值("5"));
        断言相等!(取值("CARGO_PKG_VERSION_PRE"), 有值(""));
        断言相等!(取值("CARGO_CRATE_NAME"), 有值("tauri"));
        断言相等!(取值("CARGO_MANIFEST_DIR"), 有值("/src/tauri-2.11.5"));
        断言相等!(取值("CARGO_PKG_AUTHORS"), 有值("A:B"));
        断言相等!(取值("CARGO_PKG_LICENSE"), 有值("MIT"));
        断言相等!(取值("CARGO_PKG_RUST_VERSION"), 有值("1.77"));
        // 未声明的字段与包管理器一致给空串；未声明最低版本不提供该变量
        断言相等!(取值("CARGO_PKG_DESCRIPTION"), 有值(""));
        让 包项二 = JSON序列化::JSON格式!({ "name": "x", "version": "1.0.0-alpha.1+build.5" });
        让 清单二: TOML处理::TOML值 =
            TOML处理::解析字符串("[package]\nname = \"x\"\nversion = \"1.0.0-alpha.1+build.5\"\n")
                .解包();
        让 变量表二 = 构建环境变量(
            &包项二,
            &清单二,
            "x",
            "x",
            路径类型::新建("/s"),
            路径类型::新建("/s/Cargo.toml"),
        );
        让 取值二 = |键名: &文本| {
            变量表二
                .迭代器()
                .查找(|(键, _)| 键 == 键名)
                .映射(|(_, 值)| 值.作为文本切片())
        };
        断言相等!(取值二("CARGO_PKG_VERSION_PRE"), 有值("alpha.1"));
        断言相等!(取值二("CARGO_PKG_VERSION_PATCH"), 有值("0"));
        断言相等!(取值二("CARGO_PKG_RUST_VERSION"), 无);
        断言相等!(取值二("CARGO_PKG_README"), 无);
    }

    /// 真实工具链：文档工具在编译期读取包元数据环境变量，
    /// 注入缺失或值错误时常量断言编译失败——保障提取管线补全这些变量
    #[测试]
    函数 包元数据环境注入() {
        让 临时 = 临时文件::建临时目录().解包();
        让 迷你 = 临时.条目路径().连接("mini-env");
        文件系统::创建所有目录(迷你.连接("src")).解包();
        文件系统::写入(
            迷你.连接("Cargo.toml"),
            "[package]\nname = \"mini-env\"\nversion = \"0.2.3\"\nedition = \"2024\"\ndescription = \"迷你环境测试包\"\n\n[workspace]\n",
        )
        .解包();
        文件系统::写入(
            迷你.连接("src/lib.rs"),
            "const fn eq(a: &str, b: &str) -> bool {\n\
             let (a, b) = (a.as_bytes(), b.as_bytes());\n\
             if a.len() != b.len() {\n\
             return false;\n\
             }\n\
             let mut i = 0;\n\
             while i < a.len() {\n\
             if a[i] != b[i] {\n\
             return false;\n\
             }\n\
             i += 1;\n\
             }\n\
             true\n\
             }\n\
             const _: () = assert!(eq(env!(\"CARGO_PKG_NAME\"), \"mini-env\"));\n\
             const _: () = assert!(eq(env!(\"CARGO_PKG_VERSION\"), \"0.2.3\"));\n\
             const _: () = assert!(eq(env!(\"CARGO_PKG_VERSION_MINOR\"), \"2\"));\n\
             const _: () = assert!(eq(env!(\"CARGO_CRATE_NAME\"), \"mini_env\"));\n\
             pub fn env_check() -> u8 { 1 }\n",
        )
        .解包();
        让 外壳 = 临时.条目路径().连接("外壳5");
        文件系统::创建所有目录(外壳.连接("src")).解包();
        文件系统::写入(
            外壳.连接("Cargo.toml"),
            "[package]\nname = \"外壳5\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\nmini-env = { path = \"../mini-env\" }\n\n[workspace]\n",
        )
        .解包();
        文件系统::写入(外壳.连接("src/lib.rs"), "// 空库\n").解包();

        让 (文档列表值, _) = 提取文档结构内部(&临时项目(外壳.克隆值()), "mini-env")
            .期望("包元数据环境变量注入后应能生成文档");
        让 条目表 = 提取公开接口(&文档列表值[0].1).解包();
        让 名称清单: 向量<&文本> =
            条目表.迭代器().映射(|条目| 条目.英文名.作为文本切片()).收集();
        断言!(
            名称清单.包含(&"env_check"),
            "应提取到环境检查函数: {:?}",
            名称清单
        );
    }

    /// 样本 JSON 可解析（样本与提取器在同一包，防漂移）
    #[测试]
    函数 样本可解析() {
        让 条目表 = 提取公开接口(&示例文档()).解包();
        断言!(!条目表.是否为空());
    }
}
