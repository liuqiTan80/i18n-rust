//! AI 驱动的映射生成（OpenAI 兼容接口，默认端点 DeepSeek）：
//! 只发送 API 英文名与类型签名（法律合规约束，见 mod.rs 模块文档）。

使用 JSON序列化::JSON值;
使用 标准库::集合::{哈希集合, 哈希映射};

使用 超级::接口条目;

/// AI 请求超时配置（秒）
常量 智能连接超时: 无符号长整数 = 30;
/// 单次 AI 调用最多处理的 API 条目数：长映射（数百条目）单次调用会超
/// 模型输出上限，按批调用后合并结果
常量 智能批大小: 无符号机器整数 = 50;
/// AI 系统提示语（中文）：面向 zh 语言包，生成中文名 + 中文解释
常量 智能提示中文: &文本 = "你是面向 Rust 新手的教学翻译专家。任务：把第三方 crate 的公开 API 翻译成中文教学映射。\n\
    输入：API 英文名 + 类型签名列表。你只能依据名称和类型签名推测含义，\n\
    禁止使用、翻译或复制任何官方文档内容。\n\
    输出：严格 TOML 格式，仅两个节：\n\
    [\"标识符\"]\n\"中文名\" = \"英文名\"\n\
    [\"解释\"]\n\"中文名\" = \"一句不超过 40 字的大白话解释\"\n\
    要求：中文名直观好记；解释说明这个 API 是干什么的、怎么用，面向新手；\n\
    不能确定的条目省略；只输出 TOML，不要输出任何其他文字。";
/// AI 系统提示语（英文）：面向非 zh 语言包，名称保持英文，生成英文新手解释
/// （TOML 节名必须保持 \"标识符\" / \"解释\"，与解析器及映射文件格式兼容）
常量 智能提示英文: &文本 = "You are a teaching translation expert for Rust beginners. Task: produce a teaching mapping for the public API of a third-party crate.\n\
    Input: a list of API English names + type signatures. Infer meaning from names and signatures only;\n\
    never use, translate, or copy any official documentation content.\n\
    Output: strict TOML with exactly two sections:\n\
    [\"标识符\"]\n\"name\" = \"EnglishName\" (keep the names as-is; only include entries you are sure about)\n\
    [\"解释\"]\n\"name\" = \"one plain-language explanation under 40 words for beginners\"\n\
    Requirements: the explanation must say what the API does and how to use it, in simple English;\n\
    omit entries you cannot determine; output only TOML and nothing else.";
常量 智能读取超时: 无符号长整数 = 120;
常量 智能写入超时: 无符号长整数 = 60;

/// 默认端点与模型（DeepSeek，OpenAI 兼容协议）
常量 默认基础地址: &文本 = "https://api.deepseek.com";
常量 默认模型: &文本 = "deepseek-chat";

/// AI 端点配置：三项与 VS Code 扩展的 `i18n-rust.ai.baseUrl / apiKey / model`
/// 设置一一对应，CLI 侧走环境变量（无图形界面与 CI 场景要能脚本化）
#[派生(可调试, 部分相等, 全等)]
公开 结构体 智能端点<'甲> {
    /// chat/completions 的基础 URL（不含 `/chat/completions` 后缀）
    公开 基础地址: 字符串,
    /// Bearer 密钥，只用于请求头，绝不输出
    公开 接口密钥: 字符串,
    /// 请求体的模型字段
    公开 模型: 字符串,
    /// 实际生效的密钥环境变量名（诊断文案回显，避免用户查错变量）
    公开 密钥变量名: &'甲 文本,
    /// 端点是否被用户改成自定义地址（决定密钥回退链）
    公开 自定义: 布尔,
}

/// 解析 AI 端点配置（环境变量读取函数由调用方注入，单测不碰真实环境）
///
/// 首选 `RZ_AI_BASE_URL / RZ_AI_API_KEY / RZ_AI_MODEL`，未设置时回退历史
/// DeepSeek 专用变量。密钥回退有一条安全约束：默认端点是 DeepSeek，只有当用户
/// 显式改成自定义端点时才考虑 `OPENAI_API_KEY`——否则会把用户的 OpenAI 密钥
/// 发往另一台主机（拿到一个 401，账单却可能记在 OpenAI 侧）。
函数 解析端点<'甲>(
    取值函数: &动态 闭包特征(&文本) -> 选项<字符串>,
) -> 错误处理::结果<智能端点<'甲>> {
    让 界面表 = 包::界面::界面消息表::全局表();
    // 空串视为未设置：CI 里 `export RZ_AI_BASE_URL=` 不应把端点变成空 URL
    让 读取配置 = |变量名: &文本| {
        取值函数(变量名)
            .映射(|值文本| 值文本.裁剪().转字符串())
            .过滤(|值文本| !值文本.是否为空())
    };
    让 基础地址 = 读取配置("RZ_AI_BASE_URL")
        .或用否则(|| 读取配置("DEEPSEEK_BASE_URL"))
        .解包或用否则(|| 默认基础地址.转字符串());
    让 自定义 = 基础地址 != 默认基础地址;
    让 模型 = 读取配置("RZ_AI_MODEL").解包或用否则(|| 默认模型.转字符串());
    让 链: &[&'甲 文本] = 如果 自定义 {
        &["RZ_AI_API_KEY", "OPENAI_API_KEY", "DEEPSEEK_API_KEY"]
    } 否则 {
        &["RZ_AI_API_KEY", "DEEPSEEK_API_KEY"]
    };
    让 可变 空变量: 选项<&'甲 文本> = 无;
    对于 &变量名 在 链 {
        匹配 取值函数(变量名) {
            有值(值文本) 如果 值文本.裁剪().是否为空() => {
                空变量.插入或(变量名);
            }
            有值(值文本) => {
                返回 成功(智能端点 {
                    基础地址,
                    接口密钥: 值文本.裁剪().转字符串(),
                    模型,
                    密钥变量名: 变量名,
                    自定义,
                });
            }
            无 => {}
        }
    }
    匹配 空变量 {
        // 密钥存在但为空串：点名是哪个变量，不让用户逐个试
        有值(变量名) => 错误处理::错误中止!(
            "{}",
            界面表.取带参消息("mg_err_api_key_empty", &[变量名])
        ),
        无 => 错误处理::错误中止!("{}", 界面表.取带参消息("mg_err_no_api_key", &[链[0]])),
    }
}

/// 拼出 chat/completions 完整 URL
///
/// 编辑器扩展习惯把端点写到版本段，而 CLI 沿用的默认值
/// 是不带 `/v1` 的裸主机名；这里统一为“已带后缀就原样用，否则补一段”，
/// 两侧粘同一个 URL 都能跑。
公开 函数 对话地址(基础文本: &文本) -> 字符串 {
    让 裁剪文本 = 基础文本.裁剪右侧匹配('/');
    如果 裁剪文本.以结尾("/chat/completions") {
        裁剪文本.转字符串()
    } 否则 {
        格式化!("{裁剪文本}/chat/completions")
    }
}

/// AI 模式的前置凭据检查：在写任何文件之前确认密钥可用
///
/// `mapping scaffold --provider <ai>` 是「生成骨架 + AI 填充」两步，但没配密钥时
/// 不该先留下几十个待手工翻译的骨架文件——那会让「命令失败」与「文件已被改动」
/// 同时成立。只跑 [`解析端点`]，不发网络请求。
公开 函数 确保凭据() -> 错误处理::结果<空> {
    解析端点(&|变量名| 标准库::环境::环境变量(变量名).转选项()).映射(|_| ())
}

/// `--provider` 参数的归一化结果
#[派生(可调试, 部分相等, 全等)]
公开 枚举 服务商 {
    /// 调用 OpenAI 兼容端点翻译
    智能,
    /// 离线规则模式（不联网）
    规则,
}

/// 解析服务商选项：深度求索 / 开放人工智能 / 兼容端点走同一条 OpenAI
/// 兼容链路（区别只在环境变量里的端点与模型），规则为离线模式。
///
/// 保留深度求索作为默认写法（已有脚本与文档都在用），但名字不再绑死厂商。
公开 函数 解析服务商(值文本: &文本) -> 选项<服务商> {
    匹配 值文本 {
        "deepseek" | "openai" | "compatible" => 有值(服务商::智能),
        "rule" => 有值(服务商::规则),
        _ => 无,
    }
}

/// 调用 OpenAI 兼容对话补全接口的通用底层：发送系统与用户提示词，返回模型文本
///
/// 端点、密钥、模型由 [`解析端点`] 决定。供映射生成
/// （调用智能生成映射）与脚手架翻译
/// （映射检查::运行脚手架的服务商选项）共用。
公开 函数 智能对话(系统提示: &文本, 用户提示: &文本) -> 错误处理::结果<字符串> {
    让 界面表 = 包::界面::界面消息表::全局表();
    让 端点 = 解析端点(&|变量名| 标准库::环境::环境变量(变量名).转选项())?;
    让 地址 = 对话地址(&端点.基础地址);
    // 端点只回显一次：分批调用逐批打印会淹没进度；只回显密钥变量名，不碰密钥本身
    静态 端点已报告: 标准库::同步模块::一次性 = 标准库::同步模块::一次性::新建();
    端点已报告.调用一次(|| {
        打印行!(
            "{}",
            界面表.取带参消息("mg_ai_endpoint", &[&地址, &端点.模型, 端点.密钥变量名])
        );
    });
    让 请求体 = JSON序列化::JSON格式!({
        "model": 端点.模型,
        "messages": [
            { "role": "system", "content": 系统提示 },
            { "role": "user", "content": 用户提示 }
        ],
        "temperature": 0.2,
        // 输出上限 8K：分批后单批输出仍可能接近默认 4K 上限
        "max_tokens": 8000,
        "stream": 假
    });
    让 代理 = 轻量HTTP客户端::智能代理::配置构建器()
        .连接限时(有值(标准库::时间模块::持续时间::从秒(智能连接超时)))
        .整体限时(有值(标准库::时间模块::持续时间::从秒(
            智能读取超时 + 智能写入超时,
        )))
        .构建()
        .新代理();
    让 响应 = 代理
        .发送请求(&地址)
        .头部("Content-Type", "application/json")
        .头部("Authorization", &格式化!("Bearer {}", 端点.接口密钥))
        .发送(请求体.转字符串())
        .映射错误(|错误值| 错误处理::错误处理!("{}", 界面表.取带参消息("mg_err_ai_request", &[&错误值.转字符串()])))?;
    如果 响应.响应状态() != 200 {
        错误处理::错误中止!(
            "{}",
            界面表.取带参消息("mg_err_ai_status", &[&响应.响应状态().转字符串()])
        );
    }
    // 读取上限：被控/故障端点的响应若无界，读取全部字符串会持续累积
    // 直到进程内存耗尽（超时只限制时长，不限制字节数）。
    // 8 MiB 远超单批键名翻译的合理响应（数百条短键），仅作安全上限。
    常量 响应上限: 无符号长整数 = 8 * 1024 * 1024;
    让 可变 主体 = 响应.转入主体();
    让 响应文本 = 主体
        .带配置()
        .限制(响应上限)
        .读取全部字符串()
        .映射错误(|错误值| 错误处理::错误处理!("{}", 界面表.取带参消息("mg_err_ai_read", &[&错误值.转字符串()])))?;
    让 响应文档: JSON值 = JSON序列化::解析字符串(&响应文本)
        .映射错误(|错误值| 错误处理::错误处理!("{}", 界面表.取带参消息("mg_err_ai_parse", &[&错误值.转字符串()])))?;
    响应文档
        .截取("choices")
        .而后映射(|选择值| 选择值.截取(0))
        .而后映射(|消息值| 消息值.截取("message"))
        .而后映射(|消息值| 消息值.截取("content"))
        .而后映射(JSON值::作为字符串)
        .映射(|文本值| 文本值.转字符串())
        .缺值转错(|| 错误处理::错误处理!("{}", 界面表.取消息("mg_err_ai_no_content")))
}

/// 构建单批请求的用户提示词（包名 + 该批接口列表）
函数 构建用户提示(
    包名: &文本,
    语言代码: &文本,
    批: &[接口条目],
) -> 字符串 {
    让 接口列表 = 批
        .迭代()
        .映射(|条目值| 格式化!("- {} {}", 条目值.种类.取展示名(), 条目值.签名))
        .收集::<向量<_>>()
        .连接("\n");
    如果 语言代码 == "zh" {
        格式化!(
            "crate: {}\n公开 API 列表（名称 + 类型签名）：\n{}",
            包名, 接口列表
        )
    } 否则 {
        格式化!(
            "crate: {}\nPublic API list (name + type signature):\n{}",
            包名, 接口列表
        )
    }
}

/// 调用 OpenAI 兼容端点生成中文名与解释，返回 (中文名→英文名, 中文名→解释)
///
/// 只发送 API 英文名与类型签名；长映射按 [`智能批大小`] 分批调用后合并
/// （单次调用的输出会超模型上限）；任一批失败整体返回错误，由上层回退规则模式。
公开 函数 调用智能生成映射(
    包名: &文本,
    语言代码: &文本,
    条目们: &[接口条目],
) -> 错误处理::结果<(哈希映射<字符串, 字符串>, 哈希映射<字符串, 字符串>)> {
    让 系统提示 = 如果 语言代码 == "zh" {
        智能提示中文
    } 否则 {
        智能提示英文
    };
    让 界面表 = 包::界面::界面消息表::全局表();
    让 批们: 向量<&[接口条目]> = 条目们.分块(智能批大小).收集();
    让 可变 标识符映射 = 哈希映射::新建();
    让 可变 解释映射 = 哈希映射::新建();
    对于 (批序号, 批) 在 批们.迭代().枚举() {
        打印行!(
            "{}",
            界面表.取带参消息(
                "mg_ai_batch_progress",
                &[&(批序号 + 1).转字符串(), &批们.长度().转字符串()]
            )
        );
        让 用户提示 = 构建用户提示(包名, 语言代码, 批);
        让 内容 = 智能对话(系统提示, &用户提示)?;
        // 只接受本批条目中的英文名（防止 AI 幻觉改名）
        让 合法英文名: 哈希集合<字符串> =
            批.迭代().映射(|条目值| 条目值.英文名.克隆值()).收集();
        让 (批标识符, 批解释) =
            解析智能结果(&内容, &合法英文名)?;
        标识符映射.扩展(批标识符);
        解释映射.扩展(批解释);
    }
    成功((标识符映射, 解释映射))
}

/// 解析 AI 返回的 TOML 文本为 (中文名→英文名, 中文名→解释)；
/// 英文名不在合法集合中的条目丢弃（防止 AI 幻觉改名）
///
/// 严格 TOML 解析失败时（AI 偶发输出重复节头等不规范内容）回退逐行宽松
/// 扫描抢救可辨识条目；抢救不到任何内容时仍返回原始解析错误。
公开 函数 解析智能结果(
    文本内容: &文本,
    合法英文名: &哈希集合<字符串>,
) -> 错误处理::结果<(哈希映射<字符串, 字符串>, 哈希映射<字符串, 字符串>)> {
    // 清洗：去掉 ```toml 围栏与前后杂讯，只保留第一个 [ 开始、结尾围栏之前的部分
    让 起点 = 文本内容
        .查找('[')
        .缺值转错(|| 错误处理::错误处理!("{}", 包::界面::界面消息表::全局表().取消息("mg_err_ai_no_toml")))?;
    让 终点 = 文本内容[起点..]
        .查找("```")
        .映射(|位置值| 起点 + 位置值)
        .解包或用(文本内容.长度());
    让 映射片段 = &文本内容[起点..终点];
    让 表值 = 匹配 TOML处理::解析字符串::<TOML处理::TOML值>(映射片段) {
        成功(表值) => 表值,
        错误(严格错误) => {
            让 抢救结果 = 宽松解析各节(映射片段);
            如果 抢救结果.是否为空() {
                返回 错误(错误处理::错误处理!(
                    "{}",
                    包::界面::界面消息表::全局表().取带参消息("mg_err_ai_toml_parse", &[&严格错误.转字符串()])
                ));
            }
            TOML处理::TOML值::表格(抢救结果)
        }
    };
    成功(从表提取各节(&表值, 合法英文名))
}

/// 从 {标识符, 解释} 表过滤合法条目：标识符需英文名在合法集合内，
/// 解释逐条校验长度（超 40 字打印警告）；严格与宽松两条解析路径共用
函数 从表提取各节(
    表值: &TOML处理::TOML值,
    合法英文名: &哈希集合<字符串>,
) -> (哈希映射<字符串, 字符串>, 哈希映射<字符串, 字符串>) {
    让 可变 标识符映射 = 哈希映射::新建();
    让 可变 解释映射 = 哈希映射::新建();
    如果让 有值(节值) = 表值.截取("标识符").而后映射(TOML处理::TOML值::作为表格) {
        对于 (中文名, 值) 在 节值 {
            如果让 有值(英文名) = 值.作为字符串()
                && 合法英文名.包含(英文名)
                && !中文名.是否为空()
            {
                标识符映射.置入(中文名.克隆值(), 英文名.转字符串());
            }
        }
    }
    如果让 有值(节值) = 表值.截取("解释").而后映射(TOML处理::TOML值::作为表格) {
        对于 (中文名, 值) 在 节值 {
            如果让 有值(解释) = 值.作为字符串()
                && !解释.是否为空()
            {
                如果 解释.逐字符().计数() > 40 {
                    错误打印行!(
                        "{}",
                        包::界面::界面消息表::全局表().取带参消息(
                            "mg_warn_ai_explain_long",
                            &[&解释.逐字符().计数().转字符串(), 中文名]
                        )
                    );
                }
                解释映射.置入(中文名.克隆值(), 解释.转字符串());
            }
        }
    }
    (标识符映射, 解释映射)
}

/// 宽松逐行扫描 AI 输出：识别含"标识符"/"解释"的节头（容忍重复出现，
/// 同名节内容合并），节内解析 `"键" = "值"` 行；返回重新组装的表值
/// （仅含实际出现的节），供与严格解析相同的过滤路径复用
函数 宽松解析各节(映射片段: &文本) -> TOML处理::表格 {
    让 可变 节名: 选项<&文本> = 无;
    让 可变 标识符表 = TOML处理::表格::新建();
    让 可变 解释表 = TOML处理::表格::新建();
    对于 行文本 在 映射片段.逐行() {
        让 裁剪行 = 行文本.裁剪();
        如果 裁剪行.以开头('[') {
            // 节头判定放宽到"包含"：容忍多余空格/引号/围栏残缺
            节名 = 如果 裁剪行.包含("标识符") {
                有值("标识符")
            } 否则 如果 裁剪行.包含("解释") {
                有值("解释")
            } 否则 {
                无
            };
            继续;
        }
        让 有值(当前节) = 节名 否则 {
            继续;
        };
        让 有值((键, 值)) = 拆分键值(裁剪行) 否则 {
            继续;
        };
        如果 当前节 == "标识符" {
            标识符表.置入(键, TOML处理::TOML值::字符串值(值));
        } 否则 {
            解释表.置入(键, TOML处理::TOML值::字符串值(值));
        }
    }
    让 可变 表值 = TOML处理::表格::新建();
    如果 !标识符表.是否为空() {
        表值.置入("标识符".转字符串(), TOML处理::TOML值::表格(标识符表));
    }
    如果 !解释表.是否为空() {
        表值.置入("解释".转字符串(), TOML处理::TOML值::表格(解释表));
    }
    表值
}

/// 解析 `"键" = "值"` 行；无等号或键/值为空时返回空值
函数 拆分键值(行文本: &文本) -> 选项<(字符串, 字符串)> {
    让 (原始键, 原始值) = 行文本.分割一次('=')?;
    有值((提取片段(原始键)?, 提取片段(原始值)?))
}

/// 提取片段内容：优先取引号（半/全角）内文本，未加引号时取 `#` 前文本；
/// 内容为空返回空值
函数 提取片段(原始文本: &文本) -> 选项<字符串> {
    让 裁剪文本 = 原始文本.裁剪();
    对于 (左引号, 右引号) 在 [('"', '"'), ('\'', '\''), ('“', '”'), ('「', '」')] {
        如果让 有值(去引文本) = 裁剪文本.去前缀(左引号) {
            让 内部 = 去引文本
                .分割一次(右引号)
                .映射或默认(去引文本, |(前段, _)| 前段)
                .裁剪();
            返回 (!内部.是否为空()).然后(|| 内部.转字符串());
        }
    }
    让 平文本 = 裁剪文本.分割('#').下一个().解包或用(裁剪文本).裁剪();
    (!平文本.是否为空()).然后(|| 平文本.转字符串())
}

/// 检测系统语言（用于 --lang 缺省值）：完整支持全部内置语言，默认 "zh"
///
/// 实现见 [`包::界面::探测系统语言`]（读取 LC_ALL / LC_MESSAGES / LANG）。
公开 函数 探测系统语言() -> 字符串 {
    包::界面::探测系统语言()
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;
    使用 包::映射生成::接口种类;

    /// 环境变量假象器：把键值表包成读取闭包，单测不碰真实进程环境
    /// （进程级环境改动会与并行其它测试互相干扰）
    函数 假环境(环境条目: &[(&文本, &文本)]) -> 实现 闭包特征(&文本) -> 选项<字符串> {
        让 表: 标准库::集合::哈希映射<字符串, 字符串> = 环境条目
            .迭代()
            .映射(|(键, 值)| (键.转字符串(), 值.转字符串()))
            .收集();
        移动 |键| 表.截取(键).克隆副本()
    }

    /// 默认端点下的配置与密钥回退链
    #[测试]
    函数 测试解析端点默认深度求索() {
        让 端点 = 解析端点(&假环境(&[("DEEPSEEK_API_KEY", "sk-d")])).解包();
        断言相等!(端点.基础地址, 默认基础地址);
        断言相等!(端点.模型, 默认模型);
        断言相等!(端点.接口密钥, "sk-d");
        断言相等!(端点.密钥变量名, "DEEPSEEK_API_KEY");
        断言!(!端点.自定义);

        // 统一前缀的变量优先于历史变量
        让 端点 = 解析端点(&假环境(&[
            ("RZ_AI_API_KEY", "sk-rz"),
            ("DEEPSEEK_API_KEY", "sk-d"),
            ("RZ_AI_MODEL", "deepseek-reasoner"),
        ]))
        .解包();
        断言相等!(端点.接口密钥, "sk-rz");
        断言相等!(端点.密钥变量名, "RZ_AI_API_KEY");
        断言相等!(端点.模型, "deepseek-reasoner");

        // 用旧变量名配的自定义端点同样算自定义（按最终端点判定，不按变量名）
        让 端点 = 解析端点(&假环境(&[
            ("DEEPSEEK_BASE_URL", "https://mirror.example/v1"),
            ("OPENAI_API_KEY", "sk-o"),
        ]))
        .解包();
        断言!(端点.自定义);
        断言相等!(端点.密钥变量名, "OPENAI_API_KEY");
    }

    /// 安全约束：默认端点绝不读 OPENAI_API_KEY（不把别家密钥发往 DeepSeek）
    #[测试]
    函数 测试解析端点不泄露开放智能密钥() {
        让 错误值 = 解析端点(&假环境(&[("OPENAI_API_KEY", "sk-o")])).取错误值();
        断言!(
            错误值.转字符串().包含("RZ_AI_API_KEY"),
            "应提示主密钥变量：{错误值}"
        );
        // 自定义端点才启用 OPENAI_API_KEY，且优先于 DEEPSEEK_API_KEY
        让 端点 = 解析端点(&假环境(&[
            ("RZ_AI_BASE_URL", "https://api.openai.com/v1"),
            ("OPENAI_API_KEY", "sk-o"),
            ("DEEPSEEK_API_KEY", "sk-d"),
        ]))
        .解包();
        断言!(端点.自定义);
        断言相等!(端点.接口密钥, "sk-o");
        断言相等!(端点.密钥变量名, "OPENAI_API_KEY");
        断言相等!(
            对话地址(&端点.基础地址),
            "https://api.openai.com/v1/chat/completions"
        );
    }

    /// 密钥/端点为空串时点名变量，不拿空值去请求
    #[测试]
    函数 测试解析端点点名问题变量() {
        让 错误值 = 解析端点(&假环境(&[("RZ_AI_API_KEY", "")])).取错误值();
        断言!(错误值.转字符串().包含("RZ_AI_API_KEY"), "{错误值}");
        // 空串不阻断回退：主变量为空、历史变量可用时照旧能跑
        让 端点 = 解析端点(&假环境(&[
            ("RZ_AI_API_KEY", ""),
            ("DEEPSEEK_API_KEY", "sk-d"),
        ]))
        .解包();
        断言相等!(端点.密钥变量名, "DEEPSEEK_API_KEY");
        // 空白端点视为未设置，不拼出只补后缀的废 URL
        让 端点 = 解析端点(&假环境(&[
            ("RZ_AI_BASE_URL", "   "),
            ("DEEPSEEK_API_KEY", "sk-d"),
        ]))
        .解包();
        断言相等!(端点.基础地址, 默认基础地址);
    }

    /// chat/completions 拼接：带 /v1 与不带、已带后缀、结尾斜杠均能跑
    #[测试]
    函数 测试对话地址形态() {
        断言相等!(
            对话地址("https://api.deepseek.com"),
            "https://api.deepseek.com/chat/completions"
        );
        断言相等!(
            对话地址("http://localhost:11434/v1/"),
            "http://localhost:11434/v1/chat/completions"
        );
        断言相等!(
            对话地址("https://x.example/v1/chat/completions"),
            "https://x.example/v1/chat/completions"
        );
    }

    /// 服务商别名归一：三种写法同一条链路，规则为离线，其余报空值
    #[测试]
    函数 测试解析服务商别名() {
        对于 别名 在 ["deepseek", "openai", "compatible"] {
            断言相等!(解析服务商(别名), 有值(服务商::智能), "{别名}");
        }
        断言相等!(解析服务商("rule"), 有值(服务商::规则));
        断言相等!(解析服务商("deeepseek"), 无);
        断言相等!(解析服务商(""), 无);
    }

    #[测试]
    函数 测试解析智能结果() {
        让 合法英文名: 哈希集合<字符串> = ["new", "Error", "Context"]
            .迭代()
            .映射(|词| 词.转字符串())
            .收集();
        让 文本内容 = "好的，以下是映射：\n```toml\n[\"标识符\"]\n\"新建\" = \"new\"\n\"错误\" = \"Error\"\n\"幻觉\" = \"NotExist\"\n\n[\"解释\"]\n\"新建\" = \"创建一个新的实例，非常简单\"\n\"错误\" = \"描述错误信息的类型\"\n```\n";
        让 (标识映射, 解释) = 解析智能结果(文本内容, &合法英文名).期望("应能解析");
        断言!(标识映射.包含键("新建"));
        断言!(标识映射.包含键("错误"));
        // 幻觉条目（英文名不在合法集合）被丢弃
        断言!(!标识映射.包含键("幻觉"));
        断言相等!(
            解释.截取("新建").映射(字符串::作为文本切片),
            有值("创建一个新的实例，非常简单")
        );
    }

    /// 分批请求的提示词只包含本批条目，语言开关选择正确模板
    #[测试]
    函数 测试构建用户提示按批() {
        让 条目们 = 向量![
            接口条目 {
                种类: 接口种类::函数项,
                英文名: "new".转字符串(),
                签名: "fn new() -> Self".转字符串(),
            },
            接口条目 {
                种类: 接口种类::结构体项,
                英文名: "Window".转字符串(),
                签名: "struct Window".转字符串(),
            },
        ];
        让 中文提示 = 构建用户提示("tauri", "zh", &条目们);
        断言!(中文提示.包含("crate: tauri"));
        断言!(中文提示.包含("fn new() -> Self"));
        断言!(中文提示.包含("struct Window"));
        让 单个提示 = 构建用户提示("tauri", "zh", &条目们[..1]);
        断言!(单个提示.包含("fn new() -> Self"));
        断言!(!单个提示.包含("struct Window"), "不应包含其他批的条目");
        让 英文提示 = 构建用户提示("tauri", "ru", &条目们[..1]);
        断言!(英文提示.包含("Public API list"));
    }

    #[测试]
    函数 测试智能结果非映射错误() {
        让 合法英文名 = 哈希集合::新建();
        断言!(解析智能结果("抱歉，我无法完成。", &合法英文名).是否为错误());
    }

    /// AI 偶发重复节头（两次 ["解释"] 等）：严格 TOML 解析必然失败，
    /// 宽松扫描应合并重复节并抢救出全部条目
    #[测试]
    函数 测试解析智能结果重复节() {
        让 合法英文名: 哈希集合<字符串> = ["new", "Error"]
            .迭代()
            .映射(|词| 词.转字符串())
            .收集();
        让 文本内容 = "```toml\n[\"标识符\"]\n\"新建\" = \"new\"\n[\"标识符\"]\n\"错误\" = \"Error\"\n[\"解释\"]\n\"新建\" = \"创建实例\"\n[\"解释\"]\n\"错误\" = \"错误类型\"\n```\n";
        让 (标识映射, 解释) = 解析智能结果(文本内容, &合法英文名).期望("宽松解析应能抢救");
        断言相等!(标识映射.长度(), 2, "重复标识符节应合并");
        断言相等!(
            解释.截取("错误").映射(字符串::作为文本切片),
            有值("错误类型"),
            "重复解释节应合并"
        );
    }

    /// 完全无法抢救（无可用节与键值对）时保留严格解析的原始错误
    #[测试]
    函数 测试解析智能结果无法解析保留错误() {
        让 合法英文名 = 哈希集合::新建();
        让 文本内容 = "[标题]\n- 列表项，没有任何键值对\n";
        让 错误值 = 解析智能结果(文本内容, &合法英文名).期望错误("应保留解析错误");
        断言!(
            错误值.转字符串().包含("TOML parse error"),
            "应含 toml crate 原始错误: {}",
            错误值
        );
    }

    #[测试]
    函数 测试探测系统语言() {
        // 系统语言完全由环境变量决定：临时接管清除 LC_ALL / LC_MESSAGES / LANG
        // 后逐个设定确定性断言。直接读真实环境断言会因 CI 平台区域设置差异
        // 假失败（苹果系统执行器预设英文，此前断言中文/俄文即因此挂掉）
        让 _锁 = 包::语言管理::测试模块::环境锁();
        让 _环境 = 包::语言管理::测试模块::环境还原::接管(&["LC_ALL", "LC_MESSAGES", "LANG"]);
        不安全 {
            标准库::环境::设置环境变量("LANG", "zh_CN.UTF-8");
        }
        断言相等!(探测系统语言(), "zh", "zh_CN 应识别为 zh");
        不安全 {
            标准库::环境::设置环境变量("LANG", "ru_RU.UTF-8");
        }
        断言相等!(探测系统语言(), "ru", "ru_RU 应识别为 ru");
        不安全 {
            标准库::环境::移除环境变量("LANG");
        }
        断言相等!(探测系统语言(), "zh", "无区域设置应回退默认 zh");
    }
}
