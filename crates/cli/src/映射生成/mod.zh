//! 自动映射生成：`rzc mapping auto` 的实现。
//!
//! 流程：在临时项目中把目标包作为依赖，用 `cargo build` 编译后，
//! 通过 `cargo metadata` 定位注册仓库源码，再手动调用 rustdoc 生成 JSON 文档，
//! 解析出公开接口（名称 + 类型签名），最后由智能服务或规则生成中文映射。
//!
//! 法律合规（本项目强制约束）：
//! 1. 只提取接口名称与类型签名（rustdoc JSON 的名称与内部节点字段），
//!    绝不读取文档注释字段；该字段在本模块任何地方都不会被访问。
//! 2. 生成的映射文件不含任何来自原包的文档注释翻译或复制。
//! 3. 解释由智能服务根据接口英文名称和类型签名自行生成；规则模式解释留空。
//! 4. 输出文件头部固定附免责声明（见 [`免责声明文本`]）。
//!
//! 子模块划分（与本文件此前的分段注释一致）：
//! - [`文档抽取`]：rustdoc JSON 解析与签名渲染
//! - [`文档结构`]：工具链（临时项目、元数据、编译、文档生成）
//! - [`规则`]：规则驱动的中文名生成
//! - [`映射输出`]：映射 TOML 构建
//! - [`智能`]：智能服务驱动（深度求索，兼容开放人工智能接口）

公开 模块 智能;
公开 模块 文档结构;
公开 模块 规则;
公开 模块 文档抽取;
公开 模块 映射输出;

公开 使用 智能::{
    服务商, 智能对话, 调用智能生成映射, 探测系统语言, 确保凭据, 解析服务商,
};
公开 使用 规则::{检测关键字冲突, 生成包本地化名, 规则生成本地化名};
公开 使用 文档抽取::提取公开接口;
公开 使用 映射输出::构建映射表;

使用 错误处理::错误上下文特征;
使用 标准库::集合::{哈希集合, 哈希映射};
使用 标准库::文件系统;
使用 标准库::路径::{路径类型, 路径缓冲};

/// 输出文件头部的法律免责声明（按目标语言输出，逐字写入生成文件）
公开 函数 免责声明文本(语言代码: &文本) -> 字符串 {
    包::界面::界面消息表::按语言建表(语言代码).取消息("mapping_disclaimer")
}

/// API 种类（对应需求：函数/结构体/枚举/特征/类型别名/宏/常量）
#[派生(可调试, 可克隆, 可复制, 部分相等, 全等, 哈希)]
公开 枚举 接口种类 {
    /// 函数
    函数项,
    /// 结构体
    结构体项,
    /// 枚举
    枚举项,
    /// 特征
    特征项,
    /// 类型别名
    类型别名项,
    /// 宏
    宏项,
    /// 常量
    常量项,
}

实现 接口种类 {
    /// 显示名（随界面语言变化）
    公开 函数 取展示名(&自我) -> 字符串 {
        让 消息键 = 匹配 自我 {
            自身::函数项 => "mapping_kind_function",
            自身::结构体项 => "mapping_kind_struct",
            自身::枚举项 => "mapping_kind_enum",
            自身::特征项 => "mapping_kind_trait",
            自身::类型别名项 => "mapping_kind_type_alias",
            自身::宏项 => "mapping_kind_macro",
            自身::常量项 => "mapping_kind_const",
        };
        包::界面::界面消息表::全局表().取消息(消息键)
    }
}

/// 提取出的公开 API 条目：只含名称与类型签名（无任何文档内容）
#[派生(可调试, 可克隆)]
公开 结构体 接口条目 {
    /// API 种类
    公开 种类: 接口种类,
    /// 英文原名
    公开 英文名: 字符串,
    /// 类型签名，如 `fn new() -> Result<Self>`、`struct Error`、`const MAX: u32`
    公开 签名: 字符串,
}

/// `--target-version` 校验并转换为 Cargo 版本需求（生成基准锁定）：
///
/// - `x.y.z`（可带 `-预发布` / `+构建` 后缀）→ `=x.y.z` 精确锁定；
/// - `x.y` → `x.y.*`、`x` → `x.*`（该线最新，生产映射建议完整版本号）；
/// - 兼容前导等号与版本字母写法（如 `=2.11.5`）；
/// - 非法输入返回空值（调用方以 `mapping_version_invalid` 提示）。
公开(包) 函数 版本需求(版本文: &文本) -> 选项<字符串> {
    让 版本文 = 版本文.去前缀('=').解包或用(版本文);
    让 版本文 = 版本文
        .去前缀('v')
        .或用否则(|| 版本文.去前缀('V'))
        .解包或用(版本文);
    // 拆出构建(+)与预发布(-)后缀（仅完整 x.y.z 才允许带后缀）
    让 (余文, 构建段) = 匹配 版本文.分割一次('+') {
        有值((前段, 后段)) => (前段, 有值(后段)),
        无 => (版本文, 无),
    };
    让 (核心段, 预发布段) = 匹配 余文.分割一次('-') {
        有值((前段, 后段)) => (前段, 有值(后段)),
        无 => (余文, 无),
    };
    让 段们: 向量<&文本> = 核心段.分割('.').收集();
    让 是否为数字串 =
        |段文本: &文本| !段文本.是否为空() && 段文本.逐字符().全部(|单字| 单字.是数字字符());
    如果 段们.是否为空() || 段们.长度() > 3 || 段们.迭代().任意(|段| !是否为数字串(段)) {
        返回 无;
    }
    // 后缀字符集：字母、数字、点、连字符，且点分段非空（语义版本规范）
    让 后缀有效 = |后缀: &文本| {
        !后缀.是否为空()
            && 后缀.分割('.').全部(|分段| {
                !分段.是否为空()
                    && 分段.逐字符().全部(|单字| 单字.是ASCII字母数字() || 单字 == '-')
            })
    };
    如果 (预发布段.是否为有值() || 构建段.是否为有值()) && 段们.长度() != 3 {
        返回 无;
    }
    如果 预发布段.有值且(|段| !后缀有效(段)) || 构建段.有值且(|段| !后缀有效(段)) {
        返回 无;
    }
    匹配 段们.长度() {
        3 => 有值(格式化!("={}", 版本文)),
        2 => 有值(格式化!("{}.{}.*", 段们[0], 段们[1])),
        _ => 有值(格式化!("{}.*", 段们[0])),
    }
}

/// 智能解释覆盖率（生成后自检）：按最终母语名表统计非空解释。
///
/// 智能服务偶发省略部分条目的解释（同批不同调用间有随机波动），生成后
/// 显式输出覆盖率，便于及时发现缺失并重跑补齐。
函数 解释覆盖率(
    中文名表: &[(字符串, 字符串)],
    解释表: &哈希映射<字符串, 字符串>,
) -> (无符号机器整数, 无符号机器整数) {
    让 覆盖数 = 中文名表
        .迭代()
        .过滤(|(名字, _)| {
            解释表
                .截取(名字)
                .有值且(|文本值| !文本值.是否为空())
        })
        .计数();
    (覆盖数, 中文名表.长度())
}

/// 主入口：`rzc mapping auto`
///
/// - 包名：目标包（已安装或可从官方仓库拉取）
/// - 语言代码：语言包目录名（如中文、俄文），用于冲突检测与默认输出位置
/// - 服务商：深度求索 / 开放人工智能 / 兼容端点（均走开放人工智能兼容链路，调用智能服务）
///   或规则（离线规则模式）
/// - 输出路径：生成文件的写入位置
/// - 目标版本：锁定提取基准版本（`2.11.5` → `=2.11.5` 精确锁定；
///   `2.11` / `2` → 该线最新）；空值时解析最新版（结果不可复现，打印提示）
公开 函数 运行自动生成(
    包名: &文本,
    语言代码: &文本,
    服务商: &文本,
    输出路径: &路径类型,
    目标版本: 选项<&文本>,
) -> 错误处理::结果<空> {
    让 界面表 = 包::界面::界面消息表::按语言建表(语言代码);
    如果 包名.是否为空() {
        错误处理::错误中止!("{}", 界面表.取消息("mapping_crate_empty"));
    }
    如果 !包名
        .逐字符()
        .全部(|单字| 单字.是ASCII字母数字() || 单字 == '-' || 单字 == '_')
    {
        错误处理::错误中止!("{}", 界面表.取带参消息("mapping_crate_invalid", &[包名]));
    }
    // 版本锁定参数校验：非法输入直接报错，避免生成基准被静默放宽
    让 版本需求值 = 匹配 目标版本 {
        有值(版本文) => 匹配 版本需求(版本文) {
            有值(需求值) => 有值(需求值),
            无 => 错误处理::错误中止!("{}", 界面表.取带参消息("mapping_version_invalid", &[版本文])),
        },
        无 => {
            错误打印行!("{}", 界面表.取消息("mapping_version_unlocked"));
            无
        }
    };

    // 服务商参数早校验：拼错的服务商选项不该先跑完文档提取再报错
    让 有值(模式) = 解析服务商(服务商) 否则 {
        错误处理::错误中止!("{}", 界面表.取带参消息("mapping_unknown_provider", &[服务商]));
    };

    打印行!("{}", 界面表.取带参消息("mapping_extracting", &[包名]));
    让 (结构化文档们, 解析版本) =
        文档结构::提取包文档(包名, 版本需求值.作为解引用())?;
    // 薄壳包（转发包，自身只做整批重导出）的公开接口
    // 来自通配重导出链上的依赖包，逐个 JSON 合并提取；
    // 同名接口只保留首个条目（链上包可能导出同名类型）
    让 可变 条目们 = 向量::新建();
    让 可变 已见英文名 = 哈希集合::新建();
    对于 (文档包名, 结构化文档值) 在 &结构化文档们 {
        打印行!("{}", 界面表.取带参消息("mapping_extracting", &[文档包名]));
        对于 条目值 在 提取公开接口(结构化文档值)? {
            如果 已见英文名.置入(条目值.英文名.克隆值()) {
                条目们.推(条目值);
            }
        }
    }
    如果 条目们.是否为空() {
        错误处理::错误中止!("{}", 界面表.取带参消息("mapping_no_api", &[包名]));
    }

    // 统计各类数量
    让 可变 统计表: 哈希映射<接口种类, 无符号机器整数> = 哈希映射::新建();
    对于 条目值 在 &条目们 {
        *统计表.取条目(条目值.种类).或插入(0) += 1;
    }
    让 统计文本 = [
        接口种类::函数项,
        接口种类::结构体项,
        接口种类::枚举项,
        接口种类::特征项,
        接口种类::类型别名项,
        接口种类::常量项,
        接口种类::宏项,
    ]
    .迭代()
    .映射(|种类| {
        格式化!(
            "{} {}",
            统计表.获取(种类).复制值().解包或用(0),
            种类.取展示名()
        )
    })
    .收集::<向量<_>>()
    .连接(如果 语言代码 == "zh" { "、" } 否则 { ", " });
    打印行!(
        "{}",
        界面表.取带参消息(
            "mapping_extracted",
            &[&条目们.长度().转字符串(), &统计文本]
        )
    );
    // rustdoc JSON 格式当前工具链不输出声明式宏定义（官方格式限制），提示用户
    如果 !统计表.包含键(&接口种类::宏项) {
        错误打印行!("{}", 界面表.取消息("mapping_no_macro"));
    }

    // 1. 名称：中文走规则生成中文名，其他语言保留英文原名（智能模式成功后由智能结果覆盖）
    让 可变 中文名表: 向量<(字符串, 字符串)> = 向量::新建();
    让 可变 已用中文名 = 哈希集合::新建();
    对于 条目值 在 &条目们 {
        让 中文名 = 规则生成本地化名(语言代码, &条目值.英文名);
        如果 !已用中文名.置入(中文名.克隆值()) {
            错误打印行!(
                "{}",
                界面表.取带参消息(
                    "mapping_name_conflict",
                    &[&中文名, &条目值.英文名]
                )
            );
            继续;
        }
        中文名表.推((中文名, 条目值.英文名.克隆值()));
    }

    // 2. 解释：智能模式调用服务商，失败或无配置回退规则模式（解释留空）
    让 可变 解释表: 哈希映射<字符串, 字符串> = 哈希映射::新建();
    匹配 模式 {
        服务商::智能 => {
            匹配 调用智能生成映射(包名, 语言代码, &条目们) {
                成功((智能标识符们, 智能解释们)) => {
                    // 智能中文名覆盖规则名（校验英文名合法性，防止智能服务幻觉改名）
                    对于 (中文名, 英文名) 在 智能标识符们 {
                        // 先采集智能解释：即使名字与规则名重复（常见情形），
                        // 解释也不应丢弃
                        如果让 有值(解释) = 智能解释们.截取(&中文名)
                            && !解释.是否为空()
                        {
                            解释表.置入(中文名.克隆值(), 解释.克隆值());
                        }
                        如果 中文名表
                            .迭代()
                            .任意(|(名字, _)| 名字 == &中文名)
                        {
                            继续;
                        }
                        如果让 有值(位置值) = 中文名表
                            .迭代()
                            .取位置(|(_, 英文)| 英文 == &英文名)
                        {
                            中文名表.移除(位置值);
                            中文名表.推((中文名.克隆值(), 英文名));
                        }
                    }
                    打印行!("{}", 界面表.取带参消息("mapping_ai_success", &[服务商]));
                    // 解释覆盖率自检：缺失时显式警告（智能服务偶发省略条目）
                    让 (覆盖数, 总数) =
                        解释覆盖率(&中文名表, &解释表);
                    如果 覆盖数 < 总数 {
                        错误打印行!(
                            "{}",
                            界面表.取带参消息(
                                "mapping_ai_coverage_missing",
                                &[
                                    &覆盖数.转字符串(),
                                    &总数.转字符串(),
                                    &(总数 - 覆盖数).转字符串()
                                ]
                            )
                        );
                    } 否则 {
                        打印行!(
                            "{}",
                            界面表.取带参消息(
                                "mapping_ai_coverage",
                                &[&覆盖数.转字符串(), &总数.转字符串()]
                            )
                        );
                    }
                }
                错误(错误值) => {
                    错误打印行!(
                        "{}",
                        界面表.取带参消息(
                            "mapping_ai_fallback",
                            &["RZ_AI_API_KEY / DEEPSEEK_API_KEY", &错误值.转字符串()]
                        )
                    );
                }
            }
        }
        服务商::规则 => {
            错误打印行!("{}", 界面表.取消息("mapping_rule_mode"));
        }
    }

    // 3. 输出 TOML
    让 包中文名 = 生成包本地化名(语言代码, 包名);
    让 映射文本 = 构建映射表(
        语言代码,
        包名,
        &包中文名,
        解析版本.作为解引用(),
        &条目们,
        &中文名表,
        &解释表,
    );

    // 4. 冲突检测：词法转译（关键字映射）先于别名替换执行，冲突的中文名生成后不会生效；
    // 语言包目录优先从输出路径推导（…/<lang>/crates/<crate>.toml 的上两级），
    // 推导失败时回退当前目录的项目语言包根（主仓库为 crates/engine/lang-packs/）
    让 语言包目录 = 输出路径
        .父目录()
        .而后映射(|路径值| 路径值.父目录())
        .过滤(|目录值| 目录值.连接("keywords.toml").存在())
        .映射(|目录值| 目录值.转路径缓冲())
        .解包或用否则(|| {
            标准库::环境::当前目录()
                .映射(|工作目录| 包::语言包根目录(&工作目录).连接(语言代码))
                .解包或用否则(|_| 路径缓冲::从(格式化!("lang-packs/{}", 语言代码)))
        });
    对于 (中文名, 关键字英文, 本项英文) 在
        检测关键字冲突(&语言包目录, &中文名表)
    {
        错误打印行!(
            "{}",
            界面表.取带参消息(
                "mapping_keyword_conflict",
                &[&中文名, &中文名, &关键字英文, &本项英文]
            )
        );
    }

    // 目标文件已存在时给出覆盖警告（防止静默覆盖手工调整过的映射）
    如果 输出路径.存在() {
        错误打印行!(
            "{}",
            界面表.取带参消息(
                "mapping_overwrite_warn",
                &[&输出路径.展示().转字符串()]
            )
        );
    }
    如果让 有值(父路径) = 输出路径.父目录() {
        文件系统::创建所有目录(父路径)
            .带错误上下文(|| 界面表.取带参消息("mg_err_mkdir", &[&父路径.展示().转字符串()]))?;
    }
    文件系统::写入(输出路径, 映射文本)
        .带错误上下文(|| 界面表.取带参消息("mg_err_write", &[&输出路径.展示().转字符串()]))?;
    打印行!(
        "{}",
        界面表.取带参消息("mapping_generated", &[&输出路径.展示().转字符串()])
    );
    打印行!(
        "{}",
        界面表.取带参消息(
            "mapping_crate_name_line",
            &[&包中文名, &包中文名, 包名]
        )
    );
    打印行!("{}", 界面表.取带参消息("mapping_usage_hint", &[语言代码]));
    成功(())
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::{解释覆盖率, 运行自动生成, 版本需求};
    使用 标准库::集合::哈希映射;

    /// 完整三段版本 → `=x.y.z` 精确锁定；兼容 =/v 前导与预发布/构建后缀
    #[测试]
    函数 测试版本需求精确() {
        断言相等!(版本需求("2.11.5").作为解引用(), 有值("=2.11.5"));
        断言相等!(版本需求("=2.11.5").作为解引用(), 有值("=2.11.5"));
        断言相等!(版本需求("v2.11.5").作为解引用(), 有值("=2.11.5"));
        断言相等!(
            版本需求("3.0.0-alpha.0").作为解引用(),
            有值("=3.0.0-alpha.0")
        );
        断言相等!(
            版本需求("1.0.0+build.7").作为解引用(),
            有值("=1.0.0+build.7")
        );
    }

    /// 一段/两段版本 → 该线最新（前缀锁定）
    #[测试]
    函数 测试版本需求前缀线() {
        断言相等!(版本需求("2.11").作为解引用(), 有值("2.11.*"));
        断言相等!(版本需求("2").作为解引用(), 有值("2.*"));
    }

    /// 非法输入一律为空值（由调用方给出非法版本提示）
    #[测试]
    函数 测试版本需求非法() {
        对于 坏值 在 [
            "",
            " ",
            "abc",
            "2.11.*",
            "2.11.5.6",
            "2..5",
            "2.11.5 x",
            "-1.0.0",
            "2.11.5-",
            "2.11.5-alpha..1",
            "v",
            "=",
        ] {
            断言相等!(版本需求(坏值), 无, "应判非法: {坏值:?}");
        }
    }

    /// 解释覆盖率：空串解释不计入；空表安全返回 (0, 0)
    #[测试]
    函数 测试解释覆盖率() {
        让 表 = 向量![
            ("新建".转字符串(), "new".转字符串()),
            ("错误".转字符串(), "Error".转字符串()),
            ("状态".转字符串(), "State".转字符串()),
        ];
        让 可变 解释表 = 哈希映射::新建();
        解释表.置入("新建".转字符串(), "创建新对象。".转字符串());
        解释表.置入("错误".转字符串(), 字符串::新建());
        断言相等!(解释覆盖率(&表, &解释表), (1, 3));
        解释表.置入("错误".转字符串(), "错误类型。".转字符串());
        解释表.置入("状态".转字符串(), "状态值。".转字符串());
        断言相等!(解释覆盖率(&表, &解释表), (3, 3));
        断言相等!(解释覆盖率(&[], &解释表), (0, 0));
    }

    /// 入参非法时在任何网络/提包动作之前直接报错返回，且不落盘任何文件
    #[测试]
    函数 测试运行自动生成先校验后联网() {
        让 目录值 = 临时文件::建临时目录().解包();
        让 输出文件 = 目录值.条目路径().连接("out.toml");
        // 空包名
        断言!(运行自动生成("", "zh", "rule", &输出文件, 无).是否为错误());
        // 名字含路径穿越/空格等非法字符
        断言!(运行自动生成("../evil name", "zh", "rule", &输出文件, 无).是否为错误());
        // 版本号非法（空值之外才会在此报错；合法版本随后才进入提包网络流程）
        断言!(运行自动生成("serde", "zh", "rule", &输出文件, 有值("abc")).是否为错误());
        断言!(运行自动生成("serde", "zh", "rule", &输出文件, 有值("2.x")).是否为错误());
        断言!(!输出文件.存在(), "校验失败不得产生输出文件");
    }
}
