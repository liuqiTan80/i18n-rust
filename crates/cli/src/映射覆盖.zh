//! 后端源码语料覆盖矩阵（`rzc mapping coverage`）
//!
//! 将仓库内后端真实 Rust 源码（引擎 / 命令行 / 语言服务三方的源码）作为真实语料，
//! 对每个语言包检验「用户写代码时会遇到的名字」的覆盖度，自动列出缺失的母语映射：
//! - 关键字：缺失时用户无法用母语写出该语法结构（错误级）
//! - 接口名（标准库/核心库/分配库路径段、使用导入、首字母大写类型名）：缺失时只能
//!   写英文原名，全母语体验打折（警告级）
//!
//! 用法：在仓库根目录运行 `rzc mapping coverage [--lang <代码>]`（默认全部内置语言）。
//! 语料来自仓库内后端三个包的源码目录；发布版（无源码）环境下不可用，
//! 此命令面向语言包维护者与持续集成门禁。

使用 标准库::集合::哈希映射;
使用 标准库::路径::路径类型;

使用 引擎库::映射源;

/// 一个名字的出现统计（出现次数 + 示例文件）
使用 错误处理::错误处理;

类型 名称统计 = (无符号机器整数, 字符串);

/// 语料提取结果：四类名字 → （出现次数, 示例文件）
#[派生(默认)]
结构体 语料库 {
    /// 关键字
    关键字表: 哈希映射<字符串, 名称统计>,
    /// 标准库/核心库/分配库路径段（模块名与类型名）
    标准库段: 哈希映射<字符串, 名称统计>,
    /// 使用导入的第三方包名
    外部包名: 哈希映射<字符串, 名称统计>,
    /// 首字母大写标识符（类型名，路径链之外）
    类型名: 哈希映射<字符串, 名称统计>,
}

/// Rust 稳定关键字全集（方言母语映射应覆盖；词法器不区分关键字，需自行匹配）
常量 稳定关键字表: &[&文本] = &[
    "as", "break", "const", "continue", "crate", "dyn", "else", "enum", "extern", "false", "fn",
    "for", "if", "impl", "in", "let", "loop", "match", "mod", "move", "mut", "pub", "ref",
    "return", "self", "Self", "static", "struct", "super", "trait", "true", "type", "unsafe",
    "use", "where", "while", "async", "await", "union",
];

实现 语料库 {
    函数 记录(映射表: &可变 哈希映射<字符串, 名称统计>, 包名: &文本, 来源标记: &文本) {
        如果让 有值(统计项) = 映射表.获取可变(&包名.转字符串()) {
            统计项.0 += 1;
        } 否则 {
            映射表.置入(包名.转字符串(), (1, 来源标记.转字符串()));
        }
    }
}

/// 收集仓库内后端源码（引擎、命令行、语言服务三方的源码目录），返回（相对路径, 内容）
函数 收集后端源码(根目录: &路径类型) -> 向量<(字符串, 字符串)> {
    让 可变 文件清单 = 向量::新建();
    对于 目录名 在 ["engine", "cli", "lsp"] {
        让 源目录 = 根目录.连接("crates").连接(目录名).连接("src");
        让 成功(目录项流) = 标准库::文件系统::读取目录(&源目录) 否则 {
            继续;
        };
        对于 目录条目 在 目录项流.展平() {
            让 路径值 = 目录条目.条目路径();
            如果 路径值.取扩展名().而后映射(|后缀| 后缀.取字符串引用()) != 有值("rs") {
                继续;
            }
            如果让 成功(内容文本) = 标准库::文件系统::读取全部字符串(&路径值) {
                文件清单.推入((
                    格式化!(
                        "crates/{}/src/{}",
                        目录名,
                        路径值.取文件名().取值或默认().转有损字符串()
                    ),
                    内容文本,
                ));
            }
        }
    }
    文件清单.排序();
    文件清单
}

/// 下一个非空白词元的种类（词法器将 `::` 拆为两个冒号，中间允许空白）
函数 下一非空白种类(
    令牌们: &[词法解析器::词法令牌],
    起点位: 无符号机器整数,
) -> 选项<词法解析器::令牌种类> {
    令牌们[起点位..]
        .迭代()
        .映射(|令牌| 令牌.令牌类别)
        .查找(|种类值| *种类值 != 词法解析器::令牌种类::空白符)
}

/// 前一个非空白词元的种类（起点位为当前词元索引）
函数 前一非空白种类(
    令牌们: &[词法解析器::词法令牌],
    起点位: 无符号机器整数,
) -> 选项<词法解析器::令牌种类> {
    令牌们[..起点位]
        .迭代()
        .逆序()
        .映射(|令牌| 令牌.令牌类别)
        .查找(|种类值| *种类值 != 词法解析器::令牌种类::空白符)
}

/// 从单个源文件提取语料名字（单遍词法器扫描，无语法树依赖）
///
/// 状态机：
/// - `使用中`：使用语句内（到 `;` 结束）
/// - `路径模式`：当前 `::` 路径链（含暂存的首段）；
///   标识符先暂存进链，遇到 `::` 才确认是路径（否则按普通标识符处理）
/// - 使用内的 `as X` 别名跳过；内部路径（包、父模块、自身）忽略
函数 从源码提取名称(来源标记: &文本, 源文本: &文本, 语料: &可变 语料库) {
    让 令牌们: 向量<词法解析器::词法令牌> = 词法解析器::切分令牌(源文本).收集();
    // 逐词元的字节偏移（词法器词法流覆盖全源，偏移连续）
    让 可变 偏移们: 向量<无符号机器整数> = 向量::带容量(令牌们.长度());
    让 可变 累计 = 0;
    对于 令牌 在 &令牌们 {
        偏移们.推入(累计);
        累计 += 令牌.令牌长度;
    }

    让 可变 使用中 = 假;
    让 可变 路径链: 向量<字符串> = 向量::新建();
    让 可变 路径模式 = 假;
    让 可变 跳过下一使用标识 = 假;

    对于 (序号, 令牌) 在 令牌们.迭代().枚举() {
        让 文本串 = &源文本[偏移们[序号]..偏移们[序号] + 令牌.令牌长度];
        匹配 令牌.令牌类别 {
            词法解析器::令牌种类::标识符记号 => {
                如果 稳定关键字表.包含(&文本串) {
                    匹配 文本串 {
                        "use" 如果 !使用中 => {
                            使用中 = 真;
                            路径链.清空();
                            路径模式 = 假;
                        }
                        "as" 如果 使用中 => {
                            跳过下一使用标识 = 真;
                        }
                        // 内部路径首段（包、父模块、自身加双冒号）：入链整体忽略，
                        // 避免包名被冲刷后其后的内部模块名误入外部包名表；
                        // 单独出现的自身仍按普通关键字处理
                        "crate" | "super" | "self" | "Self"
                            如果 下一非空白种类(&令牌们, 序号 + 1)
                                == 有值(词法解析器::令牌种类::冒号) =>
                        {
                            路径链.推入(文本串.转字符串());
                            路径模式 = 假;
                        }
                        // 普通关键字：结束当前链
                        _ => {
                            如果 !使用中
                                && !["crate", "super", "self", "Self"].包含(&文本串)
                            {
                                语料库::记录(&可变 语料.关键字表, 文本串, 来源标记);
                            }
                            冲刷路径链(&可变 路径链, 路径模式, 使用中, 语料, 来源标记);
                            使用中 = 假;
                            路径模式 = 假;
                        }
                    }
                } 否则 如果 跳过下一使用标识 {
                    跳过下一使用标识 = 假;
                    路径链.清空();
                    路径模式 = 假;
                } 否则 如果 使用中 || 路径模式 {
                    路径链.推入(文本串.转字符串());
                } 否则 {
                    // 暂存：等下一个词元决定是路径链还是普通标识符
                    路径链.推入(文本串.转字符串());
                    路径模式 = 假;
                }
            }
            词法解析器::令牌种类::冒号 => {
                // 词法器将 `::` 拆为两个冒号（中间允许空白）：
                // 第一半前瞻下一个非空白仍是冒号；第二半（前一个非空白
                // 是冒号）保持路径链，仅单冒号（类型标注等）结束当前链
                让 前是冒号 = 前一非空白种类(&令牌们, 序号)
                    == 有值(词法解析器::令牌种类::冒号);
                让 后是冒号 = 下一非空白种类(&令牌们, 序号 + 1)
                    == 有值(词法解析器::令牌种类::冒号);
                如果 前是冒号 {
                    // `::` 第二半：路径链继续（路径模式已由第一半设置）
                } 否则 如果 后是冒号 {
                    路径模式 = 真;
                } 否则 {
                    // 单个冒号（类型标注等）：结束当前链
                    冲刷路径链(&可变 路径链, 路径模式, 使用中, 语料, 来源标记);
                    路径模式 = 假;
                }
            }
            词法解析器::令牌种类::分号 => {
                冲刷路径链(&可变 路径链, 路径模式, 使用中, 语料, 来源标记);
                使用中 = 假;
                路径模式 = 假;
            }
            _ => {
                // 其他词元：结束当前链；若链中只有一个暂存标识符，按普通标识符处理
                冲刷路径链(&可变 路径链, 路径模式, 使用中, 语料, 来源标记);
                路径模式 = 假;
            }
        }
    }
    冲刷路径链(&可变 路径链, 路径模式, 使用中, 语料, 来源标记);
}

/// 结束当前路径链：按使用/非使用与首段归属分类记录到语料
函数 冲刷路径链(
    路径链: &可变 向量<字符串>,
    路径模式: 布尔,
    使用中: 布尔,
    语料: &可变 语料库,
    来源标记: &文本,
) {
    如果 路径链.是否为空() {
        返回;
    }
    // 非路径链的单个暂存标识符：首字母大写且非单字符 → 类型名
    如果 !路径模式 && !使用中 {
        让 包名 = &路径链[0];
        让 首字 = 包名.逐字符().下一个().取值或('a');
        如果 首字.是否为大写() && 包名.长度() > 1 {
            语料库::记录(&可变 语料.类型名, 包名, 来源标记);
        }
        路径链.清空();
        返回;
    }
    让 首段 = &路径链[0];
    让 是内部路径 = ["crate", "super", "self"].包含(&首段.作为文本切片());
    让 是标准库路径 = ["std", "core", "alloc"].包含(&首段.作为文本切片());
    如果 !是内部路径 {
        如果 是标准库路径 || 使用中 {
            // 标准库路径引用 / 使用导入：段全部记录（模块名与类型名）
            对于 段 在 路径链.迭代() {
                如果 是标准库路径 {
                    语料库::记录(&可变 语料.标准库段, 段, 来源标记);
                }
            }
        }
        // 首段（包名）：使用导入或路径引用的第三方包；
        // 惯例上包名小写、类型名大写
        如果 !是标准库路径 {
            让 首字 = 首段.逐字符().下一个().取值或('a');
            如果 首字.是否为大写() {
                语料库::记录(&可变 语料.类型名, 首段, 来源标记);
            } 否则 {
                语料库::记录(&可变 语料.外部包名, 首段, 来源标记);
            }
        }
        // 使用内的非首段：大写段是类型名
        如果 使用中 && !是标准库路径 {
            对于 段 在 路径链.迭代().跳过(1) {
                让 首字 = 段.逐字符().下一个().取值或('a');
                如果 首字.是否为大写() && 段.长度() > 1 {
                    语料库::记录(&可变 语料.类型名, 段, 来源标记);
                }
            }
        }
        // 非使用的第三方路径引用：后续段按类型名/忽略
        如果 !使用中 && !是标准库路径 {
            对于 段 在 路径链.迭代().跳过(1) {
                让 首字 = 段.逐字符().下一个().取值或('a');
                如果 首字.是否为大写() && 段.长度() > 1 {
                    语料库::记录(&可变 语料.类型名, 段, 来源标记);
                }
            }
        }
    }
    路径链.清空();
}

/// 构建语言包反向索引：英文原名 → 母语键
///
/// 合并关键字配置（排除派生特征节，与运行时语义一致）、模块路径配置、
/// 标准库配置、三方库映射的全部映射值；同值多键时保留首个（报告无需区分）。
函数 构建反向索引(
    关键字内容: &文本,
    模块路径内容: &文本,
    标准库内容: &文本,
    三方库数据: &[(&文本, &文本)],
) -> 哈希映射<字符串, 字符串> {
    让 可变 反向表: 哈希映射<字符串, 字符串> = 哈希映射::新建();
    让 置入反向 = |反向表: &可变 哈希映射<字符串, 字符串>, 值项: &文本, 键名: &文本| {
        如果 !值项.是否为空() {
            反向表
                .取条目(值项.转字符串())
                .或用插入(|| 键名.转字符串());
        }
    };
    如果让 成功(各节) = 映射源::解析映射节(关键字内容) {
        对于 (节名, 映射表) 在 &各节 {
            如果 节名 == "派生特征" || 映射源::是否元数据节(节名) {
                继续;
            }
            对于 (键名, 值项) 在 映射表 {
                置入反向(&可变 反向表, 值项, 键名);
            }
        }
    }
    对于 配置文本 在 [模块路径内容, 标准库内容] {
        如果让 成功(各节) = 映射源::解析映射节(配置文本) {
            对于 (节名, 映射表) 在 &各节 {
                如果 映射源::是否元数据节(节名) {
                    继续;
                }
                对于 (键名, 值项) 在 映射表 {
                    置入反向(&可变 反向表, 值项, 键名);
                }
            }
        }
    }
    对于 (_, 内容文本) 在 三方库数据 {
        如果让 成功(各节) = 映射源::解析映射节(内容文本) {
            对于 (节名, 映射表) 在 &各节 {
                如果 映射源::是否元数据节(节名) {
                    继续;
                }
                对于 (键名, 值项) 在 映射表 {
                    置入反向(&可变 反向表, 值项, 键名);
                }
            }
        }
    }
    反向表
}

/// 单个语言包的覆盖报告
公开 结构体 覆盖报告 {
    /// 语言代码
    公开 语言代码: 字符串,
    /// 缺失关键字（错误级）：（名字, 出现次数, 示例文件）
    公开 缺失关键字: 向量<(字符串, 无符号机器整数, 字符串)>,
    /// 缺失标准库段（警告级，用户写代码最常遇到）
    公开 缺失标准库段: 向量<(字符串, 无符号机器整数, 字符串)>,
    /// 缺失第三方包名（警告级，用外部库时需要）
    公开 缺失第三方包: 向量<(字符串, 无符号机器整数, 字符串)>,
    /// 缺失类型名（警告级，多为编译器内部实现，可按需忽略）
    公开 缺失类型: 向量<(字符串, 无符号机器整数, 字符串)>,
    /// 覆盖统计
    公开 总名称数: 无符号机器整数,
    公开 已覆盖数: 无符号机器整数,
}

/// 按出现次数降序排序缺失清单（同次数按名字升序，稳定输出）
函数 排序缺失(列表: &可变 [(字符串, 无符号机器整数, 字符串)]) {
    列表.排序_by(|甲, 乙| 乙.1.比较(&甲.1).然后(甲.0.比较(&乙.0)));
}

/// 用反向索引检测语料覆盖，产出报告
函数 计算覆盖(
    语料: &语料库,
    反向表: &哈希映射<字符串, 字符串>,
    语言代码: &文本,
) -> 覆盖报告 {
    让 可变 报告值 = 覆盖报告 {
        语言代码: 语言代码.转字符串(),
        缺失关键字: 向量::新建(),
        缺失标准库段: 向量::新建(),
        缺失第三方包: 向量::新建(),
        缺失类型: 向量::新建(),
        总名称数: 0,
        已覆盖数: 0,
    };
    // 关键字缺失（错误级）
    对于 (条目名, (次数, 来源标记)) 在 &语料.关键字表 {
        报告值.总名称数 += 1;
        如果 !反向表.包含键(条目名) {
            报告值
                .缺失关键字
                .推入((条目名.克隆值(), *次数, 来源标记.克隆值()));
        } 否则 {
            报告值.已覆盖数 += 1;
        }
    }
    // 接口缺失（警告级）：标准库段 / 外部包 / 类型名分三组
    对于 (条目名, (次数, 来源标记)) 在 &语料.标准库段 {
        报告值.总名称数 += 1;
        如果 !反向表.包含键(条目名) {
            报告值
                .缺失标准库段
                .推入((条目名.克隆值(), *次数, 来源标记.克隆值()));
        } 否则 {
            报告值.已覆盖数 += 1;
        }
    }
    对于 (条目名, (次数, 来源标记)) 在 &语料.外部包名 {
        报告值.总名称数 += 1;
        如果 !反向表.包含键(条目名) {
            报告值
                .缺失第三方包
                .推入((条目名.克隆值(), *次数, 来源标记.克隆值()));
        } 否则 {
            报告值.已覆盖数 += 1;
        }
    }
    对于 (条目名, (次数, 来源标记)) 在 &语料.类型名 {
        报告值.总名称数 += 1;
        如果 !反向表.包含键(条目名) {
            报告值
                .缺失类型
                .推入((条目名.克隆值(), *次数, 来源标记.克隆值()));
        } 否则 {
            报告值.已覆盖数 += 1;
        }
    }
    排序缺失(&可变 报告值.缺失关键字);
    排序缺失(&可变 报告值.缺失标准库段);
    排序缺失(&可变 报告值.缺失第三方包);
    排序缺失(&可变 报告值.缺失类型);
    报告值
}

/// 打印单个语言包的覆盖报告（本地化输出）
函数 打印覆盖报告(报告值: &覆盖报告, 源码数: 无符号机器整数) {
    让 界面表 = 包::界面::界面消息表::全局表();
    打印行!("{}", 界面表.取带参消息("mc_cov_header", &[&报告值.语言代码]));
    让 百分比 = 报告值
        .已覆盖数
        .检查乘(100)
        .而后映射(|数| 数.检查除(报告值.总名称数))
        .取值或(0);
    打印行!(
        "{}",
        界面表.取带参消息(
            "mc_cov_stats",
            &[
                &报告值.已覆盖数.转字符串(),
                &报告值.总名称数.转字符串(),
                &百分比.转字符串(),
                &源码数.转字符串()
            ]
        )
    );
    // 关键字缺失（错误级，最多展示 30 条）
    让 关键字总数 = 报告值.缺失关键字.长度();
    对于 (条目名, 次数, 示例路径) 在 报告值.缺失关键字.迭代().取值(30) {
        打印行!(
            "{}",
            界面表.取带参消息("mc_cov_kw_missing", &[条目名, &次数.转字符串(), 示例路径])
        );
    }
    如果 关键字总数 > 30 {
        打印行!(
            "{}",
            界面表.取带参消息("mc_cov_more", &[&(关键字总数 - 30).转字符串()])
        );
    }
    // 标准库段缺失（警告级，最多展示 25 条）：用户写代码最常遇到，优先补齐
    让 标准库总数 = 报告值.缺失标准库段.长度();
    对于 (条目名, 次数, 示例路径) 在 报告值.缺失标准库段.迭代().取值(25) {
        打印行!(
            "{}",
            界面表.取带参消息("mc_cov_std_missing", &[条目名, &次数.转字符串(), 示例路径])
        );
    }
    如果 标准库总数 > 25 {
        打印行!(
            "{}",
            界面表.取带参消息("mc_cov_more", &[&(标准库总数 - 25).转字符串()])
        );
    }
    // 第三方包缺失（警告级，最多展示 15 条）
    让 第三方总数 = 报告值.缺失第三方包.长度();
    对于 (条目名, 次数, 示例路径) 在 报告值.缺失第三方包.迭代().取值(15) {
        打印行!(
            "{}",
            界面表.取带参消息("mc_cov_crate_missing", &[条目名, &次数.转字符串(), 示例路径])
        );
    }
    如果 第三方总数 > 15 {
        打印行!(
            "{}",
            界面表.取带参消息("mc_cov_more", &[&(第三方总数 - 15).转字符串()])
        );
    }
    // 类型名缺失（警告级，最多展示 15 条；多为编译器内部实现，可按需忽略）
    让 类型总数 = 报告值.缺失类型.长度();
    对于 (条目名, 次数, 示例路径) 在 报告值.缺失类型.迭代().取值(15) {
        打印行!(
            "{}",
            界面表.取带参消息("mc_cov_type_missing", &[条目名, &次数.转字符串(), 示例路径])
        );
    }
    如果 类型总数 > 15 {
        打印行!(
            "{}",
            界面表.取带参消息("mc_cov_more", &[&(类型总数 - 15).转字符串()])
        );
    }
    如果 关键字总数 == 0 {
        打印行!("{}", 界面表.取消息("mc_cov_kw_ok"));
    }
    打印行!();
}

/// 「映射覆盖」命令入口
///
/// - 语言参数为空值：检测全部内置语言
/// - 语言参数为内置语言代码：仅检测该语言
///
/// 返回是否全部语言关键字覆盖（错误级）通过。
公开 函数 运行覆盖检查(语言参数: 选项<&文本>) -> 错误处理::结果<布尔> {
    让 界面表 = 包::界面::界面消息表::全局表();
    // 语料必须来自源码仓库（发布版无后端源码目录结构）
    让 工作目录 =
        标准库::环境::当前目录().映射错误(|错误值| 错误处理!("获取当前目录失败: {}", 错误值))?;
    让 项目根 = 包::查找项目根向上(&工作目录)
        .缺值转错(|| 错误处理!("{}", 界面表.取消息("mc_cov_no_repo")))?;
    让 源码清单 = 收集后端源码(&项目根);
    如果 源码清单.是否为空() {
        错误处理::错误中止!("{}", 界面表.取消息("mc_cov_no_repo"));
    }
    // 提取语料（一次，供所有语言包复用）
    让 可变 语料 = 语料库::默认值();
    对于 (来源标记, 内容文本) 在 &源码清单 {
        从源码提取名称(来源标记, 内容文本, &可变 语料);
    }
    打印行!("{}", 界面表.取消息("mc_cov_corpus_intro"));
    让 语言清单: 向量<&文本> = 匹配 语言参数 {
        有值(单语言) => 向量![单语言],
        无 => 包::内置语言::内置语言清单(),
    };
    让 可变 全部通过 = 真;
    对于 语言代码 在 语言清单 {
        如果 !包::内置语言::有内置语言包(语言代码) {
            错误处理::错误中止!("{}", 界面表.取带参消息("mc_unknown_target", &[语言代码]));
        }
        让 数据 = 包::内置语言::获取内置数据(语言代码);
        让 反向表 = 构建反向索引(
            数据.关键字内容,
            数据.模块路径内容,
            数据.标准库内容,
            数据.三方库数据,
        );
        让 报告值 = 计算覆盖(&语料, &反向表, 语言代码);
        全部通过 &= 报告值.缺失关键字.是否为空();
        打印覆盖报告(&报告值, 源码清单.长度());
    }
    如果 全部通过 {
        打印行!("{}", 界面表.取消息("mc_cov_all_ok"));
    }
    成功(全部通过)
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    /// 单文件语料提取：关键字 / 标准库路径段 / 第三方包 / 类型名
    #[测试]
    函数 测试提取名称基础() {
        让 源码 = r#"
use std::collections::HashMap;
use serde::Serialize;
use crate::toolchain::find_toolchain;

pub fn main() -> Result<(), Box<dyn Error>> {
    let map: HashMap<String, Vec<u8>> = HashMap::new();
    std::fs::read_to_string("x")?;
    ureq::get("https://x").call()?;
    let server = MyServer::new();
    Ok(())
}
"#;
        让 可变 语料 = 语料库::默认值();
        从源码提取名称("t.rs", 源码, &可变 语料);
        // 关键字
        对于 关键字值 在 ["fn", "let", "pub", "dyn"] {
            断言!(语料.关键字表.包含键(关键字值), "缺少关键字 {关键字值}");
        }
        断言!(
            !语料.关键字表.包含键("use"),
            "use 不应作为关键字语料"
        );
        // 标准库路径段
        对于 段 在 ["std", "collections", "HashMap", "fs", "read_to_string"] {
            断言!(语料.标准库段.包含键(段), "缺少标准库段 {段}");
        }
        // 第三方包名
        对于 包名 在 ["serde", "ureq"] {
            断言!(语料.外部包名.包含键(包名), "缺少包 {包名}");
        }
        // 内部路径忽略（引擎包名是外部包，包前缀路径忽略）
        断言!(
            !语料.外部包名.包含键("crate"),
            "包前缀路径不应计入"
        );
        // 类型名：使用段中的大写 + 普通大写标识符
        断言!(语料.类型名.包含键("Serialize"));
        断言!(语料.类型名.包含键("MyServer"));
        断言!(语料.类型名.包含键("Error"), "错误特征的类型名");
        断言!(
            !语料.外部包名.包含键("HashMap"),
            "裸类型构造是类型引用而非包"
        );
        断言!(
            语料.标准库段.包含键("HashMap"),
            "使用路径链中的 HashMap 计入标准库段"
        );
        // 非使用的内部路径调用整体忽略，内部模块名不入外部包名
        让 源码二 = "fn f() { crate::ui::Ui::global(); super::helper::run(); self::x::y(); }\n";
        让 可变 语料二 = 语料库::默认值();
        从源码提取名称("t2.rs", 源码二, &可变 语料二);
        对于 内部段 在 ["ui", "Ui", "helper", "run", "x", "y"] {
            断言!(
                !语料二.外部包名.包含键(内部段) && !语料二.类型名.包含键(内部段),
                "内部路径段 {内部段} 不应计入"
            );
        }
    }

    /// 使用别名与泛型单字符不进入语料
    #[测试]
    函数 测试提取名称别名与泛型() {
        让 源码 = "use std::fmt::Result as FmtResult;\nfn foo<T>(x: T) -> Result<T> { Ok(x) }\n";
        让 可变 语料 = 语料库::默认值();
        从源码提取名称("t.rs", 源码, &可变 语料);
        断言!(!语料.类型名.包含键("FmtResult"), "别名应跳过");
        断言!(!语料.类型名.包含键("T"), "单字符泛型参数不应计入");
        断言!(语料.标准库段.包含键("fmt"));
        断言!(语料.关键字表.包含键("fn"));
        断言!(
            语料.类型名.包含键("Result"),
            "返回类型中的真实类型引用应记录"
        );
    }

    /// 反向索引：合并关键字/标准库/模块路径/三方库的值
    #[测试]
    函数 测试构建反向索引() {
        让 关键字内容 =
            "[\"声明\"]\n\"函数\" = \"fn\"\n\"让\" = \"let\"\n[\"派生特征\"]\n\"调试\" = \"Debug\"\n";
        让 模块路径内容 = "[\"模块路径\"]\n\"标准库\" = \"std\"\n";
        让 标准库内容 = "[\"标识符\"]\n\"字符串\" = \"String\"\n";
        让 三方库数据 = [(
            "serde.toml",
            "[\"模块路径\"]\n\"序列化\" = \"serde\"\n[\"标识符\"]\n\"序列化特征\" = \"Serialize\"\n",
        )];
        让 反向表 = 构建反向索引(关键字内容, 模块路径内容, 标准库内容, &三方库数据);
        断言相等!(反向表.获取("fn").映射(字符串::作为文本切片), 有值("函数"));
        断言相等!(反向表.获取("let").映射(字符串::作为文本切片), 有值("让"));
        断言相等!(反向表.获取("std").映射(字符串::作为文本切片), 有值("标准库"));
        断言相等!(反向表.获取("String").映射(字符串::作为文本切片), 有值("字符串"));
        断言相等!(反向表.获取("serde").映射(字符串::作为文本切片), 有值("序列化"));
        断言相等!(
            反向表.获取("Serialize").映射(字符串::作为文本切片),
            有值("序列化特征")
        );
        断言!(
            !反向表.包含键("Debug"),
            "派生特征节不应并入关键字索引"
        );
    }

    /// 覆盖检测：关键字缺失入错误列表，接口缺失入警告列表
    #[测试]
    函数 测试计算覆盖() {
        让 关键字内容 = "[\"声明\"]\n\"函数\" = \"fn\"\n";
        让 模块路径内容 = "[\"模块路径\"]\n\"标准库\" = \"std\"\n";
        让 反向表 = 构建反向索引(关键字内容, 模块路径内容, "", &[]);
        让 可变 语料 = 语料库::默认值();
        语料.关键字表.置入("fn".转字符串(), (3, "a.rs".转字符串()));
        语料
            .关键字表
            .置入("unsafe".转字符串(), (1, "b.rs".转字符串()));
        语料
            .标准库段
            .置入("std".转字符串(), (9, "a.rs".转字符串()));
        语料
            .类型名
            .置入("NotCovered".转字符串(), (2, "b.rs".转字符串()));
        让 报告值 = 计算覆盖(&语料, &反向表, "zh");
        断言!(报告值.缺失关键字.迭代().任意(|(条目名, ..)| 条目名 == "unsafe"));
        断言!(!报告值.缺失关键字.迭代().任意(|(条目名, ..)| 条目名 == "fn"));
        断言!(报告值.缺失类型.迭代().任意(|(条目名, ..)| 条目名 == "NotCovered"));
        断言!(!报告值.缺失标准库段.迭代().任意(|(条目名, ..)| 条目名 == "std"));
        断言相等!(报告值.总名称数, 4);
        断言相等!(报告值.已覆盖数, 2);
    }

    /// 关键字门禁：全部内置语言包必须覆盖 Rust 稳定关键字全集（错误级）——
    /// 任一语言缺任一关键字（用户无法用母语写出该语法结构）都会在此失败
    #[测试]
    函数 测试全部内置语言关键字齐全() {
        让 可变 失败清单: 向量<字符串> = 向量::新建();
        对于 语言代码 在 包::内置语言::内置语言清单() {
            让 数据 = 包::内置语言::获取内置数据(语言代码);
            让 反向表 = 构建反向索引(数据.关键字内容, "", "", &[]);
            让 缺失: 向量<&文本> = 稳定关键字表
                .迭代()
                .复制值()
                .过滤(|关键字值| !反向表.包含键(*关键字值))
                .收集();
            如果 !缺失.是否为空() {
                失败清单.推入(格式化!("{} 缺 {:?}", 语言代码, 缺失));
            }
        }
        断言!(失败清单.是否为空(), "关键字门禁失败: {:?}", 失败清单);
    }

    /// 全内置语言跑一遍覆盖检测（不崩溃、有统计）
    #[测试]
    函数 测试全部语言覆盖不崩溃() {
        对于 语言代码 在 包::内置语言::内置语言清单() {
            让 数据 = 包::内置语言::获取内置数据(语言代码);
            让 反向表 = 构建反向索引(
                数据.关键字内容,
                数据.模块路径内容,
                数据.标准库内容,
                数据.三方库数据,
            );
            // 用最小语料冒烟：语料为空时统计为 0 即可
            让 语料 = 语料库::默认值();
            让 报告值 = 计算覆盖(&语料, &反向表, 语言代码);
            断言相等!(报告值.总名称数, 0, "{语言代码} 空语料统计应为 0");
            断言!(报告值.缺失关键字.是否为空());
        }
    }
}
