//! `rzc 待译清单` —— 待译清单（英文残留）查看、导出与清零
//!
//! 编译器/构建工具的消息命中不了语言包消息表时，诊断照旧按英文原文显示
//! （兜底，绝不吞诊断），同时把这条未译记录写入 `~/.rz/待译清单/<语言>.tsv`。
//! 本命令把清单读回来：直接看、导出成补表素材，或补完后清零。
//!
//! 清单每行 `语言 → 通道 → 错误码 → 消息原文`，通道取主消息、建议或工具；
//! 消息原文里的换行与制表符以转义字面量存放（一类编译器消息本身就跨行），
//! 保证一行一条记录；去掉首列即与语料门禁的
//! `crates/engine/tests/data/diag-corpus.tsv` 同构，可直接并入。

使用 标准库::路径::路径缓冲;

使用 错误处理::错误上下文特征;
使用 引擎库::诊断::待译清单;

使用 包::界面;

/// 列出/导出/清零待译清单
公开(包) 函数 清单命令(
    界面表: &界面::界面消息表,
    语言: 选项<字符串>,
    导出: 选项<路径缓冲>,
    清空: 布尔,
) -> 错误处理::结果<空> {
    让 语言代码 = 语言.解包或用否则(界面::探测界面语言);
    让 清单文件 = 待译清单::清单项文件(&语言代码);
    如果 清空 {
        打印行!(
            "{}",
            界面表.取带参消息(
                "gaps_cleared",
                &[&语言代码, &清单文件.展示().转字符串()]
            )
        );
        如果 !待译清单::清空缺口(&语言代码) {
            // 文件本就不存在：清单已是空，补一句避免误以为删了东西
            打印行!(
                "{}",
                界面表.取带参消息("gaps_none", &[&清单文件.展示().转字符串()])
            );
        }
        返回 成功(());
    }
    让 清单 = 待译清单::读取缺口(&语言代码);
    如果 清单.是否为空() {
        打印行!(
            "{}",
            界面表.取带参消息("gaps_none", &[&清单文件.展示().转字符串()])
        );
        返回 成功(());
    }
    让 文本串 = 渲染清单(&清单);
    如果让 有值(导出路径) = 导出 {
        标准库::文件系统::写入(&导出路径, 文本串)
            .带错误上下文(|| 格式化!("写入 {} 失败", 导出路径.展示()))?;
        打印行!(
            "{}",
            界面表.取带参消息(
                "gaps_written",
                &[&导出路径.展示().转字符串(), &清单.长度().转字符串()]
            )
        );
    } 否则 {
        // 直接输出纯制表符分隔文本（无表头），便于管道给工具链与补表脚本消费
        打印!("{文本串}");
    }
    成功(())
}

/// 渲染清单：按通道分组排序，输出与语料门禁同构的三列制表符分隔文本
///
/// 消息里的换行/制表符走 [`待译清单::编码缺口字段`]：跨行消息（如错误码
/// 后跟「下列类型实现了该特征」清单）若原样输出，导出件一行就不只一条记录，
/// 下游补表脚本与 `解析清单行` 都要读坏。
函数 渲染清单(清单: &[待译清单::待译记录]) -> 字符串 {
    让 可变 排序清单 = 清单.到向量();
    // 通道（主消息 → 建议 → 工具）→ 消息原文，稳定输出便于对比差异
    排序清单.排序_by(|甲, 乙| (&甲.1, &甲.3).比较(&(&乙.1, &乙.3)));
    让 可变 输出文本 = 字符串::新建();
    对于 (_, 通道, 错误码, 消息原文) 在 排序清单 {
        输出文本.推入字符串(&格式化!(
            "{通道}\t{错误码}\t{}\n",
            待译清单::编码缺口字段(&消息原文)
        ));
    }
    输出文本
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    /// 渲染：按通道排序且与引擎清单格式兼容（三列：通道 → 错误码 → 消息）
    #[测试]
    函数 渲染按通道再按消息排序() {
        让 清单 = 向量![
            (
                "zh".转字符串(),
                "tool".转字符串(),
                字符串::新建(),
                "failed to parse manifest".转字符串(),
            ),
            (
                "zh".转字符串(),
                "main".转字符串(),
                "E9999".转字符串(),
                "some english".转字符串(),
            ),
            (
                "zh".转字符串(),
                "main".转字符串(),
                字符串::新建(),
                "another english".转字符串(),
            ),
        ];
        让 文本串 = 渲染清单(&清单);
        让 行列表: 向量<&文本> = 文本串.逐行().收集();
        断言相等!(行列表.长度(), 3);
        断言!(行列表[0].以开头("main\t") && 行列表[0].包含("another english"));
        断言!(行列表[1].以开头("main\tE9999"));
        断言!(行列表[2].以开头("tool\t"));
        // 去掉语言列后可直接被引擎解析（语料门禁同构）
        断言相等!(待译清单::解析清单行(&文本串).长度(), 3);
    }

    /// 跨行消息在导出件里仍是一行一条，且能被引擎逐字读回
    ///
    /// 不转义就会把导出产物拆成裸行：补表脚本按行读到的是半句，
    /// 而 `rzc 待译清单` 的条数也不再是待译句子数。
    #[测试]
    函数 渲染转义跨行消息() {
        让 多行 = "the following other types implement trait `Add<Rhs>`:\n  `&f16` implements `Add<f16>`\nand 56 others";
        让 清单 = 向量![
            (
                "ja".转字符串(),
                "help".转字符串(),
                "E0277".转字符串(),
                多行.转字符串(),
            ),
            (
                "ja".转字符串(),
                "main".转字符串(),
                字符串::新建(),
                "a single line message".转字符串(),
            ),
        ];
        让 文本串 = 渲染清单(&清单);
        让 行列表: 向量<&文本> = 文本串.逐行().收集();
        断言相等!(行列表.长度(), 2, "跨行消息不得拆行：{行列表:?}");
        让 跨行行 = 行列表
            .迭代()
            .查找(|本行| 本行.以开头("help\tE0277\t"))
            .期望("建议通道的跨行记录应在列");
        断言!(
            跨行行.包含("trait `Add<Rhs>`:\\n  `&f16`"),
            "应以转义字面量存放：{跨行行}"
        );
        // 导出件去首列后仍与语料门禁同构，读回内容逐字相等
        让 读回项 = 待译清单::解析清单行(&文本串);
        断言相等!(读回项.长度(), 2);
        断言!(
            读回项.迭代().任意(|记录项| 记录项.3 == 多行),
            "跨行内容应无损还原：{读回项:?}"
        );
    }
}
