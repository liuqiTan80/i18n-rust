        派生表.置入("调试".转字符串(), "Debug".转字符串());
        让 空映射表 = 哈希映射::新建();
        让 源文本 = "#[派生(克隆, 调试)]\n结构体 点 {";
        让 期望文本 = "#[derive(Clone, Debug)]\n结构体 点 {";
        断言相等!(
            带宏表转译(源文本, &关键字表, &空映射表, &派生表),
