    #[测试]
    函数 词法分词转译记录关键字替换() {
        让 关键字表 = 词法建测试关键字表();
        让 宏表 = 词法建宏表();
        让 源文本 = "函数 主函数() { 让 x = 5; 打印行(\"你好\") }";
        让 分词产物 = 分词转译(
            源文本,
            &关键字表,
            &宏表,
            &哈希映射::新建(),
            &哈希集合::新建(),
            &哈希集合::新建(),
            &哈希映射::新建(),
        );

        // 函数/让/打印行 被替换，主函数 未命中映射不记录
        让 函数编辑条 = 分词产物
            .源映射
            .迭代()
            .查找(|编辑条| 编辑条.原文 == "函数")
            .期望("应有 函数 映射");
        断言相等!(函数编辑条.替换文字, "fn");
        断言相等!(
            &源文本[函数编辑条.源偏移..函数编辑条.源偏移 + 函数编辑条.源码长度],
            "函数"
        );

        让 让编辑条 = 分词产物
            .源映射
            .迭代()
            .查找(|编辑条| 编辑条.原文 == "让")
            .期望("应有 让 映射");
        断言相等!(让编辑条.替换文字, "let");
        断言相等!(
            &源文本[让编辑条.源偏移..让编辑条.源偏移 + 让编辑条.源码长度],
            "让"
        );

        // 宏名映射记录翻译文本（打印行宏名），感叹号补充不产生额外条目
        让 打印行编辑条 = 分词产物
            .源映射
            .迭代()
            .查找(|编辑条| 编辑条.原文 == "打印行")
            .期望("应有 打印行 映射");
        断言相等!(打印行编辑条.替换文字, "println");

        断言!(!分词产物
            .源映射
            .迭代()
            .任意(|编辑条| 编辑条.原文 == "主函数"));
    }

