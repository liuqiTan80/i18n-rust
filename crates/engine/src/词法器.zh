//! 词法处理模块 —— 把母语源码按关键字映射转译成标准 Rust 源码
//!
//! 基于词法解析器的词元级转译，保证注释与字符串字面量内容不被误改。
//! 支持宏感叹号自动补充、原始标识符（`r#`）处理、反向转译（Rust → 母语）。

使用 包::名字缓存::名字缓存;
使用 包::缓存::{映射文本, 源码映射条目};
使用 词法解析器::{令牌种类, 切分令牌};
使用 标准库::集合::{哈希映射, 哈希集合};

// 局部别名：让 if-let 的模式路径以本文件声明的名字开头，避免词元解析把
// 外部类型路径的首段当成模式绑定名而冻结全文件的类型替换
类型 词元类别 = 令牌种类;

/// 转译结果：标准 Rust 输出、词法阶段源映射与全管线编辑表
#[派生(调试, 克隆)]
公开 结构体 分词结果 {
    /// 转译后的代码文本
    公开 输出: 字符串,
    /// 词法阶段源映射条目列表（记录被替换的标识符；替换文字是词法阶段自己的
    /// 产物，因此不含宏调用自动补的 `!`）
    公开 源映射: 向量<源码映射条目>,
    /// 全管线编辑表：与源映射同偏移，但替换文字为**最终输出文本**
    ///（宏调用自动补充的 `!` 已计入替换文字），供全管线编辑地图组合使用
    公开 最终编辑表: 向量<源码映射条目>,
}

/// 标识符映射事实：一次解析出词法阶段无条件要问的那两张表的答案
///
/// 词法阶段对每个标识符都要问关键字表与宏表，每次都是一次随机内存访问——
/// 2000 行样例（3930 个标识符）实测约 22 纳秒/次。同一份源码里标识符高度重复
///（局部变量、字段名被反复引用），因此按名字直映缓存解析结果：重复名字只付
/// 一次廉价探测，首次出现才查表。
///
/// 只缓存无条件的这两张表：派生特征表、使用段让位词、方法位让位词都只在特定
/// 上下文（`#[派生(` 内、使用段内、圆点之后）才需要，现场查一次比塞进缓存更
/// 便宜——早先每个未命中的名字都要连查五张表，实测占词法阶段 16%（1192 份
/// 语料 0.84 毫秒）。
#[派生(克隆, 复制)]
结构体 标识事实<'甲> {
    /// 关键字表命中值（按去掉 `r#` 的名字查）
    关键字映射值: 选项<&'甲 文本>,
    /// 宏表命中值（按去掉 `r#` 的名字查）
    宏映射值: 选项<&'甲 文本>,
}

/// 将母语 Rust 源代码转换为标准 Rust 源代码字符串
///
/// 参数：
///   源文本: 母语源代码（如 .zh 文件内容）
///   关键词表: 母语关键字到英文关键字的映射表
/// 返回：标准 Rust 源代码
公开 函数 基础转译(源文本: &文本, 关键词表: &哈希映射<字符串, 字符串>) -> 字符串 {
    让 空映射表 = 哈希映射::新建();
    带宏表转译(源文本, 关键词表, &空映射表, &哈希映射::新建())
}

/// 将母语 Rust 源代码转换为标准 Rust 源代码字符串（支持宏感叹号自动补充）
///
/// 参数：
///   源文本: 母语源代码（如 .zh 文件内容）
///   关键词表: 母语关键字到英文关键字的映射表
///   宏名集: 所有中文宏名的集合（不含感叹号），用于自动补充 `!`
/// 返回：标准 Rust 源代码
///
/// 注意：宏名的英文替换优先使用宏映射（见 [`带宏表转译`]）；
/// 本函数以关键词表兜底（宏名在关键词表中被类型节覆盖时值可能不准，
/// 如 `向量` 在类型节映射为大写类型名、在宏节映射为小写宏名）。
公开 函数 带宏名转译(
    源文本: &文本,
    关键词表: &哈希映射<字符串, 字符串>,
    宏名集: &哈希集合<字符串>,
) -> 字符串 {
    让 宏映射表: 哈希映射<字符串, 字符串> = 宏名集
        .迭代()
        .映射(|名字| {
            (
                名字.克隆值(),
                关键词表
                    .获取(名字)
                    .克隆副本()
                    .解包或用否则(|| 名字.克隆值()),
            )
        })
        .收集();
    分词转译(
        源文本,
        关键词表,
        &宏映射表,
        &哈希映射::新建(),
        &哈希集合::新建(),
        &哈希集合::新建(),
        &哈希映射::新建(),
    )
    .输出
}

/// 同 [`带宏名转译`]，但宏名英文替换来自宏映射表
///（宏名 → 英文宏名，如 `向量` → 宏节的小写宏名），可避免宏名在类型节与宏节
/// 重复时被类型值覆盖（如 `向量` 类型节为大写类型名、宏节为小写宏名）。
公开 函数 带宏表转译(
    源文本: &文本,
    关键词表: &哈希映射<字符串, 字符串>,
    宏映射表: &哈希映射<字符串, 字符串>,
    派生特征表: &哈希映射<字符串, 字符串>,
) -> 字符串 {
    分词转译(
        源文本,
        关键词表,
        宏映射表,
        派生特征表,
        &哈希集合::新建(),
        &哈希集合::新建(),
        &哈希映射::新建(),
    )
    .输出
}

/// 同 [`带宏名转译`]，同时产出源映射（被替换标识符的源偏移与翻译前后文本）
///
/// 源映射在标识符实际被替换时记录；宏感叹号自动补充不产生映射条目。
///
/// `使用段让位词`：使用语句内的让位词集合（模块路径/别名映射键，见
/// [`包::映射管理器::映射管理器::取使用段让位词`]）。
/// 使用段内命中该集合的词跳过关键字/宏替换，原样保留给后续阶段处理。
///
/// `方法位让位词`：方法位让位词集合（见
/// [`包::映射管理器::映射管理器::取方法位让位词`]）——
/// 词法替换值是保留关键字的词（`枚举` 会转译为枚举保留字）在方法位（前面是圆点）原样
/// 保留：`.枚举()` 直译会成非法的 `.enum()`，让位后由别名阶段替换为
/// `.enumerate()`。
///
/// `字面后缀表`：数字字面量后缀的兜底查表（标准库标识符映射，见
/// [`包::映射管理器::映射管理器::取别名映射`]）——标准库层
/// 数值类型词（如 `无符号机器整数` = 机器字长无符号整数）不在关键词表，黏连数字后
/// 同样需要拆分替换。
公开 函数 分词转译(
    源文本: &文本,
    关键词表: &哈希映射<字符串, 字符串>,
    宏映射表: &哈希映射<字符串, 字符串>,
    派生特征表: &哈希映射<字符串, 字符串>,
    使用段让位词: &哈希集合<字符串>,
    方法位让位词: &哈希集合<字符串>,
    字面后缀表: &哈希映射<字符串, 字符串>,
) -> 分词结果 {
    分词转译并取令牌(
        源文本,
        关键词表,
        宏映射表,
        派生特征表,
        使用段让位词,
        方法位让位词,
        字面后缀表,
    )
    .0
}

/// 同 [`分词转译`]，另把本阶段自己分好的**输入**词元流交给调用方
///
/// 转译需要随机访问整条词元流（前瞻宏调用的 `!`、后顾声明位），因此本
/// 阶段无论如何都要把源码分词一次并留一份向量。转译之后的管线还需要在
/// **词法产物**上分词一次（词法产物的输出词元流），而那份流可由「本阶段
/// 的输入词元流 + 本阶段的编辑表」派生（见管线侧的重分词复用）：
/// 于是这里把手里的向量顺手交出去，省掉管线对输出的整趟重新分词（2000 行
/// 样例实测 421 微秒）。
公开(包) 函数 分词转译并取令牌(
    源文本: &文本,
    关键词表: &哈希映射<字符串, 字符串>,
    宏映射表: &哈希映射<字符串, 字符串>,
    派生特征表: &哈希映射<字符串, 字符串>,
    使用段让位词: &哈希集合<字符串>,
    方法位让位词: &哈希集合<字符串>,
    字面后缀表: &哈希映射<字符串, 字符串>,
) -> (分词结果, 向量<词法解析器::词法令牌>) {
    // 收集所有词元以便前瞻/后顾。词元原文按需切片（见 [`回溯令牌原文`]）：
    // 早先为整条词元流预建 `向量<&文本>`，2000 行文件因此多付一次全量分配、
    // 一趟遍历和每词元 16 字节的临时表，而实际回溯只跨紧邻的几个词元
    让 可变 词元流: 向量<词法解析器::词法令牌> = 向量::带容量(源文本.元素数() / 4 + 8);
    词元流.扩展(切分令牌(源文本));
    // 输出只在替换点刷出：未替换的词元不逐个推入字符串，替换时才把
    //「上次刷出位置 → 本词元起点」的原始片段整段拷过去（2000 行样例
    // 1.5 万个词元只有一百多个替换点）
    让 可变 输出文本 = 字符串::带容量(源文本.元素数());
    让 可变 已复制 = 0usize;
    让 可变 当前偏移 = 0;
    // 本文件声明的名字（`函数 测试`/`结构体 测试`… 后的标识符）：调用位不是宏调用。
    // 与宏同名的用户函数被调用时（`测试(41)`），若不排除会被宏糖补 `!`
    // 产出不存在的宏 `test!(41)`。惰性构建：文件里没有宏调用形态时零开销。
    让 可变 已声明名: 选项<哈希集合<&文本>> = 无;
    // 全管线编辑表：替换文字为最终输出文本（宏补的 `!` 计入）
    让 可变 最终编辑表: 向量<源码映射条目> = 向量::新建();
    // 词法表（源映射）**不在主循环里收**：它与最终编辑表逐条同偏移、同原文，
    // 只有「词法自动补 `!`」的条目不同（词法表记不含 `!` 的替换值，或压根不记）。
    // 两条表在循环里各写一份是词法阶段里最大的一项重复写入：2000 行样例（两条表
    // 各 2525 条、每条 80 字节）上改成「只收一张 + 末尾整表复制」（复制那一份实测
    // 28 微秒）后，配对基准（改动前后交替构建、错误流分流）测得词法阶段
    // 906.1 → 841.6 微秒（−6.0%～−12.7%）。这里因此只记下少数差异条目（最终编辑表
    // 下标 + 词法阶段的替换值，`无` = 该条不进词法表），循环后由
    // [`构建词法源映射`] 复制出词法表。
    让 可变 词法覆盖项: 向量<(无符号机器整数, 选项<映射文本>)> = 向量::新建();
    // 派生参数态：`#[派生(` 之后的参数（直到 `)`）内的标识符
    // 优先查派生特征映射（`克隆` → 克隆特征），避免与方法名别名（小写方法名）冲突
    让 可变 处于派生参数 = 假;
    // 使用语句态：使用段内的路径段命中「让位词」（模块路径/别名映射键）时
    // 跳过关键字/宏替换，交由后续模块路径与别名阶段按标准库语义替换——
    // 同名词在宏表与标准库表重复时使用段内标准库优先（`文件` 既是文件模块词
    // 又是文件类型词，`使用 标准库::文件系统::文件` 必须产出 `use std::fs::File`
    // 而非小写文件模块名）
    让 可变 处于使用语句 = 假;
    // 标识符事实缓存（见 [`标识事实`] 与 [`包::名字缓存`]）：按名字直映
    让 可变 事实缓存: 名字缓存<'_, 标识事实<'_>> = 名字缓存::新建();
    // 上一个有意义词元是否为圆点（方法位判定）：空白/注释不改变该状态，
    // 与早先逐位回溯前一为圆点逐字等价，但不必再回扫词元流
    让 可变 前一为圆点 = 假;

    对于 序号 在 0..词元流.元素数() {
        让 本词元 = &词元流[序号];
        让 本长度 = 本词元.令牌长度;
        让 文本片段 = &源文本[当前偏移..当前偏移 + 本长度];
        让 本类别 = 本词元.令牌类别;

        如果 本类别 == 令牌种类::标识符记号 || 本类别 == 令牌种类::原始标识符 {
            让 原名片段 = 文本片段.去前缀("r#").取值或(文本片段);
            // 原始标识符（`r#匹配`）是用户显式转义的名字：关键字查表口径
            // 与普通标识符不同（宏名不能是原始标识符，故永不补 `!`）
            让 为原始 = 原名片段.元素数() != 文本片段.元素数();
            // 名字级缓存：命中则复用上次解析的几张表答案，未命中才逐表查
            让 事实 = 事实缓存.取或解析(文本片段, || 标识事实 {
                关键字映射值: 关键词表.获取(原名片段).映射(|文本值| 文本值.作为文本切片()),
                宏映射值: 宏映射表.获取(原名片段).映射(|文本值| 文本值.作为文本切片()),
            });

            // 宏调用上下文优先：宏名后跟 `!` 或 `(/[/{`（且前面不是双冒号）时，
            // 使用宏映射替换为英文宏名并确保感叹号，避免宏名在类型节与宏节
            // 重复时被类型值覆盖（如 `向量` 类型节为大写类型名、宏节为小写宏名）。
            // 方法调用位（前面是圆点）不适用：宏不经圆点访问，
            // `.格式化(` 是方法调用，不补 `!`（后续走关键字映射 → `.format(`）
            让 可变 已处理 = 假;
            如果 事实.宏映射值.是否为有值()
                // 原始标识符（`r#匹配`）是用户显式转义的名字：宏名不能是
                // 原始标识符，故永不补 `!`（`r#匹配(3)` → `r#match(3)`）
                && !为原始
                && !前有双冒号(&词元流, 序号)
                && !前一为圆点
                && !是否为属性名(&词元流, 序号)
                && !(处于使用语句 && 使用段让位词.包含(原名片段))
                // 声明位豁免：声明关键字后的名字不是宏调用（`模块 测试 {` 的
                // `测试` 不得补 `!`），修复 `mod test!` 一类非法产物。
                && !前有声明引导词(
                    源文本,
                    &词元流,
                    序号,
                    当前偏移,
                    关键词表,
                )
                // 本文件已声明同名函数/类型时，调用位按普通标识符处理
                && !已声明名
                    .插入或用(|| {
                        收集已声明名(源文本, &词元流, 关键词表, 宏映射表)
                    })
                    .包含(原名片段)
                && 让 有值(下个类别) = 查找下个非空白类别(&词元流, 序号 + 1)
            {
                让 需补叹号 = 是否为开括号(下个类别);
                如果 需补叹号 || 下个类别 == 令牌种类::非号 {
                    // 借用映射表里的值而非克隆：宏名替换是热路径上少数
                    // 需要字符串的场合，未命中时直接沿用原文切片
                    让 可变 英文宏名: &文本 = 文本片段;
                    如果让 有值(宏值) = 事实.宏映射值 {
                        英文宏名 = 宏值;
                    } 否则 如果 让 有值(关键词值) = 事实.关键字映射值 {
                        英文宏名 = 关键词值;
                    }
                    // 最终输出文本（含自动补充的 `!`）：
                    // 与词法表语义不同——替换文字即输出原文，供列映射回放
                    让 拼接串 = 如果 需补叹号 {
                        格式化!("{英文宏名}!")
                    } 否则 {
                        字符串::从(英文宏名)
                    };
                    如果 拼接串 != 文本片段 {
                        让 词法下标 = 最终编辑表.元素数();
                        最终编辑表.推(源码映射条目::新建(
                            当前偏移,
                            本长度,
                            文本片段,
                            &拼接串,
                        ));
                        // 补了 `!`：词法表要的是不含 `!` 的替换值；替换值本就等于
                        // 原文（只补了 `!`）时词法表不记这一条
                        如果 需补叹号 {
                            词法覆盖项.推((
                                词法下标,
                                (英文宏名 != 文本片段)
                                    .然后(|| 映射文本::从(英文宏名)),
                            ));
                        }
                    }
                    输出文本.推入字符串(&源文本[已复制..当前偏移]);
                    输出文本.推入字符串(英文宏名);
                    // 后跟开括号但无 `!` 时自动补 `!`
                    如果 需补叹号 {
                        输出文本.推('!');
                    }
                    已复制 = 当前偏移 + 本长度;
                    已处理 = 真;
                }
            }

            如果 !已处理 {
                // 全走借用：热路径上绝大多数标识符未命中任何映射表，
                // 逐词元转字符串是纯分配损耗（2000 行文件数万次）
                让 可变 替换文本: &文本 = 文本片段;
                让 可变 需原始前缀 = 假;
                如果 处于使用语句 && 使用段让位词.包含(原名片段) {
                    // 使用段让位：保持原文，由模块路径/别名阶段替换
                } 否则 如果 前一为圆点 && 方法位让位词.包含(原名片段) {
                    // 方法位让位：替换值是保留关键字，直译非法（`.枚举()` →
                    // `.enum()`）；保持原文由别名阶段替换为有效词条（枚举迭代方法）
                } 否则 如果 处于派生参数
                    && 让 有值(派生值) = 派生特征表
                        .获取(原名片段)
                        .映射(|文本值| 文本值.作为文本切片())
                {
                    // 派生参数态内：优先查派生特征映射（如 `克隆` → 克隆特征）
                    替换文本 = 派生值;
                } 否则 如果 为原始 {
                    如果让 有值(关键词值) = 事实.关键字映射值 {
                        替换文本 = 关键词值;
                        需原始前缀 = 真;
                    }
                } 否则 如果 让 有值(关键词值) = 事实.关键字映射值 {
                    替换文本 = 关键词值;
                }
                让 原始拼接 = 需原始前缀.然后(|| 格式化!("r#{}", 替换文本));
                如果让 有值(拼接值) = &原始拼接 {
                    替换文本 = 拼接值.作为文本切片();
                }

                // `宏规则` 声明形式：后跟宏名时必须带 `!`，
                // 如 `宏规则 创建向量 { ... }` → `macro_rules! 创建向量 { ... }`
                让 宏规则声明 = 替换文本 == "macro_rules"
                    && 查找下个非空白类别(&词元流, 序号 + 1)
                        .有值且(|类别| 类别 == 令牌种类::标识符记号);
                让 最终替换文本: &文本 = 如果 宏规则声明 {
                    "macro_rules!"
                } 否则 {
                    替换文本
                };

                // 记录实际发生替换的标识符映射（两张表此处同值，只收一份）
                如果 最终替换文本 != 文本片段 {
                    最终编辑表.推(源码映射条目::新建(
                        当前偏移,
                        本长度,
                        文本片段,
                        最终替换文本,
                    ));
                    输出文本.推入字符串(&源文本[已复制..当前偏移]);
                    输出文本.推入字符串(最终替换文本);
                    已复制 = 当前偏移 + 本长度;
                }
            }
            // 使用语句态推进：本语言使用关键字词形开启让位态，由分号结束。
            // 词形经关键字映射反查（中文与日文 `使用`、西班牙文/葡萄牙文的
            // 使用词形、俄文等全部本地词形），不硬编码字面的英文使用关键字与 `使用`
            // ——历史实现只识别这两种，其余语言使用段让位态从未开启，
            // 冲突词（如西班牙文的格式化宏与格式化模块同名）被词法替换后
            // 残留英文宏名 `format::`
            //
            // 原始标识符按完整原文查（与上面缓存里的原名口径不同）
            让 使用词值 = 如果 为原始 {
                关键词表.获取(文本片段).映射(|文本值| 文本值.作为文本切片())
            } 否则 {
                事实.关键字映射值
            };
            如果 文本片段 == "use" || 使用词值.有值且(|值项| 值项 == "use") {
                处于使用语句 = 真;
            }
        } 否则 如果 本类别 == 令牌种类::开圆括号 {
            // 派生属性：`派生`（转译为派生属性关键字）后跟 `(` 进入参数态
            如果 !处于派生参数
                && 前标识符是否为(
                    源文本,
                    &词元流,
                    序号,
                    当前偏移,
                    关键词表,
                    "derive",
                )
            {
                处于派生参数 = 真;
            }
        } 否则 如果 本类别 == 令牌种类::闭圆括号 {
            // 离开派生参数态
            处于派生参数 = 假;
        } 否则 如果 本类别 == 令牌种类::分号 {
            // 使用语句以分号结束，退出让位态
            处于使用语句 = 假;
        } 否则 如果让 词元类别::字面量记号 { 后缀起点: 起位置, .. } = 本类别 {
            // 数字字面量：数字与中文类型「黏连」（`0无符号微整数`）时，
            // 词法解析器把整串（含 Unicode 后缀）切为单个字面量记号，
            // 后缀是完整映射词（关键字表或标准库表：`无符号微整数` → 8 位无符号整数、
            // `无符号机器整数` → 机器字长无符号整数）时替换后缀（产出带英文后缀的数字字面量）；
            // 未命中保持原样（编译错误交由编译器报告）
            让 后缀 = &文本片段[起位置..];
            如果 !后缀.是否为空() && !后缀.是否为ASCII() {
                让 英文选项 = 关键词表
                    .获取(后缀)
                    .或用否则(|| 字面后缀表.获取(后缀));
                如果让 有值(英文值) = 英文选项 {
                    让 数字部分 = &文本片段[..起位置];
                    让 替换串 = 格式化!("{}{}", 数字部分, 英文值);
                    让 编辑条 = 源码映射条目::新建(
                        当前偏移 + 起位置,
                        后缀.元素数(),
                        后缀,
                        英文值,
                    );
                    最终编辑表.推(编辑条);
                    输出文本.推入字符串(&源文本[已复制..当前偏移]);
                    输出文本.推入字符串(&替换串);
                    已复制 = 当前偏移 + 本长度;
                }
            }
        }
        // 空白/注释不改变「上一个有意义词元」的状态
        如果 !是否为空白类别(本词元.令牌类别) {
            前一为圆点 = 本词元.令牌类别 == 令牌种类::圆点;
        }
        当前偏移 += 本长度;
    }
    输出文本.推入字符串(&源文本[已复制..]);

    让 源映射 = 构建词法源映射(&最终编辑表, &词法覆盖项);
    (
        分词结果 {
            输出: 输出文本,
            源映射,
            最终编辑表,
        },
        词元流,
    )
}

/// 由全管线编辑表复制出词法阶段的源映射表
///
/// 两条表逐条同偏移、同原文（见 [`分词转译并取令牌`] 里的说明），只有
/// 词法自动补 `!` 的条目不同：覆盖项按最终编辑表下标升序给出这些条目
/// 在词法阶段的替换值，`无` 表示该条不进词法表（替换值就是原文、只补了 `!`）。
/// 与「在循环里各推入一份」逐条等价，但只付一次整表复制。
函数 构建词法源映射(
    最终编辑表: &[源码映射条目],
    覆盖项: &[(无符号机器整数, 选项<映射文本>)],
) -> 向量<源码映射条目> {
    让 可变 输出表: 向量<源码映射条目> = 向量::带容量(最终编辑表.元素数());
    让 可变 下个覆盖 = 0usize;
    对于 (序号, 编辑条) 在 最终编辑表.迭代().枚举() {
        当 下个覆盖 < 覆盖项.元素数() && 覆盖项[下个覆盖].0 < 序号 {
            下个覆盖 += 1;
        }
        如果 下个覆盖 < 覆盖项.元素数() && 覆盖项[下个覆盖].0 == 序号 {
            下个覆盖 += 1;
            如果让 有值(词法文本) = &覆盖项[下个覆盖 - 1].1 {
                输出表.推(源码映射条目 {
                    源偏移: 编辑条.源偏移,
                    源码长度: 编辑条.源码长度,
                    原文: 编辑条.原文.克隆值(),
                    替换文字: 词法文本.克隆值(),
                });
            }
            继续;
        }
        输出表.推(编辑条.克隆值());
    }
    输出表
}

/// 查找从指定位置开始的第一个非空白词元的类别
函数 查找下个非空白类别(词元流: &[词法解析器::词法令牌], 起始: 无符号机器整数) -> 选项<令牌种类> {
    对于 本词元 在 &词元流[起始..] {
        如果 !是否为空白类别(本词元.令牌类别) {
            返回 有值(本词元.令牌类别);
        }
    }
    无
}

/// 取词元流中序号 `目标序号` 的原文切片
///
/// `当前偏移` 是序号 `当前序号`（要求 `目标序号 <= 当前序号`）词元的起始偏移。
/// 回溯只跨过紧邻的少量词元（空白/标点），因此是常数级且零分配——取代
/// 早先为整条词元流预建 `向量<&文本>` 的做法。
函数 回溯令牌原文<'甲>(
    源文本: &'甲 文本,
    词元流: &[词法解析器::词法令牌],
    当前序号: 无符号机器整数,
    当前偏移: 无符号机器整数,
    目标序号: 无符号机器整数,
) -> &'甲 文本 {
    让 可变 起点 = 当前偏移;
    让 可变 游标 = 当前序号;
    当 游标 > 目标序号 {
        游标 -= 1;
        起点 = 起点.饱和减(词元流[游标].令牌长度);
    }
    让 本长度 = 词元流[目标序号].令牌长度;
    &源文本[起点..起点 + 本长度]
}

/// 判断当前位置之前的第一个非空白标识符（经关键字映射后）是否等于指定英文值
///
/// 用于识别派生属性：`#[派生(...)]` 中 `派生` 的映射值为派生属性关键字。
函数 前标识符是否为(
    源文本: &文本,
    词元流: &[词法解析器::词法令牌],
    当前序号: 无符号机器整数,
    当前偏移: 无符号机器整数,
    关键词表: &哈希映射<字符串, 字符串>,
    英文值: &文本,
) -> 布尔 {
    前标识符原文(源文本, 词元流, 当前序号, 当前偏移)
        .而后映射(|名字片段| 关键词表.获取(名字片段))
        .有值且(|值项| 值项 == 英文值)
}

/// 返回当前位置之前第一个非空白标识符的原文（含 `r#` 前缀则剔除）
///
/// 中间遇到非空白词元时返回 `无`（非紧邻）。
函数 前标识符原文<'甲>(
    源文本: &'甲 文本,
    词元流: &[词法解析器::词法令牌],
    当前序号: 无符号机器整数,
    当前偏移: 无符号机器整数,
) -> 选项<&'甲 文本> {
    让 可变 游标 = 当前序号;
    当 游标 > 0 {
        游标 -= 1;
        让 本类别 = 词元流[游标].令牌类别;
        如果 是否为空白类别(本类别) {
            继续;
        }
        如果 本类别 == 令牌种类::标识符记号 || 本类别 == 令牌种类::原始标识符 {
            让 原名片段 = 回溯令牌原文(源文本, 词元流, 当前序号, 当前偏移, 游标);
            返回 有值(原名片段.去前缀("r#").取值或(原名片段));
        }
        返回 无;
    }
    无
}

/// 声明引导词（对应母语词条的英文映射值）：其后紧跟的名字是「被声明的标识符」，
/// 不是宏调用——即便该名字恰好也是宏名（如 `测试` = 测试模块名），也不得补 `!`。
///
/// 覆盖 `模块 X {` / `结构体 X {` / `函数 X(` 等「声明关键字 + 名字」形态；
/// 修复 `模块 测试 { … }` 被误转译为非法 `mod test! { … }` 的缺陷（`{` 被
/// 当作宏调用的花括号定界符）。
常量 声明引导词取值: &[&文本] = &[
    "fn", "let", "const", "static", "struct", "enum", "union", "type", "trait", "impl", "mod",
];

/// 判断指定位置的标识符是否紧跟声明引导词（如 `函数 测试` 中的 `测试`）。
///
/// 命中时该标识符处于声明位，应跳过宏感叹号自动补充，交由关键字映射照常替换。
函数 前有声明引导词(
    源文本: &文本,
    词元流: &[词法解析器::词法令牌],
    当前序号: 无符号机器整数,
    当前偏移: 无符号机器整数,
    关键词表: &哈希映射<字符串, 字符串>,
) -> 布尔 {
    前标识符原文(源文本, 词元流, 当前序号, 当前偏移)
        .而后映射(|名字片段| 关键词表.获取(名字片段))
        .有值且(|值项| 声明引导词取值.包含(&值项.作为文本切片()))
}

/// 收集本文件声明的标识符名字（声明引导词之后紧跟的那个标识符）。
///
/// 用于抑制宏糖：`函数 测试` 已声明 `测试` 后，`测试(41)` 是该函数的调用，
/// 不应被当作宏调用补 `!`（否则产出不存在的 `test!(41)`）。只收集同时
/// 存在于宏表的名字——调用方仅在宏名分支上问该集合。
函数 收集已声明名<'甲>(
    源文本: &'甲 文本,
    词元流: &[词法解析器::词法令牌],
    关键词表: &哈希映射<字符串, 字符串>,
    宏映射表: &哈希映射<字符串, 字符串>,
) -> 哈希集合<&'甲 文本> {
    让 可变 名字集 = 哈希集合::新建();
    // 顺序扫描并自维护运行偏移（避免为全文回溯重建词元索引表）
    让 可变 运行偏移 = 0usize;
    对于 序号 在 0..词元流.元素数() {
        让 词元起点 = 运行偏移;
        让 本长度 = 词元流[序号].令牌长度;
        运行偏移 += 本长度;
        如果 !(词元流[序号].令牌类别 == 令牌种类::标识符记号
            || 词元流[序号].令牌类别 == 令牌种类::原始标识符)
        {
            继续;
        }
        // 先取前一个标识符再做一次查表（避免对 11 个引导词重复回溯）
        让 有值(前名) = 前标识符原文(源文本, 词元流, 序号, 词元起点) 否则 {
            继续;
        };
        让 是声明 = 关键词表
            .获取(前名)
            .有值且(|值项| 声明引导词取值.包含(&值项.作为文本切片()));
        如果 !是声明 {
            继续;
        }
        让 本文本 = &源文本[词元起点..词元起点 + 本长度];
        让 名字片段 = 本文本.去前缀("r#").取值或(本文本);
        如果 宏映射表.包含键(名字片段) {
            名字集.置入(名字片段);
        }
    }
    名字集
}

/// 将标准 Rust 源码反向转译为母语源码
///
/// 参数：
///   源文本: 标准 Rust 源代码（如 rustfmt 格式化后的虚拟 .rs 内容）
///   反向映射表: 英文关键字到母语关键字的映射表（由正向映射反转得到）
///   模块名集: 当前已打开 .zh 文件的模块名集合。
///              代理为跨文件引用插入的包前缀在此被删除，
///              还原为母语中的裸路径（`辅助::`），与正向翻译的
///              模块路径替换互为逆操作。
/// 返回：母语源代码
///
/// 以词元为单位匹配，天然避免子串误替换
///（如长类型关键词不会被更短的同前缀类型关键词错误替换），
/// 注释与字符串字面量内容保持原样，与正向翻译一一对应。
///
/// `新增包令牌集` 为代理（编辑器虚拟项目）添加的包前缀在英文
/// 输出中的非空白词元序号（见 [`新增包前缀令牌序号`]）：仅删除这些
/// 位置的前缀；用户显式书写的包前缀（不在集合中）原样保留，反向转译
/// 不再无差别删除，避免还原后代码丢失用户手写前缀。
公开 函数 反译(
    源文本: &文本,
    反向映射表: &哈希映射<字符串, 字符串>,
    模块名集: &哈希集合<字符串>,
    新增包令牌集: &哈希集合<无符号机器整数>,
) -> 字符串 {
    // 收集（词元类别, 文本）对以便前瞻/后顾
    让 词元流: 向量<(令牌种类, &文本)> = {
        让 可变 词元列表 = 向量::新建();
        让 可变 运行偏移 = 0;
        对于 本词元 在 切分令牌(源文本) {
            词元列表.推((本词元.令牌类别, &源文本[运行偏移..运行偏移 + 本词元.令牌长度]));
            运行偏移 += 本词元.令牌长度;
        }
        词元列表
    };
    // 预处理：每个词元的非空白序号（格式化等空白变化不影响序号，
    // 序号与 [`新增包前缀令牌序号`] 的计数口径一致）
    让 可变 非空白序号表 = 向量::带容量(词元流.元素数());
    让 可变 非空白计数 = 0usize;
    对于 (类别, _) 在 &词元流 {
        非空白序号表.推(非空白计数);
        如果 !是否为空白类别(*类别) {
            非空白计数 += 1;
        }
    }
    让 可变 输出文本 = 字符串::带容量(源文本.元素数());
    让 可变 跳过词元数 = 0usize; // 删除包前缀 / 宏规则感叹号时跳过的词元数

    对于 序号 在 0..词元流.元素数() {
        如果 跳过词元数 > 0 {
            跳过词元数 -= 1;
            继续;
        }
        让 (本类别, 文本片段) = &词元流[序号];
        如果 *本类别 == 令牌种类::标识符记号 || *本类别 == 令牌种类::原始标识符 {
            让 原名片段 = 如果让 有值(内层) = 文本片段.去前缀("r#") {
                内层
            } 否则 {
                文本片段
            };
            // 代理为跨文件引用插入的包前缀：仅当序号命中
            // 正向翻译记录（新增包令牌集）时才整体删除；
            // 用户手写的包前缀不在记录中，原样保留
            //（跳过数含中间空白，兼容 `crate :: 模块` 等带空格写法）
            如果 原名片段 == "crate"
                && 新增包令牌集.包含(&非空白序号表[序号])
                && 让 有值(跳过数) = 包前缀跳过数(&词元流, 序号, 模块名集)
            {
                跳过词元数 = 跳过数;
                继续;
            }
            // `macro_rules! 名称` 声明形式反向转译为 `宏规则 名称`（省略感叹号）
            如果 原名片段 == "macro_rules"
                && 让 有值(跳过数) = 叹号后缀跳过数(&词元流, 序号)
            {
                跳过词元数 = 跳过数;
            }
            让 母语值 = 反向映射表
                .获取(原名片段)
                .映射(|文本值| 文本值.作为文本切片())
                .取值或(原名片段);
            如果 文本片段.以开头("r#") && !母语值.以开头("r#") {
                输出文本.推入字符串("r#");
            }
            输出文本.推入字符串(母语值);
        } 否则 {
            输出文本.推入字符串(文本片段);
        }
    }
    输出文本
}

/// 计算全管线编辑地图中「代理添加的包前缀」在英文输出中的非空白词元序号
///
/// 输入为最终英文输出文本与其全管线编辑地图（替换文字为最终输出文本）。
/// 净长度增量线性累积后，把替换文字以包前缀开头的条目（仅来自编辑器
/// 虚拟项目的跨文件引用前缀重写，用户手写前缀不产生编辑条目）的母语源偏移
/// 换算为英文输出偏移，再转为非空白词元序号。
///
/// 格式化不改变非空白词元序列（只改变空白），序号在格式化前后
/// 保持一致，供 [`反译`] 对格式化后的文本精确删除前缀。
公开 函数 新增包前缀令牌序号(
    英文内容: &文本,
    全管线表: &[源码映射条目],
) -> 哈希集合<无符号机器整数> {
    // 1. 英文输出偏移 = 母语源偏移 + 之前全部条目的净长度增量
    //（编辑地图以母语源偏移升序记录且条目互不重叠，线性累积即可）
    让 可变 英文偏移集 = 哈希集合::新建();
    让 可变 长度增量 = 0长整数;
    对于 编辑条 在 全管线表 {
        如果 编辑条.替换文字.以开头("crate::") {
            英文偏移集.置入((编辑条.源偏移 作为 长整数 + 长度增量) 作为 无符号机器整数);
        }
        长度增量 += 编辑条.替换文字.元素数() 作为 长整数 - 编辑条.源码长度 作为 长整数;
    }
    如果 英文偏移集.是否为空() {
        返回 哈希集合::新建();
    }
    // 2. 偏移 → 非空白词元序号（与 [`反译`] 计数口径一致）
    让 可变 序号集合 = 哈希集合::新建();
    让 可变 扫描偏移 = 0usize;
    让 可变 非空白计数 = 0usize;
    对于 本词元 在 切分令牌(英文内容) {
        如果 !是否为空白类别(本词元.令牌类别) {
            如果 英文偏移集.包含(&扫描偏移) {
                序号集合.置入(非空白计数);
            }
            非空白计数 += 1;
        }
        扫描偏移 += 本词元.令牌长度;
    }
    序号集合
}

/// `crate::模块名` 前缀成立时，返回包前缀词之后需跳过的词元数（空白 + 两个冒号）；
/// 不成立（冒号不足/后非已知模块名）返回 `无`
函数 包前缀跳过数(
    词元流: &[(令牌种类, &文本)],
    当前序号: 无符号机器整数,
    模块名集: &哈希集合<字符串>,
) -> 选项<无符号机器整数> {
    让 可变 游标 = 当前序号 + 1;
    让 可变 跳过数 = 0usize;
    让 可变 冒号数 = 0usize;
    当 游标 < 词元流.元素数() {
        让 (本类别, 文本片段) = 词元流[游标];
        如果 是否为空白类别(本类别) {
            跳过数 += 1;
            游标 += 1;
            继续;
        }
        如果 冒号数 < 2 && 本类别 == 令牌种类::冒号 {
            冒号数 += 1;
            跳过数 += 1;
            游标 += 1;
            继续;
        }
        // 两个冒号后的第一个非空白词元必须是已知模块名才视为代理插入的前缀
        如果 冒号数 == 2 && 本类别 == 令牌种类::标识符记号 && 模块名集.包含(文本片段) {
            返回 有值(跳过数);
        }
        返回 无;
    }
    无
}

/// 宏规则关键字后跟感叹号（可隔空白）时，返回需跳过的词元数（空白 + 感叹号）
函数 叹号后缀跳过数(词元流: &[(令牌种类, &文本)], 当前序号: 无符号机器整数) -> 选项<无符号机器整数> {
    让 可变 跳过数 = 0usize;
    对于 (本类别, _) 在 &词元流[当前序号 + 1..] {
        如果 是否为空白类别(*本类别) {
            跳过数 += 1;
            继续;
        }
        返回 如果 *本类别 == 令牌种类::非号 {
            有值(跳过数 + 1)
        } 否则 {
            无
        };
    }
    无
}

/// 判断词元是否为空白
函数 是否为空白类别(类别: 令牌种类) -> 布尔 {
    模式匹配!(
        类别,
        令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. }
    )
}

/// 判断词元是否为开括号（圆括号、方括号、花括号）
函数 是否为开括号(类别: 令牌种类) -> 布尔 {
    模式匹配!(
        类别,
        令牌种类::开圆括号 | 令牌种类::开方括号 | 令牌种类::开大括号
    )
}

/// 检查指定位置之前的非空白词元是否构成双冒号
函数 前有双冒号(词元流: &[词法解析器::词法令牌], 当前位置: 无符号机器整数) -> 布尔 {
    // 从当前位置往前找，跳过空白，找前两个非空白词元
    让 可变 前一个 = 无;
    让 可变 前两个 = 无;

    让 可变 游标 = 当前位置;
    当 游标 > 0 {
        游标 -= 1;
        如果 !是否为空白类别(词元流[游标].令牌类别) {
            如果 前一个.是否为无() {
                前一个 = 有值(词元流[游标].令牌类别);
            } 否则 如果 前两个.是否为无() {
                前两个 = 有值(词元流[游标].令牌类别);
                中断;
            }
        }
    }

    // 前一个和前两个都是冒号 → 前面是双冒号
    模式匹配!(前一个, 有值(令牌种类::冒号)) && 模式匹配!(前两个, 有值(令牌种类::冒号))
}

/// 判断指定位置的标识符是否为属性名（紧跟在 `#[` 或 `#![` 之后的标识符）
///
/// 属性名不应触发宏感叹号自动补充：`#[配置(测试)]` 中的 `配置` 是属性
///（对应配置属性关键字），而非宏调用，若误补 `!` 会生成非法的 `#[cfg!(test)]`。
函数 是否为属性名(词元流: &[词法解析器::词法令牌], 当前位置: 无符号机器整数) -> 布尔 {
    // 往前收集最多三个非空白词元（最近的在前）
    让 可变 预测: 向量<令牌种类> = 向量::新建();
    让 可变 游标 = 当前位置;
    当 游标 > 0 && 预测.元素数() < 3 {
        游标 -= 1;
        如果 !是否为空白类别(词元流[游标].令牌类别) {
            预测.推(词元流[游标].令牌类别);
        }
    }

    // `#[标识符`：最近的词元是 `[`，再前一个是 `#`
    // `#![标识符`：最近的词元是 `[`，再前两个是 `!` 与 `#`
    模式匹配!(
        预测.切片(),
        [令牌种类::开方括号, 令牌种类::井号码, ..]
    ) || 模式匹配!(
        预测.切片(),
        [令牌种类::开方括号, 令牌种类::非号, 令牌种类::井号码]
    )
}

#[配置(测试)]
模块 本文件测试 {
    使用 超级::*;

    函数 词法建测试关键字表() -> 哈希映射<字符串, 字符串> {
        哈希映射::从([
