    /// 编辑表投影成（原文，替换值）序列，便于逐条比两张表的内容
    函数 词法表条目对(条目们: &[源码映射条目]) -> 向量<(&文本, &文本)> {
        条目们
            .迭代()
            .映射(|编辑条| (编辑条.原文.文本切片(), 编辑条.替换文字.文本切片()))
            .收集()
    }

    /// 只给关键字表与宏表的最小入参转译（其余表为空，不影响这里的形态）
    函数 词法两表转译(
        源文本: &文本,
        关键词表: &哈希映射<字符串, 字符串>,
        宏映射表: &哈希映射<字符串, 字符串>,
    ) -> 分词结果 {
        分词转译(
            源文本,
            关键词表,
            宏映射表,
            &哈希映射::新建(),
            &哈希集合::新建(),
            &哈希集合::新建(),
            &哈希映射::新建(),
        )
    }

    /// 两张表的等价关系（回归锁，口径见 [`构建词法源映射`]）
    ///
    /// 主循环只收全管线表，词法表由它复制、少数条目按补 `!` 规则改写或删除。
    /// 这里钉住两个后果：① 全管线表回放到源码必须逐字等于输出——漏收条目、
    /// 替换值写错都会先在这里炸；② 两张表逐条同偏移同原文，替换值只可能差一个
    /// 自动补的 `!`，且不进词法表的条目必须正是「原文 + `!`」那一种。
    函数 词法断言两表同步(源文本: &文本, 分词产物: &分词结果) {
        让 可变 回放文本 = 字符串::新建();
        让 可变 已复制 = 0usize;
        对于 编辑条 在 &分词产物.最终编辑表 {
            断言!(
                编辑条.源偏移 >= 已复制,
                "全管线表必须按偏移升序且不重叠：{编辑条:?}"
            );
            回放文本.推入字符串(&源文本[已复制..编辑条.源偏移]);
            回放文本.推入字符串(编辑条.替换文字.文本切片());
            已复制 = 编辑条.源偏移 + 编辑条.源码长度;
        }
        回放文本.推入字符串(&源文本[已复制..]);
        断言相等!(回放文本, 分词产物.输出, "全管线表回放必须逐字等于输出");

        让 可变 词法迭代器 = 分词产物.源映射.迭代();
        让 可变 待定编辑 = 词法迭代器.下一个();
        对于 编辑条 在 &分词产物.最终编辑表 {
            如果 待定编辑.有值且(|词法条| 词法条.源偏移 == 编辑条.源偏移) {
                让 词法条 = 待定编辑.取().期望("上面 是否为有值 判定的就是这个条目");
                断言相等!(
                    (词法条.源码长度, 词法条.原文.文本切片()),
                    (编辑条.源码长度, 编辑条.原文.文本切片()),
                    "偏移 {} 的两表条目必须同原文同长度",
                    编辑条.源偏移
                );
                让 差异片段 = 编辑条
                    .替换文字
                    .文本切片()
                    .去前缀(词法条.替换文字.文本切片());
                断言!(
                    差异片段 == 有值("") || 差异片段 == 有值("!"),
                    "偏移 {}：词法表 {:?} 与全管线表 {:?} 只能差一个补的 `!`",
                    编辑条.源偏移,
                    词法条.替换文字,
                    编辑条.替换文字
                );
                待定编辑 = 词法迭代器.下一个();
            } 否则 {
                让 原片段 = &源文本[编辑条.源偏移..编辑条.源偏移 + 编辑条.源码长度];
                断言相等!(
                    编辑条.替换文字.文本切片(),
                    格式化!("{原片段}!"),
                    "不进词法表的条目只能是「原文只补 `!`」"
                );
            }
        }
        断言!(待定编辑.是否为无(), "词法表不能有全管线表之外的条目");
    }

    /// 各形态下两条表各自的内容：宏调用补的 `!` 只进全管线表，其余同值
    #[测试]
    函数 词法两表按形态内容() {
        让 可变 关键字表 = 词法建测试关键字表();
        关键字表.置入("无符号微整数".转字符串(), "u8".转字符串());
        关键字表.置入("宏规则".转字符串(), "macro_rules".转字符串());
        关键字表.置入("匹配".转字符串(), "match".转字符串());
        让 源文本 = "函数 示例() {\n    打印行(\"补叹号\");\n    打印行!(\"已带叹号\");\n    让 值 = 0无符号微整数;\n    让 r#匹配 = 1;\n    宏规则 建向量 { () => {} }\n}\n";
        让 分词产物 = 词法两表转译(源文本, &关键字表, &词法建宏表());
        断言相等!(
            分词产物.输出,
            "fn 示例() {\n    println!(\"补叹号\");\n    println!(\"已带叹号\");\n    let 值 = 0u8;\n    let r#match = 1;\n    macro_rules! 建向量 { () => {} }\n}\n"
        );
        // 词法表记本阶段产物：两条宏调用都是打印行宏名（第一条的 `!` 由本阶段
        // 补在输出里，不进表），`宏规则` 的 `!` 是替换值自带、照常进表
        断言相等!(
            词法表条目对(&分词产物.源映射),
            [
                ("函数", "fn"),
                ("打印行", "println"),
                ("打印行", "println"),
                ("让", "let"),
                ("无符号微整数", "u8"),
                ("让", "let"),
                ("r#匹配", "r#match"),
                ("宏规则", "macro_rules!"),
            ]
        );
        // 全管线表记输出原文：第一条补了 `!`，第二条源码自带 `!` 不重复补
        断言相等!(
            词法表条目对(&分词产物.最终编辑表),
            [
                ("函数", "fn"),
                ("打印行", "println!"),
                ("打印行", "println"),
                ("让", "let"),
                ("无符号微整数", "u8"),
                ("让", "let"),
                ("r#匹配", "r#match"),
                ("宏规则", "macro_rules!"),
            ]
        );
        词法断言两表同步(源文本, &分词产物);
    }

    /// 宏名译文与母语词形相同（两表差别只有补的 `!`）：词法表不记该条
    ///
    /// 这是「词法阶段没改动、输出却多了 `!`」的那一侧边界，对应
    /// 词法覆盖项里的 `无` 分支。
    #[测试]
    函数 词法源表跳过仅补叹号条目() {
        让 关键字表 = 哈希映射::从([("打印行".转字符串(), "打印行".转字符串())]);
        让 宏表 = 哈希映射::从([("打印行".转字符串(), "打印行".转字符串())]);
        让 源文本 = "打印行(\"甲\");\n";
        让 分词产物 = 词法两表转译(源文本, &关键字表, &宏表);
        断言相等!(分词产物.输出, "打印行!(\"甲\");\n");
        断言!(分词产物.源映射.是否为空(), "只补 `!` 的条目不进词法表");
        断言相等!(
            词法表条目对(&分词产物.最终编辑表),
            [("打印行", "打印行!")]
        );
        词法断言两表同步(源文本, &分词产物);
    }

    // ===== 反向转译测试 =====

    函数 词法建反查表(正向表: &哈希映射<字符串, 字符串>) -> 哈希映射<字符串, 字符串> {
        正向表
            .迭代()
            .映射(|(键值, 值项)| (值项.克隆值(), 键值.克隆值()))
            .收集()
    }

    #[测试]
    函数 词法反译基础() {
        // 关键字、类型名、宏名均被还原为母语，宏感叹号保留
        让 正向表 = 哈希映射::从([
            ("函数".转字符串(), "fn".转字符串()),
            ("主函数".转字符串(), "main".转字符串()),
            ("让".转字符串(), "let".转字符串()),
            ("可变".转字符串(), "mut".转字符串()),
            ("整数".转字符串(), "i32".转字符串()),
            ("打印行".转字符串(), "println".转字符串()),
        ]);
        让 反向表 = 词法建反查表(&正向表);
        让 空集 = 哈希集合::新建();
        让 源文本 = "fn main() { let mut x: i32 = 5; println!(\"你好\"); }";
        让 期望文本 = "函数 主函数() { 让 可变 x: 整数 = 5; 打印行!(\"你好\"); }";
        断言相等!(
            反译(源文本, &反向表, &空集, &哈希集合::新建()),
            期望文本
        );
    }

    #[测试]
    函数 词法反译保留注释字符串自定义标识符() {
        // 注释、字符串字面量、中文/英文自定义标识符均保持原样
        让 反向表 = 哈希映射::从([
            ("fn".转字符串(), "函数".转字符串()),
            ("let".转字符串(), "让".转字符串()),
        ]);
        让 空集 = 哈希集合::新建();
        让 源文本 = "// fn 是关键字\nlet s = \"let\";\nlet 计数 = fn_value;";
        让 期望文本 = "// fn 是关键字\n让 s = \"let\";\n让 计数 = fn_value;";
        断言相等!(
            反译(源文本, &反向表, &空集, &哈希集合::新建()),
            期望文本
        );
    }

    #[测试]
    函数 词法反译长词优先() {
        // 词元级匹配：两个整数类型词是完整词元，互不干扰（无子串误替换）
        让 反向表 = 哈希映射::从([
            ("i32".转字符串(), "整数".转字符串()),
            ("i3".转字符串(), "三".转字符串()),
        ]);
        让 空集 = 哈希集合::新建();
        让 源文本 = "let a: i32 = 1; let b: i3x = 2; let c = i3;";
        // 让 关键字不在反向表中保持原样；32 位整数类型词→整数、三号类型词→三，后缀词是完整词元不受影响
        让 期望文本 = "let a: 整数 = 1; let b: i3x = 2; let c = 三;";
        断言相等!(
            反译(源文本, &反向表, &空集, &哈希集合::新建()),
            期望文本
        );
    }

    #[测试]
    函数 词法反译宏规则声明() {
        // `macro_rules! 名称` 反向转译为 `宏规则 名称`（感叹号省略）
        让 正向表 = 哈希映射::从([
            ("宏规则".转字符串(), "macro_rules".转字符串()),
            ("函数".转字符串(), "fn".转字符串()),
        ]);
        让 反向表 = 词法建反查表(&正向表);
        让 空集 = 哈希集合::新建();
        让 源文本 = "macro_rules! 创建向量 { () => { } }";
        让 期望文本 = "宏规则 创建向量 { () => { } }";
        断言相等!(
            反译(源文本, &反向表, &空集, &哈希集合::新建()),
            期望文本
        );
    }

    #[测试]
    函数 词法反译宏规则带叹号字符串() {
        // 宏调用 `名称!(...)` 的感叹号属于调用方，反向转译时保留
        让 正向表 = 哈希映射::从([
            ("打印行".转字符串(), "println".转字符串()),
            ("宏规则".转字符串(), "macro_rules".转字符串()),
            ("函数".转字符串(), "fn".转字符串()),
        ]);
        让 反向表 = 词法建反查表(&正向表);
        让 空集 = 哈希集合::新建();
        让 源文本 = "macro_rules! 创建向量 { () => { } }\nfn main() { 创建向量!() }";
        让 期望文本 = "宏规则 创建向量 { () => { } }\n函数 main() { 创建向量!() }";
        断言相等!(
            反译(源文本, &反向表, &空集, &哈希集合::新建()),
            期望文本
        );
    }

    #[测试]
    函数 词法反译模块前缀() {
        让 正向表 = 哈希映射::从([
            ("函数".转字符串(), "fn".转字符串()),
            ("包".转字符串(), "crate".转字符串()),
        ]);
        让 反向表 = 词法建反查表(&正向表);
        让 模块集 = 哈希集合::从(["辅助".转字符串()]);
        // 序号命中正向记录（代理添加的包前缀）：整体删除，还原为裸路径
        让 新增集 = 哈希集合::从([5usize]);
        断言相等!(
            反译(
                "fn main() { crate::辅助::辅助函数(); }",
                &反向表,
                &模块集,
                &新增集
            ),
            "函数 main() { 辅助::辅助函数(); }"
        );
        // 序号未命中（用户手写的包前缀，非代理添加）：前缀保留不误删
        断言相等!(
            反译(
                "fn main() { crate::辅助::辅助函数(); }",
                &反向表,
                &模块集,
                &哈希集合::新建()
            ),
            "函数 main() { 包::辅助::辅助函数(); }"
        );
        // 后跟非模块名时还原为 包::（不受序号影响）
        断言相等!(
            反译("fn main() { crate::外部函数(); }", &反向表, &模块集, &新增集),
            "函数 main() { 包::外部函数(); }"
        );
    }

    #[测试]
    函数 词法反译原始标识符() {
        让 反向表 = 哈希映射::从([
            ("let".转字符串(), "让".转字符串()),
            ("match".转字符串(), "匹配".转字符串()),
        ]);
        让 空集 = 哈希集合::新建();
        断言相等!(
            反译("let r#match = 1;", &反向表, &空集, &哈希集合::新建()),
            "让 r#匹配 = 1;"
        );
    }

    #[测试]
    函数 词法反译包前缀带空白() {
        // 包前缀词与双冒号之间存在空白时前缀仍应被完整删除（不能残留孤立冒号）
        让 反向表 = 哈希映射::从([("fn".转字符串(), "函数".转字符串())]);
        让 模块集 = 哈希集合::从(["辅助".转字符串()]);
        让 新增集 = 哈希集合::从([5usize]);
        断言相等!(
            反译(
                "fn f() { crate :: 辅助::辅助函数(); }",
                &反向表,
                &模块集,
                &新增集
            ),
            "函数 f() { 辅助::辅助函数(); }"
        );
    }

    #[测试]
    函数 词法反译宏规则带空白叹号() {
        // 宏规则关键字与 `!` 之间存在空白时感叹号仍应被省略
        让 反向表 = 哈希映射::从([("macro_rules".转字符串(), "宏规则".转字符串())]);
        让 空集 = 哈希集合::新建();
        断言相等!(
            反译(
                "macro_rules ! 创建向量 { () => { } }",
                &反向表,
                &空集,
                &哈希集合::新建()
            ),
            "宏规则 创建向量 { () => { } }"
        );
    }

    /// 使用段让位：`文件` 同时在宏表（文件宏名）与让位集合（标准库文件类型名）中时，
    /// 使用段内跳过词法替换（交后续模块路径/别名阶段处理）；
    /// 普通代码位置的 `文件!` 宏调用照常替换
    #[测试]
    函数 词法使用段让位冲突词() {
        让 关键字表 = 哈希映射::从([
            ("使用".转字符串(), "use".转字符串()),
            ("文件".转字符串(), "file".转字符串()),
        ]);
        让 让位集 = 哈希集合::从(["文件".转字符串()]);
        让 输出文本 = 分词转译(
            "使用 标准库::文件系统::文件 as 库文件;\n文件!()",
            &关键字表,
            &哈希映射::新建(),
            &哈希映射::新建(),
            &让位集,
            &哈希集合::新建(),
            &哈希映射::新建(),
        )
        .输出;
        断言相等!(输出文本, "use 标准库::文件系统::文件 as 库文件;\nfile!()");
        // 对照组：无让位集合时使用段内照旧替换（旧行为，验证让位集合确为开关）
        让 无让位输出 = 分词转译(
            "使用 标准库::文件系统::文件 as 库文件;",
            &关键字表,
            &哈希映射::新建(),
            &哈希映射::新建(),
            &哈希集合::新建(),
            &哈希集合::新建(),
            &哈希映射::新建(),
        )
        .输出;
        断言相等!(无让位输出, "use 标准库::文件系统::file as 库文件;");
    }

    /// 使用段让位（本地化使用词形）：不使用 `使用` 词形的语言（如西班牙文的
    /// 使用词）也需开启让位态——词形经关键字映射反查（历史硬编码只识别
    /// 英文使用关键字与 `使用`，西班牙文等语言使用段的冲突词被词法替换后
    /// 残留 `format::`，模块路径阶段无法修复）
    #[测试]
    函数 词法使用段本地化使用词让位() {
        让 关键字表 = 哈希映射::从([
            ("usar".转字符串(), "use".转字符串()),
            ("formato".转字符串(), "format".转字符串()),
        ]);
        让 让位集 = 哈希集合::从(["formato".转字符串()]);
        让 输出文本 = 分词转译(
            "usar estandar::formato::Mostrar;",
            &关键字表,
            &哈希映射::新建(),
            &哈希映射::新建(),
            &让位集,
            &哈希集合::新建(),
            &哈希映射::新建(),
        )
        .输出;
        // 西班牙文使用词照常译为使用关键字；格式化词让位保留（交模块路径阶段替换为格式化模块）
        断言相等!(输出文本, "use estandar::formato::Mostrar;");
    }

    /// 方法位判定跨空白与注释：圆点与名字之间夹什么都是方法位
    ///
    /// 方法位改用「上一个有意义词元是否为圆点」的状态变量（早先对每个
    /// 标识符回扫词元流），空白与注释不重置该状态正是两条实现等价的关键
    /// 边界；同时确认非方法位照常替换，状态没有被粘住。
    #[测试]
    函数 词法方法位跨杂项让位() {
        让 关键字表 = 哈希映射::从([("枚举".转字符串(), "enum".转字符串())]);
        让 方法让位集 = 哈希集合::从(["枚举".转字符串()]);
        对于 样本文本 在 [
            "列.枚举();",
            "列 . 枚举();",
            "列.\n    枚举();",
            "列. /* c */ 枚举();",
            "列. // c\n    枚举();",
        ] {
            让 输出文本 = 分词转译(
                样本文本,
                &关键字表,
                &哈希映射::新建(),
                &哈希映射::新建(),
                &哈希集合::新建(),
                &方法让位集,
                &哈希映射::新建(),
            )
            .输出;
            断言相等!(输出文本, 样本文本, "方法位让位失效：{样本文本:?}");
        }
        // 对照：不在圆点之后的同名标识符照常替换
        让 输出文本 = 分词转译(
            "枚举();",
            &关键字表,
            &哈希映射::新建(),
            &哈希映射::新建(),
            &哈希集合::新建(),
            &方法让位集,
            &哈希映射::新建(),
        )
        .输出;
        断言相等!(输出文本, "enum();");
    }

    /// 方法位让位：词法替换值是保留关键字的词（`枚举` 会转译为枚举保留字）在圆点后
    /// 原样保留（交别名阶段替成枚举迭代方法）；未命中让位集合时照旧替换
    #[测试]
    函数 词法方法位让位冲突词() {
        让 关键字表 = 哈希映射::从([
            ("让".转字符串(), "let".转字符串()),
            ("迭代".转字符串(), "iter".转字符串()),
            ("枚举".转字符串(), "enum".转字符串()),
        ]);
        让 方法让位集 = 哈希集合::从(["枚举".转字符串()]);
        让 输出文本 = 分词转译(
            "让 n = 列.迭代().枚举();",
            &关键字表,
            &哈希映射::新建(),
            &哈希映射::新建(),
            &哈希集合::新建(),
            &方法让位集,
            &哈希映射::新建(),
        )
        .输出;
        断言相等!(输出文本, "let n = 列.iter().枚举();");
        // 对照组：无让位集合时方法位照旧替换（旧行为，验证让位集合确为开关）
        让 无让位输出 = 分词转译(
            "让 n = 列.迭代().枚举();",
            &关键字表,
            &哈希映射::新建(),
            &哈希映射::新建(),
            &哈希集合::新建(),
            &哈希集合::新建(),
            &哈希映射::新建(),
        )
        .输出;
        断言相等!(无让位输出, "let n = 列.iter().enum();");
    }

    /// 数字与中文类型黏连（`0无符号微整数`）：词法解析器视为单个
    /// 字面量记号，后缀命中映射表时替换（→ `0u8`）；未命中/ASCII 后缀原样
    #[测试]
    函数 词法数字字面量中文后缀() {
        让 关键字表 = 哈希映射::从([("无符号微整数".转字符串(), "u8".转字符串())]);
        让 空映射表 = 哈希映射::新建();
        // 后缀命中：替换为英文数值类型，并记录编辑条目（仅后缀部分）
        让 分词产物 = 分词转译(
            "vec![0无符号微整数; 16]",
            &关键字表,
            &空映射表,
            &空映射表,
            &哈希集合::新建(),
            &哈希集合::新建(),
            &空映射表,
        );
        断言相等!(分词产物.输出, "vec![0u8; 16]");
        断言相等!(分词产物.源映射.元素数(), 1);
        断言相等!(分词产物.源映射[0].原文, "无符号微整数");
        断言相等!(分词产物.源映射[0].替换文字, "u8");
        // 后缀未命中：原样保留（编译错误交给编译器）
        让 输出文本 = 分词转译(
            "let x = 0未知词;",
            &关键字表,
            &空映射表,
            &空映射表,
            &哈希集合::新建(),
            &哈希集合::新建(),
            &空映射表,
        )
        .输出;
        断言相等!(输出文本, "let x = 0未知词;");
        // ASCII 后缀不受影响
        让 输出文本 = 分词转译(
            "let x = 0u8;",
            &关键字表,
            &空映射表,
            &空映射表,
            &哈希集合::新建(),
            &哈希集合::新建(),
            &空映射表,
        )
        .输出;
        断言相等!(输出文本, "let x = 0u8;");
    }

    /// 标准库层数值类型词（`无符号机器整数` = 机器字长无符号整数，不在关键词表）
    /// 黏连数字后由兜底表拆分：`0无符号机器整数` → 机器字长数字字面量；
    /// 两表同词冲突时关键词表优先
    #[测试]
    函数 词法数字后缀回落标准库表() {
        让 空映射表 = 哈希映射::新建();
        让 标准库表 = 哈希映射::从([("无符号机器整数".转字符串(), "usize".转字符串())]);
        让 分词产物 = 分词转译(
            "let x = 0无符号机器整数;",
            &空映射表,
            &空映射表,
            &空映射表,
            &哈希集合::新建(),
            &哈希集合::新建(),
            &标准库表,
        );
        断言相等!(分词产物.输出, "let x = 0usize;");
        断言相等!(分词产物.源映射.元素数(), 1);
        断言相等!(分词产物.源映射[0].原文, "无符号机器整数");
        断言相等!(分词产物.源映射[0].替换文字, "usize");
        // 两表同词冲突：关键词表优先（匹配其它阶段的查找次序）
        让 关键字表 = 哈希映射::从([("微整数".转字符串(), "u8".转字符串())]);
        让 回落表 = 哈希映射::从([("微整数".转字符串(), "usize".转字符串())]);
        让 输出文本 = 分词转译(
            "0微整数",
            &关键字表,
            &空映射表,
            &空映射表,
            &哈希集合::新建(),
            &哈希集合::新建(),
            &回落表,
        )
        .输出;
        断言相等!(输出文本, "0u8");
    }
}
