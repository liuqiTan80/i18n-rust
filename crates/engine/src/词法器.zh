        让 期望文本 = "let mut x = 5;";
        断言相等!(基础转译(源文本, &关键字表), 期望文本);
    }

    #[测试]
    函数 词法未映射标识符原样保留() {
        让 关键字表 = 词法建测试关键字表();
        让 源文本 = "让 变量名 = 42;";
        让 期望文本 = "let 变量名 = 42;";
        断言相等!(基础转译(源文本, &关键字表), 期望文本);
    }

    #[测试]
    函数 词法注释与字符串原样保留() {
        让 关键字表 = 词法建测试关键字表();
        让 源文本 = "// 这是注释 函数\n让 s = \"这是字符串 函数\";";
        让 期望文本 = "// 这是注释 函数\nlet s = \"这是字符串 函数\";";
        断言相等!(基础转译(源文本, &关键字表), 期望文本);
    }

    #[测试]
    函数 词法原始标识符处理() {
        // 原始标识符用于保留关键字（如匹配关键字是 Rust 保留字）
        让 可变 关键字表 = 词法建测试关键字表();
        关键字表.置入("匹配".转字符串(), "match".转字符串());
        让 源文本 = "让 r#匹配 = 1;";
        让 期望文本 = "let r#match = 1;";
        断言相等!(基础转译(源文本, &关键字表), 期望文本);
    }

    #[测试]
    函数 词法未映射标识符保持() {
        让 关键字表 = 词法建测试关键字表();
        让 源文本 = "函数 主函数() { }";
        让 期望文本 = "fn 主函数() { }";
        断言相等!(基础转译(源文本, &关键字表), 期望文本);
    }

    /// 标识符事实缓存按名字直映：槽位冲突时两个名字必须各得其事实
    ///
    /// 槽内保存名字全文并逐字节比较；若误按槽位直接取用，后写入的未映射
    /// 名字会拿到前一个已映射名字的译文（或反之）。
    #[测试]
    函数 词法标识缓存撞槽保留双名() {
        让 可变 关键字表 = 词法建测试关键字表();
        关键字表.置入("甲".转字符串(), "one".转字符串());
        让 目标槽 = 包::名字缓存::名字槽位("甲");
        让 撞槽名 = (0..5000)
            .映射(|序号| 格式化!("甲{序号}"))
            .查找(|名字| 包::名字缓存::名字槽位(名字) == 目标槽)
            .期望("应能找到同槽位的另一个名字");
        让 源文本 = 格式化!("让 甲 = 1;\n让 {撞槽名} = 2;\n");
        让 期望文本 = 格式化!("let one = 1;\nlet {撞槽名} = 2;\n");
        断言相等!(基础转译(&源文本, &关键字表), 期望文本);
    }

    /// 名字数远超缓存槽数（必然反复冲突覆盖），逐个仍按自己的事实转译
    #[测试]
    函数 词法标识缓存多名共用() {
        让 关键字表 = 词法建测试关键字表();
        让 可变 源文本 = 字符串::从("函数 主函数() {\n");
        让 可变 期望文本 = 字符串::从("fn 主函数() {\n");
        对于 序号 在 0..600 {
            源文本.推入字符串(&格式化!("    让 变量_{序号} = {序号};\n"));
            期望文本.推入字符串(&格式化!("    let 变量_{序号} = {序号};\n"));
        }
        // 重复引用 + 关键字词交替出现：命中与未命中混在一起
        源文本.推入字符串(
            "    让 结果 = 变量_5 + 变量_257;\n    如果 结果 > 0 { 打印行!(\"正\"); }\n}\n",
        );
        期望文本.推入字符串(
            "    let 结果 = 变量_5 + 变量_257;\n    if 结果 > 0 { println!(\"正\"); }\n}\n",
        );
        让 宏表 = 词法建宏表();
        断言相等!(
            带宏表转译(&源文本, &关键字表, &宏表, &哈希映射::新建()),
            期望文本
        );
    }

    // ===== 宏感叹号自动补充测试 =====

