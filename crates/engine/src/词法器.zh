            ("否则".转字符串(), "else".转字符串()),
            ("打印行".转字符串(), "println".转字符串()),
            ("打印".转字符串(), "print".转字符串()),
            ("格式化".转字符串(), "format".转字符串()),
            ("断言".转字符串(), "assert".转字符串()),
            ("断言相等".转字符串(), "assert_eq".转字符串()),
            ("向量".转字符串(), "vec".转字符串()),
