    #[测试]
    函数 词法声明位宏词不补叹号() {
        // 声明位豁免：`模块 测试 {` 的 `测试` 是模块名（恰为测试宏名），
        // 不得补 `!` 产出非法的 `mod test! {`；`函数 测试(` 同理。
        让 可变 关键字表 = 词法建测试关键字表();
        关键字表.置入("模块".转字符串(), "mod".转字符串());
        关键字表.置入("测试".转字符串(), "test".转字符串());
        让 可变 宏表 = 词法建宏表();
        宏表.置入("测试".转字符串(), "test".转字符串());

        让 源文本 = "模块 测试 {\n    函数 f() {}\n}";
        让 期望文本 = "mod test {\n    fn f() {}\n}";
        断言相等!(
            带宏表转译(源文本, &关键字表, &宏表, &哈希映射::新建()),
            期望文本
        );

        // 非声明位的同名宏调用仍照常补 `!`（不误伤）
        断言相等!(
            带宏表转译("让 x = 测试();", &关键字表, &宏表, &哈希映射::新建()),
            "let x = test!();"
        );
    }

    #[测试]
    函数 词法已声明同名函数调用不补叹号() {
        // 用户定义与宏同名的函数后，调用位不得补 `!`：
        // `测试(1)` 是函数调用（→ `test(1)`），不是宏调用（`test!(1)` 不存在）
        让 可变 关键字表 = 词法建测试关键字表();
        关键字表.置入("测试".转字符串(), "test".转字符串());
        让 可变 宏表 = 词法建宏表();
        宏表.置入("测试".转字符串(), "test".转字符串());

        让 源文本 = "函数 测试() {}\n\n函数 主函数() {\n    测试(1);\n}";
        让 输出文本 = 带宏表转译(源文本, &关键字表, &宏表, &哈希映射::新建());
        断言!(输出文本.包含("fn test()"), "{输出文本}");
        断言!(输出文本.包含("test(1);"), "{输出文本}");
        断言!(!输出文本.包含("test!(1)"), "声明后的调用不应补 `!`：{输出文本}");

        // 未声明同名函数时仍按宏处理（不误伤真宏调用）
        让 另一输出 =
            带宏表转译("让 x = 测试(1);", &关键字表, &宏表, &哈希映射::新建());
        断言!(另一输出.包含("test!(1)"), "{另一输出}");
    }

    #[测试]
    函数 词法原始标识符宏词调用保留裸括号() {
        // `r#匹配` 转义声明后，调用位 `r#匹配(3)` 也不得补 `!`
        //（否则产出 `r#match!(3)`）：撞名的兜底写法规那么依赖本行为
        让 可变 关键字表 = 词法建测试关键字表();
        关键字表.置入("匹配".转字符串(), "match".转字符串());
        让 可变 宏表 = 词法建宏表();
        宏表.置入("匹配".转字符串(), "match".转字符串());

        让 源文本 = "函数 r#匹配(值: 整数) -> 整数 {\n    返回 值\n}";
        让 输出文本 = 带宏表转译(源文本, &关键字表, &宏表, &哈希映射::新建());
        断言!(输出文本.包含("fn r#match("), "{输出文本}");

        // 同文件内的转义调用
        让 调用文本 = "函数 主函数() {\n    r#匹配(3);\n}";
        让 输出文本 = 带宏表转译(调用文本, &关键字表, &宏表, &哈希映射::新建());
        断言!(输出文本.包含("r#match(3);"), "{输出文本}");
        断言!(!输出文本.包含("r#match!("), "转义调用不应补 `!`：{输出文本}");
    }

