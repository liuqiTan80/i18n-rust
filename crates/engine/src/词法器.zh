    #[测试]
    函数 词法分词转译输出一致() {
        让 关键字表 = 词法建测试关键字表();
        让 宏表 = 词法建宏表();
        让 源文本 = "函数 主函数() { 让 x = 5; 打印行(\"你好\") }";
        让 分词产物 = 分词转译(
            源文本,
            &关键字表,
            &宏表,
            &哈希映射::新建(),
            &哈希集合::新建(),
            &哈希集合::新建(),
