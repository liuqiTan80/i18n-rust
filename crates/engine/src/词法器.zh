    函数 词法普通代码宏仍补叹号() {
        让 关键字表 = 词法建测试关键字表();
        让 宏表 = 词法建宏表();
        // 普通代码中的宏调用不受影响
        让 源文本 = "断言(5 > 3)";
        让 期望文本 = "assert!(5 > 3)";
        断言相等!(
            带宏表转译(源文本, &关键字表, &宏表, &哈希映射::新建()),
            期望文本
        );
    }

    #[测试]
    函数 词法双冒号后宏不补叹号() {
        让 关键字表 = 词法建测试关键字表();
        让 宏表 = 词法建宏表();
        // 打印行 在宏集合中，但前面是双冒号，不应加 !
        让 源文本 = "std::打印行(\"你好\")";
        让 期望文本 = "std::println(\"你好\")";
        断言相等!(
            带宏表转译(源文本, &关键字表, &宏表, &哈希映射::新建()),
