//! 别名替换模块
//! 将源代码中的中文标识符别名（如第三方库的中文名称）替换为英文标识符。
//! 仅替换标识符类型的 token，不触碰字符串字面量和注释等内容。
//! 声明位保护：紧跟在声明关键字（fn/struct/let 等）后的标识符是用户自己的定义，
//! 不是库 API 引用，不参与别名替换；且用户声明的名字在整个文件内的
//! 裸使用处都豁免（两遍扫描：先收集声明名，再逐 token 替换），
//! 避免 `let 新建 = 5` 声明位受保护而后续使用处被误替换成 新建。
//! 三条精细规则：
//! 1. `::` 限定后的路径段按「链根」分级处理：根是项目符号
//!    （包/self/super/项目模块名/项目项名）时链内**与项目声明名
//!    同名**的段豁免——`平台Linux::新建` 的定义侧与调用侧一致
//!    （避免 E0599）；链内非项目名与根非项目符号的段都照常替换
//!    （`源码映射项::新建` 的 `新建` 未定义于项目、`盒子::新建`
//!    的 `新建` 是库 API）；无项目上下文时退化为「本文件项名豁免」
//!    （`接口错误::错误请求`）；
//! 2. 库特征实现块（`实现 <映射词特征> 对于 类型 {}`）内的方法名是库 API
//!    规定的名称（用户从映射表抄写而来），不是用户自定义名字，不受声明位
//!    保护——`实现 抄写器 对于 类型 { 函数 渲染（...） }` 中的 `渲染`
//!    必须转译为 `render`，否则无法匹配 `Scribe::render`（E0407/E0046）；
//! 3. 函数参数与闭包参数是「值绑定」（用户命名）：`fn 完整网址(路径: &str)`
//!    的 `路径` 在声明与使用处都豁免替换（参数「类型」位置的字照常替换），
//!    与格式化串中的 `{路径}` 保持一致，避免 E0425（找不到名称 `路径`）；
//! 4. 结构体字段名与枚举变体名同样是用户命名，纳入声明收集：
//!    字段 `struct 容器 { 值: i32 }` 的 `值`（撞 `值`=values 映射键）
//!    在定义/构造/访问处（`实例.值`）全豁免；枚举变体
//!    `enum 判定结果 { 保留, 丢弃 }` 的 `保留`/`丢弃`（撞
//!    保留/drop 映射键）同理；变体可经 `::` 访问
//!    （`判定结果::保留`）故收集为项，字段收集为值绑定。
//!    方法调用位（`实例.方法()`）不查字段名：`编辑表.长度()` 的
//!    `长度` 是 `新建向量::元素数` 调用，只查「项目方法名集合」（项）；
//! 5. 模式绑定（match 臂、let 解构、对于 模式）同样是值绑定：
//!    `匹配 有值(入参) { 有值(连接) => … }` 的 `连接`（撞
//!    `连接`=连接 映射键）全文件豁免（见 collect_pattern_bindings）。

使用 词法解析器::{令牌种类, 切分令牌};
使用 标准库::集合::{哈希映射, 哈希集合};

使用 包::缓存::源映射条目;

/// 单阶段替换结果：输出与编辑表
///
/// 编辑表以**本阶段输入文本**的字节偏移记录（input_offset 升序、互不重叠），
/// replacement 为本阶段输出文本。
#[派生(调试, 克隆)]
公开 结构体 替换结果 {
    /// 替换后的文本
    公开 产出: 字符串,
    /// 编辑表
    公开 编辑表: 向量<源映射条目>,
}

/// 声明位关键字（转译后的英文形式）：其后紧跟的标识符为用户定义
///
/// 不含 `mut`：仅 `让 mut 名称` 场景下透明传递声明状态（见替换循环），
/// `&mut 类型` 等非声明位的 mut 不传递，避免误保护库类型引用。
/// 不含 `实现`：`实现 特征 对于 类型` 中的特征/类型多为库 API，仍需替换。
/// LSP 列映射模拟别名替换时复用同一张表，保证两侧行为一致。
公开 常量 声明关键字表: &[&文本] = &[
    "fn", "struct", "enum", "trait", "type", "mod", "let", "const", "static",
];

/// 变量声明关键字：其后名字是「变量」（不可经 `::` 访问）；
/// [`声明关键字表`] 的其余关键字（fn/struct/enum/trait/type/mod）声明的
/// 是「项」，项可经 `::` 访问（见模块文档第 1 条规则）
常量 变量声明关键字: &[&文本] = &["let", "const", "static"];

/// 用户声明名与库特征方法名的收集结果（第一遍扫描）
#[派生(调试, 默认)]
公开 结构体 声明收集 {
    /// 项声明名（fn/struct/enum/trait/type/mod）+ 枚举变体名：
    /// `::` 后的同名标识符仍豁免
    公开 项名集: 哈希集合<字符串>,
    /// 变量声明名（let/const/静态）+ 函数/闭包参数：
    /// `::` 后的同名标识符照常替换
    公开 变量名集: 哈希集合<字符串>,
    /// 结构体命名字段：裸使用处豁免（`实例.字段`/结构体字面量）；
    /// `::` 后照常替换（字段不能经 `::` 访问）。
    /// 与 variables 分开收集，供项目级合并（绑定名是文件局部的）
    公开 成员名集: 哈希集合<字符串>,
    /// 库特征实现块内的方法名：声明位保护对这些名字失效（库 API 名称）
    公开 库方法名集: 哈希集合<字符串>,
}

/// 项目级声明上下文（跨文件声明豁免）
///
/// 单文件的声明豁免无法覆盖跨文件调用：A 文件声明 `公开 函数 新建()`，
/// B 文件调用 `包::A::新建()` 时 B 的转译单元看不到 A 的声明，
/// `新建` 被当作库别名替换出 `新建`（E0599）。转译前扫描同 包
/// 全部方言源文件汇总本结构，把使用处豁免升级到项目级。
///
/// 保守近似与单文件声明豁免一致：不做作用域/可见性分析，同名即豁免。
#[派生(调试, 默认, 克隆)]
公开 结构体 项目上下文 {
    /// 项目模块名（方言文件名词干）：`::` 路径链根
    公开 模块名集: 哈希集合<字符串>,
    /// 项目声明名（项 + 结构体字段）：裸使用处豁免
    ///（let/参数等文件内绑定不参与合并——绑定名是文件局部的）
    公开 声明名: 哈希集合<字符串>,
    /// 项目项名（fn/struct/enum/trait/type/mod + 枚举变体）：
    /// `::` 路径段豁免与路径链根判定（字段不参与：不可经 `::` 访问）
    公开 项名集: 哈希集合<字符串>,
}

实现 项目上下文 {
    /// 从项目源文件集合构建：`modules` 为项目模块名词干，
    /// `sources` 为全部方言源文件内容（母语原文）
    ///
    /// 声明收集工作在关键字转译后的文本上进行（声明关键字需英文形式），
    /// 内部对每个源文件先跑词法转译阶段再收集。
    公开 函数 自源文件新建<'a>(
        模块名集: 哈希集合<字符串>,
        源文件集: 实现 可迭代<货物类型 = &'a 文本>,
        映射管理器: &包::映射管理::映射管理器,
    ) -> 自身 {
        让 声明们: 向量<声明收集> = 源文件集
            .转迭代()
            .变换(|源码| 收集源声明(源码, 映射管理器))
            .收集();
        自身::自声明新建(模块名集, 声明们.迭代())
    }

    /// 同 [`Self::自源文件新建`]，但单文件声明收集结果由调用方提供
    ///
    /// 汇总规则唯一来源（[`Self::自源文件新建`] 亦委托本函数）：调用方可按
    /// 文件粒度缓存 [`收集源声明`] 的结果（如 LSP 按内容哈希
    /// 缓存），避免同一内容被重复跑词法转译，同时无需复刻合并规则。
    公开 函数 自声明新建<'a>(
        模块名集: 哈希集合<字符串>,
        声明集: 实现 可迭代<货物类型 = &'a 声明收集>,
    ) -> 自身 {
        让 可变 声明名 = 哈希集合::新建();
        让 可变 项名集 = 哈希集合::新建();
        对于 声明 在 声明集 {
            对于 名字 在 &声明.项名集 {
                声明名.插入(名字.克隆值());
                项名集.插入(名字.克隆值());
            }
            声明名.扩展(声明.成员名集.迭代().克隆副本());
        }
        自身 {
            模块名集,
            声明名,
            项名集,
        }
    }

    /// 上下文为空（无模块且无声明名）：空上下文不产生任何豁免
    公开 函数 上下文为空(&自我) -> 布尔 {
        自我.模块名集.是否为空() && 自我.声明名.是否为空()
    }

    /// 项目上下文指纹（排序后哈希，跨进程确定）：并入转译缓存指纹，
    /// 项目声明集合变化时相关缓存自动失效
    公开 函数 计算指纹(&自我) -> 无符号长整数 {
        使用 标准库::哈希模块::{哈希特征, 哈希器类型};
        让 可变 模块列表: 向量<&字符串> = 自我.模块名集.迭代().收集();
        模块列表.不稳定排序();
        让 可变 名字列表: 向量<&字符串> = 自我.声明名.迭代().收集();
        名字列表.不稳定排序();
        让 可变 项名列表: 向量<&字符串> = 自我.项名集.迭代().收集();
        项名列表.不稳定排序();
        让 可变 哈希器 = 标准库::集合模块::哈希映射模块::默认哈希器::新建();
        ("i18n-rust-project", 模块列表, 名字列表, 项名列表).哈希模块(&可变 哈希器);
        哈希器.完成()
    }

    /// 裸使用处豁免：项目声明名（项 + 结构体字段，含其他文件声明）
    函数 裸用豁免(&自我, 文本段: &文本) -> 布尔 {
        自我.声明名.包含(文本段)
    }

    /// 路径链根判定：包/super/self/项目模块名/项目项名。
    /// 根段后跟 `::` 时整条路径视为项目路径（链内全部段豁免）
    函数 是路径根(&自我, 文本段: &文本) -> 布尔 {
        模式匹配!(文本段, "crate" | "super" | "self")
            || 自我.模块名集.包含(文本段)
            || 自我.项名集.包含(文本段)
    }
}

/// 类型体（结构体/枚举）扫描状态：收集命名字段与枚举变体
#[派生(调试)]
结构体 类型体扫描 {
    /// 是否为枚举体（枚举顶层成员是变体，收集为项）
    是否枚举: 布尔,
    /// 花括号深度（1 = 类型体顶层）
    深度: 无符号整数,
    /// 处于成员开始位置（`{`/`,` 之后）：下一个标识符是字段名/变体名
    成员开始: 布尔,
    /// 已见的名字（等 `:` 确认后收集为字段）
    待确认成员: 选项<字符串>,
}

/// 收集单个方言源文件的声明名（词法转译 + 声明扫描）
///
/// 与 [`项目上下文::自源文件新建`] 内部的单文件收集步骤完全一致
/// （后者亦委托本函数，规则唯一来源），供需要按文件粒度缓存结果的调用方
/// 使用——例如 LSP 每按键都要汇总全部打开文件的声明名，若每次重算
/// 等于 O(项目规模) 次词法转译；按内容哈希缓存本函数的返回值后，
/// 每次按键只有内容真正变化的那个文件需要重算。
公开 函数 收集源声明(
    源码: &文本,
    映射管理器: &包::映射管理::映射管理器,
) -> 声明收集 {
    让 词法 = 包::词法::词法转译并映射(
        源码,
        映射管理器.取关键词映射表(),
        映射管理器.取宏映射表(),
        映射管理器.取派生映射表(),
        映射管理器.取使用延迟词(),
        映射管理器.取方法延迟词(),
        映射管理器.取别名映射表(),
    );
    收集声明名(&词法.产出, 映射管理器.取别名映射表())
}

/// 收集用户在声明位定义的标识符名（第一遍扫描）
///
/// 状态机与替换主循环一致：声明关键字后紧跟的标识符计入集合；
/// `mut` 在声明态内透明传递；空白/注释不打断声明态；符号终结声明位。
/// 另收集「值绑定」：函数参数名（`fn 名(参数: 类型)` 中的参数开始位
/// 且后跟 `:`）与闭包参数名（`|甲, 乙|`，可无类型标注直接收集）——
/// 绑定名是用户命名，不是库 API 引用。
/// 结构体/枚举体扫描（[`类型体扫描`]）：命名字段（`字段: 类型`）
/// 收集为值绑定，枚举顶层变体名收集为项（变体可经 `::` 访问）。
/// 集合内的名字在文件内的使用处豁免别名替换（保守近似：不做作用域
/// 分析，同名遮蔽场景同样豁免，与声明位保护的设计意图一致）。
/// 库特征实现块内的方法名（见 [`收集库特征方法名`]）从保护集合剔除。
公开 函数 收集声明名(源码: &文本, 别名映射表: &哈希映射<字符串, 字符串>) -> 声明收集 {
    让 可变 产出 = 声明收集::缺省();
    让 可变 前声明态: 选项<&'static 文本> = 无;
    // —— 类型体（struct/enum）扫描状态 ——
    // 待定类型：已见 `struct`/`enum` 关键字，值为（是否枚举，是否已见名字）；
    // 名字后遇 `{` 进入体扫描，遇 `;` 放弃（unit/tuple 结构体无可收集成员）
    让 可变 待定类型: 选项<(布尔, 布尔)> = 无;
    让 可变 类型体: 选项<类型体扫描> = 无;
    // 类型体内的括号/方括号深度：>0 时内部标识符不参与成员收集
    //（`公开(包) 字段` 可见性、`[T; N]` 数组类型、`#[属性]` 属性）
    让 可变 体圆数 = 0u32;
    让 可变 体尖数 = 0u32;
    让 可变 体方数 = 0u32;
    // —— 函数参数绑定跟踪 ——
    // 函头态：0=不在 fn 头部；1=已见 fn 等待参数括号；2=在参数括号内。
    // 括号内处于参数开始位置（`(` 或 `,` 之后）且后跟 `:` 的标识符是
    // 用户声明的参数名（`mut 名: 类型` 中 mut 透明传递）
    让 可变 函头态 = 0u32;
    // fn 名后的 `<...>` 泛型深度：`fn 名<T>(...)` 中的 `(` 不是参数括号
    让 可变 函尖数 = 0u32;
    让 可变 圆深 = 0u32;
    让 可变 参起始 = 假;
    让 可变 待参: 选项<字符串> = 无;
    // —— 闭包参数绑定跟踪（`|甲, 乙| 体`，无类型标注直接收集）——
    让 可变 闭包中 = 假;
    // 闭包参数内的括号深度：解构/类型（`|(甲, 乙): (T, T)|`）内的名字不收集
    让 可变 闭圆数 = 0u32;
    让 可变 闭起始 = 假;
    // 上一个有效 token 是否可作表达式结尾（区分位或 `a | b` 与闭包 `|甲|`）
    让 可变 前值尾 = 假;
    // 上一个 `|`（或号）token 的结束偏移：词法解析器 不合并 `||`，它是连续
    // 两个 `|` token，紧邻的第二个不得判定为闭包起始（`a || b` 是逻辑或）
    让 可变 或尾位 = 无符号机器整数::最大常量;
    // token 序列预收集：本函数内三遍扫描（声明名/库特征方法/模式绑定）
    // 共享同一份 token 序列，避免重复词法化
    让 令牌序列: 向量<词法解析器::词法令牌> = 切分令牌(源码).收集();
    让 可变 偏移 = 0;
    对于 令牌 在 &令牌序列 {
        让 文本段 = &源码[偏移..偏移 + 令牌.元素数];
        匹配 令牌.令牌类别 {
            令牌种类::标识符记号 => {
                // —— 类型头推进（struct/enum 后第一个标识符是类型名）——
                // 名字已由下方声明关键字逻辑收集为项；此处仅推进状态，
                // `公开` 修饰不消耗「等名字」态
                如果 文本段 == "struct" {
                    待定类型 = 有值((假, 假));
                } 否则 如果 文本段 == "enum" {
                    待定类型 = 有值((真, 假));
                } 否则 如果 让 有值((_, 已见名)) = &可变 待定类型
                    && !*已见名
                    && 文本段 != "pub"
                {
                    *已见名 = 真;
                }
                // —— 类型体成员收集 ——
                // 成员开始位置的标识符：枚举顶层是变体名（收集为项，变体可经
                // `::` 访问）；struct 字段与变体携带的结构体字段先入候选，
                // 等 `:` 确认后收集（`公开(包)` 可见性、`#[属性]`、数组类型
                // `[T; N]` 与泛型 `<...>` 内部的标识符不参与）
                如果 让 有值(扫描体) = &可变 类型体
                    && 体圆数 == 0
                    && 体尖数 == 0
                    && 体方数 == 0
                    && 扫描体.成员开始
                    && 文本段 != "pub"
                {
                    如果 扫描体.是否枚举 && 扫描体.深度 == 1 {
                        产出.项名集.插入(文本段.转字符串());
                    } 否则 {
                        扫描体.待确认成员 = 有值(文本段.转字符串());
                    }
                    扫描体.成员开始 = 假;
                }
                如果 让 有值(关键字) = 前声明态 {
                    如果 变量声明关键字.包含(&关键字) {
                        产出.变量名集.插入(文本段.转字符串());
                    } 否则 {
                        产出.项名集.插入(文本段.转字符串());
                    }
                }
                前声明态 = 推进声明关键字(前声明态, 文本段);
                // 函数参数名：参数开始位置的标识符（`mut` 后继续等待名字）
                如果 函头态 == 2 && 圆深 == 1 && 参起始 && 文本段 != "mut" {
                    待参 = 有值(文本段.转字符串());
                    参起始 = 假;
                }
                如果 函头态 == 0 && 文本段 == "fn" {
                    函头态 = 1;
                    函尖数 = 0;
                }
                // 闭包参数名：`|` 或 `,` 之后的名字（`mut 名` 同样透明）
                如果 闭包中 && 闭圆数 == 0 && 闭起始 && 文本段 != "mut" {
                    产出.变量名集.插入(文本段.转字符串());
                    闭起始 = 假;
                }
                // `move |甲|`：move 是闭包前缀，其后 `|` 仍是闭包起始
                前值尾 = 文本段 != "move";
            }
            令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. } => {}
            令牌种类::开圆括号 => {
                前声明态 = 无;
                如果 类型体.是否为有值() {
                    体圆数 += 1;
                }
                如果 函头态 == 1 && 函尖数 == 0 {
                    函头态 = 2;
                    圆深 = 1;
                    参起始 = 真;
                } 否则 如果 函头态 == 2 {
                    圆深 += 1;
                    参起始 = 假;
                }
                如果 闭包中 {
                    闭圆数 += 1;
                    闭起始 = 假;
                }
                待参 = 无;
                前值尾 = 假;
            }
            令牌种类::闭圆括号 => {
                前声明态 = 无;
                如果 类型体.是否为有值() {
                    体圆数 = 体圆数.饱和减(1);
                }
                如果 函头态 == 2 {
                    圆深 = 圆深.饱和减(1);
                    如果 圆深 == 0 {
                        函头态 = 0;
                    }
                    参起始 = 假;
                }
                如果 闭包中 {
                    闭圆数 = 闭圆数.饱和减(1);
                    闭起始 = 假;
                }
                待参 = 无;
                前值尾 = 真;
            }
            令牌种类::逗号 => {
                前声明态 = 无;
                如果 函头态 == 2 && 圆深 == 1 {
                    参起始 = 真;
                }
                如果 闭包中 && 闭圆数 == 0 {
                    闭起始 = 真;
                }
                // 类型体成员分隔：重置成员开始位（括号/尖括号/方括号内的
                // 逗号是类型参数分隔，不是成员分隔）
                如果 体圆数 == 0
                    && 体尖数 == 0
                    && 体方数 == 0
                    && 让 有值(扫描体) = &可变 类型体
                {
                    扫描体.成员开始 = 真;
                    扫描体.待确认成员 = 无;
                }
                // 名字后遇 `,`（无类型标注模式）：丢弃待确认候选
                待参 = 无;
                前值尾 = 假;
            }
            令牌种类::冒号 => {
                前声明态 = 无;
                // `名:` → 确认函数参数绑定（其他位置不会有待确认候选）
                如果 让 有值(名字) = 待参.取值() {
                    产出.变量名集.插入(名字);
                }
                // `字段:` → 确认结构体字段名（收作成员名；`::` 的第二冒号
                // 无候选，无副作用）
                如果 让 有值(扫描体) = &可变 类型体
                    && 让 有值(名字) = 扫描体.待确认成员.取值()
                {
                    产出.成员名集.插入(名字);
                }
                前值尾 = 假;
            }
            令牌种类::或号 => {
                前声明态 = 无;
                如果 闭包中 {
                    如果 闭圆数 == 0 {
                        闭包中 = 假;
                    }
                } 否则 如果 !前值尾 && 或尾位 != 偏移 {
                    // 前一个有效 token 不是表达式结尾，且不与上一个 `|`
                    // 相邻（`a || b` 是连续两个 `|` token）→ 闭包起始
                    //（位或 `a | b` 的 `|` 前是表达式，不进入闭包态）
                    闭包中 = 真;
                    闭圆数 = 0;
                    闭起始 = 真;
                }
                或尾位 = 偏移 + 令牌.元素数;
                待参 = 无;
                前值尾 = 假;
            }
            令牌种类::小于号 => {
                前声明态 = 无;
                如果 函头态 == 1 {
                    函尖数 += 1;
                }
                如果 类型体.是否为有值() {
                    体尖数 += 1;
                }
                待参 = 无;
                前值尾 = 假;
            }
            令牌种类::大于号 => {
                前声明态 = 无;
                如果 函头态 == 1 {
                    函尖数 = 函尖数.饱和减(1);
                }
                如果 类型体.是否为有值() {
                    体尖数 = 体尖数.饱和减(1);
                }
                待参 = 无;
                前值尾 = 假;
            }
            令牌种类::开大括号 => {
                // `struct/enum 名 {` → 进入类型体成员扫描；体内嵌套花括号
                //（变体携带的结构体体、常量表达式块）加深一层
                如果 让 有值((是否枚举, 已见名)) = 待定类型.取值() {
                    如果 已见名 {
                        类型体 = 有值(类型体扫描 {
                            是否枚举,
                            深度: 1,
                            成员开始: 真,
                            待确认成员: 无,
                        });
                        体圆数 = 0;
                        体尖数 = 0;
                        体方数 = 0;
                    }
                } 否则 如果 类型体.是否为有值()
                    && 体圆数 == 0
                    && 体尖数 == 0
                    && 体方数 == 0
                    && 让 有值(扫描体) = &可变 类型体
                {
                    扫描体.深度 += 1;
                    扫描体.成员开始 = 真;
                    扫描体.待确认成员 = 无;
                }
                前声明态 = 无;
                待参 = 无;
                前值尾 = 假;
            }
            令牌种类::闭大括号 => {
                // 类型体闭合：深度 归零退出扫描（括号/尖括号/方括号内的
                // 花括号不是类型体边界）
                如果 体圆数 == 0 && 体尖数 == 0 && 体方数 == 0 {
                    让 已退出 = 如果 让 有值(扫描体) = &可变 类型体 {
                        扫描体.深度 = 扫描体.深度.饱和减(1);
                        如果 扫描体.深度 == 0 {
                            真
                        } 否则 {
                            扫描体.成员开始 = 真;
                            扫描体.待确认成员 = 无;
                            假
                        }
                    } 否则 {
                        假
                    };
                    如果 已退出 {
                        类型体 = 无;
                    }
                }
                前声明态 = 无;
                待参 = 无;
                前值尾 = 真;
            }
            令牌种类::开方括号 => {
                // 方括号内的标识符不参与成员收集（属性、数组类型 `[T; N]`）
                如果 类型体.是否为有值() {
                    体方数 += 1;
                }
                前声明态 = 无;
                待参 = 无;
                前值尾 = 假;
            }
            令牌种类::闭方括号 => {
                如果 类型体.是否为有值() {
                    体方数 = 体方数.饱和减(1);
                }
                前声明态 = 无;
                待参 = 无;
                前值尾 = 真;
            }
            _ => {
                前声明态 = 无;
                待参 = 无;
                // `struct/enum 名;`（单元结构体）：放弃类型体等待
                如果 模式匹配!(令牌.令牌类别, 令牌种类::分号) {
                    待定类型 = 无;
                }
                前值尾 = 模式匹配!(
                    令牌.令牌类别,
                    令牌种类::字面量记号 { .. }
                        | 令牌种类::闭方括号
                        | 令牌种类::闭大括号
                        | 令牌种类::问号符
                );
            }
        }
        偏移 += 令牌.元素数;
    }
    // 库特征实现块内的方法名从保护集合剔除：它们是库 API 规定的名称，
    // 应照常参与别名替换（如 `实现 抄写器 对于 类型 { 函数 渲染（...） }`）
    产出.库方法名集 = 收集库特征方法名(&令牌序列, 源码, &产出.项名集, 别名映射表);
    对于 名字 在 &产出.库方法名集 {
        产出.项名集.移除(名字);
        产出.变量名集.移除(名字);
    }
    // 模式绑定收集（match 臂 / let 解构 / 对于 模式）：独立扫描
    收集模式绑定(&令牌序列, 源码, &可变 产出);
    产出
}

/// 推进声明关键字状态：`mut` 透明传递，其余按是否声明关键字更新
函数 推进声明关键字(前一: 选项<&'static 文本>, 文本段: &文本) -> 选项<&'static 文本> {
    如果 文本段 == "mut" {
        返回 前一;
    }
    声明关键字表.迭代().查找(|&&次索引| 次索引 == 文本段).复制值()
}

/// `实现` 块扫描状态（第二遍扫描用）
#[派生(调试)]
枚举 实现扫描 {
    /// 不在 实现 上下文中
    不在,
    /// 已见 `实现`，等待特征名/类型名（`<...>` 泛型参数内的名字忽略）
    等特征,
    /// 已见 实现 目标名，等待块开始 `{`
    有名(字符串),
    /// 在 实现 块内；`是库` 表示这是「库特征实现块」
    体内 { 是库: 布尔 },
}

/// 识别「库特征实现块」内的方法名（第二遍扫描）
///
/// 实现外部（库）特征时，`实现` 块内的方法名是库 API 规定的方法名
/// （用户从映射表抄写而来），必须照常参与别名替换；而实现用户自定义
/// 特征（`trait 可显示`）时方法名是用户取的名字，保持声明位保护。
/// 判定「库特征」的两个条件同时满足：特征名不在用户项集合中（排除
/// 同文件自定义特征），且在别名映射表中（无映射词时替换循环本就无事
/// 可做，保持保护无害，也避免跨文件自定义特征被误判）。
函数 收集库特征方法名(
    令牌序列: &[词法解析器::词法令牌],
    源码: &文本,
    项集: &哈希集合<字符串>,
    别名映射表: &哈希映射<字符串, 字符串>,
) -> 哈希集合<字符串> {
    让 可变 库方法名 = 哈希集合::新建();
    让 可变 扫描态 = 实现扫描::不在;
    // 等特征 中 `<...>` 泛型参数深度：`实现<T> 特征 对于 类型` 里 `T` 不是特征名
    让 可变 尖括深度 = 0u32;
    // 体内 内大括号深度：归零时退出 实现 块
    让 可变 花括深度 = 0u32;
    // 上一个有意义 token 是否为 `fn`（空白/注释不打断，与主循环一致）
    让 可变 前是函数 = 假;
    让 可变 偏移 = 0;
    对于 令牌 在 令牌序列 {
        让 文本段 = &源码[偏移..偏移 + 令牌.元素数];
        匹配 令牌.令牌类别 {
            令牌种类::标识符记号 => {
                匹配 &扫描态 {
                    实现扫描::不在 => {
                        如果 文本段 == "impl" {
                            扫描态 = 实现扫描::等特征;
                            尖括深度 = 0;
                        }
                    }
                    实现扫描::等特征 => {
                        如果 尖括深度 == 0 {
                            扫描态 = 实现扫描::有名(文本段.转字符串());
                        }
                    }
                    // `实现 特征 对于 类型`：特征名之后的 对于/类型名均忽略，等待 `{`
                    实现扫描::有名(_) => {}
                    实现扫描::体内 { 是库 } => {
                        如果 *是库 && 前是函数 {
                            库方法名.插入(文本段.转字符串());
                        }
                    }
                }
                前是函数 = 文本段 == "fn";
            }
            令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. } => {}
            令牌种类::开大括号 => {
                如果 让 实现扫描::有名(名字) = &扫描态 {
                    让 是库 = !项集.包含(名字) && 别名映射表.包含键(名字);
                    扫描态 = 实现扫描::体内 { 是库 };
                    花括深度 = 0;
                } 否则 如果 模式匹配!(扫描态, 实现扫描::体内 { .. }) {
                    花括深度 += 1;
                } 否则 如果 模式匹配!(扫描态, 实现扫描::等特征) {
                    // `实现 {`：非法写法，放弃跟踪
                    扫描态 = 实现扫描::不在;
                }
                前是函数 = 假;
            }
            令牌种类::闭大括号 => {
                如果 模式匹配!(扫描态, 实现扫描::体内 { .. }) {
                    如果 花括深度 == 0 {
                        扫描态 = 实现扫描::不在;
                    } 否则 {
                        花括深度 -= 1;
                    }
                }
                前是函数 = 假;
            }
            令牌种类::小于号 => {
                如果 模式匹配!(扫描态, 实现扫描::等特征) {
                    尖括深度 += 1;
                }
                前是函数 = 假;
            }
            令牌种类::大于号 => {
                如果 模式匹配!(扫描态, 实现扫描::等特征) {
                    尖括深度 = 尖括深度.饱和减(1);
                }
                前是函数 = 假;
            }
            _ => 前是函数 = 假,
        }
        偏移 += 令牌.元素数;
    }
    库方法名
}

/// 对于 模式挂起中出现的「非模式词」：声明/语句关键字
///
/// 真模式里不可能出现这些词，出现即说明挂起跨越了语句边界
/// （残留/剥离代码），须丢弃挂起，避免把后续代码里的名字误收为绑定。
常量 语句边界关键字: &[&文本] = &[
    "fn", "struct", "enum", "impl", "trait", "mod", "type", "const", "static", "let", "use", "pub",
    "return", "if", "else", "while", "loop", "match", "break", "continue", "unsafe", "async",
    "await", "move", "where",
];

/// 模式绑定收集（第三遍扫描）：match 臂 / let 解构 / 对于 模式
///
/// 模式中出现的标识符是「值绑定」（用户命名），须与函数/闭包参数一样
/// 全文件豁免替换——否则 `成功(连接) =>` 的 `连接`（撞 `连接`=连接
/// 映射键）会被误替换为 `连接`（实测确认的缺陷）。识别规则：
/// - match 臂：`=>`（`等号码`+`大于号` 相邻两 token）向左回溯到臂起点
///   （深度 0 的 `,`/`{`/`;`），区间内标识符按模式语法过滤后收集；
///   守卫表达式中的名字同为值使用，一并收集无害（方法调用位与
///   `::` 路径位不查值绑定集合，不会过度豁免库 API）；
/// - let 解构：`let` 后解构括号（`let (甲, 乙) = …`、
///   `let 点 { x, y } = …`）内的名字；`=` 结束（类型标注在括号外，
///   不受影响），if-let/while-let 同形覆盖；
/// - 对于 模式：`对于` 到 `在` 之间的名字（`对于 &长度 在 …`、
///   `对于 (键, 值) 在 …`）；挂起期间遇声明/语句关键字即丢弃。
///   `实现 … 对于 类型 {` 的 对于 由 实现 头部状态排除。
///
/// 过滤见 [`是模式绑定`]：`::` 路径段（`错误::连接` 的
/// `连接` 是库变体）、后跟 `(`/`{`/`[` 的构造路径（`有值(…)`、
/// `点 { … }`）、后跟 `:` 的字段名（`x: 甲` 的 `x`）、`mut`/`ref`
/// 修饰符都不是绑定。
函数 收集模式绑定(
    令牌序列: &[词法解析器::词法令牌],
    源码: &文本,
    产出: &可变 声明收集,
) {
    // —— let 解构态 / 对于 模式态 / 实现 头部区间 ——
    让 可变 模式态 = 假;
    让 可变 模式深 = 0u32;
    让 可变 循环态 = 假;
    让 可变 循环深 = 0u32;
    让 可变 循环挂起: 向量<字符串> = 向量::新建();
    // `实现 … 对于 类型 {` 的头部区间：其间出现的 `对于` 是 实现 语法
    让 可变 实现头中 = 假;

    让 可变 偏移 = 0usize;
    对于 下标 在 0..令牌序列.元素数() {
        让 形态 = 令牌序列[下标].令牌类别;
        让 文本段 = &源码[偏移..偏移 + 令牌序列[下标].元素数];
        匹配 形态 {
            令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. } => {}
            令牌种类::标识符记号 => {
                如果 文本段 == "impl" {
                    实现头中 = 真;
                }
                // —— 对于 模式态 ——
                如果 循环态 {
                    如果 文本段 == "in" && 循环深 == 0 {
                        // 模式结束：提交挂起绑定
                        产出.变量名集.扩展(循环挂起.耗尽(..));
                        循环态 = 假;
                    } 否则 如果 循环深 == 0
                        && (文本段 == "for" || 语句边界关键字.包含(&文本段))
                    {
                        // 遇嵌套 对于 重启挂起；遇声明/语句关键字丢弃挂起
                        循环挂起.清空();
                        循环态 = 文本段 == "for";
                        循环深 = 0;
                    } 否则 如果 是模式绑定(令牌序列, 下标, 文本段) {
                        循环挂起.推入(文本段.转字符串());
                    }
                } 否则 如果 文本段 == "for" && !实现头中 {
                    循环态 = 真;
                    循环深 = 0;
                    循环挂起.清空();
                }
                // —— let 解构态（`=` 之前括号内的名字是绑定）——
                如果 模式态 && 模式深 > 0 && 是模式绑定(令牌序列, 下标, 文本段) {
                    产出.变量名集.插入(文本段.转字符串());
                }
                如果 文本段 == "let" {
                    模式态 = 真;
                    模式深 = 0;
                }
            }
            令牌种类::开圆括号 | 令牌种类::开方括号 => {
                如果 模式态 {
                    模式深 += 1;
                }
                如果 循环态 {
                    循环深 += 1;
                }
            }
            令牌种类::开大括号 => {
                // 实现 头部结束（进入块体）
                实现头中 = 假;
                如果 模式态 {
                    模式深 += 1;
                }
                如果 循环态 {
                    循环深 += 1;
                }
            }
            令牌种类::闭圆括号 | 令牌种类::闭方括号 | 令牌种类::闭大括号 => {
                模式深 = 模式深.饱和减(1);
                循环深 = 循环深.饱和减(1);
            }
            令牌种类::分号 => {
                实现头中 = 假;
                模式态 = 假;
                模式深 = 0;
                循环挂起.清空();
                循环态 = 假;
                循环深 = 0;
            }
            令牌种类::等号码 => {
                // `let 模式 =`：模式结束（`=` 之后是表达式，名字照常替换）；
                // 对于 模式里 `=` 不合法（防御）
                如果 模式态 && 模式深 == 0 {
                    模式态 = 假;
                }
                如果 循环态 && 循环深 == 0 {
                    循环挂起.清空();
                    循环态 = 假;
                }
            }
            令牌种类::冒号 => {
                // `let 名: 类型` 的 `:` 是类型标注分隔——其后是类型（可能含
                // `[`/`<`/`(`），不再是模式绑定。须立即结束 let 态，否则类型
                // 中的 `[` 会把 let 深度抬回非零、`=` 无法结束 let 态，导致类型
                // 内的别名被误收为值绑定而全文件豁免替换（weix-1 #15）。
                // `::` 是路径分隔（两个相邻 冒号 token），不代表类型标注，不能结束。
                如果 模式态
                    && 模式深 == 0
                    && !前一有意义索引(令牌序列, 下标)
                        .有值且(|前索引| 令牌序列[前索引].令牌类别 == 令牌种类::冒号)
                    && !后继有意义索引(令牌序列, 下标)
                        .有值且(|数量| 令牌序列[数量].令牌类别 == 令牌种类::冒号)
                {
                    模式态 = 假;
                    模式深 = 0;
                }
                // 对于 模式里 `:` 不合法（类型标注等非循环场景，防御）
                如果 循环态 && 循环深 == 0 {
                    循环挂起.清空();
                    循环态 = 假;
                }
            }
            令牌种类::小于号 如果 循环态 && 循环深 == 0 => {
                // 对于 模式里 `<` 不合法（泛型等非循环场景，防御）
                循环挂起.清空();
                循环态 = 假;
            }
            令牌种类::大于号 => {
                // `=>`（`等号码`+`大于号` 相邻两 token）：match 臂箭头 → 回溯收集
                //（索引相邻即两 token 间无其他 token，`=>` 无空白）
                如果 让 有值(前索引) = 前一有意义索引(令牌序列, 下标)
                    && 令牌序列[前索引].令牌类别 == 令牌种类::等号码
                    && 前索引 == 下标 - 1
                {
                    收集匹配臂绑定(令牌序列, 偏移, 下标, 源码, 产出);
                }
            }
            _ => {}
        }
        偏移 += 令牌序列[下标].元素数;
    }
}

/// `=>` 回溯：收集 match 臂模式中的绑定名
///
/// 从箭头（索引 `箭索引`，起点偏移 `箭偏移`）向左回溯到臂起点
/// （深度 0 的 `,`/`{`/`;`），区间内标识符经 [`是模式绑定`]
/// 过滤后收为值绑定。`{}`/`()`/`[]` 深度配对处理结构体模式
/// （`点 { x, y }`）与嵌套模式。
///
/// 越界防护（weix-1 #27）：带块臂体（`=> { … }`）的**下一臂**回溯时
/// 会先遇到上一臂的块闭合 `}`；若不识别，深度失衡后 `,`/`;` 不再
/// 终止，回溯将穿透上一臂语句，把类型标注（`让 x: T = …` 的 `T`）
/// 等裸标识符误收为值绑定 → 其全文件豁免替换（`无符号机器整数`
/// = 无符号机器整数 实测不被翻译，产物 E0425）。块体臂的逗号可省略，其闭合
/// `}` 即当前臂模式的左边界：识别后立即截止
/// （见 [`闭花括号终结臂体`]）。
函数 收集匹配臂绑定(
    令牌序列: &[词法解析器::词法令牌],
    箭偏移: 无符号机器整数,
    箭索引: 无符号机器整数,
    源码: &文本,
    产出: &可变 声明收集,
) {
    // 箭索引 前一个有意义 token 是 `=`（调用方已确认 `=>` 相邻）
    让 有值(等索引) = 前一有意义索引(令牌序列, 箭索引) 否则 {
        返回;
    };
    让 可变 深度 = 0u32;
    // 反向累计各 token 的起点偏移（切分令牌 连续覆盖全源）
    让 可变 起点 = 箭偏移.饱和减(令牌序列[等索引].元素数);
    对于 内索引 在 (0..等索引).逆序() {
        起点 = 起点.饱和减(令牌序列[内索引].元素数);
        让 形态 = 令牌序列[内索引].令牌类别;
        匹配 形态 {
            令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. } => {}
            令牌种类::闭圆括号 | 令牌种类::闭方括号 => 深度 += 1,
            令牌种类::闭大括号 => {
                // 上一臂块体闭合即当前臂模式左边界：就此截止，
                // 不得穿入上一臂体（见函数文档「越界防护」）
                如果 深度 == 0 && 闭花括号终结臂体(令牌序列, 内索引) {
                    中断;
                }
                深度 += 1;
            }
            令牌种类::开圆括号 | 令牌种类::开方括号 => {
                如果 深度 == 0 {
                    中断; // 模式区间外的括号（异常输入）：保守停止
                }
                深度 -= 1;
            }
            令牌种类::开大括号 => {
                如果 深度 == 0 {
                    中断; // match 体（或宏体）的起点
                }
                深度 -= 1;
            }
            令牌种类::逗号 | 令牌种类::分号 => {
                如果 深度 == 0 {
                    中断; // 上一臂的分隔或语句边界
                }
            }
            令牌种类::标识符记号 => {
                让 文本段 = &源码[起点..起点 + 令牌序列[内索引].元素数];
                如果 是模式绑定(令牌序列, 内索引, 文本段) {
                    产出.变量名集.插入(文本段.转字符串());
                }
            }
            _ => {}
        }
    }
}

/// `}`（索引 `闭索引`）是否为「臂块体闭合」（`=> { … }` 的收尾）
///
/// 判定：向左找配对的 `{`，其前一个有意义 token 是 `=>` 的 `>`
/// （`等号码`+`大于号` 相邻）则为臂体闭合。结构体模式的 `}`（配对 `{` 前
/// 是路径名，如 `点 { x }`、`点<T> { x }`）返回 false，照常参与
/// 深度配对。
函数 闭花括号终结臂体(令牌序列: &[词法解析器::词法令牌], 闭索引: 无符号机器整数) -> 布尔 {
    让 可变 深度 = 0u32;
    让 可变 次索引 = 闭索引;
    当 次索引 > 0 {
        次索引 -= 1;
        匹配 令牌序列[次索引].令牌类别 {
            令牌种类::闭大括号 => 深度 += 1,
            令牌种类::开大括号 => {
                如果 深度 == 0 {
                    // 配对 `{`：前一个有意义 token 是 `=>` 的 `>`？
                    返回 前一有意义索引(令牌序列, 次索引).有值且(|前索引| {
                        令牌序列[前索引].令牌类别 == 令牌种类::大于号
                            && 前一有意义索引(令牌序列, 前索引)
                                .有值且(|前一位置| 令牌序列[前一位置].令牌类别 == 令牌种类::等号码 && 前一位置 == 前索引 - 1)
                    });
                }
                深度 -= 1;
            }
            _ => {}
        }
    }
    假
}

/// 模式内标识符的「值绑定」判定
///
/// `mut`/`ref` 修饰符不是名字；`::` 路径段（变体/常量路径）、后跟
/// `(`/`{`/`[` 的构造路径（`有值(…)`、`点 { … }`）、后跟 `:` 的
/// 字段名（`x: 甲` 的 `x`，兼作 `::` 前段判定）都不是绑定。
函数 是模式绑定(令牌序列: &[词法解析器::词法令牌], 下标: 无符号机器整数, 文本段: &文本) -> 布尔 {
    如果 文本段 == "mut" || 文本段 == "ref" {
        返回 假;
    }
    如果 让 有值(数量) = 后继有意义索引(令牌序列, 下标) {
        匹配 令牌序列[数量].令牌类别 {
            令牌种类::冒号
            | 令牌种类::开圆括号
            | 令牌种类::开大括号
            | 令牌种类::开方括号 => 返回 假,
            _ => {}
        }
    }
    // 前是 `::` 后段（前两个有意义 token 都是 冒号）→ 路径段，不是绑定
    如果 让 有值(前索引) = 前一有意义索引(令牌序列, 下标)
        && 令牌序列[前索引].令牌类别 == 令牌种类::冒号
        && 让 有值(前一位置) = 前一有意义索引(令牌序列, 前索引)
        && 令牌序列[前一位置].令牌类别 == 令牌种类::冒号
    {
        返回 假;
    }
    真
}

/// 下标 之前（不含 下标）第一个有意义 token 的索引（跳过空白/注释）
函数 前一有意义索引(令牌序列: &[词法解析器::词法令牌], 下标: 无符号机器整数) -> 选项<无符号机器整数> {
    令牌序列[..下标].迭代().反向位置(|令牌项| !是琐碎词(令牌项.令牌类别))
}

/// 下标 之后（不含 下标）第一个有意义 token 的索引（跳过空白/注释）
函数 后继有意义索引(令牌序列: &[词法解析器::词法令牌], 下标: 无符号机器整数) -> 选项<无符号机器整数> {
    令牌序列[下标 + 1..]
        .迭代()
        .取位置(|令牌项| !是琐碎词(令牌项.令牌类别))
        .变换(|前索引| 前索引 + 下标 + 1)
}

/// 空白/注释（trivia）：不参与相邻性判断
函数 是琐碎词(形态: 令牌种类) -> 布尔 {
    模式匹配!(
        形态,
        令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. }
    )
}

/// 将源码中的中文别名替换为英文标识符（仅替换标识符 token）
///
/// 输入应为已完成关键字转译的代码（声明关键字已是英文形式）。
/// 声明位的标识符（如 `fn 绝对值()`、`让 字符串 = 1`）保留原样，
/// 且这些用户声明名在文件内的使用处也不替换；`::` 限定后的路径段
/// 仅对「变量名」不豁免（如 `字符串::新建` 里的 `新建` 是库 API，
/// 照常替换），用户声明的项可经 `::` 访问（`接口错误::错误请求`），
/// 仍豁免。库特征实现块内的方法名是库 API 名称，照常替换（见模块文档）。
///
/// # 参数
/// - `source`: 待替换的源代码字符串
/// - `别名映射表`: 中文别名 → 英文原名 的映射表
///
/// # 返回
/// 替换后的源代码字符串
公开 函数 替换别名(源码: &文本, 别名映射表: &哈希映射<字符串, 字符串>) -> 字符串 {
    替换别名并映射(源码, 别名映射表).产出
}

/// 同 [`替换别名`]，同时产出编辑表（本阶段输入坐标）
公开 函数 替换别名并映射(
    源码: &文本,
    别名映射表: &哈希映射<字符串, 字符串>,
) -> 替换结果 {
    替换别名并上下文(源码, 别名映射表, 无)
}

/// 同 [`替换别名并映射`]，附项目级声明上下文（跨文件声明豁免）
///
/// `project` 为 无 时行为与 [`替换别名并映射`] 完全一致。
/// 提供上下文时在逐文件豁免之上额外豁免：
/// - 项目声明名（含其他文件声明的项/结构体字段）的裸使用处；
/// - 项目模块名的裸使用处；
/// - 以 `包`/`super`/`self`/项目模块名/项目项名为根的 `::` 路径链：
///   链内**与项目声明名同名**的段豁免（`包::平台Linux::Linux内存源::新建`
///   ——跨文件引用成员与声明侧一致，避免 E0599）；链内非项目名
///   （`源码映射项::新建` 的 `新建` 未定义于项目）照常替换。
///   `::` 后非项目根的段（`盒子::新建`）同样照常替换：`新建` 是库 API。
公开 函数 替换别名并上下文(
    源码: &文本,
    别名映射表: &哈希映射<字符串, 字符串>,
    项目上下文: 选项<&项目上下文>,
) -> 替换结果 {
    替换别名并上下文并模块路径(源码, 别名映射表, &哈希映射::新建(), 项目上下文)
}

/// 同 [`替换别名并上下文`]，附模块路径表（use 之外的模块前缀转译）
///
/// 管线的「模块路径替换」阶段只处理 use 语句；表达式与属性位置的
/// `模块词::项`（`异步运行时::睡眠`、`#[异步运行时::主函数]`）在本函数内
/// 回退模块路径表完成（office-zb #10/#18：此前「模块词」保留、「项」被
/// 别名替换，产物 `异步运行时::main` 报 E0433）。回退规则：
/// - 仅**路径根位置**（后跟 `::`、且前不是 `::` 的段）触发；
/// - 别名表命中优先——标识符语义覆盖模块语义（`路径::新建` 的 `路径`
///   是 `路径类型` 而非 `路径模块` 模块）；
/// - 路径根位上的字段/变量名豁免不适用（见 `使用豁免` 的根位分支）；
/// - 替换值做 包 名连字符规范化（`-` → `_`）。
公开 函数 替换别名并上下文并模块路径(
    源码: &文本,
    别名映射表: &哈希映射<字符串, 字符串>,
    模块路径表: &哈希映射<字符串, 字符串>,
    项目上下文: 选项<&项目上下文>,
) -> 替换结果 {
    // 映射表为空时直接返回，避免不必要的词法分析开销
    如果 别名映射表.是否为空() && 模块路径表.是否为空() {
        返回 替换结果 {
            产出: 源码.转字符串(),
            编辑表: 向量::新建(),
        };
    }
    // 第一遍：收集用户声明名与库特征方法名（使用处豁免见 声明收集）
    让 声明结果 = 收集声明名(源码, 别名映射表);
    // 单个 冒号 跟踪：词法解析器 把 `::` 拆成两个 冒号 token
    让 可变 上次冒号 = 假;
    // token 序列化收集：`.方法()` 判定需向后看一位（下一个有意义 token
    // 是否为 `(`），字段访问 `实例.字段` 与方法调用 `实例.方法()` 的
    // 豁免集合不同
    让 令牌序列: 向量<词法解析器::词法令牌> = 切分令牌(源码).收集();
    让 可变 产出 = 字符串::新建();
    让 可变 编辑表 = 向量::新建();
    让 可变 当前偏移 = 0;
    // 上一个有意义 token 若是声明关键字，记录其文本（`mut` 透明传递）；
    // 空白/注释不重置该状态
    让 可变 前声明态: 选项<&'static 文本> = 无;
    // 上一个有意义 token 是否为 `::`（两个连续 冒号 token 的第二个）
    让 可变 前路径分隔 = 假;
    // 上一个有意义 token 是否为 `.`（成员访问/方法链）
    让 可变 前点号 = 假;
    // —— 项目路径链跟踪（仅 项目上下文 为 有值 时生效）——
    // 待项目根：上一标识符是项目根候选（包/模块名/项名），
    // 等待 `::` 确认；项目路径中：根段已确认，链内段按项目声明名豁免
    让 可变 待项目根 = 假;
    让 可变 项目路径中 = 假;

    对于 (索引, 令牌) 在 令牌序列.迭代().枚举() {
        让 长度 = 令牌.元素数;
        让 文本段 = &源码[当前偏移..当前偏移 + 长度];
        匹配 令牌.令牌类别 {
            令牌种类::标识符记号 => {
                // `.方法()` 位：`.` 后的标识符且下一个有意义 token 是 `(`
                //（字段名不是方法名，豁免集合见下方 使用豁免）
                让 方法位 = 前点号 && 后继有意义是开括号(&令牌序列, 索引);
                // 路径根位置（首段）：后跟 `::` 且前不是 `::` 的标识符——
                // `模块词::项` 的首段。字段/变量不可经 `::` 访问，根位豁免
                // 不适用（office-zb #27）；模块词回退替换亦仅限根位
                让 路径头位 =
                    !前路径分隔 && 后继有意义是路径分隔(&令牌序列, 索引);
                // 项目路径链：根段后跟 `::` 时链内段按项目声明名豁免。
                // 根段确认依赖上一标识符留存的候选标记与当前 `::` 状态
                让 项目链中 = 项目上下文.是否为有值()
                    && (项目路径中 || (待项目根 && 前路径分隔));
                如果 项目链中 {
                    项目路径中 = 真;
                }
                // 声明位保护：紧随声明关键字的名字是用户自己的定义；
                // 例外——库特征实现块内 `fn` 后的方法名是库 API 名称
                //（见 收集库特征方法名），照常参与替换
                让 声明保护 = 前声明态.是否为有值()
                    && !(前声明态 == 有值("fn") && 声明结果.库方法名集.包含(文本段));
                // 各位置豁免集合：
                // - 链内：仅项目声明名（项/模块）——`平台Linux::新建` 豁免，
                //   未定义于项目的 `源码映射项::新建` 照常替换（与教程
                //   `fn 新建` 定义侧一致）；
                // - `::` 后非链（根非项目根）：无项目上下文时保留旧行为
                //   （本文件项名豁免，`接口错误::错误请求`）；有上下文时
                //   一律按库 API 替换（`盒子::新建` 的同名项目项不得误伤）；
                // - `.方法()` 位：仅项目方法名（项集合）——`编辑表.长度()`
                //   的 `长度` 是 `新建向量::元素数` 调用，字段名豁免不适用于方法位；
                // - 其他：本文件声明名 + 项目裸使用处豁免（含结构体字段）
                让 使用豁免 = 如果 项目链中 {
                    声明结果.项名集.包含(文本段)
                        || 项目上下文
                            .有值且(|前索引| 前索引.项名集.包含(文本段) || 前索引.模块名集.包含(文本段))
                } 否则 如果 前路径分隔 {
                    项目上下文.是否为无() && 声明结果.项名集.包含(文本段)
                } 否则 如果 方法位 {
                    声明结果.项名集.包含(文本段) || 项目上下文.有值且(|前索引| 前索引.项名集.包含(文本段))
                } 否则 如果 路径头位 {
                    // 路径根位（后跟 `::`）：字段/变量/裸名豁免不适用——它们
                    // 不可经 `::` 访问。缺陷回归（office-zb #27 字段场景）：
                    // 字段名与词表词撞名（如「天数」=Days）时，`天数::新建`
                    // 曾因字段豁免保留「天数」、只替换段位 → `天数::新建`
                    // 报 E0433；字面量/字段访问位等非根位仍按字段豁免。
                    // 仅本文件项名与项目项名/模块名（路径链根）在根位豁免
                    声明结果.项名集.包含(文本段) || 项目上下文.有值且(|前索引| 前索引.是路径根(文本段))
                } 否则 {
                    声明结果.项名集.包含(文本段)
                        || 声明结果.变量名集.包含(文本段)
                        || 声明结果.成员名集.包含(文本段)
                        // 项目声明名（项+字段，含其他文件声明）与项目根词
                        //（模块名；包/super/self 为英文，替换表不会命中，
                        // 在此仅作为路径链起点）
                        || 项目上下文.有值且(|前索引| {
                            前索引.裸用豁免(文本段) || 前索引.是路径根(文本段)
                        })
                };
                如果 声明保护 || 使用豁免 {
                    // 声明位标识符或用户声明名的使用处：保留原样
                    产出.推入字符串(文本段);
                } 否则 如果 让 有值(英文值) = 别名映射表.获取(文本段) {
                    编辑表.推入(源映射条目::新建条目(当前偏移, 长度, 文本段, 英文值));
                    产出.推入字符串(英文值);
                } 否则 如果 路径头位 && 让 有值(英文值) = 模块路径表.获取(文本段) {
                    // 路径根位回退模块路径表：`异步运行时::睡眠` → `tokio::sleep`、
                    // `#[异步运行时::主函数]` → `#[tokio::main]`（office-zb #10/#18）。
                    // use 语句内已在管线模块路径阶段替换，此处覆盖表达式/属性位置
                    让 归一化 = 包::模块路径::规范化包名连字符(英文值);
                    让 替换值 = 归一化.作为解引用().解包或用(英文值);
                    编辑表.推入(源映射条目::新建条目(当前偏移, 长度, 文本段, 替换值));
                    产出.推入字符串(替换值);
                } 否则 {
                    产出.推入字符串(文本段);
                }
                // 根段候选判定（基于母语原文；`包`等已在词法阶段转为英文）
                待项目根 = 项目上下文.有值且(|前索引| 前索引.是路径根(文本段));
                // `让 mut 名称`：声明位内的 mut 透明传递声明状态；
                // `&mut 类型` 等非声明位的 mut 不传递，库类型引用仍被替换
                前声明态 = 推进声明关键字(前声明态, 文本段);
                前路径分隔 = 假;
                前点号 = 假;
            }
            令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. } => {
                产出.推入字符串(文本段);
                // 空白与注释不打断声明状态、路径限定状态与成员访问状态
            }
            _ => {
                产出.推入字符串(文本段);
                // 符号终结声明位；连续两个 冒号 构成 `::` 路径限定
                前声明态 = 无;
                让 是冒号 = 模式匹配!(令牌.令牌类别, 令牌种类::冒号);
                // 非 冒号 符号终结项目路径链（`::` 的冒号保持链状态）
                如果 !是冒号 {
                    项目路径中 = 假;
                    待项目根 = 假;
                }
                前路径分隔 = 如果 是冒号 {
                    前路径分隔 || 上次冒号
                } 否则 {
                    假
                };
                上次冒号 = 是冒号;
                前点号 = 模式匹配!(令牌.令牌类别, 令牌种类::圆点);
            }
        }
        当前偏移 += 长度;
    }
    替换结果 { 产出, 编辑表 }
}

/// 下一个有意义 token（跳过空白/注释）是否为 `(`
///
/// 判定标识符处于「方法调用位」（`实例.方法()`）而非「字段访问位」
///（`实例.字段`）——两者豁免集合不同（字段名不是方法名）。
/// 行选择上限：词法解析器 的 `词法令牌` 仅含 令牌类别/元素数，`令牌序列` 与源码
/// 对齐，索引索引即偏移序位。
函数 后继有意义是开括号(令牌序列: &[词法解析器::词法令牌], 索引: 无符号机器整数) -> 布尔 {
    令牌序列
        .获取(索引 + 1..)
        .取值或默认()
        .迭代()
        .查找(|令牌项| {
            !模式匹配!(
                令牌项.令牌类别,
                令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. }
            )
        })
        .有值且(|令牌项| 模式匹配!(令牌项.令牌类别, 令牌种类::开圆括号))
}

/// 下一个有意义 token（跳过空白/注释）是否为 `::`
///
/// 判定标识符处于「路径根位置」（`模块词::项` 的首段）。词法解析器 将
/// `::` 拆分为两个连续 冒号 token；空白/注释不打断（与主循环
/// `上次冒号` 状态对空白的处理一致）。
函数 后继有意义是路径分隔(令牌序列: &[词法解析器::词法令牌], 索引: 无符号机器整数) -> 布尔 {
    让 可变 冒号数 = 0;
    对于 令牌项 在 令牌序列.获取(索引 + 1..).取值或默认() {
        如果 模式匹配!(
            令牌项.令牌类别,
            令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. }
        ) {
            继续;
        }
        如果 模式匹配!(令牌项.令牌类别, 令牌种类::冒号) {
            冒号数 += 1;
            如果 冒号数 >= 2 {
                返回 真;
            }
            继续;
        }
        返回 假;
    }
    假
}

#[配置(测试)]
模块 单元测试 {
    使用 超级::*;

    函数 别名映射表() -> 哈希映射<字符串, 字符串> {
        哈希映射::从([
            ("绝对值".转字符串(), "abs".转字符串()),
            ("字符串".转字符串(), "String".转字符串()),
        ])
    }

    #[测试]
    函数 测试方法调用与类型位替换() {
        让 产出 = 替换别名("let s: 字符串 = x.绝对值();", &别名映射表());
        断言相等!(产出, "let s: String = x.abs();");
    }

    #[测试]
    函数 测试声明位保留() {
        让 产出 = 替换别名("fn 绝对值() {}\nlet 字符串 = 1;", &别名映射表());
        断言相等!(产出, "fn 绝对值() {}\nlet 字符串 = 1;");
    }

    #[测试]
    函数 测试声明名使用处保留() {
        // 用户声明名在使用处同样豁免：声明位保护不能只保护声明点
        让 产出 = 替换别名("let 字符串 = 1;\nlet y = 字符串 + 2;", &别名映射表());
        断言相等!(产出, "let 字符串 = 1;\nlet y = 字符串 + 2;");
    }

    #[测试]
    函数 测试未声明别名使用处照常替换() {
        // 无用户声明撞名时，使用处照常替换
        让 产出 = 替换别名("let y = 字符串::from(x);", &别名映射表());
        断言相等!(产出, "let y = String::from(x);");
    }

    #[测试]
    函数 测试限定路径段不豁免() {
        // `::` 限定后的路径段是库 API 访问，不受用户声明名豁免；
        // 裸使用处（第一行声明与第三行变量引用）仍豁免
        让 映射表 = 哈希映射::从([
            ("字符串".转字符串(), "String".转字符串()),
            ("新建".转字符串(), "new".转字符串()),
        ]);
        让 产出 = 替换别名(
            "let 新建 = 5;\nlet s = 字符串::新建();\nlet y = 新建;",
            &映射表,
        );
        断言相等!(产出, "let 新建 = 5;\nlet s = String::new();\nlet y = 新建;");
    }

    #[测试]
    函数 测试结构体与常量声明保留() {
        让 产出 = 替换别名("struct 字符串;\nconst 绝对值: i32 = 1;", &别名映射表());
        断言相等!(产出, "struct 字符串;\nconst 绝对值: i32 = 1;");
    }

    #[测试]
    函数 测试让可变声明保留() {
        // mut 透明传递声明状态，变量名仍受保护
        让 产出 = 替换别名("let mut 绝对值 = 1;", &别名映射表());
        断言相等!(产出, "let mut 绝对值 = 1;");
    }

    #[测试]
    函数 测试引用可变类型仍替换() {
        // `&mut 类型` 是非声明位，库类型引用仍应替换
        让 产出 = 替换别名("fn f(x: &mut 字符串) {}", &别名映射表());
        断言相等!(产出, "fn f(x: &mut String) {}");
    }

    #[测试]
    函数 测试函数参数绑定保留() {
        // 函数参数名是值绑定（用户命名）：声明与使用处均保留，
        // 与格式化串中的 `{路径}` 保持一致（避免 E0425）
        让 映射表 = 哈希映射::从([("路径".转字符串(), "Path".转字符串())]);
        让 源码 = "fn 完整网址(路径: &str) -> String { format!(\"{路径}\") }";
        让 产出 = 替换别名(源码, &映射表);
        断言相等!(产出, 源码);
    }

    #[测试]
    函数 测试函数参数类型位照常替换() {
        // 参数「类型」位置的映射词照常替换，只保护名字
        让 映射表 = 哈希映射::从([
            ("路径".转字符串(), "Path".转字符串()),
            ("字符串".转字符串(), "String".转字符串()),
        ]);
        让 产出 = 替换别名("fn f(路径: &字符串) {}", &映射表);
        断言相等!(产出, "fn f(路径: &String) {}");
    }

    #[测试]
    函数 测试闭包参数绑定保留() {
        让 映射表 = 哈希映射::从([("值".转字符串(), "values".转字符串())]);
        让 产出 = 替换别名("let f = |值| 值 + 1;", &映射表);
        断言相等!(产出, "let f = |值| 值 + 1;");
    }

    #[测试]
    函数 测试移动闭包参数绑定保留() {
        让 映射表 = 哈希映射::从([("值".转字符串(), "values".转字符串())]);
        让 产出 = 替换别名("let f = move |值| 值 + 1;", &映射表);
        断言相等!(产出, "let f = move |值| 值 + 1;");
    }

    #[测试]
    函数 测试按位或不判为闭包() {
        // `a | b` 的 `|` 前是表达式结尾，不是闭包起始；`值` 照常替换
        让 映射表 = 哈希映射::从([("值".转字符串(), "values".转字符串())]);
        让 产出 = 替换别名("let r = a | 值;", &映射表);
        断言相等!(产出, "let r = a | values;");
    }

    #[测试]
    函数 测试逻辑或不判为闭包() {
        // `a || 值` 是两个连续的 `|` token：第二个不得判定为闭包起始
        让 映射表 = 哈希映射::从([("值".转字符串(), "values".转字符串())]);
        让 产出 = 替换别名("let r = a || 值;", &映射表);
        断言相等!(产出, "let r = a || values;");
    }

    #[测试]
    函数 测试空参数闭包不判为绑定() {
        // `|| 值` 是零参数闭包：`值` 不是绑定名，照常替换
        让 映射表 = 哈希映射::从([("值".转字符串(), "values".转字符串())]);
        让 产出 = 替换别名("let f = || 值;", &映射表);
        断言相等!(产出, "let f = || values;");
    }

    #[测试]
    函数 测试声明关键字与名字之间的注释() {
        让 产出 = 替换别名("fn /* 说明 */ 绝对值() {}", &别名映射表());
        断言相等!(产出, "fn /* 说明 */ 绝对值() {}");
    }

    #[测试]
    函数 测试实现目标仍替换() {
        // 实现 后的特征/类型多为库 API，不在保护名单内
        让 产出 = 替换别名("impl 字符串 for 客户端 {}", &别名映射表());
        断言相等!(产出, "impl String for 客户端 {}");
    }

    #[测试]
    函数 测试用户项限定路径豁免() {
        // 用户声明的项可经 `::` 访问：调用处仍豁免，与定义侧一致（避免 E0599）
        让 映射表 = 哈希映射::从([
            ("错误请求".转字符串(), "bad_request".转字符串()),
            ("未找到".转字符串(), "not_found".转字符串()),
        ]);
        让 源码 = "struct 接口错误;\nimpl 接口错误 {\n    fn 错误请求() {}\n    fn 未找到() {}\n}\nlet e = 接口错误::错误请求();";
        让 产出 = 替换别名(源码, &映射表);
        断言相等!(产出, 源码);
    }

    #[测试]
    函数 测试库特征实现块方法替换() {
        // 库特征实现块内的方法名是库 API 名称，照常替换（避免 E0407/E0046）
        让 映射表 = 哈希映射::从([
            ("抄写器".转字符串(), "Scribe".转字符串()),
            ("渲染".转字符串(), "render".转字符串()),
            ("响应".转字符串(), "Response".转字符串()),
        ]);
        让 产出 = 替换别名(
            "impl 抄写器 for 接口错误 {\n    fn 渲染(self, r: &mut 响应) { r.渲染(); }\n}",
            &映射表,
        );
        断言相等!(
            产出,
            "impl Scribe for 接口错误 {\n    fn render(self, r: &mut Response) { r.render(); }\n}"
        );
    }

    #[测试]
    函数 测试用户特征实现方法保留() {
        // 用户自定义特征（非映射词）的实现：方法名是用户取的，保持保护；
        // 特征声明与实现均保留中文
        让 映射表 = 哈希映射::从([("描述".转字符串(), "describe".转字符串())]);
        让 源码 = "trait 可显示 {\n    fn 描述(&self);\n}\nimpl 可显示 for 狗 {\n    fn 描述(&self) {}\n}\n狗.描述();";
        让 产出 = 替换别名(源码, &映射表);
        断言相等!(产出, 源码);
    }

    #[测试]
    函数 测试字符串字面量与注释不动() {
        让 产出 = 替换别名("println!(\"绝对值\"); // 绝对值", &别名映射表());
        断言相等!(产出, "println!(\"绝对值\"); // 绝对值");
    }

    #[测试]
    函数 测试结构体字段名保留() {
        // 结构体字段名是用户命名（撞 `值`=values 映射键）：定义/构造/访问处
        // 全豁免；字段不可经 `::` 访问故收作值绑定
        让 映射表 = 哈希映射::从([("值".转字符串(), "values".转字符串())]);
        让 源码 = "struct 容器 { 值: i32 }\nlet c = 容器 { 值: 1 };\nlet x = c.值;";
        让 产出 = 替换别名(源码, &映射表);
        断言相等!(产出, 源码);
    }

    #[测试]
    函数 测试枚举变体名保留() {
        // 枚举变体名是用户命名（撞 `保留`=保留、`丢弃`=drop 映射键）：
        // 定义与 `::` 限定使用处均豁免（变体可经 `::` 访问，收作项）
        让 映射表 = 哈希映射::从([
            ("保留".转字符串(), "retain".转字符串()),
            ("丢弃".转字符串(), "drop".转字符串()),
        ]);
        让 源码 = "enum 判定结果 { 保留, 丢弃 }\nlet r = 判定结果::保留;";
        让 产出 = 替换别名(源码, &映射表);
        断言相等!(产出, 源码);
    }

    #[测试]
    函数 测试枚举变体结构体字段保留() {
        // 变体携带的结构体字段同受豁免；反例——无声明时映射词照常替换
        让 映射表 = 哈希映射::从([("内容".转字符串(), "contents".转字符串())]);
        让 源码 = "enum 消息 { 退出, 写入 { 内容: String } }\nlet m = 消息::写入 { 内容: String::new() };";
        让 产出 = 替换别名(源码, &映射表);
        断言相等!(产出, 源码);
        让 产出2 = 替换别名("let x = 内容 + 1;", &映射表);
        断言相等!(产出2, "let x = contents + 1;");
    }

    #[测试]
    函数 测试公开结构体字段保留() {
        // 公开 与 公开(包) 可见性修饰的字段名收集（可见性修饰不消耗
        // 成员开始位，括号内标识符不参与收集）
        让 映射表 = 哈希映射::从([
            ("值".转字符串(), "values".转字符串()),
            ("计数".转字符串(), "count".转字符串()),
        ]);
        让 源码 = "struct 容器 { pub 值: i32, pub(crate) 计数: u32 }";
        让 产出 = 替换别名(源码, &映射表);
        断言相等!(产出, 源码);
    }

    #[测试]
    函数 测试泛型与属性成员不误收() {
        // 泛型参数 `乙` 不得被误收为字段（无声明则照常替换）
        让 映射表 = 哈希映射::从([
            ("甲".转字符串(), "first".转字符串()),
            ("乙".转字符串(), "second".转字符串()),
        ]);
        让 源码 = "struct 容器 { 字段: 映射<甲, 乙> }";
        让 产出 = 替换别名(源码, &映射表);
        断言相等!(产出, "struct 容器 { 字段: 映射<first, second> }");
    }

    /// 项目上下文夹具：模块 `平台Linux`，声明名 `新建`（weix-1 场景）
    函数 项目夹具() -> 项目上下文 {
        项目上下文 {
            模块名集: 哈希集合::从(["平台Linux".转字符串()]),
            声明名: 哈希集合::从(["新建".转字符串()]),
            项名集: 哈希集合::从(["新建".转字符串()]),
        }
    }

    #[测试]
    函数 测试项目上下文跨文件调用保留() {
        // 跨文件调用（#8）：`新建` 在本文件的转译单元无声明，由项目上下文
        // 豁免（否则被替换出 `新建` → E0599，与声明侧 `fn 新建` 不一致）
        让 映射表 = 哈希映射::从([
            ("新建".转字符串(), "new".转字符串()),
            ("平台Linux".转字符串(), "platform_linux".转字符串()),
        ]);
        让 夹具 = 项目夹具();
        让 源码 = "let e = crate::平台Linux::Linux内存源::新建();";
        让 产出 = 替换别名并上下文(源码, &映射表, 有值(&夹具));
        断言相等!(产出.产出, 源码);
        // 无项目上下文（旧行为）时模块名与成员都被替换
        让 产出2 = 替换别名并上下文(源码, &映射表, 无);
        断言相等!(
            产出2.产出,
            "let e = crate::platform_linux::Linux内存源::new();"
        );
    }

    #[测试]
    函数 测试项目上下文模块根链() {
        // 模块名为根的路径链（无 包 前缀）链内全豁免；
        // 模块名自身的裸使用处同样豁免（模块词不落入别名替换）
        让 映射表 = 哈希映射::从([
            ("新建".转字符串(), "new".转字符串()),
            ("平台Linux".转字符串(), "platform_linux".转字符串()),
        ]);
        让 夹具 = 项目夹具();
        让 源码 = "let a = 平台Linux::Linux内存源::新建();\nlet b = 平台Linux;";
        让 产出 = 替换别名并上下文(源码, &映射表, 有值(&夹具));
        断言相等!(产出.产出, 源码);
    }

    #[测试]
    函数 测试项目上下文库路径段仍替换() {
        // 非同模块的库路径段不受项目上下文影响：`盒子::新建` 的 `新建`
        // 是库 API（项目内同名 `fn 新建` 不得误伤）
        让 映射表 = 哈希映射::从([
            ("新建".转字符串(), "new".转字符串()),
            ("盒子".转字符串(), "Box".转字符串()),
        ]);
        让 夹具 = 项目夹具();
        让 产出 = 替换别名并上下文("let b = 盒子::新建();", &映射表, 有值(&夹具));
        断言相等!(产出.产出, "let b = Box::new();");
    }

    #[测试]
    函数 测试项目上下文裸使用处豁免() {
        // 项目声明名（其他文件声明）的裸使用处豁免；
        // `::` 链外的普通表达式不受影响
        让 映射表 = 哈希映射::从([
            ("新建".转字符串(), "new".转字符串()),
            ("计算".转字符串(), "calculate".转字符串()),
        ]);
        让 夹具 = 项目夹具();
        让 产出 = 替换别名并上下文("let x = 新建 + 计算;", &映射表, 有值(&夹具));
        断言相等!(产出.产出, "let x = 新建 + calculate;");
    }

    #[测试]
    函数 测试项目上下文链在符号处终结() {
        // 路径链在非 冒号 符号处终结：链后的普通标识符照常替换
        让 映射表 = 哈希映射::从([
            ("新建".转字符串(), "new".转字符串()),
            ("计算".转字符串(), "calculate".转字符串()),
        ]);
        让 夹具 = 项目夹具();
        让 产出 = 替换别名并上下文(
            "let e = crate::平台Linux::新建() + 计算;",
            &映射表,
            有值(&夹具),
        );
