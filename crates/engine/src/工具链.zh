//! 工具链定位：内置目录 → 环境变量 → PATH 的三源查找
//!
//! 内置工具链：`rzc install toolchain` 将官方独立发行版工具链
//!（rustc/cargo/rust-analyzer）安装到 `~/.rz/toolchain/bin`，使发布包自包含、
//! 不依赖 rustup 与 PATH 配置。
//!
//! 设计（中文原生重构，非英文版的逐句对译）：
//! - 三个来源先**折算成一条候选路径序列**，存在性判定只留一处 `是否为文件`。
//!   英文版把「是否为文件」判定抄了四遍（内置、环境变量、PATH 目录、PATHEXT 后缀各一
//!   遍），每加一个来源就多一个判定分支；改成数据驱动后，新增来源只是往序列里
//!   多推一条路径，优先级由序列次序表达，不再由嵌套层次表达。
//! - Windows 后缀**读系统真实登记的 `PATHEXT`**，取代硬编码的
//!   硬编码的「.exe / .cmd / .bat / .com」后缀表与「操作系统名 == Windows」字符串比较：
//!   非 Windows 上该环境变量不存在，直接得到空序列，既不空转四轮探测，也尊重
//!   用户自定义的 PATHEXT（原实现会漏 `.MSI` 一类，又无条件试 `.COM`）。

使用 标准库::环境;
使用 标准库::路径::路径缓冲;

/// 全局安装目录（`~/.rz`）：语言包与工具链共用一根
公开 函数 安装根目录() -> 路径缓冲 {
    让 主目录 = 环境::环境变量("HOME")
        .或用否则(|_| 环境::环境变量("USERPROFILE"))
        .解包或用否则(|_| ".".转字符串());
    路径缓冲::从(主目录).连接(".rz")
}

/// 内置工具链的二进制目录（`~/.rz/toolchain/bin`）
公开 函数 工具链程序目录() -> 路径缓冲 {
    安装根目录().连接("toolchain").连接("bin")
}

/// 补上平台可执行后缀的裸文件名（Unix 上后缀为空串，结果就是原名）
函数 拼程序名(名字: &文本) -> 字符串值 {
    让 可变 程序名 = 名字.转字符串();
    程序名.推入字符串(环境::平台常量::可执行后缀);
    程序名
}

/// 组件名转「同名环境变量名」：`rust-analyzer` → `RUST_ANALYZER_PATH`
函数 环境变量名(名字: &文本) -> 字符串值 {
    让 可变 键名 = 名字.转大写().替换("-", "_");
    键名.推入字符串("_PATH");
    键名
}

/// PATH 扩展名序列（PATHEXT 原值按 `;` 切分，项自带前导点，如 `.EXE`）
///
/// 非 Windows 上没有该环境变量，`.转选项()` 后即空序列——平台差异由数据
/// 存在与否表达，不用 `操作系统名` 分支。
函数 路径扩展名序列() -> 向量<字符串值> {
    环境::环境变量("PATHEXT")
        .转选项()
        .变换(|串| 串.分割(';').变换(|项| 项.转字符串()).收集::<向量<字符串值>>())
        .取值或默认()
}

/// 按优先级排出的候选路径：内置目录 → 同名环境变量 → PATH 逐目录（含后缀展开）
函数 候选序列(名字: &文本) -> 向量<路径缓冲> {
    让 程序名 = 拼程序名(名字);
    让 可变 候选 = 向量::新建();
    // 1. 内置工具链（`rzc install toolchain` 的落点）
    候选.推入(工具链程序目录().连接(&程序名));
    // 2. 同名环境变量指路（如 RUST_ANALYZER_PATH），值原样当路径用
    如果 让 有值(指路路径) = 环境::环境变量(环境变量名(名字))
        .转选项()
        .变换(路径缓冲::从)
    {
        候选.推入(指路路径);
    }
    // 3. PATH 扫描：每个目录先试裸名，再试 PATHEXT 各后缀（后缀序列只取一次）
    如果 让 成功(路径串) = 环境::环境变量("PATH") {
        让 后缀序列 = 路径扩展名序列();
        对于 目录 在 环境::切分路径(&路径串) {
            候选.推入(目录.连接(&程序名));
            对于 后缀 在 &后缀序列 {
                让 可变 带后缀名 = 程序名.转字符串();
                带后缀名.推入字符串(后缀);
                候选.推入(目录.连接(&带后缀名));
            }
        }
    }
    候选
}

/// 查找工具链可执行文件的绝对路径：按候选序列取第一个真实存在的普通文件
///
/// 内置目录、环境变量指路、PATH 扫描三级优先级由 `候选序列` 的次序表达；
/// 全都不存在时返回无。
公开 函数 查找工具链程序(名字: &文本) -> 选项<路径缓冲> {
    候选序列(名字).消费迭代().查找(|候选路径| 候选路径.是否为文件())
}

/// 已安装的内置工具链版本号（如 `1.98.0`）；未安装或记录为空时返回无
公开 函数 已安装版本() -> 选项<字符串值> {
    标准库::文件系统::读取全部字符串(安装根目录().连接("toolchain").连接("version.txt"))
        .转选项()
        .变换(|串| 串.裁剪().转字符串())
        .过滤(|串| !串.是否为空())
}

/// 当前锁定版本（与仓库 rust-toolchain.toml 对齐；后续随官方稳定版升级）
公开 常量 锁定版本: &文本 = "1.98.0";

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;
    使用 标准库::路径::路径类型;

    /// 把路径拆成组件字符串序列，便于断言目录约定
    函数 组件串序列(待拆路径: &路径类型) -> 向量<字符串值> {
        待拆路径
            .组件()
            .变换(|组件| 组件.作为系统串().转有损字符串().转字符串())
            .收集::<向量<字符串值>>()
    }

    #[测试]
    函数 目录布局符合约定() {
        // 目录结构约定：~/.rz/toolchain/bin（组件级检查，不依赖文件系统真实状态）
        让 组件们 = 组件串序列(&工具链程序目录());
        断言!(组件们.迭代().任意(|组件| 组件 == ".rz"));
        断言!(组件们.迭代().任意(|组件| 组件 == "toolchain"));
        断言!(组件们.最后一个().有值且(|尾| 尾 == "bin"));
    }

    #[测试]
    函数 环境变量名按组件名派生() {
        // 连字符转下划线、字母大写——三级查找的第二级全靠这个环境变量名
        断言相等!(环境变量名("rust-analyzer"), "RUST_ANALYZER_PATH");
        断言相等!(环境变量名("cargo"), "CARGO_PATH");
    }

    #[测试]
    函数 程序名带平台后缀() {
        // Unix 上「可执行后缀」为空串，Windows 上为 .exe：拼接结果随平台一致变化
        让 期望名 = 拼程序名("rustc");
        断言!(期望名.以开头("rustc"));
        断言相等!(期望名.长度(), "rustc".长度() + 环境::平台常量::可执行后缀.长度());
    }

    #[测试]
    函数 候选序列首位是内置目录() {
        // 优先级是这三级查找的核心约定：内置目录必须排在最前
        让 候选们 = 候选序列("rustc");
        断言相等!(候选们[0], 工具链程序目录().连接(拼程序名("rustc")));
    }

    #[测试]
    函数 扩展名序列的项自带前导点() {
        // Windows 的 PATHEXT 每项以 `.` 起头；非 Windows 得到空序列
        对于 后缀 在 路径扩展名序列() {
            断言!(后缀.以开头("."), "PATHEXT 项应自带前导点，实得 {后缀}");
        }
    }

    #[测试]
    函数 不存在的程序名查不出路径() {
        // 内置、环境变量指路、PATH 扫描三级都落空：名字带 __ 前缀，不会与真实工具链撞名
        断言!(查找工具链程序("__rzc_absent_bin__").是否为无());
    }
}
