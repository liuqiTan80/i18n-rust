//! 工具链定位模块【zh 自举·批次1】
//! 本文件是源真相：由引导 rzc 转译为 工具链.rs 后交 cargo 编译。
//! 再生成方式见 tools/zh-selfhost/regen.sh；请勿手改同目录下的 工具链.rs。
//!
//! 内置工具链：`rzc install toolchain` 将官方 standalone 工具链
//!（rustc/cargo/rust-analyzer）安装到 `~/.rz/toolchain/bin`，
//! 使发布包自包含、不依赖 rustup 与 PATH 配置。
//! 查找优先级：内置目录 → 环境变量 → PATH 扫描。
//!
//! 注：`切分路径`、`组件`、`作为系统串`、`转有损字符串`、
//! `有值且`、`平台常量::可执行后缀` 暂无中文词条，按英文透传（合法
//! 方言行为）；目录名 `".rz"`、`"toolchain"` 等是与磁盘布局对齐的字面量，
//! 属数据而非代码，保持原文。

使用 标准库::路径::路径缓冲;

/// 全局安装目录（~/.rz）：语言包（lang-packs/）与工具链（toolchain/）共用
公开 函数 安装根目录() -> 路径缓冲 {
    // `或用否则` / `解包或用否则` 无中文词条，按英文透传
    让 家目录 = 标准库::环境::环境变量("HOME")
        .或用否则(|_| 标准库::环境::环境变量("USERPROFILE"))
        .解包或用否则(|_| ".".转字符串());
    路径缓冲::从(家目录).连接(".rz")
}

/// 内置工具链 bin 目录（~/.rz/toolchain/bin）
公开 函数 工具链程序目录() -> 路径缓冲 {
    安装根目录().连接("toolchain").连接("bin")
}

/// 查找工具链可执行文件的绝对路径
///
/// 优先级：
/// 1. 内置工具链目录（`rzc install toolchain` 安装的 standalone 版本）
/// 2. 同名环境变量（如 rust-analyzer 对应 RUST_ANALYZER_PATH）
/// 3. PATH 扫描（跨平台，Windows 追加 PATHEXT 后缀）
公开 函数 查找工具链程序(名称: &文本) -> 选项<路径缓冲> {
    让 程序名 = 格式化!("{}{}", 名称, 标准库::环境::平台常量::可执行后缀);

    // 1. 内置工具链
    让 内置 = 工具链程序目录().连接(&程序名);
    如果 内置.是否为文件() {
        返回 有值(内置);
    }

    // 2. 环境变量（RUST_ANALYZER_PATH / RUSTC_PATH / CARGO_PATH 等）
    让 环境键 = 格式化!("{}_PATH", 名称.转大写().替换("-", "_"));
    如果让 成功(路径) = 标准库::环境::环境变量(环境键) {
        让 候选 = 路径缓冲::从(&路径);
        如果 候选.是否为文件() {
            返回 有值(候选);
        }
    }

    // 3. PATH 扫描
    扫描路径(&程序名)
}

/// 在 PATH 中查找可执行文件（含 Windows PATHEXT 后缀探测）
函数 扫描路径(程序名: &文本) -> 选项<路径缓冲> {
    让 路径变量 = 标准库::环境::环境变量("PATH").转选项()?;
    对于 目录 在 标准库::环境::切分路径(&路径变量) {
        让 候选 = 目录.连接(程序名);
        如果 候选.是否为文件() {
            返回 有值(候选);
        }
        // Windows：无后缀名时按 PATHEXT 顺序探测（.EXE/.CMD/.BAT…）
        如果 标准库::环境::平台常量::操作系统名 == "windows" {
            对于 后缀 在 ["exe", "cmd", "bat", "com"] {
                让 带后缀 = 目录.连接(格式化!("{}.{}", 程序名, 后缀));
                如果 带后缀.是否为文件() {
                    返回 有值(带后缀);
                }
            }
        }
    }
    无
}

/// 已安装的内置工具链版本目录名（如 `1.98.0`）；未安装返回 无
公开 函数 已安装工具链版本() -> 选项<字符串> {
    让 目录 = 安装根目录().连接("toolchain").连接("version.txt");
    标准库::文件系统::读取字符串(目录)
        .转选项()
        .映射(|文本| 文本.裁剪().转字符串())
        .过滤(|文本| !文本.是否为空())
}

/// 当前锁定版本（与仓库 rust-toolchain.toml 对齐；后续随官方 stable 升级）
公开 常量 锁定工具链版本: &文本 = "1.98.0";

#[配置(测试)]
模块 单元测试 {
    使用 超级::*;

    #[测试]
    函数 工具链目录布局() {
        // 目录结构约定：~/.rz/toolchain/bin（组件级检查）
        让 目录 = 工具链程序目录();
        让 组件列表: 向量<字符串> = 目录
            .组件()
            .映射(|字符值| 字符值.作为系统串().转有损字符串().转字符串())
            .收集();
        断言!(组件列表.迭代器().任意(|字符值| 字符值 == ".rz"));
        断言!(组件列表.迭代器().任意(|字符值| 字符值 == "toolchain"));
        断言!(组件列表.最后一个().有值且(|字符值| 字符值 == "bin"));
    }

    #[测试]
    函数 查找缺失程序返回无() {
        // 不存在的二进制名应返回 无（内置与 PATH 都无）
        让 名称 = 格式化!("__rzc_nonexistent__{}", 标准库::进程::进程号());
        断言!(查找工具链程序(&名称).是否为无());
    }
}
