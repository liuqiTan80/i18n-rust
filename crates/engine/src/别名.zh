//! 将源代码中的中文标识符别名（如第三方库的中文名称）替换为英文标识符。
//! 仅替换标识符类型的词元，不触碰字符串字面量和注释等内容。
//! 声明位保护：紧跟在声明关键字（函数、结构体、枚举、特征、类型、模块、让 等）
//! 后的标识符是用户自己的定义，不是库 API 引用，不参与别名替换；且用户声明的
//! 名字在整个文件内的裸使用处都豁免（两遍扫描：先收集声明名，再逐词元替换），
//! 避免 `让 新建 = 5` 声明位受保护而后续使用处被误替换成「新建」的映射目标。
//! 三条精细规则：
//! 1. `::` 限定后的路径段按「链根」分级处理：根是项目符号
//!    （包根、自身、父级、项目模块名、项目项名）时链内**与项目声明名
//!    同名**的段豁免——`平台Linux::新建` 的定义侧与调用侧一致
//!    （避免 E0599）；链内非项目名与根非项目符号的段都照常替换
//!    （`源码映射项::新建` 的 `新建` 未定义于项目、`盒子::新建`
//!    的 `新建` 是库 API）；无项目上下文时退化为「本文件项名豁免」
//!    （`接口错误::错误请求`）；
//! 2. 库特征实现块（`实现 某特征 对于 类型 {}`）内的方法名是库 API
//!    规定的名称（用户从映射表抄写而来），不是用户自定义名字，不受声明位
//!    保护——`实现 抄写器 对于 类型 { 函数 渲染（...） }` 中的 `渲染`
//!    必须转译，否则无法匹配库特征规定的同名方法（E0407/E0046）；
//! 3. 函数参数与闭包参数是「值绑定」（用户命名）：`函数 完整网址(路径: &文本)`
//!    的 `路径` 在声明与使用处都豁免替换（参数「类型」位置的字照常替换），
//!    与格式化串中的 `{路径}` 保持一致，避免 E0425（找不到名称 `路径`）；
//! 4. 结构体字段名与枚举变体名同样是用户命名，纳入声明收集：
//!    字段 `结构体 容器 { 值: 整数 }` 的 `值`（撞「值」映射键）
//!    在定义/构造/访问处（`实例.值`）全豁免；枚举变体
//!    `枚举 判定结果 { 保留, 丢弃 }` 的 `保留`/`丢弃`（撞
//!    retain/drop 映射键）同理；变体可经 `::` 访问
//!    （`判定结果::保留`）故收集为项，字段收集为值绑定。
//!    方法调用位（`实例.方法()`）不查字段名：`编辑表.长度()` 的
//!    `长度` 是 `向量::长度` 调用，只查「项目方法名集合」（项）；
//! 5. 模式绑定（匹配臂、让 解构、循环模式）同样是值绑定：
//!    `匹配 有值(入参) { 有值(连接) => … }` 的 `连接` 全文件豁免
//!    （见「收集模式绑定」）。

使用 词法解析器::令牌种类;
使用 标准库::集合::{哈希映射, 哈希集合};

使用 包::名字缓存::名字缓存;
使用 包::缓存::源码映射条目;

/// 单阶段替换结果：输出与编辑表
///
/// 编辑表以**本阶段输入文本**的字节偏移记录（输入偏移升序、互不重叠），
/// 替换文字为本阶段输出文本。
#[派生(调试, 克隆)]
公开 结构体 替换结果 {
    /// 替换后的文本
    公开 输出文本: 字符串,
    /// 编辑表
    公开 编辑表: 向量<源码映射条目>,
}

/// 声明位关键字（转译后的英文形式）：其后紧跟的标识符为用户定义
///
/// 不含「可变」：仅在 `让 可变 名称` 场景下透明传递声明状态（见替换循环），
/// `&可变 类型` 等非声明位的可变不传递，避免误保护库类型引用。
/// 不含「实现」：`实现 特征 对于 类型` 中的特征/类型多为库 API，仍需替换。
/// 列映射模拟别名替换时复用同一张表，保证两侧行为一致。
公开 常量 声明关键字表: &[&文本] = &[
    "fn", "struct", "enum", "trait", "type", "mod", "let", "const", "static",
];

/// 变量声明关键字：其后名字是「变量」（不可经 `::` 访问）；
/// [`声明关键字表`] 的其余关键字（函数/结构体/枚举/特征/类型/模块）声明的
/// 是「项」，项可经 `::` 访问（见模块文档第 1 条规则）
常量 变量声明关键字表: &[&文本] = &["let", "const", "static"];

/// 用户声明名与库特征方法名的收集结果
#[派生(调试, 默认)]
公开 结构体 已声明名集合 {
    /// 项声明名（函数/结构体/枚举/特征/类型/模块）+ 枚举变体名：
    /// `::` 后的同名标识符仍豁免
    公开 条目集: 哈希集合<字符串>,
    /// 变量声明名（让/常量/静态）+ 函数/闭包参数：
    /// `::` 后的同名标识符照常替换
    公开 变量集: 哈希集合<字符串>,
    /// 结构体命名字段：裸使用处豁免（`实例.字段`/结构体字面量）；
    /// `::` 后照常替换（字段不能经 `::` 访问）。
    /// 与变量集分开收集，供项目级合并（绑定名是文件局部的）
    公开 成员集: 哈希集合<字符串>,
    /// 库特征实现块内的方法名：声明位保护对这些名字失效（库 API 名称）
    公开 库方法集: 哈希集合<字符串>,
}

/// 项目级声明上下文（跨文件声明豁免）
///
/// 单文件的声明豁免无法覆盖跨文件调用：甲文件声明 `公开 函数 新建()`，
/// 乙文件调用 `包::甲::新建()` 时乙的转译单元看不到甲的声明，
/// `新建` 被当作库别名替换成「新建」的映射目标（E0599）。转译前扫描同包
/// 全部方言源文件汇总本结构，把使用处豁免升级到项目级。
///
/// 保守近似与单文件声明豁免一致：不做作用域/可见性分析，同名即豁免。
#[派生(调试, 默认, 克隆)]
公开 结构体 项目上下文 {
    /// 项目模块名（方言文件名词干）：`::` 路径链根
    公开 模块集: 哈希集合<字符串>,
    /// 项目声明名（项 + 结构体字段）：裸使用处豁免
    ///（让/参数等文件内绑定不参与合并——绑定名是文件局部的）
    公开 名字集: 哈希集合<字符串>,
    /// 项目项名（函数/结构体/枚举/特征/类型/模块 + 枚举变体）：
    /// `::` 路径段豁免与路径链根判定（字段不参与：不可经 `::` 访问）
    公开 条目集: 哈希集合<字符串>,
}

实现 项目上下文 {
    /// 从项目源文件集合构建：`模块集` 为项目模块名词干，
    /// `源集合` 为全部方言源文件内容（母语原文）
    ///
    /// 声明收集工作在关键字转译后的文本上进行（声明关键字需英文形式），
    /// 内部对每个源文件先跑词法转译阶段再收集。
    公开 函数 从源集合<'甲>(
        模块集: 哈希集合<字符串>,
        源集合: 实现 可迭代<货物类型 = &'甲 文本>,
        管理器: &包::映射管理器::映射管理器,
    ) -> 自身 {
        让 声明们: 向量<已声明名集合> = 源集合
            .消费迭代()
            .变换(|原因| 收集源声明(原因, 管理器))
            .收集();
        自身::从声明集合(模块集, 声明们.迭代())
    }

    /// 同 [`自身::从源集合`]，但单文件声明收集结果由调用方提供
    ///
    /// 汇总规则唯一来源（[`自身::从源集合`] 亦委托本函数）：调用方可按
    /// 文件粒度缓存 [`收集源声明`] 的结果（如列映射服务按内容哈希
    /// 缓存），避免同一内容被重复跑词法转译，同时无需复刻合并规则。
    公开 函数 从声明集合<'甲>(
        模块集: 哈希集合<字符串>,
        声明集合: 实现 可迭代<货物类型 = &'甲 已声明名集合>,
    ) -> 自身 {
        让 可变 名字集 = 哈希集合::新建();
        让 可变 条目集 = 哈希集合::新建();
        对于 已声明 在 声明集合 {
            对于 名字值 在 &已声明.条目集 {
                名字集.置入(名字值.克隆值());
                条目集.置入(名字值.克隆值());
            }
            名字集.扩展(已声明.成员集.迭代().克隆副本());
        }
        自身 {
            模块集,
            名字集,
            条目集,
        }
    }

    /// 是否为空（无模块且无声明名）：空上下文不产生任何豁免
    公开 函数 上下文为空(&自我) -> 布尔 {
        自我.模块集.是否为空() && 自我.名字集.是否为空()
    }

    /// 项目上下文指纹（排序后哈希，跨进程确定）：并入转译缓存指纹，
    /// 项目声明集合变化时相关缓存自动失效
    公开 函数 指纹(&自我) -> 无符号长整数 {
        使用 标准库::哈希模块::{哈希, 哈希器};
        让 可变 模块向量: 向量<&字符串> = 自我.模块集.迭代().收集();
        模块向量.不稳定排序();
        让 可变 名字向量: 向量<&字符串> = 自我.名字集.迭代().收集();
        名字向量.不稳定排序();
        让 可变 条目向量: 向量<&字符串> = 自我.条目集.迭代().收集();
        条目向量.不稳定排序();
        让 可变 散列器 = 标准库::集合::哈希映射模块::默认哈希器::新建();
        ("i18n-rust-project", 模块向量, 名字向量, 条目向量).哈希模块(&可变 散列器);
        散列器.完成()
    }

    /// 裸使用处豁免：项目声明名（项 + 结构体字段，含其他文件声明）
    函数 裸使用豁免(&自我, 文本响应: &文本) -> 布尔 {
        自我.名字集.包含(文本响应)
    }

    /// 路径链根判定：包根、父级、自身、项目模块名、项目项名。
    /// 根段后跟 `::` 时整条路径视为项目路径（链内全部段豁免）
    函数 是路径根(&自我, 文本响应: &文本) -> 布尔 {
        模式匹配!(文本响应, "crate" | "super" | "self")
            || 自我.模块集.包含(文本响应)
            || 自我.条目集.包含(文本响应)
    }
}

/// 类型体（结构体/枚举）扫描状态：收集命名字段与枚举变体
#[派生(调试)]
结构体 类型体扫描 {
    /// 是否为枚举体（枚举顶层成员是变体，收集为项）
    为枚举体: 布尔,
    /// 花括号深度（1 = 类型体顶层）
    深度: 无符号整数,
    /// 处于成员开始位置（`{`/`,` 之后）：下一个标识符是字段名/变体名
    位于起点: 布尔,
    /// 已见的名字（等 `:` 确认后收集为字段）
    待定成员: 选项<字符串>,
}
/// 收集单个方言源文件的声明名（词法转译 + 声明扫描）
///
/// 与 [`项目上下文::从源集合`] 内部的单文件收集步骤完全一致
/// （后者亦委托本函数，规则唯一来源），供需要按文件粒度缓存结果的调用方
/// 使用——例如列映射服务每按键都要汇总全部打开文件的声明名，若每次重算
/// 等于 O(项目规模) 次词法转译；按内容哈希缓存本函数的返回值后，
/// 每次按键只有内容真正变化的那个文件需要重算。
公开 函数 收集源声明(
    原因: &文本,
    管理器: &包::映射管理器::映射管理器,
) -> 已声明名集合 {
    让 词法产物 = 包::词法器::分词转译(
        原因,
        管理器.取关键词表(),
        管理器.取宏表(),
        管理器.取派生特征表(),
        管理器.取让位词(),
        管理器.取方法让位词(),
        管理器.取别名表(),
    );
    收集声明名(&词法产物.输出, 管理器.取别名表())
}

/// 收集用户在声明位定义的标识符名（第一遍扫描）
///
/// 状态机与替换主循环一致：声明关键字后紧跟的标识符计入集合；
/// 「可变」在声明态内透明传递；空白/注释不打断声明态；符号终结声明位。
/// 另收集「值绑定」：函数参数名（`函数 名(参数: 类型)` 中的参数开始位
/// 且后跟 `:`）与闭包参数名（`|甲, 乙|`，可无类型标注直接收集）——
/// 绑定名是用户命名，不是库 API 引用。
/// 结构体/枚举体扫描（[`类型体扫描`]）：命名字段（`字段: 类型`）
/// 收集为值绑定，枚举顶层变体名收集为项（变体可经 `::` 访问）。
/// 集合内的名字在文件内的使用处豁免别名替换（保守近似：不做作用域
/// 分析，同名遮蔽场景同样豁免，与声明位保护的设计意图一致）。
/// 库特征实现块内的方法名（见「库特征实现方法收集」）从保护集合剔除。
公开 函数 收集声明名(原因: &文本, 别名映射: &哈希映射<字符串, 字符串>) -> 已声明名集合 {
    让 词元们 = 包::收集令牌(原因);
    在文本中收集声明名(原因, 别名映射, &词元们)
}

/// [`收集声明名`] 的实现：调用方已持有词元序列时直接复用，
/// 避免同一份源码被重复词法化
///
/// 管线内部也直接走本入口：延迟项目上下文的入口要对词法产物的输出文本
/// 切分令牌才能收集声明，而导入路径阶段恰好也在这份文本上跑，两者共用
/// 同一份词元流。
///
/// 声明收集的三个方面合并为**一次**词元遍历：
/// - 声明位（函数/结构体/让/常量/静态… 后的名字）、类型体成员、
///   函数与闭包参数；
/// - 库特征实现块的方法名：`实现 特征 对于 类型 { 函数 方法 }` 中，特征名
///   既不是本文件声明的项、又在别名映射表里时，块内方法名是库 API（用户从
///   映射表抄写而来），必须照常参与替换；实现用户自定义特征时方法名是用户
///   取的名字，保持声明位保护；
/// - 模式绑定：匹配臂（`=>` 向左回溯到臂起点）、让 解构括号内、循环到
///   迭代源之间的名字是用户命名的值绑定，与参数一样全文件豁免替换
///   （`有值(连接) =>` 的 `连接` 撞「连接」词条，误替换即缺陷）。
///
/// 三组状态互不读对方的中途结果（库特征判定用的 `条目集` 只在整份源码扫完
/// 后），所以能并在一起：每个词元只取一次文本切片、只分派一次。此前
/// 三者各走一遍词元流，98 千字节 / 2805 行样例声明收集 1684 → 1513 µs
/// （−10.2%，同进程交替 5/5 轮）；1193 份语料与旧实现逐字段零差异。
///
/// 但仍保留原来的**两阶段顺序**：库特征方法名要拿扫完后的完整 `条目集` 判定
/// 并统一剔除（实现块可以出现在目标类型声明之前），模式绑定在那之后再并入。
公开(包) 函数 在文本中收集声明名<'甲>(
    原因: &'甲 文本,
    别名映射: &哈希映射<字符串, 字符串>,
    词元序列: &[词法解析器::词法令牌],
) -> 已声明名集合 {
    让 可变 声明累计 = 已声明名集合::缺省();
    // —— 一：声明位 / 类型体 / 函数与闭包参数 ——
    让 可变 前一关键字: 选项<&'甲 文本> = 无;
    让 可变 待定类型: 选项<(布尔, 布尔)> = 无;
    让 可变 类型体: 选项<类型体扫描> = 无;
    让 可变 体内圆括号 = 0u32;
    让 可变 体内尖括号 = 0u32;
    让 可变 体内方括号 = 0u32;
    让 可变 函数头态 = 0u32;
    让 可变 函数尖括号 = 0u32;
    让 可变 圆括号深度 = 0u32;
    让 可变 位于参数起点 = 假;
    让 可变 待定参数: 选项<字符串> = 无;
    让 可变 在闭包内 = 假;
    让 可变 闭包圆括号 = 0u32;
    让 可变 闭包起点 = 假;
    让 可变 前为值结尾 = 假;
    让 可变 上个或号结尾 = 无符号机器整数::最大常量;
    // —— 二：实现块（库特征判定延后到扫完之后）——
    // 实现块可以出现在目标类型声明之前，故不能边扫边按 `条目集` 判定；
    // 先把每块的（目标名, 块内函数名）记下，扫完后统一判定。
    // 名字用源码切片，不分配。
    让 可变 实现头态 = 假;
    让 可变 实现目标: 选项<&'甲 文本> = 无;
    让 可变 实现块号: 选项<无符号机器整数> = 无;
    让 可变 实现尖括号 = 0u32;
    让 可变 实现花括号 = 0u32;
    让 可变 前一为函数 = 假;
    让 可变 实现块们: 向量<(&'甲 文本, 向量<&'甲 文本>)> = 向量::新建();
    // —— 三：模式绑定 ——
    让 可变 在让态 = 假;
    让 可变 让深度 = 0u32;
    让 可变 在循环态 = 假;
    让 可变 循环深度 = 0u32;
    让 可变 循环待定: 向量<&'甲 文本> = 向量::新建();
    让 可变 在实现头内 = 假;
    // 模式绑定单独暂存：库特征方法名的剔除只作用于声明位收集结果，
    // 旧实现是「先剔除、再把模式绑定并入变量集」，此处保持同一顺序
    让 可变 绑定集: 哈希集合<字符串> = 哈希集合::新建();
    让 可变 偏移 = 0usize;
    对于 序号 在 0..词元序列.元素数() {
        让 当前类别 = 词元序列[序号].类别值;
        让 文本响应 = &原因[偏移..偏移 + 词元序列[序号].元素数];
        匹配 当前类别 {
            令牌种类::标识符记号 => {
                // —— 一：类型头推进（结构体/枚举后第一个标识符是类型名）——
                如果 文本响应 == "struct" {
                    待定类型 = 有值((假, 假));
                } 否则 如果 文本响应 == "enum" {
                    待定类型 = 有值((真, 假));
                } 否则 如果 让 有值((_, 已见)) = &可变 待定类型
                    && !*已见
                    && 文本响应 != "pub"
                {
                    *已见 = 真;
                }
                // —— 一：类型体成员收集 ——
                如果 让 有值(请求体) = &可变 类型体
                    && 体内圆括号 == 0
                    && 体内尖括号 == 0
                    && 体内方括号 == 0
                    && 请求体.位于起点
                    && 文本响应 != "pub"
                {
                    如果 请求体.为枚举体 && 请求体.深度 == 1 {
                        声明累计.条目集.置入(文本响应.转字符串());
                    } 否则 {
                        请求体.待定成员 = 有值(文本响应.转字符串());
                    }
                    请求体.位于起点 = 假;
                }
                // —— 一：声明位 ——
                如果 让 有值(关键字值) = 前一关键字 {
                    如果 变量声明关键字表.包含(&关键字值) {
                        声明累计.变量集.置入(文本响应.转字符串());
                    } 否则 {
                        声明累计.条目集.置入(文本响应.转字符串());
                    }
                }
                前一关键字 = 下一声明关键字(前一关键字, 文本响应);
                // —— 一：函数参数名 ——
                如果 函数头态 == 2 && 圆括号深度 == 1 && 位于参数起点 && 文本响应 != "mut" {
                    待定参数 = 有值(文本响应.转字符串());
                    位于参数起点 = 假;
                }
                如果 函数头态 == 0 && 文本响应 == "fn" {
                    函数头态 = 1;
                    函数尖括号 = 0;
                }
                // —— 一：闭包参数名 ——
                如果 在闭包内 && 闭包圆括号 == 0 && 闭包起点 && 文本响应 != "mut" {
                    声明累计.变量集.置入(文本响应.转字符串());
                    闭包起点 = 假;
                }
                前为值结尾 = 文本响应 != "move";

                // —— 二：实现块 ——
                如果 让 有值(块号) = 实现块号 {
                    // 块体内的函数名：紧跟在「函数」关键字之后的标识符
                    如果 前一为函数 {
                        实现块们[块号].1.推(文本响应);
                    }
                } 否则 如果 实现头态 {
                    // `<...>` 泛型参数里的名字不是实现目标
                    如果 实现尖括号 == 0 {
                        实现头态 = 假;
                        实现目标 = 有值(文本响应);
                    }
                } 否则 如果 实现目标.是否为无() && 文本响应 == "impl" {
                    实现头态 = 真;
                    实现尖括号 = 0;
                }
                前一为函数 = 文本响应 == "fn";

                // —— 三：模式绑定 ——
                如果 文本响应 == "impl" {
                    在实现头内 = 真;
                }
                如果 在循环态 {
                    如果 文本响应 == "in" && 循环深度 == 0 {
                        // 模式结束：提交挂起绑定
                        绑定集.扩展(循环待定.耗尽(..).变换(文本::转字符串));
                        在循环态 = 假;
                    } 否则 如果 循环深度 == 0
                        && (文本响应 == "for" || 语句边界关键字表.包含(&文本响应))
                    {
                        // 遇嵌套循环重启挂起；遇声明/语句关键字丢弃挂起
                        循环待定.清空集合();
                        在循环态 = 文本响应 == "for";
                        循环深度 = 0;
                    } 否则 如果 是模式绑定(词元序列, 序号, 文本响应) {
                        循环待定.推(文本响应);
                    }
                } 否则 如果 文本响应 == "for" && !在实现头内 {
                    在循环态 = 真;
                    循环深度 = 0;
                    循环待定.清空集合();
                }
                如果 在让态 && 让深度 > 0 && 是模式绑定(词元序列, 序号, 文本响应) {
                    绑定集.置入(文本响应.转字符串());
                }
                如果 文本响应 == "let" {
                    在让态 = 真;
                    让深度 = 0;
                }
            }
            令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. } => {}
            令牌种类::开圆括号 => {
                前一关键字 = 无;
                如果 类型体.是否为有值() {
                    体内圆括号 += 1;
                }
                如果 函数头态 == 1 && 函数尖括号 == 0 {
                    函数头态 = 2;
                    圆括号深度 = 1;
                    位于参数起点 = 真;
                } 否则 如果 函数头态 == 2 {
                    圆括号深度 += 1;
                    位于参数起点 = 假;
                }
                如果 在闭包内 {
                    闭包圆括号 += 1;
                    闭包起点 = 假;
                }
                待定参数 = 无;
                前为值结尾 = 假;
                前一为函数 = 假;
                如果 在让态 {
                    让深度 += 1;
                }
                如果 在循环态 {
                    循环深度 += 1;
                }
            }
            令牌种类::闭圆括号 => {
                前一关键字 = 无;
                如果 类型体.是否为有值() {
                    体内圆括号 = 体内圆括号.饱和减(1);
                }
                如果 函数头态 == 2 {
                    圆括号深度 = 圆括号深度.饱和减(1);
                    如果 圆括号深度 == 0 {
                        函数头态 = 0;
                    }
                    位于参数起点 = 假;
                }
                如果 在闭包内 {
                    闭包圆括号 = 闭包圆括号.饱和减(1);
                    闭包起点 = 假;
                }
                待定参数 = 无;
                前为值结尾 = 真;
                前一为函数 = 假;
                让深度 = 让深度.饱和减(1);
                循环深度 = 循环深度.饱和减(1);
            }
            令牌种类::逗号 => {
                前一关键字 = 无;
                如果 函数头态 == 2 && 圆括号深度 == 1 {
                    位于参数起点 = 真;
                }
                如果 在闭包内 && 闭包圆括号 == 0 {
                    闭包起点 = 真;
                }
                // 类型体成员分隔：重置成员开始位（括号/尖括号/方括号内的
                // 逗号是类型参数分隔，不是成员分隔）
                如果 体内圆括号 == 0
                    && 体内尖括号 == 0
                    && 体内方括号 == 0
                    && 让 有值(请求体) = &可变 类型体
                {
                    请求体.位于起点 = 真;
                    请求体.待定成员 = 无;
                }
                待定参数 = 无;
                前为值结尾 = 假;
                前一为函数 = 假;
            }
            令牌种类::冒号 => {
                前一关键字 = 无;
                // `名:` → 确认函数参数绑定（其他位置不会有待确认候选）
                如果 让 有值(名字值) = 待定参数.取() {
                    声明累计.变量集.置入(名字值);
                }
                // `字段:` → 确认结构体字段名
                如果 让 有值(请求体) = &可变 类型体
                    && 让 有值(名字值) = 请求体.待定成员.取()
                {
                    声明累计.成员集.置入(名字值);
                }
                前为值结尾 = 假;
                前一为函数 = 假;
                // `让 名: 类型` 的 `:` 是类型标注分隔——其后是类型，不再是
                // 模式绑定；`::` 是路径分隔（两个相邻冒号），不结束让态
                如果 在让态
                    && 让深度 == 0
                    && !前有效下标(词元序列, 序号)
                        .有值且(|前下标| 词元序列[前下标].类别值 == 令牌种类::冒号)
                    && !后有效下标(词元序列, 序号)
                        .有值且(|后下标| 词元序列[后下标].类别值 == 令牌种类::冒号)
                {
                    在让态 = 假;
                    让深度 = 0;
                }
                // 循环模式里 `:` 不合法（类型标注等非循环场景，防御）
                如果 在循环态 && 循环深度 == 0 {
                    循环待定.清空集合();
                    在循环态 = 假;
                }
            }
            令牌种类::或号 => {
                前一关键字 = 无;
                如果 在闭包内 {
                    如果 闭包圆括号 == 0 {
                        在闭包内 = 假;
                    }
                } 否则 如果 !前为值结尾 && 上个或号结尾 != 偏移 {
                    // 前一个有效词元不是表达式结尾，且不与上一个 `|`
                    // 相邻（`a || b` 是连续两个 `|` 词元）→ 闭包起始
                    在闭包内 = 真;
                    闭包圆括号 = 0;
                    闭包起点 = 真;
                }
                上个或号结尾 = 偏移 + 词元序列[序号].元素数;
                待定参数 = 无;
                前为值结尾 = 假;
                前一为函数 = 假;
            }
            令牌种类::小于号 => {
                前一关键字 = 无;
                如果 函数头态 == 1 {
                    函数尖括号 += 1;
                }
                如果 类型体.是否为有值() {
                    体内尖括号 += 1;
                }
                待定参数 = 无;
                前为值结尾 = 假;
                如果 实现头态 {
                    实现尖括号 += 1;
                }
                前一为函数 = 假;
                // 循环模式里 `<` 不合法（泛型等非循环场景，防御）
                如果 在循环态 && 循环深度 == 0 {
                    循环待定.清空集合();
                    在循环态 = 假;
                }
            }
            令牌种类::大于号 => {
                前一关键字 = 无;
                如果 函数头态 == 1 {
                    函数尖括号 = 函数尖括号.饱和减(1);
                }
                如果 类型体.是否为有值() {
                    体内尖括号 = 体内尖括号.饱和减(1);
                }
                待定参数 = 无;
                前为值结尾 = 假;
                如果 实现头态 {
                    实现尖括号 = 实现尖括号.饱和减(1);
                }
                前一为函数 = 假;
                // `=>`（相等 + 大于号相邻两词元）：匹配臂箭头 → 回溯收集
                如果 让 有值(前下标) = 前有效下标(词元序列, 序号)
                    && 词元序列[前下标].类别值 == 令牌种类::全等
                    && 前下标 == 序号 - 1
                {
                    收集匹配臂绑定(词元序列, 偏移, 序号, 原因, &可变 绑定集);
                }
            }
            令牌种类::开大括号 => {
                // `结构体/枚举 名 {` → 进入类型体成员扫描
                如果 让 有值((为枚举体, 已见)) = 待定类型.取() {
                    如果 已见 {
                        类型体 = 有值(类型体扫描 {
                            为枚举体,
                            深度: 1,
                            位于起点: 真,
                            待定成员: 无,
                        });
                        体内圆括号 = 0;
                        体内尖括号 = 0;
                        体内方括号 = 0;
                    }
                } 否则 如果 类型体.是否为有值()
                    && 体内圆括号 == 0
                    && 体内尖括号 == 0
                    && 体内方括号 == 0
                    && 让 有值(请求体) = &可变 类型体
                {
                    请求体.深度 += 1;
                    请求体.位于起点 = 真;
                    请求体.待定成员 = 无;
                }
                前一关键字 = 无;
                待定参数 = 无;
                前为值结尾 = 假;
                // `实现 目标 {` → 进入块体；体内嵌套花括号加深一层
                如果 让 有值(块目标) = 实现目标.取() {
                    实现块们.推((块目标, 向量::新建()));
                    实现块号 = 有值(实现块们.元素数() - 1);
                    实现花括号 = 0;
                } 否则 如果 实现块号.是否为有值() {
                    实现花括号 += 1;
                } 否则 {
                    // `实现 {`：非法写法，放弃跟踪
                    实现头态 = 假;
                }
                前一为函数 = 假;
                // 实现头部结束（进入块体）
                在实现头内 = 假;
                如果 在让态 {
                    让深度 += 1;
                }
                如果 在循环态 {
                    循环深度 += 1;
                }
            }
            令牌种类::闭大括号 => {
                // 类型体闭合：深度归零退出扫描（括号/尖括号/方括号内的
                // 花括号不是类型体边界）
                如果 体内圆括号 == 0 && 体内尖括号 == 0 && 体内方括号 == 0 {
                    让 已退出 = 如果 让 有值(请求体) = &可变 类型体 {
                        请求体.深度 = 请求体.深度.饱和减(1);
                        如果 请求体.深度 == 0 {
                            真
                        } 否则 {
                            请求体.位于起点 = 真;
                            请求体.待定成员 = 无;
                            假
                        }
                    } 否则 {
                        假
                    };
                    如果 已退出 {
                        类型体 = 无;
                    }
                }
                前一关键字 = 无;
                待定参数 = 无;
                前为值结尾 = 真;
                // 实现块体闭合：嵌套深度归零时退出追踪
                如果 实现块号.是否为有值() {
                    如果 实现花括号 == 0 {
                        实现块号 = 无;
                    } 否则 {
                        实现花括号 -= 1;
                    }
                }
                前一为函数 = 假;
                让深度 = 让深度.饱和减(1);
                循环深度 = 循环深度.饱和减(1);
            }
            令牌种类::开方括号 => {
                // 方括号内的标识符不参与成员收集（属性、数组类型 `[T; N]`）
                如果 类型体.是否为有值() {
                    体内方括号 += 1;
                }
                前一关键字 = 无;
                待定参数 = 无;
                前为值结尾 = 假;
                前一为函数 = 假;
                如果 在让态 {
                    让深度 += 1;
                }
                如果 在循环态 {
                    循环深度 += 1;
                }
            }
            令牌种类::闭方括号 => {
                如果 类型体.是否为有值() {
                    体内方括号 = 体内方括号.饱和减(1);
                }
                前一关键字 = 无;
                待定参数 = 无;
                前为值结尾 = 真;
                前一为函数 = 假;
                让深度 = 让深度.饱和减(1);
                循环深度 = 循环深度.饱和减(1);
            }
            _ => {
                前一关键字 = 无;
                待定参数 = 无;
                如果 模式匹配!(当前类别, 令牌种类::分号) {
                    // `结构体/枚举 名;`（单元结构体）：放弃类型体等待
                    待定类型 = 无;
                    // 语句边界：清空全部模式状态
                    在实现头内 = 假;
                    在让态 = 假;
                    让深度 = 0;
                    循环待定.清空集合();
                    在循环态 = 假;
                    循环深度 = 0;
                } 否则 如果 模式匹配!(当前类别, 令牌种类::全等) {
                    // `让 模式 =`：模式结束（`=` 之后是表达式）
                    如果 在让态 && 让深度 == 0 {
                        在让态 = 假;
                    }
                    // 循环模式里 `=` 不合法（防御）
                    如果 在循环态 && 循环深度 == 0 {
                        循环待定.清空集合();
                        在循环态 = 假;
                    }
                }
                前为值结尾 = 模式匹配!(
                    当前类别,
                    令牌种类::字面量记号 { .. }
                        | 令牌种类::闭方括号
                        | 令牌种类::闭大括号
                        | 令牌种类::问号符
                );
                前一为函数 = 假;
            }
        }
        偏移 += 词元序列[序号].元素数;
    }
    // 库特征实现块：目标名既不是用户项、又在别名映射表中 → 块内方法名是库 API
    //（判定用扫完后的完整条目集；先全部判定再统一剔除，与旧实现两阶段一致）
    让 可变 库方法名: 向量<&文本> = 向量::新建();
    对于 (块目标, 方法们) 在 &实现块们 {
        如果 声明累计.条目集.包含(*块目标) || !别名映射.包含键(*块目标) {
            继续;
        }
        库方法名.扩展(方法们.迭代().复制值());
    }
    对于 方法 在 库方法名 {
        声明累计.库方法集.置入(方法.转字符串());
        声明累计.条目集.移除(方法);
        声明累计.变量集.移除(方法);
    }
    // 模式绑定最后并入：旧实现顺序为「先剔除库方法名、再并入模式绑定」
    声明累计.变量集.扩展(绑定集);
    声明累计
}

/// 推进声明关键字状态：「可变」透明传递，其余按是否声明关键字更新
函数 下一声明关键字<'甲>(
    前一关键字: 选项<&'甲 文本>,
    文本响应: &'甲 文本,
) -> 选项<&'甲 文本> {
    如果 文本响应 == "mut" {
        返回 前一关键字;
    }
    声明关键字表.迭代().查找(|&&关键字值| 关键字值 == 文本响应).复制值()
}

/// 循环模式挂起中出现的「非模式词」：声明/语句关键字
///
/// 真模式里不可能出现这些词，出现即说明挂起跨越了语句边界
/// （残留/剥离代码），须丢弃挂起，避免把后续代码里的名字误收为绑定。
常量 语句边界关键字表: &[&文本] = &[
    "fn", "struct", "enum", "impl", "trait", "mod", "type", "const", "static", "let", "use", "pub",
    "return", "if", "else", "while", "loop", "match", "break", "continue", "unsafe", "async",
    "await", "move", "where",
];

/// `=>` 回溯：收集匹配臂模式中的绑定名
///
/// 从箭头（索引 `箭头下标`，起点偏移 `箭头偏移`）向左回溯到臂起点
/// （深度 0 的 `,`/`{`/`;`），区间内标识符经 [`是模式绑定`]
/// 过滤后收为值绑定。`{}`/`()`/`[]` 深度配对处理结构体模式
/// （`点 { x, y }`）与嵌套模式。
///
/// 越界防护（weix-1 #27）：带块臂体（`=> { … }`）的**下一臂**回溯时
/// 会先遇到上一臂的块闭合 `}`；若不识别，深度失衡后 `,`/`;` 不再
/// 终止，回溯将穿透上一臂语句，把类型标注（`让 x: T = …` 的 `T`）
/// 等裸标识符误收为值绑定 → 其全文件豁免替换（`无符号机器整数`
/// 的映射目标实测不被翻译，产物 E0425）。块体臂的逗号可省略，其闭合
/// `}` 即当前臂模式的左边界：识别后立即截止
/// （见 [`闭花括号结束臂体`]）。
函数 收集匹配臂绑定(
    词元序列: &[词法解析器::词法令牌],
    箭头偏移: 无符号机器整数,
    箭头下标: 无符号机器整数,
    原因: &文本,
    绑定集: &可变 哈希集合<字符串>,
) {
    // 箭头前一个有意义词元是 `=`（调用方已确认 `=>` 相邻）
    让 有值(等号下标) = 前有效下标(词元序列, 箭头下标) 否则 {
        返回;
    };
    让 可变 深度 = 0u32;
    // 反向累计各词元的起点偏移（切分令牌连续覆盖全源）
    让 可变 起点 = 箭头偏移.饱和减(词元序列[等号下标].元素数);
    对于 下标 在 (0..等号下标).逆序() {
        起点 = 起点.饱和减(词元序列[下标].元素数);
        让 当前类别 = 词元序列[下标].类别值;
        匹配 当前类别 {
            令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. } => {}
            令牌种类::闭圆括号 | 令牌种类::闭方括号 => 深度 += 1,
            令牌种类::闭大括号 => {
                // 上一臂块体闭合即当前臂模式左边界：就此截止，
                // 不得穿入上一臂体（见函数文档「越界防护」）
                如果 深度 == 0 && 闭花括号结束臂体(词元序列, 下标) {
                    中断;
                }
                深度 += 1;
            }
            令牌种类::开圆括号 | 令牌种类::开方括号 => {
                如果 深度 == 0 {
                    中断; // 模式区间外的括号（异常输入）：保守停止
                }
                深度 -= 1;
            }
            令牌种类::开大括号 => {
                如果 深度 == 0 {
                    中断; // 匹配体（或宏体）的起点
                }
                深度 -= 1;
            }
            令牌种类::逗号 | 令牌种类::分号 => {
                如果 深度 == 0 {
                    中断; // 上一臂的分隔或语句边界
                }
            }
            令牌种类::标识符记号 => {
                让 文本响应 = &原因[起点..起点 + 词元序列[下标].元素数];
                如果 是模式绑定(词元序列, 下标, 文本响应) {
                    绑定集.置入(文本响应.转字符串());
                }
            }
            _ => {}
        }
    }
}

/// `}`（索引 `闭合下标`）是否为「臂块体闭合」（`=> { … }` 的收尾）
///
/// 判定：向左找配对的 `{`，其前一个有意义词元是 `=>` 的 `>`（相等与大于号
/// 相邻）则为臂体闭合。结构体模式的 `}`（配对 `{` 前是路径名，如
/// `点 { x }`、`点<T> { x }`）返回假，照常参与深度配对。
函数 闭花括号结束臂体(
    词元序列: &[词法解析器::词法令牌],
    闭合下标: 无符号机器整数,
) -> 布尔 {
    让 可变 深度 = 0u32;
    让 可变 游标 = 闭合下标;
    当 游标 > 0 {
        游标 -= 1;
        匹配 词元序列[游标].类别值 {
            令牌种类::闭大括号 => 深度 += 1,
            令牌种类::开大括号 => {
                如果 深度 == 0 {
                    // 配对 `{`：前一个有意义词元是 `=>` 的 `>`？
                    返回 前有效下标(词元序列, 游标).有值且(|前下标| {
                        词元序列[前下标].类别值 == 令牌种类::大于号
                            && 前有效下标(词元序列, 前下标).有值且(|再前下标| {
                                词元序列[再前下标].类别值 == 令牌种类::全等
                                    && 再前下标 == 前下标 - 1
                            })
                    });
                }
                深度 -= 1;
            }
            _ => {}
        }
    }
    假
}

/// 模式内标识符的「值绑定」判定
///
/// 「可变」/「引用」修饰符不是名字；`::` 路径段（变体/常量路径）、后跟
/// `(`/`{`/`[` 的构造路径（`有值(…)`、`点 { … }`）、后跟 `:` 的
/// 字段名（`x: 甲` 的 `x`，兼作 `::` 前段判定）都不是绑定。
函数 是模式绑定(
    词元序列: &[词法解析器::词法令牌],
    序号: 无符号机器整数,
    文本响应: &文本,
) -> 布尔 {
    如果 文本响应 == "mut" || 文本响应 == "ref" {
        返回 假;
    }
    如果 让 有值(后下标) = 后有效下标(词元序列, 序号) {
        匹配 词元序列[后下标].类别值 {
            令牌种类::冒号
            | 令牌种类::开圆括号
            | 令牌种类::开大括号
            | 令牌种类::开方括号 => 返回 假,
            _ => {}
        }
    }
    // 前是 `::` 后段（前两个有意义词元都是冒号）→ 路径段，不是绑定
    如果 让 有值(前下标) = 前有效下标(词元序列, 序号)
        && 词元序列[前下标].类别值 == 令牌种类::冒号
        && 让 有值(再前下标) = 前有效下标(词元序列, 前下标)
        && 词元序列[再前下标].类别值 == 令牌种类::冒号
    {
        返回 假;
    }
    真
}

/// 序号之前（不含序号）第一个有意义词元的下标（跳过空白/注释）
函数 前有效下标(
    词元序列: &[词法解析器::词法令牌],
    序号: 无符号机器整数,
) -> 选项<无符号机器整数> {
    词元序列[..序号].迭代().反向位置(|词元| !是琐碎词元(词元.类别值))
}

/// 序号之后（不含序号）第一个有意义词元的下标（跳过空白/注释）
函数 后有效下标(
    词元序列: &[词法解析器::词法令牌],
    序号: 无符号机器整数,
) -> 选项<无符号机器整数> {
    词元序列[序号 + 1..]
        .迭代()
        .位置(|词元| !是琐碎词元(词元.类别值))
        .变换(|位置| 位置 + 序号 + 1)
}

/// 空白/注释（琐碎词元）：不参与相邻性判断
函数 是琐碎词元(当前类别: 令牌种类) -> 布尔 {
    模式匹配!(
        当前类别,
        令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. }
    )
}
/// 将源码中的中文别名替换为英文标识符（仅替换标识符词元）
///
/// 输入应为已完成关键字转译的代码（声明关键字已是英文形式）。
/// 声明位的标识符（如 `函数 绝对值()`、`让 字符串 = 1`）保留原样，
/// 且这些用户声明名在文件内的使用处也不替换；`::` 限定后的路径段
/// 仅对「变量名」不豁免（如 `字符串::新建` 里的 `新建` 是库 API，
/// 照常替换），用户声明的项可经 `::` 访问（`接口错误::错误请求`），
/// 仍豁免。库特征实现块内的方法名是库 API 名称，照常替换（见模块文档）。
///
/// # 参数
/// - `原因`: 待替换的源码字符串
/// - `别名映射表`: 中文别名 → 英文原名 的映射表
///
/// # 返回
/// 替换后的源码字符串
公开 函数 替换别名(原因: &文本, 别名映射: &哈希映射<字符串, 字符串>) -> 字符串 {
    带映射替换别名(原因, 别名映射).输出文本
}

/// 同 [`替换别名`]，同时产出编辑表（本阶段输入坐标）
公开 函数 带映射替换别名(
    原因: &文本,
    别名映射: &哈希映射<字符串, 字符串>,
) -> 替换结果 {
    带上下文替换别名(原因, 别名映射, 无)
}

/// 同 [`带映射替换别名`]，附项目级声明上下文（跨文件声明豁免）
///
/// `项目` 为 `无` 时行为与 [`带映射替换别名`] 完全一致。
/// 提供上下文时在逐文件豁免之上额外豁免：
/// - 项目声明名（含其他文件声明的项/结构体字段）的裸使用处；
/// - 项目模块名的裸使用处；
/// - 以包根、父级、自身、项目模块名、项目项名为根的 `::` 路径链：
///   链内**与项目声明名同名**的段豁免（`包::平台Linux::Linux内存源::新建`
///   ——跨文件引用成员与声明侧一致，避免 E0599）；链内非项目名
///   （`源码映射项::新建` 的 `新建` 未定义于项目）照常替换。
///   `::` 后非项目根的段（`盒子::新建`）同样照常替换：`新建` 是库 API。
公开 函数 带上下文替换别名(
    原因: &文本,
    别名映射: &哈希映射<字符串, 字符串>,
    项目: 选项<&项目上下文>,
) -> 替换结果 {
    带上下文与模块路径替换别名(原因, 别名映射, &哈希映射::新建(), 项目)
}

/// 别名阶段的名字级事实：一次解出主循环要问的那几张表的答案
///
/// 主循环对每个标识符都要查别名表、判定项目路径根（`模块集`/`条目集` 两次
/// 哈希查找）、推进声明关键字状态（`声明关键字表` 线性扫）。这三件事只取决于
/// 名字本身，因此按名字直映缓存（见 [`包::名字缓存`]）：同名重复出现时
/// 只付一次探测。模块路径表**不在**缓存内——它只在路径根位（后跟 `::`）才
/// 需要，而路径根位是少数，无条件预查反而会为每个标识符多搭一次随机访存。
#[派生(克隆, 可复制)]
结构体 别名事实<'甲> {
    /// 别名表命中值
    别名值: 选项<&'甲 文本>,
    /// 项目路径根（包根、父级、自身、项目模块名、项目项名）；无项目上下文时恒假
    路径根: 布尔,
    /// 声明位关键字（「可变」除外：它的透明传递由调用处按上一个状态处理）
    声明关键字: 选项<&'甲 文本>,
}

/// 同 [`带上下文替换别名`]，附模块路径表（导入语句之外的模块前缀转译）
///
/// 管线的「模块路径替换」阶段只处理导入语句；表达式与属性位置的
/// `模块词::项`（`异步运行时::睡眠`、`#[异步运行时::主函数]`）在本函数内
/// 回退模块路径表完成（office-zb #10/#18：此前「模块词」保留、「项」被
/// 别名替换，产物 `异步运行时::主函数` 报 E0433）。回退规则：
/// - 仅**路径根位置**（后跟 `::`、且前不是 `::` 的段）触发；
/// - 别名表命中优先——标识符语义覆盖模块语义（`路径::新建` 的 `路径`
///   是 `Path` 而非 `path` 模块）；
/// - 路径根位上的字段/变量名豁免不适用（见 `使用处豁免` 的根位分支）；
/// - 替换值做包名连字符规范化（`-` → `_`）。
公开 函数 带上下文与模块路径替换别名(
    原因: &文本,
    别名映射: &哈希映射<字符串, 字符串>,
    模块路径映射: &哈希映射<字符串, 字符串>,
    项目: 选项<&项目上下文>,
) -> 替换结果 {
    按声明替换别名(原因, 别名映射, 模块路径映射, 项目, 无)
}

/// 同 [`带上下文与模块路径替换别名`]，但可复用调用方已收集好的声明名
///
/// 延迟项目上下文的管线入口必须在别名阶段之前先拿到本文件声明才能建项目
/// 上下文，而它拿到的声明是从**词法产物**收集的；本阶段的输入则是
/// 「词法 → 导入路径 → `包::` 前缀」之后的文本。两处的声明集合相同（后续
/// 两个阶段只改导入路径段与路径根位前缀，既不动声明关键字也不动声明位
/// 名字），因此可省掉本阶段内部那趟声明状态机（分词仍要为替换主循环付，
/// 省不掉）——359 行样例上该状态机 47.3 µs，占管线约 9%，现场收集整趟
/// （含分词）则占 ~21%。
///
/// 等价性由 `tests/alias_declared_reuse.rs` 的差分测试锁定：两条入口对同一
/// 语料的输出文本与编辑表逐字段一致。`已声明集合` 为 `无` 时行为与原入口相同。
公开 函数 按声明替换别名(
    原因: &文本,
    别名映射: &哈希映射<字符串, 字符串>,
    模块路径映射: &哈希映射<字符串, 字符串>,
    项目: 选项<&项目上下文>,
    已声明集合: 选项<&已声明名集合>,
) -> 替换结果 {
    复用替换别名(原因, 别名映射, 模块路径映射, 项目, 已声明集合, 无)
}

/// [`按声明替换别名`] 的实现，另可复用调用方已分好的词元流
///
/// `词元序列` 必须与 `原因` 同一份文本（同一序列）。管线里本阶段的输入是
/// 「词法 → 导入路径」之后的文本，那份词元流可由「词法产物的词元 + 导入路径
/// 阶段各编辑的新长度」派生（见「派生词元序列」），省掉整份重新分词——
/// 359 行样例上该分词 46~72 µs，占管线一成上下。
公开(包) 函数 复用替换别名<'甲>(
    原因: &'甲 文本,
    别名映射: &'甲 哈希映射<字符串, 字符串>,
    模块路径映射: &'甲 哈希映射<字符串, 字符串>,
    项目: 选项<&'甲 项目上下文>,
    已声明集合: 选项<&'甲 已声明名集合>,
    词元选项: 选项<&'甲 [词法解析器::词法令牌]>,
) -> 替换结果 {
    // 映射表为空时直接返回，避免不必要的词法分析开销
    如果 别名映射.是否为空() && 模块路径映射.是否为空() {
        返回 替换结果 {
            输出文本: 原因.转字符串(),
            编辑表: 向量::新建(),
        };
    }
    // 词元序列只解析一次：候选位预扫、声明名收集与替换主循环共享（`.方法()`
    // 判定需向后看一位——下一个有意义词元是否为 `(`，字段访问 `实例.字段`
    // 与方法调用 `实例.方法()` 的豁免集合不同）。调用方已分好词时直接借用
    让 自持词元: 向量<词法解析器::词法令牌>;
    让 词元序列: &[词法解析器::词法令牌] = 匹配 词元选项 {
        有值(词元流) => 词元流,
        无 => {
            自持词元 = 包::收集令牌(原因);
            &自持词元
        }
    };
    // 候选位预扫：整份源码没有任何替换候选（别名表命中 / 路径根位命中模块
    // 路径表）时直接原样返回。真实语料 1192 份里 774 份属于这一类，此前照旧
    // 付「声明名收集 + 逐位置豁免判定」两趟（该阶段 6.1 ms 里的 4.2 ms）
    如果 !有替换候选(词元序列, 原因, 别名映射, 模块路径映射) {
        返回 替换结果 {
            输出文本: 原因.转字符串(),
            编辑表: 向量::新建(),
        };
    }
    // 第一遍：收集用户声明名与库特征方法名（使用处豁免见已声明名集合）。
    // 调用方已收集好时直接借用，未收集时才现场走状态机
    让 自持声明: 已声明名集合;
    让 已声明: &已声明名集合 = 匹配 已声明集合 {
        有值(声明实例) => 声明实例,
        无 => {
            自持声明 = 在文本中收集声明名(原因, 别名映射, 词元序列);
            &自持声明
        }
    };
    // 名字级事实缓存（见 [`别名事实`]）：按名字直映
    让 可变 名字缓存实例: 名字缓存<'_, 别名事实<'_>> = 名字缓存::新建();
    // 单个冒号跟踪：词法器把 `::` 拆成两个冒号词元
    让 可变 上一为冒号 = 假;
    // 输出只在替换点刷出：未命中的词元不逐个推入，替换时才把
    // 「上次刷出位置 → 本词元起点」的原始片段整段拷过去。2000 行样例
    // 有 1.5 万个词元、替换点只有几十个，逐词元复制是纯开销
    让 可变 输出文本 = 字符串::带容量(原因.元素数());
    让 可变 拷贝游标 = 0usize;
    让 可变 编辑表 = 向量::新建();
    让 可变 当前偏移 = 0;
    // 上一个有意义词元若是声明关键字，记录其文本（「可变」透明传递）；
    // 空白/注释不重置该状态
    让 可变 前一关键字: 选项<&'甲 文本> = 无;
    // 上一个有意义词元是否为 `::`（两个连续冒号词元的第二个）
    让 可变 前一为路径分隔 = 假;
    // 上一个有意义词元是否为 `.`（成员访问/方法链）
    让 可变 前一为圆点 = 假;
    // —— 项目路径链跟踪（仅项目为有值时生效）——
    // 待定项目根：上一标识符是项目根候选（包根/模块名/项名），
    // 等待 `::` 确认；在项目路径内：根段已确认，链内段按项目声明名豁免
    让 可变 待定项目根 = 假;
    让 可变 在项目路径内 = 假;

    对于 (序号, 词元) 在 词元序列.迭代().枚举() {
        让 词元长度 = 词元.元素数;
        让 文本响应 = &原因[当前偏移..当前偏移 + 词元长度];
        匹配 词元.类别值 {
            令牌种类::标识符记号 => {
                // 替换候选先行判定：别名表命中，或处于路径根位且模块路径表命中。
                // 两者皆无时是否豁免不影响输出（豁免只决定要不要替换），直接原样
                // 输出：大文件里绝大多数标识符走这条快路，省掉 5 次豁免哈希查找
                让 事实 = 名字缓存实例.取或解析(文本响应, || 别名事实 {
                    别名值: 别名映射.获取(文本响应).变换(字符串::作为字符串),
                    路径根: 项目.有值且(|项目引用| 项目引用.是路径根(文本响应)),
                    声明关键字: 声明关键字表
                        .迭代()
                        .查找(|&&关键字值| 关键字值 == 文本响应)
                        .复制值(),
                });
                让 别名命中 = 事实.别名值;
                让 是路径头候选 =
                    !前一为路径分隔 && 后有效为路径分隔(词元序列, 序号);
                // 模块路径表只在路径根位查一次（命中判定与取值共用同一次查找）
                让 模块命中 = 如果 是路径头候选 {
                    模块路径映射.获取(文本响应).变换(字符串::作为字符串)
                } 否则 {
                    无
                };
                // 项目路径链状态必须无条件推进（链内段的豁免判定依赖它，与当前
                // 标识符是否有替换候选无关）；根段确认依赖上一标识符留存的候选
                // 标记与当前 `::` 状态
                让 在项目链内 = 项目.是否为有值()
                    && (在项目路径内 || (待定项目根 && 前一为路径分隔));
                如果 在项目链内 {
                    在项目路径内 = 真;
                }
                如果 别名命中.是否为有值() || 模块命中.是否为有值() {
                    // `.方法()` 位：`.` 后的标识符且下一个有意义词元是 `(`
                    //（字段名不是方法名，豁免集合见下方使用处豁免）
                    让 于方法位 =
                        前一为圆点 && 后有效为左括号(词元序列, 序号);
                    // 路径根位置（首段）：后跟 `::` 且前不是 `::` 的标识符——
                    // `模块词::项` 的首段。字段/变量不可经 `::` 访问，根位豁免
                    // 不适用（office-zb #27）；模块词回退替换亦仅限根位
                    让 于路径头 = 是路径头候选;
                    // 声明位保护：紧随声明关键字的名字是用户自己的定义；
                    // 例外——库特征实现块内「函数」关键字后的方法名是库 API 名称
                    //（见「库特征实现方法收集」），照常参与替换
                    让 声明受保护 = 前一关键字.是否为有值()
                        && !(前一关键字 == 有值("fn") && 已声明.库方法集.包含(文本响应));
                    // 各位置豁免集合：
                    // - 链内：仅项目声明名（项/模块）——`平台Linux::新建` 豁免，
                    //   未定义于项目的 `源码映射项::新建` 照常替换（与教程
                    //   `fn new` 定义侧一致）；
                    // - `::` 后非链（根非项目根）：无项目上下文时保留旧行为
                    //   （本文件项名豁免，`接口错误::错误请求`）；有上下文时
                    //   一律按库 API 替换（`盒子::新建` 的同名项目项不得误伤）；
                    // - `.方法()` 位：仅项目方法名（项集合）——`编辑表.长度()`
                    //   的 `长度` 是 `向量::长度` 调用，字段名豁免不适用于方法位；
                    // - 其他：本文件声明名 + 项目裸使用处豁免（含结构体字段）
                    让 使用处豁免 = 如果 在项目链内 {
                        已声明.条目集.包含(文本响应)
                            || 项目.有值且(|项目引用| {
                                项目引用.条目集.包含(文本响应)
                                    || 项目引用.模块集.包含(文本响应)
                            })
                    } 否则 如果 前一为路径分隔 {
                        项目.是否为无() && 已声明.条目集.包含(文本响应)
                    } 否则 如果 于方法位 {
                        已声明.条目集.包含(文本响应)
                            || 项目.有值且(|项目引用| 项目引用.条目集.包含(文本响应))
                    } 否则 如果 于路径头 {
                        // 路径根位（后跟 `::`）：字段/变量/裸名豁免不适用——它们
                        // 不可经 `::` 访问。缺陷回归（office-zb #27 字段场景）：
                        // 字段名与词表词撞名（如「天数」词条）时，`天数::新建`
                        // 曾因字段豁免保留「天数」、只替换段位 → `天数::new`
                        // 报 E0433；字面量/字段访问位等非根位仍按字段豁免。
                        // 仅本文件项名与项目项名/模块名（路径链根）在根位豁免
                        已声明.条目集.包含(文本响应) || 事实.路径根
                    } 否则 {
                        已声明.条目集.包含(文本响应)
                            || 已声明.变量集.包含(文本响应)
                            || 已声明.成员集.包含(文本响应)
                            // 项目声明名（项+字段，含其他文件声明）与项目根词
                            //（模块名；包根/父级/自身为英文，替换表不会命中，
                            // 在此仅作为路径链起点）
                            || 项目.有值且(|项目引用| 项目引用.裸使用豁免(文本响应))
                            || 事实.路径根
                    };
                    // 声明位标识符与用户声明名的使用处保留原样（随片段拷出）
                    如果 !声明受保护 && !使用处豁免 {
                        如果 让 有值(英文名) = 别名命中 {
                            编辑表.推(源码映射条目::新建(
                                当前偏移,
                                词元长度,
                                文本响应,
                                英文名,
                            ));
                            输出文本.推入字符串(&原因[拷贝游标..当前偏移]);
                            输出文本.推入字符串(英文名);
                            拷贝游标 = 当前偏移 + 词元长度;
                        } 否则 如果 让 有值(英文名) = 模块命中 {
                            // 路径根位回退模块路径表：`异步运行时::睡眠` → `tokio::sleep`、
                            // `#[异步运行时::主函数]` → `#[tokio::main]`（office-zb #10/#18）。
                            // 导入语句内已在管线模块路径阶段替换，此处覆盖表达式/属性位置
                            让 规范化值 = 包::模块路径::规范化包名连字符(英文名);
                            让 替换值 = 规范化值.作为解引用().取值或(英文名);
                            编辑表.推(源码映射条目::新建(
                                当前偏移,
                                词元长度,
                                文本响应,
                                替换值,
                            ));
                            输出文本.推入字符串(&原因[拷贝游标..当前偏移]);
                            输出文本.推入字符串(替换值);
                            拷贝游标 = 当前偏移 + 词元长度;
                        }
                    }
                }
                // 根段候选判定（基于母语原文；`包` 等已在词法阶段转为英文）
                待定项目根 = 事实.路径根;
                // `让 可变 名称`：声明位内的可变透明传递声明状态；
                // `&可变 类型` 等非声明位的可变不传递，库类型引用仍被替换
                前一关键字 = 如果 文本响应 == "mut" {
                    前一关键字
                } 否则 {
                    事实.声明关键字
                };
                前一为路径分隔 = 假;
                前一为圆点 = 假;
            }
            令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. } => {
                // 空白与注释不打断声明状态、路径限定状态与成员访问状态；
                // 原文随片段拷出，无需单独输出
            }
            _ => {
                // 符号终结声明位；连续两个冒号构成 `::` 路径限定
                前一关键字 = 无;
                让 是冒号 = 模式匹配!(词元.类别值, 令牌种类::冒号);
                // 非冒号符号终结项目路径链（`::` 的冒号保持链状态）
                如果 !是冒号 {
                    在项目路径内 = 假;
                    待定项目根 = 假;
                }
                前一为路径分隔 = 如果 是冒号 {
                    前一为路径分隔 || 上一为冒号
                } 否则 {
                    假
                };
                上一为冒号 = 是冒号;
                前一为圆点 = 模式匹配!(词元.类别值, 令牌种类::圆点);
            }
        }
        当前偏移 += 词元长度;
    }
    输出文本.推入字符串(&原因[拷贝游标..]);
    替换结果 { 输出文本, 编辑表 }
}

/// 整份源码是否存在任何替换候选
///
/// 主循环只在两处替换：别名表命中，或路径根位（后跟 `::`、前不是 `::`）命中
/// 模块路径表。声明名收集与逐位置豁免判定都只服务于这些候选，因此候选数为零
/// 的文件整条阶段可以省掉——扫描本身只做一次标识符查表 + 路径根位前瞻，比
/// 「收集声明 + 判定豁免」两趟便宜得多。
///
/// 状态机与主循环逐字对齐（`::` 由两个冒号词元构成、空白/注释不打断），
/// 否则预扫可能漏判候选，把该替换的文件原样返回。
函数 有替换候选(
    词元序列: &[词法解析器::词法令牌],
    原因: &文本,
    别名映射: &哈希映射<字符串, 字符串>,
    模块路径映射: &哈希映射<字符串, 字符串>,
) -> 布尔 {
    让 可变 偏移 = 0usize;
    让 可变 上一为冒号 = 假;
    让 可变 前一为路径分隔 = 假;
    对于 (序号, 词元) 在 词元序列.迭代().枚举() {
        让 文本响应 = &原因[偏移..偏移 + 词元.元素数];
        匹配 词元.类别值 {
            令牌种类::标识符记号 => {
                如果 别名映射.包含键(文本响应) {
                    返回 真;
                }
                如果 !前一为路径分隔
                    && !模块路径映射.是否为空()
                    && 模块路径映射.包含键(文本响应)
                    && 后有效为路径分隔(词元序列, 序号)
                {
                    返回 真;
                }
                前一为路径分隔 = 假;
            }
            令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. } => {}
            _ => {
                让 是冒号 = 模式匹配!(词元.类别值, 令牌种类::冒号);
                前一为路径分隔 = 如果 是冒号 {
                    前一为路径分隔 || 上一为冒号
                } 否则 {
                    假
                };
                上一为冒号 = 是冒号;
            }
        }
        偏移 += 词元.元素数;
    }
    假
}

/// 下一个有意义词元（跳过空白/注释）是否为 `(`
///
/// 判定标识符处于「方法调用位」（`实例.方法()`）而非「字段访问位」
///（`实例.字段`）——两者豁免集合不同（字段名不是方法名）。
/// 行选择上限：词法器的词法令牌仅含种类与长度，词元序列与源码
/// 对齐，下标序号即偏移序位。
函数 后有效为左括号(
    词元序列: &[词法解析器::词法令牌],
    序号: 无符号机器整数,
) -> 布尔 {
    词元序列
        .获取(序号 + 1..)
        .取值或默认()
        .迭代()
        .查找(|词元| {
            !模式匹配!(
                词元.类别值,
                令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. }
            )
        })
        .有值且(|词元| 模式匹配!(词元.类别值, 令牌种类::开圆括号))
}

/// 下一个有意义词元（跳过空白/注释）是否为 `::`
///
/// 判定标识符处于「路径根位置」（`模块词::项` 的首段）。词法器将
/// `::` 拆分为两个连续冒号词元；空白/注释不打断（与主循环
/// `上一为冒号` 状态对空白的处理一致）。
函数 后有效为路径分隔(
    词元序列: &[词法解析器::词法令牌],
    序号: 无符号机器整数,
) -> 布尔 {
    让 可变 冒号计数 = 0;
    对于 词元 在 词元序列.获取(序号 + 1..).取值或默认() {
        如果 模式匹配!(
            词元.类别值,
            令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. }
        ) {
            继续;
        }
        如果 模式匹配!(词元.类别值, 令牌种类::冒号) {
            冒号计数 += 1;
            如果 冒号计数 >= 2 {
                返回 真;
            }
            继续;
        }
        返回 假;
    }
    假
}
#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    函数 别名映射夹具() -> 哈希映射<字符串, 字符串> {
        哈希映射::从([
            ("绝对值".转字符串(), "abs".转字符串()),
            ("字符串".转字符串(), "String".转字符串()),
        ])
    }

    /// 零候选文件：整份源码既无别名表命中、也无路径根位命中模块路径表时，
    /// 预扫直接原样返回（不产出编辑）。早期实现照旧付「声明名收集 + 逐位置
    /// 豁免判定」两趟，等价性由本测试与下方候选位测试共同锁定。
    #[测试]
    函数 零候选文件原样返回() {
        让 变换 = 别名映射夹具();
        让 源码 = "fn 主函数() {\n    let x = 1;\n    let 总和 = x + 2;\n}\n";
        让 结果值 = 带上下文与模块路径替换别名(源码, &变换, &哈希映射::新建(), 无);
        断言相等!(结果值.输出文本, 源码);
        断言!(结果值.编辑表.是否为空(), "无候选文件不应产出编辑：{:?}", 结果值.编辑表);
    }

    /// 预扫的状态机必须与主循环一致：`::` 由两个连续冒号词元组成，中间允许
    /// 夹空白与注释。预扫若漏认路径根位，整份文件会被误判为零候选而原样返回。
    #[测试]
    函数 候选预扫识别琐碎路径分隔() {
        让 变换 = 哈希映射::从([("打印".转字符串(), "print".转字符串())]);
        让 模块表 = 哈希映射::从([("异步运行时".转字符串(), "tokio".转字符串())]);
        对于 源码 在 [
            "异步运行时::睡眠(1);",
            "异步运行时 :: 睡眠(1);",
            "异步运行时: /* c */ : 睡眠(1);",
        ] {
            让 结果值 =
                带上下文与模块路径替换别名(源码, &变换, &模块表, 无);
            断言!(
                !结果值.编辑表.是否为空(),
                "路径根位候选被预扫漏掉，整份文件原样返回：{源码}"
            );
            断言!(
                结果值.输出文本.包含("tokio"),
                "路径根位未回退模块路径表：{}",
                结果值.输出文本
            );
        }
    }

    /// 有候选但候选全被豁免（声明位）：输出必须与零候选路径一致——原样、无编辑。
    /// 豁免只决定「要不要替换」，不创造替换；预扫据此只看候选存在性。
    #[测试]
    函数 豁免候选不产出编辑() {
        让 变换 = 别名映射夹具();
        让 源码 = "struct 字符串;\n";
        让 结果值 =
            带上下文与模块路径替换别名(源码, &变换, &哈希映射::新建(), 无);
        断言相等!(结果值.输出文本, 源码);
        断言!(结果值.编辑表.是否为空(), "声明位不应被替换：{:?}", 结果值.编辑表);
    }

    /// 有候选文件不受预扫影响：所有可替换点仍照常替换（含路径根段与类型位）。
    #[测试]
    函数 有候选时仍替换全部位置() {
        让 变换 = 哈希映射::从([
            ("字符串".转字符串(), "String".转字符串()),
            ("新建".转字符串(), "new".转字符串()),
        ]);
        让 源码 = "fn 主函数() {\n    let b = 字符串::新建();\n    let c: 字符串 = b;\n}\n";
        让 结果值 =
            带上下文与模块路径替换别名(源码, &变换, &哈希映射::新建(), 无);
        断言!(
            结果值.输出文本.包含("String::new()"),
            "路径根与段位未全部替换：{}",
            结果值.输出文本
        );
        断言!(
            结果值.输出文本.包含("let c: String = b;"),
            "类型位未替换：{}",
            结果值.输出文本
        );
        断言相等!(
            结果值.编辑表.元素数(),
            3,
            "可替换点应全部替换：{:?}",
            结果值.编辑表
        );
    }

    #[测试]
    函数 方法调用与类型位替换() {
        让 输出 = 替换别名("let s: 字符串 = x.绝对值();", &别名映射夹具());
        断言相等!(输出, "let s: String = x.abs();");
    }

    #[测试]
    函数 声明位保留() {
        让 输出 = 替换别名("fn 绝对值() {}\nlet 字符串 = 1;", &别名映射夹具());
        断言相等!(输出, "fn 绝对值() {}\nlet 字符串 = 1;");
    }

    #[测试]
    函数 已声明名使用处保留() {
        // 用户声明名在使用处同样豁免：声明位保护不能只保护声明点
        让 输出 = 替换别名("let 字符串 = 1;\nlet y = 字符串 + 2;", &别名映射夹具());
        断言相等!(输出, "let 字符串 = 1;\nlet y = 字符串 + 2;");
    }

    #[测试]
    函数 未声明别名使用处仍替换() {
        // 无用户声明撞名时，使用处照常替换
        让 输出 = 替换别名("let y = 字符串::from(x);", &别名映射夹具());
        断言相等!(输出, "let y = String::from(x);");
    }

    #[测试]
    函数 路径段不豁免() {
        // `::` 限定后的路径段是库 API 访问，不受用户声明名豁免；
        // 裸使用处（第一行声明与第三行变量引用）仍豁免
        让 变换 = 哈希映射::从([
            ("字符串".转字符串(), "String".转字符串()),
            ("新建".转字符串(), "new".转字符串()),
        ]);
        让 输出 = 替换别名(
            "let 新建 = 5;\nlet s = 字符串::新建();\nlet y = 新建;",
            &变换,
        );
        断言相等!(输出, "let 新建 = 5;\nlet s = String::new();\nlet y = 新建;");
    }

    #[测试]
    函数 结构体与常量声明保留() {
        让 输出 = 替换别名("struct 字符串;\nconst 绝对值: i32 = 1;", &别名映射夹具());
        断言相等!(输出, "struct 字符串;\nconst 绝对值: i32 = 1;");
    }

    #[测试]
    函数 让可变声明保留() {
        // 可变透明传递声明状态，变量名仍受保护
        让 输出 = 替换别名("let mut 绝对值 = 1;", &别名映射夹具());
        断言相等!(输出, "let mut 绝对值 = 1;");
    }

    #[测试]
    函数 引用可变类型仍替换() {
        // `&mut 类型` 是非声明位，库类型引用仍应替换
        让 输出 = 替换别名("fn f(x: &mut 字符串) {}", &别名映射夹具());
        断言相等!(输出, "fn f(x: &mut String) {}");
    }

    #[测试]
    函数 函数参数绑定保留() {
        // 函数参数名是值绑定（用户命名）：声明与使用处均保留，
        // 与格式化串中的 `{路径}` 保持一致（避免 E0425）
        让 变换 = 哈希映射::从([("路径".转字符串(), "Path".转字符串())]);
        让 源码 = "fn 完整网址(路径: &str) -> String { format!(\"{路径}\") }";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, 源码);
    }

    #[测试]
    函数 参数类型位仍替换() {
        // 参数「类型」位置的映射词照常替换，只保护名字
        让 变换 = 哈希映射::从([
            ("路径".转字符串(), "Path".转字符串()),
            ("字符串".转字符串(), "String".转字符串()),
        ]);
        让 输出 = 替换别名("fn f(路径: &字符串) {}", &变换);
        断言相等!(输出, "fn f(路径: &String) {}");
    }

    #[测试]
    函数 闭包参数绑定保留() {
        让 变换 = 哈希映射::从([("值".转字符串(), "values".转字符串())]);
        让 输出 = 替换别名("let f = |值| 值 + 1;", &变换);
        断言相等!(输出, "let f = |值| 值 + 1;");
    }

    #[测试]
    函数 移动闭包参数绑定保留() {
        让 变换 = 哈希映射::从([("值".转字符串(), "values".转字符串())]);
        让 输出 = 替换别名("let f = move |值| 值 + 1;", &变换);
        断言相等!(输出, "let f = move |值| 值 + 1;");
    }

    #[测试]
    函数 按位或不当闭包() {
        // `a | b` 的 `|` 前是表达式结尾，不是闭包起始；`值` 照常替换
        让 变换 = 哈希映射::从([("值".转字符串(), "values".转字符串())]);
        让 输出 = 替换别名("let r = a | 值;", &变换);
        断言相等!(输出, "let r = a | values;");
    }

    #[测试]
    函数 逻辑或不当闭包() {
        // `a || 值` 是两个连续的 `|` 词元：第二个不得判定为闭包起始
        让 变换 = 哈希映射::从([("值".转字符串(), "values".转字符串())]);
        让 输出 = 替换别名("let r = a || 值;", &变换);
        断言相等!(输出, "let r = a || values;");
    }

    #[测试]
    函数 空闭包参数不当绑定() {
        // `|| 值` 是零参数闭包：`值` 不是绑定名，照常替换
        让 变换 = 哈希映射::从([("值".转字符串(), "values".转字符串())]);
        让 输出 = 替换别名("let f = || 值;", &变换);
        断言相等!(输出, "let f = || values;");
    }

    #[测试]
    函数 声明关键字与名字间注释() {
        让 输出 = 替换别名("fn /* 说明 */ 绝对值() {}", &别名映射夹具());
        断言相等!(输出, "fn /* 说明 */ 绝对值() {}");
    }

    #[测试]
    函数 实现目标仍替换() {
        // 实现后的特征/类型多为库 API，不在保护名单内
        让 输出 = 替换别名("impl 字符串 for 客户端 {}", &别名映射夹具());
        断言相等!(输出, "impl String for 客户端 {}");
    }

    #[测试]
    函数 用户项路径豁免() {
        // 用户声明的项可经 `::` 访问：调用处仍豁免，与定义侧一致（避免 E0599）
        让 变换 = 哈希映射::从([
            ("错误请求".转字符串(), "bad_request".转字符串()),
            ("未找到".转字符串(), "not_found".转字符串()),
        ]);
        让 源码 = "struct 接口错误;\nimpl 接口错误 {\n    fn 错误请求() {}\n    fn 未找到() {}\n}\nlet e = 接口错误::错误请求();";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, 源码);
    }

    #[测试]
    函数 库特征实现方法替换() {
        // 库特征实现块内的方法名是库 API 名称，照常替换（避免 E0407/E0046）
        让 变换 = 哈希映射::从([
            ("抄写器".转字符串(), "Scribe".转字符串()),
            ("渲染".转字符串(), "render".转字符串()),
            ("响应".转字符串(), "Response".转字符串()),
        ]);
        让 输出 = 替换别名(
            "impl 抄写器 for 接口错误 {\n    fn 渲染(self, r: &mut 响应) { r.渲染(); }\n}",
            &变换,
        );
        断言相等!(
            输出,
            "impl Scribe for 接口错误 {\n    fn render(self, r: &mut Response) { r.render(); }\n}"
        );
    }

    #[测试]
    函数 用户特征实现方法保留() {
        // 用户自定义特征（非映射词）的实现：方法名是用户取的，保持保护；
        // 特征声明与实现均保留中文
        让 变换 = 哈希映射::从([("描述".转字符串(), "describe".转字符串())]);
        让 源码 = "trait 可显示 {\n    fn 描述(&self);\n}\nimpl 可显示 for 狗 {\n    fn 描述(&self) {}\n}\n狗.描述();";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, 源码);
    }

    #[测试]
    函数 字符串字面量与注释不动() {
        让 输出 = 替换别名("println!(\"绝对值\"); // 绝对值", &别名映射夹具());
        断言相等!(输出, "println!(\"绝对值\"); // 绝对值");
    }

    #[测试]
    函数 结构体字段名保留() {
        // 结构体字段名是用户命名（撞「值」映射键）：定义/构造/访问处
        // 全豁免；字段不可经 `::` 访问故收作值绑定
        让 变换 = 哈希映射::从([("值".转字符串(), "values".转字符串())]);
        让 源码 = "struct 容器 { 值: i32 }\nlet c = 容器 { 值: 1 };\nlet x = c.值;";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, 源码);
    }

    #[测试]
    函数 枚举变体名保留() {
        // 枚举变体名是用户命名（撞「保留」「丢弃」映射键）：
        // 定义与 `::` 限定使用处均豁免（变体可经 `::` 访问，收作项）
        让 变换 = 哈希映射::从([
            ("保留".转字符串(), "retain".转字符串()),
            ("丢弃".转字符串(), "drop".转字符串()),
        ]);
        让 源码 = "enum 判定结果 { 保留, 丢弃 }\nlet r = 判定结果::保留;";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, 源码);
    }

    #[测试]
    函数 枚举变体结构体字段保留() {
        // 变体携带的结构体字段同受豁免；反例——无声明时映射词照常替换
        让 变换 = 哈希映射::从([("内容".转字符串(), "contents".转字符串())]);
        让 源码 = "enum 消息 { 退出, 写入 { 内容: String } }\nlet m = 消息::写入 { 内容: String::new() };";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, 源码);
        让 输出乙 = 替换别名("let x = 内容 + 1;", &变换);
        断言相等!(输出乙, "let x = contents + 1;");
    }

    #[测试]
    函数 公开结构体字段保留() {
        // 公开与包内可见性修饰的字段名收集（可见性修饰不消耗
        // 成员开始位，括号内标识符不参与收集）
        让 变换 = 哈希映射::从([
            ("值".转字符串(), "values".转字符串()),
            ("计数".转字符串(), "count".转字符串()),
        ]);
        让 源码 = "struct 容器 { pub 值: i32, pub(crate) 计数: u32 }";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, 源码);
    }

    #[测试]
    函数 泛型与属性成员不误收() {
        // 泛型参数 `乙` 不得被误收为字段（无声明则照常替换）
        让 变换 = 哈希映射::从([
            ("甲".转字符串(), "first".转字符串()),
            ("乙".转字符串(), "second".转字符串()),
        ]);
        让 源码 = "struct 容器 { 字段: 映射<甲, 乙> }";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, "struct 容器 { 字段: 映射<first, second> }");
    }
    /// 项目上下文夹具：模块 `平台Linux`，声明名 `新建`（weix-1 场景）
    函数 项目夹具() -> 项目上下文 {
        项目上下文 {
            模块集: 哈希集合::从(["平台Linux".转字符串()]),
            名字集: 哈希集合::从(["新建".转字符串()]),
            条目集: 哈希集合::从(["新建".转字符串()]),
        }
    }

    #[测试]
    函数 项目上下文跨文件调用保留() {
        // 跨文件调用（#8）：`新建` 在本文件的转译单元无声明，由项目上下文
        // 豁免（否则被替换成「新建」的映射目标 → E0599，与声明侧函数声明不一致）
        让 变换 = 哈希映射::从([
            ("新建".转字符串(), "new".转字符串()),
            ("平台Linux".转字符串(), "platform_linux".转字符串()),
        ]);
        让 上下文 = 项目夹具();
        让 源码 = "let e = crate::平台Linux::Linux内存源::新建();";
        让 输出 = 带上下文替换别名(源码, &变换, 有值(&上下文));
        断言相等!(输出.输出文本, 源码);
        // 无项目上下文（旧行为）时模块名与成员都被替换
        让 输出乙 = 带上下文替换别名(源码, &变换, 无);
        断言相等!(
            输出乙.输出文本,
            "let e = crate::platform_linux::Linux内存源::new();"
        );
    }

    #[测试]
    函数 项目上下文模块根链() {
        // 模块名为根的路径链（无包根前缀）链内全豁免；
        // 模块名自身的裸使用处同样豁免（模块词不落入别名替换）
        让 变换 = 哈希映射::从([
            ("新建".转字符串(), "new".转字符串()),
            ("平台Linux".转字符串(), "platform_linux".转字符串()),
        ]);
        让 上下文 = 项目夹具();
        让 源码 = "let a = 平台Linux::Linux内存源::新建();\nlet b = 平台Linux;";
        让 输出 = 带上下文替换别名(源码, &变换, 有值(&上下文));
        断言相等!(输出.输出文本, 源码);
    }

    #[测试]
    函数 项目上下文库路径段仍替换() {
        // 非同模块的库路径段不受项目上下文影响：`盒子::新建` 的 `新建`
        // 是库 API（项目内同名 `fn 新建` 不得误伤）
        让 变换 = 哈希映射::从([
