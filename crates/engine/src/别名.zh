    /// 链内未定义于项目的成员照常替换（教程彩蛋块回归）：
    /// `源码映射项` 是项目声明的结构体，`新建` 不是项目声明的方法名
    ///（项目定义的是「新建」的映射目标）——调用位必须替换成该目标，与声明位一致；
    /// 同时验证方法调用位不查字段名（`编辑表.长度()` → 长度映射目标），
    /// 字段访问位仍豁免（`实例.令牌长度` 保持）
    #[测试]
    函数 项目上下文未声明成员与方法位() {
        让 变换 = 哈希映射::从([
            ("新建".转字符串(), "new".转字符串()),
            ("源码映射项".转字符串(), "SourceMapEntry".转字符串()),
            ("推入".转字符串(), "push".转字符串()),
            ("长度".转字符串(), "len".转字符串()),
        ]);
        // 项目声明：结构体 `源码映射项`（项）+ 字段 `长度`（成员名，非项）；
        // 「新建」的映射目标为方法名（项）；不含 `新建`
        让 上下文 = 项目上下文 {
            模块集: 哈希集合::从(["替换模块路径".转字符串()]),
            名字集: 哈希集合::从([
                "源码映射项".转字符串(),
                "长度".转字符串(),
                "new".转字符串(),
            ]),
            条目集: 哈希集合::从(["源码映射项".转字符串(), "new".转字符串()]),
        };
        让 源码 = "编辑表.推入(源码映射项::新建(当前偏移, 令牌长));\nlet n = 编辑表.长度();\nlet m = 实例.令牌长度;";
        让 输出 = 带上下文替换别名(源码, &变换, 有值(&上下文));
        断言相等!(
            输出.输出文本,
            "编辑表.push(源码映射项::new(当前偏移, 令牌长));\nlet n = 编辑表.len();\nlet m = 实例.令牌长度;"
        );
    }

    #[测试]
    函数 项目上下文指纹确定() {
        // 集合迭代顺序不影响指纹（排序后哈希）：跨进程缓存稳定
        让 甲上下文 = 项目上下文 {
            模块集: 哈希集合::从(["甲".转字符串(), "乙".转字符串()]),
            名字集: 哈希集合::从(["丙".转字符串(), "丁".转字符串()]),
            条目集: 哈希集合::从(["丙".转字符串()]),
        };
        让 乙上下文 = 项目上下文 {
            模块集: 哈希集合::从(["乙".转字符串(), "甲".转字符串()]),
            名字集: 哈希集合::从(["丁".转字符串(), "丙".转字符串()]),
            条目集: 哈希集合::从(["丙".转字符串()]),
        };
        断言相等!(甲上下文.指纹(), 乙上下文.指纹());
        让 丙上下文 = 项目上下文 {
            模块集: 哈希集合::从(["甲".转字符串()]),
            名字集: 哈希集合::从(["丙".转字符串()]),
            条目集: 哈希集合::新建(),
        };
        断言不等!(甲上下文.指纹(), 丙上下文.指纹());
    }

    #[测试]
    函数 从源集合收集项与成员() {
        // 项目扫描：项名与结构体字段都并入声明名，字段不入项名；
        // 源文件为母语原文（内部先跑词法转译再收集声明）
        让 目录 = 标准库::条目路径::路径::新建(编译环境!("CARGO_MANIFEST_DIR"))
            .等待线程("lang-packs/zh");
        让 管理器 = 包::映射管理器::映射管理器::从目录载入(&目录)
            .期望("加载 zh 语言包失败");
        让 上下文 = 项目上下文::从源集合(
            哈希集合::从(["甲".转字符串()]),
            ["公开 函数 新建() {}\n结构体 配置 { pub 超时: u32 }"],
            &管理器,
        );
        断言!(上下文.名字集.包含("新建"));
        断言!(上下文.名字集.包含("超时"));
        断言!(上下文.条目集.包含("新建"));
        断言!(!上下文.条目集.包含("超时"));
        断言!(上下文.模块集.包含("甲"));
        断言!(!上下文.上下文为空());
        断言!(项目上下文::缺省().上下文为空());
    }

    #[测试]
    函数 空映射原样返回() {
        断言相等!(
            替换别名("任意内容", &哈希映射::新建()),
            "任意内容"
        );
    }

    #[测试]
    函数 匹配臂绑定保留() {
        // 匹配臂模式中的绑定名是值绑定：`连接`（撞「连接」映射键）
        // 声明与使用处均豁免
        让 变换 = 哈希映射::从([("连接".转字符串(), "join".转字符串())]);
        让 源码 = "match 甲 { Some(连接) => 连接 + 1, None => 0 }";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, 源码);
    }

    #[测试]
    函数 匹配臂路径段仍替换() {
        // 对照：`::` 路径段与后跟 `(` 的构造路径名不是绑定，照常替换
        让 变换 = 哈希映射::从([
            ("连接".转字符串(), "join".转字符串()),
            ("数据行".转字符串(), "Row".转字符串()),
        ]);
        让 输出 = 替换别名("match 甲 { 错误::连接 => 0, 数据行(乙) => 1 }", &变换);
        断言相等!(输出, "match 甲 { 错误::join => 0, Row(乙) => 1 }");
    }

    #[测试]
    函数 匹配臂结构体模式绑定() {
        // 结构体模式：路径名（后跟 `{`）照常替换；字段绑定（`x: 值`
        // 的 `值`）与缩写绑定（`y`）收为值绑定，使用处豁免
        让 变换 = 哈希映射::从([
            ("点".转字符串(), "Point".转字符串()),
            ("值".转字符串(), "values".转字符串()),
        ]);
        让 源码 = "match 甲 { 点 { x: 值, y: 乙 } => 值 + 乙 }";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, "match 甲 { Point { x: 值, y: 乙 } => 值 + 乙 }");
    }

    #[测试]
    函数 匹配臂字段名仍替换() {
        // 字段名（后跟 `:`）不是绑定：库字段名照常替换
        让 变换 = 哈希映射::从([("值".转字符串(), "values".转字符串())]);
        让 输出 = 替换别名("match 甲 { 点 { 值: 乙 } => 乙 }", &变换);
        断言相等!(输出, "match 甲 { 点 { values: 乙 } => 乙 }");
    }

    #[测试]
    函数 匹配臂守卫绑定保留() {
        // 守卫表达式中的名字同为值使用，一并收集
        让 变换 = 哈希映射::从([("连接".转字符串(), "join".转字符串())]);
        让 源码 = "match 甲 { Some(连接) if 连接 > 0 => 连接, _ => 0 }";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, 源码);
    }

    #[测试]
    函数 匹配臂块体不泄漏到下一臂() {
        // 缺陷回归（weix-1 #27）：带块臂体（`=> { … }`）的下一臂回溯
        // 曾越过块闭合 `}`，`;` 深度失衡后不再终止 → 穿透上一臂语句，
        // 把类型标注等裸标识符误收为值绑定（全文件豁免替换）：
        // `无符号机器整数`（标准库别名）因此不被翻译（E0425）
        让 变换 = 哈希映射::从([("无符号机器整数".转字符串(), "usize".转字符串())]);
        让 源码 = "match 乙 { Ok(报告值) => { let 库总数: 无符号机器整数 = 报告值; 库总数 } Err(_) => 0 }";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(
            输出,
            "match 乙 { Ok(报告值) => { let 库总数: usize = 报告值; 库总数 } Err(_) => 0 }"
        );
    }

    #[测试]
    函数 匹配臂块体绑定仍保留() {
        // 修复不误伤：带块臂体的模式绑定仍被收集（体块 `}` 即模式左界），
        // 绑定名与使用处照常豁免
        让 变换 = 哈希映射::从([("连接".转字符串(), "join".转字符串())]);
        让 源码 = "match 甲 { Ok(连接) => { let n = 连接; n } Err(_) => 0 }";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, 源码);
    }

    #[测试]
    函数 让解构绑定保留() {
        // 让解构括号内的名字是绑定：声明与使用处豁免
        让 变换 = 哈希映射::从([("连接".转字符串(), "join".转字符串())]);
        让 源码 = "let (连接, 乙) = 对; let s = 连接;";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, 源码);
    }

    #[测试]
    函数 如果让绑定保留() {
        // 如果让与让链同形覆盖：`有值(连接)` 内为绑定
        让 变换 = 哈希映射::从([("连接".转字符串(), "join".转字符串())]);
        让 源码 = "if let Some(连接) = 甲 { let y = 连接; }";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, 源码);
    }

    #[测试]
    函数 循环模式绑定保留() {
        // 循环模式（解构/引用形式）内的名字是绑定；使用处豁免
        让 变换 = 哈希映射::从([
            ("值".转字符串(), "values".转字符串()),
            ("长度".转字符串(), "len".转字符串()),
        ]);
        让 源码 = "for (键, 值) in 映射 { let z = 值; }\nfor &长度 in 长度们 {}";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, 源码);
    }

    #[测试]
    函数 循环绑定只到在() {
        // 循环关键字与迭代源之间的名字是绑定；迭代源之后的迭代对象照常替换
        让 变换 = 哈希映射::从([
            ("项".转字符串(), "item".转字符串()),
            ("迭代".转字符串(), "iter".转字符串()),
        ]);
        让 输出 = 替换别名("for 项 in 容器.迭代() { let z = 项; }", &变换);
        断言相等!(输出, "for 项 in 容器.iter() { let z = 项; }");
    }

    #[测试]
    函数 实现循环目标不当绑定() {
        // 特征实现头中的「对于 类型」是实现语法：目标类型名照常替换，
        // 不被当作循环模式绑定收集
        让 变换 = 哈希映射::从([("渲染器".转字符串(), "Renderer".转字符串())]);
        让 输出 = 替换别名("impl 显示 for 渲染器 {}", &变换);
        断言相等!(输出, "impl 显示 for Renderer {}");
    }

    #[测试]
    函数 模式关键字无绑定时仍替换() {
        // 对照：无模式绑定时，同词在值使用位照常替换
        让 变换 = 哈希映射::从([("连接".转字符串(), "join".转字符串())]);
        让 输出 = 替换别名("let y = 连接;", &变换);
        断言相等!(输出, "let y = join;");
    }

    #[测试]
    函数 让类型标注含方括号不绑定() {
        // weix-1 #15：让类型标注含 `[`（切片/数组）时，`[` 曾把让态深度
        // 抬回非零、`=` 无法结束让态，类型内别名被误收为值绑定而全文件
        // 豁免替换（E0425）。修复后顶层的 `:` 立即结束让态，类型内别名照常替换。
        让 变换 = 哈希映射::从([("单元数据".转字符串(), "Data".转字符串())]);
        让 源码 = "let 行列表: 向量<&[单元数据]> = 区域.全部行(); let z = 单元数据;";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(
            输出,
            "let 行列表: 向量<&[Data]> = 区域.全部行(); let z = Data;"
        );
    }

    #[测试]
    函数 让结构体模式字段冒号仍绑定() {
        // 修复不误伤：结构体模式 `点 { x: 甲 }` 的 `:` 位于括号深度内（字段名
        // 分隔），不能结束让态——字段值 `甲` 仍是绑定，须全文件豁免。
        让 变换 = 哈希映射::从([("数据".转字符串(), "data".转字符串())]);
        让 源码 = "let 点 { x: 数据, y: 乙 } = 甲; let z = 数据;";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(输出, 源码);
    }

    /// 项目上下文的字段名（不参与项集合）在路径根位不得豁免（office-zb
    /// #27 字段场景）：字段名「天数」撞词表词（「天数」词条）时，`天数::新建` 须
    /// 替换成「天数」的映射目标——此前因字段并入项目名字集而全豁免，产物
    /// `天数::new` 报 E0433
    #[测试]
    函数 项目字段在路径根位不豁免() {
        让 变换 = 哈希映射::从([
            ("天数".转字符串(), "Days".转字符串()),
            ("新建".转字符串(), "new".转字符串()),
        ]);
        让 上下文 = 项目上下文 {
            模块集: 哈希集合::新建(),
            名字集: 哈希集合::从(["天数".转字符串()]),
            条目集: 哈希集合::新建(),
        };
        让 输出 = 带上下文替换别名("let d = 天数::新建(1);", &变换, 有值(&上下文));
        断言相等!(输出.输出文本, "let d = Days::new(1);");
        // 裸使用处的字段名照旧豁免（值语义与字面量场景）
        让 输出乙 = 带上下文替换别名("let x = 天数 + 1;", &变换, 有值(&上下文));
        断言相等!(输出乙.输出文本, "let x = 天数 + 1;");
    }

    /// 单文件字段场景（无项目上下文）：同文件声明的字段名撞词表词时，
    /// 路径根位同样不豁免；字面量与字段访问位仍豁免
    #[测试]
    函数 本地字段在路径根位不豁免() {
        让 变换 = 哈希映射::从([
            ("天数".转字符串(), "Days".转字符串()),
            ("新建".转字符串(), "new".转字符串()),
        ]);
        让 源码 = "struct 账本 { 天数: i32 }\nlet d = 天数::新建(1);\nlet x = 账本 { 天数: 1 };";
        让 输出 = 替换别名(源码, &变换);
        断言相等!(
            输出,
            "struct 账本 { 天数: i32 }\nlet d = Days::new(1);\nlet x = 账本 { 天数: 1 };"
        );
    }

    /// 模块路径回退：导入语句之外的限定路径前缀（office-zb #10）——
    /// 「异步运行时」在模块路径表（异步运行时包），表达式位置根段回退替换；
    /// 段位「睡眠」由别名表替换
    #[测试]
    函数 表达式模块路径前缀替换() {
        让 别名表 = 哈希映射::从([("睡眠".转字符串(), "sleep".转字符串())]);
        让 模块表 = 哈希映射::从([("异步运行时".转字符串(), "tokio".转字符串())]);
        让 输出 = 带上下文与模块路径替换别名(
            "let r = 异步运行时::睡眠(1);",
            &别名表,
            &模块表,
            无,
        );
        断言相等!(输出.输出文本, "let r = tokio::sleep(1);");
    }

    /// 属性宏路径位置的模块词同样回退转译（office-zb #18）
    #[测试]
    函数 属性模块路径前缀替换() {
        让 别名表 = 哈希映射::从([("主函数".转字符串(), "main".转字符串())]);
        让 模块表 = 哈希映射::从([("异步运行时".转字符串(), "tokio".转字符串())]);
        让 输出 = 带上下文与模块路径替换别名(
            "#[异步运行时::主函数]\nfn f() {}",
            &别名表,
            &模块表,
            无,
        );
        断言相等!(输出.输出文本, "#[tokio::main]\nfn f() {}");
    }

    /// 模块路径回退的包名连字符规范化（`tauri-plugin-autostart` → 下划线）
    #[测试]
    函数 模块路径前缀连字符规范化() {
        让 别名表 = 哈希映射::从([("初始化".转字符串(), "init".转字符串())]);
        让 模块表 =
            哈希映射::从([("自启插件".转字符串(), "tauri-plugin-autostart".转字符串())]);
        让 输出 = 带上下文与模块路径替换别名(
            "自启插件::初始化();",
            &别名表,
            &模块表,
            无,
        );
        断言相等!(输出.输出文本, "tauri_plugin_autostart::init();");
    }

    /// 别名表命中优先于模块路径回退（「路径」为路径类型而非路径模块）
    #[测试]
    函数 模块路径回退别名优先() {
        让 别名表 = 哈希映射::从([
            ("路径".转字符串(), "Path".转字符串()),
            ("新建".转字符串(), "new".转字符串()),
        ]);
        让 模块表 = 哈希映射::从([("路径".转字符串(), "path".转字符串())]);
        让 输出 = 带上下文与模块路径替换别名(
            "let p = 路径::新建();",
            &别名表,
            &模块表,
            无,
        );
        断言相等!(输出.输出文本, "let p = Path::new();");
    }

    /// 回退仅限路径根位：裸使用与 `::` 后段（中段）不查模块路径表
    #[测试]
    函数 模块路径回退仅路径根位() {
        让 别名表 = 哈希映射::新建();
        让 模块表 = 哈希映射::从([("时间".转字符串(), "time".转字符串())]);
        让 输出 =
            带上下文与模块路径替换别名("let t = 时间;", &别名表, &模块表, 无);
        断言相等!(输出.输出文本, "let t = 时间;");
        让 输出乙 = 带上下文与模块路径替换别名(
            "let x = 我的类型::时间();",
            &别名表,
            &模块表,
            无,
        );
        断言相等!(输出乙.输出文本, "let x = 我的类型::时间();");
    }

    /// 本文件声明的类型名与模块词撞名：路径根位按本地项豁免（本地语义优先）
    #[测试]
    函数 本地项遮蔽模块路径回退() {
        让 别名表 = 哈希映射::从([("新建".转字符串(), "new".转字符串())]);
        让 模块表 = 哈希映射::从([("时间".转字符串(), "time".转字符串())]);
        让 输出 = 带上下文与模块路径替换别名(
            "struct 时间 {}\nlet t = 时间::新建();",
            &别名表,
            &模块表,
            无,
        );
        断言相等!(输出.输出文本, "struct 时间 {}\nlet t = 时间::new();");
    }

    /// 名字级事实缓存按名字直映：槽位冲突时两个名字各得其事实
    ///
    /// 槽内保存名字全文并逐字节比较；若误按槽位取用，同槽的未映射名字会拿到
    /// 前一个已映射名字的译文。
    #[测试]
    函数 别名事实缓存撞槽保留双名() {
        让 别名表 = 哈希映射::从([("甲".转字符串(), "one".转字符串())]);
        让 目标槽 = 包::名字缓存::名字槽位("甲");
        让 撞名 = (0..5000)
            .变换(|序号| 格式化!("甲{序号}"))
            .查找(|名字值| 包::名字缓存::名字槽位(名字值) == 目标槽)
            .期望("应能找到同槽位的另一个名字");
        让 原因 = 格式化!("let y = 甲 + {撞名};\n");
        让 输出 = 替换别名(&原因, &别名表);
        断言相等!(输出, 格式化!("let y = one + {撞名};\n"));
    }

    /// 项目上下文的名字级缓存：路径根事实在重复名字上一致生效
    ///
    /// 同一个名字既作路径链根又出现在裸使用位，两处的豁免依据不同
    ///（根位看 `路径根`，裸位看项目声明名），缓存不能把两件事混成一件。
    #[测试]
    函数 项目路径根事实跨位复用() {
        让 别名表 = 哈希映射::从([
            ("平台Linux".转字符串(), "platform".转字符串()),
            ("新建".转字符串(), "new".转字符串()),
        ]);
        让 可变 条目集 = 哈希集合::新建();
        条目集.置入("平台Linux".转字符串());
        让 项目 = 项目上下文 {
            模块集: 哈希集合::新建(),
            名字集: 条目集.克隆值(),
            条目集,
        };
        让 输出 = 带上下文替换别名(
            "let a = 平台Linux::新建();\nlet b = 平台Linux();",
            &别名表,
            有值(&项目),
        );
        // 根位按项目路径根豁免、裸位按项目声明名豁免，两处都不替换；
        // 链内段「新建」未定义于项目，照常按库 API 替换
        断言相等!(
            输出.输出文本,
            "let a = 平台Linux::new();\nlet b = 平台Linux();"
        );
    }
}





