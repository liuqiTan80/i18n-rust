//! rustc 编译器诊断的 JSON 数据结构（对应其按 JSON 格式输出的诊断记录）。

使用 序列化属性::可反序列化;

/// rustc 编译器诊断信息（对应一行 JSON 输出）
#[派生(可反序列化, 调试, 克隆)]
公开 结构体 编译器诊断 {
    #[序列化属性(重命名 = "message")]
    公开 诊断消息: 字符串,
    #[序列化属性(重命名 = "code")]
    公开 诊断码: 选项<诊断代码>,
    #[序列化属性(重命名 = "level")]
    公开 级别: 字符串,
    #[序列化属性(重命名 = "spans")]
    公开 跨度集: 向量<诊断跨度>,
    #[序列化属性(重命名 = "children")]
    公开 子诊断: 向量<编译器诊断>,
    #[序列化属性(重命名 = "rendered")]
    公开 已渲染: 选项<字符串>,
}

/// 诊断错误码（如 E0308）
#[派生(可反序列化, 调试, 克隆)]
公开 结构体 诊断代码 {
    #[序列化属性(重命名 = "code")]
    公开 码值: 字符串,
    #[序列化属性(重命名 = "explanation")]
    公开 释义: 选项<字符串>,
}

/// 诊断跨度（代码位置信息）
#[派生(可反序列化, 调试, 克隆)]
公开 结构体 诊断跨度 {
    #[序列化属性(重命名 = "file_name")]
    公开 文件名称: 字符串,
    #[序列化属性(重命名 = "line_start")]
    公开 起始行号: 无符号整数,
    #[序列化属性(重命名 = "column_start")]
    公开 起始列号: 无符号整数,
    #[序列化属性(重命名 = "line_end")]
    公开 结束行号: 无符号整数,
    #[序列化属性(重命名 = "column_end")]
    公开 结束列号: 无符号整数,
    #[序列化属性(重命名 = "text")]
    公开 源码文本: 选项<JSON序列化::JSON值>,
    #[序列化属性(重命名 = "byte_start")]
    公开 起始字节: 选项<无符号长整数>,
    #[序列化属性(重命名 = "byte_end")]
    公开 结束字节: 选项<无符号长整数>,
    #[序列化属性(重命名 = "is_primary")]
    公开 是否主因: 布尔,
    #[序列化属性(重命名 = "label")]
    公开 标签文本: 选项<字符串>,
    #[序列化属性(重命名 = "suggested_replacement")]
    公开 建议替换: 选项<字符串>,
}

/// 从序列化的 JSON 值中提取源码文本
公开(超级) 函数 取源码文本(文本值: &选项<JSON序列化::JSON值>) -> 选项<字符串> {
    文本值.作为引用方法().而后映射(|包装| {
        包装
            .作为数组()
            .而后映射(|数组| 数组.第一个())
            .而后映射(|对象| 对象.获取("text"))
            .而后映射(|片段| 片段.作为字符串())
            .映射(|取值| 取值.转字符串())
    })
}
