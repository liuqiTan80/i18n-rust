    /// 通配导入加项目项名命中：可能经通配引入作用域，不加前缀；
    /// 无通配时项目项名不影响前缀（模块引用照旧补全）
    #[测试]
    函数 通配导入与项目项名命中() {
        让 模块名集 = 哈希集合::从(["项目配置".转字符串()]);
        让 项目项名集 = 哈希集合::从(["项目配置".转字符串()]);
        让 样本文本 = "use super::*;\nfn f() { 项目配置::default() }";
        断言相等!(
            带映射限定模块路径(样本文本, &模块名集, &项目项名集).输出文本,
            样本文本
        );
        断言相等!(
            带映射限定模块路径("fn f() { 项目配置::load() }", &模块名集, &项目项名集)
                .输出文本,
            "fn f() { crate::项目配置::load() }"
        );
    }

    /// 模块声明名不豁免：虚拟项目会抹除文件式声明，前缀仍须补全
    #[测试]
    函数 模块声明名不豁免() {
        让 模块名集 = 哈希集合::从(["工具".转字符串()]);
        断言相等!(
            带映射限定模块路径(
                "mod 工具;\nfn f() { 工具::加一() }",
                &模块名集,
                &哈希集合::新建()
            )
            .输出文本,
            "mod 工具;\nfn f() { crate::工具::加一() }"
        );
    }

    /// 通配来源段不是绑定名：`use crate::工具::*;` 不遮蔽 `工具`
    /// （通配场景由项目项名另行判定；此处项名集合为空，照旧加前缀）
    #[测试]
    函数 通配来源段不是绑定名() {
        让 模块名集 = 哈希集合::从(["工具".转字符串()]);
        断言相等!(
            带映射限定模块路径(
                "use crate::工具::*;\nfn f() { 工具::加一() }",
                &模块名集,
                &哈希集合::新建()
            )
            .输出文本,
            "use crate::工具::*;\nfn f() { crate::工具::加一() }"
        );
    }

    // ===== 抹除文件式模块声明测试 =====

    /// 文件式模块声明被整体抹除为空格，且行号不变
    #[测试]
    函数 文件式模块声明整体抹除() {
        让 样本文本 = "mod 日志设置;\nfn main() {}";
        让 抹除文本 = 剥离文件模块声明(样本文本);
        断言相等!(抹除文本, "         \nfn main() {}");
        断言相等!(抹除文本.逐行().计数(), 样本文本.逐行().计数());
    }

    /// 公开可见性修饰随声明一并抹除
    #[测试]
    函数 公开可见性修饰随声明抹除() {
        让 样本文本 = "pub mod 工具;\nfn f() {}";
        让 抹除文本 = 剥离文件模块声明(样本文本);
        断言相等!(抹除文本, "           \nfn f() {}");
    }

    /// 可见性括号形式 `pub(crate)` 随声明一并抹除
    #[测试]
    函数 可见性括号形式随声明抹除() {
        让 样本文本 = "pub(crate) mod 工具;\nfn f() {}";
        让 抹除文本 = 剥离文件模块声明(样本文本);
        断言相等!(抹除文本, "                  \nfn f() {}");
    }

    /// 属性与文档注释随声明一并抹除（避免悬空修饰）
    #[测试]
    函数 属性与文档注释随声明抹除() {
        // `#[cfg(test)]`（12 字符）与 `mod 测试;`（7 字符）分别变为等宽空格
        让 样本文本 = "#[cfg(test)]\nmod 测试;\nfn f() {}";
        让 抹除文本 = 剥离文件模块声明(样本文本);
        断言相等!(
            抹除文本,
            格式化!("{}\n{}\nfn f() {{}}", " ".重复(12), " ".重复(7))
        );

        // `/// 工具模块`（8 字符）与 `mod 工具;`（7 字符）分别变为等宽空格
        让 样本文本 = "/// 工具模块\nmod 工具;";
        让 抹除文本 = 剥离文件模块声明(样本文本);
        断言相等!(抹除文本, 格式化!("{}\n{}", " ".重复(8), " ".重复(7)));
    }

    /// 多行属性随声明一并抹除，且每行 UTF-16 列宽严格不变
    #[测试]
    函数 多行属性随声明抹除且列宽不变() {
        让 样本文本 = "#[cfg(\n    all(test, unix)\n)]\nmod 工具;\nfn f() {}";
        让 抹除文本 = 剥离文件模块声明(样本文本);
        让 原行集: 向量<&文本> = 样本文本.逐行().收集();
        让 产物行集: 向量<&文本> = 抹除文本.逐行().收集();
        断言相等!(原行集.元素数(), 产物行集.元素数());
        对于 (前项, 后项) 在 原行集.迭代().拉链(&产物行集) {
            断言相等!(前项.编码UTF16().计数(), 后项.编码UTF16().计数());
        }
        断言!(抹除文本.以结尾("fn f() {}"));
    }

    /// 内联模块（含其内容）不被处理
    #[测试]
    函数 内联模块保持原样() {
        让 样本文本 = "mod 工具 {\n    fn f() {}\n}\nfn main() {}";
        断言相等!(剥离文件模块声明(样本文本), 样本文本);
    }

    /// 内联模块内的文件式声明同样被抹除
    #[测试]
    函数 内联模块内文件式声明被抹除() {
        让 样本文本 = "mod 外层 {\n    mod 内层;\n}";
        让 抹除文本 = 剥离文件模块声明(样本文本);
        断言相等!(抹除文本, "mod 外层 {\n           \n}");
    }

    /// 属性属于上一个项时不随声明抹除
    #[测试]
    函数 属性属于上一项时保留() {
        让 样本文本 = "#[cfg(test)]\nfn f() {}\nmod 工具;";
        让 抹除文本 = 剥离文件模块声明(样本文本);
        断言相等!(抹除文本, "#[cfg(test)]\nfn f() {}\n       ");
    }

    /// 含模块关键字子串的标识符不被误判
    #[测试]
    函数 模块关键字子串不被误判() {
        让 样本文本 = "fn commode() {}\nfn mode() {}";
        断言相等!(剥离文件模块声明(样本文本), 样本文本);
    }

    /// 无文件式声明时原样返回
    #[测试]
    函数 无声明时原样返回() {
        让 样本文本 = "fn main() {}\nfn f() { let mode = 1; }";
        断言相等!(剥离文件模块声明(样本文本), 样本文本);
    }

    /// 非母语文件式模块声明补充路径注解；英文名与内联模块不受影响
    #[测试]
    函数 非母语模块注解() {
        让 样本文本 = "#[path = \"数学.rs\"]\nmod 数学;";
        断言相等!(注解非母语模块(样本文本), 样本文本);
        断言相等!(注解非母语模块("mod ascii;"), "mod ascii;");
        断言相等!(注解非母语模块("mod 工具 {}"), "mod 工具 {}");
        让 注解文本 = 注解非母语模块("fn main() {\n    mod 数学;\n}");
        断言相等!(
            注解文本,
            "fn main() {\n    #[path = \"数学.rs\"]\n    mod 数学;\n}"
        );
    }

    /// 注解行映射：磁盘行 → 引擎直出行（从 0 起计数），注解行归属其模块声明行，
    /// 多处注解时偏移逐处累积
    #[测试]
    函数 非母语模块注解行映射() {
        让 (注解文本, 行映射) = 注解非母语模块并返回行映射("mod 数学;\nfn main() {}");
        断言相等!(注解文本, "#[path = \"数学.rs\"]\nmod 数学;\nfn main() {}");
        断言相等!(行映射, 向量![0, 0, 1]);

        让 (_, 行映射) = 注解非母语模块并返回行映射("fn main() {}\nfn f() {}");
        断言相等!(行映射, 向量![0, 1]);

        让 双模块文本 = "mod 数学;\nmod 物理;\nfn main() {}";
        让 (注解文本, 行映射) = 注解非母语模块并返回行映射(双模块文本);
        断言相等!(
            注解文本,
            "#[path = \"数学.rs\"]\nmod 数学;\n#[path = \"物理.rs\"]\nmod 物理;\nfn main() {}"
        );
        断言相等!(行映射, 向量![0, 0, 1, 1, 2]);
    }

    /// 首部字节序标记回归：首行恰为模块声明时注解行不得把标记挤到行内
    /// （rustc 仅接受文件第一个字符位置的字节序标记，否则报未知令牌起始错误）
    #[测试]
    函数 首部字节序标记保持() {
        让 (注解文本, 行映射) =
            注解非母语模块并返回行映射("\u{FEFF}mod 数学;\nfn main() {}");
        断言!(
            注解文本.以开头("\u{FEFF}#[path = \"数学.rs\"]\nmod 数学;"),
            "{注解文本}"
        );
        // 字节序标记不占行：行映射与无标记时一致
        断言相等!(行映射, 向量![0, 0, 1]);
        // 无字节序标记时行为不变
        断言相等!(
            注解非母语模块并返回行映射("mod 数学;"),
            (
                "#[path = \"数学.rs\"]\nmod 数学;".转字符串(),
                向量![0, 0]
            )
        );
    }
}
