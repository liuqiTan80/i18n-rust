//! 模块路径替换模块
//! 1. 将源代码中使用语句的中文模块路径段替换为英文路径段
//!    （如 `使用 标准集合::哈希映射` → `使用 std::collections::HashMap`）；
//! 2. 为已知模块路径段添加 `crate::` 前缀（LSP 虚拟项目跨文件引用专用，
//!    原实现在 LSP 侧，迁入引擎统一维护转译规则）；
//! 3. 文件式模块声明的净化（虚拟项目聚合用）与非母语模块名的
//!    `#[path]` 注解（真实项目产物用，CLI 与 LSP 镜像共享同一实现）。
//!
//! 各阶段均以令牌级替换并产出编辑表，供全管线编辑地图组合。
//!
//! 包名规范化：Cargo 包名允许连字符（如 `tracing-subscriber`），但 Rust
//! 代码中引用包必须写下划线形式；使用路径中模块、类型、函数名不含连字符，
//! `-` 只会出现在包名段，故替换时对映射值做连字符到下划线的规范化安全。

使用 包::缓存::源码映射条目;
使用 词法解析器::{令牌种类, 切分令牌};
使用 标准库::集合::{哈希映射, 哈希集合};

/// 单阶段替换结果：输出文本与编辑表
///
/// 编辑表以**本阶段输入文本**的字节偏移记录（输入偏移升序、互不重叠），
/// 替换文字为本阶段输出文本。
#[派生(调试, 克隆)]
公开 结构体 替换结果 {
    /// 替换后的文本
    公开 输出文本: 字符串,
    /// 编辑表
    公开 编辑表: 向量<源码映射条目>,
}

/// 将源代码中的中文模块路径段替换为英文
///
/// # 参数
/// - `源文本`: 待替换的源代码字符串
/// - `路径映射`: 中文路径段 → 英文路径段 的映射表
///
/// # 注意
/// 采用令牌级替换（与别名替换一致）：
/// - 仅替换**完整标识符令牌**，避免破坏组合词
///   （如 `读取全部字符串` 中的 `字符串` 不会被误替换）；
/// - 仅替换**使用语句内**的路径段（含末段与单段路径，如 `使用 文件系统;`），
///   使用语句内不可能出现用户变量，全量替换安全；
/// - 表达式中的 `类型::关联函数`（如 `引用计数::新建`）不替换，
///   留给别名映射处理成 `Rc::new`。
公开 函数 替换模块路径(源文本: &文本, 路径映射: &哈希映射<字符串, 字符串>) -> 字符串 {
    带映射替换模块路径(源文本, 路径映射).输出文本
}

/// 同 [`替换模块路径`]，同时产出编辑表（本阶段输入坐标）
公开 函数 带映射替换模块路径(
    源文本: &文本,
    路径映射: &哈希映射<字符串, 字符串>,
) -> 替换结果 {
    如果 路径映射.是否为空() {
        返回 替换结果 {
            输出文本: 源文本.转字符串(),
            编辑表: 向量::新建(),
        };
    }
    // 使用语句是唯一的替换场合：整份源码里两种词形都不出现时无需分词
    // （直接调用本函数时母语与已转译的使用语句都可能出现）
    如果 !源文本.包含("use") && !源文本.包含("使用") {
        返回 替换结果 {
            输出文本: 源文本.转字符串(),
            编辑表: 向量::新建(),
        };
    }
    // 不收集令牌向量：主循环只顺序消费一次（每个使用行只命中少数段），
    // 收集一份全文件令牌表是纯分配开销
    替换模块路径迭代(源文本, 路径映射, 切分令牌(源文本).变换(|令牌| (令牌.令牌类别, 令牌.元素数)))
}

/// 同 [`带映射替换模块路径`]，但复用调用方已分好的令牌流
///
/// 引擎的延迟项目上下文入口在词法产物上已经分词一次（为了收集声明名
/// 建项目上下文），而本阶段恰好也是在这份文本上跑，可直接借用那份令牌流，
/// 省掉一次全文件分词。两条入口的输出与编辑表逐字相同（同一序列）。
公开(包) 函数 带令牌替换模块路径(
    源文本: &文本,
    路径映射: &哈希映射<字符串, 字符串>,
    令牌切片: &[词法解析器::词法令牌],
) -> 替换结果 {
    如果 路径映射.是否为空() {
        返回 替换结果 {
            输出文本: 源文本.转字符串(),
            编辑表: 向量::新建(),
        };
    }
    // 与现分词入口同一道早退：本阶段与它逐字等价，只是令牌来源不同
    如果 !源文本.包含("use") && !源文本.包含("使用") {
        返回 替换结果 {
            输出文本: 源文本.转字符串(),
            编辑表: 向量::新建(),
        };
    }
    替换模块路径迭代(
        源文本,
        路径映射,
        令牌切片.迭代().变换(|令牌| (令牌.令牌类别, 令牌.元素数)),
    )
}

/// [`带映射替换模块路径`] 的实现：令牌流由调用方决定是现分词
/// （流式）还是复用已有向量
函数 替换模块路径迭代<迭代流>(
    源文本: &文本,
    路径映射: &哈希映射<字符串, 字符串>,
    令牌迭代: 迭代流,
) -> 替换结果
哪里
    迭代流: 迭代器特征<货物类型 = (令牌种类, 无符号机器整数)>,
{
    让 可变 输出文本 = 字符串::带容量(源文本.元素数());
    让 可变 编辑表 = 向量::新建();
    让 可变 当前偏移 = 0;
    // 已刷出的源偏移：未命中的令牌不逐个追加，命中时才把「上次刷出
    // 位置 → 本令牌起点」的原始片段整段拷过去。大文件里令牌数万而命中
    // 只在使用语句行，逐令牌复制是纯开销（2000 行样例本阶段 515.7 → 473.9 微秒）
    让 可变 已复制 = 0usize;
    // 使用语句内的路径段才启用模块路径映射；
    // 表达式中的 `类型::关联函数`（如 `引用计数::新建`）应走别名映射，
    // 不能被模块路径映射误替换成 `rc::新建`
    让 可变 处于使用语句 = 假;

    对于 (本类别, 本长度) 在 令牌迭代 {
        让 文本片段 = &源文本[当前偏移..当前偏移 + 本长度];
        如果 本类别 == 令牌种类::标识符记号 {
            // 使用语句内所有路径段（含末段或单段）都查映射：
            // 使用中不可能出现用户变量，替换安全；
            // 末段若不在路径映射（如 `服务器` 属于标识符别名），
            // 保持原样交给别名替换处理
            如果 处于使用语句 && 让 有值(英文路径) = 路径映射.截取(文本片段) {
                // 包名规范化：映射值中的连字符改为下划线
                //（映射值中的连字符在 Rust 路径里非法）
                让 规范化后 = 规范化包名连字符(英文路径);
                让 替换文字 = 规范化后.作为解引用().取值或(英文路径);
                编辑表.推(源码映射条目::新建(
                    当前偏移,
                    本长度,
                    文本片段,
                    替换文字,
                ));
                输出文本.推入字符串(&源文本[已复制..当前偏移]);
                输出文本.推入字符串(替换文字);
                已复制 = 当前偏移 + 本长度;
            }
            // 检测使用语句起点（管线中 `使用` 已被词法转译为对应关键字；
            // 直接调用本函数时两种写法均支持）
            如果 文本片段 == "use" || 文本片段 == "使用" {
                处于使用语句 = 真;
            }
        } 否则 如果 本类别 == 令牌种类::分号 {
            // 使用语句以分号结束
            处于使用语句 = 假;
        }
        当前偏移 += 本长度;
    }
    输出文本.推入字符串(&源文本[已复制..]);
    替换结果 {
        输出文本,
        编辑表,
    }
}

/// 将使用路径段中的连字符规范化为下划线（包名规则）
///
/// Cargo 包名允许连字符（如 `tracing-subscriber`），但 Rust 路径中包段
/// 必须写下划线形式。使用路径中模块、类型、函数名均不含连字符，`-` 只会
/// 出现在包名段，故直接替换安全；无需替换时返回无（避免无谓分配）。
/// 别名阶段对使用语句之外的模块词回退替换时复用本函数。
公开(包) 函数 规范化包名连字符(段文本: &文本) -> 选项<字符串> {
    段文本.包含('-').然后(|| 段文本.内存替换('-', "_"))
}

/// 可能被加 `crate::` 前缀的路径段：模块名之后（跳过空白）紧跟 `::`
///
/// 供 [`带映射限定模块路径`] 的快速通道使用：这是「该名字会被加
/// 前缀」的**必要条件**（[`路径分隔符在后`] 允许名与 `::` 之间
/// 夹空白或注释）。注释以 `/` 开头，遇到 `/` 时同样视为可能（否则
/// `甲 /*x*/ :: 乙` 会被误判为不可能）；其余后续字节（`(`、`;`、`_` 等）
/// 都足以否定该处出现。
函数 可能成为路径段(内容: &文本, 名字: &文本) -> 布尔 {
    如果 名字.是否为空() {
        返回 假;
    }
    // 名字可能自重叠（长名字里含更短的自我匹配），每次只前进一个字符
    让 步长 = 名字.逐字符().下一个().映射或默认(1, |字符值| 字符值.字符字节数());
    让 可变 起点 = 0usize;
    当让 有值(位置) = 内容[起点..].查找(名字) {
        让 名字后 = 起点 + 位置 + 名字.元素数();
        让 剩余 = 内容[名字后..].裁剪左侧匹配([' ', '\t', '\r', '\n']);
        如果 模式匹配!(剩余.转为字节().第一个(), 有值(b':') | 有值(b'/')) {
            返回 真;
        }
        起点 += 位置 + 步长;
    }
    假
}

/// 为已知模块路径段添加 `crate::` 前缀
///
/// Rust 2018+ 中，子模块内的裸路径 `模块::项` 无法解析到包的根模块，
/// 必须写成 `crate::模块::项` 或先使用。LSP 虚拟项目把每个方言文件聚合为
/// 同一包的兄弟模块，因此为引用其他模块的路径段自动补全前缀，
/// 使 rust-analyzer 能够解析跨文件引用（引用查找与重命名）。
///
/// 已带前缀的路径（`crate::辅助`、`其他::辅助`）不会被重复处理。
///
/// 遮蔽豁免：模块名与文件内名字（类型声明名、使用导入绑定名）重名时，
/// 裸路径首段按 Rust 作用域解析优先命中后者（如 `结构体 项目配置` 与
/// `模块 项目配置` 重名时，`项目配置::缺省()` 指向结构体关联函数），
/// 此时不得加前缀——前缀会把路径钉死为模块路径（E0425）。文件含通配
/// 导入（`use ...::*;`）时，项目项名集合（跨文件汇总）中的名字视为
/// 可能被通配引入作用域，一并豁免；项目项名集合传空集合时仅按文件内
/// 遮蔽判定（无项目上下文的调用方行为不变）。
公开 函数 带映射限定模块路径(
    内容: &文本,
    模块名集: &哈希集合<字符串>,
    项目项名集: &哈希集合<字符串>,
) -> 替换结果 {
    如果 模块名集.是否为空() || 内容.是否为空() {
        返回 替换结果 {
            输出文本: 内容.转字符串(),
            编辑表: 向量::新建(),
        };
    }
    // 快速通道：本条只给「与模块名逐字节相同的标识符、且后面紧跟 `::`」
    // 加前缀，所以只要每个模块名的每处出现后面都不可能跟 `::`，就一定没有
    // 编辑（无编辑时逐令牌重建的输出恒等于原文）。比「全文包含模块名」更准：
    // 单文件项目的模块名就是文件名干，而 `主函数` 会被词法阶段译成
    // 入口函数名（`fn main()`）——只看子串会永远命中，等于没有早退。
    如果 !模块名集
        .迭代()
        .任意(|名字| 可能成为路径段(内容, 名字))
    {
        返回 替换结果 {
            输出文本: 内容.转字符串(),
            编辑表: 向量::新建(),
        };
    }
    // 令牌序列与字节区间：预扫描（遮蔽名收集）与主循环共用
    让 可变 令牌区间: 向量<(令牌种类, 无符号机器整数, 无符号机器整数)> = 向量::新建();
    让 可变 累计偏移 = 0usize;
    对于 令牌 在 切分令牌(内容) {
        让 起点 = 累计偏移;
        累计偏移 += 令牌.元素数;
        令牌区间.推((令牌.令牌类别, 起点, 累计偏移));
    }
    让 (遮蔽名集, 存在通配导入) = 收集遮蔽名(内容, &令牌区间);

    让 可变 输出文本 = 字符串::带容量(内容.元素数() + 模块名集.元素数() * 8);
    让 可变 编辑表 = 向量::新建();

    对于 (序号, &(判别类别, 起点, 终点)) 在 令牌区间.迭代().枚举() {
        让 文本片段 = &内容[起点..终点];

        如果 为空白(判别类别) {
            输出文本.推入字符串(文本片段);
            继续;
        }

        // 模块路径段：标识符属于已知模块名、后跟 `::`、且不在既有路径段之后
        // （`crate::辅助`、`a::辅助` 中的 `辅助` 已处于路径内，跳过）；
        // 文件内遮蔽名与通配下命中的项目项名不加前缀（保持本地语义）
        让 需加前缀 = 为标识符(判别类别) && {
            让 原始名 = 文本片段.去前缀("r#").取值或(文本片段);
            模块名集.包含(原始名)
                && 路径分隔符在后(&令牌区间, 序号)
                && !路径分隔符在前(&令牌区间, 序号)
                && !遮蔽名集.包含(原始名)
                && !(存在通配导入 && 项目项名集.包含(原始名))
        };
        如果 需加前缀 {
            让 加前缀后 = 格式化!("crate::{}", 文本片段);
            编辑表.推(源码映射条目::新建(起点, 文本片段.元素数(), 文本片段, &加前缀后));
            输出文本.推入字符串(&加前缀后);
        } 否则 {
            输出文本.推入字符串(文本片段);
        }
    }
    替换结果 {
        输出文本,
        编辑表,
    }
}

/// 收集文件内遮蔽名与通配导入标记（`crate::` 前缀豁免判定用）
///
/// 遮蔽名 = 可能让裸路径首段优先解析为本地项的名字：
/// - 类型声明名：结构体、枚举、特征、类型、联合关键字后的名字
///   （类型命名空间，路径首段解析的优先候选）；
/// - 使用导入绑定名：使用语句中每条路径链的末段，别名子句取其别名
///   （容器段与中间段不引入作用域，不收集）。
///
/// 不收集模块声明名：LSP 虚拟项目会以 1:1 空格替换抹除文件式模块
/// 声明（[`剥离文件模块声明`]），声明消失后裸模块名仍须依赖
/// `crate::` 前缀解析，收集会令前缀缺失（回归 E0433 误报）。
///
/// 返回值第二项标记文件是否存在通配导入（`use ...::*;`）：通配引入
/// 的名字不可枚举，调用方回退查项目级项名集合做豁免。
函数 收集遮蔽名<'甲>(
    内容: &'甲 文本,
    令牌区间: &[(令牌种类, 无符号机器整数, 无符号机器整数)],
) -> (哈希集合<&'甲 文本>, 布尔) {
    让 可变 名字集: 哈希集合<&'甲 文本> = 哈希集合::新建();
    让 可变 存在通配导入 = 假;
    对于 (序号, &(判别类别, 起点, 终点)) 在 令牌区间.迭代().枚举() {
        如果 !为标识符(判别类别) {
            继续;
        }
        让 文本片段 = &内容[起点..终点];
        如果 模式匹配!(文本片段, "struct" | "enum" | "trait" | "type" | "union") {
            // 声明名：关键字后第一个非空白令牌为标识符时收集
            让 可变 后续序号 = 序号 + 1;
            当 后续序号 < 令牌区间.元素数() && 为空白(令牌区间[后续序号].0) {
                后续序号 += 1;
            }
            如果 后续序号 < 令牌区间.元素数() && 为标识符(令牌区间[后续序号].0) {
                让 (_, 起始, 截止) = 令牌区间[后续序号];
                名字集.置入(&内容[起始..截止]);
            }
        } 否则 如果 文本片段 == "use" {
            收集使用绑定(内容, 令牌区间, 序号, &可变 名字集, &可变 存在通配导入);
        }
    }
    (名字集, 存在通配导入)
}

/// 扫描一条使用语句：收集绑定名（路径链末段或别名），标记通配
///
/// 使用关键字后的令牌流以分号结束（使用语句内不出现分号）；花括号容器段
/// （`path::{...}` 的容器路径末段）不引入作用域，遇 `{` 不提交末段；
/// 通配来源段（`路径::*` 的路径末段）同样不是绑定名。
函数 收集使用绑定<'甲>(
    内容: &'甲 文本,
    令牌区间: &[(令牌种类, 无符号机器整数, 无符号机器整数)],
    使用序号: 无符号机器整数,
    名字集: &可变 哈希集合<&'甲 文本>,
    存在通配导入: &可变 布尔,
) {
    让 可变 末段: 选项<&'甲 文本> = 无;
    让 可变 期待别名 = 假;
    对于 &(判别类别, 起点, 终点) 在 &令牌区间[(使用序号 + 1)..] {
        如果 判别类别 == 令牌种类::分号 {
            中断;
        }
        让 文本片段 = &内容[起点..终点];
        如果 判别类别 == 令牌种类::星号记号 {
            *存在通配导入 = 真;
            末段 = 无;
        } 否则 如果 模式匹配!(判别类别, 令牌种类::标识符记号 | 令牌种类::原始标识符) {
            让 名字 = 文本片段.去前缀("r#").取值或(文本片段);
            如果 名字 == "as" {
                期待别名 = 真;
            } 否则 如果 !模式匹配!(名字, "use" | "pub" | "crate" | "self" | "super") {
                如果 期待别名 {
                    名字集.置入(名字);
                    期待别名 = 假;
                    末段 = 无;
                } 否则 {
                    末段 = 有值(名字);
                }
            }
        } 否则 如果 模式匹配!(判别类别, 令牌种类::逗号 | 令牌种类::闭大括号) {
            // 链结束（`a::b,` / `a::b}`）：末段为导入绑定名
            如果让 有值(段名) = 末段.取() {
                名字集.置入(段名);
            }
        } 否则 如果 判别类别 == 令牌种类::开大括号 {
            // 进入成员列表（`path::{...}`）：容器段不是绑定名
            末段 = 无;
        }
    }
    如果让 有值(段名) = 末段 {
        名字集.置入(段名);
    }
}

/// 抹除文件式模块声明（`mod 名字;`），供 LSP 虚拟项目内容净化使用
///
/// LSP 虚拟项目将每个方言文件以哈希名托管，并在聚合 `main.rs` 中以
/// `#[path]` 声明为兄弟模块；用户原文中的文件式 `模块 名字;`（转译后为
/// `mod 名字;`）指向的模块文件在虚拟项目中不存在，会被 Cargo 检查报
/// E0583（找不到模块文件）与 E0754（非母语标识符名）。因此发送给
/// rust-analyzer 与写入磁盘前须抹除这类声明。
///
/// 抹除范围连带声明紧邻的修饰：属性（`#[cfg(...)]`、`#[path = ...]`）、
/// 文档注释与可见性（公开、`pub(crate)`）——修饰必须附着于某个项，
/// 声明被抹除后会变成悬空修饰触发新错误；修饰与声明之间允许空白与注释。
///
/// 抹除采用 1:1 字符替换（换行符保留、其余字符替换为等数 UTF-16 单位的
/// 空格），行号与列号同原文严格一致，列映射无需调整；内联模块
/// （`mod 名字 { ... }`）照常参与编译，不被处理。
公开 函数 剥离文件模块声明(内容: &文本) -> 字符串 {
    // 快速通道：判定一个令牌是否文件式声明，要求其文本恰为模块关键字，
    // 因此全文连子串都不含时不可能有声明。LSP 每次按键都会调用
    // 本函数，省掉整趟词法与令牌区间表的分配（绝大多数文件没有模块声明）。
    如果 !内容.包含("mod") {
        返回 内容.转字符串();
    }

    // 收集令牌的字节区间：词法器令牌流连续覆盖整个输入
    让 可变 令牌区间: 向量<(令牌种类, 无符号机器整数, 无符号机器整数)> = 向量::新建();
    让 可变 累计偏移 = 0usize;
    对于 令牌 在 切分令牌(内容) {
        让 起点 = 累计偏移;
        累计偏移 += 令牌.元素数;
        令牌区间.推((令牌.令牌类别, 起点, 累计偏移));
    }

    // 定位所有文件式模块声明：模块关键字 + 名字（隔空白或注释）+ 分号
    让 可变 待抹范围: 向量<(无符号机器整数, 无符号机器整数)> = 向量::新建();
    让 可变 序号 = 0usize;
    当 序号 < 令牌区间.元素数() {
        让 (判别类别, 起点, 终点) = 令牌区间[序号];
        如果 为标识符(判别类别)
            && &内容[起点..终点] == "mod"
            && 让 有值(分号序号) = 文件模块分号(&令牌区间, 序号)
        {
            // 回溯扩展起点：连带声明前的属性、文档注释、可见性修饰
            让 起始 = 文件模块声明起点(&令牌区间, 内容, 序号);
            待抹范围.推((令牌区间[起始].1, 令牌区间[分号序号].2));
            序号 = 分号序号 + 1;
            继续;
        }
        序号 += 1;
    }
    如果 待抹范围.是否为空() {
        返回 内容.转字符串();
    }

    // 1:1 字符替换：换行保留（行号不变），其余字符按等数 UTF-16 单位
    // 替换为空格（列号不变）
    让 可变 输出文本 = 字符串::带容量(内容.元素数());
    让 可变 已复制 = 0usize;
    对于 (起点, 终点) 在 待抹范围 {
        输出文本.推入字符串(&内容[已复制..起点]);
        对于 字符值 在 内容[起点..终点].逐字符() {
            如果 字符值 == '\n' || 字符值 == '\r' {
                输出文本.推(字符值);
            } 否则 {
                对于 _ 在 0..字符值.长度UTF16() {
                    输出文本.推(' ');
                }
            }
        }
        已复制 = 终点;
    }
    输出文本.推入字符串(&内容[已复制..]);
    输出文本
}

/// 检查模块关键字令牌是否为文件式声明，是则返回其结束分号的令牌索引
///
/// 文件式：模块关键字后（允许空白或注释）为单个标识符，再后（允许空白或注释）
/// 为分号；内联模块（`mod X { ... }`）返回无。
函数 文件模块分号(
    令牌区间: &[(令牌种类, 无符号机器整数, 无符号机器整数)],
    模块序号: 无符号机器整数,
) -> 选项<无符号机器整数> {
    让 可变 名字已见 = 假;
    对于 (序号, &(判别类别, _, _)) 在 令牌区间.迭代().枚举().跳过(模块序号 + 1) {
        如果 为空白(判别类别) {
            继续;
        }
        如果 !名字已见 {
            // 模块关键字后必须紧跟名字（含原始标识符）
            如果 !为标识符(判别类别) {
                返回 无;
            }
            名字已见 = 真;
            继续;
        }
        返回 模式匹配!(判别类别, 令牌种类::分号).然后有值(序号);
    }
    无
}

/// 回溯文件式模块声明的起点：连带声明紧邻的注释、属性与可见性修饰
///
/// 从模块关键字令牌向前回溯：跳过空白（注释与声明之间的空行允许跨越）；
/// 遇到紧邻的注释（如文档注释）直接纳入——悬空文档注释会触发
/// E0585（缺少文档注释目标）；遇到属性结尾（`]`）时纳入配对的 `#[`；
/// 遇到可见性括号（`)`）时纳入配对的 `(` 并确认前置公开修饰；遇到裸
/// 公开修饰直接纳入。任何其他令牌（上一项的结尾等）终止回溯。
/// 返回最前的修饰令牌索引；无修饰时返回模块关键字自身索引。
函数 文件模块声明起点(
    令牌区间: &[(令牌种类, 无符号机器整数, 无符号机器整数)],
    内容: &文本,
    模块序号: 无符号机器整数,
) -> 无符号机器整数 {
    让 可变 最早 = 模块序号;
    让 可变 游标 = 模块序号; // 回溯游标：当前已纳入块的第一个令牌索引
    循环 {
        // 向前跳过空白（仅空白；注释本身会被纳入或终止回溯）
        让 可变 前序 = 游标;
        当 前序 > 0 && 令牌区间[前序 - 1].0 == 令牌种类::空白符 {
            前序 -= 1;
        }
        如果 前序 == 0 {
            返回 最早;
        }
        让 (判别类别, 起点, 终点) = 令牌区间[前序 - 1];
        如果 模式匹配!(判别类别, 令牌种类::行评论 | 令牌种类::块评论 { .. }) {
            // 紧邻注释（含文档注释）随声明一并抹除
            最早 = 前序 - 1;
            游标 = 前序 - 1;
        } 否则 如果 判别类别 == 令牌种类::标识符记号 && &内容[起点..终点] == "pub" {
            // 裸可见性修饰
            最早 = 前序 - 1;
            游标 = 前序 - 1;
        } 否则 如果 判别类别 == 令牌种类::闭圆括号 {
            // 可见性括号形式的闭圆括号
            让 有值(开启序号) = 配对开启(
                令牌区间,
                前序 - 1,
                令牌种类::开圆括号,
                令牌种类::闭圆括号,
            ) 否则 {
                返回 最早;
            };
            // 开圆括号前须为非空白公开修饰
            让 可变 定位 = 开启序号;
            当 定位 > 0 && 为空白(令牌区间[定位 - 1].0) {
                定位 -= 1;
            }
            如果 定位 > 0
                && 为标识符(令牌区间[定位 - 1].0)
                && &内容[令牌区间[定位 - 1].1..令牌区间[定位 - 1].2] == "pub"
            {
                最早 = 定位 - 1;
                游标 = 定位 - 1;
            } 否则 {
                返回 最早;
            }
        } 否则 如果 判别类别 == 令牌种类::闭方括号 {
            // 属性结尾
            让 有值(开启序号) = 配对开启(
                令牌区间,
                前序 - 1,
                令牌种类::开方括号,
                令牌种类::闭方括号,
            ) 否则 {
                返回 最早;
            };
            // 开方括号前须为非空白井号码
            让 可变 定位 = 开启序号;
            当 定位 > 0 && 为空白(令牌区间[定位 - 1].0) {
                定位 -= 1;
            }
            如果 定位 > 0 && 令牌区间[定位 - 1].0 == 令牌种类::井号码 {
                最早 = 定位 - 1;
                游标 = 定位 - 1;
            } 否则 {
                返回 最早;
            }
        } 否则 {
            返回 最早;
        }
    }
}

/// 向前查找与闭合序号处闭合令牌配对的开启令牌索引
函数 配对开启(
    令牌区间: &[(令牌种类, 无符号机器整数, 无符号机器整数)],
    闭合序号: 无符号机器整数,
    开启类别: 令牌种类,
    闭合类别: 令牌种类,
) -> 选项<无符号机器整数> {
    让 可变 深度 = 0usize;
    对于 序号 在 (0..=闭合序号).逆序() {
        让 本类别 = 令牌区间[序号].0;
        如果 本类别 == 闭合类别 {
            深度 += 1;
        } 否则 如果 本类别 == 开启类别 {
            深度 -= 1;
            如果 深度 == 0 {
                返回 有值(序号);
            }
        }
    }
    无
}

/// 是否为空白或注释令牌
函数 为空白(判别类别: 令牌种类) -> 布尔 {
    模式匹配!(
        判别类别,
        令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. }
    )
}

/// 是否为标识符令牌（含原始标识符）
函数 为标识符(判别类别: 令牌种类) -> 布尔 {
    模式匹配!(判别类别, 令牌种类::标识符记号 | 令牌种类::原始标识符)
}

/// 检查指定令牌之后两个连续的非空白令牌是否为 `::`
///
/// rustc 将 `::` 拆分为两个冒号令牌。
函数 路径分隔符在后(
    令牌区间: &[(令牌种类, 无符号机器整数, 无符号机器整数)],
    当前序号: 无符号机器整数,
) -> 布尔 {
    让 可变 冒号计数 = 0;
    对于 &(判别类别, _, _) 在 &令牌区间[(当前序号 + 1)..] {
        如果 为空白(判别类别) {
            继续;
        }
        如果 模式匹配!(判别类别, 令牌种类::冒号) {
            冒号计数 += 1;
            如果 冒号计数 >= 2 {
                返回 真;
            }
            继续;
        }
        返回 假;
    }
    假
}

/// 检查指定令牌之前两个连续的非空白令牌是否为 `::`
函数 路径分隔符在前(
    令牌区间: &[(令牌种类, 无符号机器整数, 无符号机器整数)],
    当前序号: 无符号机器整数,
) -> 布尔 {
    让 可变 冒号计数 = 0;
    对于 &(判别类别, _, _) 在 令牌区间[..当前序号].迭代().逆序() {
        如果 为空白(判别类别) {
            继续;
        }
        如果 模式匹配!(判别类别, 令牌种类::冒号) {
            冒号计数 += 1;
            如果 冒号计数 >= 2 {
                返回 真;
            }
        } 否则 {
            返回 假;
        }
    }
    假
}

/// 为非母语模块名的文件式声明 `mod 名称;` 补充 `#[path = "名称.rs"]` 注解。
///
/// rustc 拒绝加载非母语标识符对应的模块文件（E0754），而方言项目
/// 的模块文件常以母语命名（如 `src/数学.zh` → `src/数学.rs`）；
/// 显式指定路径后 rustc 可正常加载。仅处理以分号结尾的文件式声明，
/// 内联模块块（`mod 名称 { ... }`）与英文名不受影响。
///
/// 适用于包的根文件（`main.rs`/`lib.rs`）：子模块与根文件同处源码目录。
/// 非根文件的多层目录布局请用 [`注解嵌套模块并返回行映射`]，
/// 虚拟托管布局（平铺哈希产物）请用 [`注解模块路径并返回行映射`]。
公开 函数 注解非母语模块(源文本: &文本) -> 字符串 {
    注解非母语模块并返回行映射(源文本).0
}

/// 非根模块文件（多层目录）的 `#[path]` 注解，并返回行映射。
///
/// 自身词干为当前文件自身词干（如 `src/领域.rs` 传 `"领域"`）：
/// 其中 `mod 工具;` 的子文件实际位于 `src/领域/工具.rs`，而 `#[path]`
/// 相对当前文件所在源码目录解析，故注入 `#[path = "领域/工具.rs"]`。
/// 更深层同理（`src/领域/工具.rs` 传 `"工具"` → `#[path = "工具/内部.rs"]`，
/// 相对 `src/领域/`）。仅注解非母语名；英文名遵循 rustc 默认查找。
公开 函数 注解嵌套模块并返回行映射(
    源文本: &文本,
    自身词干: &文本,
) -> (字符串, 向量<无符号机器整数>) {
    注解模块路径并返回行映射(源文本, |名字| {
        (!名字.是否为ASCII()).然后(|| 格式化!("{自身词干}/{名字}.rs"))
    })
}

/// 通用文件式模块声明 `#[path]` 注解器，并返回磁盘行 → 引擎直行映射。
///
/// 解析器给出相对路径时在声明前插入 `#[path = "<相对路径>"]`；
/// 返回无时不注解（如子文件不存在，保留 rustc 原生 E0583）。
/// 仅处理分号结尾的文件式声明与尚无 `#[path]` 的声明；
/// 内联模块块（`mod 名 { ... }`）不受影响。
///
/// 供三类布局复用：根文件（`名.rs`）、多层真实布局（`自词干/名.rs`）、
/// 虚拟托管布局（平铺哈希产物，`<hash>.rs`）。
公开 函数 注解模块路径并返回行映射(
    源文本: &文本,
    解析器: 实现 闭包特征(&文本) -> 选项<字符串>,
) -> (字符串, 向量<无符号机器整数>) {
    注解模块路径实现(源文本, &解析器)
}

/// 同 [`注解非母语模块`]，并额外返回磁盘产物行 → 引擎直出行映射
///
/// 每处注解在模块声明所在行前插入一整行 `#[path = ...]`，其后所有磁盘
/// 行号相对引擎直出产物整体偏移（偏移量 = 该行之前的注解数）。诊断回译时
/// 必须先用本映射把 rustc 报告的磁盘行号换算回引擎直出行号，再走以引擎
/// 直出产物为基准的列映射；否则多模块入口文件（如 `main.zh` 声明 3 个
/// `模块 xxx;`）的诊断行号会系统性偏移 3 行。映射从 0 起计数：
/// `行映射[磁盘行] = 引擎直出行`（注解行归属其所在模块声明行）。
公开 函数 注解非母语模块并返回行映射(源文本: &文本) -> (字符串, 向量<无符号机器整数>) {
    注解模块路径实现(源文本, &|名字| {
        (!名字.是否为ASCII()).然后(|| 格式化!("{名字}.rs"))
    })
}

/// [`注解模块路径并返回行映射`] 的实现体
函数 注解模块路径实现(
    源文本: &文本,
    解析器: &动态 闭包特征(&文本) -> 选项<字符串>,
) -> (字符串, 向量<无符号机器整数>) {
    // 文件首部字节序标记：rustc 仅接受文件第一个字符位置的字节序标记。首行恰好是
    // 模块声明时，注解行插在声明前会把字节序标记挤到行内（
    // `unknown start of token: \u{feff}`，编译失败）。剥离后统一前置，
    // 字节序标记不占行，行映射不受影响。
    让 (字节序标记, 正文) = 如果让 有值(剩余文本) = 源文本.去前缀("\u{FEFF}") {
        ("\u{FEFF}", 剩余文本)
    } 否则 {
        ("", 源文本)
    };
    让 令牌们: 向量<_> = 切分令牌(正文).收集();
    // 逐令牌的字节偏移（词法器令牌流覆盖全源，偏移连续）
    让 可变 偏移们: 向量<无符号机器整数> = 向量::带容量(令牌们.元素数());
    让 可变 累计 = 0usize;
    对于 令牌 在 &令牌们 {
        偏移们.推(累计);
        累计 += 令牌.元素数;
    }
    让 跳过杂项 = |起点序号: 无符号机器整数| {
        让 可变 序号 = 起点序号;
        当 序号 < 令牌们.元素数()
            && 模式匹配!(
                令牌们[序号].令牌类别,
                令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. }
            )
        {
            序号 += 1;
        }
        序号
    };
    让 可变 插入点集: 向量<(无符号机器整数, 字符串)> = 向量::新建();
    对于 (序号, 令牌) 在 令牌们.迭代().枚举() {
        如果 令牌.令牌类别 != 令牌种类::标识符记号 {
            继续;
        }
        让 文本片段 = &正文[偏移们[序号]..偏移们[序号] + 令牌.元素数];
        如果 文本片段 != "mod" {
            继续;
        }
        让 名字序号 = 跳过杂项(序号 + 1);
        让 有值(名字令牌) = 令牌们.截取(名字序号) 否则 {
            继续;
        };
        如果 名字令牌.令牌类别 != 令牌种类::标识符记号 {
            继续;
        }
        让 分号序号 = 跳过杂项(名字序号 + 1);
        // 仅文件式声明（分号结尾）需要注解；内联模块块以开大括号开头
        如果 !模式匹配!(
            令牌们.截取(分号序号).变换(|令牌| 令牌.令牌类别),
            有值(令牌种类::分号)
        ) {
            继续;
        }
        让 名字 = &正文[偏移们[名字序号]..偏移们[名字序号] + 名字令牌.元素数];
        让 有值(模块路径) = 解析器(名字) 否则 {
            继续;
        };
        // 插入点：若有可见性修饰（公开），注解必须在公开修饰之前
        让 可变 插入位置 = 偏移们[序号];
        让 可变 回退序号 = 序号;
        当 回退序号 > 0
            && 模式匹配!(
                令牌们[回退序号 - 1].令牌类别,
                令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. }
            )
        {
            回退序号 -= 1;
        }
        如果 回退序号 > 0
            && 令牌们[回退序号 - 1].令牌类别 == 令牌种类::标识符记号
            && &正文[偏移们[回退序号 - 1]..偏移们[回退序号 - 1] + 令牌们[回退序号 - 1].元素数] == "pub"
        {
            插入位置 = 偏移们[回退序号 - 1];
        }
        // 已有路径注解时不重复添加：注解可独占多行，需向上逐行扫描属性链
        让 行首 = 正文[..插入位置]
            .反向查找('\n')
            .变换(|索引| 索引 + 1)
            .取值或(0);
        让 可变 扫描起点 = 行首;
        让 可变 已有路径属性 = 假;
        循环 {
            让 当前行 = 正文[扫描起点..插入位置].逐行().下一个().取值或("");
            // 首行可能是模块声明所在行的缩进前缀；上移后的行应为属性行
            如果 扫描起点 != 行首 || 当前行.裁剪左侧().以开头("#[") {
                如果 当前行.包含("#[path") {
                    已有路径属性 = 真;
                    中断;
                }
                如果 !当前行.裁剪左侧().以开头("#[") {
                    中断; // 属性链被普通行或空行打断
                }
            }
            如果 扫描起点 == 0 {
                中断;
            }
            让 前行首 = 正文[..扫描起点 - 1]
                .反向查找('\n')
                .变换(|索引| 索引 + 1)
                .取值或(0);
            如果 前行首 == 扫描起点 {
                中断;
            }
            扫描起点 = 前行首;
        }
        如果 已有路径属性 {
            继续;
        }
        让 缩进 = &正文[行首..插入位置];
        插入点集.推((插入位置, 格式化!("#[path = \"{模块路径}\"]\n{缩进}")));
    }
    // 按插入点升序回放：引擎直出文本的换行推进引擎行号；注解插入文本
    // 的换行不推进（插入行仍归属其所在模块声明行）
    让 可变 结果文本 = 字符串::带容量(
        正文.元素数()
            + 插入点集
                .迭代()
                .变换(|(_, 片段)| 片段.元素数())
                .求和::<无符号机器整数>(),
    );
    结果文本.推入字符串(字节序标记);
    让 可变 行映射: 向量<无符号机器整数> = 向量![0];
    让 可变 引擎行 = 0usize;
    让 可变 上次位置 = 0usize;
    对于 (插入位置, 片段) 在 &插入点集 {
        追加并维护行映射(
            &可变 结果文本,
            &可变 行映射,
            &可变 引擎行,
            &正文[上次位置..*插入位置],
            真,
        );
        追加并维护行映射(
            &可变 结果文本,
            &可变 行映射,
            &可变 引擎行,
            片段,
            假,
        );
        上次位置 = *插入位置;
    }
    追加并维护行映射(
        &可变 结果文本,
        &可变 行映射,
        &可变 引擎行,
        &正文[上次位置..],
        真,
    );
    (结果文本, 行映射)
}

/// 追加文本并同步维护行映射：来自引擎为假（注解插入文本）的换行
/// 不推进引擎行号，其余同普通文本
函数 追加并维护行映射(
    输出文本: &可变 字符串,
    行映射: &可变 向量<无符号机器整数>,
    引擎行: &可变 无符号机器整数,
    文本片段: &文本,
    来自引擎: 布尔,
) {
    对于 字符值 在 文本片段.逐字符() {
        输出文本.推(字符值);
        如果 字符值 == '\n' {
            如果 来自引擎 {
                *引擎行 += 1;
            }
            行映射.推(*引擎行);
        }
    }
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    函数 样例路径映射() -> 哈希映射<字符串, 字符串> {
        让 可变 路径表 = 哈希映射::新建();
        路径表.置入("标准集合".转字符串(), "std::collections".转字符串());
        路径表.置入("文件系统".转字符串(), "std::fs".转字符串());
        路径表.置入("字符串".转字符串(), "string".转字符串());
        路径表
    }

    /// 模块路径段后跟 `::` 时被替换
    #[测试]
    函数 模块路径段后跟双冒号时被替换() {
        让 路径表 = 样例路径映射();
        让 译文 = 替换模块路径("使用 标准集合::哈希映射;", &路径表);
        断言相等!(译文, "使用 std::collections::哈希映射;");
    }

    /// 使用语句外的类型关联调用（如 `引用计数::新建`）不被模块映射替换，
    /// 留给别名映射处理成 `Rc::new`
    #[测试]
    函数 使用语句外类型调用不被替换() {
        让 路径表 = 样例路径映射();
        让 译文 = 替换模块路径("标准集合::新建(5);", &路径表);
        断言相等!(译文, "标准集合::新建(5);");
    }

    /// 使用语句末段（后跟分号）也参与路径映射替换
    #[测试]
    函数 使用语句末段被替换() {
        让 路径表 = 样例路径映射();
        让 译文 = 替换模块路径("使用 标准集合::字符串;", &路径表);
        断言相等!(译文, "使用 std::collections::string;");
    }

    /// 使用语句单段路径（无 `::`）直接映射整个模块
    #[测试]
    函数 使用语句单段被替换() {
        让 路径表 = 样例路径映射();
        让 译文 = 替换模块路径("使用 文件系统;", &路径表);
        断言相等!(译文, "使用 std::fs;");
    }

    /// 映射表未覆盖的末段保持原样，交给别名替换处理
    #[测试]
    函数 使用语句未映射末段保持原样() {
        让 路径表 = 样例路径映射();
        让 译文 = 替换模块路径("使用 salvo::服务器;", &路径表);
        断言相等!(译文, "使用 salvo::服务器;");
    }

    /// 复用外部令牌流的入口与现分词入口逐字等价
    ///
    /// 两条路径同一实现，差别只在令牌从哪来（现分词与调用方已分的向量）。
    /// 覆盖：使用段内或段外、跨行使用、注释与空白穿插、无使用语句文件
    /// （字符串早退）、未映射末段、连字符包名、空文件。
    #[测试]
    函数 令牌入口与现分词入口逐字等价() {
        让 路径表 = 哈希映射::从([
            ("标准集合".转字符串(), "std::collections".转字符串()),
            ("文件系统".转字符串(), "std::fs".转字符串()),
            ("字符串".转字符串(), "string".转字符串()),
            ("日志订阅".转字符串(), "tracing-subscriber".转字符串()),
        ]);
        对于 样本文本 在 [
            "使用 标准集合::哈希映射;\n",
            "使用 文件系统;\n",
            "使用 标准集合::字符串 as 映射;\n使用 文件系统::文件;\n",
            "使用 标准集合 :: 字符串;\n",
            "使用 日志订阅 as 日志框架;\n",
            "使用 salvo::服务器;\n",
            "fn main() {\n    let x = 标准集合::新建(5);\n}\n",
            "使用 文件系统::文件;\nfn f() { 文件系统::读('a'); }\n",
            "// 使用 标准集合::哈希映射;\nlet x = 1;\n",
            "fn main() {}\n",
            "",
        ] {
            让 现分词 = 带映射替换模块路径(样本文本, &路径表);
            让 令牌们: 向量<词法解析器::词法令牌> = 切分令牌(样本文本).收集();
            让 复用分词 = 带令牌替换模块路径(样本文本, &路径表, &令牌们);
            断言相等!(现分词.输出文本, 复用分词.输出文本, "{样本文本:?}：译文不一致");
            断言相等!(
                现分词.编辑表.元素数(),
                复用分词.编辑表.元素数(),
                "{样本文本:?}：编辑条数"
            );
            对于 (序号, (前条, 后条)) 在
                现分词.编辑表.迭代().拉链(&复用分词.编辑表).枚举()
            {
                断言相等!(前条.源偏移, 后条.源偏移, "{样本文本:?} 第 {序号} 条偏移");
                断言相等!(前条.源码长度, 后条.源码长度, "{样本文本:?} 第 {序号} 条长度");
                断言相等!(前条.原文, 后条.原文, "{样本文本:?} 第 {序号} 条原文");
                断言相等!(
                    前条.替换文字,
                    后条.替换文字,
                    "{样本文本:?} 第 {序号} 条替换文字"
                );
            }
        }
    }

    /// 包名含连字符时（Cargo 名 ≠ Rust 路径名）：替换值规范化为下划线形式
    #[测试]
    函数 使用连字符包名时规范化为下划线() {
        让 路径表 = 哈希映射::从([("日志订阅".转字符串(), "tracing-subscriber".转字符串())]);
        让 译文 = 带映射替换模块路径("使用 日志订阅 as 日志框架;", &路径表);
        断言相等!(译文.输出文本, "使用 tracing_subscriber as 日志框架;");
        断言相等!(译文.编辑表.元素数(), 1);
        断言相等!(译文.编辑表[0].替换文字, "tracing_subscriber");
    }

    /// 无连字符的路径段不受规范化影响
    #[测试]
    函数 无连字符路径段不受规范化影响() {
        让 路径表 = 样例路径映射();
        让 译文 = 替换模块路径("使用 标准集合::哈希映射;", &路径表);
        断言相等!(译文, "使用 std::collections::哈希映射;");
    }

    /// 使用语句结束后（分号后）恢复默认行为
    #[测试]
    函数 使用语句结束后恢复默认行为() {
        让 路径表 = 样例路径映射();
        让 译文 = 替换模块路径("使用 标准集合::哈希映射; 标准集合::新建(1);", &路径表);
        断言相等!(译文, "使用 std::collections::哈希映射; 标准集合::新建(1);");
    }

    /// 组合词内部的中文不被破坏（令牌级替换）
    #[测试]
    函数 组合词内部中文不被破坏() {
        让 路径表 = 样例路径映射();
        让 译文 = 替换模块路径("读取全部字符串(\"a.txt\")", &路径表);
        断言相等!(译文, "读取全部字符串(\"a.txt\")");
    }

    /// 普通中文变量名（后无 `::`）不被替换
    #[测试]
    函数 普通中文变量名不被替换() {
        让 路径表 = 样例路径映射();
        让 译文 = 替换模块路径("让 字符串 = 1;", &路径表);
        断言相等!(译文, "让 字符串 = 1;");
    }

    /// 空映射表直接返回原文
    #[测试]
    函数 空映射表直接返回原文() {
        让 译文 = 替换模块路径("让 x = 1;", &哈希映射::新建());
        断言相等!(译文, "让 x = 1;");
    }

    /// 编辑表：输入偏移精确指向被替换的路径段
    #[测试]
    函数 编辑表记录输入偏移() {
        让 路径表 = 样例路径映射();
        让 替换产出 = 带映射替换模块路径("使用 标准集合::哈希映射;", &路径表);
        断言相等!(替换产出.输出文本, "使用 std::collections::哈希映射;");
        断言相等!(替换产出.编辑表.元素数(), 1);
        让 条目 = &替换产出.编辑表[0];
        断言相等!(条目.原文, "标准集合");
        断言相等!(条目.替换文字, "std::collections");
        断言相等!(
            &"使用 标准集合::哈希映射;"[条目.源偏移..条目.源偏移 + 条目.源码长度],
            "标准集合"
        );
    }

    // ===== 限定前缀测试（自 LSP 迁入） =====

    #[测试]
    函数 限定添加前缀() {
        让 模块名集 = 哈希集合::从(["辅助".转字符串(), "主".转字符串()]);
        断言相等!(
            带映射限定模块路径("fn main() {\n    辅助::辅助函数();\n}", &模块名集, &哈希集合::新建()).输出文本,
            "fn main() {\n    crate::辅助::辅助函数();\n}"
        );
    }

    #[测试]
    函数 限定不重复添加前缀() {
        让 模块名集 = 哈希集合::从(["辅助".转字符串(), "主".转字符串()]);
        断言相等!(
            带映射限定模块路径("crate::辅助::辅助函数()", &模块名集, &哈希集合::新建()).输出文本,
            "crate::辅助::辅助函数()"
        );
        // 其他路径段内的模块名（`a::辅助`）不重复处理
        断言相等!(
            带映射限定模块路径("a::辅助::辅助函数()", &模块名集, &哈希集合::新建()).输出文本,
            "a::辅助::辅助函数()"
        );
    }

    #[测试]
    函数 限定非模块路径不动() {
        让 模块名集 = 哈希集合::从(["辅助".转字符串(), "主".转字符串()]);
        断言相等!(
            带映射限定模块路径("x::方法()", &模块名集, &哈希集合::新建()).输出文本,
            "x::方法()"
        );
    }

    #[测试]
    函数 限定空集合保持原文() {
        断言相等!(
            带映射限定模块路径("辅助::辅助函数()", &哈希集合::新建(), &哈希集合::新建()).输出文本,
            "辅助::辅助函数()"
        );
