    #[测试]
    函数 限定记录编辑表() {
        让 模块名集 = 哈希集合::从(["辅助".转字符串()]);
        让 替换产出 =
            带映射限定模块路径("fn f() { 辅助::x() }", &模块名集, &哈希集合::新建());
        断言相等!(替换产出.输出文本, "fn f() { crate::辅助::x() }");
        断言相等!(替换产出.编辑表.元素数(), 1);
        让 条目 = &替换产出.编辑表[0];
        断言相等!(条目.原文, "辅助");
        断言相等!(条目.替换文字, "crate::辅助");
    }

    /// 同文件类型声明名与模块名重名：裸路径按本地类型解析，不加前缀
    /// （`struct 项目配置` 与 `模块 项目配置` 重名的 E0425 回归）
    #[测试]
    函数 类型声明名遮蔽模块名() {
        让 模块名集 = 哈希集合::从(["项目配置".转字符串()]);
        让 样本文本 = "struct 项目配置 {}\nfn f() { 项目配置::default() }";
        断言相等!(
            带映射限定模块路径(样本文本, &模块名集, &哈希集合::新建()).输出文本,
            样本文本
        );
