    /// 使用导入的类型名与模块名重名：裸路径解析为导入类型，不加前缀
    #[测试]
    函数 使用导入遮蔽模块名() {
        让 模块名集 = 哈希集合::从(["项目配置".转字符串()]);
        让 样本文本 = "use crate::项目配置::项目配置;\nfn f() { 项目配置::default() }";
        断言相等!(
            带映射限定模块路径(样本文本, &模块名集, &哈希集合::新建()).输出文本,
            样本文本
        );
