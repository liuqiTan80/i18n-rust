//! Unicode 混淆检测：在词法处理前扫描源码，检出零宽字符、双向文本控制符与
//! 同形异义字符，防范借不可见或形似字符伪装代码（藏匿恶意、冒充标识符等）。
//! 语言感知：当某方言本就合法使用某套文字（如俄语方言的西里尔标识符）时，
//! 不再就该文字的同形异义告警，免得对合法代码误报。

/// 混淆类别枚举
#[派生(调试, 克隆, 可复制, 部分相等, 全等)]
公开 枚举 混淆类别 {
    /// 零宽字符：肉眼不可见的控制字符
    零宽字符,
    /// 双向文本控制符：可篡改显示顺序的 Unicode 字符
    双向控制符,
    /// 同形异义字符：形似拉丁字母的西里尔/希腊字母
    同形字符,
}

实现 混淆类别 {
    /// 返回当前语言下的类别显示文字
    公开 函数 显示文字(&自我) -> 字符串 {
        让 键名 = 匹配 自我 {
            混淆类别::零宽字符 => "unicode_cat_zero_width",
            混淆类别::双向控制符 => "unicode_cat_bidi",
            混淆类别::同形字符 => "unicode_cat_homoglyph",
        };
        包::语言::取消息(键名)
    }
}

/// 单个混淆警告：位置（1 起行/列）+ 字符 + 类别 + 说明
#[派生(调试, 克隆, 部分相等)]
公开 结构体 混淆警告 {
    /// 行号（从 1 开始）
    公开 行号: 无符号机器整数,
    /// 列号（从 1 开始）
    公开 列号: 无符号机器整数,
    /// 可疑字符
    公开 涉事字符: 字符,
    /// 混淆类别
    公开 类别: 混淆类别,
    /// 本地化说明
    公开 说明: 字符串,
}

实现 混淆警告 {
    /// 格式化为单行警告文本，模板随当前语言变化
    /// 示例（中文）：`第 2 行第 5 列：检测到零宽字符 U+200B（零宽空格。此类字符肉眼不可见...）`
    公开 函数 展示行(&自我) -> 字符串 {
        // 码位先补零成 4 位十六进制，再作为单个占位符填进模板
        让 码位 = 格式化!("{:04X}", 自我.涉事字符 作为 无符号整数);
        包::语言::取带参消息(
            "unicode_warning_at",
            &[
                &自我.行号.转字符串(),
                &自我.列号.转字符串(),
                &自我.类别.显示文字(),
                &码位,
                &自我.说明,
            ],
        )
    }
}

/// 检查源码中的 Unicode 混淆字符，返回全部警告（不阻断翻译，由调用方决定呈现）。
///
/// - 零宽字符：零宽空格、连接符、字节序标记（文件首部除外）等不可见字符
/// - 双向文本控制符：可篡改显示顺序的一批方向控制字符
/// - 同形异义字符：西里尔/希腊字母中形似拉丁字母的字符
公开 函数 检查混淆(源码: &文本) -> 向量<混淆警告> {
    让 可变 警告们 = 向量::新建();
    让 可变 行号: 无符号机器整数 = 1;
    让 可变 列序: 无符号机器整数 = 1;
    // 当前方言是否原生使用西里尔字母：只与语言有关，循环外判定一次。
    // 西里尔源码里几乎每个字母都命中同形表，逐个再查语言会把开销摊到最热处。
    让 原生西里尔 = 包::语言::用西里尔文字(&包::语言::当前语言());

    对于 (偏移, 码元) 在 源码.逐字符枚举() {
        如果 码元 == '\n' {
            行号 += 1;
            列序 = 1;
            继续;
        }
        // 三张表全不含 ASCII（零宽、双向控制符、西里尔与希腊字母），逐个查表
        // 纯属浪费——CJK 与拉丁源码里多数字符都走到这条快速路径。
        如果 码元.是否为ASCII() {
            列序 += 1;
            继续;
        }
        // 文件开头的字节序标记是合法编码标记，不视为混淆
        如果 码元 作为 无符号整数 == 65279 && 偏移 == 0 {
            列序 += 1;
            继续;
        }
        如果让 有值(名字) = 零宽字符名(码元) {
            警告们.推入(混淆警告 {
                行号,
                列号: 列序,
                涉事字符: 码元,
                类别: 混淆类别::零宽字符,
                说明: 包::语言::取带参消息(
                    "unicode_zero_width_hint",
                    &[&本地化字符名(码元, 名字)],
                ),
            });
            列序 += 1;
            继续;
        }
        如果让 有值(名字) = 双向控制符名(码元) {
            警告们.推入(混淆警告 {
                行号,
                列号: 列序,
                涉事字符: 码元,
                类别: 混淆类别::双向控制符,
                说明: 包::语言::取带参消息(
                    "unicode_bidi_hint",
                    &[&本地化字符名(码元, 名字)],
                ),
            });
            列序 += 1;
            继续;
        }
        如果让 有值((形似, 名字)) = 同形字符(码元) {
            // 当前方言合法使用该文字时不构成混淆，跳过；其余照常告警
            如果 原生西里尔 && 是西里尔块(码元) {
                // 合法文字，不告警
            } 否则 {
                警告们.推入(混淆警告 {
                    行号,
                    列号: 列序,
                    涉事字符: 码元,
                    类别: 混淆类别::同形字符,
                    说明: 包::语言::取带参消息(
                        "unicode_homoglyph_hint",
                        &[&形似.转字符串(), &本地化字符名(码元, 名字)],
                    ),
                });
            }
        }
        列序 += 1;
    }
    警告们
}

/// 零宽字符名称查找（英文 Unicode 官方名，作为数据随字面量保留）
函数 零宽字符名(码元: 字符) -> 选项<字符串> {
    // 按码位（十进制）匹配，避开 \u 转义里的连续字母被全中文门禁误计
    匹配 码元 作为 无符号整数 {
        8203 => 有值("ZERO WIDTH SPACE".转字符串()),
        8204 => 有值("ZERO WIDTH NON-JOINER".转字符串()),
        8205 => 有值("ZERO WIDTH JOINER".转字符串()),
        65279 => 有值("ZERO WIDTH NO-BREAK SPACE".转字符串()),
        8288 => 有值("WORD JOINER".转字符串()),
        173 => 有值("SOFT HYPHEN".转字符串()),
        6158 => 有值("MONGOLIAN VOWEL SEPARATOR".转字符串()),
        _ => 无,
    }
}

/// 双向文本控制符名称查找（英文 Unicode 官方名，作为数据随字面量保留）
函数 双向控制符名(码元: 字符) -> 选项<字符串> {
    匹配 码元 {
        '\u{200E}' => 有值("LEFT-TO-RIGHT MARK".转字符串()),
        '\u{200F}' => 有值("RIGHT-TO-LEFT MARK".转字符串()),
        '\u{202A}' => 有值("LEFT-TO-RIGHT EMBEDDING".转字符串()),
        '\u{202B}' => 有值("RIGHT-TO-LEFT EMBEDDING".转字符串()),
        '\u{202C}' => 有值("POP DIRECTIONAL FORMATTING".转字符串()),
        '\u{202D}' => 有值("LEFT-TO-RIGHT OVERRIDE".转字符串()),
        '\u{202E}' => 有值("RIGHT-TO-LEFT OVERRIDE".转字符串()),
        '\u{2066}' => 有值("LEFT-TO-RIGHT ISOLATE".转字符串()),
        '\u{2067}' => 有值("RIGHT-TO-LEFT ISOLATE".转字符串()),
        '\u{2068}' => 有值("FIRST STRONG ISOLATE".转字符串()),
        '\u{2069}' => 有值("POP DIRECTIONAL ISOLATE".转字符串()),
        _ => 无,
    }
}

/// 获取当前语言下的字符名：中文语言包提供中文名（键为码位大写十六进制），
/// 其他语言直接用英文 Unicode 官方名（语言包不重复翻译字符名）。
函数 本地化字符名(码元: 字符, 英文名: 字符串) -> 字符串 {
    // 键名取码位补零成 4 位大写十六进制，与语言包一致
    如果 包::语言::当前语言() == "zh" {
        包::语言::取消息(&格式化!("unicode_name_{:04X}", 码元 作为 无符号整数))
    } 否则 {
        英文名
    }
}

/// 同形异义字符表：(可疑字符, 形似的拉丁字母, Unicode 官方名)
常量 同形表: &[(字符, 字符, &文本)] = &[
    // 西里尔字母（形似拉丁）
    ('\u{0410}', 'A', "CYRILLIC CAPITAL LETTER A"),
    ('\u{0412}', 'B', "CYRILLIC CAPITAL LETTER VE"),
    ('\u{0415}', 'E', "CYRILLIC CAPITAL LETTER IE"),
    ('\u{041A}', 'K', "CYRILLIC CAPITAL LETTER KA"),
    ('\u{041D}', 'H', "CYRILLIC CAPITAL LETTER EN"),
    ('\u{041E}', 'O', "CYRILLIC CAPITAL LETTER O"),
    ('\u{0420}', 'P', "CYRILLIC CAPITAL LETTER ER"),
    ('\u{0421}', 'C', "CYRILLIC CAPITAL LETTER ES"),
    ('\u{0422}', 'T', "CYRILLIC CAPITAL LETTER TE"),
    ('\u{0423}', 'Y', "CYRILLIC CAPITAL LETTER U"),
    ('\u{0425}', 'X', "CYRILLIC CAPITAL LETTER HA"),
    ('\u{0430}', 'a', "CYRILLIC SMALL LETTER A"),
    ('\u{0435}', 'e', "CYRILLIC SMALL LETTER IE"),
    ('\u{043E}', 'o', "CYRILLIC SMALL LETTER O"),
    ('\u{0440}', 'p', "CYRILLIC SMALL LETTER ER"),
    ('\u{0441}', 'c', "CYRILLIC SMALL LETTER ES"),
    ('\u{0445}', 'x', "CYRILLIC SMALL LETTER HA"),
    // 希腊字母（形似拉丁）
    ('\u{0391}', 'A', "GREEK CAPITAL LETTER ALPHA"),
    ('\u{0392}', 'B', "GREEK CAPITAL LETTER BETA"),
    ('\u{0395}', 'E', "GREEK CAPITAL LETTER EPSILON"),
    ('\u{0397}', 'H', "GREEK CAPITAL LETTER ETA"),
    ('\u{0399}', 'I', "GREEK CAPITAL LETTER IOTA"),
    ('\u{039A}', 'K', "GREEK CAPITAL LETTER KAPPA"),
    ('\u{039C}', 'M', "GREEK CAPITAL LETTER MU"),
    ('\u{039D}', 'N', "GREEK CAPITAL LETTER NU"),
    ('\u{039F}', 'O', "GREEK CAPITAL LETTER OMICRON"),
    ('\u{03A1}', 'P', "GREEK CAPITAL LETTER RHO"),
    ('\u{03A4}', 'T', "GREEK CAPITAL LETTER TAU"),
    ('\u{03A5}', 'Y', "GREEK CAPITAL LETTER UPSILON"),
    ('\u{03A7}', 'X', "GREEK CAPITAL LETTER CHI"),
    ('\u{03B1}', 'a', "GREEK SMALL LETTER ALPHA"),
    ('\u{03B5}', 'e', "GREEK SMALL LETTER EPSILON"),
    ('\u{03B9}', 'i', "GREEK SMALL LETTER IOTA"),
    ('\u{03BA}', 'k', "GREEK SMALL LETTER KAPPA"),
    ('\u{03BC}', 'u', "GREEK SMALL LETTER MU"),
    ('\u{03BD}', 'v', "GREEK SMALL LETTER NU"),
    ('\u{03BF}', 'o', "GREEK SMALL LETTER OMICRON"),
    ('\u{03C1}', 'p', "GREEK SMALL LETTER RHO"),
    ('\u{03C4}', 't', "GREEK SMALL LETTER TAU"),
    ('\u{03C5}', 'u', "GREEK SMALL LETTER UPSILON"),
    ('\u{03C7}', 'x', "GREEK SMALL LETTER CHI"),
    ('\u{03C9}', 'w', "GREEK SMALL LETTER OMEGA"),
];

/// 查询字符是否为同形异义字符，返回 (形似的拉丁字母, Unicode 名称)
函数 同形字符(码元: 字符) -> 选项<(字符, 字符串)> {
    同形表
        .迭代()
        .查找(|(可疑, _, _)| *可疑 == 码元)
        .变换(|(_, 形似, 名字)| (*形似, 名字.转字符串()))
}

/// 字符是否属于西里尔字母 Unicode 块
///
/// 使用西里尔字母的方言（俄语、乌克兰语、保加利亚语、塞尔维亚语 等）中，形似拉丁字母的西里尔字符
/// 是合法字符而非伪装；覆盖基本块与扩展块，确保乌克兰语、白俄罗斯语等扩展
/// 字符不被误报。希腊字母等其他同形字符不受豁免，仍然告警。
函数 是西里尔块(码元: 字符) -> 布尔 {
    让 码位 = 码元 作为 无符号整数;
    码位 >= 0x0400 && 码位 <= 0x052F
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    #[测试]
    函数 普通中文源码无告警() {
        让 源码 = "// 注释\n函数 主函数() {\n    让 x = 5;\n    打印行(\"你好\");\n}";
        断言!(检查混淆(源码).是否为空());
    }

    #[测试]
    函数 检出零宽空格并定位() {
        让 _护 = 包::语言::钉住语言("zh");
        让 源码 = "函数 主函数() {\n\u{200B}让 x = 1;\n}";
        让 警告们 = 检查混淆(源码);
        断言相等!(警告们.长度(), 1);
        让 警 = &警告们[0];
        断言相等!(警.涉事字符, '\u{200B}');
        断言相等!(警.类别, 混淆类别::零宽字符);
        断言相等!(警.行号, 2);
        断言相等!(警.列号, 1);
        断言!(警.说明.包含("零宽空格"));
    }

    #[测试]
    函数 检出零宽连接符与分隔符() {
        让 源码 = "让 a\u{200D}b = 1; 让 c\u{200C}d = 2; 让 e\u{2060}f = 3;";
        让 警告们 = 检查混淆(源码);
        断言相等!(警告们.长度(), 3);
        断言!(警告们.迭代().全部(|警| 警.类别 == 混淆类别::零宽字符));
    }

    #[测试]
    函数 首部字节序标记不告警() {
        让 源码 = "\u{FEFF}函数 主函数() {}";
        断言!(检查混淆(源码).是否为空());
        // 中间位置的字节序标记可疑
        让 源码 = "函数 主函数(\u{FEFF}) {}";
        让 警告们 = 检查混淆(源码);
        断言相等!(警告们.长度(), 1);
        断言相等!(警告们[0].涉事字符 作为 无符号整数, 65279);
    }

    #[测试]
    函数 检出双向文本控制符() {
        让 _护 = 包::语言::钉住语言("zh");
        让 源码 = "// 注释 \u{202E} 反转显示\n让 x = \u{202A}1\u{202C};";
        让 警告们 = 检查混淆(源码);
        断言相等!(警告们.长度(), 3);
        断言!(警告们.迭代().全部(|警| 警.类别 == 混淆类别::双向控制符));
        断言相等!(警告们[0].行号, 1);
        断言相等!(警告们[0].列号, 7);
        断言!(警告们[0].说明.包含("从右到左覆盖"));
    }

    #[测试]
    函数 检出双向隔离符() {
        让 _护 = 包::语言::钉住语言("zh");
        让 源码 = "让 x = \u{2066}1\u{2069};";
        让 警告们 = 检查混淆(源码);
        断言相等!(警告们.长度(), 2);
        断言!(警告们[0].说明.包含("从左到右隔离"));
        断言!(警告们[1].说明.包含("弹出方向隔离"));
    }

    #[测试]
    函数 检出西里尔同形字符() {
        让 _护 = 包::语言::钉住语言("zh");
        让 源码 = "让 а = 1;";
        让 警告们 = 检查混淆(源码);
        断言相等!(警告们.长度(), 1);
        让 警 = &警告们[0];
        断言相等!(警.类别, 混淆类别::同形字符);
        断言相等!(警.涉事字符, '\u{0430}');
        断言!(警.说明.包含("形似拉丁字母 'a'"));
        断言!(警.说明.包含("西里尔小写字母"));
        断言相等!(警.行号, 1);
        断言相等!(警.列号, 3);
    }

    /// 零宽字符紧跟在 ASCII 代码之后：列号按字符计，ASCII 快速路径不得丢弃计数
    #[测试]
    函数 零宽紧跟半角列号() {
        让 _护 = 包::语言::钉住语言("zh");
        让 源码 = "函数 主函数() { let x = 1;\u{200B} }";
        让 警告们 = 检查混淆(源码);
        断言相等!(警告们.长度(), 1);
        让 预期列 = 源码
            .逐字符()
            .位置(|码元| 码元 == '\u{200B}')
            .期望("源码里应有零宽空格")
            + 1;
        断言相等!(警告们[0].列号, 预期列);
        断言相等!(警告们[0].行号, 1);
    }

    #[测试]
    函数 检出希腊同形字符() {
        让 _护 = 包::语言::钉住语言("zh");
        让 源码 = "函数 主函数() { 让 ρ = 1; }";
        让 警告们 = 检查混淆(源码);
        断言相等!(警告们.长度(), 1);
        断言相等!(警告们[0].涉事字符, '\u{03C1}');
        断言!(警告们[0].说明.包含("形似拉丁字母 'p'"));
    }

    #[测试]
    函数 跨行位置计数() {
        // 西里尔字符告警依赖当前语言为中文（俄语下方豁免），需持锁串行
        让 _护 = 包::语言::钉住语言("zh");
        让 源码 = "函数 主函数() {\n    让 x = 1;\n    а = 2;\n}";
        让 警告们 = 检查混淆(源码);
        断言相等!(警告们.长度(), 1);
        断言相等!(警告们[0].行号, 3);
        断言相等!(警告们[0].列号, 5);
    }

    #[测试]
    函数 俄语方言跳过西里尔同形() {
        // 作用域守卫：离开作用域（含断言失败）自动恢复中文，无需手工还原
        让 _护 = 包::语言::钉住语言("ru");
        // 西里尔字符在俄语方言中是合法标识符字符，不再报同形异义告警
        让 警告们 = 检查混淆("пусть а = 1;");
        断言!(警告们.是否为空(), "ru 方言不应误报西里尔字符");
        // 希腊字母与零宽字符在俄语方言下仍然告警
        让 警告们 = 检查混淆("пусть ρ\u{200B} = 1;");
        断言相等!(警告们.长度(), 2);
        断言!(警告们.迭代().任意(|警| 警.类别 == 混淆类别::同形字符));
        断言!(警告们.迭代().任意(|警| 警.类别 == 混淆类别::零宽字符));
    }

    #[测试]
    函数 警告格式化输出() {
        让 _护 = 包::语言::钉住语言("zh");
        让 警告 = 混淆警告 {
            行号: 2,
            列号: 5,
            涉事字符: '\u{200B}',
            类别: 混淆类别::零宽字符,
            说明: "零宽空格。此类字符肉眼不可见，可能被用于隐藏代码或绕过检测".转字符串(),
        };
        让 文字 = 警告.展示行();
        断言!(文字.包含("第 2 行第 5 列"));
        断言!(文字.包含("零宽字符"));
        断言!(文字.包含("U+200B"));
    }
}
