//! 转译产物磁盘布局：非入口方言文件的 `.rs` 产物写入项目内托管目录
//! `.rz/gen/`，镜像源码目录树（`src/数学.zh` → `.rz/gen/src/数学.rs`）。
//!
//! 动机：源码目录是学习者唯一会去看的目录，旧布局把每个方言文件的英文产物
//! 平铺在源文件旁边（`src/数学.zh` + `src/数学.rs`），母语教学目录里一半
//! 内容是生成物。托管后源码目录只剩母语源文件与 Cargo 固定入口产物
//! `src/main.rs`（入口必须留在 Cargo 默认发现位置，无法移出）。
//!
//! 关键不变量：**托管目录镜像源码布局**，所以非入口产物之间的相对位置与
//! 旧布局完全一致，`mod 工具;` 的 `#[path]` 前缀不变；只有入口产物
//! （仍在源码根目录）指向子模块时需要 `../.rz/gen/src/…` 前缀——由
//! [`注解产物模块路径并返回行映射`] 统一计算，CLI 与 LSP 镜像
//! 共用同一实现，避免两侧规则漂移。

使用 标准库::路径::{路径类型, 路径缓冲};
使用 标准库::外部接口模块::操作系统字符串;

/// 产物托管目录（相对项目根）
公开 常量 托管目录: &文本 = ".rz/gen";

/// 方言源文件 → 非入口产物路径（镜像源码布局，保持项目根相对位置）
///
/// 源文件不在项目根之下（`rzc check ~/示例.zh` 等）时退回旧行为：
/// 产物写在源文件旁边，不硬造 `.rz/gen/` 结构。
公开 函数 产物路径(项目根: &路径类型, 源文件: &路径类型) -> 路径缓冲 {
    如果让 有值(相对路径值) = 相对项目根路径(项目根, 源文件) {
        项目根.连接(托管目录).连接(相对路径值).设扩展名("rs")
    } 否则 {
        源文件.设扩展名("rs")
    }
}

/// 位于托管目录下的产物 → 去掉托管前缀的等价路径（仍为绝对路径）
///
/// `.rz/gen/src/数学.rs` → `<root>/src/数学.rs`；不在托管目录下返回「无」。
/// 供诊断回译使用：rustc 报的是托管产物路径，母语源文件在源码树里。
公开 函数 去托管前缀(项目根: &路径类型, 入口路径: &路径类型) -> 选项<路径缓冲> {
    让 相对路径值 = 相对项目根路径(项目根, 入口路径)?;
    让 内部路径 = 相对路径值.去前缀(托管目录).转选项()?;
    有值(项目根.连接(内部路径))
}

/// 从起始目录到目标路径的词法相对路径（`#[path]` 用 `/` 分隔）
///
/// `#[path]` 由 rustc 相对**声明所在文件的目录**解析，故起始目录参数传目录。
/// 纯词法计算（不访问文件系统、不解析符号链接）：本项目内产物与源码都在
/// 同一根目录下按字面路径生成，无需真实路径。
公开 函数 相对路径(起始目录: &路径类型, 目标路径: &路径类型) -> 字符串 {
    让 起点 = 规整为绝对路径(起始目录);
    让 终点 = 规整为绝对路径(目标路径);
    让 起段: 向量<_> = 起点.组件().收集();
    让 终段: 向量<_> = 终点.组件().收集();
    让 公共段数 = 起段
        .迭代()
        .拉链(终段.迭代())
        .取前(|(甲, 乙)| 甲 == 乙)
        .计数();
    让 可变 拼接串: 向量<字符串> = 向量::新建();
    对于 _ 在 公共段数..起段.元素数() {
        拼接串.推入("..".转字符串());
    }
    对于 段 在 &终段[公共段数..] {
        拼接串.推入(段.作为系统串().转有损字符串().转所有权());
    }
    如果 拼接串.是否为空() {
        ".".转字符串()
    } 否则 {
        拼接串.连接("/")
    }
}

/// 文件式 `mod 名称;` 声明的 `#[path]` 注解（托管布局版），并返回行映射
///
/// 逐模块名解析实际落点，两类命中者才注解（其余保留 rustc 原生 E0583，
/// 与旧布局同口径）：
/// 1. `child_src_dir/名称.<方言>` 存在 → 指向其托管产物（镜像布局）；
/// 2. `child_src_dir/名称.rs` 存在（手写 `.rs` 子模块）→ 指向它本身。
///
/// 注解路径相对产物目录（当前文件**产物**所在目录）计算：入口产物在
/// 源码根目录时得到 `../.rz/gen/src/…`，非入口产物在 `.rz/gen/src/` 时子模块
/// 之间仍是 `领域/工具.rs`，与旧布局逐字一致。
///
/// 扩展名序列为可用方言扩展名（可带点），顺序即优先级。
公开 函数 注解产物模块路径并返回行映射(
    代码: &文本,
    子源码目录: &路径类型,
    产物目录: &路径类型,
    项目根: &路径类型,
    扩展名序列: &[字符串],
) -> (字符串, 向量<无符号机器整数>) {
    包::模块路径::注解模块路径并返回行映射(代码, |名称| {
        对于 后缀 在 扩展名序列 {
            让 源路径 = 子源码目录.连接(格式化!("{}.{}", 名称, 后缀.裁剪左侧匹配('.') ));
            如果 源路径.是否为文件() {
                返回 有值(相对路径(
                    产物目录,
                    &产物路径(项目根, &源路径),
                ));
            }
        }
        让 手写路径 = 子源码目录.连接(格式化!("{}.rs", 名称));
        如果 手写路径.是否为文件() {
            返回 有值(相对路径(产物目录, &手写路径));
        }
        无
    })
}

/// 路径是否落在本项目的托管目录下
///
/// 用于区分写入语义：托管目录内都是机器产物（用户从不编辑），覆盖无需
/// 备份；`src/main.rs` 与项目外源文件旁的产物可能与用户手写文件同名，
/// 必须保留「内容不同先备份」的护栏。
公开 函数 是否为托管产物(项目根: &路径类型, 目标路径: &路径类型) -> 布尔 {
    让 成功(元数据) = 标准库::文件系统::符号链接元数据(目标路径) 否则 {
        // 目标还不存在（首次写入）：按字面路径判定，只看父目录是否在托管树下
        返回 目标路径.以开头(项目根.连接(托管目录));
    };
    // 已存在的真实路径同样要落在本项目根下（符号链接可能指向项目外）
    如果 !元数据.是否为文件() {
        返回 假;
    }
    让 真实路径 = 目标路径.规范路径().解包或用否则(|_| 目标路径.转路径缓冲());
    让 根路径 = 规整为绝对路径(&项目根.连接(托管目录));
    规整为绝对路径(&真实路径).以开头(根路径)
}

/// 清理托管目录中已失去母语源文件的产物，返回被删除的文件路径（已排序）
///
/// 托管目录是本工具的专属地盘（源码目录里的手写 `.rs` 从不复制进来），其中
/// 「找不到对应源文件」的 `.rs` 只有一种来历：源文件被删除或改名后留下的
/// 旧产物。留着并非无害——rustc 按默认规则解析 `mod 工具;` 时会在产物同级
/// 目录里找到它（`.rz/gen/src/领域/工具.rs`），于是被删掉的代码还在参与编译，
/// 报错位置指向一个已经没有源文件的生成物。旧布局下不敢做这种清理
/// （源码目录混着学习者手写 `.rs`，删错就是毁数据），托管后判定是纯本地的：
/// 只看源文件在不在（并顺手清掉旧写入语义留下的 `.rs.bak`），绝不触碰
/// `.rz/gen/` 以外的任何文件；符号链接一律不跟随。
公开 函数 清理失效产物(项目根: &路径类型, 扩展名序列: &[字符串]) -> 向量<路径缓冲> {
    让 托管根 = 项目根.连接(托管目录);
    让 成功(元数据) = 标准库::文件系统::符号链接元数据(&托管根) 否则 {
        返回 向量::新建();
    };
    // 托管根被换成符号链接（异常环境）：不顺着走，避免删到目录外的文件
    如果 !元数据.是否为目录() {
        返回 向量::新建();
    }
    让 可变 失效产物: 向量<路径缓冲> = 向量::新建();
    让 可变 目录集: 向量<路径缓冲> = 向量![托管根.克隆值()];
    让 可变 待走访: 向量<路径缓冲> = 向量![托管根.克隆值()];
    当 让 有值(目录) = 待走访.弹() {
        让 成功(目录项) = 标准库::文件系统::读取目录(&目录) 否则 {
            继续;
        };
        对于 条目 在 目录项.展平() {
            让 条目路径 = 条目.条目路径();
            让 成功(文件类型) = 条目.文件类型() 否则 { 继续 };
            // 符号链接一律不跟随：既不删也不下钻
            如果 文件类型.是否为符号链接() {
                继续;
            }
            如果 文件类型.是否为目录() {
                目录集.推入(条目路径.克隆值());
                待走访.推入(条目路径);
            } 否则 如果 文件类型.是否为文件()
                && 是否为废弃产物(项目根, &条目路径, &托管根, 扩展名序列)
            {
                失效产物.推入(条目路径);
            }
        }
    }
    让 可变 已删除 = 向量::新建();
    对于 条目路径 在 &失效产物 {
        如果 标准库::文件系统::删除文件(条目路径).是否为成功() {
            已删除.推入(条目路径.克隆值());
        }
    }
    // 产物清空后的空目录自底向上移除（托管根本身保留，下次写入省一次创建）：
    // 按键升序后整体反转，等价于按组件数降序（同层目录的先后不影响结果）
    目录集.按键排序(|目录| 目录.组件().计数());
    目录集.反转();
    对于 目录 在 目录集 {
        如果 目录 == 托管根 {
            继续;
        }
        如果 标准库::文件系统::读取目录(&目录).成功且(|可变 读取器| 读取器.下一个().是否为无()) {
            让 _ = 标准库::文件系统::删除目录(&目录);
        }
    }
    已删除.排序();
    已删除
}

/// 托管目录下的文件是否属于可安全删除的机器产物
///
/// 两类：失去源文件的 `.rs` 产物，以及旧写入语义在同一产物变更时留下的
/// `.rs.bak` 备份（内容就是本目录里那个 `.rs` 的上一版本，不含用户数据）。
/// 其余文件（用户自己放进来的东西）一律保留。
函数 是否为废弃产物(
    项目根: &路径类型,
    目标路径: &路径类型,
    托管根: &路径类型,
    扩展名序列: &[字符串],
) -> 布尔 {
    如果 是否为产物备份(目标路径) {
        返回 真;
    }
    是否有产物扩展名(目标路径) && !是否有源文件(项目根, 目标路径, 托管根, 扩展名序列)
}

/// 是否为产物扩展名（`.rs`）的文件
函数 是否有产物扩展名(目标路径: &路径类型) -> 布尔 {
    目标路径.取扩展名().有值且(|扩展名| 扩展名 == "rs")
}

/// 是否为产物备份（`.rs.bak`）
函数 是否为产物备份(目标路径: &路径类型) -> 布尔 {
    目标路径.取文件名()
        .而后映射(|名称| 名称.取字符串引用())
        .有值且(|名称| 名称.以结尾(".rs.bak"))
}

/// 托管产物是否还有对应的母语源文件（源文件在源码树里的镜像位置）
函数 是否有源文件(
    项目根: &路径类型,
    产物路径值: &路径类型,
    托管根: &路径类型,
    扩展名序列: &[字符串],
) -> 布尔 {
    如果让 成功(相对路径值) = 产物路径值.去前缀(托管根) {
        让 源基 = 项目根.连接(相对路径值);
        扩展名序列
            .迭代()
            .任意(|后缀| 源基.设扩展名(后缀.裁剪左侧匹配('.')).是否为文件())
    } 否则 {
        真 // 不在托管根下（理论不可达）：保守视为有源，不删
    }
}

/// 项目根相对路径（源文件/产物可能是相对路径，先按当前目录补齐）
公开 函数 相对项目根路径(项目根: &路径类型, 目标路径: &路径类型) -> 选项<路径缓冲> {
    让 根路径 = 规整为绝对路径(项目根);
    让 绝对路径 = 规整为绝对路径(目标路径);
    绝对路径.去前缀(&根路径).转选项().变换(路径缓冲::从)
}

/// 路径词法规整为绝对形式：相对路径按当前目录补齐，取不到当前目录时
/// 只做词法规整（比较退化为词法相等）
函数 规整为绝对路径(目标路径: &路径类型) -> 路径缓冲 {
    如果 目标路径.是否绝对() {
        返回 规整词法路径(目标路径, 真);
    }
    如果让 成功(当前目录) = 标准库::环境::当前目录() {
        规整词法路径(&当前目录.连接(目标路径), 真)
    } 否则 {
        // 取不到当前目录：按原样做词法规整（首个非 `.`/`..` 段不算根）
        规整词法路径(目标路径, 假)
    }
}

/// 词法规整路径：就地消解 `.`/`..`（不访问文件系统、不解析符号链接）
///
/// rustc 报告 `#[path]` 子模块时把父文件目录与注解值直接拼接、不做规整
/// （`src/main.rs` + `../.rz/gen/src/数学.rs` → `src/../.rz/gen/src/数学.rs`），
/// 诊断回译要认出托管产物就必须先词法化；`..` 在此只作字面段处理，
/// 符号链接场景下会失真，但本项目内产物与源码均按字面路径生成。
///
/// `已有根` 为真表示输入是绝对路径（或由当前目录补齐），首个非 `.`/`..`
/// 段就是根/前缀段，落到输出并阻止后续 `..` 越过根；为假时全部按普通段处理。
函数 规整词法路径(目标路径: &路径类型, 已有根: 布尔) -> 路径缓冲 {
    让 可变 输出 = 路径缓冲::新建();
    让 可变 段栈: 向量<操作系统字符串> = 向量::新建();
    让 可变 根已落位 = !已有根;
    对于 组件 在 目标路径.组件() {
        让 原始段 = 组件.作为系统串();
        让 文案 = 原始段.转有损字符串();
        如果 文案 == "." {
            继续;
        }
        如果 文案 == ".." {
            如果 段栈.最后一个().有值且(|末段| 末段 != "..") {
                段栈.弹();
            } 否则 如果 !输出.存在() {
                段栈.推入(操作系统字符串::从(".."));
            }
            继续;
        }
        如果 !根已落位 {
            // 根/前缀段（首个非普通段）落到输出：后续 `..` 不会越过它
            输出.推入(原始段);
            根已落位 = 真;
        } 否则 {
            段栈.推入(操作系统字符串::从(原始段));
        }
    }
    对于 段 在 段栈 {
        输出.推入(段);
    }
    输出
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    函数 根目录() -> 路径缓冲 {
        路径缓冲::从("/proj")
    }

    #[测试]
    函数 非入口产物镜像源码布局() {
        断言相等!(
            产物路径(&根目录(), 路径类型::新建("/proj/src/数学.zh")),
            路径缓冲::从("/proj/.rz/gen/src/数学.rs")
        );
        断言相等!(
            产物路径(&根目录(), 路径类型::新建("/proj/src/领域/工具.zh")),
            路径缓冲::从("/proj/.rz/gen/src/领域/工具.rs")
        );
    }

    #[测试]
    函数 项目外源文件产物留在原地() {
        断言相等!(
            产物路径(&根目录(), 路径类型::新建("/home/u/示例.zh")),
            路径缓冲::从("/home/u/示例.rs")
        );
    }

    #[测试]
    函数 托管前缀剥离只认托管目录() {
        断言相等!(
            去托管前缀(&根目录(), 路径类型::新建("/proj/.rz/gen/src/数学.rs")),
            有值(路径缓冲::从("/proj/src/数学.rs"))
        );
        断言相等!(
            去托管前缀(&根目录(), 路径类型::新建("/proj/src/数学.rs")),
            无
        );
        // rustc 报的子模块路径不规整（父文件目录 + `#[path]` 值直接拼接），
        // 词法规整后才能认出托管产物（否则回译失效，诊断指向生成物路径）
        断言相等!(
            去托管前缀(&根目录(), 路径类型::新建("/proj/src/../.rz/gen/src/数学.rs")),
            有值(路径缓冲::从("/proj/src/数学.rs"))
        );
        // 别的项目下的同名目录不误剥（前缀必须落在本项目根之下）
        断言相等!(
            去托管前缀(&根目录(), 路径类型::新建("/other/.rz/gen/src/数学.rs")),
            无
        );
    }

    #[测试]
    函数 相对路径计算覆盖出入口两个方向() {
        // 入口（源码根目录）指向托管子模块
        断言相等!(
            相对路径(
                路径类型::新建("/proj/src"),
                路径类型::新建("/proj/.rz/gen/src/数学.rs")
            ),
            "../.rz/gen/src/数学.rs"
        );
        // 托管产物之间：与旧布局逐字一致
        断言相等!(
            相对路径(
                路径类型::新建("/proj/.rz/gen/src"),
                路径类型::新建("/proj/.rz/gen/src/领域/工具.rs")
            ),
            "领域/工具.rs"
        );
        // 托管产物指回手写 .rs（逐层上跳到项目根再进源码目录）
        断言相等!(
            相对路径(
                路径类型::新建("/proj/.rz/gen/src/领域"),
                路径类型::新建("/proj/src/领域/helper.rs")
            ),
            "../../../../src/领域/helper.rs"
        );
        断言相等!(
            相对路径(路径类型::新建("/proj/src"), 路径类型::新建("/proj/src/x.rs")),
            "x.rs"
        );
    }

    /// 端到端：入口产物注解指向托管目录，非 ASCII 与 ASCII 方言子模块都覆盖
    #[测试]
    函数 入口注解指向托管产物并按源文件存在性取舍() {
        让 临时 = 临时文件::建临时目录().取成功值();
        让 根路径 = 临时.条目路径();
        标准库::文件系统::创建所有目录(根路径.连接("src")).取成功值();
        标准库::文件系统::写入(根路径.连接("src/数学.zh"), "fn a() {}\n").取成功值();
        标准库::文件系统::写入(根路径.连接("src/util.zh"), "fn b() {}\n").取成功值();
        标准库::文件系统::写入(根路径.连接("src/helper.rs"), "pub fn c() {}\n").取成功值();
        让 (输出, 行映射) = 注解产物模块路径并返回行映射(
            "mod 数学;\nmod util;\nmod helper;\nmod 不存在;\n",
            &根路径.连接("src"),
            &根路径.连接("src"),
            根路径,
            &["zh".转字符串()],
        );
        断言!(
            输出.包含("#[path = \"../.rz/gen/src/数学.rs\"]"),
            "非 ASCII 方言子模块应指向托管产物：{输出}"
        );
        断言!(
            输出.包含("#[path = \"../.rz/gen/src/util.rs\"]"),
            "ASCII 方言子模块同样要指向托管产物（旧布局的自动查找已失效）：{输出}"
        );
        断言!(
            输出.包含("#[path = \"helper.rs\"]"),
            "手写 .rs 子模块留在 src/：{输出}"
        );
        断言相等!(
            输出.模式匹配("#[path").计数(),
            3,
            "无源文件的模块不注解（保留 rustc 原生 E0583）：{输出}"
        );
        // 每条注解一行，行映射把注解行归属其模块声明行
        断言相等!(行映射.元素数(), 输出.逐行().计数() + 1);
    }

    /// 托管产物自身注解：子模块相对位置与旧布局一致，手写 .rs 走逃逸路径
    #[测试]
    函数 托管内注解与旧布局逐字一致() {
        让 临时 = 临时文件::建临时目录().取成功值();
        让 根路径 = 临时.条目路径();
        标准库::文件系统::创建所有目录(根路径.连接("src/领域")).取成功值();
        标准库::文件系统::创建所有目录(根路径.连接(".rz/gen/src")).取成功值();
        标准库::文件系统::写入(根路径.连接("src/领域/工具.zh"), "fn a() {}\n").取成功值();
        标准库::文件系统::写入(根路径.连接("src/领域/helper.rs"), "fn b() {}\n").取成功值();
        让 (输出, _) = 注解产物模块路径并返回行映射(
            "mod 工具;\nmod helper;\n",
            &根路径.连接("src/领域"),
            &根路径.连接(".rz/gen/src"),
            根路径,
            &["zh".转字符串()],
        );
        断言!(
            输出.包含("#[path = \"领域/工具.rs\"]"),
            "方言子模块在托管树内的相对位置不变：{输出}"
        );
        断言!(
            输出.包含("#[path = \"../../../src/领域/helper.rs\"]"),
            "手写子模块要跨出托管目录回到 src/：{输出}"
        );
    }

    /// 清理只看源文件在不在：改名/删除后的残留被收走，在源的产物与
    /// 非产物文件（用户自己往托管目录放的东西）一律不动
    #[测试]
    函数 清理失效产物只删无源的产物() {
        让 临时 = 临时文件::建临时目录().取成功值();
        让 根路径 = 临时.条目路径();
        标准库::文件系统::创建所有目录(根路径.连接(".rz/gen/src/领域")).取成功值();
        标准库::文件系统::写入(根路径.连接(".rz/gen/src/数学.rs"), "pub fn a() {}\n").取成功值();
        标准库::文件系统::写入(根路径.连接(".rz/gen/src/领域/工具.rs"), "pub fn b() {}\n")
            .取成功值();
        标准库::文件系统::写入(根路径.连接(".rz/gen/src/旧名.rs"), "pub fn c() {}\n").取成功值();
        标准库::文件系统::写入(根路径.连接(".rz/gen/src/笔记.txt"), "keep\n").取成功值();
        // 源文件仍在（含嵌套层与多扩展名候选）
        标准库::文件系统::创建所有目录(根路径.连接("src/领域")).取成功值();
        标准库::文件系统::写入(根路径.连接("src/数学.zh"), "公开 函数 a() {}\n").取成功值();
        标准库::文件系统::写入(根路径.连接("src/领域/工具.ja"), "公開 関数 a() {}\n")
            .取成功值();
        让 已删除 = 清理失效产物(根路径, &["zh".转字符串(), "ja".转字符串()]);
        断言相等!(
            已删除,
            向量![根路径.连接(".rz/gen/src/旧名.rs")],
            "只有无源文件的产物被删"
        );
        断言!(根路径.连接(".rz/gen/src/数学.rs").是否为文件());
        断言!(根路径.连接(".rz/gen/src/领域/工具.rs").是否为文件());
        断言!(根路径.连接(".rz/gen/src/笔记.txt").是否为文件());
        // 源文件一个都没少时，重复清理为空操作
        断言!(清理失效产物(根路径, &["zh".转字符串(), "ja".转字符串()]).是否为空());
    }

    /// 产物所在的空目录一并移除（嵌套目录整体消失，不留空壳），
    /// 仍有产物的目录与托管根本身保留
    #[测试]
    函数 失效产物所在的空目录被移除() {
        让 临时 = 临时文件::建临时目录().取成功值();
        让 根路径 = 临时.条目路径();
        标准库::文件系统::创建所有目录(根路径.连接("src/留着")).取成功值();
        标准库::文件系统::创建所有目录(根路径.连接(".rz/gen/src/领域/更深")).取成功值();
        标准库::文件系统::写入(
            根路径.连接(".rz/gen/src/领域/更深/工具.rs"),
            "pub fn a() {}\n",
        )
        .取成功值();
        标准库::文件系统::创建所有目录(根路径.连接(".rz/gen/src/留着")).取成功值();
        标准库::文件系统::写入(根路径.连接(".rz/gen/src/留着/内容.rs"), "pub fn b() {}\n")
            .取成功值();
        // 镜像位置的源文件还在（产物 留着/内容.rs ← 源 src/留着/内容.zh）
        标准库::文件系统::写入(根路径.连接("src/留着/内容.zh"), "公开 函数 b() {}\n")
            .取成功值();
        让 已删除 = 清理失效产物(根路径, &["zh".转字符串()]);
        断言相等!(已删除, 向量![根路径.连接(".rz/gen/src/领域/更深/工具.rs")]);
        断言!(!根路径.连接(".rz/gen/src/领域").存在(), "整个分支已无产物");
        断言!(根路径.连接(".rz/gen/src/留着/内容.rs").是否为文件());
        断言!(根路径.连接(".rz/gen").是否为目录(), "托管根保留");
    }

    /// 无托管目录（纯入口项目 / 从未跑过非入口文件）时静默返回
    #[测试]
    函数 没有托管目录时不报错() {
        让 临时 = 临时文件::建临时目录().取成功值();
        断言!(清理失效产物(临时.条目路径(), &["zh".转字符串()]).是否为空());
    }

    /// 旧写入语义在托管目录里留下的 `.rs.bak`（同一产物的上一版本）也被清走，
    /// 而源文件还在的正常产物不受影响
    #[测试]
    函数 托管目录内的产物备份一并清理() {
        让 临时 = 临时文件::建临时目录().取成功值();
        让 根路径 = 临时.条目路径();
        标准库::文件系统::创建所有目录(根路径.连接("src")).取成功值();
        标准库::文件系统::写入(根路径.连接("src/数学.zh"), "公开 函数 a() {}\n").取成功值();
        标准库::文件系统::创建所有目录(根路径.连接(".rz/gen/src")).取成功值();
        标准库::文件系统::写入(根路径.连接(".rz/gen/src/数学.rs"), "pub fn a() {}\n")
            .取成功值();
        标准库::文件系统::写入(根路径.连接(".rz/gen/src/数学.rs.bak"), "旧版本\n")
            .取成功值();
        让 已删除 = 清理失效产物(根路径, &["zh".转字符串()]);
        断言相等!(已删除, 向量![根路径.连接(".rz/gen/src/数学.rs.bak")]);
        断言!(根路径.连接(".rz/gen/src/数学.rs").是否为文件());
    }

    /// 写入语义分流：只有本项目托管树下的文件算「机器产物」
    #[测试]
    函数 托管产物判定不越项目边界() {
        让 临时 = 临时文件::建临时目录().取成功值();
        让 根路径 = 临时.条目路径();
        标准库::文件系统::创建所有目录(根路径.连接(".rz/gen/src")).取成功值();
        标准库::文件系统::写入(根路径.连接(".rz/gen/src/数学.rs"), "pub fn a() {}\n")
            .取成功值();
        标准库::文件系统::创建所有目录(根路径.连接("src")).取成功值();
        标准库::文件系统::写入(根路径.连接("src/main.rs"), "fn main() {}\n").取成功值();
        断言!(是否为托管产物(根路径, &根路径.连接(".rz/gen/src/数学.rs")));
        // 首次写入（文件还不存在）同样按字面路径归入托管树
        断言!(是否为托管产物(
            根路径,
            &根路径.连接(".rz/gen/src/新文件.rs")
        ));
        断言!(!是否为托管产物(根路径, &根路径.连接("src/main.rs")));
        // 同名目录属于另一个项目时不算（否则备份护栏被绕过，真风险）
        让 另项目 = 路径类型::新建("/other/.rz/gen/src/数学.rs");
        断言!(!是否为托管产物(根路径, 另项目));
    }
}
