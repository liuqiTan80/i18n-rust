        让 源码 = "函数 主函数() {\n    让 x = 项们.拉平();\n}";
        让 告警 = 按词表检查教学(源码, &已知词, &中文歧义());
        让 提示: 向量<_> = 告警
            .迭代()
            .过滤(|告警项| 告警项.告警种类 == 告警类别::易混标识符)
            .收集();
        断言相等!(提示.长度(), 1, "{告警:?}");
        断言相等!(提示[0].相关文本, "拉平");
        断言相等!(提示[0].附加文本, "展平");
        断言相等!(提示[0].行号, 2);
        断言相等!(提示[0].列号, 14);
    }

    /// 共享索引入口与惰性入口结果一致（CLI 多文件路径改用缓存索引）
    ///
    /// 惰性入口只在源码出现方法调用位时才建索引，共享索引则无条件复用
    /// 调用方缓存的那份；两者必须给出同一串警告，否则接缓存会改变提示口径。
    #[测试]
    函数 分桶入口与惰性词入口一致() {
        让 已知词: 哈希集合<字符串> = ["展平".转字符串(), "长度".转字符串()]
            .消费迭代()
            .收集();
        让 歧义 = 中文歧义();
        对于 源码 在 [
            "函数 主函数() {\n    让 x = 项们.拉平();\n}",
            "函数 主函数() {\n    让 x = 1;\n}", // 无方法调用位：惰性分支不建索引
            "函数 主函数() {\n    项们.打印行（）;\n}", // 全角括号 + 表内词
        ] {
            让 字符切片: 向量<字符> = 源码.逐字符().收集();
            让 词形桶 = 词形分桶::构建(&已知词);
            让 惰性结果 = 按词表检查教学(源码, &已知词, &歧义);
            让 共享结果 = 按词形桶检查教学(源码, &词形桶, &歧义);
            让 共享字符结果 =
                按词形桶检查字符(&字符切片, &词形桶, &歧义);
            断言相等!(共享结果, 惰性结果, "共享索引与惰性索引结果不同:{源码}");
            断言相等!(共享字符结果, 惰性结果, "切片入口与字符串入口结果不同:{源码}");
        }
    }

    /// 差一字的短名（长词删一字符的结果）也提示
    #[测试]
    函数 易混方法长度差一() {
        让 已知词: 哈希集合<字符串> = ["打印行".转字符串()].消费迭代().收集();
        让 源码 = "函数 主函数() {\n    项们.打印();\n}";
        让 告警 = 按词表检查教学(源码, &已知词, &中文歧义());
        让 提示: 向量<_> = 告警
            .迭代()
            .过滤(|告警项| 告警项.告警种类 == 告警类别::易混标识符)
            .收集();
        断言相等!(提示.长度(), 1, "{告警:?}");
        断言相等!(提示[0].相关文本, "打印");
        断言相等!(提示[0].附加文本, "打印行");
    }

    /// 降噪边界：表内词/远距离词/单字名/字段访问/字符串/注释/范围与浮点不提示
    #[测试]
    函数 易混方法负例() {
        让 已知词: 哈希集合<字符串> = ["展平".转字符串()].消费迭代().收集();
        让 样例集 = [
            // 表内词
            "函数 主函数() {\n    让 x = 项们.展平();\n}",
            // 远距离词（编辑距离 >1）
            "函数 主函数() {\n    让 x = 项们.翻江倒海();\n}",
            // 单字方法名
            "函数 主函数() {\n    让 x = 项们.拉();\n}",
            // 字段访问（无括号）
            "函数 主函数() {\n    让 x = 项们.拉平;\n}",
            // 字符串内
            "函数 主函数() {\n    让 s = \"项.拉平()\";\n}",
            // 注释内
            "函数 主函数() {\n    // 项.拉平()\n}",
            // 范围语法 `..`
            "函数 主函数() {\n    循环 i 于 0..10 {}\n}",
            // 浮点字面量
            "函数 主函数() {\n    让 f: 浮点数 = 1.5;\n}",
        ];
        对于 源码 在 样例集 {
            让 告警 = 按词表检查教学(源码, &已知词, &中文歧义());
            断言!(
                !告警
                    .迭代()
                    .任意(|告警项| 告警项.告警种类 == 告警类别::易混标识符),
                "不应提示: {源码}\n{告警:?}"
            );
        }
    }

    /// 名字与 `(` 间隔空白仍判定；带 `_` 的复合名不判定（降噪边界）
    #[测试]
    函数 易混方法间距与复合名() {
        让 已知词: 哈希集合<字符串> = ["展平".转字符串()].消费迭代().收集();
        让 源码 = "函数 主函数() {\n    让 x = 项们.拉平 ();\n}";
        让 告警 = 按词表检查教学(源码, &已知词, &中文歧义());
        断言!(
            告警
                .迭代()
                .任意(|告警项| 告警项.告警种类 == 告警类别::易混标识符),
            "{告警:?}"
        );
        让 源码 = "函数 主函数() {\n    让 x = 项们.拉平_所有();\n}";
        让 告警 = 按词表检查教学(源码, &已知词, &中文歧义());
        断言!(
            !告警
                .迭代()
                .任意(|告警项| 告警项.告警种类 == 告警类别::易混标识符),
            "{告警:?}"
        );
    }

    /// 兼容入口（无词表）不做易混方法名提示
    #[测试]
    函数 易混方法兼容入口静默() {
        让 告警 = 检查教学("函数 主函数() {\n    让 x = 项们.拉平();\n}");
        断言!(
            !告警
                .迭代()
                .任意(|告警项| 告警项.告警种类 == 告警类别::易混标识符),
            "{告警:?}"
        );
    }

    /// 精确命中表与惰性路径（逐词比较）结论一致：合法词不提示笔误，
    /// 真笔误仍能给出候选
    #[测试]
    函数 精确索引与惰性查表一致() {
        让 词表: 哈希集合<字符串> = ["展平", "推送", "弹出", "向量", "新建"]
            .迭代()
            .映射(|英文| 英文.转字符串())
            .收集();
        让 惰性索引 = 词形分桶::构建(&词表);
        让 精确索引 = 词形分桶::构建(&词表).带精确索引();
        对于 名字 在 [
            "展平",
            "拉平",
            "推送",
            "推 送",
            "弹出",
            "向量",
            "不存在",
            "很长的名字",
        ] {
            让 字符切片: 向量<字符> = 名字.逐字符().收集();
            断言相等!(
                易混候选(&字符切片, &惰性索引),
                易混候选(&字符切片, &精确索引),
                "名字 {名字} 在上两条路径上的结论应一致"
            );
        }
        // 合法词一次命中，不进候选遍历
        让 命中: 向量<字符> = "展平".逐字符().收集();
        断言相等!(易混候选(&命中, &精确索引), 无);
        // 一字之差仍给出词典序最小候选
        让 笔误: 向量<字符> = "拉平".逐字符().收集();
        断言相等!(易混候选(&笔误, &精确索引), 有值("展平"));
    }

    /// 分桶索引入口与「三个独立入口依次拼接」结论逐条一致（含顺序）
    ///
    /// LSP 诊断发布路径从三趟切到一次遍历，这条锁住两条路径不漂移：
    /// 教学 / 英文回退 / 保留名撞词三组警告的数量、顺序、行列与文本。
    #[测试]
    函数 分桶全部入口与三入口一致() {
        让 已知词: 哈希集合<字符串> =
            ["展平", "推送", "向量", "新建", "函数", "让"]
                .迭代()
                .映射(|英文| 英文.转字符串())
                .收集();
        让 词形桶 = 词形分桶::构建(&已知词).带精确索引();
        让 英文回退表 =
            哈希映射::从([("fn".转字符串(), "函数".转字符串())]);
        让 关键字映射 = 哈希映射::从([
            ("函数".转字符串(), "fn".转字符串()),
            ("让".转字符串(), "let".转字符串()),
            ("匹配".转字符串(), "match".转字符串()),
        ]);
        让 歧义 = 中文歧义();
        // 第 4 行的歧义绑定后续无引用，确保「未标注类型」组真实出现；
        // 第 2 行的 `项` 后续被方法调用引用，类型可由使用处推导，不再提示
        让 源码 = "函数 匹配(x: 整数) {\n    让 项 = 向量::新建();\n    项.拉平();\n    让 孤立 = 向量::新建();\n    fn 打印行();\n    让 y = 项.展平();\n}";

        让 可变 预期 = 按词表检查教学(源码, &已知词, &歧义);
        预期.扩展(检查英文回退(源码, &英文回退表));
        预期.扩展(检查保留名撞词(源码, &关键字映射));

        让 字符切片: 向量<字符> = 源码.逐字符().收集();
        让 实际 = 按词形桶检查全部教学字符(
            &字符切片,
            &词形桶,
            &歧义,
            &英文回退表,
            &关键字映射,
        );

        让 取键 = |告警项: &教学告警| {
            (
                告警项.告警种类,
                告警项.行号,
                告警项.列号,
                告警项.相关文本.克隆值(),
                告警项.附加文本.克隆值(),
            )
        };
        断言相等!(
            预期.迭代().映射(取键).收集::<向量<_>>(),
            实际.迭代().映射(取键).收集::<向量<_>>()
        );
        // 三组警告都要在这份源码上真实出现，否则上面的相等是空对空
        断言!(实际
            .迭代()
            .任意(|告警项| 告警项.告警种类 == 告警类别::未标注类型));
        断言!(实际
            .迭代()
            .任意(|告警项| 告警项.告警种类 == 告警类别::易混标识符));
        断言!(实际
            .迭代()
            .任意(|告警项| 告警项.告警种类 == 告警类别::英文回退));
        断言!(实际
            .迭代()
            .任意(|告警项| 告警项.告警种类 == 告警类别::保留名撞词));
    }

    #[测试]
    函数 深缩进仅报告一次() {
        // 两处深层嵌套：仅首个报告（避免刷屏）；缩进逐层递增
        让 可变 源码 = 字符串::从("函数 主函数() {\n");
        对于 层数 在 1..=7 {
            源码.推入字符串(&"    ".重复(层数));
            源码.推入字符串("if 真 {\n");
        }
        源码.推入字符串(&"    ".重复(8));
        源码.推入字符串("让 x = 1;\n");
        对于 层数 在 (1..=7).逆序() {
            源码.推入字符串(&"    ".重复(层数));
            源码.推入字符串("}\n");
        }
        源码.推入字符串("    if 真 {\n        如果 真 {\n            循环 {\n");
        源码.推入字符串(&"    ".重复(5));
        源码.推入字符串("让 y = 1;\n");
        源码.推入字符串("            }\n        }\n    }\n}\n");
        让 告警 = 检查教学(&源码);
        让 深缩进集: 向量<_> = 告警
            .迭代()
            .过滤(|告警项| 告警项.告警种类 == 告警类别::嵌套过深)
            .收集();
        断言相等!(深缩进集.长度(), 1, "{告警:?}");
        // 第 7 层条件分支（第 7 行）缩进已达 24 空格阈值，是首个触发点
        断言相等!(深缩进集[0].行号, 7);
    }

    #[测试]
    函数 注释行不算深缩进() {
        让 源码 =
            "函数 主函数() {\n                        // 长缩进的注释行\n    让 x = 1;\n}";
        让 告警 = 检查教学(源码);
        断言!(
            !告警
                .迭代()
                .任意(|告警项| 告警项.告警种类 == 告警类别::嵌套过深),
            "{告警:?}"
        );
    }

    /// 原始字符串与字符字面量内的数字/易混方法名不参与判定：模块文档称扫描器与
    /// 全角标点模块同构、跳过 字符串/字符/原始字符串/注释，但既有教学检查负例只测了
    /// 普通双引号串与行/块注释，未覆盖字面量状态 2（字符）与 3（原始串）
    /// ——而全角标点模块对此两类有专测。先以代码位同名方法确证会提示（排除“全局
    /// 静音”假象），再断言同样的内容落进原始串/字符字面量即被状态机跳过。
    #[测试]
    函数 原始串与字符字面量被忽略() {
        让 已知词: 哈希集合<字符串> = ["展平".转字符串()].消费迭代().收集();
        让 歧义 = 中文歧义();
        // 正例锚点：.拉平() 在代码位应触发易混提示（与已知词里的 展平 编辑距离 1）
        让 代码样例 = r#"函数 主函数() {
    让 x = 项们.拉平();
}"#;
        让 代码告警 = 按词表检查教学(代码样例, &已知词, &歧义);
        断言!(
            代码告警
                .迭代()
                .任意(|告警项| 告警项.告警种类 == 告警类别::易混标识符),
            "代码位 .拉平() 应提示:{代码告警:?}"
        );
        // 原始串 r#"..."# 内的数字与易混方法名均被状态机(3)跳过
        让 原始样例 = r##"函数 主函数() {
    让 s = r#"42 项们.拉平()"#;
}"##;
        让 原始告警 = 按词表检查教学(原始样例, &已知词, &歧义);
        断言!(
            !原始告警
                .迭代()
                .任意(|告警项| 告警项.告警种类 == 告警类别::魔法数字),
            "原始串内 42 不应报魔法数字:{原始告警:?}"
        );
        断言!(
            !原始告警
                .迭代()
                .任意(|告警项| 告警项.告警种类 == 告警类别::易混标识符),
            "原始串内 .拉平() 不应报易混方法:{原始告警:?}"
        );
        // 字符字面量 '5' 内的数字被状态机(2)跳过
        让 字符样例 = r#"函数 主函数() {
    让 c = '5';
}"#;
        让 字符告警 = 检查教学(字符样例);
        断言!(
            !字符告警
                .迭代()
                .任意(|告警项| 告警项.告警种类 == 告警类别::魔法数字),
            "字符字面量内 5 不应报魔法数字:{字符告警:?}"
        );
    }

    /// 回退测试用反向索引（英文 → 母语），模拟中文语言包的一批常见词
    函数 中文回退表() -> 哈希映射<字符串, 字符串> {
        [
            ("fn", "函数"),
            ("let", "让"),
            ("struct", "结构体"),
            ("match", "匹配"),
            ("pub", "公开"),
            ("mut", "可变"),
            ("Vec", "向量"),
            ("String", "字符串"),
            ("new", "新建"),
            ("collect", "收集"),
            ("clone", "克隆"),
            ("println", "打印行"),
            ("sum", "求和"),
        ]
        .消费迭代()
        .映射(|(英文, 中文)| (英文.转字符串(), 中文.转字符串()))
        .收集()
    }

    /// 结构位置的英文被提示；恒等空表自动静默
    #[测试]
    函数 英文回退标记结构位置() {
        让 映射表 = 中文回退表();
        让 源码 = "fn main() {\n    let v = Vec::new();\n}";
        让 告警 = 检查英文回退(源码, &映射表);
        让 已标记: 向量<&文本> =
            告警.迭代().映射(|告警项| 告警项.相关文本.作为文本切片()).收集();
        // 函数/让 保留字、向量 路径头、新建 关联函数调用 均应提示
        断言!(已标记.包含(&"fn"), "fn 应提示:{告警:?}");
        断言!(已标记.包含(&"let"), "let 应提示:{告警:?}");
        断言!(已标记.包含(&"Vec"), "Vec:: 应提示:{告警:?}");
        断言!(已标记.包含(&"new"), "::new() 应提示:{告警:?}");
        // 主函数（函数关键字后的名字）与 v（让 绑定后的变量名）为用户命名，豁免
        断言!(!已标记.包含(&"main"), "函数名不应提示:{告警:?}");
        断言!(!已标记.包含(&"v"), "变量名不应提示:{告警:?}");
        // 空表（英文恒等映射语言包）静默
        断言!(检查英文回退(源码, &哈希映射::新建()).是否为空());
    }

    /// 方法调用位 `.collect()` / 宏 `println!` / 泛型 `Vec<` 被提示
    #[测试]
    函数 英文回退方法宏泛型() {
        让 映射表 = 中文回退表();
        让 告警 =
            检查英文回退("让 和 = 数们.iter().map(|x| x).collect();", &映射表);
        断言!(
            告警.迭代().任意(|告警项| 告警项.相关文本 == "collect"),
            ".collect() 应提示:{告警:?}"
        );
        让 宏告警 = 检查英文回退("println!(\"hi\");", &映射表);
        断言!(
            宏告警.迭代().任意(|告警项| 告警项.相关文本 == "println"),
            "println! 应提示:{告警:?}"
        );
        让 泛型告警 =
            检查英文回退("让 a: Vec<i32> = 向量::新建();", &映射表);
        断言!(
            泛型告警.迭代().任意(|告警项| 告警项.相关文本 == "Vec"),
            "Vec< 泛型位应提示:{泛型告警:?}"
        );
    }

    /// 降噪：字符串/注释内英文跳过；同一英文词每文件仅首个命中提示一次；
    /// 非结构位的裸标识符（变量名恰好等于映射词）不误报
    #[测试]
    函数 英文回退去重与降噪() {
        让 映射表 = 中文回退表();
        // 多个函数关键字只报一次
        让 多个 = 检查英文回退("fn a() {}\nfn b() {}\nfn c() {}", &映射表);
        断言相等!(
            多个
                .迭代()
                .过滤(|告警项| 告警项.相关文本 == "fn")
                .计数(),
            1,
            "fn 应去重为一条:{多个:?}"
        );
        // 字符串与行注释内的 `值.collect()` 不提示
        让 串内 =
            检查英文回退("让 s = \"collect\"; // collect\n让 变量 = 5;", &映射表);
        断言!(
            !串内
                .迭代()
                .任意(|告警项| 告警项.相关文本 == "collect"),
            "字符串/注释内 collect 不应提示:{串内:?}"
        );
        // 裸标识符（无调用/泛型/路径/宏结构位）不误报：求和 作为变量名
        让 裸标识符 = 检查英文回退("让 求和值 = 总和 + 统计;", &映射表);
        断言!(裸标识符.是否为空(), "纯母语写法不应提示:{裸标识符:?}");
        // 「教学忽略」行整行跳过
        让 已忽略 = 检查英文回退("fn x() {} // 教学忽略", &映射表);
        断言!(
            !已忽略
                .迭代()
                .任意(|告警项| 告警项.相关文本 == "fn"),
            "教学忽略行不应提示:{已忽略:?}"
        );
    }

    /// 声明关键字后的用户命名豁免：函数名、结构体名这类用户命名不提示
    #[测试]
    函数 英文回退豁免声明名() {
        让 映射表 = 中文回退表();
        让 告警 = 检查英文回退("fn collect() {}\nstruct String;", &映射表);
        让 已标记: 向量<&文本> =
            告警.迭代().映射(|告警项| 告警项.相关文本.作为文本切片()).收集();
        // fn/struct 关键字自身提示
        断言!(已标记.包含(&"fn"), "fn 应提示:{告警:?}");
        断言!(已标记.包含(&"struct"), "struct 应提示:{告警:?}");
        // 但其后的函数名/结构体名（恰与映射词同名）豁免
        断言!(
            !已标记.包含(&"collect"),
            "声明的函数名不应提示:{告警:?}"
        );
        断言!(
            !已标记.包含(&"String"),
            "声明的结构体名不应提示:{告警:?}"
        );
    }

    /// 用 `r#` 转义后的声明名字不再提示（转译产物本就合法）
    #[测试]
    函数 保留名撞词原始标识符转义静默() {
        让 映射表 = 中文关键字表();
        让 源码 = "函数 r#匹配(值: 整数) -> 整数 {\n    返回 值\n}\n\n函数 主函数() {\n    让 r#循环 = r#匹配(3);\n}";
        让 告警 = 检查保留名撞词(源码, &映射表);
        断言!(告警.是否为空(), "r# 转义后不应提示:{告警:?}");
    }

    /// 母语 → 英文关键字表（仅收撞名相关词条）
    函数 中文关键字表() -> 哈希映射<字符串, 字符串> {
        [
            ("函数", "fn"),
            ("让", "let"),
            ("可变", "mut"),
            ("结构体", "struct"),
            ("枚举", "enum"),
            ("特征", "trait"),
            ("模块", "mod"),
            ("实现", "impl"),
            ("类型", "type"),
            ("常量", "const"),
            ("匹配", "match"),
            ("循环", "loop"),
            ("返回", "return"),
            ("如果", "if"),
        ]
        .消费迭代()
        .映射(|(中文, 英文)| (中文.转字符串(), 英文.转字符串()))
        .收集()
    }

    /// 声明位命中保留字时提示（函数名/结构体名/let 绑定），并带出目标保留字
    #[测试]
    函数 保留名撞词标记声明名() {
        让 映射表 = 中文关键字表();
        让 源码 = "函数 匹配(x: 整数) -> 整数 {\n    返回 x\n}\n\n结构体 类型 {\n    字段: 整数,\n}\n\n函数 主函数() {\n    让 循环 = 5;\n}";
        让 告警 = 检查保留名撞词(源码, &映射表);
        让 相关文本集: 向量<&文本> =
            告警.迭代().映射(|告警项| 告警项.相关文本.作为文本切片()).收集();
        断言!(相关文本集.包含(&"匹配"), "函数名撞名应提示:{告警:?}");
        断言!(相关文本集.包含(&"类型"), "结构体名撞名应提示:{告警:?}");
        断言!(相关文本集.包含(&"循环"), "let 绑定撞名应提示:{告警:?}");
        // 带出目标保留字（附加文本）
        断言!(
            告警
                .迭代()
                .任意(|告警项| 告警项.相关文本 == "循环" && 告警项.附加文本 == "loop"),
            "应报告目标保留字 loop:{告警:?}"
        );
        // 普通语句词（`返回 x`）不是名字位，不提示
        断言!(!相关文本集.包含(&"返回"), "返回作语句词不应提示:{告警:?}");
    }

    /// 语句词/模式位不误报；`让 可变` 跨过修饰词后仍能命中真正的名字
    #[测试]
    函数 保留名撞词语句词与可变修饰() {
        让 映射表 = 中文关键字表();
        // 「匹配」作匹配表达式、「返回」作语句：均非声明名字位
        让 源码 = "函数 f(值: 整数) -> 整数 {\n    让 r = 匹配 值 {\n        _ => 1,\n    };\n    返回 r\n}";
        让 告警 = 检查保留名撞词(源码, &映射表);
        断言!(
            告警.是否为空(),
            "语句/表达式位的匹配与返回不应提示:{告警:?}"
        );
        // `让 可变 循环`：可变 是修饰词，真正的名字 循环 撞「循环」保留字
        让 含可变 = 检查保留名撞词("让 可变 循环 = 5;", &映射表);
        断言相等!(含可变.长度(), 1, "应只报 循环 一条:{含可变:?}");
        断言相等!(含可变[0].相关文本, "循环");
        // `让 可变 x`：名字正常，不报
        断言!(检查保留名撞词("让 可变 x = 5;", &映射表).是否为空());
    }

    /// 空表静默；“教学忽略”行整行跳过；字符串/注释内的名字不参与判定
    #[测试]
    函数 保留名撞词静默与忽略() {
        断言!(检查保留名撞词("函数 匹配() {}", &哈希映射::新建()).是否为空());
        让 映射表 = 中文关键字表();
        // 教学忽略标记跳过整行
        断言!(
            检查保留名撞词("函数 匹配() {} // 教学忽略", &映射表).是否为空(),
            "教学忽略行不应提示"
        );
        // 字符串/注释内的名字不参与判定
        让 源码 = "函数 f() {\n    让 s = \"匹配 循环\"; // 匹配 类型\n}";
        断言!(
            检查保留名撞词(源码, &映射表).是否为空(),
            "字符串/注释内不应提示:{:?}",
            检查保留名撞词(源码, &映射表)
        );
    }

    /// 注释起始须两字符相邻：分隔的 `/` 不得吞掉后续代码
    ///
    /// 英文回退原先按「上一个非空白字符」判定，`a / *b` 的 `*` 与
    /// `/ / fn f()` 的第二个 `/` 都会被误当作注释起点，导致该行/该文件
    /// 之后的提示整体丢失。合并扫描后与撞名检查统一按相邻字符判定。
    #[测试]
    函数 注释起点需相邻斜杠() {
        让 映射表 = 中文回退表();
        // 除法后解引用：`*` 不是块注释起点，下一行的函数关键字照常提示
        让 除法样例 = 检查英文回退("让 x = a / *b;\nfn foo();", &映射表);
        断言!(
            除法样例
                .迭代()
                .任意(|告警项| 告警项.相关文本 == "fn"),
            "`a / *b` 不应吞掉后续行:{除法样例:?}"
        );
        // 两个 `/` 之间隔空格：不是行注释，同行的函数关键字照常提示
        让 隔空 = 检查英文回退("让 a = 1; /  / fn foo();", &映射表);
        断言!(
            隔空
                .迭代()
                .任意(|告警项| 告警项.相关文本 == "fn"),
            "隔空格的 `/ /` 不应当行注释:{隔空:?}"
        );
        // 真正的注释仍然跳过
        让 真注释 = 检查英文回退("// fn foo()\n/* fn bar() */", &映射表);
        断言!(真注释.是否为空(), "注释内英文不应提示:{真注释:?}");
    }

    /// 组合入口与三个单函数逐条一致（顺序：教学 / 英文回退 / 撞名）
    #[测试]
    函数 全部教学入口与单检查一致() {
        让 英文回退表 = 中文回退表();
        让 关键字映射 = 中文关键字表();
        让 词表 = 哈希集合::新建();
        让 歧义 = 哈希集合::新建();
        让 源码 = "函数 匹配() {\n    let v = Vec::new();\n    让 循环 = 5;\n}";

        让 可变 预期 = 按词表检查教学(源码, &词表, &歧义);
        预期.扩展(检查英文回退(源码, &英文回退表));
        预期.扩展(检查保留名撞词(源码, &关键字映射));
        让 实际 =
            检查全部教学(源码, &词表, &歧义, &英文回退表, &关键字映射);
        断言相等!(预期, 实际, "组合入口应与三个单函数逐条一致");
        断言!(!实际.是否为空(), "样例应同时命中两侧提示:{实际:?}");
        // 两侧空表时退化为纯教学检查
        让 纯教学 = 检查全部教学(
            源码,
            &词表,
            &歧义,
            &哈希映射::新建(),
            &哈希映射::新建(),
        );
        断言相等!(
            纯教学,
            按词表检查教学(源码, &词表, &歧义),
            "空表应退化为纯教学检查"
        );
    }
}
