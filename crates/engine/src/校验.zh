    /// 「教学忽略」标记的字符切片判定（不分配字符串）：含标记才收行号
    #[测试]
    函数 含忽略标记判定() {
        让 标记: 向量<字符> = 忽略标记.逐字符().收集();
        断言!(含忽略标记(&标记));
        // 前后带注释上下文（教程里的常见写法）
        让 可变 填充: 向量<字符> = "// ".逐字符().收集();
        填充.扩展(标记.迭代().复制值());
        填充.扩展("：这行故意不修".逐字符());
        断言!(含忽略标记(&填充));
        // 普通注释、标记前缀（不足一个标记）、空切片
        断言!(!含忽略标记(
            &"// 普通注释".逐字符().收集::<向量<_>>()
        ));
        断言!(!含忽略标记(&标记[..标记.长度() - 1]));
        断言!(!含忽略标记(&[]));
    }

