//! 教学检查模块
//! 针对 Rust 初学者的启发式代码风格提示（教学价值驱动）：
//! 与编译器错误不同，这些提示不阻断编译，只在代码位置出现常见
//! 教学问题时给出建设性建议。规则刻意保守，避免噪音——教学工具的
//! 提示必须每条都有价值：
//! - 未标注类型：仅在类型**无法靠初始化式及其后续使用推导**的歧义形态提示
//!   （`让 x = 向量::新建();`、`让 x = 迭代器.收集();`）——无注解且绑定名
//!   在语句之后再无引用的位置，rustc 才会以 E0282 要求注解；字面量、普通
//!   函数/方法调用、结构体/元组/数组、路径与块表达式的类型均可自行推导，
//!   后续使用（如 `x.推入(...)`）同样能补全容器元素类型——这些位置提示
//!   「显式写出类型」无解且成噪音，不报告
//! - 魔法数字：非平凡数字字面量（命名常量教学）
//! - 嵌套过深：代码行缩进过深（重构教学，每文件仅首个）
//! - 易混方法名：方法调用位未命中映射表且与表内词近似的长中文串
//!   （如 `.拉平()` 应为 `.展平()`，编辑距离 ≤1 才提示以降噪）
//! - 英文回退：结构词写成英文（`fn 主()`、`Vec::新建()`、`值.collect()`）而语言包有母语词条
//!   （`检查英文回退`）
//! - 保留名撞词：声明位的名字经映射后是 Rust 保留字（`函数 匹配` → `fn match`），
//!   产物非法或语义被静默改写（`检查保留名撞词`）
//!
//! 行注释含「教学忽略」时整行跳过（教师可标注故意不修的示例）：
//! `让 x = 5;  // 教学忽略` 不产生任何教学警告。
//!
//! 扫描器与全角标点模块同构：状态机跳过字符串/字符/原始字符串与
//! 注释，仅在代码位置判定，避免把字符串内容误判为代码问题。

使用 标准库::集合::{哈希映射, 哈希集合};
使用 标准库::同步::原子::{原子布尔, 内存顺序};

/// 教学检查全局开关（默认开启，进程级）
///
/// 项目开发（非教学）场景下，初学者代码风格提示会在每次转译时刷屏；
/// 命令行的关闭开关将其置为关闭（见 [`设教学告警启用`]）。
/// 仅影响教学检查输出，Unicode 混杂/全角标点告警不受影响；
/// 与日志级别同为进程级配置。
静态 教学告警总开关: 原子布尔 = 原子布尔::新建(真);

/// 设置教学检查开关（进程级；测试与嵌入场景使用）
公开 函数 设教学告警启用(启用状态: 布尔) {
    教学告警总开关.存值(启用状态, 内存顺序::松弛序);
}

/// 查询教学检查开关（输出方：转译管线/CLI 逐文件告警均据此静默）
公开 函数 教学告警已启用() -> 布尔 {
    教学告警总开关.加载(内存顺序::松弛序)
}

/// 教学检查规则种类
#[派生(调试, 克隆, 可复制, 部分相等, 全等)]
公开 枚举 告警类别 {
    /// `让` 绑定缺少类型注解
    未标注类型,
    /// 非平凡数字字面量（建议命名常量）
    魔法数字,
    /// 代码行嵌套过深（建议拆分函数）
    嵌套过深,
    /// 方法调用位的长中文串未命中映射表且与表内词近似（疑似笔误）
    易混标识符,
    /// 母语方言源码里把有母语词条的结构词写成英文（`fn 主()`、`Vec::新建()`、`值.collect()`…）
    英文回退,
    /// 声明位名字命中关键字词条且映射为 Rust 保留关键字（撞名，会静默改写语义）
    保留名撞词,
}

/// 单个教学检查告警：位置（1 起行/列）+ 规则 + 相关文本
#[派生(调试, 克隆, 部分相等)]
公开 结构体 教学告警 {
    /// 行号（从 1 开始）
    公开 行号: 无符号机器整数,
    /// 列号（从 1 开始，按字符计数）
    公开 列号: 无符号机器整数,
    /// 规则种类
    公开 告警种类: 告警类别,
    /// 相关文本（魔法数字原文、方法名等；其他规则为空串）
    公开 相关文本: 字符串,
    /// 补充文本（易混词提示的候选词等；其他规则为空串）
    公开 附加文本: 字符串,
}

实现 教学告警 {
    /// 格式化为单行提示文本，模板随当前语言变化
    公开 函数 生成说明(&自我) -> 字符串 {
        匹配 自我.告警种类 {
            告警类别::未标注类型 => 包::语言::取带参消息(
                "lint_untyped_let",
                &[&自我.行号.转字符串(), &自我.列号.转字符串()],
            ),
            告警类别::魔法数字 => 包::语言::取带参消息(
                "lint_magic_number",
                &[&自我.行号.转字符串(), &自我.列号.转字符串(), &自我.相关文本],
            ),
            告警类别::嵌套过深 => 包::语言::取带参消息(
                "lint_deep_indent",
                &[&自我.行号.转字符串(), &自我.相关文本],
            ),
            告警类别::易混标识符 => 包::语言::取带参消息(
                "lint_confusable_method",
                &[
                    &自我.行号.转字符串(),
                    &自我.列号.转字符串(),
                    &自我.相关文本,
                    &自我.附加文本,
                ],
            ),
            告警类别::英文回退 => 包::语言::取带参消息(
                "lint_english_fallback",
                &[
                    &自我.行号.转字符串(),
                    &自我.列号.转字符串(),
                    &自我.相关文本,
                    &自我.附加文本,
                ],
            ),
            告警类别::保留名撞词 => 包::语言::取带参消息(
                "lint_reserved_name_collision",
                &[
                    &自我.行号.转字符串(),
                    &自我.列号.转字符串(),
                    &自我.相关文本,
                    &自我.附加文本,
                ],
            ),
        }
    }
}

/// 进行中的 `让` 绑定扫描（等待语句结束判定是否有类型注解）
结构体 让声明扫描 {
    行号: 无符号机器整数,
    列号: 无符号机器整数,
    /// 绑定名：语句结束后若仍有引用，类型可由使用处推导，不再提示
    名字: 字符串,
    /// 已见到 `=`（其后出现的 `:` 是路径分隔符而非类型注解）
    已见等号: 布尔,
    /// 已见到 `:`（类型注解）
    已标注: 布尔,
    /// `=` 之后的初始化式原文（到 `;`/`{`/`}` 为止；用于判定类型能否
    /// 自行推导，仅在无注解时参与判定）
    初始化原文: 字符串,
}

/// 初始化式歧义、但需等扫描结束才能确认「绑定名后续无引用」的候选绑定
///
/// 局部变量类型推断是**整函数**级别的：`让 可变 v = 向量::新建();`
/// 后接 `v.推入(路径缓冲)` 时元素类型由推入实参确定，rustc 不会报 E0282。
/// 故提示延后到扫描结束，再按语句之后的引用情况取舍。
结构体 待标注类型 {
    名字: 字符串,
    行号: 无符号机器整数,
    列号: 无符号机器整数,
    /// 绑定语句结束位置（分号/花括号/下一个 `让` 的下标），从其后找使用处
    之后位置: 无符号机器整数,
}

/// 布尔字面量的无词条别名：`真`/`假` 是关键字表词形，直接写进 `有值(…)`
/// 会被绑定位审计当成模式内绑定（表达式位与模式位同形），故用常量承接。
常量 真值: 布尔 = 真;
常量 假值: 布尔 = 假;

/// 类型推导歧义构造器的英文被调名（无映射表时的兜底集合）
常量 英文歧义构造器: &[&文本] = &["new", "default"];

/// 对源码执行教学检查（无已知词表：不做易混方法名提示），返回全部警告（升序）
///
/// 兼容入口；需要易混方法名提示（方法调用位未命中映射表）时用
/// [`按词表检查教学`] 并传入映射表键集合。
公开 函数 检查教学(源码: &文本) -> 向量<教学告警> {
    让 歧义: 哈希集合<字符串> = 英文歧义构造器
        .迭代()
        .映射(|文本值| 文本值.转字符串())
        .收集();
    按词表检查教学(源码, &哈希集合::新建(), &歧义)
}

/// 对源码执行教学检查，返回全部警告（升序）
///
/// `已知词表`：全部映射表键的集合（关键字/宏/派生/模块路径/别名）。
/// 方法调用位出现未命中词表的长中文串（≥2 字）且与表内词近似
/// （编辑距离 ≤1）时提示疑似笔误——未命中词会被原样保留，错误在
/// 产物侧才爆发（如 `.拉平()` 应为 `.展平()`）。
///
/// `歧义构造器`：类型推导歧义构造器的被调名集合（含英文
/// 「新建」「缺省」及其各方言映射词），由
/// `映射管理器::歧义构造器词表` 提供；仅这些关联构造
/// 的无显式泛型调用与无显式泛型的 `.collect()` 才触发未标注类型提示。
/// 绑定名在语句之后仍有引用（类型可由使用处推导，如后续 `.推入(...)`）时不提示。
///
/// 仅报告代码位置的问题；字符串/注释内的同名文本被状态机跳过。
///
/// 仅在源码里出现方法调用位时才建词表分桶索引（首次调用时）；同一语言包
/// 下重复调用（CLI 批量转译、LSP 每次编辑）请改用
/// [`按词形桶检查教学`] 复用调用方缓存。
公开 函数 按词表检查教学(
    源码: &文本,
    已知词表: &哈希集合<字符串>,
    歧义构造器: &哈希集合<字符串>,
) -> 向量<教学告警> {
    让 字符切片: 向量<字符> = 源码.逐字符().收集();
    检查教学字符(
        &字符切片,
        词形索引来源::延迟静态值(已知词表),
        歧义构造器,
    )
}

/// 同 [`按词表检查教学`]，但复用调用方缓存的词表分桶索引
///
/// `词形桶` 由 [`包::映射管理器::映射管理器::检查词形桶`]
/// 提供：词表随语言包确定后不可变，分桶只需建一次。小文件（批量转译、
/// 每次编辑）上重建索引的开销远大于扫描本身。
公开 函数 按词形桶检查教学(
    源码: &文本,
    词形桶: &词形分桶,
    歧义构造器: &哈希集合<字符串>,
) -> 向量<教学告警> {
    让 字符切片: 向量<字符> = 源码.逐字符().收集();
    按词形桶检查字符(&字符切片, 词形桶, 歧义构造器)
}

/// [`按词形桶检查教学`] 的字符切片入口
///
/// 供一次教学检查里还要跑全角扫描、Unicode 混淆扫描的调用方使用（CLI 多文件
/// 转译、LSP 每次变更）：字符切片只物化一份，几个扫描器共用。
公开 函数 按词形桶检查字符(
    字符切片: &[字符],
    词形桶: &词形分桶,
    歧义构造器: &哈希集合<字符串>,
) -> 向量<教学告警> {
    检查教学字符(
        字符切片,
        词形索引来源::共享(词形桶),
        歧义构造器,
    )
}

/// 易混方法名索引的来源：调用方已缓存（管线路径）或现场惰性构建（单次调用）
///
/// 惰性分支保留改前的行为：源码里一个方法调用位都没有时完全不建索引。
公开(包) 枚举 词形索引来源<'甲> {
    /// 调用方持有并缓存的分桶索引（每语言包一次）
    共享(&'甲 词形分桶),
    /// 现场构建：只在首个方法调用位出现时建一次
    延迟静态值(&'甲 哈希集合<字符串>),
}

/// [`按词表检查教学`] 的字符切片入口
///
/// 同一轮教学检查里多个扫描器共用一份字符切片，避免每个各扫一遍源码
/// （整条管线一次物化，见转译管线内部函数）。
/// 已持有分桶索引的调用方请改用 [`按词形桶检查字符`]。
公开(包) 函数 检查教学字符(
    字符切片: &[字符],
    词索引来源: 词形索引来源<'_>,
    歧义构造器: &哈希集合<字符串>,
) -> 向量<教学告警> {
    // 惰性分支的落地位置：进入首个方法调用位时建一次
    让 可变 本地索引: 选项<词形分桶> = 无;
    让 可变 告警 = 向量::新建();
    让 可变 行号 = 1usize;
    让 可变 列号 = 1usize;
    // 字面量状态：0 = 代码位置；1 = 双引号串 2 = 字符 3 = 原始串
    让 可变 字面量状态: 字节 = 0;
    让 可变 原始井数 = 0usize;
    让 可变 前普通字符 = '\0';
    // 行首缩进追踪（仅代码行累计，用于嵌套深度提示）
    让 可变 行首缩进 = 0usize;
    让 可变 在行首 = 真;
    让 可变 首个非空白是注释 = 假;
    让 可变 深缩进已报告 = 假;
    // 未标注类型扫描状态
    让 可变 让扫描状态: 选项<让声明扫描> = 无;
    // 初始化式歧义、待确认「绑定名后续无引用」的候选（扫描结束统一取舍）
    让 可变 待定列表: 向量<待标注类型> = 向量::新建();
    // 行注释含「教学忽略」的行号：整行跳过教学警告（教师标注故意不修的示例）
    让 可变 已忽略行集: 哈希集合<无符号机器整数> = 哈希集合::新建();

    让 可变 序号 = 0usize;
    当 序号 < 字符切片.长度() {
        让 当前字符 = 字符切片[序号];
        // 行首缩进累计（独立于字面量状态：多行字符串内部行由字面量
        // 分支吞掉，不会走到这里；行首仅代码位置才累计）
        如果 在行首 && 字面量状态 == 0 {
            匹配 当前字符 {
                ' ' => {
                    行首缩进 += 1;
                    序号 += 1;
                    列号 += 1;
                    继续;
                }
                '\t' => {
                    行首缩进 += 4;
                    序号 += 1;
                    列号 += 1;
                    继续;
                }
                '\n' => {
                    // 空行/纯空白行的换行：须与主循环的换行处理一致（行号 +1、列复位），
                    // 否则空行不计行，其后所有警告位置整体前移（回归：第 5 行的 `让`
                    // 因上方两个空行被报成第 3 行）
                    行号 += 1;
                    列号 = 1;
                    行首缩进 = 0;
                    在行首 = 真;
                    首个非空白是注释 = 假;
                    前普通字符 = '\0';
                    序号 += 1;
                    继续;
                }
                '/' 如果 !首个非空白是注释
                    && 序号 + 1 < 字符切片.长度()
                    && (字符切片[序号 + 1] == '/' || 字符切片[序号 + 1] == '*') =>
                {
                    // 注释行：不参与嵌套深度提示
                    首个非空白是注释 = 真;
                    在行首 = 假;
                }
                _ => {
                    // 首个非空白字符（非注释）：代码行，判定嵌套深度
                    如果 行首缩进 >= 深缩进阈值 && !深缩进已报告 {
                        深缩进已报告 = 真;
                        告警.推入(教学告警 {
                            行号,
                            列号: 行首缩进 + 1,
                            告警种类: 告警类别::嵌套过深,
                            相关文本: 行首缩进.转字符串(),
                            附加文本: 字符串::新建(),
                        });
                    }
                    在行首 = 假;
                }
            }
        }
        如果 当前字符 == '\n' {
            行号 += 1;
            列号 = 1;
            行首缩进 = 0;
            在行首 = 真;
            首个非空白是注释 = 假;
            前普通字符 = '\0';
            如果 字面量状态 == 2 || 字面量状态 == 3 {
                // 防御：字符/原始串内出现未闭合引号时在行尾强制退出，
                // 避免状态污染后续行（编译器本就会报错，此处只为正确判定）
                字面量状态 = 0;
            }
            序号 += 1;
            继续;
        }
        匹配 字面量状态 {
            1 | 2 => {
                // 字符串/字符字面量：转义跳过下一字符，闭合引号退出
                如果 当前字符 == '\\' {
                    序号 += 2;
                    列号 += 1;
                    继续;
                }
                让 闭合符 = 如果 字面量状态 == 1 { '"' } 否则 { '\'' };
                如果 当前字符 == 闭合符 {
                    字面量状态 = 0;
                }
            }
            3 => {
                // 原始字符串 r#"..."#：遇 " 后跟等量 #（或行尾/EOF）退出
                如果 当前字符 == '"' {
                    让 井号数 = 字符切片[序号 + 1..].迭代().取前(|当前| **当前 == '#').计数();
                    如果 井号数 >= 原始井数 {
                        字面量状态 = 0;
                        原始井数 = 0;
                    }
                }
            }
            _ => 匹配 当前字符 {
                '"' => 字面量状态 = 1,
                '\'' => 字面量状态 = 2,
                // 行注释：吞到行尾（\n 留给主循环统一处理）
                '/' 如果 前普通字符 == '/' => {
                    让 注释起点 = 序号;
                    列号 -= 1;
                    当 序号 < 字符切片.长度() && 字符切片[序号] != '\n' {
                        序号 += 1;
                        列号 += 1;
                    }
                    // 注释含「教学忽略」：整行跳过教学警告
                    如果 含忽略标记(&字符切片[注释起点..序号]) {
                        已忽略行集.置入(行号);
                    }
                    前普通字符 = '\0';
                    继续;
                }
                // 块注释（不处理嵌套，够用）
                '*' 如果 前普通字符 == '/' => {
                    列号 -= 1;
                    当 序号 < 字符切片.长度() {
                        让 块内字符 = 字符切片[序号];
                        序号 += 1;
                        如果 块内字符 == '\n' {
                            行号 += 1;
                            列号 = 1;
                        } 否则 如果 块内字符 == '*' && 序号 < 字符切片.长度() && 字符切片[序号] == '/' {
                            序号 += 1;
                            列号 += 2;
                            中断;
                        } 否则 {
                            列号 += 1;
                        }
                    }
                    前普通字符 = '\0';
                    继续;
                }
                // 原始字符串前缀（`r#"…"#` 或 `br#"…"#`：前缀后跟引号或井号）
                'r' | 'b' 如果 是原始前缀(前普通字符) => {
                    让 可变 井号计数 = 0usize;
                    让 可变 位置 = 序号 + 1;
                    当 位置 < 字符切片.长度() && 字符切片[位置] == '#' {
                        井号计数 += 1;
                        位置 += 1;
                    }
                    如果 位置 < 字符切片.长度() && 字符切片[位置] == '"' {
                        原始井数 = 井号计数;
                        字面量状态 = 3;
                        序号 = 位置 + 1;
                        列号 += 1 + 井号计数 + 1;
                        继续;
                    }
                }
                // `让` 关键字：简单标识符绑定时开始未标注类型扫描（前后均须
                // 有标识符边界）；模式解构绑定（元组/结构体/数组/枚举解构、
                // 让-否则、绑定链）不做提示——教学示例均以不标注形式书写，
                // 且无法自然标注类型（须标注整个模式），提示无解成噪音
                '让' 如果 是标识符边界(前普通字符)
                    && (序号 + 1 >= 字符切片.长度() || 是标识符边界(字符切片[序号 + 1])) =>
                {
                    // 前一个绑定语句未闭合（上一语句缺分号）：先收尾
                    完成让扫描(
                        &可变 让扫描状态,
                        &可变 待定列表,
                        歧义构造器,
                        序号,
                    );
                    如果 让 有值(名字) = 简单让绑定名(字符切片, 序号 + 1) {
                        让扫描状态 = 有值(让声明扫描 {
                            行号,
                            列号,
                            名字,
                            已见等号: 假,
                            已标注: 假,
                            初始化原文: 字符串::新建(),
                        });
                    }
                }
                // 数字字面量（前一字不是标识符字符时才是独立字面量）
                当前符 如果 当前符.是数字字符() && 是标识符边界(前普通字符) => {
                    序号 = 扫描数字(字符切片, 序号, 当前符, &可变 告警, 行号, 列号, 前普通字符);
                    继续;
                }
                // 方法调用位的长中文串（如 `.拉平()`）：未命中映射表且与
                // 表内词近似时提示疑似笔误——未命中词会被原样保留，错误在
                // 产物侧才爆发（#14）。仅调用位（后随 `(`）判定以降噪；
                // `..` 范围与浮点（前一字为 `.`/数字）不启动扫描。
                '.' 如果 前普通字符 != '.' && !前普通字符.是数字字符() => {
                    如果 让 有值(名字) = 扫描方法名(字符切片, 序号) {
                        // 惰性分支：首个方法调用位才建索引（无调用位的源码零开销）
                        让 索引 = 匹配 &词索引来源 {
                            词形索引来源::共享(桶) => *桶,
                            词形索引来源::延迟静态值(已知词) => {
                                &*本地索引.插入或用(|| 词形分桶::构建(已知词))
                            }
                        };
                        如果 让 有值(候选) = 易混候选(名字, 索引) {
                            告警.推入(教学告警 {
                                行号,
                                列号: 列号 + 1,
                                告警种类: 告警类别::易混标识符,
                                相关文本: 名字.迭代().收集(),
                                附加文本: 候选.转字符串(),
                            });
                        }
                    }
                }
                _ => {}
            },
        }
        // 绑定扫描推进：仅在代码位置处理语句内符号
        如果 让 有值(扫描) = 让扫描状态.作为可变引用方法() {
            匹配 当前字符 {
                ':' 如果 !扫描.已见等号 => 扫描.已标注 = 真,
                '=' => 扫描.已见等号 = 真,
                ';' | '{' | '}' => 完成让扫描(
                    &可变 让扫描状态,
                    &可变 待定列表,
                    歧义构造器,
                    序号,
                ),
                _ 如果 扫描.已见等号 => 扫描.初始化原文.推入(当前字符),
                _ => {}
            }
        }
        序号 += 1;
        列号 += 1;
        如果 当前字符 != ' ' && 当前字符 != '\t' && 字面量状态 == 0 {
            前普通字符 = 当前字符;
        }
    }
    完成让扫描(
        &可变 让扫描状态,
        &可变 待定列表,
        歧义构造器,
        字符切片.长度(),
    );
    // 绑定名在语句之后仍被引用 → 类型由使用处推导，不提示；只在后续无
    // 任何引用的位置提示（真歧义仍由 rustc E0282 兜底）
    对于 待定 在 待定列表 {
        如果 !后续有使用(字符切片, 待定.之后位置, &待定.名字) {
            告警.推入(教学告警 {
                行号: 待定.行号,
                列号: 待定.列号,
                告警种类: 告警类别::未标注类型,
                相关文本: 字符串::新建(),
                附加文本: 字符串::新建(),
            });
        }
    }
    // 过滤被「教学忽略」标记的行（三种规则统一按行过滤）
    告警.保留(|告警项| !已忽略行集.包含(&告警项.行号));
    // 未标注类型提示延后产出，统一按位置排序保持「升序」契约
    告警.按键排序(|告警项| (告警项.行号, 告警项.列号));
    告警
}

/// 声明关键字：其后紧跟的名字视为用户命名，回落检查豁免不提示
常量 声明关键字表: &[&文本] = &[
    "fn", "let", "struct", "enum", "union", "trait", "type", "mod", "impl", "const", "static",
];

/// Rust 保留关键字：不可能作为自定义标识符，出现英文且有母语词条即回落提示
常量 保留关键字表: &[&文本] = &[
    "as", "async", "await", "break", "const", "continue", "crate", "dyn", "else", "enum", "extern",
    "false", "fn", "for", "if", "impl", "in", "let", "loop", "match", "mod", "move", "mut", "pub",
    "ref", "return", "self", "Self", "static", "struct", "super", "trait", "true", "type",
    "unsafe", "use", "where", "while", "yield",
];

/// 声明引导词的英文映射值：其后紧跟的名字是「被声明的标识符」，
/// 而非语句词（`返回`/`匹配` 作普通语句时不按撞名判定）。
常量 声明引导词表: &[&文本] = &[
    "fn", "let", "const", "static", "struct", "enum", "union", "type", "trait", "impl", "mod",
];

/// 英文回退检查：在母语方言源码中提示「有母语词条却写成英文」的结构词
///
/// `英文回退表`：英文原词 → 母语词条（见
/// [`包::映射管理器::映射管理器::英文回退表`]）；恒等映射的
/// 英文语言包传入空表，本函数直接返回空（自动静默，不误伤英文原生写法）。
///
/// 只在**结构位置**判定以降噪（避免把同名自定义变量/字段误报）：
/// - Rust 保留关键字（`fn 主()`、`让 名`、`匹配 值 {…}`…）任意代码位出现即提示（保留字不可能是自定义名）；
/// - 宏调用 `词!`、方法/关联函数调用 `.词(` / `::词(`、路径头 `词::`、泛型 `词<`——
///   这些位置的英文词有母语词条时提示。
///
/// 声明关键字（`fn 主()`、`让 名`、`结构体 名`…）后紧跟的名字视为用户命名，豁免不提示；
/// 同一英文词每文件只在首个命中处提示一次（避免同一英文词反复刷屏）。字符串/字符/
/// 原始串/注释内的英文由状态机跳过，与其余教学检查同构；行注释含「教学忽略」跳过整行。
公开 函数 检查英文回退(
    源码: &文本,
    英文回退表: &哈希映射<字符串, 字符串>,
) -> 向量<教学告警> {
    如果 英文回退表.是否为空() {
        返回 向量::新建();
    }
    让 字符切片: 向量<字符> = 源码.逐字符().收集();
    检查英文回退字符(&字符切片, 英文回退表)
}

/// 英文回退与保留名撞词的共用扫描：一次遍历产出两组警告
///
/// 两个检查原先各有一套同构状态机（跳过字符串/字符/原始串/注释、按标识符
/// 边界取词元、识别 `r"…"` 前缀、收集「教学忽略」行），同一份源码要扫两趟
/// （大文件里两趟骨架状态机约 22 µs）。合并后标识符只提取一次（复用同一个
/// 单词缓冲，不再逐词元分配字符串），词表各查一次；任一侧传 `无`
/// 或空表时该侧判定整体跳过。
///
/// 两侧原有的语义差异逐条保留：
/// - `前普通字符`（跳过空白，供 `.词(` / `::词(` 判定）只服务英文回退，
///   `等待名字`（遇非空白即清）只服务撞名；
/// - 声明关键字后的名字只豁免英文回退（`声明之后`），不影响撞名；
/// - 英文回退只看 ASCII 段（中文名后接英文的混合标识符不判定），撞名看完整词元；
/// - 注释起始改按 `前字符 == '/'`（两字符相邻）判定：英文回退原先用
///   `前普通字符`（跳过空白），会把 `a / *b` 里的 `*` 误当块注释起点。
公开(包) 函数 检查英文与撞词字符(
    字符切片: &[字符],
    英文回退表: 选项<&哈希映射<字符串, 字符串>>,
    关键字映射: 选项<&哈希映射<字符串, 字符串>>,
) -> (向量<教学告警>, 向量<教学告警>) {
    让 英文回退表 = 英文回退表.过滤(|映射| !映射.是否为空());
    让 关键字映射 = 关键字映射.过滤(|映射| !映射.是否为空());
    让 可变 英文告警 = 向量::新建();
    让 可变 撞词告警 = 向量::新建();
    如果 英文回退表.是否为无() && 关键字映射.是否为无() {
        返回 (英文告警, 撞词告警);
    }

    // 同一英文词每文件只报首个命中（避免同一英文词反复刷屏）
    让 可变 已报告: 哈希集合<字符串> = 哈希集合::新建();
    // 行注释含「教学忽略」的行号：整行跳过两侧警告
    让 可变 已忽略行集: 哈希集合<无符号机器整数> = 哈希集合::新建();
    让 可变 行号 = 1usize;
    让 可变 列号 = 1usize;
    // 字面量状态：0=代码 1=双引号串 2=字符 3=原始串
    让 可变 字面量状态: 字节 = 0;
    让 可变 原始井数 = 0usize;
    让 可变 前字符 = '\0'; // 紧邻前一个字符（含空白），用于标识符边界与注释判定
    让 可变 前普通字符 = '\0'; // 上一个非空白代码字符
    让 可变 前前普通字符 = '\0'; // 前普通字符的前一个非空白代码字符
    让 可变 声明之后 = 假; // 上一标识符是声明关键字：其后的名字豁免
    // 刚读到声明引导词（或 `让 可变` 的修饰词），等待其后的名字
    让 可变 等待名字 = 假;
    // 单词缓冲：复用避免每个标识符都分配一个字符串（大文件扫描热点）
    让 可变 词缓冲 = 字符串::带容量(16);

    让 可变 序号 = 0usize;
    当 序号 < 字符切片.长度() {
        让 当前字符 = 字符切片[序号];
        如果 当前字符 == '\n' {
            行号 += 1;
            列号 = 1;
            如果 字面量状态 == 2 || 字面量状态 == 3 {
                // 字符/原始串内未闭合引号：行尾强制退出，避免状态污染后续行
                字面量状态 = 0;
            }
            前字符 = '\n';
            序号 += 1;
            继续;
        }
        匹配 字面量状态 {
            1 | 2 => {
                如果 当前字符 == '\\' {
                    序号 += 2;
                    列号 += 1;
                    前字符 = '\\';
                    继续;
                }
                让 闭合符 = 如果 字面量状态 == 1 { '"' } 否则 { '\'' };
                如果 当前字符 == 闭合符 {
                    字面量状态 = 0;
                }
            }
            3 => {
                // 原始串 r#"..."#：遇 " 后跟等量 # 退出
                如果 当前字符 == '"' {
                    让 井号数 = 字符切片[序号 + 1..].迭代().取前(|当前| **当前 == '#').计数();
                    如果 井号数 >= 原始井数 {
                        字面量状态 = 0;
                        原始井数 = 0;
                    }
                }
            }
            _ => 匹配 当前字符 {
                '"' => 字面量状态 = 1,
                '\'' => 字面量状态 = 2,
                '/' 如果 前字符 == '/' => {
                    // 行注释：吞到行尾；含「教学忽略」标记整行
                    让 注释起点 = 序号;
                    当 序号 < 字符切片.长度() && 字符切片[序号] != '\n' {
                        序号 += 1;
                        列号 += 1;
                    }
                    如果 含忽略标记(&字符切片[注释起点..序号]) {
                        已忽略行集.置入(行号);
                    }
                    前字符 = '\0';
                    前普通字符 = '\0';
                    前前普通字符 = '\0';
                    等待名字 = 假;
                    继续;
                }
                '*' 如果 前字符 == '/' => {
                    // 块注释（不处理嵌套，够用）
                    当 序号 < 字符切片.长度() {
                        让 块内字符 = 字符切片[序号];
                        序号 += 1;
                        如果 块内字符 == '\n' {
                            行号 += 1;
                            列号 = 1;
                        } 否则 如果 块内字符 == '*' && 序号 < 字符切片.长度() && 字符切片[序号] == '/' {
                            序号 += 1;
                            列号 += 2;
                            中断;
                        } 否则 {
                            列号 += 1;
                        }
                    }
                    前字符 = '\0';
                    前普通字符 = '\0';
                    前前普通字符 = '\0';
                    等待名字 = 假;
                    继续;
                }
                当前符 如果 是标识符延续(当前符) && 是标识符边界(前字符) => {
                    让 起始行 = 行号;
                    让 起始列 = 列号;
                    让 可变 结束位置 = 序号;
                    当 结束位置 < 字符切片.长度() && 是标识符延续(字符切片[结束位置]) {
                        结束位置 += 1;
                    }
                    词缓冲.清空集合();
                    词缓冲.扩展(字符切片[序号..结束位置].迭代());
                    // 原始串前缀（`r#"…"#` 或 `br#"…"#`）：转入字面量状态，两侧都不参与判定
                    如果 模式匹配!(词缓冲.作为文本切片(), "r" | "b" | "br") {
                        让 可变 井号量 = 0usize;
                        让 可变 探位 = 结束位置;
                        当 探位 < 字符切片.长度() && 字符切片[探位] == '#' {
                            井号量 += 1;
                            探位 += 1;
                        }
                        如果 探位 < 字符切片.长度() && 字符切片[探位] == '"' {
                            如果 词缓冲 == "b" && 井号量 == 0 {
                                字面量状态 = 1; // 字节串 b"..."：转义规则同普通串
                            } 否则 {
                                字面量状态 = 3;
                                原始井数 = 井号量;
                            }
                            列号 += 探位 + 1 - 序号;
                            序号 = 探位 + 1;
                            前字符 = '"';
                            前普通字符 = '"';
                            前前普通字符 = '\0';
                            声明之后 = 假;
                            等待名字 = 假;
                            继续;
                        }
                    }
                    // 词元后首个非空白字符及其后继：撞名的声明定界符与英文回退的
                    // 结构位置共用同一次前瞻
                    让 可变 后位 = 结束位置;
                    当 后位 < 字符切片.长度() && 字符切片[后位].是否为空白() {
                        后位 += 1;
                    }
                    让 下个字符 = 字符切片.截取(后位).复制值();
                    如果 让 有值(映射) = 英文回退表
                        && (当前字符.是ASCII字母() || 当前字符 == '_')
                    {
                        // 前导 ASCII 段即英文词元：字节数等于字符数，可直接切片查表
                        让 可变 英文末 = 序号;
                        当 英文末 < 结束位置
                            && (字符切片[英文末].是ASCII字母数字() || 字符切片[英文末] == '_')
                        {
                            英文末 += 1;
                        }
                        让 词元 = &词缓冲[..英文末 - 序号];
                        // 混合标识符：英文回退的前瞻从其 ASCII 段末尾算起
                        让 (回退下个, 回退下下个) = 如果 英文末 == 结束位置 {
                            (下个字符, 字符切片.截取(后位 + 1).复制值())
                        } 否则 {
                            让 可变 混合位 = 英文末;
                            当 混合位 < 字符切片.长度() && 字符切片[混合位].是否为空白() {
                                混合位 += 1;
                            }
                            (字符切片.截取(混合位).复制值(), 字符切片.截取(混合位 + 1).复制值())
                        };
                        让 后随调用 = 回退下个 == 有值('(');
                        让 后随泛型 = 回退下个 == 有值('<');
                        让 后随路径 = 回退下个 == 有值(':') && 回退下下个 == 有值(':');
                        让 后随宏 = 回退下个 == 有值('!');
                        让 前有句点 = 前普通字符 == '.';
                        让 前有双冒号 = 前普通字符 == ':' && 前前普通字符 == ':';
                        让 是声明关键字 = 声明关键字表.包含(&词元);
                        // 声明关键字后的用户命名（声明之后）豁免不提示；
                        // 其余按结构位置判定
                        如果 !声明之后 && 让 有值(原生) = 映射.截取(词元) {
                            让 结构位置 = 保留关键字表.包含(&词元)
                                || 后随宏
                                || (后随调用 && (前有句点 || 前有双冒号))
                                || 后随路径
                                || 后随泛型;
                            如果 结构位置 && 已报告.置入(词元.转字符串()) {
                                英文告警.推入(教学告警 {
                                    行号: 起始行,
                                    列号: 起始列,
                                    告警种类: 告警类别::英文回退,
                                    相关文本: 词元.转字符串(),
                                    附加文本: 原生.克隆值(),
                                });
                            }
                        }
                        // 混合标识符的后半段等同逐字符走过：豁免随之中断
                        声明之后 = 是声明关键字 && 英文末 == 结束位置;
                    } 否则 {
                        // 非英文起头的词元（中文名/数字）：等同逐字符走完后清除豁免
                        声明之后 = 假;
                    }
                    如果 让 有值(映射) = 关键字映射 {
                        // 单次查表同时服务三种判定（不派生临时集合）：
                        // `可变` 修饰词 / 撞名候选 / 声明引导词
                        让 映射结果 = 映射.截取(词缓冲.作为文本切片()).映射(字符串::作为文本切片);
                        如果 等待名字 {
                            // `让 可变 名字`：跨过修饰词，继续等待名字
                            如果 映射结果 != 有值("mut") {
                                如果 让 有值(英文) = 映射结果
                                    && 保留关键字表.包含(&英文)
                                    && 模式匹配!(下个字符, 有值('(' | '{' | ';' | '=' | '<' | ':' | ','))
                                {
                                    撞词告警.推入(教学告警 {
                                        行号: 起始行,
                                        列号: 起始列,
                                        告警种类: 告警类别::保留名撞词,
                                        相关文本: 词缓冲.克隆值(),
                                        附加文本: 英文.转字符串(),
                                    });
                                }
                                等待名字 = 假;
                            }
                        } 否则 如果 让 有值(英文) = 映射结果
                            && 声明引导词表.包含(&英文)
                        {
                            等待名字 = 真;
                        }
                    }
                    让 末字符 = 字符切片[结束位置 - 1];
                    列号 += 结束位置 - 序号;
                    序号 = 结束位置;
                    前字符 = 末字符;
                    前前普通字符 = 前普通字符;
                    前普通字符 = 末字符;
                    继续;
                }
                _ => {}
            },
        }
        // 普通字符推进：非空白才更新前普通字符（用于 . 与 :: 判定）并清除命名豁免
        如果 !(当前字符 == ' ' || 当前字符 == '\t' || 当前字符 == '\r') {
            声明之后 = 假;
            前前普通字符 = 前普通字符;
            前普通字符 = 当前字符;
        }
        如果 !当前字符.是否为空白() {
            等待名字 = 假;
        }
        前字符 = 当前字符;
        序号 += 1;
        列号 += 1;
    }
    英文告警.保留(|告警项| !已忽略行集.包含(&告警项.行号));
    撞词告警.保留(|告警项| !已忽略行集.包含(&告警项.行号));
    (英文告警, 撞词告警)
}

/// 保留名撞词检查：声明位（`函数`/`让`/`结构体`… 之后的名字）若命中关键字
/// 词条且其英文映射是 Rust 保留关键字，转译会把用户名字改写成保留字，产物
/// 非法（`fn match`）或语义改写（`让 循环`→`let loop`）——这是转译管线唯一
/// 的静默语义改写路径。此处提示并给出修复方向：改名，或将产物中的该名字
/// 用 `r#` 原始标识符转义。
///
/// `关键字映射`：母语 → 英文的关键字映射（见
/// [`包::映射管理器::映射管理器::取关键字映射`]）。声明引导词
/// 与撞名候选均直接从该表查（不派生临时集合：本函数在 LSP 每次变更都会
/// 跑一遍，过早建哈希集合会白付 600+ 次哈希）；`可变`（可变修饰词）作为 `让` 的
/// 修饰词可跨过后再判定名字。判定要求名字后紧跟声明定界符
/// （`(` `{` `;` `=` `<` `:` `,`），`返回`/`匹配` 作普通语句词时不提示。
/// 字符串/字符/原始串/注释内容由状态机跳过；含「教学忽略」的行整行跳过。
公开 函数 检查保留名撞词(
    源码: &文本,
    关键字映射: &哈希映射<字符串, 字符串>,
) -> 向量<教学告警> {
    如果 关键字映射.是否为空() {
        返回 向量::新建();
    }

    让 字符切片: 向量<字符> = 源码.逐字符().收集();
    检查保留名撞词字符(&字符切片, 关键字映射)
}

/// [`检查英文回退`] 的字符切片入口（只跑英文回退一侧）
///
/// 与撞名检查共用的扫描见 [`检查英文与撞词字符`]：同一份源码
/// 只需一组状态机。
公开(包) 函数 检查英文回退字符(
    字符切片: &[字符],
    英文回退表: &哈希映射<字符串, 字符串>,
) -> 向量<教学告警> {
    检查英文与撞词字符(字符切片, 有值(英文回退表), 无).0
}

/// [`检查保留名撞词`] 的字符切片入口（只跑撞名一侧）
公开(包) 函数 检查保留名撞词字符(
    字符切片: &[字符],
    关键字映射: &哈希映射<字符串, 字符串>,
) -> 向量<教学告警> {
    检查英文与撞词字符(字符切片, 无, 有值(关键字映射)).1
}

/// 一次扫描产出全部教学检查警告（顺序：教学 / 英文回退 / 保留名撞词）
///
/// 走转译管线的调用方（CLI 转译、LSP 每次变更）用这个入口：源码只物化一次
/// 字符切片，五个扫描器共用；英文回退与撞名合并为单次遍历，状态机由三趟
/// 降到两趟。各表口径与单函数版本一致，空表即该侧静默。
公开 函数 检查全部教学(
    源码: &文本,
    已知词表: &哈希集合<字符串>,
    歧义构造器: &哈希集合<字符串>,
    英文回退表: &哈希映射<字符串, 字符串>,
    关键字映射: &哈希映射<字符串, 字符串>,
) -> 向量<教学告警> {
    让 字符切片: 向量<字符> = 源码.逐字符().收集();
    检查全部教学字符(
        &字符切片,
        词形索引来源::延迟静态值(已知词表),
        歧义构造器,
        英文回退表,
        关键字映射,
    )
}

/// [`检查全部教学`] 的字符切片入口
///
/// 转译管线已经物化过一份字符切片，直接从这里进，不再展开一次源码。
/// `词索引来源` 为易混方法名的索引来源：管线路径传
/// [`词形索引来源::共享`]（每语言包建一次，见
/// [`包::映射管理器::映射管理器::检查词形桶`]）。
公开(包) 函数 检查全部教学字符(
    字符切片: &[字符],
    词索引来源: 词形索引来源<'_>,
    歧义构造器: &哈希集合<字符串>,
    英文回退表: &哈希映射<字符串, 字符串>,
    关键字映射: &哈希映射<字符串, 字符串>,
) -> 向量<教学告警> {
    让 可变 告警 = 检查教学字符(字符切片, 词索引来源, 歧义构造器);
    让 (英文告警, 撞词告警) =
        检查英文与撞词字符(字符切片, 有值(英文回退表), 有值(关键字映射));
    告警.扩展(英文告警);
    告警.扩展(撞词告警);
    告警
}

/// [`检查全部教学`] 的分桶索引入口（调用方已缓存索引）
///
/// 与 [`按词形桶检查字符`] 对称：LSP 每次发布诊断都要重算
/// 教学提示，索引随语言包确定后不可变，应由
/// [`包::映射管理器::映射管理器::检查词形桶`] 建一次、
/// 此后每份文档直接复用（惰性入口每份源码重建一次分桶与精确命中表）。
公开 函数 按词形桶检查全部教学字符(
    字符切片: &[字符],
    词形桶: &词形分桶,
    歧义构造器: &哈希集合<字符串>,
    英文回退表: &哈希映射<字符串, 字符串>,
    关键字映射: &哈希映射<字符串, 字符串>,
) -> 向量<教学告警> {
    检查全部教学字符(
        字符切片,
        词形索引来源::共享(词形桶),
        歧义构造器,
        英文回退表,
        关键字映射,
    )
}

/// 教学忽略标记：行注释含此文本时该行跳过全部教学警告
公开 常量 忽略标记: &文本 = "教学忽略";

/// 字符切片里是否含 [`忽略标记`] 标记
///
/// 逐字符比较，不为行注释构造临时字符串——教程模板几乎每行都有注释，
/// 逐行一次的分配在批量转译里是纯浪费。
函数 含忽略标记(字符切片: &[字符]) -> 布尔 {
    让 标记长度 = 忽略标记.逐字符().计数();
    字符切片.长度() >= 标记长度
        && 字符切片
            .窗口(标记长度)
            .任意(|窗口| 忽略标记.逐字符().相等方法(窗口.迭代().复制值()))
}

/// 嵌套深度阈值：前导缩进 ≥ 此空格数时提示（24 = 6 层，4 空格一层）
常量 深缩进阈值: 无符号机器整数 = 24;

/// 判定字符是否可作为标识符边界（非字母/数字/下划线即边界）
函数 是标识符边界(字符值: 字符) -> 布尔 {
    !是标识符延续(字符值)
}

/// 判定前一字符是否可作为原始字符串前缀（`r#"…"#` 或 `br#"…"#`：前一字为行首/空白/运算符）
函数 是原始前缀(前一字符: 字符) -> 布尔 {
    前一字符 == '\0' || 前一字符.是否为空白() || "([{<,;:!?&|=+-*/%^".包含(前一字符)
}

/// 判定 `让` 后的绑定是否为简单标识符绑定（`名字` / `可变 名字`），是则返回绑定名
///
/// `起始下标` 为「让」之后的下标。仅简单绑定参与「未标注类型」提示；
/// 模式解构绑定（`(甲, 乙)`、`点 { x, y }`、`[首, 次]`、`有值(数)`、
/// `枚举::变体(数)` 等）返回 `无`——这类绑定须标注整个模式的类型
/// （远超初学者范围），教程示例均不标注，提示无解且成噪音。
///
/// 无法归类的形态（如语法错误、注释紧跟）一律返回 `无`（宁缺毋滥）。
函数 简单让绑定名(字符切片: &[字符], 起始下标: 无符号机器整数) -> 选项<字符串> {
    让 可变 位置 = 起始下标;
    // 跳过空白（含换行：多行布局不影响绑定判定）
    当 位置 < 字符切片.长度() && 字符切片[位置].是否为空白() {
        位置 += 1;
    }
    // 可选「可变」前缀（`让 可变 名字 = …`；须为独立词）
    如果 以词开头(字符切片, 位置, "可变") {
        位置 += "可变".逐字符().计数();
        当 位置 < 字符切片.长度() && 字符切片[位置].是否为空白() {
            位置 += 1;
        }
    }
    // 绑定首字符须为标识符字符：`(`/`[`/`{` 等模式起始一律排除
    如果 位置 >= 字符切片.长度() || !是标识符延续(字符切片[位置]) {
        返回 无;
    }
    // 收集标识符（到名字结束），再跳过名字与后续符号之间的空白
    让 可变 结束位置 = 位置;
    当 结束位置 < 字符切片.长度() && 是标识符延续(字符切片[结束位置]) {
        结束位置 += 1;
    }
    让 名字 = 字符切片[位置..结束位置].迭代().收集::<字符串>();
    当 结束位置 < 字符切片.长度() && 字符切片[结束位置].是否为空白() {
        结束位置 += 1;
    }
    匹配 字符切片.截取(结束位置) {
        // `名字 = …` / `名字;`（语法错，交给编译器）：简单绑定
        有值('=' | ';') => 有值(名字),
        有值(':') => {
            // 单个 `:` 是类型标注（`名字: 类型 = …`）；`::` 是路径
            // （`枚举::变体(数)` 模式）——后者非简单绑定
            如果 模式匹配!(字符切片.截取(结束位置 + 1), 有值(':')) {
                无
            } 否则 {
                有值(名字)
            }
        }
        // `名字(` / `名字 {` 等模式、行尾、无法归类的形态：不提示
        _ => 无,
    }
}

/// 判断 `字符切片[位置..]` 是否以独立词 `词` 开头（词后不能紧跟标识符续字符）
函数 以词开头(字符切片: &[字符], 位置: 无符号机器整数, 词: &文本) -> 布尔 {
    让 目标: 向量<字符> = 词.逐字符().收集();
    如果 位置 + 目标.长度() > 字符切片.长度() || 字符切片[位置..位置 + 目标.长度()] != 目标[..] {
        返回 假;
    }
    !模式匹配!(字符切片.截取(位置 + 目标.长度()), 有值(当前) 如果 是标识符延续(*当前))
}

/// 收尾进行中的 `让` 扫描：无类型注解且初始化式类型无法自行推导时，
/// 记入候选（最终是否提示还要看绑定名在语句之后有没有引用）
函数 完成让扫描(
    让扫描状态: &可变 选项<让声明扫描>,
    待定列表: &可变 向量<待标注类型>,
    歧义构造器: &哈希集合<字符串>,
    之后位置: 无符号机器整数,
) {
    如果 让 有值(扫描) = 让扫描状态.取()
        && !扫描.已标注
        && 初始化需标注(&扫描.初始化原文, 歧义构造器)
    {
        待定列表.推入(待标注类型 {
            名字: 扫描.名字,
            行号: 扫描.行号,
            列号: 扫描.列号,
            之后位置,
        });
    }
}

/// 判定初始化式是否属于「类型无法自行推导、需要显式注解」的歧义形态
///
/// Rust 的局部变量类型绝大多数可由初始化式推导（字面量、普通函数/方法
/// 调用、宏、结构体/元组/数组、路径引用、块与控制流表达式）；仅少数
/// 构造的结果类型依赖使用处，rustc 会以 E0282（需要类型注解）
/// 要求注解。教学提示只在这些位置才有建设性：
/// - 无显式泛型的歧义关联构造器：`X::new()`、`X::default()`
///   （`X` 是任意路径段，含方言写法 `向量::新建()`——翻译后判定）；
/// - 无显式泛型的 `.collect()` 收集（目标集合类型未知）。
///
/// 纯词法启发式（与扫描器同构，不做语法分析）；无法归类时保守不报告。
/// 后续使用能补全类型（`让 v = 向量::新建(); v.推入(1);`）的绑定由
/// [`后续有使用`] 排除；真歧义自有 rustc E0282 兜底。
函数 初始化需标注(初始化原文: &文本, 歧义构造器: &哈希集合<字符串>) -> 布尔 {
    让 原文 = 初始化原文.裁剪();
    如果 原文.是否为空() {
        返回 假;
    }
    // 去空白紧致形式（允许跨行/任意空格布局）
    让 紧凑式: 字符串 = 原文.逐字符().过滤(|当前| !当前.是否为空白()).收集();
    // 显式泛型 `::<类型>` 已给出类型，不再歧义
    如果 紧凑式.包含("::<") {
        返回 假;
    }
    // `值.collect()`（含方法链前缀）：目标集合类型未知
    如果 紧凑式.以结尾(".collect()") {
        返回 真;
    }
    // 首个调用的被调名：取第一个 '(' 前的标识符末段
    // 宏调用（'(' 紧邻 '!'，如 `向量![]`、`打印行!()`）跳过
    让 有值(左括号位) = 紧凑式.查找('(') 否则 {
        返回 假;
    };
    如果 左括号位 > 0 && 紧凑式.转为字节()[左括号位 - 1] == b'!' {
        返回 假;
    }
    让 之前段 = &紧凑式[..左括号位];
    // 路径末段（:: 之后），否则整段即被调名
    让 末段 = 之前段.逆分割("::").下一个().取值或(之前段);
    // 仅关联函数（路径含 ::）的歧义构造器提示；集合含英文 new/default
    // 与其各方言映射词（如「新建」「缺省」）；裸调用 `新建()` 不提示
    之前段.包含("::") && 歧义构造器.包含(末段)
}

/// 绑定名在语句结束之后是否仍被代码引用（字符串/注释/字段访问/路径段不计）
///
/// 局部变量类型推断是整函数级别的：`让 可变 v = 向量::新建();` 之后的
/// `v.推入(路径)` 就把元素类型定成 `路径`，rustc 不再要求注解。这里只做
/// 「后面还出现过这个名字」的保守判定——仍可能无解的使用（如仅 `v.长度()`）
/// 由编译器 E0282 兜底；宁可少提示一条，也不误报。
函数 后续有使用(字符切片: &[字符], 起始下标: 无符号机器整数, 名字: &文本) -> 布尔 {
    让 目标: 向量<字符> = 名字.逐字符().收集();
    让 长度 = 目标.长度();
    如果 长度 == 0 || 起始下标 >= 字符切片.长度() {
        返回 假;
    }
    // 代码位置的标识符出现：前后须为边界，且不是 `对象.名字` / `路径::名字`
    让 在该处匹配 = |位置: 无符号机器整数| {
        字符切片[位置] == 目标[0]
            && 位置 + 长度 <= 字符切片.长度()
            && 字符切片[位置..位置 + 长度] == 目标[..]
            && (位置 == 0 || 是标识符边界(字符切片[位置 - 1]))
            && 字符切片.截取(位置 + 长度).是否为无或(|当前| 是标识符边界(*当前))
            && !(位置 > 0 && 字符切片[位置 - 1] == '.')
            && !(位置 >= 2 && 字符切片[位置 - 1] == ':' && 字符切片[位置 - 2] == ':')
    };
    让 可变 序号 = 起始下标;
    让 可变 字面量状态: 字节 = 0; // 1 = 双引号串 2 = 字符
    当 序号 < 字符切片.长度() {
        让 当前字符 = 字符切片[序号];
        匹配 字面量状态 {
            1 => {
                如果 当前字符 == '\\' {
                    序号 += 2;
                    继续;
                }
                如果 当前字符 == '"' {
                    字面量状态 = 0;
                }
                序号 += 1;
                继续;
            }
            _ 如果 字面量状态 == 2 => {
                如果 当前字符 == '\\' {
                    序号 += 2;
                    继续;
                }
                如果 当前字符 == '\'' {
                    字面量状态 = 0;
                }
                序号 += 1;
                继续;
            }
            _ => {}
        }
        // 行注释
        如果 当前字符 == '/' && 字符切片.截取(序号 + 1) == 有值(&'/') {
            当 序号 < 字符切片.长度() && 字符切片[序号] != '\n' {
                序号 += 1;
            }
            继续;
        }
        // 块注释（不处理嵌套，与主扫描器同构）
        如果 当前字符 == '/' && 字符切片.截取(序号 + 1) == 有值(&'*') {
            序号 += 2;
            当 序号 + 1 < 字符切片.长度() && !(字符切片[序号] == '*' && 字符切片[序号 + 1] == '/') {
                序号 += 1;
            }
            序号 = (序号 + 2).最小(字符切片.长度());
            继续;
        }
        如果 当前字符 == '"' {
            字面量状态 = 1;
            序号 += 1;
            继续;
        }
        // 区分字符字面量 `'x'` 与生命周期 `'甲`：只有闭合成对的才进字符状态
        如果 当前字符 == '\'' && (字符切片.截取(序号 + 1) == 有值(&'\\') || 字符切片.截取(序号 + 2) == 有值(&'\'')) {
            字面量状态 = 2;
            序号 += 1;
            继续;
        }
        如果 在该处匹配(序号) {
            返回 真;
        }
        序号 += 1;
    }
    假
}

/// 数字字面量扫描：返回结束位置（序号应前进到的下标）
///
/// 跳过 0x/0b/0o 前缀字面量；解析十进制（含小数点/科学计数法/下划线），
/// 值属于平凡集合（0/1/2 及其负数）时不报告。
函数 扫描数字(
    字符切片: &[字符],
    起始位置: 无符号机器整数,
    首字符: 字符,
    告警: &可变 向量<教学告警>,
    行号: 无符号机器整数,
    列号: 无符号机器整数,
    前普通字符: 字符,
) -> 无符号机器整数 {
    让 可变 序号 = 起始位置;
    // 0x/0b/0o 前缀：跳过整个字面量（教学场景罕见，不提示）
    如果 首字符 == '0' && 序号 + 1 < 字符切片.长度() && 模式匹配!(字符切片[序号 + 1], 'x' | 'b' | 'o') {
        序号 += 2;
        当 序号 < 字符切片.长度()
            && (字符切片[序号].是ASCII字母数字() || 字符切片[序号] == '_')
        {
            序号 += 1;
        }
        返回 序号;
    }
    让 数字起点 = 序号;
    // 整数部分：[0-9_]+
    当 序号 < 字符切片.长度() && (字符切片[序号].是数字字符() || 字符切片[序号] == '_') {
        序号 += 1;
    }
    // 小数部分：. + [0-9_]+
    如果 序号 + 1 < 字符切片.长度() && 字符切片[序号] == '.' && 字符切片[序号 + 1].是数字字符() {
        序号 += 1;
        当 序号 < 字符切片.长度() && (字符切片[序号].是数字字符() || 字符切片[序号] == '_') {
            序号 += 1;
        }
    }
    // 科学计数法：指数标记后跟可选正负号与数字位
    如果 序号 < 字符切片.长度() && 模式匹配!(字符切片[序号], 'e' | 'E') {
        让 可变 位置 = 序号 + 1;
        如果 位置 < 字符切片.长度() && 模式匹配!(字符切片[位置], '+' | '-') {
            位置 += 1;
        }
        如果 位置 < 字符切片.长度() && 字符切片[位置].是数字字符() {
            序号 = 位置;
            当 序号 < 字符切片.长度() && (字符切片[序号].是数字字符() || 字符切片[序号] == '_') {
                序号 += 1;
            }
        }
    }
    // 后随标识符字符（如 `42abc`）：非法代码，交给编译器，不提示
    如果 序号 < 字符切片.长度() && 是标识符延续(字符切片[序号]) {
        返回 序号;
    }
    让 文本值: 字符串 = 字符切片[数字起点..序号].迭代().收集();
    // 平凡值排除：0/1/2（含浮点形式）与前导负号（-1/-2 等常见常量）
    让 清理后: 字符串 = 文本值.逐字符().过滤(|当前| *当前 != '_').收集();
    让 是平凡值 = 清理后
        .解析::<浮点数>()
        .成功且(|数值| 数值 == 0.0 || 数值 == 1.0 || 数值 == 2.0);
    如果 是平凡值 || 前普通字符 == '-' {
        返回 序号;
    }
    告警.推入(教学告警 {
        行号,
        列号,
        告警种类: 告警类别::魔法数字,
        相关文本: 文本值,
        附加文本: 字符串::新建(),
    });
    序号
}

/// 标识符续字符（数字后跟这些字符视为同一标识符）
///
/// 快路径：ASCII 与 CJK 统一表意文字直接判定——`char::is_alphanumeric`
/// 要走 Unicode 通用类别查询，在教学扫描里占单字符开销的大头；这两类
/// 字符已占方言源码绝大多数。其余文字（假名/谚文/西里尔/阿拉伯…）回落
/// 标准判定，语义与 `c.is_alphanumeric() || c == '_'` 完全一致。
函数 是标识符延续(字符值: 字符) -> 布尔 {
    让 码位 = 字符值 作为 无符号整数;
    如果 码位 < 128 {
        标识符字符表[码位 作为 无符号机器整数]
    } 否则 {
        是中日韩字符(字符值) || 字符值.是否为字母数字()
    }
}

/// 标识符字符表（字母/数字/下划线）：扫描器对每个字符都问一次，
/// 查表比三次区间比较少两次分支
静态 标识符字符表: [布尔; 128] = {
    让 可变 指示表 = [假; 128];
    让 可变 序号 = 0;
    当 序号 < 128 {
        指示表[序号] = (序号 >= b'0' 作为 无符号机器整数 && 序号 <= b'9' 作为 无符号机器整数)
            || (序号 >= b'A' 作为 无符号机器整数 && 序号 <= b'Z' 作为 无符号机器整数)
            || (序号 >= b'a' 作为 无符号机器整数 && 序号 <= b'z' 作为 无符号机器整数)
            || 序号 == b'_' 作为 无符号机器整数;
        序号 += 1;
    }
    指示表
};

/// 判定字符是否属于 CJK 统一表意文字（基本区 + 扩展 A）
函数 是中日韩字符(字符值: 字符) -> 布尔 {
    模式匹配!(字符值, '\u{4E00}'..='\u{9FFF}' | '\u{3400}'..='\u{4DBF}')
}

/// 前瞻扫描 `.` 后的方法名：收集连续 CJK 字符（如 `拉平`），
/// 名字与 `(` 之间允许空格/tab；只有最终跟 `(`（调用位）才返回名字。
/// 名字含 ASCII/假名等其他字符（如 `拉平_所有`、字段访问）时不判定。
///
/// 返回字符切片而非字符串：调用位可能极多，只有真的命中笔误才需要转成文本。
函数 扫描方法名(字符切片: &[字符], 点: 无符号机器整数) -> 选项<&[字符]> {
    让 可变 位置 = 点 + 1;
    当 位置 < 字符切片.长度() && 是中日韩字符(字符切片[位置]) {
        位置 += 1;
    }
    如果 位置 == 点 + 1 {
        返回 无;
    }
    让 可变 结束位置 = 位置;
    当 结束位置 < 字符切片.长度() && (字符切片[结束位置] == ' ' || 字符切片[结束位置] == '\t') {
        结束位置 += 1;
    }
    如果 结束位置 < 字符切片.长度() && 字符切片[结束位置] == '(' {
        有值(&字符切片[点 + 1..位置])
    } 否则 {
        无
    }
}

/// FNV-1a 64 位哈希：精确命中表用（短串上比 SipHash 快一个量级，且无密钥）
函数 哈希一甲(字节序列: &[字节]) -> 无符号长整数 {
    让 可变 哈希值: 无符号长整数 = 0xcbf2_9ce4_8422_2325;
    对于 &字节值 在 字节序列 {
        哈希值 ^= 字节值 作为 无符号长整数;
        哈希值 = 哈希值.溢出乘(0x0000_0100_0000_01b3);
    }
    哈希值
}

/// 已知词表按字符数分桶后的索引（易混方法名判定用）
///
/// 编辑距离 ≤1 只在长度差 ≤1 的词之间成立，分桶后每个方法名只需比较相邻
/// 三桶；此前每次方法调用位都要扫一遍整张词表（语言包约千条），是整个教学
/// 检查里最贵的一步。桶内顺序与 `哈希集合` 迭代顺序一致，候选仍按字典序取
/// 最小，结果确定。
///
/// 词表随语言包确定后不可变，而笔误检查只需「名字长度 ±1」的桶。早先
/// 每份源码在第一个方法调用位才现场构建一次，小文件（CLI 批量、LSP 每次
/// 编辑）上这份固定开销远大于扫描本身（实测：真实语料上占检查的 85%）。
/// 现在改为拥有所有权、由调用方缓存
/// （[`包::映射管理器::映射管理器::检查词形桶`]）。
///
/// 词按桶顺序紧排在同一个字符串里，桶内只记 `(起始字节, 字节长度)`：
/// 词表上千条，逐词 `Box<str>` 会让一次性构建的开销涨到十倍。
#[派生(调试, 克隆)]
公开 结构体 词形分桶 {
    词表: 字符串,
    按长度: 向量<向量<(无符号整数, 无符号整数)>>,
    /// 精确命中表（开放地址，槽存 `(起始字节, 字节长度)`，空槽起始为 `u32::MAX`）
    ///
    /// 真实语料里方法调用位绝大多数是**合法词**（`.推送(`），笔误极少；早先
    /// 每个调用位都要线性扫长度 ±1 三个桶（母语词表实测平均 721 条候选）才能
    /// 确认「名字本身在词表里」，占教学检查一半以上。有这张表只需一次哈希
    /// 探测。惰性构建路径（单文件 API）不建此表——词表上千条时每份源码重建
    /// 与扫描同量级。
    精确表: 选项<盒子<[(无符号整数, 无符号整数)]>>,
}

实现 词形分桶 {
    /// 按字符数把词表切成分桶
    公开 函数 构建(已知词: &哈希集合<字符串>) -> 自身 {
        让 可变 词表 = 字符串::带容量(已知词.长度() * 8);
        让 可变 按长度: 向量<向量<(无符号整数, 无符号整数)>> = 向量::新建();
        对于 词 在 已知词 {
            让 长度 = 词.逐字符().计数();
            如果 按长度.长度() <= 长度 {
                按长度.调整大小(长度 + 1, 向量::新建());
            }
            让 起点 = 词表.长度() 作为 无符号整数;
            词表.推入字符串(词);
            按长度[长度].推入((起点, 词.长度() 作为 无符号整数));
        }
        自身 {
            词表,
            按长度,
            精确表: 无,
        }
    }

    /// 追加精确命中表（每语言包建一次，不是每份源码一次）
    ///
    /// 开放地址线性探测，容量取词数的两倍向上取整；槽里存词在公共 `词表`
    /// 串中的位置，不复制字符串。只由缓存索引的调用方
    /// （[`包::映射管理器::映射管理器::检查词形桶`]）调用。
    #[必须使用]
    公开 函数 带精确索引(可变 自我) -> 自身 {
        让 总数: 无符号机器整数 = 自我.按长度.迭代().映射(向量::长度).求和();
        如果 总数 == 0 {
            返回 自我;
        }
        让 容量 = (总数 * 2).下一个二次幂();
        让 可变 表 = 向量![(无符号整数::最大常量, 0u32); 容量];
        对于 桶 在 &自我.按长度 {
            对于 &(起点, 长度) 在 桶 {
                让 键 = &自我.词表[起点 作为 无符号机器整数..起点 作为 无符号机器整数 + 长度 作为 无符号机器整数];
                让 可变 槽 = (哈希一甲(键.转为字节()) 作为 无符号机器整数) & (容量 - 1);
                当 表[槽].0 != 无符号整数::最大常量 {
                    槽 = (槽 + 1) & (容量 - 1);
                }
                表[槽] = (起点, 长度);
            }
        }
        自我.精确表 = 有值(表.转装箱切片());
        自我
    }

    /// 名字是否恰为词表里的词：`无` 表示未建精确表（惰性路径）
    函数 精确命中(&自我, 探测词: &文本) -> 选项<布尔> {
        让 表 = 自我.精确表.作为解引用()?;
        如果 表.是否为空() {
            返回 有值(假值);
        }
        让 掩码 = 表.长度() - 1;
        让 可变 槽 = (哈希一甲(探测词.转为字节()) 作为 无符号机器整数) & 掩码;
        循环 {
            让 (起点, 长度) = 表[槽];
            如果 起点 == 无符号整数::最大常量 {
                返回 有值(假值);
            }
            让 词 = &自我.词表[起点 作为 无符号机器整数..起点 作为 无符号机器整数 + 长度 作为 无符号机器整数];
            如果 词 == 探测词 {
                返回 有值(真值);
            }
            槽 = (槽 + 1) & 掩码;
        }
    }

    /// 字符数为 `长度-1` / `长度` / `长度+1` 的词（缺失的桶自动跳过）
    ///
    /// 连同桶长一起产出：候选词字符数即桶索引，省得下游每词重数一遍
    /// `逐字符().计数()`（实测算术，一次候选扫描里占近半）
    函数 邻近桶(&自我, 长度: 无符号机器整数) -> 实现 迭代器特征<货物类型 = (无符号机器整数, &文本)> + '_ {
        让 词表 = 自我.词表.作为文本切片();
        (长度.饱和减(1)..=长度.饱和加(1))
            .过滤映射(移动 |序号| 自我.按长度.截取(序号).映射(|桶| (序号, 桶)))
            .平铺(移动 |(序号, 桶)| {
                桶.迭代().映射(移动 |&(起点, 长度)| {
                    让 起点 = 起点 作为 无符号机器整数;
                    (序号, &词表[起点..起点 + 长度 作为 无符号机器整数])
                })
            })
    }
}

/// 在已知词表中寻找与未命中方法名编辑距离 ≤1 的候选（按字典序取
/// 首个，结果确定）；名字本身在表中或过短（单字）时不提示。
函数 易混候选<'甲>(名字: &[字符], 索引: &'甲 词形分桶) -> 选项<&'甲 文本> {
    如果 名字.长度() < 2 {
        返回 无;
    }
    // 名字本身就是合法词（真实语料里绝大多数方法调用位）：一次哈希探测即
    // 收工，不必扫三个长度桶的候选。惰性路径未建精确表，走下面的逐词比较。
    让 探测词: 字符串 = 名字.迭代().收集();
    如果 索引.精确命中(&探测词) == 有值(真值) {
        返回 无;
    }
    让 可变 最佳: 选项<&'甲 文本> = 无;
    对于 (词长度, 词) 在 索引.邻近桶(名字.长度()) {
        // 名字本身在词表中：不是笔误。逐字符比较代替 `包含(&文本)`，
        // 免去为切片构造临时字符串（相等的词必与名字同长，落在本轮桶内）
        如果 词长度 == 名字.长度() && 词.逐字符().相等方法(名字.迭代().复制值()) {
            返回 无;
        }
        如果 一次编辑内(名字, 词, 词长度) && 最佳.是否为无或(|前项| 词 < 前项) {
            最佳 = 有值(词);
        }
    }
    最佳
}

/// 编辑距离 ≤1 的近似判定（等长时恰有一处不同；差一字时短词是长词
/// 删去一个字符的结果），用于易混词候选筛选。
///
/// `甲` 为字符切片（调用方已持有），`乙` 按需取字符迭代器——两侧都不分配；
/// 此前每个候选词都要为两侧各物化一个 `向量<字符>`。`乙长度` 由分桶索引直接
/// 给出（桶索引即字符数），不再逐候选 `逐字符().计数()` 重数。
函数 一次编辑内(甲: &[字符], 乙: &文本, 乙长度: 无符号机器整数) -> 布尔 {
    如果 甲.长度() == 乙长度 {
        // 等长：恰好一处不同；发现第二处即失败，不必数完全程
        让 可变 差异数 = 0usize;
        对于 (左项, 右项) 在 甲.迭代().拉链(乙.逐字符()) {
            如果 *左项 != 右项 {
                差异数 += 1;
                如果 差异数 > 1 {
                    返回 假;
                }
            }
        }
        差异数 == 1
    } 否则 如果 甲.长度() + 1 == 乙长度 {
        单字符插入(甲.迭代().复制值(), 乙.逐字符())
    } 否则 如果 乙长度 + 1 == 甲.长度() {
        单字符插入(乙.逐字符(), 甲.迭代().复制值())
    } 否则 {
        假
    }
}

/// 判定 `短序列` 是否恰为 `长序列` 删去一个字符的结果（两侧均按字符迭代）
函数 单字符插入(
    短序列: 实现 迭代器特征<货物类型 = 字符>,
    长序列: 实现 迭代器特征<货物类型 = 字符>,
) -> 布尔 {
    让 可变 短序列 = 短序列.可窥视();
    让 可变 长序列 = 长序列.可窥视();
    让 可变 已跳过 = 假;
    循环 {
        匹配 (短序列.偷看().复制值(), 长序列.偷看().复制值()) {
            (无, _) => 返回 真,
            (有值(短项), 有值(长项)) 如果 短项 == 长项 => {
                让 _ = (短序列.下一个(), 长序列.下一个());
            }
            (有值(_), 有值(_)) 如果 已跳过 => 返回 假,
            (有值(_), 有值(_)) => {
                已跳过 = 真;
                让 _ = 长序列.下一个();
            }
            (有值(_), 无) => 返回 假,
        }
    }
}
#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    /// 测试用歧义构造器词集（模拟语言包：`索引.新建()` 对应 `索引.new()`、`索引.缺省()` 对应 `索引.default()`）
    函数 中文歧义() -> 哈希集合<字符串> {
        [
            "new".转字符串(),
            "default".转字符串(),
            "新建".转字符串(),
            "缺省".转字符串(),
        ]
        .消费迭代()
        .收集()
    }

    #[测试]
    函数 检测未标注类型() {
        // 类型无法自行推导的关联构造器调用才提示（普通字面量不再触发）
        让 源码 = "函数 主函数() {\n    让 x = 向量::新建();\n}";
        让 告警 =
            按词表检查教学(源码, &哈希集合::新建(), &中文歧义());
        断言相等!(告警.长度(), 1, "{告警:?}");
        断言相等!(告警[0].告警种类, 告警类别::未标注类型);
        断言相等!(告警[0].行号, 2);
        断言相等!(告警[0].列号, 5);
    }

    /// 类型可自行推导的初始化式一律不报（用户反馈：自动推导时提示成噪音）
    #[测试]
    函数 可推导初始化式不提示() {
        让 样例集 = [
            "函数 主函数() {\n    让 x = 1;\n}", // 整数字面量
            "函数 主函数() {\n    让 s = \"你好\";\n}", // 字符串
            "函数 主函数() {\n    让 b = 真;\n}",  // 布尔
            "函数 主函数() {\n    让 y = x + 1;\n}", // 运算
            "函数 主函数() {\n    让 n = 加一(1);\n}", // 普通函数调用
            "函数 主函数() {\n    让 n = 项.长度();\n}", // 方法调用
            "函数 主函数() {\n    让 v = 向量![1, 2];\n}", // 宏
            "函数 主函数() {\n    让 p = 点 { x: 1, y: 2 };\n}", // 结构体字面量
            "函数 主函数() {\n    让 t = (1, 2);\n}", // 元组
            "函数 主函数() {\n    让 a = [1, 2];\n}", // 数组
            "函数 主函数() {\n    让 r = serde_json::from_str(\"{}\");\n}", // 普通关联函数
            "函数 主函数() {\n    让 x = 常量名;\n}", // 路径/常量
            "函数 主函数() {\n    让 v = 向量::新建::<i32>();\n}", // 泛型标注已给类型
            "函数 主函数() {\n    让 v: 整数 = 向量::新建();\n}", // 已注解
        ];
        对于 源码 在 样例集 {
            让 告警 =
                按词表检查教学(源码, &哈希集合::新建(), &中文歧义());
            断言!(
                !告警
                    .迭代()
                    .任意(|告警项| 告警项.告警种类 == 告警类别::未标注类型),
                "可推导初始化式不应提示: {源码}\n{告警:?}"
            );
        }
    }

    /// 真正歧义（rustc 也会 E0282）的形态：无显式泛型的「新建」「缺省」
