// JSON 诊断解析、格式化输出与未解析导入检测

use 超级::教学::教学诊断;
use 超级::诊断模型::编译器诊断;

/// 解析 rustc/cargo 的 JSON 诊断输出（逐行 JSON 对象）
///
/// 支持两种格式：
/// - rustc 直接输出：每行一个完整的诊断 JSON 对象
/// - cargo --message-format=json 包装：诊断嵌套在 `message` 字段中
公开 函数 解析诊断输出(输出: &文本) -> 向量<编译器诊断> {
    让 可变 诊断结果 = 向量::新建();
    对于 每行 in 输出.lines() {
        让 每行 = 每行.trim();
        如果 每行.is_empty() || !每行.starts_with('{') {
            继续;
        }
        如果让 成功(诊断) = serde_json::from_str::<编译器诊断>(每行) {
            诊断结果.push(诊断);
        } 否则 如果让 成功(包装值) = serde_json::from_str::<serde_json::Value>(每行) {
            // cargo --message-format=json 的 compiler-message 包装行：
            // 完整诊断嵌套在顶层 message 字段中（build-finished 等行无 message 对象，自动跳过）
            如果让 成功(诊断) =
                serde_json::from_value::<编译器诊断>(包装值["message"].clone())
            {
                诊断结果.push(诊断);
            }
        }
    }
    诊断结果
}

/// 格式化后的诊断信息（用于文本输出）
公开 结构体 格式化诊断 {
    公开 级别文字: 字符串,
    公开 码文字: 字符串,
    公开 消息: 字符串,
    公开 位置描述: 向量<字符串>,
    公开 教学提示: 向量<字符串>,
}

实现 教学诊断 {
    /// 格式化为结构化诊断
    公开 函数 格式化为结构(&自我) -> 格式化诊断 {
        让 级别文字 = 自我.严重级别.显示文字().to_string();
        让 码文字 = 自我
            .错误码
            .as_ref()
            .map(|码| 格式化!("[{}]", 码))
            .unwrap_or_default();

        让 位置描述 = 自我
            .位置列表
            .iter()
            .filter(|p| p.是主跨度)
            .map(|p| {
                让 可变 描述 = 格式化!("  --> {}:{}:{}", p.源文件名, p.起始行, p.起始列);
                如果让 有值(标签) = &p.标签 {
                    描述 = 格式化!("{}\n      {}", 描述, 标签);
                }
                描述
            })
            .collect();

        格式化诊断 {
            级别文字,
            码文字,
            消息: 自我.翻译消息.clone(),
            位置描述,
            教学提示: 自我.教学提示.clone(),
        }
    }

    /// 格式化为文本（可直接输出到终端）
    公开 函数 格式化为文本(&自我) -> 字符串 {
        让 已格式化 = 自我.格式化为结构();
        让 可变 输出 = 字符串::新建();

        // 第一行：错误级别 + 错误码 + 消息
        输出.push_str(&格式化!(
            "{}{}: {}\n",
            已格式化.级别文字, 已格式化.码文字, 已格式化.消息
        ));

        // 位置信息（只显示第一个主要位置）
        如果让 有值(位置) = 自我.位置列表.iter().find(|p| p.是主跨度) {
            输出.push_str(&格式化!(
                "  --> {}:{}:{}\n",
                位置.源文件名, 位置.起始行, 位置.起始列
            ));
            如果让 有值(源码) = &位置.源码文本 {
                输出.push_str(&格式化!("   | {}\n", 源码));
            }
        }

        // 所有权错误叙事提示
        如果让 有值(详情) = &自我.所有权详情 {
            输出.push_str(&格式化!("📌 {}\n", 详情.叙事文本()));
        }

        // 教学提示（全部输出；此前仅取首条，其余被静默丢弃）
        对于 提示 in &自我.教学提示 {
            输出.push_str(&格式化!("💡 {}\n", 提示));
        }

        输出
    }

    /// 批量格式化为文本
    公开 函数 批量格式化为文本(诊断列表: &[教学诊断]) -> 字符串 {
        让 可变 输出 = 字符串::新建();
        对于 (序号, 诊断) in 诊断列表.iter().enumerate() {
            如果 序号 > 0 {
                输出.push_str("\n---\n\n");
            }
            输出.push_str(&诊断.格式化为文本());
        }
        输出
    }
}

/// 判断诊断消息是否为未解析导入类错误（英文原文匹配）
///
/// 覆盖 rustc E0432（unresolved import）与 E0433（failed to resolve:
/// use of undeclared crate or module）两种消息格式。
公开 函数 是未解析导入消息(消息: &文本) -> 布尔 {
    消息.contains("unresolved import") || 消息.contains("use of undeclared crate or module")
}

/// 提取消息中所有反引号包裹路径的首段（:: 分隔）
///
/// 仅取形如路径的内容（标识符字符与 ::），过滤含空格的自由文本；
/// 翻译后的诊断同样保留反引号内容，故母语/英文消息均可提取。
公开 函数 抽取反引号首段(待扫描文本: &文本) -> 向量<字符串> {
    让 可变 段列表 = 向量::新建();
    让 可变 剩余 = 待扫描文本;
    当让 有值(起点) = 剩余.find('`') {
        让 之后 = &剩余[起点 + 1..];
        让 有值(终点) = 之后.find('`') 否则 { 中断 };
        让 内部 = &之后[..终点];
        剩余 = &之后[终点 + 1..];
        如果 !内部.is_empty()
            && 内部
                .chars()
                .all(|c| c.is_alphanumeric() || c == '_' || c == ':')
        {
            让 首段 = 内部.split("::").next().unwrap_or(内部);
            如果 !首段.is_empty() {
                段列表.push(首段.to_string());
            }
        }
    }
    段列表
}

/// 从未解析导入消息提取候选 crate 名（去重，排除标准库与保留路径）
///
/// 非未解析导入消息返回空列表。供 CLI 编译诊断提示与 LSP
/// 快捷修复代码动作共用：提示用户通过 `rzc add <crate>` 添加依赖。
/// crate 名必须是 ASCII（字母/数字/下划线/连字符）；母语标识符
/// （如漏写 `包::` 前缀的中文模块名 "数据模型"）不是 crate，
/// 提示 `rzc add 数据模型` 只会误导用户。
公开 函数 未解析包候选(消息: &文本) -> 向量<字符串> {
    如果 !是未解析导入消息(消息) {
        返回 向量::新建();
    }
    让 可变 候选列表 = 向量::新建();
    对于 段 in 抽取反引号首段(消息) {
        如果 matches!(
            段.as_str(),
            "std" | "core" | "alloc" | "self" | "super" | "crate" | "proc_macro"
        ) || 段.chars().next().is_some_and(|c| c.is_ascii_digit())
            || !段.is_ascii()
        {
            继续;
        }
        如果 !候选列表.contains(&段) {
            候选列表.push(段);
        }
    }
    候选列表
}
