//! 错误消息翻译结构：从语言包 errors.toml 加载错误码表与消息表。

使用 包::故障::{载入故障, 载入目标};
使用 序列化属性::可反序列化;
使用 标准库::集合::哈希映射;
使用 标准库::文件系统;
使用 标准库::路径::路径类型;

/// 错误消息翻译条目（从 errors.toml 加载）
#[派生(可反序列化, 调试, 克隆)]
公开 结构体 错误消息条目 {
    公开 消息模板: 字符串,
    公开 教学提示: 选项<字符串>,
}

/// 消息键的通配符：`?` 表示一段动态内容（非贪婪，按后续字面量定位）
///
/// 带通配的键称「通配段键」：一次匹配即可拿到中间与末尾两个动态名（`{q0}`/`{q1}`），
/// 解决「两端动态」的消息无法用单一前缀/后缀键完整翻译的问题。
公开 常量 通配符: 字符 = '?';

/// 消息表匹配的动态部分来源
///
/// 前缀键与后缀键命中的残段形态不同，占位符提取方式也不同：
/// - 前缀键：残段是键之后的尾段，开引号已被键剥离；
/// - 后缀键（键以 `~` 开头）：残段是键之前的头段，引号对完整；
/// - 通配段键（含 `?`）：逐个捕获每个 `?` 之间的原文。
#[派生(调试, 克隆)]
公开 枚举 消息残段<'乙> {
    /// 前缀键命中的尾段
    尾段(&'乙 文本),
    /// 后缀键命中的头段
    头段(&'乙 文本),
    /// 通配段键命中的逐个捕获（第 n 个 `?` 之间的原文）
    片段集(向量<&'乙 文本>),
}

实现<'乙> 消息残段<'乙> {
    /// 未翻译原文残段（模板无占位符命中时按原文拼接到模板后）
    ///
    /// 通配段键不适用：其动态部分已被逐个 `{qN}` 完整接管，残段为空。
    公开 函数 文字(&自我) -> &'乙 文本 {
        匹配 自我 {
            自身::尾段(串) | 自身::头段(串) => 串,
            自身::片段集(_) => "",
        }
    }
}

/// 错误消息翻译管理器：按错误码或消息文本查询翻译条目
#[派生(调试, 克隆)]
公开 结构体 错误消息管理器 {
    /// 错误码表：错误码 → 翻译条目（`errors.toml` 顶层 `[E0xxx]` 节）
    公开 翻译表: 哈希映射<字符串, 错误消息条目>,
    /// 消息表：英文消息原文 → 翻译条目（errors.toml [消息翻译] 节）
    消息映射: 哈希映射<字符串, 错误消息条目>,
}

实现 错误消息管理器 {
    /// 从文件加载错误翻译表
    公开 函数 从文件载入(目标路径: &路径类型) -> 结果<自身, 载入故障> {
        让 内容 = 文件系统::读取全部字符串(目标路径).映射错误(|坏| 载入故障::读取失败 {
            目标: 载入目标::错误消息表,
            文件路径: 有值(目标路径.展示().转字符串()),
            详情: 坏.转字符串(),
        })?;
        自身::从字符串载入(&内容)
    }

    /// 从 TOML 字符串加载错误翻译表
    ///
    /// 顶层表分为两类：错误码表（含模板与提示）与消息表（键为英文消息原文）。
    公开 函数 从字符串载入(内容: &文本) -> 结果<自身, 载入故障> {
        让 值对象: TOML处理::TOML值 = TOML处理::解析字符串(内容).映射错误(|坏| 载入故障::解析失败 {
            目标: 载入目标::错误消息表,
            文件路径: 无,
            详情: 坏.转字符串(),
        })?;
        让 可变 翻译表 = 哈希映射::新建();
        让 可变 消息映射 = 哈希映射::新建();
        如果 让 有值(顶层表) = 值对象.作为表格() {
            对于 (键名, 映射值) 在 顶层表 {
                如果 键名 == "消息翻译" {
                    如果 让 有值(子表) = 映射值.作为表格() {
                        对于 (消息文, 翻译条目) 在 子表 {
                            消息映射.置入(消息文.克隆(), 条目自值(翻译条目));
                        }
                    }
                } 否则 {
                    翻译表.置入(键名.克隆(), 条目自值(映射值));
                }
            }
        }
        成功(自身 { 翻译表, 消息映射 })
    }

    /// 按错误码查询翻译条目
    公开 函数 按码查询(&自我, 错误码: &文本) -> 选项<&错误消息条目> {
        自我.翻译表.获取(错误码)
    }

    /// 按消息原文查询翻译条目
    ///
    /// 匹配顺序：精确匹配 → 最长通配段键 → 最长前缀匹配 → 最长后缀匹配。
    /// 返回未匹配的动态部分（前缀键为尾段、后缀键为头段、通配段键为逐个捕获），
    /// 供调用方填充模板占位符或拼接到模板后。
    公开 函数 按消息查询<'甲, '乙>(
        &'甲 自我,
        原文: &'乙 文本,
    ) -> 选项<(&'甲 错误消息条目, 选项<消息残段<'乙>>)> {
        // 1. 精确匹配
        如果 让 有值(翻译条目) = 自我.消息映射.获取(原文) {
            返回 有值((翻译条目, 无));
        }
        // 2. 通配段键（字面量总长最长者胜：越具体越优先）
        让 可变 最佳段: 选项<(无符号机器整数, 向量<&'乙 文本>, &'甲 错误消息条目)> = 无;
        // 3. 最长前缀 / 最长后缀候选（前缀优先，其模板通常更完整、含类型词）
        让 可变 最佳前缀: 选项<(无符号机器整数, &'乙 文本, &'甲 错误消息条目)> = 无;
        让 可变 最佳后缀: 选项<(无符号机器整数, &'乙 文本, &'甲 错误消息条目)> = 无;
        对于 (键名, 翻译条目) 在 &自我.消息映射 {
            如果 让 有值(后缀键) = 键名.去前缀('~') {
                如果 让 有值(前缀) = 原文.去后缀(后缀键)
                    && 最佳后缀.是否为无或(|(段长, _, _)| 后缀键.长度() > 段长) {
                    最佳后缀 = 有值((后缀键.长度(), 前缀, 翻译条目));
                }
            } 否则 如果 键名.包含(通配符) {
                如果 让 有值(捕获集) = 匹配段(键名, 原文)
                    && 最佳段.作为引用方法().是否为无或(|(段长, _, _)| 字面量总长(键名) > *段长) {
                    最佳段 = 有值((字面量总长(键名), 捕获集, 翻译条目));
                }
            } 否则 如果 原文.以开头(键名.作为字符串())
                && 最佳前缀.是否为无或(|(段长, _, _)| 键名.长度() > 段长) {
                最佳前缀 = 有值((键名.长度(), &原文[键名.长度()..], 翻译条目));
            }
        }
        如果 让 有值((_, 捕获集, 翻译条目)) = 最佳段 {
            // 通配段捕获已借自原文（'乙），直接归入片段集随返回值存活；
            // 仅当模板确实引用占位符时保留捕获，否则丢弃空片段集。
            让 残段值 = 如果 翻译条目.消息模板.包含("{q") {
                消息残段::片段集(捕获集)
            } 否则 {
                消息残段::片段集(向量::新建())
            };
            返回 有值((翻译条目, 有值(残段值)));
        }
        如果 让 有值((_, 尾段, 翻译条目)) = 最佳前缀 {
            返回 有值((翻译条目, 有值(消息残段::尾段(尾段))));
        }
        最佳后缀.映射(|(_, 头段, 翻译条目)| (翻译条目, 有值(消息残段::头段(头段))))
    }

    /// 已覆盖的错误码数量
    公开 函数 覆盖数(&自我) -> 无符号机器整数 {
        自我.翻译表.长度()
    }
}

/// 将通配段键拆为字面量段（以 `?` 为分界）
函数 分割通配(键名: &文本) -> 向量<&文本> {
    键名.分割(通配符).收集()
}

/// 通配段键的字面量总长度（多键命中同一消息时的特异度排序依据）
函数 字面量总长(键名: &文本) -> 无符号机器整数 {
    分割通配(键名).迭代().映射(|段| 段.逐字符().计数()).求和()
}

/// 用通配段键匹配消息，成功返回每个 `?` 捕获的原文（按出现顺序）
///
/// 语义为非贪婪：每个字面量段从上一段之后首次出现的位置开始找。首段为前缀锚
/// （须非空），尾段为后缀锚（可空），中间为捕获间的分隔锚，要求依次不重叠出现。
函数 匹配段<'乙>(键名: &文本, 原文: &'乙 文本) -> 选项<向量<&'乙 文本>> {
    让 字面量段集 = 分割通配(键名);
    如果 字面量段集.是否为空() {
        返回 无;
    }
    让 首段 = 字面量段集[0];
    让 其余字面量 = &字面量段集[1..];
    如果 首段.是否为空() {
        返回 无;
    }
    让 尾锚 = *其余字面量.最后一个()?;
    让 正文 = 原文.去前缀(首段)?;
    如果 !正文.以结尾(尾锚) {
        返回 无;
    }
    让 分隔锚 = &其余字面量[..其余字面量.长度() - 1];
    让 可变 捕获集 = 向量::新建();
    让 可变 剩余 = 正文;
    对于 隔符 在 分隔锚 {
        让 命中处 = 剩余.查找(隔符)?;
        捕获集.推入(&剩余[..命中处]);
        剩余 = &剩余[命中处 + 隔符.长度()..];
    }
    捕获集.推入(剩余.去后缀(尾锚)?);
    有值(捕获集)
}

/// 用动态部分填充模板的 `{q0}`/`{q1}`（恒等本地化）
公开 函数 填充动态占位(译文模板: &文本, 残段: &消息残段<'_>) -> (字符串, 布尔) {
    填充动态占位定制(译文模板, 残段, &可变 |词元| 词元.转字符串())
}

/// 可注入本地化版本的动态占位填充
///
/// 本地化作用在每个即将写进模板的动态捕获值上，一次一处：调用方因此能区分
/// 「编译器注入的类型名」与「作者写在模板字面里的英文标识符」。主消息走此入口，
/// 建议通道与审计/工具通道继续用恒等闭包（填充动态占位），行为不变。
公开 函数 填充动态占位定制(
    译文模板: &文本,
    残段: &消息残段<'_>,
    本地化: &可变 动态 可变函数(&文本) -> 字符串,
) -> (字符串, 布尔) {
    让 可变 成品 = 译文模板.转字符串();
    让 可变 已消费 = 假;
    // 占位符编号上界：前缀/后缀键的启发式只区分 `{q0}`/`{q1}`；`{q2}` 仅对通配段键有意义。
    对于 序号 在 0..3 {
        让 占位符 = 格式化!("{{q{序号}}}");
        如果 成品.包含(&占位符) {
            让 内容 = 匹配 残段 {
                消息残段::片段集(捕获集) => 捕获集.获取(序号).复制值(),
                消息残段::头段(动态段) => {
                    如果 动态段.包含('`') {
                        如果 序号 == 1 || 动态段.模式匹配('`').计数() == 1 {
                            动态段.逆分割('`').取第项(1)
                        } 否则 {
                            动态段.分割('`').取第项(1)
                        }
                    } 否则 {
                        动态段.分割('\'').取第项(序号 * 2 + 1)
                    }
                }
                消息残段::尾段(动态段) => {
                    如果 动态段.包含('`') {
                        如果 序号 == 1 {
                            动态段.逆分割('`').取第项(1)
                        } 否则 如果 让 有值(后) = 动态段.去前缀('`') {
                            后.分割('`').下一个()
                        } 否则 {
                            动态段.分割('`').下一个()
                        }
                    } 否则 {
                        动态段.分割('\'').取第项(序号 * 2)
                    }
                }
            };
            匹配 内容 {
                有值(内容) 如果 !内容.是否为空() => {
                    成品 = 成品.替换(&占位符, &本地化(内容));
                    已消费 = 真;
                }
                // 捕获为空或失败：原样回退，交由调用方拼接原文
                _ => 返回 (译文模板.转字符串(), 假),
            }
        }
    }
    (成品, 已消费)
}

/// 从 TOML 值构建翻译条目（模板缺失时回退空串，避免解析失败丢失整表）
函数 条目自值(值对象: &TOML处理::TOML值) -> 错误消息条目 {
    错误消息条目 {
        消息模板: 值对象
            .获取("消息模板")
            .而后映射(|映射值| 映射值.作为字符串())
            .取值或默认()
            .转字符串(),
        教学提示: 值对象
            .获取("教学提示")
            .而后映射(|映射值| 映射值.作为字符串())
            .映射(|串| 串.转字符串()),
    }
}

/// 单条 rustc 消息在给定语言包下的译文审计结果（供审计示例与门禁测试共用）
#[派生(调试, 克隆)]
公开 结构体 消息审计 {
    /// 命中形态：CODE/EXACT/PREFIX/SUFFIX/SEGMENT/MISS
    公开 种类: 字符串,
    /// 渲染后的译文（含未消费残段回拼）
    公开 已渲染: 字符串,
    /// 渲染后仍残留的英文词串（空表示已译全）
    公开 残留: 向量<字符串>,
}

/// 连续多少个英文单词即视为「未翻译残留」（单个标识符关键字之类不报）
常量 最少英文词数: 无符号机器整数 = 4;

/// 从文本中提取长度≥最少英文词数的连续 ASCII 英文词串
///
/// 分隔符仅用于切词：连续的标点/反引号/逗号会切出空串，但空串不算英文、
/// 也不算译文，必须跳过而非中断词串，否则整句未译的英文会被拆成碎串而漏报。
函数 英文词串(正文: &文本) -> 向量<字符串> {
    让 可变 词串集 = 向量::新建();
    让 可变 当前: 向量<&文本> = 向量::新建();
    对于 词元 在 正文.分割(|每字: 字符| !每字.是ASCII字母数字()) {
        如果 词元.是否为空() {
            继续;
        }
        如果 词元.逐字符().全部(|每字: 字符| 每字.是否为字母数字())
            && 词元.包含(|每字: 字符| 每字.是ASCII字母()) {
            当前.推入(词元);
        } 否则 {
            如果 当前.长度() >= 最少英文词数 {
                词串集.推入(当前.连接(" "));
            }
            当前.清空集合();
        }
    }
    如果 当前.长度() >= 最少英文词数 {
        词串集.推入(当前.连接(" "));
    }
    词串集
}

/// 码表桩是否会按「反引号记号出现顺序」猜句子结构
///
/// 桩里的类型/特征等占位符没有语义来源，渲染时把消息里的反引号内容按先后顺序
/// 逐个塞进去；同一错误码下编译器会输出结构完全不同的句子，猜错就答非所问。
/// 只用由跨度标签可靠提取的期望/实际、或不含占位符的桩不属于猜结构。
公开(包) 函数 桩猜测标记形态(翻译条目: &错误消息条目) -> 布尔 {
    超级::诊断翻译::码模板占位符集
        .迭代()
        .任意(|占位| 翻译条目.消息模板.包含(占位))
}

/// 消息表命中结果里的「整句条目」（精确键或通配段键）
公开(包) 函数 整句命中<'甲>(
    查询结果: &选项<(&'甲 错误消息条目, 选项<消息残段<'_>>)>,
) -> 选项<&'甲 错误消息条目> {
    让 有值((翻译条目, 残段)) = 查询结果 否则 {
        返回 无;
    };
    匹配 残段 {
        无 | 有值(消息残段::片段集(_)) => 有值(*翻译条目),
        _ => 无,
    }
}

/// 主消息取哪张表：消息表的整句译文，还是会猜槽位的码表桩
///
/// 规约：码表桩要靠记号顺序猜句子结构、而消息表对该句有整条译文时，用消息表；
/// 其余情形维持既有的「码表桩优先」。
公开(包) 函数 消息表胜出(
    码表条目: 选项<&错误消息条目>,
    整句条目: 选项<&错误消息条目>,
) -> 布尔 {
    让 (有值(桩), 有值(_)) = (码表条目, 整句条目) 否则 {
        返回 假;
    };
    桩猜测标记形态(桩)
}

/// 用引擎自身的匹配器审计一条消息在语言包中的译文残留
///
/// 渲染路径与翻译器完全一致，因此这里报出的残留就是用户在终端里实际看到的文字。
公开 函数 审计消息(
    译表: &错误消息管理器,
    级别: &文本,
    码: &文本,
    原文: &文本,
) -> 消息审计 {
    // 主消息优先看错误码表（完整桩）：若该码已有模板，主消息就不会残留英文。
    // 例外：桩要靠记号顺序猜结构而消息表有整句译文时，渲染走的是消息表。
    如果 级别 == "main"
        && !码.是否为空()
        && 让 有值(翻译条目) = 译表.按码查询(码)
        && !翻译条目.消息模板.是否为空()
        && !消息表胜出(有值(翻译条目), 整句命中(&译表.按消息查询(原文))) {
        返回 消息审计 {
            种类: "CODE".转字符串(),
            已渲染: 翻译条目.消息模板.克隆(),
            残留: 向量::新建(),
        };
    }
    匹配 译表.按消息查询(原文) {
        // 完全未命中：整条英文原文都是残留。
        无 => 消息审计 {
            种类: "MISS".转字符串(),
            已渲染: 字符串::新建(),
            残留: 英文词串(原文),
        },
        // 精确命中：译文即我方模板，不再度量模板。
        有值((翻译条目, 无)) => 消息审计 {
            种类: "EXACT".转字符串(),
            已渲染: 翻译条目.消息模板.克隆(),
            残留: 向量::新建(),
        },
        有值((翻译条目, 有值(残段))) => {
            让 种类标签 = 匹配 &残段 {
                消息残段::尾段(_) => "PREFIX",
                消息残段::头段(_) => "SUFFIX",
                消息残段::片段集(_) => "SEGMENT",
            };
            让 (可变 已渲染, 已消费) = 填充动态占位(&翻译条目.消息模板, &残段);
            如果 !已消费 {
                已渲染.推入字符串(残段.文字());
                // 未消费＝把英文残段原样回拼，只对残段判残留。
                返回 消息审计 {
                    种类: 种类标签.转字符串(),
                    已渲染,
                    残留: 英文词串(残段.文字()),
                };
            }
            消息审计 {
                种类: 种类标签.转字符串(),
                已渲染,
                残留: 向量::新建(),
            }
        }
    }
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    /// 从消息表点号表头片段构建消息管理器（测试辅助）
    函数 建表(片段文字: &文本) -> 错误消息管理器 {
        错误消息管理器::从字符串载入(片段文字).期望("测试用 TOML 应能解析")
    }

    /// 渲染消息表命中结果：填充占位符，未消费时拼回残段（与调用方同逻辑）
    函数 渲染(译表: &错误消息管理器, 原文: &文本) -> 选项<字符串> {
        让 (翻译条目, 残段) = 译表.按消息查询(原文)?;
        让 可变 文字 = 翻译条目.消息模板.克隆();
        如果 让 有值(残段) = 残段 {
            让 (已填充, 已消费) = 填充动态占位(&文字, &残段);
            文字 = 已填充;
            如果 !已消费 {
                文字.推入字符串(残段.文字());
            }
        }
        有值(文字)
    }

    /// 单 `?` 通配段键（回归）：仅两段时也必须能匹配
    #[测试]
    函数 通配段单捕获() {
        让 表 = 建表(
            "[\"消息翻译\".\"consider specifying a concrete type for the type parameter `?`\"]\n\"消息模板\" = \"考虑为类型参数 `{q0}` 指定具体类型\"",
        );
        断言相等!(
            渲染(&表, "consider specifying a concrete type for the type parameter `T`")
                .作为解引用(),
            有值("考虑为类型参数 `T` 指定具体类型")
        );
    }

    /// 英文词串跨标点连续计数（回归）：反引号/逗号拆出的空串不得中断词串
    #[测试]
    函数 英文词串跨标点() {
        让 串集 = 英文词串("variable `x` is assigned to, but never used");
        断言!(
            串集.迭代().任意(|串| 串.包含("assigned") && 串.包含("never")),
            "整句英文应作为连续词串报出，实际: {串集:?}"
        );
        断言!(英文词串("赋值给 `x` 的值从未被读取").是否为空());
    }

    /// 「未使用变量」告警的「赋值但从未使用」通配段键：动态变量名回填、无英文残留
    #[测试]
    函数 通配段赋值未使用() {
        让 表 = 建表(
            "[\"消息翻译\".\"variable `?` is assigned to, but never used\"]\n\"消息模板\" = \"`{q0}` 被赋值但从未使用\"",
        );
        断言相等!(
            审计消息(&表, "main", "unused_variables", "variable `x` is assigned to, but never used")
                .残留,
            向量::<字符串>::新建(),
            "补键后应无英文残留"
        );
    }

    /// 两端动态：通配段键一次拿齐两个动态名
    #[测试]
    函数 通配段两端动态() {
        让 表 = 建表(
            "[\"消息翻译\".\"the trait `?` is not implemented for `?`\"]\n\"消息模板\" = \"特征 `{q0}` 未对 `{q1}` 实现\"",
        );
        断言相等!(
            渲染(&表, "the trait `std::fmt::Display` is not implemented for `HashMap<&str, i32>`")
                .作为解引用(),
            有值("特征 `std::fmt::Display` 未对 `HashMap<&str, i32>` 实现")
        );
    }

    /// 多通配：非贪婪逐个切分
    #[测试]
    函数 通配段三捕获非贪婪() {
        让 表 = 建表(
            "[\"消息翻译\".\"the lifetime `'a` may only live as long as one of `?`'s ? or one of `?`'s ?\"]\n\"消息模板\" = \"`a` 只能与 `{q0}` 或 `{q2}` 的引用同长存活\"",
        );
        让 原文 = "the lifetime `'a` may only live as long as one of `a' and `b' and `c`'s 2 lifetimes or one of `d`'s 2 lifetimes";
        断言相等!(
            渲染(&表, 原文).作为解引用(),
            有值("`a` 只能与 `a' and `b' and `c` 或 `d` 的引用同长存活")
        );
    }

    /// 特异度：通配段键优先于更长的前缀/后缀键
    #[测试]
    函数 通配段优先前后缀() {
        让 表 = 建表(
            "[\"消息翻译\".\"the trait `\"]\n\"消息模板\" = \"特征 `{q0}`\"\n\
             [\"消息翻译\".\"~ is not implemented for `\"]\n\"消息模板\" = \"未实现尾巴\"\n\
             [\"消息翻译\".\"the trait `?` is not implemented for `?`\"]\n\"消息模板\" = \"特征 `{q0}` 未对 `{q1}` 实现\"",
        );
        断言相等!(
            渲染(&表, "the trait `Debug` is not implemented for `Foo`").作为解引用(),
            有值("特征 `Debug` 未对 `Foo` 实现")
        );
    }

    /// 多通配段键同时命中时取字面量更长者
    #[测试]
    函数 更具体通配键胜出() {
        让 表 = 建表(
            "[\"消息翻译\".\"`?` and `?`\"]\n\"消息模板\" = \"宽松\"\n\
             [\"消息翻译\".\"variants `?` and `?` are never constructed\"]\n\"消息模板\" = \"变体 `{q0}` 与 `{q1}` 从未被构造\"",
        );
        断言相等!(
            渲染(&表, "variants `Red` and `Green` are never constructed").作为解引用(),
            有值("变体 `Red` 与 `Green` 从未被构造")
        );
    }

    /// 无占位符的通配键：整句改写，不粘回英文残段
    #[测试]
    函数 无占位通配整句改写() {
        让 表 = 建表(
            "[\"消息翻译\".\"this trait has no implementations, `?` adding `?`\"]\n\"消息模板\" = \"该特征无任何实现\"",
        );
        断言相等!(
            渲染(&表, "this trait has no implementations, `X` adding `Y`").作为解引用(),
            有值("该特征无任何实现")
        );
    }

    /// 精确匹配仍优先于通配段键
    #[测试]
    函数 精确优先通配() {
        让 表 = 建表(
            "[\"消息翻译\".\"the trait `?` is not implemented for `?`\"]\n\"消息模板\" = \"通配\"\n\
             [\"消息翻译\".\"the trait `A` is not implemented for `B`\"]\n\"消息模板\" = \"精确\"",
        );
        断言相等!(
            渲染(&表, "the trait `A` is not implemented for `B`").作为解引用(),
            有值("精确")
        );
        断言相等!(
            渲染(&表, "the trait `C` is not implemented for `D`").作为解引用(),
            有值("通配")
        );
    }

    /// 锚点不唯一时必须拒绝
    #[测试]
    函数 锚点不唯一拒绝() {
        让 表 = 建表(
            "[\"消息翻译\".\"this function's return type contains a borrowed value, but the signature does not say whether it is borrowed from `?` or `?`\"]\n\"消息模板\" = \"未说明借自 `{q0}` 还是 `{q1}`\"",
        );
        让 原文 = "this function's return type contains a borrowed value, but the signature does not say whether it is borrowed from `a` or `b`";
        断言相等!(渲染(&表, 原文).作为解引用(), 有值("未说明借自 `a` 还是 `b`"));
        让 坏 = 建表("[\"消息翻译\".\"borrowed from `?` or `?`\"]\n\"消息模板\" = \"误抓 `{q0}`\"");
        断言!(坏.按消息查询(原文).是否为无());
    }

    /// 字面量不匹配时不得误命中
    #[测试]
    函数 字面量失配不误命中() {
        让 表 = 建表(
            "[\"消息翻译\".\"the trait `?` is not implemented for `?`\"]\n\"消息模板\" = \"特征 `{q0}`\"",
        );
        断言!(表.按消息查询("totally different message").是否为无());
    }

    /// 捕获为空串时不假装消费
    #[测试]
    函数 空捕获回退() {
        让 表 = 建表("[\"消息翻译\".\"a?b?c\"]\n\"消息模板\" = \"{q0}/{q1}\"");
        让 (翻译条目, 残段) = 表.按消息查询("abbc").期望("通配段键应命中空捕获");
        让 残段 = 残段.期望("通配段键应携带捕获");
        让 (已填充, 已消费) = 填充动态占位(&翻译条目.消息模板, &残段);
        断言相等!(已填充, "{q0}/{q1}");
        断言!(!已消费);
    }

    /// 既有前缀键行为不变（残段回拼，零回归）
    #[测试]
    函数 前缀键行为不变() {
        让 表 = 建表("[\"消息翻译\".\"consider \"]\n\"消息模板\" = \"考虑 \"");
        断言相等!(
            渲染(&表, "consider making this binding mutable").作为解引用(),
            有值("考虑 making this binding mutable")
        );
    }

    /// 既有后缀键行为不变
    #[测试]
    函数 后缀键行为不变() {
        让 表 = 建表("[\"消息翻译\".\"~ is never used\"]\n\"消息模板\" = \"`{q0}` 从未被使用\"");
        断言相等!(
            渲染(&表, "function `helper` is never used").作为解引用(),
            有值("`helper` 从未被使用")
        );
    }

    /// 字面量切分正确性
    #[测试]
    函数 切分与字面量总长() {
        断言相等!(分割通配("a?b?c"), 向量!["a", "b", "c"]);
        断言相等!(分割通配("no wildcard"), 向量!["no wildcard"]);
        断言相等!(字面量总长("a?b?c"), 3);
        断言相等!(字面量总长("中文?"), 2);
    }

    /// 匹配段直接对抗：单/双/三捕获、非贪婪切分、空尾锚、各类失配返回无
    #[测试]
    函数 匹配段对抗() {
        断言相等!(匹配段("before `?` after", "before `std::io::Error` after"), 有值(向量!["std::io::Error"]));
        断言相等!(匹配段("`?` and `?`", "`x` and `y` and `z`"), 有值(向量!["x", "y` and `z"]));
        断言相等!(匹配段("[?][?][?]", "[a][b][c]"), 有值(向量!["a", "b", "c"]));
        断言相等!(匹配段("prefix ?", "prefix tail goes to end"), 有值(向量!["tail goes to end"]));
        断言相等!(匹配段("? suffix", "x suffix"), 无);
        断言相等!(匹配段("abc?def", "abXdef"), 无);
        断言相等!(匹配段("abc?def", "abcdefXX"), 无);
        断言相等!(匹配段("a?x?b", "ayyb"), 无);
        断言相等!(匹配段("abc?def", "ab"), 无);
        断言相等!(匹配段("a?b", "ab"), 有值(向量![""]));
    }

    /// 英文词串阈值与切分对抗
    #[测试]
    函数 英文词串阈值() {
        断言!(英文词串("").是否为空());
        断言!(英文词串("``, ，。").是否为空());
        断言!(英文词串("one two three").是否为空());
        断言相等!(英文词串("one two three four"), 向量!["one two three four"]);
        断言相等!(英文词串("aaa bbb 123 ccc ddd eee fff"), 向量!["ccc ddd eee fff"]);
        断言相等!(英文词串("foo1 bar2 baz3 qux4"), 向量!["foo1 bar2 baz3 qux4"]);
        断言相等!(英文词串("word `a` word2, word3 word4"), 向量!["word a word2 word3 word4"]);
        断言相等!(英文词串("let x 赋值 alpha beta gamma"), 向量!["let x alpha beta gamma"]);
        断言!(英文词串("let x = 1;").是否为空());
    }
}
