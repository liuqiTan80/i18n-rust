//! JSON 解析与格式化输出、未解析导入检测（CLI / LSP 共用）。

使用 超级::诊断模型::编译器诊断;
使用 超级::教学诊断记录::教学诊断;

/// 解析 rustc/cargo 的 JSON 诊断输出（逐行 JSON 对象）
///
/// 支持两种格式：
/// - rustc 直接输出：每行一个完整的诊断 JSON 对象
/// - cargo --message-format=json 包装：诊断嵌套在顶层消息字段中
公开 函数 解析诊断输出(输出文本: &文本) -> 向量<编译器诊断> {
    让 可变 结果集 = 向量::新建();
    对于 当前行 在 输出文本.逐行() {
        让 当前行 = 当前行.裁剪();
        如果 当前行.是否为空() || !当前行.以开头('{') {
            继续;
        }
        如果 让 成功(诊断) = JSON序列化::解析字符串::<编译器诊断>(当前行) {
            结果集.推入(诊断);
        } 否则 如果 让 成功(值对象) = JSON序列化::解析字符串::<JSON序列化::JSON值>(当前行) {
            // cargo --message-format=json 的 compiler-message 包装行：
            // 完整诊断嵌套在顶层消息字段中（build-finished 等行无消息对象，自动跳过）
            如果 让 成功(诊断) =
                JSON序列化::解析值::<编译器诊断>(值对象["message"].克隆())
            {
                结果集.推入(诊断);
            }
        }
    }
    结果集
}

/// 格式化后的诊断信息（用于文本输出）
公开 结构体 诊断文本格式 {
    公开 级别文字: 字符串,
    公开 码文字: 字符串,
    公开 诊断消息: 字符串,
    公开 位置描述集: 向量<字符串>,
    公开 提示集: 向量<字符串>,
}

实现 教学诊断 {
    /// 格式化为结构化诊断
    公开 函数 取格式(&自我) -> 诊断文本格式 {
        让 级别文字 = 自我.级别.显示文字().转字符串();
        让 码文字 = 自我.错误码
            .作为引用方法()
            .映射(|码| 格式化!("[{}]", 码))
            .取值或默认();

        让 位置描述集 = 自我.位置集
            .迭代()
            .过滤(|该位置| 该位置.是否主因)
            .映射(|该位置| {
                让 可变 说明 = 格式化!(
                    "  --> {}:{}:{}", 该位置.文件名称, 该位置.起始行号, 该位置.起始列号
                );
                如果 让 有值(标签) = &该位置.标签文本 {
                    说明 = 格式化!("{}\n      {}", 说明, 标签);
                }
                说明
            })
            .收集();

        诊断文本格式 {
            级别文字,
            码文字,
            诊断消息: 自我.译文消息.克隆(),
            位置描述集,
            提示集: 自我.提示集.克隆(),
        }
    }

    /// 格式化为文本（可直接输出到终端）
    公开 函数 作为文字输出(&自我) -> 字符串 {
        让 格式化结果 = 自我.取格式();
        让 可变 输出文本 = 字符串::新建();

        // 第一行：错误级别 + 错误码 + 消息
        输出文本.推入字符串(&格式化!(
            "{}{}: {}\n",
            格式化结果.级别文字, 格式化结果.码文字, 格式化结果.诊断消息
        ));

        // 位置信息（只显示第一个主要位置）
        如果 让 有值(该位置) = 自我.位置集.迭代().查找(|该位置| 该位置.是否主因) {
            输出文本.推入字符串(&格式化!(
                "  --> {}:{}:{}\n",
                该位置.文件名称, 该位置.起始行号, 该位置.起始列号
            ));
            如果 让 有值(源码) = &该位置.源码文本 {
                输出文本.推入字符串(&格式化!("   | {}\n", 源码));
            }
        }

        // 所有权错误叙事提示
        如果 让 有值(详情) = &自我.所有权详情 {
            输出文本.推入字符串(&格式化!("📌 {}\n", 详情.叙事文本()));
        }

        // 教学提示（全部输出；此前仅取首条，其余被静默丢弃）
        对于 提示 在 &自我.提示集 {
            输出文本.推入字符串(&格式化!("💡 {}\n", 提示));
        }

        输出文本
    }

    /// 批量格式化为文本
    公开 函数 批量作为文字输出(诊断集: &[教学诊断]) -> 字符串 {
        让 可变 输出文本 = 字符串::新建();
        对于 (序号, 诊断) 在 诊断集.迭代().枚举() {
            如果 序号 > 0 {
                输出文本.推入字符串("\n---\n\n");
            }
            输出文本.推入字符串(&诊断.作为文字输出());
        }
        输出文本
    }
}

/// 判断诊断消息是否为未解析导入类错误（英文原文匹配）
///
/// 覆盖 rustc E0432（`unresolved import`）与 E0433 两种消息格式，
/// 后者原文为 `failed to resolve: use of undeclared crate or module`。
公开 函数 是否未解析导入消息(全文: &文本) -> 布尔 {
    全文.包含("unresolved import") || 全文.包含("use of undeclared crate or module")
}

/// 提取消息中所有反引号包裹路径的首段（:: 分隔）
///
/// 仅取形如路径的内容（标识符字符与 ::），过滤含空格的自由文本；
/// 翻译后的诊断同样保留反引号内容，故母语/英文消息均可提取。
公开 函数 取反引号首段(全文: &文本) -> 向量<字符串> {
    让 可变 段集 = 向量::新建();
    让 可变 剩余 = 全文;
    当 让 有值(首处) = 剩余.查找('`') {
        让 后半 = &剩余[首处 + 1..];
        让 有值(尾处) = 后半.查找('`') 否则 { 中断 };
        让 内部 = &后半[..尾处];
        剩余 = &后半[尾处 + 1..];
        如果 !内部.是否为空()
            && 内部
                .逐字符()
                .全部(|每字符| 每字符.是否为字母数字() || 每字符 == '_' || 每字符 == ':')
        {
            让 首段 = 内部.分割("::").下一个().取值或(内部);
            如果 !首段.是否为空() {
                段集.推入(首段.转字符串());
            }
        }
    }
    段集
}

/// 从未解析导入消息提取候选包名（去重，排除标准库与保留路径）
///
/// 非未解析导入消息返回空列表。供 CLI 编译诊断提示与 LSP
/// 快捷修复代码动作共用：提示用户通过 `rzc add <crate>` 添加依赖。
/// 包名必须是 ASCII（字母/数字/下划线/连字符）；母语标识符
/// （如漏写 `包::` 前缀的中文模块名 "数据模型"）不是包名，
/// 提示 `rzc add 数据模型` 只会误导用户。
公开 函数 未解析包候选(全文: &文本) -> 向量<字符串> {
    如果 !是否未解析导入消息(全文) {
        返回 向量::新建();
    }
    常量 标准路径集: &[&文本] =
        &["std", "core", "alloc", "self", "super", "crate", "proc_macro"];
    让 可变 结果集 = 向量::新建();
    对于 段 在 取反引号首段(全文) {
        如果 标准路径集.包含(&段.作为字符串())
            || 段.逐字符().下一个().有值且(|每字符| 每字符.是数字字符())
            || !段.是否为ASCII()
        {
            继续;
        }
        如果 !结果集.包含(&段) {
            结果集.推入(段);
        }
    }
    结果集
}
