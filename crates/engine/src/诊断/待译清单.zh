//! 英文残留兜底与待译清单
//!
//! 背景：消息表（errors.toml 的「消息翻译」节）覆盖哪些句子，静态检查看不全
//! ——只有真跑编译器/构建工具才知道今天会吐哪些新句子。旧行为是「未命中就
//! 静默原样输出英文」：用户看到中英夹杂却无从反馈，维护者也收不到「哪句漏了」
//! 的信号，只能靠实跑撞见。
//!
//! 本模块把这条反馈链固化成机制：
//!
//! 1. **兜底**：译文缺失/残段未译时，渲染照旧回拼原文（绝不吞诊断），
//!    但调用方在**本轮结束时**统一提示一次「有 N 条消息暂无译文，已按原文显示」，
//!    不再让用户以为这是产品行为；逐条加前缀会污染输出，故只在汇总行说明。
//! 2. **待译清单**：每条未译记录（语言/通道/错误码/消息原文）去重后按语言分档
//!    落盘到 `~/.rz/gaps/` 目录，格式与语料门禁清单同构
//!    （通道列取主消息级、建议级、工具级三值），维护者拿到清单即可补表；
//!    补完后用 `rzc gaps --clear` 清零。
//!
//! 恒等语言例外：英语的「原文」就是母语输出，所以 [`登记缺口`] 对
//! [`包::语言::是恒等语言`] 直接返回，不登记也不落盘。否则英语用户每次报错
//! 都会多一行「有 N 条消息暂无译文」，`~/.rz/gaps/en.tsv` 也会积成一份无法
//! 补表的清单（实测曾积 1000+ 行）。
//!
//! 清单每行只有一个字段能装下整条记录，所以消息原文里的换行与制表符在落盘前
//! 会被转成字面量（见 [`编码缺口字段`]）。

使用 标准库::集合::有序集;
使用 标准库::路径::{路径类型, 路径缓冲};
使用 标准库::同步::{互斥锁, 一次性锁};

/// 一条未译记录：`(语言, 通道, 错误码, 消息原文)`
公开 类型 待译记录 = (字符串, 字符串, 字符串, 字符串);

/// 主消息通道（与语料门禁同义）
公开 常量 主消息级: &文本 = "main";
/// 建议子诊断通道（与语料门禁同义）
公开 常量 建议级: &文本 = "help";
/// 构建工具纯文本通道（非 JSON 输出）
公开 常量 工具级: &文本 = "tool";

/// 进程内去重登记表（同一轮重复报错只记一次）
函数 登记表<'甲>() -> &'甲 互斥锁<有序集<待译记录>> {
    静态 登记缓存: 一次性锁<互斥锁<有序集<待译记录>>> = 一次性锁::新建();
    登记缓存.取得或初始化(|| 互斥锁::新建(有序集::新建()))
}

/// 登记一条未译消息（原文照旧显示，仅记录待补线索）
///
/// 空消息不记（无补表价值）。语言为空时取当前界面语言。恒等语言（英语）不记。
公开 函数 登记缺口(语言: &文本, 此级: &文本, 错误码: &文本, 全文: &文本) {
    让 全文 = 全文.裁剪();
    如果 全文.是否为空() {
        返回;
    }
    让 语言 = 如果 语言.是否为空() {
        包::语言::当前语言()
    } 否则 {
        语言.转字符串()
    };
    如果 包::语言::是恒等语言(&语言) {
        返回;
    }
    让 记录 = (语言, 此级.转字符串(), 错误码.转字符串(), 全文.转字符串());
    如果 让 成功(可变 登记集) = 登记表().加锁() {
        登记集.置入(记录);
    }
}

/// 取出并清空本轮登记（调用方负责落盘与提示，避免重复处理）
公开 函数 取出缺口() -> 向量<待译记录> {
    让 成功(可变 登记集) = 登记表().加锁() 否则 {
        返回 向量::新建();
    };
    标准库::内存::取值(&可变 *登记集).转迭代().收集()
}

/// 当前登记快照（不清空，供测试与只读查看）
公开 函数 查看缺口() -> 向量<待译记录> {
    登记表().加锁().映射(|登记集| 登记集.迭代().克隆副本().收集()).取值或默认()
}

/// 待译清单目录（主目录不可用时回退临时目录）
公开 函数 清单目录() -> 路径缓冲 {
    匹配 标准库::环境::环境变量("HOME").或用否则(|_| 标准库::环境::环境变量("USERPROFILE")) {
        成功(主目录) 如果 !主目录.是否为空() => 路径缓冲::从(主目录).连接(".rz").连接("gaps"),
        _ => 标准库::环境::临时目录().连接("rz-gaps"),
    }
}

/// 某语言的待译清单路径
公开 函数 清单项文件(语言: &文本) -> 路径缓冲 {
    清单目录().连接(格式化!("{}.tsv", 语言))
}

/// 一行清单文本（与 [`解析清单行`] 互逆）
函数 清单行(记录: &待译记录) -> 字符串 {
    让 (语言, 此级, 错误码, 全文) = 记录;
    格式化!("{语言}\t{此级}\t{错误码}\t{}", 编码缺口字段(全文))
}

/// 把消息原文编码成单行清单字段（先转义反斜杠，再处理换行、回车与制表符）
公开 函数 编码缺口字段(全文: &文本) -> 字符串 {
    全文
        .替换('\\', "\\\\")
        .替换('\n', "\\n")
        .替换('\r', "\\r")
        .替换('\t', "\\t")
}

/// [`编码缺口字段`] 的逆操作：把转义序列还原成真实字符
公开 函数 解码缺口字段(原始: &文本) -> 字符串 {
    让 可变 拼接串 = 字符串::带容量(原始.长度());
    让 可变 字符流 = 原始.逐字符();
    当 让 有值(每字符) = 字符流.下一个() {
        如果 每字符 != '\\' {
            拼接串.推(每字符);
            继续;
        }
        匹配 字符流.下一个() {
            有值('n') => 拼接串.推('\n'),
            有值('r') => 拼接串.推('\r'),
            有值('t') => 拼接串.推('\t'),
            有值('\\') => 拼接串.推('\\'),
            有值(其他) => {
                拼接串.推('\\');
                拼接串.推(其他);
            }
            // 结尾孤立反斜杠：原样保留，不吞字符
            无 => 拼接串.推('\\'),
        }
    }
    拼接串
}

/// 把行尾多出来的列拼回消息（历史未转义行里消息本身带制表符）
函数 制表尾(额外列: &[&文本]) -> 字符串 {
    额外列
        .迭代()
        .映射(|片段| 格式化!("\t{}", 片段))
        .收集::<向量<_>>()
        .连接("")
}

/// 是否为已知通道名（清单行形状的唯一依据）
函数 是已知通道(此列: &文本) -> 布尔 {
    此列 == 主消息级 || 此列 == 建议级 || 此列 == 工具级
}

/// 解析清单文本：容忍注释行与缺列（缺列按主消息级/空码处理）
///
/// 行形状按「第二列是不是通道名」判，不看首列长度；几类历史残缺（裸续行、
/// 未转义制表符）在这里一并收拾，续行拼回上一条记录的消息（还原真实换行）。
公开 函数 解析清单行(原始: &文本) -> 向量<待译记录> {
    让 可变 已解析: 向量<待译记录> = 向量::新建();
    对于 文本行 在 原始
        .逐行()
        .映射(|每行| 每行.去后缀('\r').取值或(每行))
        .过滤(|每行| !每行.裁剪().是否为空() && !每行.以开头('#'))
    {
        让 列集: 向量<&文本> = 文本行.分割('\t').收集();
        // 拼回上一条记录用：统一带换行前缀，尾随空白不带走格式信息
        让 折叠 = |主记录: &可变 待译记录, 尾段: &文本| {
            主记录.3.推('\n');
            主记录.3.推入字符串(尾段.裁剪右侧());
        };
        让 记录 = 匹配 列集.切片() {
            // 「语言\t通道\t错误码\t消息」：消息列本身可能含制表符
            [语言, 此级, 错误码, 其余 @ ..] 如果 是已知通道(此级) => (
                语言.转字符串(),
                此级.转字符串(),
                错误码.转字符串(),
                解码缺口字段(&其余.连接("\t")),
            ),
            // 语料门禁三列格式，语言取默认
            [此级, 错误码, 消息文, 额外列 @ ..] 如果 是已知通道(此级) => (
                包::语言::当前语言(),
                此级.转字符串(),
                错误码.转字符串(),
                解码缺口字段(&格式化!("{}{}", 消息文, 制表尾(额外列))),
            ),
            // 三列但第二列不是通道名：历史裸续行残行
            [语言, 错误码, 消息文, 额外列 @ ..] 如果 !语言.是否为空() => {
                让 尾段 = 匹配 (错误码.是否为空(), 消息文.是否为空()) {
                    (真, _) => *错误码,
                    (_, 真) => *消息文,
                    _ => &格式化!("{}\t{}{}", 错误码, 消息文, 制表尾(额外列)),
                };
                如果 已解析.最后一个().有值且(|记录| 记录.0 == *语言) {
                    如果 让 有值(主记录) = 已解析.可变末尾() {
                        折叠(主记录, 尾段);
                    }
                    继续;
                }
                (
                    语言.转字符串(),
                    主消息级.转字符串(),
                    错误码.转字符串(),
                    解码缺口字段(消息文),
                )
            }
            // 两列且首列是通道名：语料格式的缺消息列变体
            [此级, 消息文] 如果 是已知通道(此级) => (
                包::语言::当前语言(),
                此级.转字符串(),
                字符串::新建(),
                解码缺口字段(消息文),
            ),
            // 两列且首列不是通道名：缺列变体
            [语言, 消息文] 如果 !语言.是否为空() => (
                语言.转字符串(),
                主消息级.转字符串(),
                字符串::新建(),
                解码缺口字段(消息文),
            ),
            // 单列：优先当作上一条记录的裸续行拼回
            [消息文] => {
                如果 让 有值(主记录) = 已解析.可变末尾() {
                    折叠(主记录, 消息文);
                    继续;
                }
                (
                    包::语言::当前语言(),
                    主消息级.转字符串(),
                    字符串::新建(),
                    解码缺口字段(消息文),
                )
            }
            // 无主记录的残行：拼回上一条记录
            [..] => {
                如果 让 有值(主记录) = 已解析.可变末尾() {
                    折叠(主记录, 文本行);
                }
                继续;
            }
        };
        如果 !已解析.包含(&记录) {
            已解析.推入(记录);
        }
    }
    已解析
}

/// 把本轮登记合并写入清单文件（去重），返回新增条数
///
/// 采用**整档重写**而非追加，顺带完成历史裸行的格式迁移；写盘失败不阻断主流程。
公开 函数 落盘缺口至目录(目录: &路径类型, 记录集: &[待译记录]) -> 无符号机器整数 {
    如果 记录集.是否为空() {
        返回 0;
    }
    让 可变 新增数 = 0无符号机器整数;
    对于 语言 在 记录集.迭代().映射(|记录| 记录.0.克隆()).收集::<有序集<_>>() {
        让 本轮: 向量<&待译记录> = 记录集.迭代().过滤(|记录| 记录.0 == 语言).收集();
        让 文件路径 = 目录.连接(格式化!("{}.tsv", 语言));
        让 原始 = 标准库::文件系统::读取字符串(&文件路径).取值或默认();
        让 可变 已存在 = 解析清单行(&原始);
        让 可变 新增: 向量<&待译记录> = 向量::新建();
        对于 记录 在 本轮 {
            如果 !已存在.包含(记录) {
                已存在.推入(记录.克隆());
                新增.推入(记录);
            }
        }
        新增数 += 新增.元素数();
        如果 新增.是否为空() {
            // 本轮无新记录：不动盘
            继续;
        }
        如果 让 有值(父目录) = 文件路径.父目录()
            && 标准库::文件系统::递归创建目录(父目录).是否为错误()
        {
            继续;
        }
        已存在.排序();
        让 文本内容 = 已存在.迭代().映射(清单行).收集::<向量<_>>().连接("\n");
        让 临时档 = 目录.连接(格式化!(".{}.tsv.tmp", 语言));
        如果 标准库::文件系统::写入(&临时档, 格式化!("{}\n", 文本内容)).是否为错误()
            || 标准库::文件系统::重命名(&临时档, &文件路径).是否为错误()
        {
            让 _ = 标准库::文件系统::删除文件(&临时档);
        }
    }
    新增数
}

/// [`落盘缺口至目录`] 的默认目录版本
公开 函数 落盘缺口(记录集: &[待译记录]) -> 无符号机器整数 {
    落盘缺口至目录(&清单目录(), 记录集)
}

/// 读取某语言已积累的待译清单
公开 函数 读取缺口(语言: &文本) -> 向量<待译记录> {
    标准库::文件系统::读取字符串(清单项文件(语言))
        .映射(|原始| 解析清单行(&原始))
        .取值或默认()
}

/// 清空某语言的待译清单（补完表后归零），返回是否确实删除了文件
公开 函数 清空缺口(语言: &文本) -> 布尔 {
    标准库::文件系统::删除文件(清单项文件(语言)).是否为成功()
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;
    使用 标准库::同步::互斥守卫;

    静态 登记测试锁: 互斥锁<()> = 互斥锁::新建(());

    函数 串行登记<'甲>() -> 互斥守卫<'甲, ()> {
        匹配 登记测试锁.加锁() {
            成功(守卫) => 守卫,
            错误(中毒) => 中毒.取内层(),
        }
    }

    #[测试]
    函数 记录取出查看往返() {
        让 _串行 = 串行登记();
        让 记录 = (
            "tstlang".转字符串(),
            主消息级.转字符串(),
            "E9999".转字符串(),
            "unique message A".转字符串(),
        );
        登记表().加锁().解包().置入(记录.克隆());
        断言!(查看缺口().包含(&记录));
        让 已取出 = 取出缺口();
        断言!(已取出.包含(&记录), "取出应含已登记记录");
        断言!(!查看缺口().包含(&记录), "取出后应清空");
    }

    #[测试]
    函数 空白消息不登记() {
        让 _串行 = 串行登记();
        登记缺口("tstempty", 建议级, "", "   ");
        断言!(
            !查看缺口().迭代().任意(|记录| 记录.0 == "tstempty"),
            "空白消息不应进入待译登记"
        );
    }

    #[测试]
    函数 恒等语言不登记() {
        让 _串行 = 串行登记();
        让 待译消息 = "crate name `计算器` passed to `--extern` is not a valid ASCII identifier";
        登记缺口("en", 工具级, "", 待译消息);
        断言!(
            !查看缺口().迭代().任意(|记录| 记录.0 == "en" && 记录.3 == 待译消息),
            "en 是恒等语言，未命中消息表不算待译"
        );
        登记缺口("de", 工具级, "", 待译消息);
        断言!(
            查看缺口().迭代().任意(|记录| 记录.0 == "de" && 记录.3 == 待译消息),
            "de 不是恒等语言，同一句应照常登记待译"
        );
    }

    #[测试]
    函数 恒等语言作用于当前语言回退() {
        让 _串行 = 串行登记();
        让 _守卫 = 包::语言::钉住语言("en");
        让 待译消息 = "an english message with no entry in the identity pack";
        登记缺口("", 主消息级, "", 待译消息);
        断言!(
            !查看缺口().迭代().任意(|记录| 记录.3 == 待译消息),
            "界面语言为 en 时也不得登记待译"
        );
    }

    #[测试]
    函数 清单行往返与容错() {
        让 记录 = (
            "zh".转字符串(),
            工具级.转字符串(),
            字符串::新建(),
            "failed to parse manifest at `/x/Cargo.toml`".转字符串(),
        );
        让 文本内容 = 格式化!("# 注释\n\n{}\n", 清单行(&记录));
        让 已解析 = 解析清单行(&文本内容);
        断言相等!(已解析, 向量![记录]);
        让 三列 = "help\t\tthe trait `?` is not implemented";
        让 已解析 = 解析清单行(三列);
        断言相等!(已解析.元素数(), 1);
        断言相等!(已解析[0].1, "help");
        断言相等!(已解析[0].3, "the trait `?` is not implemented");
    }

    #[测试]
    函数 多行消息落盘为一行() {
        让 待译消息 = "the following other types implement trait `Add<Rhs>`:\n  `&f16` implements `Add<f16>`\n  `&f64` implements `Add<f64>`\nand 56 others";
        让 记录 = (
            "ztml".转字符串(),
            主消息级.转字符串(),
            "E0277".转字符串(),
            待译消息.转字符串(),
        );
        让 文本行 = 清单行(&记录);
        断言相等!(文本行.逐行().计数(), 1, "多行消息不得拆成多行");
        断言相等!(文本行.分割('\t').计数(), 4, "一行恰好四列");
        断言相等!(解析清单行(&文本行), 向量![记录.克隆()]);

        让 带页 = (
            "ztml".转字符串(),
            工具级.转字符串(),
            字符串::新建(),
            "first\tsecond".转字符串(),
        );
        让 文本行 = 清单行(&带页);
        断言相等!(文本行.分割('\t').计数(), 4, "消息里的制表符不得多开列");
        断言相等!(解析清单行(&文本行), 向量![带页]);

        让 含字面量 = r#"expected `\n` in input"#;
        断言相等!(
            解码缺口字段(&编码缺口字段(含字面量)),
            含字面量,
            "消息里的换行字面量应原样往返"
        );
    }

    #[测试]
    函数 历史裸续行拼回() {
        让 原始 = "ja\thelp\tE0277\tthe following other types implement trait `Add<Rhs>`:\n  `&f16` implements `Add<f16>`\n  `&f64` implements `Add<f64>`\nand 56 others\nja\tmain\t\tstandalone message\n";
        让 已解析 = 解析清单行(原始);
        断言相等!(已解析.元素数(), 2, "跨行记录 + 独立记录 = 2 条，不是 5 条");
        断言相等!(已解析[0].0, "ja", "拼回的续行不得改变语言归属");
        断言相等!(
            已解析[0].3,
            "the following other types implement trait `Add<Rhs>`:\n  `&f16` implements `Add<f16>`\n  `&f64` implements `Add<f64>`\nand 56 others"
        );
        断言相等!(已解析[1].3, "standalone message");

        让 文本行 = 清单行(&已解析[0]);
        断言相等!(文本行.逐行().计数(), 1);
        断言相等!(解析清单行(&文本行), 向量![已解析[0].克隆()]);

        让 开头裸行 = "orphan tail\nzh\tmain\t\treal message\n";
        让 已解析 = 解析清单行(开头裸行);
        断言相等!(已解析.元素数(), 2, "无主续行不能吞掉后面的正常记录");
        断言相等!(已解析[0].3, "orphan tail");
        断言相等!(已解析[1].3, "real message");
    }

    #[测试]
    函数 落盘跨轮去重() {
        让 目录 = 临时文件::建临时目录().解包();
        让 可变 记录集 = 向量![
            (
                "zhtest".转字符串(),
                主消息级.转字符串(),
                "E0000".转字符串(),
                "first message".转字符串(),
            ),
            (
                "zhtest".转字符串(),
                建议级.转字符串(),
                字符串::新建(),
                "help message".转字符串(),
            ),
        ];
        记录集.排序();
        断言相等!(落盘缺口至目录(目录.条目路径(), &记录集), 2);
        断言相等!(落盘缺口至目录(目录.条目路径(), &记录集), 0, "重复登记不应翻倍");
        让 读回 = 解析清单行(&标准库::文件系统::读取字符串(目录.条目路径().连接("zhtest.tsv")).解包());
        断言相等!(读回, 记录集);
    }

    #[测试]
    函数 落盘迁移历史多行文件() {
        让 目录 = 临时文件::建临时目录().解包();
        让 文件路径 = 目录.条目路径().连接("mlang.tsv");
        标准库::文件系统::写入(
            &文件路径,
            "mlang\thelp\tE0277\tthe following other types implement trait `Add<Rhs>`:\n  `&f16` implements `Add<f16>`\nand 56 others\n",
        )
        .解包();

        让 同一句 = (
            "mlang".转字符串(),
            建议级.转字符串(),
            "E0277".转字符串(),
            "the following other types implement trait `Add<Rhs>`:\n  `&f16` implements `Add<f16>`\nand 56 others".转字符串(),
        );
        让 新记录 = (
            "mlang".转字符串(),
            主消息级.转字符串(),
            字符串::新建(),
            "a brand new english message".转字符串(),
        );
        断言相等!(
            落盘缺口至目录(目录.条目路径(), &[同一句.克隆(), 新记录]),
            1,
            "已存在的多行记录不得再算新增"
        );
        让 文本内容 = 标准库::文件系统::读取字符串(&文件路径).解包();
        断言相等!(文本内容.逐行().计数(), 2, "迁移后一行一条记录");
        断言相等!(文本内容.模式匹配("and 56 others").计数(), 1, "同一句不得重复落盘");

        让 先前 = 标准库::文件系统::读取字符串(&文件路径).解包();
        断言相等!(落盘缺口至目录(目录.条目路径(), &[同一句]), 0);
        断言相等!(
            标准库::文件系统::读取字符串(&文件路径).解包(),
            先前,
            "无新增时不应改动文件"
        );
        断言相等!(
            解析清单行(&先前).迭代().过滤(|记录| 记录.0 == "mlang").计数(),
            2,
            "rzc gaps 的条数应等于待译句子数"
        );
    }
}
