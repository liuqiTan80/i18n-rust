// 诊断翻译器：结合错误消息翻译表与类型映射，将 rustc 的英文诊断
// 转化为面向母语学习者的教学诊断信息。

使用 std::collections::哈希映射;

使用 超级::教学::{诊断级别, 诊断位置, 教学诊断, 抽取所有权详情};
使用 超级::诊断模型::编译器诊断;
使用 超级::消息翻译::{错误翻译管理器, 填充动态占位符};
使用 包::映射管理::映射管理器;

/// 诊断翻译器：将 rustc 诊断翻译为教学诊断
///
/// 结合错误消息翻译表和类型映射，将 rustc 的英文诊断转化为
/// 面向中文学习者的教学诊断信息。
公开 结构体 诊断翻译器 {
    翻译管理器: 错误翻译管理器,
    类型映射表: 哈希映射<字符串, 字符串>, // 来自关键字映射表，用于替换消息中的英文类型
}

/// 对带模块路径的类型名做最长后缀匹配
///
/// `std::fmt::Display` 逐段尝试（fmt::Display → Display），命中映射段后
/// 保留原路径前缀，仅替换命中段：`std::fmt::Display` → `std::fmt::显示`。
公开(包) 函数 替换类型段(
    标记: &文本,
    类型映射表: &哈希映射<字符串, 字符串>,
) -> 选项<字符串> {
    让 段列表: 向量<&文本> = 标记.split("::").collect();
    对于 序号 in 1..段列表.len() {
        让 后缀 = 段列表[序号..].join("::");
        如果让 有值(母语) = 类型映射表.get(&后缀) {
            让 可变 转换结果 = 段列表[..序号].join("::");
            如果 !转换结果.is_empty() {
                转换结果.push_str("::");
            }
            转换结果.push_str(母语);
            返回 有值(转换结果);
        }
    }
    无
}

/// 本地化带模块路径的类型名（三段式）
///
/// 1. 类型后缀段映射：`std::fmt::Display` → `std::fmt::可显示`
/// 2. 路径前缀完整匹配（从长到短）：`std::fmt` → `标准库::格式化`（或 `std` → `标准库`）
/// 3. 剩余中间段单段映射：`fmt` → `格式化`
///    最终：`std::fmt::Display` → `标准库::格式化::可显示`；
///    仅含路径（如 `std::io::Error`）未命中任何段时返回 None 保持原样。
公开(包) 函数 本地化类型段(标记: &文本, 映射: &哈希映射<字符串, 字符串>) -> 选项<字符串> {
    让 原文 = 标记.to_string();
    // 1. 类型后缀段映射
    让 转换结果 = 替换类型段(标记, 映射).unwrap_or_else(|| 标记.to_string());
    // 2. 路径前缀完整匹配（从长到短）
    让 可变 段列表: 向量<字符串> = 转换结果.split("::").map(|段项| 段项.to_string()).collect();
    如果 段列表.len() >= 2 {
        对于 序号 in (1..段列表.len()).rev() {
            让 前缀 = 段列表[..序号].join("::");
            如果让 有值(母语) = 映射.get(&前缀) {
                让 其余 = 段列表[序号..].join("::");
                段列表 = 向量![母语.clone()];
                段列表.extend(其余.split("::").map(|段项| 段项.to_string()));
                中断;
            }
        }
        // 3. 剩余中间段单段映射（跳过首尾，避免误伤已替换的路径与类型段）
        对于 序号 in 1..段列表.len().saturating_sub(1) {
            如果让 有值(母语) = 映射.get(&段列表[序号]) {
                段列表[序号] = 母语.clone();
            }
        }
    }
    让 转换结果 = 段列表.join("::");
    (转换结果 != 原文).then_some(转换结果)
}

/// 统计类型字符串开头的引用层数（`&` 前缀个数）
///
/// 规则：连续 strip `&` 前缀，遇 `mut`（含 `mut ` / `mut` 结尾）即停止
/// —— `&mut T` 是单层可变引用，不算两层。
/// 示例：`&String` → 1，`&&String` → 2，`&mut String` → 1，`String` → 0。
公开(包) 函数 计数引用前缀(类型串: &文本) -> 无符号机器整数 {
    让 可变 剩余 = 类型串;
    让 可变 计数 = 0;
    当让 有值(之后) = 剩余.strip_prefix('&') {
        计数 += 1;
        如果 之后.starts_with("mut ") || 之后 == "mut" || 之后.starts_with("mut\t") {
            中断;
        }
        剩余 = 之后;
    }
    计数
}

/// 本地化引用类型：先整体查 type_map（如 `&str` → `字符串引用`），
/// 未命中时拆开 `&` 前缀，对本体做类型本地化后拼回
/// （如 `&String` → `&字符串`、`&&i32` → `&&整数`）。
公开(包) 函数 本地化引用类型(类型串: &文本, 映射: &哈希映射<字符串, 字符串>) -> 字符串 {
    如果让 有值(母语) = 映射.get(类型串) {
        返回 母语.clone();
    }
    让 可变 前缀 = 字符串::新建();
    让 可变 剩余 = 类型串;
    当让 有值(之后) = 剩余.strip_prefix('&') {
        前缀.push('&');
        剩余 = 之后;
    }
    如果 前缀.is_empty() {
        返回 类型串.to_string();
    }
    让 (可变部分, 本体) = 匹配 剩余.strip_prefix("mut ") {
        有值(本体) => ("mut ", 本体),
        无 => ("", 剩余),
    };
    让 本体母语 = 映射
        .get(本体)
        .cloned()
        .or_else(|| 本地化类型段(本体, 映射))
        .unwrap_or_else(|| 本体.to_string());
    格式化!("{前缀}{可变部分}{本体母语}")
}

/// 提取 rustc "if you wanted to use a crate named `X`" 建议中的 crate 名
函数 建议包名(消息: &文本) -> 选项<&文本> {
    消息
        .strip_prefix("if you wanted to use a crate named `")
        .and_then(|剩余| 剩余.split('`').next())
        .filter(|名字| !名字.is_empty())
}

/// 从 `expected `X`, found `Y`` 形式的文本（rustc label）中提取期望/实际类型
函数 抽取期望实际(内容: &文本) -> 选项<(字符串, 字符串)> {
    让 位置 = 内容.find("expected ")?;
    让 之后 = &内容[位置 + "expected ".len()..];
    让 逗号位置 = 之后.find(", found ")?;
    让 期望 = 之后[..逗号位置].trim().trim_matches('`').to_string();
    让 实际 = 之后[逗号位置 + ", found ".len()..]
        .trim()
        .trim_matches('`')
        .to_string();
    有值((期望, 实际))
}

/// 整词替换：仅当目标前后字符均非标识符字符（字母/数字/下划线）时替换，
/// 避免裸词模式（如 integer）误伤 to_integer/integer_count 等标识符子串
公开(包) 函数 整词替换(内容: &文本, 来源: &文本, 目标: &文本) -> 字符串 {
    让 是标识符字符 = |字符项: 字符| 字符项.is_alphanumeric() || 字符项 == '_';
    让 可变 转换结果 = 字符串::with_capacity(内容.len());
    让 可变 剩余 = 内容;
    当让 有值(位置) = 剩余.find(来源) {
        让 结束 = 位置 + 来源.len();
        让 前合规 = 剩余[..位置]
            .chars()
            .next_back()
            .is_none_or(|字符项| !是标识符字符(字符项));
        让 后合规 = 剩余[结束..].chars().next().is_none_or(|字符项| !是标识符字符(字符项));
        转换结果.push_str(&剩余[..位置]);
        转换结果.push_str(如果 前合规 && 后合规 { 目标 } 否则 { 来源 });
        剩余 = &剩余[结束..];
    }
    转换结果.push_str(剩余);
    转换结果
}

/// 提取文本中所有反引号包裹的内容（按出现顺序）
函数 抽取反引号段(内容: &文本) -> 向量<字符串> {
    让 可变 段列表 = 向量::新建();
    让 可变 剩余 = 内容;
    当让 有值(起点) = 剩余.find('`') {
        让 之后 = &剩余[起点 + 1..];
        匹配 之后.find('`') {
            有值(终点) => {
                段列表.push(之后[..终点].to_string());
                剩余 = &之后[终点 + 1..];
            }
            无 => 中断,
        }
    }
    段列表
}

/// 从诊断消息中提取前两个反引号包裹的类型
///
/// rustc 1.97+ 的算术错误不再输出 label，类型信息嵌入 message，
/// 如 E0369：`cannot add `{integer}` to `&str``。
函数 从消息抽取类型(消息: &文本) -> 选项<(字符串, 字符串)> {
    让 段列表 = 抽取反引号段(消息);
    如果 段列表.len() >= 2 {
        有值((段列表[0].clone(), 段列表[1].clone()))
    } 否则 {
        无
    }
}

/// 由映射管理器构建诊断类型反查表（英文类型名 → 母语名），CLI 与 LSP 共用。
///
/// 数据来源与优先级（与历史 CLI 内联逻辑完全一致，抽出以消除两处漂移）：
/// keywords `[类型]` 节反转为主，stdlib/别名表仅补充缺失条目（不覆盖），
/// 模块路径映射（std → 标准库 等）覆盖同名第三方条目以稳定标准库路径翻译。
/// 仅收录「母语键」（含非 ASCII 字符）的反向项，避免把 `format`→`fmt` 之类
/// 纯英文修正项引入诊断译文（会让译文出现英文值）。
公开 函数 构建类型映射(管理器: &映射管理器) -> 哈希映射<字符串, 字符串> {
    让 是母语键 = |键: &文本| {
        !键.chars()
            .all(|字符项| 字符项.is_ascii_alphanumeric() || 字符项 == '_' || 字符项 == '-')
    };
    让 可变 反向映射: 哈希映射<字符串, 字符串> = 管理器
        .取节映射("类型")
        .map(|节| {
            节
                .iter()
                .filter(|(键, _)| 是母语键(键))
                .map(|(键, 值)| (值.clone(), 键.clone()))
                .collect()
        })
        .unwrap_or_default();
    对于 (母语, 英文) in 管理器.取别名映射表() {
        如果 是母语键(母语) {
            反向映射
                .entry(英文.clone())
                .or_insert_with(|| 母语.clone());
        }
    }
    对于 (母语, 英文) in 管理器.取模块路径映射表() {
        如果 是母语键(母语) {
            反向映射.insert(英文.clone(), 母语.clone());
        }
    }
    反向映射
}

/// 错误码模板（`[E0xxx]` 节）支持的动态占位符：按此顺序从消息原文反引号
/// 内容中依次回填。顺序须与各模板内占位符的出现先后相容（如 E0609 的
/// `{类型}` 先于 `{字段名}`、E0027 的 `{结构名}` 先于 `{字段名}`）；
/// 模板不含某占位符时不消费 token，故跨模板共用一份列表不会串位。
/// `{期望}`/`{实际}` 另有专门的 expected/found 提取逻辑，不在此列。
常量 码模板占位符: &[&文本] = &[
    "{变量名}",
    "{名称}",
    "{类型}",
    "{特征}",
    "{模块名}",
    "{字段名}",
    "{方法名}",
    "{函数名}",
    "{结构名}",
    "{关联类型}",
    "{特征名}",
    "{生命周期}",
];

/// [`诊断翻译器::渲染主消息`] 的返回：主消息译文与其教学提示。
#[派生(调试, 克隆)]
公开 结构体 渲染消息 {
    /// 已回填占位符并完成类型中文化的主消息译文
    公开 主消息文本: 字符串,
    /// 命中条目的教学提示（若有），供调用方按需追加
    公开 教学提示: 选项<字符串>,
}

实现 诊断翻译器 {
    /// 创建诊断翻译器
    公开 函数 新建翻译器(
        翻译管理器: 错误翻译管理器,
        类型映射表: 哈希映射<字符串, 字符串>,
    ) -> 自身 {
        自身 {
            翻译管理器,
            类型映射表,
        }
    }

    /// 仅凭 (错误码, 消息原文, 主 span 标签) 渲染主消息——CLI/LSP 同口径共享入口。
    ///
    /// 渲染链与 [`诊断翻译器::翻译诊断`] 的主消息分支一致：
    /// 错误码表优先（完整桩/静态模板）→ 消息表（精确/前缀/后缀/通配段 + `{qN}`
    /// 回填）→ 占位符按序回填 → `类型映射表` 类型中文化。区别在于不依赖完整
    /// `编译器诊断`：期望/实际取自 `主要标签`（rustc 主 span 标签），
    /// 其次从消息原文 `expected X, found Y`/前两个反引号类型提取；
    /// `{变量名}`/`{名称}`/`{类型}`/`{特征}` 按序取消息反引号内容。
    ///
    /// 安全兵：错误码模板存在无法回填的占位符时（如 rust-analyzer 把
    /// `expected/found` 放在 relatedInformation 而非主消息的 E0308）
    /// **回退消息表**而非输出英文或裸占位符——保证译文不劣于旧行为。
    /// 命中任一表返回 `Some`，两表皆未命中返回 `None`（调用方走轻量兵底）。
    公开 函数 渲染主消息(
        &自我,
        码: 选项<&文本>,
        消息: &文本,
        主要标签: 选项<&文本>,
    ) -> 选项<渲染消息> {
        让 码条目 = 码
            .filter(|码文本项| !码文本项.is_empty())
            .and_then(|码文本项| 自我.翻译管理器.码查询(码文本项));
        让 消息查询 = 自我.翻译管理器.按消息查询(消息);

        // 1. 错误码表优先（与 CLI `码条目.or_else(消息查询)` 对齐）
        如果让 有值(条目) = 码条目 {
            让 可变 模板 = 条目.消息模板.clone();
            让 期望实际 = 主要标签
                .and_then(抽取期望实际)
                .or_else(|| 抽取期望实际(消息))
                .or_else(|| 从消息抽取类型(消息));
            如果让 有值((期望, 实际)) = 期望实际
                && !期望.is_empty()
                && !实际.is_empty()
            {
                模板 = 模板
                    .replace("{期望}", &期望)
                    .replace("{实际}", &实际);
            }
            // 其余占位符按出现顺序从消息反引号内容回退填充
            让 可变 段迭代器 = 抽取反引号段(消息).into_iter();
            对于 占位符 in 码模板占位符 {
                如果 模板.contains(占位符) {
                    匹配 段迭代器.next() {
                        有值(标记) => 模板 = 模板.replace(占位符, &标记),
                        无 => 中断,
                    }
                }
            }
            // 仍有未回填占位符 → 码表桩无法从可用信息渲染 → 回退消息表（不出英文/裸占位符）
            让 未解决 = ["{期望}", "{实际}"]
                .iter()
                .chain(码模板占位符.iter())
                .any(|片段项| 模板.contains(片段项));
            如果 !未解决 {
                返回 有值(渲染消息 {
                    主消息文本: 自我.替换类型名(模板),
                    教学提示: 条目.教学提示.clone(),
                });
            }
        }

        // 2. 消息表（精确/前缀/后缀/通配段）+ `{qN}` 回填，额外补 类型映射表 类型中文化
        如果让 有值((条目, 残段)) = 消息查询 {
            让 可变 消息文本 = 条目.消息模板.clone();
            如果让 有值(残段) = 残段 {
                让 (已填充, 已消费) = 填充动态占位符(&消息文本, &残段);
                消息文本 = 已填充;
                如果 !已消费 {
                    消息文本.push_str(残段.文字());
                }
            }
            返回 有值(渲染消息 {
                主消息文本: 自我.替换类型名(消息文本),
                教学提示: 条目.教学提示.clone(),
            });
        }

        无
    }

    /// 翻译单条诊断信息
    公开 函数 翻译诊断(&自我, 诊断: &编译器诊断) -> 教学诊断 {
        让 错误码 = 诊断.诊断码.as_ref().map(|诊断码项| 诊断码项.码值.clone());

        让 码条目 = 错误码
            .as_deref()
            .and_then(|码| 自我.翻译管理器.码查询(码));
        // 无错误码或错误码未收录时，按消息原文匹配（[消息翻译] 节）；
        // 消息表查询所得保留匹配来源（前缀/后缀键），供动态部分回填
        让 消息查询 = 自我
            .翻译管理器
            .按消息查询(&诊断.诊断消息);
        让 命中条目 = 码条目.or_else(|| 消息查询.map(|(条目, _)| 条目));

        // 从主要 span 的 label 中提取 expected 和 found；
        // rustc 1.97+ 的算术错误（E0369 等）不再输出 label，类型信息
        // 直接嵌入 message（如 `cannot add `{integer}` to `&str``），
        // 因此提取失败时回退从 message 中解析反引号包裹的类型。
        让 主要标签 = 诊断
            .跨度列表
            .iter()
            .find(|跨度项| 跨度项.是主跨度)
            .and_then(|跨度项| 跨度项.标签.as_deref());

        让 (期望, 实际) = 主要标签
            .and_then(抽取期望实际)
            .or_else(|| 从消息抽取类型(&诊断.诊断消息))
            .unwrap_or_default();

        // 构建翻译消息
        让 翻译消息 = 如果让 有值(条目) = 命中条目 {
            让 可变 模板 = 条目.消息模板.clone();
            如果 !期望.is_empty() && !实际.is_empty() {
                模板 = 模板
                    .replace("{期望}", &期望)
                    .replace("{实际}", &实际);
            } 否则 如果 模板.contains("{期望}") || 模板.contains("{实际}") {
                // 无法提取期望/实际类型时回退 rustc 原文，避免输出裸占位符
                模板 = 诊断.诊断消息.clone();
            }
            // 动态部分回填仅对消息表条目生效（前缀/后缀键匹配时保留动态名，
            // 如 "did you mean " → "你是否想用 `foo`?"）；错误码条目是完整桩，
            // 回拼会在中文模板后粘上英文残段（如 E0624 的
            // "字段或方法是私有的year` is private"）。错误码条目需要展示动态
            // 名称时用 {名称} 等占位符（从消息反引号内容回退填充，见下方）。
            如果 码条目.is_none()
                && 让 有值((_, 有值(残段))) = 消息查询
            {
                让 (已填充, 已消费) = 填充动态占位符(&模板, &残段);
                模板 = 已填充;
                如果 !已消费 {
                    模板.push_str(残段.文字());
                }
            }
            // 对模板中的类型名进行中文化替换
            自我.替换类型名(模板)
        } 否则 {
            自我.替换类型名(诊断.诊断消息.clone())
        };

        让 可变 教学提示列表 = 向量::新建();
        如果让 有值(条目) = 命中条目
            && 让 有值(提示) = &条目.教学提示
        {
            教学提示列表.push(提示.clone());
        }
        对于 子诊断 in &诊断.子诊断 {
            如果 子诊断.诊断级别 == "help" {
                // "if you wanted to use a crate named `X`" 建议：crate 名规则不允许
                // 非 ASCII，中文名实为拼写错误的母语模块，建议 `cargo add 中文名`
                // 必然无效（如 `add 规则类型`）；静默丢弃，避免误导初学者。
                如果 建议包名(&子诊断.诊断消息).is_some_and(|名字| !名字.is_ascii()) {
                    继续;
                }
                // help 短语优先查消息表翻译（前缀匹配保留动态后缀），未命中保留原文
                让 提示 = 自我
                    .翻译管理器
                    .按消息查询(&子诊断.诊断消息)
                    .map(|(条目, 残段)| {
                        让 可变 消息文本 = 条目.消息模板.clone();
                        如果让 有值(残段) = 残段 {
                            // 模板含 {q0}/{q1} 捕获占位符时，从动态部分提取引号内容填充
                            //（如 "trait `Datelike` which provides `year` is never used" →
                            //  "特征 `Datelike` 从未被使用"）；
                            // 捕获完整覆盖时不再追加英文残段。
                            让 (已填充, 已消费) = 填充动态占位符(&消息文本, &残段);
                            消息文本 = 已填充;
                            如果 !已消费 {
                                消息文本.push_str(残段.文字());
                            }
                        }
                        消息文本
                    })
                    .unwrap_or_else(|| 子诊断.诊断消息.clone());
                教学提示列表.push(包::语言::查译("diag_fix_suggestion", &[&提示]));
            }
        }

        // E0308 引用层数教学提示：期望/实际类型均为引用或其中之一为引用、
        // 但引用层数不同（如 `expected `&String`, found `String``）时，
        // 追加一条检查 `&` 数量的提示，覆盖初学者最常见的借用错误之一。
        如果 错误码.as_deref() == 有值("E0308") && !期望.is_empty() && !实际.is_empty() {
            让 期望引用数 = 计数引用前缀(&期望);
            让 实际引用数 = 计数引用前缀(&实际);
            如果 期望引用数 != 实际引用数 && (期望引用数 > 0 || 实际引用数 > 0) {
                教学提示列表.push(包::语言::查译(
                    "diag_ref_depth_hint",
                    &[
                        &本地化引用类型(&期望, &自我.类型映射表),
                        &本地化引用类型(&实际, &自我.类型映射表),
                    ],
                ));
            }
        }

        让 位置列表 = 诊断
            .跨度列表
            .iter()
            .map(诊断位置::从跨度构造)
            .collect();

        // 所有权错误：提取叙事化详情（变量名、移动/借用、再次使用位置）
        让 所有权详情 = 错误码
            .as_deref()
            .and_then(|码| 抽取所有权详情(码, 诊断));

        // 翻译消息中含 {变量名} 占位符时，用提取到的变量名填充
        让 可变 翻译消息 = 翻译消息;
        如果让 有值(详情) = &所有权详情 {
            翻译消息 = 翻译消息.replace("{变量名}", &详情.变量名);
        }

        // 其余占位符（{变量名}/{名称}/{类型}/{特征}/{模块名}/{字段名} 等）
        // 按出现顺序从消息反引号内容回退填充，覆盖无 label 的错误
        //（E0384 重复赋值、E0433 未找到类型、E0583 模块文件缺失等）；
        // 提取不到时回退 rustc 原文，避免输出裸占位符。
        让 可变 段迭代器 = 抽取反引号段(&诊断.诊断消息).into_iter();
        对于 占位符 in 码模板占位符 {
            如果 翻译消息.contains(占位符) {
                匹配 段迭代器.next() {
                    有值(标记) => {
                        翻译消息 = 翻译消息.replace(占位符, &标记);
                    }
                    无 => {
                        翻译消息 = 诊断.诊断消息.clone();
                        中断;
                    }
                }
            }
        }
        // 占位符填充的才是运行时实际类型名，需再次中文化
        //（如 E0277 的 `std::fmt::Display` → `std::fmt::显示`、`{integer}` → `整数`）
        翻译消息 = 自我.替换类型名(翻译消息);

        让 子诊断列表 = 诊断
            .子诊断
            .iter()
            .map(|子| 自我.翻译诊断(子))
            .collect();

        教学诊断 {
            严重级别: 诊断级别::从文本解析(&诊断.诊断级别),
            错误码,
            翻译消息,
            原始消息: 诊断.诊断消息.clone(),
            教学提示: 教学提示列表,
            位置列表,
            子诊断: 子诊断列表,
            所有权详情,
        }
    }

    /// 使用类型映射替换消息中的英文类型名
    函数 替换类型名(&自我, 消息: 字符串) -> 字符串 {
        让 可变 转换结果 = 消息;
        // rustc 未推断字面量占位符（`{integer}`/`{float}`）及 1.97+ 裸显示名
        // （`integer`/`floating-point number`）按全局语言翻译；
        // 裸 integer 用整词匹配，避免误伤 to_integer/integer_count 等标识符
        转换结果 = 转换结果
            .replace("{integer}", &包::语言::查句("diag_rustc_integer"))
            .replace("{float}", &包::语言::查句("diag_rustc_float"))
            .replace(
                "floating-point number",
                &包::语言::查句("diag_rustc_float"),
            );
        转换结果 = 整词替换(&转换结果, "integer", &包::语言::查句("diag_rustc_integer"));
        // 类型映射：仅替换反引号包裹的完整类型名（rustc 诊断中的类型均在反引号内），
        // 避免 "str"→"文本" 等短条目把消息中的 "string" 部分替换成 "文本ing"
        对于 标记 in 抽取反引号段(&转换结果) {
            如果让 有值(母语) = 自我.类型映射表.get(&标记) {
                转换结果 = 转换结果.replace(&格式化!("`{}`", 标记), &格式化!("`{}`", 母语));
            } 否则 如果让 有值(已替换) = 本地化类型段(&标记, &自我.类型映射表) {
                // 带模块路径的类型名：三段式本地化
                //（std::fmt::Display → 标准库::格式化::可显示）
                转换结果 = 转换结果.replace(&格式化!("`{}`", 标记), &格式化!("`{}`", 已替换));
            }
        }
        转换结果
    }

    /// 批量翻译诊断列表
    公开 函数 批量翻译(&自我, 诊断列表: &[编译器诊断]) -> 向量<教学诊断> {
        诊断列表
            .iter()
            .map(|诊断项| 自我.翻译诊断(诊断项))
            .collect()
    }
}
