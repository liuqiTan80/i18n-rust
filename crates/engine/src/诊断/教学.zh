// 教学诊断结构与所有权叙事化详情

使用 序列化::可序列化;

使用 超级::诊断模型::{编译器诊断, 诊断跨度, 抽取源码文本};

/// 教学诊断：翻译后的完整诊断信息，包含错误码、翻译消息、教学提示、位置等
#[派生(调试, 克隆)]
公开 结构体 教学诊断 {
    公开 严重级别: 诊断级别,
    公开 错误码: 选项<字符串>,
    公开 翻译消息: 字符串,
    公开 原始消息: 字符串,
    公开 教学提示: 向量<字符串>,
    公开 位置列表: 向量<诊断位置>,
    公开 子诊断: 向量<教学诊断>,
    公开 所有权详情: 选项<所有权详情>,
}

/// 诊断级别
#[派生(调试, 克隆, 部分相等)]
公开 枚举 诊断级别 {
    错误级,
    警告级,
    注释级,
    帮助级,
    编译器崩溃级,
    未知级(字符串),
}

实现 诊断级别 {
    /// 从 rustc 的 level 字符串解析诊断级别
    公开(超级) 函数 从文本解析(级别文本: &文本) -> 自身 {
        匹配 级别文本 {
            "error" => 自身::错误级,
            "warning" => 自身::警告级,
            "note" => 自身::注释级,
            "help" => 自身::帮助级,
            "ice" => 自身::编译器崩溃级,
            其它 => 自身::未知级(其它.to_string()),
        }
    }

    /// 返回当前语言下的诊断级别显示文字
    公开 函数 显示文字(&自我) -> 字符串 {
        让 键名 = 匹配 自我 {
            自身::错误级 => "diag_kind_error",
            自身::警告级 => "diag_kind_warning",
            自身::注释级 => "diag_kind_note",
            自身::帮助级 => "diag_kind_help",
            自身::编译器崩溃级 => "diag_kind_ice",
            自身::未知级(串) => 返回 串.clone(),
        };
        包::语言::查句(键名)
    }
}

/// 诊断位置信息（翻译后的跨度）
#[派生(调试, 克隆, 可序列化)]
公开 结构体 诊断位置 {
    公开 源文件名: 字符串,
    #[serde(rename = "起始行")]
    公开 起始行: 无符号整数,
    #[serde(rename = "起始列")]
    公开 起始列: 无符号整数,
    #[serde(rename = "结束行")]
    公开 结束行: 无符号整数,
    #[serde(rename = "结束列")]
    公开 结束列: 无符号整数,
    公开 源码文本: 选项<字符串>,
    公开 标签: 选项<字符串>,
    公开 是主跨度: 布尔,
}

实现 诊断位置 {
    /// 从 rustc 的原始跨度构造诊断位置
    公开 函数 从跨度构造(跨度: &诊断跨度) -> 自身 {
        自身 {
            源文件名: 跨度.源文件名.clone(),
            起始行: 跨度.起始行,
            起始列: 跨度.起始列,
            结束行: 跨度.结束行,
            结束列: 跨度.结束列,
            源码文本: 抽取源码文本(&跨度.源码文本),
            标签: 跨度.标签.clone(),
            是主跨度: 跨度.是主跨度,
        }
    }
}

/// 所有权错误的叙事化详情
#[派生(调试, 克隆, 可序列化)]
公开 结构体 所有权详情 {
    #[serde(rename = "变量名")]
    公开 变量名: 字符串,
    #[serde(rename = "移动发生")]
    公开 移动发生: 选项<诊断位置>,
    #[serde(rename = "借用发生")]
    公开 借用发生: 选项<诊断位置>,
    #[serde(rename = "再次使用")]
    公开 再次使用: 选项<诊断位置>,
}

实现 所有权详情 {
    /// 生成当前语言下的叙事性教学文本
    公开 函数 叙事文本(&自我) -> 字符串 {
        让 变量 = &自我.变量名;
        匹配 (
            &自我.移动发生,
            &自我.借用发生,
            &自我.再次使用,
        ) {
            (有值(移动位), 无, 有值(复用)) => 包::语言::查译(
                "diag_ownership_moved_reused",
                &[变量, &移动位.起始行.to_string(), &复用.起始行.to_string()],
            ),
            (无, 有值(借用), 有值(复用)) => 包::语言::查译(
                "diag_ownership_borrowed_in_use",
                &[变量, &借用.起始行.to_string(), &复用.起始行.to_string()],
            ),
            (有值(移动位), _, _) => {
                包::语言::查译("diag_ownership_moved", &[变量, &移动位.起始行.to_string()])
            }
            (无, 有值(借用), _) => 包::语言::查译(
                "diag_ownership_borrowed",
                &[变量, &借用.起始行.to_string()],
            ),
            _ => 包::语言::查译("diag_ownership_conflict", &[变量]),
        }
    }
}

/// 所有权相关错误码
公开 常量 所有权错误码: [&文本; 3] = ["E0382", "E0502", "E0507"];

/// 从 rustc 诊断中提取所有权错误详情
公开 函数 抽取所有权详情(
    错误码: &文本,
    诊断: &编译器诊断,
) -> 选项<所有权详情> {
    如果 !所有权错误码.contains(&错误码) {
        返回 无;
    }
    让 变量名 = 从消息抽取变量名(&诊断.诊断消息)
        .or_else(|| 从跨度抽取变量名(&诊断.跨度列表))?;

    // 收集顶层与子诊断中的所有跨度
    让 全部跨度: 向量<&诊断跨度> = 诊断
        .跨度列表
        .iter()
        .chain(
            诊断
                .子诊断
                .iter()
                .flat_map(|子| 子.跨度列表.iter()),
        )
        .collect();

    让 可变 移动发生 = 无;
    让 可变 借用发生 = 无;
    让 可变 再次使用 = 无;
    对于 跨度 in &全部跨度 {
        让 标签 = 跨度.标签.as_deref().unwrap_or("");
        // 注意顺序："borrow later used here" 同时含 borrow 与 used here，应归为再次使用
        如果 标签.contains("used here")
            || 标签.contains("later used")
            || 标签.contains("after move")
        {
            再次使用.get_or_insert_with(|| 诊断位置::从跨度构造(跨度));
        } 否则 如果 标签.contains("move") {
            移动发生.get_or_insert_with(|| 诊断位置::从跨度构造(跨度));
        } 否则 如果 标签.contains("borrow") {
            借用发生.get_or_insert_with(|| 诊断位置::从跨度构造(跨度));
        }
    }

    // 主 span 兜底：对应错误类型的核心位置
    如果让 有值(主跨度) = 诊断.跨度列表.iter().find(|跨度项| 跨度项.是主跨度) {
        匹配 错误码 {
            "E0382" => {
                再次使用.get_or_insert_with(|| 诊断位置::从跨度构造(主跨度));
            }
            "E0502" => {
                借用发生.get_or_insert_with(|| 诊断位置::从跨度构造(主跨度));
            }
            "E0507" => {
                移动发生.get_or_insert_with(|| 诊断位置::从跨度构造(主跨度));
            }
            _ => {}
        }
    }

    如果 移动发生.is_none() && 借用发生.is_none() && 再次使用.is_none() {
        返回 无;
    }
    有值(所有权详情 {
        变量名,
        移动发生,
        借用发生,
        再次使用,
    })
}

/// 从诊断消息中提取反引号包裹的变量名
函数 从消息抽取变量名(消息文本: &文本) -> 选项<字符串> {
    让 起点位置 = 消息文本.find('`')?;
    让 剩余 = &消息文本[起点位置 + 1..];
    让 终点位置 = 剩余.find('`')?;
    有值(剩余[..终点位置].to_string())
}

/// 从 span 标签中提取反引号包裹的变量名
函数 从跨度抽取变量名(跨度列表: &[诊断跨度]) -> 选项<字符串> {
    跨度列表.iter().find_map(|跨度| {
        让 标签 = 跨度.标签.as_deref()?;
        让 起点位置 = 标签.find('`')?;
        让 剩余 = &标签[起点位置 + 1..];
        让 终点位置 = 剩余.find('`')?;
        有值(剩余[..终点位置].to_string())
    })
}
