//! 教学诊断结构（翻译后的输出）与所有权错误叙事化详情。

使用 序列化属性::可序列化;

使用 超级::诊断模型::{编译器诊断, 诊断跨度, 取源码文本};

/// 教学诊断：翻译后的完整诊断信息，包含错误码、翻译消息、教学提示、位置等
#[派生(调试, 克隆)]
公开 结构体 教学诊断 {
    公开 级别: 诊断级别,
    公开 错误码: 选项<字符串>,
    公开 译文消息: 字符串,
    公开 原文消息: 字符串,
    公开 提示集: 向量<字符串>,
    公开 位置集: 向量<诊断位置>,
    公开 子诊断: 向量<教学诊断>,
    公开 所有权详情: 选项<所有权详情>,
}

/// 诊断级别
#[派生(调试, 克隆, 部分相等)]
公开 枚举 诊断级别 {
    诊断错误,
    诊断告警,
    诊断注记,
    诊断建议,
    诊断崩溃,
    未知级别(字符串),
}

实现 诊断级别 {
    /// 把 rustc 输出的严重程度字符串解析成诊断级别
    公开(超级) 函数 解析级别(级别: &文本) -> 自身 {
        匹配 级别 {
            "error" => 自身::诊断错误,
            "warning" => 自身::诊断告警,
            "note" => 自身::诊断注记,
            "help" => 自身::诊断建议,
            "ice" => 自身::诊断崩溃,
            其余 => 自身::未知级别(其余.转字符串()),
        }
    }

    /// 返回当前语言下的诊断级别显示文字
    公开 函数 显示文字(&自我) -> 字符串 {
        让 键 = 匹配 自我 {
            自身::诊断错误 => "diag_kind_error",
            自身::诊断告警 => "diag_kind_warning",
            自身::诊断注记 => "diag_kind_note",
            自身::诊断建议 => "diag_kind_help",
            自身::诊断崩溃 => "diag_kind_ice",
            自身::未知级别(串) => 返回 串.克隆(),
        };
        包::语言::取消息(键)
    }
}

/// 诊断位置信息（翻译后的跨度）
#[派生(调试, 克隆, 可序列化)]
公开 结构体 诊断位置 {
    #[序列化属性(重命名 = "file_name")]
    公开 文件名称: 字符串,
    #[序列化属性(重命名 = "起始行")]
    公开 起始行号: 无符号整数,
    #[序列化属性(重命名 = "起始列")]
    公开 起始列号: 无符号整数,
    #[序列化属性(重命名 = "结束行")]
    公开 结束行号: 无符号整数,
    #[序列化属性(重命名 = "结束列")]
    公开 结束列号: 无符号整数,
    #[序列化属性(重命名 = "source_text")]
    公开 源码文本: 选项<字符串>,
    #[序列化属性(重命名 = "label")]
    公开 标签文本: 选项<字符串>,
    #[序列化属性(重命名 = "is_primary")]
    公开 是否主因: 布尔,
}

实现 诊断位置 {
    /// 从 rustc 的原始跨度构造诊断位置
    公开 函数 自跨度(跨度: &诊断跨度) -> 自身 {
        自身 {
            文件名称: 跨度.文件名称.克隆(),
            起始行号: 跨度.起始行号,
            起始列号: 跨度.起始列号,
            结束行号: 跨度.结束行号,
            结束列号: 跨度.结束列号,
            源码文本: 取源码文本(&跨度.源码文本),
            标签文本: 跨度.标签文本.克隆(),
            是否主因: 跨度.是否主因,
        }
    }
}

/// 所有权错误的叙事化详情
#[派生(调试, 克隆, 可序列化)]
公开 结构体 所有权详情 {
    #[序列化属性(重命名 = "变量名")]
    公开 变量名: 字符串,
    #[序列化属性(重命名 = "移动发生")]
    公开 移动发生: 选项<诊断位置>,
    #[序列化属性(重命名 = "借用发生")]
    公开 借用发生: 选项<诊断位置>,
    #[序列化属性(重命名 = "再次使用")]
    公开 再次使用: 选项<诊断位置>,
    /// E0502 的冲突双方（仅当两个借用标签都在跨度中时才有值）
    #[序列化属性(重命名 = "借用冲突", 跳过序列化若 = "Option::is_none")]
    公开 借用冲突: 选项<借用冲突>,
}

/// E0502 的借用冲突双方
#[派生(调试, 克隆, 可序列化)]
公开 结构体 借用冲突 {
    #[序列化属性(重命名 = "可变借用")]
    公开 可变方: 诊断位置,
    #[序列化属性(重命名 = "不可变借用")]
    公开 不可变方: 诊断位置,
}

实现 借用冲突 {
    /// 按标签把两端位置分开收：返回 `(可变借用, 不可变借用)`
    公开 函数 归类带标签跨度<'甲, 项流>(跨度: 项流) -> (选项<诊断位置>, 选项<诊断位置>)
    哪里 项流: 可迭代<货物类型 = (&'甲 文本, 诊断位置)> {
        让 可变 可变方 = 无;
        让 可变 不可变方 = 无;
        对于 (标签, 位置) 在 跨度 {
            如果 不可变方.是否为无() && 标签.包含("immutable borrow") {
                不可变方 = 有值(位置);
            } 否则 如果 可变方.是否为无() && 标签.包含("mutable borrow") && !标签.包含("immutable") {
                可变方 = 有值(位置);
            }
        }
        (可变方, 不可变方)
    }

    /// 两端都认出来时才算得上「借用冲突」
    公开 函数 自两端(可变方: 选项<诊断位置>, 不可变方: 选项<诊断位置>) -> 选项<自身> {
        匹配 (可变方, 不可变方) {
            (有值(可变方), 有值(不可变方)) => 有值(自身 { 可变方, 不可变方 }),
            _ => 无,
        }
    }

    /// 从「标签 + 位置」序列里认出冲突双方
    公开 函数 自带标签跨度<'甲, 项流>(跨度: 项流) -> 选项<自身>
    哪里 项流: 可迭代<货物类型 = (&'甲 文本, 诊断位置)> {
        让 (可变方, 不可变方) = 自身::归类带标签跨度(跨度);
        自身::自两端(可变方, 不可变方)
    }
}

实现 所有权详情 {
    /// 生成当前语言下的叙事性教学文本
    公开 函数 叙事文本(&自我) -> 字符串 {
        让 变量 = &自我.变量名;
        如果 让 有值(冲突) = &自我.借用冲突 {
            返回 包::语言::取带参消息(
                "diag_ownership_borrow_conflict",
                &[变量, &冲突.可变方.起始行号.转字符串(), &冲突.不可变方.起始行号.转字符串()],
            );
        }
        匹配 (&自我.移动发生, &自我.借用发生, &自我.再次使用) {
            (有值(移动处), 无, 有值(复用处)) => 包::语言::取带参消息(
                "diag_ownership_moved_reused",
                &[变量, &移动处.起始行号.转字符串(), &复用处.起始行号.转字符串()],
            ),
            (无, 有值(借用处), 有值(复用处)) => 包::语言::取带参消息(
                "diag_ownership_borrowed_in_use",
                &[变量, &借用处.起始行号.转字符串(), &复用处.起始行号.转字符串()],
            ),
            (有值(移动处), _, _) => 包::语言::取带参消息(
                "diag_ownership_moved",
                &[变量, &移动处.起始行号.转字符串()],
            ),
            (无, 有值(借用处), _) => 包::语言::取带参消息(
                "diag_ownership_borrowed",
                &[变量, &借用处.起始行号.转字符串()],
            ),
            _ => 包::语言::取带参消息("diag_ownership_conflict", &[变量]),
        }
    }
}

/// 所有权相关错误码（E0382 / E0502 / E0507）
公开 常量 所有权错误码表: [&文本; 3] = ["E0382", "E0502", "E0507"];

/// 从 rustc 诊断中提取所有权错误详情
公开 函数 提取所有权详情(错误码: &文本, 诊断: &编译器诊断) -> 选项<所有权详情> {
    如果 !所有权错误码表.包含(&错误码) {
        返回 无;
    }
    让 变量名 = 从消息取变量名(&诊断.诊断消息).或用否则(|| 从跨度取变量名(&诊断.跨度集))?;

    让 全部跨度: 向量<&诊断跨度> = 诊断
        .跨度集
        .迭代()
        .链式(诊断.子诊断.迭代().平铺(|子| 子.跨度集.迭代()))
        .收集();

    让 可变 移动发生 = 无;
    让 可变 借用发生 = 无;
    让 可变 再次使用 = 无;
    对于 跨度 在 &全部跨度 {
        让 标签 = 跨度.标签文本.作为解引用().取值或("");
        如果 标签.包含("used here") || 标签.包含("later used") || 标签.包含("after move") {
            再次使用.插入或用(|| 诊断位置::自跨度(跨度));
        } 否则 如果 标签.包含("move") {
            移动发生.插入或用(|| 诊断位置::自跨度(跨度));
        } 否则 如果 标签.包含("borrow") {
            借用发生.插入或用(|| 诊断位置::自跨度(跨度));
        }
    }

    如果 让 有值(主因) = 诊断.跨度集.迭代().查找(|跨度| 跨度.是否主因) {
        匹配 错误码 {
            "E0382" => {
                再次使用.插入或用(|| 诊断位置::自跨度(主因));
            }
            "E0502" => {
                借用发生.插入或用(|| 诊断位置::自跨度(主因));
            }
            "E0507" => {
                移动发生.插入或用(|| 诊断位置::自跨度(主因));
            }
            _ => {}
        }
    }

    如果 移动发生.是否为无() && 借用发生.是否为无() && 再次使用.是否为无() {
        返回 无;
    }
    让 借用冲突 = 如果 错误码 == "E0502" {
        借用冲突::自带标签跨度(全部跨度.迭代().过滤映射(|跨度| {
            跨度.标签文本
                .作为解引用()
                .映射(|标签| (标签, 诊断位置::自跨度(跨度)))
        }))
    } 否则 {
        无
    };
    有值(所有权详情 {
        变量名,
        移动发生,
        借用发生,
        再次使用,
        借用冲突,
    })
}

/// 从诊断消息中提取反引号包裹的变量名
函数 从消息取变量名(消息: &文本) -> 选项<字符串> {
    让 首 = 消息.查找('`')?;
    让 剩余 = &消息[首 + 1..];
    让 尾 = 剩余.查找('`')?;
    有值(剩余[..尾].转字符串())
}

/// 从跨度标签中提取反引号包裹的变量名
函数 从跨度取变量名(跨度: &[诊断跨度]) -> 选项<字符串> {
    跨度.迭代().查找映射(|跨度| {
        让 标签 = 跨度.标签文本.作为解引用()?;
        让 首 = 标签.查找('`')?;
        让 剩余 = &标签[首 + 1..];
        让 尾 = 剩余.查找('`')?;
        有值(剩余[..尾].转字符串())
    })
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    函数 定位(起始行号: 无符号整数) -> 诊断位置 {
        诊断位置 {
            文件名称: "main.zh".转字符串(),
            起始行号,
            起始列号: 1,
            结束行号: 起始行号,
            结束列号: 2,
            源码文本: 无,
            标签文本: 无,
            是否主因: 假,
        }
    }

    #[测试]
    函数 借用冲突模板在每个语言包都在() {
        让 详情 = 所有权详情 {
            变量名: "x".转字符串(),
            移动发生: 无,
            借用发生: 无,
            再次使用: 无,
            借用冲突: 有值(借用冲突 { 可变方: 定位(7), 不可变方: 定位(5) }),
        };
        对于 语言 在 ["zh", "en", "ja", "ko", "ru", "de", "es", "fr", "pt", "hi", "ar"] {
            让 _守卫 = 包::语言::钉住语言(语言);
            让 正文 = 详情.叙事文本();
            断言!(!正文.包含("diag_ownership_borrow_conflict"), "{语言} 语言包缺少 diag_ownership_borrow_conflict");
            断言!(正文.包含('x') && 正文.包含('7') && 正文.包含('5'), "{语言} 的冲突叙事没有回填全部三个槽位：{正文}");
        }
    }

    #[测试]
    函数 不可变标签不被误判为可变() {
        让 可变在前 = 借用冲突::自带标签跨度(向量![
            ("mutable borrow occurs here", 定位(7)),
            ("immutable borrow occurs here", 定位(5)),
            ("immutable borrow later used here", 定位(5)),
        ])
        .期望("应认出冲突双方");
        断言相等!(可变在前.可变方.起始行号, 7);
        断言相等!(可变在前.不可变方.起始行号, 5);

        让 (可变方, 不可变方) = 借用冲突::归类带标签跨度(向量![
            ("immutable borrow occurs here", 定位(5)),
            ("immutable borrow later used here", 定位(5)),
        ]);
        断言!(可变方.是否为无(), "不可变标签不得冒充可变借用");
        断言相等!(不可变方.解包().起始行号, 5);
    }
}
