//! 导出冲突提示：在导出前扫一遍「转译会静默改变你代码含义」的位置
//!
//! 与教学检查同一定位：只提示、不阻断（`--no-lint` 选项一并关闭）。规则刻意保守，
//! 只报**能确定会被改写**的三类位置，避免把正常代码当问题：
//!
//! 1. 结构体字段名命中关键字/宏词条：字段定义被词法层改写，序列化键与字段名随之变化
//!    （`类型: 字符串` → `type: String`）；
//! 2. 声明的名字命中关键字/宏词条：`让 自身 = 1` → `let Self = 1`、
//!    `结构体 配置` → `struct cfg!`（入口函数按惯例映射，不报）；
//! 3. 会恐慌的词条被当文本用：`打印行!("{}", 解包(甲))` 在格式化实参里
//!    直接触发恐慌，而不是产出文本。
//!
//! 位置一律按**母语源文件**的行列出（提示在写盘前扫描，不经产物）。
//! 别名词条（`长度`、`版本` 等）在声明位有豁免，不会被改写，故不提示。

使用 标准库::集合::{哈希映射, 哈希集合};

使用 词法解析器::{令牌种类, 切分令牌};

使用 包::映射管理器::映射管理器;

/// 提示种类
#[派生(调试, 克隆, 可复制, 部分相等, 全等, 哈希)]
公开 枚举 提示种类 {
    /// 结构体字段名命中词条：字段定义会被改写，序列化键随之变化
    字段遮蔽,
    /// 声明的名字（结构体/枚举/函数/变量）命中词条：声明本身被改写
    声明名改写,
    /// 会恐慌的词条的结果被当文本使用
    恐慌当文本,
}

/// 单条导出冲突提示：位置（1 起行/列）+ 种类 + 相关词条
#[派生(调试, 克隆, 部分相等, 全等)]
公开 结构体 冲突提示 {
    /// 行号（从 1 开始）
    公开 行号: 无符号机器整数,
    /// 列号（从 1 开始，按字符计数）
    公开 列号: 无符号机器整数,
    /// 种类
    公开 种类: 提示种类,
    /// 触发的词条（源码里写的母语词）
    公开 词条: 字符串,
    /// 该词条的转译目标（母语词 → 对应英文关键字）
    公开 目标: 字符串,
}

实现 冲突提示 {
    /// 转成教学提示文本，模板随当前语言变化
    公开 函数 转提示文本(&自我) -> 字符串 {
        让 行号文本 = 自我.行号.转字符串();
        让 列号文本 = 自我.列号.转字符串();
        匹配 自我.种类 {
            提示种类::字段遮蔽 => 包::语言::取带参消息(
                "eject_hint_field_shadowed",
                &[&行号文本, &列号文本, &自我.词条, &自我.目标],
            ),
            提示种类::声明名改写 => 包::语言::取带参消息(
                "eject_hint_declared_name",
                &[&行号文本, &列号文本, &自我.词条, &自我.目标],
            ),
            提示种类::恐慌当文本 => 包::语言::取带参消息(
                "eject_hint_panic_as_text",
                &[&行号文本, &列号文本, &自我.词条, &自我.目标],
            ),
        }
    }
}

/// 扫描母语源码，返回全部导出冲突提示（按出现顺序）
///
/// 只依赖映射表与源码文本：不读文件、不联网、不看环境变量。
公开 函数 扫描冲突(母语源: &文本, 管理器: &映射管理器) -> 向量<冲突提示> {
    让 记号列表 = 切分记号(母语源);
    让 关键词表 = 管理器.取关键词表();
    让 别名表 = 管理器.取别名表();
    让 宏表 = 管理器.取宏表();
    让 可变 汇聚 = 提示汇聚::默认值();

    // 方言拼写由词条表反查（语言无关）：转译目标为结构体关键字的那些键，
    // 就是「结构体」这个词的方言拼写
    让 反查词条 = |目标: &文本| -> 向量<&文本> {
        关键词表
            .迭代器()
            .过滤(|(_, 词条值)| 词条值.作为字符串() == 目标)
            .映射(|(词条, _)| 词条.作为字符串())
            .收集()
    };
    让 结构体词 = 反查词条("struct");
    让 枚举词 = 反查词条("enum");
    让 函数词 = 反查词条("fn");
    让 让词 = 反查词条("let");
    让 公开词 = 反查词条("pub");

    对于 (索引, 令牌) 在 记号列表.迭代器().枚举() {
        让 令牌文本 = 令牌.令牌文本;
        如果 结构体词.包含(&令牌文本) || 枚举词.包含(&令牌文本) {
            如果让 有值(名字) = 记号列表.获取(索引 + 1) {
                报告声明名(名字, 关键词表, &可变 汇聚);
            }
            如果 结构体词.包含(&令牌文本) {
                检查结构体字段(&记号列表, 索引, 关键词表, &公开词, &可变 汇聚);
            }
        } 否则 如果 (函数词.包含(&令牌文本) || 让词.包含(&令牌文本))
            && 让 有值(名字) = 记号列表.获取(索引 + 1)
        {
            报告声明名(名字, 关键词表, &可变 汇聚);
        }
    }

    检查恐慌当文本(&记号列表, 管理器, 宏表, 别名表, &可变 汇聚);
    汇聚.提示集
}

/// 收集提示（同一位置的同一类提示只报一次）
#[派生(默认)]
结构体 提示汇聚 {
    提示集: 向量<冲突提示>,
    已见: 哈希集合<(无符号机器整数, 无符号机器整数, 提示种类)>,
}

实现 提示汇聚 {
    函数 记录(&可变 自我, 令牌: &记号<'_>, 种类: 提示种类, 词条: &文本, 目标: &文本) {
        如果 自我.已见.置入((令牌.行号, 令牌.列号, 种类)) {
            自我.提示集.推入(冲突提示 {
                行号: 令牌.行号,
                列号: 令牌.列号,
                种类,
                词条: 词条.转字符串(),
                目标: 目标.转字符串(),
            });
        }
    }
}

/// 声明名命中关键字词条 → 声明本身会被改写
///
/// 入口函数按项目惯例映射，不提示。
函数 报告声明名(名字: &记号<'_>, 关键词表: &哈希映射<字符串, 字符串>, 汇聚: &可变 提示汇聚) {
    如果 !名字.是否普通标识符 {
        返回;
    }
    如果让 有值(目标) = 关键词表.获取(名字.令牌文本)
        && 目标 != "main"
        && 目标 != 名字.令牌文本
    {
        汇聚.记录(名字, 提示种类::声明名改写, 名字.令牌文本, 目标);
    }
}

/// 扫描结构体字段名，命中关键字/宏词条时报告（字段定义会被改写）
函数 检查结构体字段(
    记号列表: &[记号<'_>],
    结构体索引: 无符号机器整数,
    关键词表: &哈希映射<字符串, 字符串>,
    公开词: &[&文本],
    汇聚: &可变 提示汇聚,
) {
    // 找结构体体的 `{`（跳过泛型约束子句；`;` 结尾的单元结构体没有字段）
    让 可变 索引 = 结构体索引 + 1;
    当 索引 < 记号列表.长度() && 记号列表[索引].令牌文本 != "{" && 记号列表[索引].令牌文本 != ";" {
        索引 += 1;
    }
    如果 索引 >= 记号列表.长度() || 记号列表[索引].令牌文本 != "{" {
        返回;
    }
    让 可变 深度 = 0usize;
    当 索引 < 记号列表.长度() {
        匹配 记号列表[索引].令牌文本 {
            "{" => 深度 += 1,
            "}" => {
                深度 -= 1;
                如果 深度 == 0 {
                    返回;
                }
            }
            ":" 如果 深度 == 1 => {
                如果让 有值(名字) = 冒号前字段名(记号列表, 索引, 公开词)
                    && 让 有值(目标) = 关键词表.获取(名字.令牌文本)
                    && 目标 != 名字.令牌文本
                {
                    汇聚.记录(名字, 提示种类::字段遮蔽, 名字.令牌文本, 目标);
                }
            }
            _ => {}
        }
        索引 += 1;
    }
}

/// 判断 `:` 前的标识符是否字段名（字段以 `{`/`,`/`]`/可见性词开头，类型路径段不是）
函数 冒号前字段名<'甲, '乙>(
    记号列表: &'甲 [记号<'乙>],
    冒号索引: 无符号机器整数,
    公开词: &[&文本],
) -> 选项<&'甲 记号<'乙>> {
    让 名字 = 记号列表.获取(冒号索引.检查减(1)?)?;
    如果 !名字.是否普通标识符 {
        返回 无;
    }
    让 前面 = 记号列表.获取(冒号索引.检查减(2)?)?;
    让 字段起始 =
        模式匹配!(前面.令牌文本, "{" | "," | "]" | "pub") || 公开词.包含(&前面.令牌文本);
    字段起始.然后有值(名字)
}

/// 会恐慌的词条出现在文本语境：文本宏实参内，或结果上直接接文本方法
函数 检查恐慌当文本(
    记号列表: &[记号<'_>],
    管理器: &映射管理器,
    宏表: &哈希映射<字符串, 字符串>,
    别名表: &哈希映射<字符串, 字符串>,
    汇聚: &可变 提示汇聚,
) {
    // 文本宏：实参会被格式化，实参里恐慌等于直接崩
    让 是文本宏 = |词条: &文本| -> 布尔 {
        宏表.获取(词条).有值且(|目标| {
            模式匹配!(
                目标.作为字符串(),
                "format"
                    | "println"
                    | "print"
                    | "eprintln"
                    | "eprint"
                    | "panic"
                    | "write"
                    | "writeln"
                    | "assert"
                    | "assert_eq"
                    | "assert_ne"
                    | "debug_assert"
                    | "debug_assert_eq"
            )
        })
    };
    // 文本处理方法：作用在「结果」上等于把结果当文本用
    让 是文本方法 = |词条: &文本| -> 布尔 {
        别名表.获取(词条).有值且(|目标| {
            模式匹配!(
                目标.作为字符串(),
                "to_string"
                    | "to_lowercase"
                    | "to_uppercase"
                    | "to_ascii_lowercase"
                    | "to_ascii_uppercase"
                    | "trim"
                    | "trim_start"
                    | "trim_end"
                    | "len"
                    | "starts_with"
                    | "ends_with"
                    | "contains"
                    | "join"
                    | "replace"
                    | "split"
                    | "split_once"
                    | "push_str"
                    | "insert_str"
            )
        })
    };
    // 会恐慌的别名词条（宏词条排除：`恐慌!(…)` 本身就是显式恐慌）
    让 恐慌目标 = |词条: &文本| -> 选项<&文本> {
        如果 宏表.包含键(词条) {
            返回 无;
        }
        让 目标 = 别名表.获取(词条)?;
        管理器
            .取危险详情(词条)
            .等级
            .会恐慌
            .然后有值(目标.作为字符串())
    };

    // 每个 `(` 是否处在文本宏实参内（嵌套继承）
    让 可变 在文本宏: 向量<布尔> = 向量::新建();
    对于 (索引, 令牌) 在 记号列表.迭代器().枚举() {
        匹配 令牌.令牌文本 {
            "(" => {
                // 宏调用写成 `词条 ! (`：`(` 前一个是 `!`，宏名再往前一个
                让 可变 前面 = 索引.检查减(1).而后映射(|令牌项| 记号列表.获取(令牌项));
                如果 前面.有值且(|令牌项| 令牌项.令牌文本 == "!") {
                    前面 = 索引.检查减(2).而后映射(|令牌项| 记号列表.获取(令牌项));
                }
                让 外层 = 在文本宏.最后一个().复制值().取值或(假)
                    || 前面.有值且(|令牌项| 是文本宏(令牌项.令牌文本));
                在文本宏.推入(外层);
                继续;
            }
            ")" => {
                在文本宏.弹出();
                继续;
            }
            _ => {}
        }
        如果 !令牌.是否普通标识符 {
            继续;
        }
        // 宏调用（`恐慌!(`）是显式恐慌，不提示
        如果 记号列表.获取(索引 + 1).有值且(|后续| 后续.令牌文本 == "!") {
            继续;
        }
        如果让 有值(目标) = 恐慌目标(令牌.令牌文本) {
            让 当文本 = 在文本宏.最后一个().复制值().取值或(假)
                || 调用结果当文本(记号列表, 索引, &是文本方法);
            如果 当文本 {
                汇聚.记录(令牌, 提示种类::恐慌当文本, 令牌.令牌文本, 目标);
            }
        }
    }
}

/// 调用结果（`词条(…)`）之后是否直接接文本方法（`.转字符串()` 等）
函数 调用结果当文本(
    记号列表: &[记号<'_>],
    词条索引: 无符号机器整数,
    是文本方法: &动态 闭包特征(&文本) -> 布尔,
) -> 布尔 {
    如果 记号列表.获取(词条索引 + 1).映射(|令牌| 令牌.令牌文本) != 有值("(") {
        返回 假;
    }
    让 可变 深度 = 0usize;
    让 可变 索引 = 词条索引 + 1;
    当 索引 < 记号列表.长度() {
        匹配 记号列表[索引].令牌文本 {
            "(" => 深度 += 1,
            ")" => {
                深度 -= 1;
                如果 深度 == 0 {
                    索引 += 1;
                    中断;
                }
            }
            _ => {}
        }
        索引 += 1;
    }
    如果 记号列表.获取(索引).映射(|令牌| 令牌.令牌文本) != 有值(".") {
        返回 假;
    }
    记号列表
        .获取(索引 + 1)
        .有值且(|方法名| 方法名.是否普通标识符 && 是文本方法(方法名.令牌文本))
}

/// 词法记号（仅保留代码位置的记号，附行列）
结构体 记号<'甲> {
    令牌文本: &'甲 文本,
    行号: 无符号机器整数,
    列号: 无符号机器整数,
    /// 普通标识符（`r#` 原始标识符不算：它不会被改写）
    是否普通标识符: 布尔,
}

/// 用词法解析器切分源码并换算行列（空白/注释之外的记号按序返回）
函数 切分记号(母语源: &文本) -> 向量<记号<'_>> {
    让 可变 行起点 = 向量![0usize];
    行起点.扩展(母语源.匹配位置('\n').映射(|(偏移, _)| 偏移 + 1));

    让 可变 记号列表 = 向量::新建();
    让 可变 偏移 = 0usize;
    对于 词元 在 切分令牌(母语源) {
        让 起始 = 偏移;
        偏移 += 词元.令牌长度;
        如果 模式匹配!(
            词元.令牌类别,
            令牌种类::空白符
                | 令牌种类::行评论
                | 令牌种类::块评论 { .. }
                | 令牌种类::未知记号
        ) {
            继续;
        }
        让 行索引 = 匹配 行起点.二分查找(&起始) {
            成功(索引) => 索引,
            错误(索引) => 索引.饱和减(1),
        };
        让 列号 = 母语源[行起点[行索引]..起始].逐字符().计数() + 1;
        记号列表.推入(记号 {
            令牌文本: &母语源[起始..偏移],
            行号: 行索引 + 1,
            列号,
            是否普通标识符: 模式匹配!(词元.令牌类别, 令牌种类::标识符记号),
        });
    }
    记号列表
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;
    使用 标准库::路径::路径类型;

    /// 真实中文内置语言包（与命令行同源）
    函数 内置管理器() -> 映射管理器 {
        让 语言目录 = 路径类型::新建(编译环境宏!("CARGO_MANIFEST_DIR")).连接("lang-packs/zh");
        映射管理器::从目录载入(&语言目录).期望("内置语言包应可加载")
    }

    函数 种类列表(提示: &[冲突提示]) -> 向量<提示种类> {
        提示.迭代器().映射(|提示项| 提示项.种类).收集()
    }

    #[测试]
    函数 字段名命中会被报告() {
        让 母语源 = "结构体 甲 {\n    类型: 字符串,\n    长度: 整数,\n}\n";
        让 提示 = 扫描冲突(母语源, &内置管理器());
        断言相等!(种类列表(&提示), 向量![提示种类::字段遮蔽]);
        断言相等!(提示[0].词条, "类型");
        断言相等!(提示[0].目标, "type");
        断言相等!((提示[0].行号, 提示[0].列号), (2, 5));
    }

    #[测试]
    函数 别名字段名静默() {
        // 别名类词条（长度/版本）在声明位有豁免，不会改写，不应提示
        让 母语源 = "结构体 甲 {\n    长度: 整数,\n    版本: 字符串,\n}\n";
        断言!(扫描冲突(母语源, &内置管理器()).是否为空());
    }

    #[测试]
    函数 字段类型路径不报告() {
        // 字段类型里的路径段（`模块::类型`）不是字段名，不得误报
        让 母语源 = "结构体 甲 {\n    计数: 模块::类型,\n}\n";
        断言!(扫描冲突(母语源, &内置管理器()).是否为空());
    }

    #[测试]
    函数 声明名命中关键字报告() {
        让 母语源 = "函数 主函数() {\n    让 自身 = 1;\n}\n";
        让 提示 = 扫描冲突(母语源, &内置管理器());
        断言相等!(种类列表(&提示), 向量![提示种类::声明名改写]);
        断言相等!(提示[0].词条, "自身");
        断言相等!(提示[0].目标, "Self");
        // 第 2 行 `    让 自身 = 1;`：四个空格 + 「让」+ 空格 → 「自身」在第 7 列
        断言相等!((提示[0].行号, 提示[0].列号), (2, 7));
    }

    #[测试]
    函数 入口函数不报告() {
        // 主函数 → 入口名 是项目惯例，不该当问题报出来
        让 母语源 = "函数 主函数() {\n    让 甲 = 1;\n}\n";
        断言!(扫描冲突(母语源, &内置管理器()).是否为空());
    }

    #[测试]
    函数 结构体名命中关键字报告() {
        // 结构体 配置 → 该词在宏表里也有，词法层直接改写
        让 提示 = 扫描冲突("结构体 配置 {\n    甲: 整数,\n}\n", &内置管理器());
        断言相等!(种类列表(&提示), 向量![提示种类::声明名改写]);
        断言相等!(提示[0].词条, "配置");
    }

    #[测试]
    函数 恐慌词在格式化实参内报告() {
        让 母语源 = "函数 主函数() {\n    让 甲 = 有值(3);\n    打印行!(\"{}\", 解包(甲));\n}\n";
        让 提示 = 扫描冲突(母语源, &内置管理器());
        断言相等!(种类列表(&提示), 向量![提示种类::恐慌当文本]);
        断言相等!(提示[0].词条, "解包");
        断言相等!(提示[0].目标, "unwrap");
        断言相等!(提示[0].行号, 3);
    }

    #[测试]
    函数 恐慌词结果当文本报告() {
        让 母语源 = "函数 主函数() {\n    让 甲 = 有值(1).解包().转字符串();\n}\n";
        让 提示 = 扫描冲突(母语源, &内置管理器());
        断言相等!(种类列表(&提示), 向量![提示种类::恐慌当文本]);
        断言相等!(提示[0].词条, "解包");
    }

    #[测试]
    函数 恐慌词他处静默() {
        // 只当值用、不进文本语境：不提示（避免把正常代码刷成一片警告）
        让 母语源 = "函数 主函数() {\n    让 甲 = 有值(3).解包();\n    让 乙 = 甲 + 1;\n}\n";
        断言!(扫描冲突(母语源, &内置管理器()).是否为空());
    }

    #[测试]
    函数 显式恐慌宏静默() {
        // `恐慌!(…)` 本身就是显式选择，不提示
        让 母语源 = "函数 主函数() {\n    恐慌!(\"{}\", 1);\n}\n";
        断言!(扫描冲突(母语源, &内置管理器()).是否为空());
    }

    #[测试]
    函数 安全数据库列词静默() {
        // 「取列」已改为安全默认（可选取值），在文本位置也不再触发恐慌提示
        让 母语源 = "函数 主函数() {\n    打印行!(\"{}\", 取列(0));\n}\n";
        断言!(扫描冲突(母语源, &内置管理器()).是否为空());
    }
}
