//! 全角标点检测与修复模块
//! 中文（及日/韩等）输入法下，用户常以全角标点书写代码（如 `打印行！（"你好"）；`），
//! 这些字符在 Rust 语法中非法或会形成错误标识符，是初学者最常见的编译错误来源。
//! 本模块在词法处理前扫描源码，仅报告代码位置（字符串字面态与注释内的全角标点
//! 合法，不报告）的全角标点：
//! - 有明确半角对应（，；：（）！？等）→ 提示对应字符，`rzc check --fix` 可自动转换
//! - 无一对一映射的中文标点（、 与全角空格等）→ 仅提示，需人工修改

/// 全角标点 → 半角映射表（可自动修复的字符）
///
/// 覆盖中文输入法全角模式下可输入的所有常见标点；
/// 字符串/注释内的全角标点是合法内容，由调用方保证仅扫描代码位置。
常量 可修复对表: &[(字符, 字符)] = &[
    ('，', ','),
    ('。', '.'),
    ('；', ';'),
    ('：', ':'),
    ('！', '!'),
    ('？', '?'),
    ('（', '('),
    ('）', ')'),
    ('【', '['),
    ('】', ']'),
    ('｛', '{'),
    ('｝', '}'),
    ('「', '['),
    ('」', ']'),
    ('『', '['),
    ('』', ']'),
    ('〔', '('),
    ('〕', ')'),
    ('“', '"'),
    ('”', '"'),
    ('‘', '\''),
    ('’', '\''),
    ('～', '~'),
    ('＠', '@'),
    ('＃', '#'),
    ('％', '%'),
    ('＆', '&'),
    ('＊', '*'),
    ('＋', '+'),
    ('－', '-'),
    ('＝', '='),
    ('／', '/'),
    ('＼', '\\'),
    ('｜', '|'),
    ('＜', '<'),
    ('＞', '>'),
    ('＿', '_'),
    ('＄', '$'),
    ('＾', '^'),
];

/// 无一对一映射、仅提示不可自动修复的字符
常量 仅提示表: &[字符] = &['、', '　', '·'];

/// 单个全角标点警告：位置（1 起行/列）+ 字符 + 建议的半角字符
#[派生(调试, 克隆, 部分相等)]
公开 结构体 全角警告 {
    /// 行号（从 1 开始）
    公开 行号: 无符号机器整数,
    /// 列号（从 1 开始，按字符计数）
    公开 列序: 无符号机器整数,
    /// 全角字符
    公开 涉事字符: 字符,
    /// 建议的半角字符；无值 表示无对应（仅提示）
    公开 替代字符: 选项<字符>,
}

实现 全角警告 {
    /// 格式化为单行警告文本，模板随当前语言变化
    /// 示例（中文）：`第 1 行第 5 列：检测到全角标点「，」，应改为半角「,」`
    公开 函数 展示行(&自我) -> 字符串 {
        让 指引 = 匹配 自我.替代字符 {
            有值(半角) => 包::语言::取带参消息("fullwidth_to_half", &[&半角.转字符串()]),
            无 => 包::语言::取消息("fullwidth_hint_only"),
        };
        包::语言::取带参消息(
            "fullwidth_warning_at",
            &[
                &自我.行号.转字符串(),
                &自我.列序.转字符串(),
                &自我.涉事字符.转字符串(),
                &指引,
            ],
        )
    }
}

/// 查找代码位置（非字符串/注释）的全角标点
///
/// 状态机跳过字符串字面态（含转义与原始字符串 r#""#）、字符字面态、
/// 行注释与块注释；其余位置出现的全角标点均报告。
/// 字符串/注释内的列号只保证大致正确（这些位置不产生警告）。
公开 函数 检测全角标点(源码: &文本) -> 向量<全角警告> {
    让 字符们: 向量<字符> = 源码.逐字符().收集();
    检测全角标点字符(&字符们)
}

/// [`检测全角标点`] 的字符切片入口
///
/// 与教学检查各扫描器共用同一份字符切片（见转译管线内部）：
/// 一轮教学检查里全角扫描、易混词表检查都只看这份切片，不再各自展开源码。
公开 函数 检测全角标点字符(字符切片: &[字符]) -> 向量<全角警告> {
    让 可变 警告们 = 向量::新建();
    让 可变 行号: 无符号机器整数 = 1;
    让 可变 列序: 无符号机器整数 = 1;
    // 字面态：0 = 代码位置；1=双引号串 2=字符 3=原始串
    让 可变 字面态: 无符号微整数 = 0;
    让 可变 原始井号数: 无符号机器整数 = 0; // 原始字符串的 # 数量
    // 保存上一个非空白字符（用于识别 r#"..."/b"..." 前缀与注释 `//`）
    让 可变 前普通 = '\0';
    让 可变 游标: 无符号机器整数 = 0;
    当 游标 < 字符切片.长度() {
        让 码元 = 字符切片[游标];
        如果 码元 == '\n' {
            行号 += 1;
            列序 = 1;
            前普通 = '\0';
            如果 字面态 == 2 || 字面态 == 3 {
                // 防御：字符/原始串内出现未闭合引号时在行尾强制退出，
                // 避免状态污染后续行（编译器本就会报错，此处只为正确报告全角标点）
                字面态 = 0;
            }
            游标 += 1;
            继续;
        }
        匹配 字面态 {
            1 | 2 => {
                // 字符串/字符字面态：转义跳过下一字符，闭合引号退出
                如果 码元 == '\\' {
                    游标 += 2;
                    列序 += 1;
                    继续;
                }
                让 闭合符 = 如果 字面态 == 1 { '"' } 否则 { '\'' };
                如果 码元 == 闭合符 {
                    字面态 = 0;
                }
            }
            3 => {
                // 原始字符串 r#"..."#：遇 " 后跟等量 #（或行尾/EOF）退出
                如果 码元 == '"' {
                    让 井数 = 字符切片[游标 + 1..].迭代().取前(|元| **元 == '#').计数();
                    如果 井数 >= 原始井号数 {
                        字面态 = 0;
                        原始井号数 = 0;
                    }
                }
            }
            _ => 匹配 码元 {
                '"' => 字面态 = 1,
                '\'' => 字面态 = 2,
                // 行注释：吞到行尾（\n 留给主循环统一处理）
                '/' 如果 前普通 == '/' => {
                    列序 -= 1; // 回退第一个 '/' 已计的列
                    当 游标 < 字符切片.长度() && 字符切片[游标] != '\n' {
                        游标 += 1;
                        列序 += 1;
                    }
                    前普通 = '\0';
                    继续;
                }
                // 块注释（不处理嵌套，够用）
                '*' 如果 前普通 == '/' => {
                    列序 -= 1;
                    当 游标 < 字符切片.长度() {
                        让 内元 = 字符切片[游标];
                        游标 += 1;
                        如果 内元 == '\n' {
                            行号 += 1;
                            列序 = 1;
                        } 否则 如果 内元 == '*' && 游标 < 字符切片.长度() && 字符切片[游标] == '/' {
                            游标 += 1;
                            列序 += 2;
                            中断;
                        } 否则 {
                            列序 += 1;
                        }
                    }
                    前普通 = '\0';
                    继续;
                }
                // 原始字符串前缀（`r` 或字节前缀 `b` 起头，后跟 井号 或 引号）
                'r' | 'b' 如果 是原始前缀(前普通) => {
                    // 前瞻后续字符：连续 # 后遇 " 才进入原始串
                    让 可变 前缀井数: 无符号机器整数 = 0;
                    让 可变 探 = 游标 + 1;
                    当 探 < 字符切片.长度() && 字符切片[探] == '#' {
                        前缀井数 += 1;
                        探 += 1;
                    }
                    如果 探 < 字符切片.长度() && 字符切片[探] == '"' {
                        原始井号数 = 前缀井数;
                        字面态 = 3;
                        // 消费前缀字符（r + # 序列 + 引号）
                        游标 = 探 + 1;
                        列序 += 1 + 前缀井数 + 1;
                        继续;
                    }
                }
                可疑 如果 可修复对表.迭代().任意(|配对| 配对.0 == 可疑) => {
                    让 替代 = 可修复对表
                        .迭代()
                        .查找(|配对| 配对.0 == 可疑)
                        .映射(|配对| 配对.1);
                    警告们.推入(全角警告 {
                        行号,
                        列序,
                        涉事字符: 可疑,
                        替代字符: 替代,
                    });
                }
                可疑 如果 仅提示表.包含(&可疑) => {
                    警告们.推入(全角警告 {
                        行号,
                        列序,
                        涉事字符: 可疑,
                        替代字符: 无,
                    });
                }
                _ => {}
            },
        }
        游标 += 1;
        列序 += 1;
        如果 码元 != ' ' && 码元 != '\t' && 字面态 == 0 {
            前普通 = 码元;
        }
    }
    警告们
}

/// 判断前一字符是否可作为原始字符串前缀（`r` 或 `b` 起头：前一字为 行首/空白/运算符）
函数 是原始前缀(前普通: 字符) -> 布尔 {
    前普通 == '\0' || 前普通.是否为空白() || "([{<,;:!?&|=+-*/%^".包含(前普通)
}

/// 自动修复代码位置的全角标点，返回（修复后文本, 替换数量）
///
/// 仅替换 [`可修复对表`] 中的字符；顿号/全角空格等仅提示字符保持原样。
/// 字符串与注释内容不受影响。
公开 函数 修复全角标点(源码: &文本) -> (字符串, 无符号机器整数) {
    让 字符们: 向量<字符> = 源码.逐字符().收集();
    让 可变 改写串 = 字符串::带容量(源码.长度());
    让 可变 替换数 = 0;
    让 可变 字面态: 无符号微整数 = 0;
    让 可变 原始井号数: 无符号机器整数 = 0;
    让 可变 前普通 = '\0';
    让 可变 游标: 无符号机器整数 = 0;
    当 游标 < 字符们.长度() {
        让 码元 = 字符们[游标];
        如果 码元 == '\n' {
            前普通 = '\0';
            如果 字面态 == 2 || 字面态 == 3 {
                字面态 = 0;
            }
            改写串.推入(码元);
            游标 += 1;
            继续;
        }
        匹配 字面态 {
            1 | 2 => {
                改写串.推入(码元);
                如果 码元 == '\\' {
                    如果 游标 + 1 < 字符们.长度() {
                        改写串.推入(字符们[游标 + 1]);
                    }
                    游标 += 2;
                    继续;
                }
                让 闭合符 = 如果 字面态 == 1 { '"' } 否则 { '\'' };
                如果 码元 == 闭合符 {
                    字面态 = 0;
                }
            }
            3 => {
                改写串.推入(码元);
                如果 码元 == '"' {
                    让 井数 = 字符们[游标 + 1..].迭代().取前(|元| **元 == '#').计数();
                    如果 井数 >= 原始井号数 {
                        字面态 = 0;
                        原始井号数 = 0;
                    }
                }
            }
            _ => 匹配 码元 {
                '"' => {
                    字面态 = 1;
                    改写串.推入(码元);
                }
                '\'' => {
                    字面态 = 2;
                    改写串.推入(码元);
                }
                '/' 如果 前普通 == '/' => {
                    改写串.推入(码元);
                    游标 += 1;
                    当 游标 < 字符们.长度() && 字符们[游标] != '\n' {
                        改写串.推入(字符们[游标]);
                        游标 += 1;
                    }
                    前普通 = '\0';
                    继续;
                }
                '*' 如果 前普通 == '/' => {
                    改写串.推入(码元);
                    游标 += 1;
                    当 游标 < 字符们.长度() {
                        让 内元 = 字符们[游标];
                        改写串.推入(内元);
                        游标 += 1;
                        如果 内元 == '\n' {
                            中断;
                        }
                        如果 内元 == '*' && 游标 < 字符们.长度() && 字符们[游标] == '/' {
                            改写串.推入('/');
                            游标 += 1;
                            中断;
                        }
                    }
                    前普通 = '\0';
                    继续;
                }
                'r' | 'b' 如果 是原始前缀(前普通) => {
                    让 可变 前缀井数: 无符号机器整数 = 0;
                    让 可变 探 = 游标 + 1;
                    当 探 < 字符们.长度() && 字符们[探] == '#' {
                        前缀井数 += 1;
                        探 += 1;
                    }
                    如果 探 < 字符们.长度() && 字符们[探] == '"' {
                        原始井号数 = 前缀井数;
                        字面态 = 3;
                        改写串.推入(码元);
                        对于 元 在 &字符们[游标 + 1..=探] {
                            改写串.推入(*元);
                        }
                        游标 = 探 + 1;
                        继续;
                    }
                    改写串.推入(码元);
                }
                可疑 => {
                    // 可修复对表 命中则改写为半角；未命中原样输出
                    // （单次查找，无需先 任意() 判定再取值的两次遍历）
                    如果让 有值((_, 半角)) = 可修复对表.迭代().查找(|配对| 配对.0 == 可疑) {
                        改写串.推入(*半角);
                        替换数 += 1;
                    } 否则 {
                        改写串.推入(码元);
                    }
                }
            },
        }
        游标 += 1;
        如果 码元 != ' ' && 码元 != '\t' && 字面态 == 0 {
            前普通 = 码元;
        }
    }
    (改写串, 替换数)
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    #[测试]
    函数 检测代码位全角() {
        让 警告们 = 检测全角标点("函数 主函数（）{\n    打印行！（\"你好\"）；\n}");
        让 字符们: 向量<字符> = 警告们.迭代().映射(|警| 警.涉事字符).收集();
        断言相等!(字符们, 向量!['（', '）', '！', '（', '）', '；']);
        断言相等!(警告们[0].行号, 1);
        断言相等!(警告们[0].列序, 7);
        断言相等!(警告们[0].替代字符, 有值('('));
    }

    /// 字符切片入口与字符串入口口径一致（CLI 多文件路径两处共用一份切片）
    #[测试]
    函数 字符切片入口与字符串入口一致() {
        让 源码 =
            "函数 主函数() {\n    让 x = 项们.展平（）;\n}\"里头的，不算\" // 注释里的，也不算";
        让 按串 = 检测全角标点(源码);
        让 字符们: 向量<字符> = 源码.逐字符().收集();
        断言相等!(检测全角标点字符(&字符们), 按串, "{按串:?}");
        断言!(
            !按串.是否为空(),
            "用例应至少命中一个全角标点，否则这条锁形同虚设"
        );
    }

    #[测试]
    函数 忽略字符串与注释() {
        让 源码 = "打印行!(\"你好，世界！？\"); // 注释：这里随便，。！\n/* 块注释：（）； */\n让 文本 = \"括号（）内的不算\";";
        让 警告们 = 检测全角标点(源码);
        断言!(
            警告们.是否为空(),
            "字符串/注释内全角标点不应报告：{警告们:?}"
        );
    }

    #[测试]
    函数 忽略字符字面态与原始串() {
        让 源码 = "让 字符 = '，';  // 字符字面态\n让 原始 = r#\"（全角）\"#;";
        让 警告们 = 检测全角标点(源码);
        断言!(警告们.是否为空(), "字符/原始字符串不应报告：{警告们:?}");
    }

    #[测试]
    函数 仅提示字符无替代() {
        让 警告们 = 检测全角标点("让 顿号、= 1;");
        断言相等!(警告们.长度(), 1);
        断言相等!(警告们[0].涉事字符, '、');
        断言相等!(警告们[0].替代字符, 无);
    }

    #[测试]
    函数 串内转义引号() {
        让 源码 = "让 文本 = \"包含\\\"引号（全角）\";";
        让 警告们 = 检测全角标点(源码);
        断言!(警告们.是否为空(), "转义串不应报告：{警告们:?}");
    }

    #[测试]
    函数 修复仅改代码位() {
        让 源码 = "函数 主函数（）{\n    打印行！（\"你好，世界\"）；\n}";
        让 (修复后, 替换数) = 修复全角标点(源码);
        断言相等!(替换数, 6);
        断言相等!(修复后, "函数 主函数(){\n    打印行!(\"你好，世界\");\n}");
        // 字符串内的全角逗号保留
        断言!(修复后.包含("你好，世界"));
    }

    #[测试]
    函数 修复保留仅提示字符() {
        让 (修复后, 替换数) = 修复全角标点("让 甲、乙 = 1；");
        断言相等!(替换数, 1, "只有全角分号被替换");
        断言相等!(修复后, "让 甲、乙 = 1;");
    }

    #[测试]
    函数 修复保留原始串() {
        让 源码 = "让 原始 = r#\"（全角）\"#;\n打印行！(\"x\");";
        让 (修复后, 替换数) = 修复全角标点(源码);
        断言相等!(替换数, 1);
        断言!(
            修复后.包含("r#\"（全角）\"#"),
            "原始字符串应保留：{修复后}"
        );
    }

    #[测试]
    函数 修复保留转义引号串() {
        // 自动修复不得改写串内内容：源码含反斜杠转义引号，若被误判为字符串结束，
        // 后半全角括号会被当代码位替换。断言只改代码位全角分号、串内逐字节原样。
        // 补 串内转义引号 只测检测、未测改写（破坏性更强）的缺口。
        让 源码 = r#"让 文本 = "含\"号（全角）"；"#;
        让 (修复后, 替换数) = 修复全角标点(源码);
        断言相等!(替换数, 1, "只有代码位全角分号应被替换：{修复后}");
        断言!(修复后.包含("号（全角）"), "串内全角括号须原样：{修复后}");
        断言相等!(修复后, r#"让 文本 = "含\"号（全角）";"#);
    }
}
