//! 映射管理器 - 统一管理所有映射表（关键字、模块路径、标识符别名）
//!
//! 提供完整的映射加载、查询接口，是翻译管线的核心数据结构。
//! 支持从文件系统目录加载或从内置字符串数据加载（无需文件系统）。

使用 标准库::同步模块::一次性锁;
使用 标准库::集合模块::{哈希映射, 哈希集合};
使用 标准库::文件系统;
使用 标准库::路径::路径类型;

// 解析原语与 mapping_source 共用单一实现（节表解析/两节合并），
// 避免两个加载器对同一 TOML 格式的理解漂移
使用 包::映射源::{
    摊平节表, 合并模块路径与标识符节, 解析配置节,
};
// 「错误类型」模块被第三方表劫持（错误类型→错误特征），改从 包 根重导出引用
使用 包::{加载目标, 加载错误};

/// 映射管理器：统一管理关键字映射、模块路径映射、标识符别名映射
///
/// 翻译管线中各阶段（词法转译、模块路径替换、别名替换）均从此处获取映射表。
/// 支持两种加载方式：
/// - `自目录加载`: 从语言包目录读取 TOML 文件
/// - `自内置加载`: 从编译时嵌入的字符串数据加载（无需文件系统）
#[派生(调试, 克隆)]
公开 结构体 映射管理器 {
    /// 关键字映射（词法转译阶段使用）
    公开 关键词映射表: 哈希映射<字符串, 字符串>,
    /// 按节（section）组织的关键字映射（用于查询宏名称等）
    节映射表: 哈希映射<字符串, 哈希映射<字符串, 字符串>>,
    /// 派生特征映射（`#[派生(...)]` 属性内专用：中文特征名 → 英文，
    /// 如 `克隆` → `Clone`；不并入 关键词映射表，避免与方法名别名冲突）
    派生映射表: 哈希映射<字符串, 字符串>,
    /// 模块路径映射（如 `标准库` → `标准库`）
    公开 模块路径映射表: 哈希映射<字符串, 字符串>,
    /// 标识符别名映射（标准库/第三方库的类型与函数名翻译）
    公开 别名映射表: 哈希映射<字符串, 字符串>,
    /// 语境指纹缓存：映射表构造后不可变，首次计算后复用。
    /// 每次转译都全量重算指纹（构建全部键值对 + 排序 + 哈希）
    /// 在批量转译场景是纯浪费（语言包不变则指纹恒定）。
    指纹缓存: 一次性锁<无符号长整数>,
    /// use 语句内的“让位词”：模块路径与别名映射（标准库 + 第三方）键的并集。
    /// 词法转译在 use 段内跳过这些词的关键字/宏替换，交由模块路径与别名
    /// 阶段按标准库语义处理——同名词在宏表与标准库表重复时 use 段内标准库
    /// 优先（`文件` 宏节为 file、标准库为 File，`使用 标准库::文件系统::文件`
    /// 必须产出 `use 标准库::文件系统::File`）。构造时一次性生成，转译时直接复用。
    使用段让位词: 哈希集合<字符串>,
    /// 方法调用位的“让位词”：词法层替换值为 Rust 保留关键字（`枚举`→enum、
    /// `匹配`→match）、而别名表（标准库 + 第三方）中该词另有不同有效词条
    /// （`枚举`=枚举、`匹配`=模式匹配）的词。词法转译在方法位（前面是
    /// `.`）跳过这些词的替换——`.枚举()` 直译会成非法的 `.enum()`，让位后
    /// 由别名阶段替换为 `.枚举()`。构造时一次性生成，转译时直接复用。
    方法位让位词: 哈希集合<字符串>,
    /// 教学 lint 已知词表缓存：全部映射表键的并集（关键字/宏/派生/模块路径/
    /// 别名）。供“方法调用位未命中映射表”的易混词提示判定——词表大且
    /// lint 每文件调用，惰性计算一次后复用（映射表构造后不可变）。
    词表缓存: 一次性锁<哈希集合<字符串>>,
    /// 教学 lint 歧义构造器被调名集缓存（见 [`Self::歧义构造词集`]）
    歧义构造器缓存: 一次性锁<哈希集合<字符串>>,
    /// 宏映射缓存（`["宏"]` 节的物化副本）：见 [`Self::取宏映射表`]
    宏映射缓存: 一次性锁<哈希映射<字符串, 字符串>>,
}

实现 映射管理器 {
    /// 从语言包目录加载全部映射（推荐用于开发模式）
    ///
    /// 加载顺序：
    /// 1. `keywords.toml` → 关键字映射
    /// 2. `module_paths.toml` → 模块路径映射
    /// 3. `stdlib.toml` → 标准库的模块路径 + 标识符别名（可选）
    /// 4. `crates/*.toml` → 第三方库的模块路径 + 标识符别名
    公开 函数 自目录加载(语言包目录: &路径类型) -> 结果<自身, 加载错误> {
        让 关键字路径 = 语言包目录.连接("keywords.toml");
        如果 !关键字路径.存在() {
            返回 错误(加载错误::新建文件缺失(
                加载目标::关键字表,
                关键字路径.展示().转字符串(),
            ));
        }

        // 1. 加载关键字映射
        让 关键字内容 = 文件系统::读取字符串(&关键字路径).映射错误(|错误值| {
            加载错误::新建读取失败(
                加载目标::关键字表,
                有值(关键字路径.展示().转字符串()),
                错误值.转字符串(),
            )
        })?;
        让 节映射表 = 解析配置节(&关键字内容).映射错误(|错误值| {
            加载错误::新建解析失败(加载目标::关键字表, 无, 错误值.转字符串())
        })?;
        // 派生特征节单独存放（不并入关键字表，避免与方法名别名冲突），
        // 并从扁平化关键字表中移除对应键
        让 派生映射表 = 节映射表.获取("派生特征").克隆副本().取值或默认();
        让 可变 关键词映射表 = 摊平节表(&节映射表);
        对于 键名 在 派生映射表.取全部键() {
            关键词映射表.移除(键名);
        }

        // 2. 加载模块路径映射（来自 module_paths.toml）
        让 模块路径磁盘项 = 语言包目录.连接("module_paths.toml");
        让 可变 模块路径映射表 = 哈希映射::新建();
        如果 模块路径磁盘项.存在() {
            让 内容 = 文件系统::读取字符串(&模块路径磁盘项).映射错误(|错误值| {
                加载错误::新建读取失败(
                    加载目标::模块路径表,
                    有值(模块路径磁盘项.展示().转字符串()),
                    错误值.转字符串(),
                )
            })?;
            让 节表 = 解析配置节(&内容).映射错误(|错误值| {
                加载错误::新建解析失败(加载目标::模块路径表, 无, 错误值.转字符串())
            })?;
            如果让 有值(条目项) = 节表.获取("模块路径") {
                模块路径映射表.扩展(条目项.迭代().变换(|(键名, 值项)| (键名.克隆值(), 值项.克隆值())));
            }
        }

        // 3. 扫描第三方库目录（crates/）
        // 文件按文件名排序后合并：读取目录 顺序未定义，同键不同值时
        // 合并结果必须确定（与 自内置加载 的排序行为一致）
        让 库目录 = 语言包目录.连接("crates");
        让 可变 别名映射表 = 哈希映射::新建();
        如果 库目录.存在() && 库目录.是否为目录() {
            // 读取目录 或条目读取失败必须报错（不能静默吞掉），
            // 否则第三方库映射整体丢失且用户无感知
            让 可变 配置表路径列表 = 向量::新建();
            对于 迭代项 在
                文件系统::读取目录(&库目录).映射错误(|错误值| 加载错误::目录读取失败 {
                    详情: 错误值.转字符串(),
                })?
            {
                让 迭代项 = 迭代项.映射错误(|错误值| 加载错误::目录读取失败 {
                    详情: 错误值.转字符串(),
                })?;
                让 磁盘项 = 迭代项.路径模块();
                如果 磁盘项.取扩展名().而后映射(|错误值| 错误值.取字符串引用()) == 有值("toml") {
                    配置表路径列表.推入(磁盘项);
                }
            }
            配置表路径列表.排序();
            对于 磁盘路径 在 配置表路径列表 {
                让 内容 = 文件系统::读取字符串(&磁盘路径).映射错误(|错误值| {
                    加载错误::新建读取失败(
                        加载目标::第三方库,
                        有值(磁盘路径.展示().转字符串()),
                        错误值.转字符串(),
                    )
                })?;
                合并模块路径与标识符节(&内容, &可变 模块路径映射表, &可变 别名映射表)
                    .映射错误(|错误值| {
                        加载错误::新建解析失败(
                            加载目标::第三方库,
                            有值(磁盘路径.展示().转字符串()),
                            错误值.转字符串(),
                        )
                    })?;
            }
        }

        // 4. 加载标准库映射（stdlib.toml，可选，最后加载以保证优先）
        //    与 crates/*.toml 相同格式：["模块路径"] + ["标识符"] 两节
        //    后加载会覆盖第三方库中同名的通用词（如 mpsc 的 "发送" 不被 HTTP 库的 "post" 覆盖）
        //    文件存在但读取失败必须报错（不能静默跳过，否则标准库映射整体丢失）
        让 标准库磁盘项 = 语言包目录.连接("stdlib.toml");
        如果 标准库磁盘项.存在() {
            让 内容 = 文件系统::读取字符串(&标准库磁盘项).映射错误(|错误值| {
                加载错误::新建读取失败(
                    加载目标::标准库表,
                    有值(标准库磁盘项.展示().转字符串()),
                    错误值.转字符串(),
                )
            })?;
            合并模块路径与标识符节(&内容, &可变 模块路径映射表, &可变 别名映射表)
                .映射错误(|错误值| {
                    加载错误::新建解析失败(
                        加载目标::标准库表,
                        有值(标准库磁盘项.展示().转字符串()),
                        错误值.转字符串(),
                    )
                })?;
        }

        让 使用段让位词 = 自身::构建使用段让位词(&模块路径映射表, &别名映射表);
        让 方法位让位词 = 自身::构建方法位让位词(&关键词映射表, &别名映射表);
        成功(自身 {
            关键词映射表,
            节映射表,
            派生映射表,
            使用段让位词,
            方法位让位词,
            模块路径映射表,
            别名映射表,
            指纹缓存: 一次性锁::新建(),
            词表缓存: 一次性锁::新建(),
            歧义构造器缓存: 一次性锁::新建(),
            宏映射缓存: 一次性锁::新建(),
        })
    }

    /// 从内置数据加载全部映射（无需文件系统，用于编译时嵌入）
    ///
    /// 参数：
    /// - `keywords_toml`: keywords.toml 的完整内容
    /// - `module_paths_toml`: module_paths.toml 的完整内容
    /// - `stdlib_toml`: stdlib.toml 的完整内容（标准库的模块路径 + 标识符别名）
    /// - `third_party_data`: 各第三方库 .toml 文件的 (文件名, 内容) 列表
    公开 函数 自内置加载(
        关键字数据: &文本,
        模块路径数据: &文本,
        标准库数据: &文本,
        第三方数据: &[(&文本, &文本)],
    ) -> 结果<自身, 加载错误> {
        // 1. 解析关键字映射
        让 节映射表 = 解析配置节(关键字数据).映射错误(|错误值| {
            加载错误::新建解析失败(加载目标::内置关键字, 无, 错误值.转字符串())
        })?;
        // 派生特征节单独存放（不并入关键字表），并从扁平化关键字表中移除
        让 派生映射表 = 节映射表.获取("派生特征").克隆副本().取值或默认();
        让 可变 关键词映射表 = 摊平节表(&节映射表);
        对于 键名 在 派生映射表.取全部键() {
            关键词映射表.移除(键名);
        }

        // 2. 解析模块路径映射
        让 可变 模块路径映射表 = 哈希映射::新建();
        让 节表 = 解析配置节(模块路径数据).映射错误(|错误值| {
            加载错误::新建解析失败(加载目标::内置模块路径表, 无, 错误值.转字符串())
        })?;
        如果让 有值(条目项) = 节表.获取("模块路径") {
            模块路径映射表.扩展(条目项.迭代().变换(|(键名, 值项)| (键名.克隆值(), 值项.克隆值())));
        }

        // 3. 解析标准库映射（模块路径 + 标识符别名）
        让 可变 别名映射表 = 哈希映射::新建();
        让 节表 = 解析配置节(标准库数据).映射错误(|错误值| {
            加载错误::新建解析失败(加载目标::内置标准库表, 无, 错误值.转字符串())
        })?;
        如果让 有值(条目项) = 节表.获取("模块路径") {
            模块路径映射表.扩展(条目项.迭代().变换(|(键名, 值项)| (键名.克隆值(), 值项.克隆值())));
        }
        如果让 有值(条目项) = 节表.获取("标识符") {
            别名映射表.扩展(条目项.迭代().变换(|(键名, 值项)| (键名.克隆值(), 值项.克隆值())));
        }

        // 4. 解析第三方库映射（按文件名排序合并，与 自目录加载 行为一致）
        让 可变 排序列表: 向量<&(&文本, &文本)> = 第三方数据.迭代().收集();
        排序列表.按键排序(|(目录名, _)| *目录名);
        对于 (目录名, 内容) 在 排序列表 {
            合并模块路径与标识符节(内容, &可变 模块路径映射表, &可变 别名映射表)
                .映射错误(|错误值| {
                    加载错误::新建解析失败(
                        加载目标::第三方库,
                        有值((*目录名).转字符串()),
                        错误值.转字符串(),
                    )
                })?;
        }

        让 使用段让位词 = 自身::构建使用段让位词(&模块路径映射表, &别名映射表);
        让 方法位让位词 = 自身::构建方法位让位词(&关键词映射表, &别名映射表);
        成功(自身 {
            关键词映射表,
            节映射表,
            派生映射表,
            使用段让位词,
            方法位让位词,
            模块路径映射表,
            别名映射表,
            指纹缓存: 一次性锁::新建(),
            词表缓存: 一次性锁::新建(),
            歧义构造器缓存: 一次性锁::新建(),
            宏映射缓存: 一次性锁::新建(),
        })
    }

    /// 向后兼容：从单个关键字文件加载（委托给 自目录加载）
    公开 函数 自文件加载(磁盘路径: &路径类型) -> 结果<自身, 加载错误> {
        让 目录 = 磁盘路径.父目录().解包或用(路径类型::新建("."));
        自身::自目录加载(目录)
    }

    /// 从已解析的映射表直接构造（旧格式语言包/降级场景）
    ///
    /// 不包含节信息（宏表/派生表为空），仅提供关键字/模块路径/别名三类映射；
    /// 用于 LSP 旧"映射表"目录格式与硬编码兜底表的接入。
    公开 函数 自扁平映射新建(
        关键词映射表: 哈希映射<字符串, 字符串>,
        模块路径映射表: 哈希映射<字符串, 字符串>,
        别名映射表: 哈希映射<字符串, 字符串>,
    ) -> 自身 {
        让 使用段让位词 = 自身::构建使用段让位词(&模块路径映射表, &别名映射表);
        让 方法位让位词 = 自身::构建方法位让位词(&关键词映射表, &别名映射表);
        自身 {
            关键词映射表,
            节映射表: 哈希映射::新建(),
            派生映射表: 哈希映射::新建(),
            使用段让位词,
            方法位让位词,
            模块路径映射表,
            别名映射表,
            指纹缓存: 一次性锁::新建(),
            词表缓存: 一次性锁::新建(),
            歧义构造器缓存: 一次性锁::新建(),
            宏映射缓存: 一次性锁::新建(),
        }
    }

    /// 查询关键字映射
    公开 函数 检索(&自我, 母语词: &文本) -> 选项<&字符串> {
        自我.关键词映射表.获取(母语词)
    }

    /// 获取完整关键字映射表
    公开 函数 取关键词映射表(&自我) -> &哈希映射<字符串, 字符串> {
        &自我.关键词映射表
    }

    /// 获取指定节的映射表
    公开 函数 取节映射(&自我, 节名: &文本) -> 选项<&哈希映射<字符串, 字符串>> {
        自我.节映射表.获取(节名)
    }

    /// 获取模块路径映射表
    公开 函数 取模块路径映射表(&自我) -> &哈希映射<字符串, 字符串> {
        &自我.模块路径映射表
    }

    /// 获取标识符别名映射表
    公开 函数 取别名映射表(&自我) -> &哈希映射<字符串, 字符串> {
        &自我.别名映射表
    }

    /// 获取 use 语句内的让位词集合（见字段 `use_defer_words` 说明）
    公开 函数 取使用延迟词(&自我) -> &哈希集合<字符串> {
        &自我.使用段让位词
    }

    /// 获取方法调用位让位词集合（见字段 `method_defer_words` 说明）
    公开 函数 取方法延迟词(&自我) -> &哈希集合<字符串> {
        &自我.方法位让位词
    }

    /// 获取教学 lint 已知词表（见字段 `lint_words_cache` 说明）：
    /// 关键字/宏/派生/模块路径/别名五表键的并集，惰性计算一次后复用。
    公开 函数 取教学检查词(&自我) -> &哈希集合<字符串> {
        自我.词表缓存.取得或初始化(|| {
            让 可变 词集: 哈希集合<字符串> = 哈希集合::新建();
            词集.扩展(自我.关键词映射表.取全部键().克隆副本());
            如果让 有值(宏节) = 自我.节映射表.获取("宏") {
                词集.扩展(宏节.取全部键().克隆副本());
            }
            词集.扩展(自我.派生映射表.取全部键().克隆副本());
            词集.扩展(自我.模块路径映射表.取全部键().克隆副本());
            词集.扩展(自我.别名映射表.取全部键().克隆副本());
            词集
        })
    }

    /// 教学 lint「未标注类型」用：类型推导歧义构造器被调名集合
    ///
    /// 含英文原词 `新建`/`缺省` 与全部映射表中值恰为这些词的方言键
    /// （如 zh：`新建`→新建、`默认值`/`缺省`→缺省）。仅供 lint 启发式
    /// 判定 `X::新建()` 这类无法自行推导结果类型的关联构造调用。
    公开 函数 歧义构造词集(&自我) -> 哈希集合<字符串> {
        自我.歧义构造器缓存
            .取得或初始化(|| {
                让 可变 词集: 哈希集合<字符串> = ["new".转字符串(), "default".转字符串()]
                    .转迭代()
                    .收集();
                对于 映射表 在 [&自我.关键词映射表, &自我.模块路径映射表, &自我.别名映射表] {
                    词集.扩展(
                        映射表.迭代()
                            .过滤(|(_, 英文词)| 模式匹配!(英文词.作为字符串(), "new" | "default"))
                            .变换(|(母语词, _)| 母语词.克隆值()),
                    );
                }
                词集
            })
            .克隆值()
    }

    /// 构建 use 段让位词集合：模块路径与别名映射键的并集
    函数 构建使用段让位词(
        模块路径映射: &哈希映射<字符串, 字符串>,
        别名映射: &哈希映射<字符串, 字符串>,
    ) -> 哈希集合<字符串> {
        模块路径映射
            .取全部键()
            .链式(别名映射.取全部键())
            .克隆副本()
            .收集()
    }

    /// 构建方法调用位让位词集合：词法层替换值为 Rust 保留关键字、且别名表
    /// 中该词另有不同且有效（非保留字）的词条——仅此冲突类让位，其余词
    /// （如 `文件`：宏节 file / 别名 File）在方法位保留词法层行为，避免
    /// 改变本就合法的产物（`.文件()` 依旧是 `.file()`）。
    函数 构建方法位让位词(
        关键字映射: &哈希映射<字符串, 字符串>,
        别名映射: &哈希映射<字符串, 字符串>,
    ) -> 哈希集合<字符串> {
        关键字映射
            .迭代()
            .过滤(|(词条, 英文词)| {
                自身::是否为保留关键字(英文词)
                    && 别名映射
                        .获取(*词条)
                        .有值且(|别名| 别名 != *英文词 && !自身::是否为保留关键字(别名))
            })
            .变换(|(词条, _)| 词条.克隆值())
            .收集()
    }

    /// Rust 保留关键字（不能用作标识符；`union` 等弱关键字不在列，仍可作
    /// 方法名）。用于方法位让位词判定：替换值是保留关键字的词在方法位直译
    /// 必为非法产物（`.enum()`），应让位给别名表。
    函数 是否为保留关键字(词项: &文本) -> 布尔 {
        模式匹配!(
            词项,
            "abstract"
                | "as"
                | "async"
                | "await"
                | "become"
                | "box"
                | "break"
                | "const"
                | "continue"
                | "crate"
                | "do"
                | "dyn"
                | "else"
                | "enum"
                | "extern"
                | "false"
                | "final"
                | "fn"
                | "for"
                | "if"
                | "impl"
                | "in"
                | "let"
                | "loop"
                | "macro"
                | "match"
                | "mod"
                | "move"
                | "mut"
                | "override"
                | "priv"
                | "pub"
                | "ref"
                | "return"
                | "self"
                | "Self"
                | "static"
                | "struct"
                | "super"
                | "trait"
                | "true"
                | "try"
                | "type"
                | "typeof"
                | "unsafe"
                | "unsized"
                | "use"
                | "virtual"
                | "where"
                | "while"
                | "yield"
        )
    }

    /// 翻译语境指纹（惰性计算并缓存）：任一映射表内容变化时指纹变化。
    /// 映射表在构造后不可变，多次转译共用同一指纹，避免每次全量重算。
    公开 函数 语境指纹(&自我) -> 无符号长整数 {
        *自我.指纹缓存.取得或初始化(|| {
            包::缓存::转译缓存::生成语境指纹(
                &自我.关键词映射表,
                &自我.模块路径映射表,
                &自我.别名映射表,
                &自我.派生映射表,
            )
        })
    }

    /// 获取所有在 `["宏"]` 节中定义的中文宏名集合（不含感叹号）
    ///
    /// 用于词法转译阶段的宏感叹号自动补充：
    /// 当标识符是宏名称且后面跟着 `(`/`[`/`{` 时，自动插入 `!`。
    公开 函数 取宏名集(&自我) -> 哈希集合<字符串> {
        让 可变 宏集 = 哈希集合::新建();
        如果让 有值(宏节) = 自我.节映射表.获取("宏") {
            对于 母语词 在 宏节.取全部键() {
                宏集.插入(母语词.克隆值());
            }
        }
        宏集
    }

    /// 获取宏映射表（中文宏名 → 英文宏名），来自 `["宏"]` 节
    ///
    /// 与 [`取宏名集`] 的区别：保留每个宏名的英文替换值。
    /// 宏名同时在类型节与宏节定义时（如 `向量` 类型节为 `新建向量`、宏节为 `向量宏`），
    /// 关键词映射表 中值被类型节覆盖，宏调用必须用本映射才能得到正确的英文宏名。
    ///
    /// 返回引用而非副本：该映射由 `section_map` 派生，每次调用都克隆整表
    /// 在批量转译/项目上下文收集中是纯浪费（映射表构造后不可变），
    /// 故惰性物化一次缓存后复用（与 [`Self::取教学检查词`] 同一策略）。
    公开 函数 取宏映射表(&自我) -> &哈希映射<字符串, 字符串> {
        自我.宏映射缓存
            .取得或初始化(|| 自我.节映射表.获取("宏").克隆副本().取值或默认())
    }

    /// 获取派生特征映射（中文特征名 → 英文），来自 `["派生特征"]` 节
    ///
    /// 仅在 `#[派生(...)]` 属性内生效（词法转译的派生参数态），
    /// 如 `克隆` → `Clone`；方法调用 `值.克隆()` 仍走别名表（`克隆值` 小写）。
    /// 返回引用而非副本：`derive_map` 本身已是字段，克隆纯属浪费。
    公开 函数 取派生映射表(&自我) -> &哈希映射<字符串, 字符串> {
        &自我.派生映射表
    }

    /// 检测映射表中的循环引用（A→B 且 B→A 的互指对）
    ///
    /// 覆盖三类：关键字表内部（含宏节）、别名表内部、关键字↔别名跨表。
    /// 循环引用会使正向转译与反向转译来回抖动（译出又译回），
    /// 是语言包配置的严重错误；返回人类可读的循环描述列表（空 = 无循环）。
    /// 自映射（A→A）不视为循环（回译无抖动，但属冗余条目）。
    公开 函数 查找映射环(&自我) -> 向量<字符串> {
        让 可变 循环列表 = 向量::新建();
        让 检查自环 = |映射表: &哈希映射<字符串, 字符串>, 标签: &文本, 循环列表: &可变 向量<字符串>| {
            对于 (键名, 值项) 在 映射表 {
                如果 键名 != 值项 && 映射表.获取(值项).有值且(|反向| 反向 == 键名) {
                    循环列表.推入(格式化!("{标签}: {键名} ↔ {值项}"));
                }
            }
        };
        检查自环(&自我.关键词映射表, "关键字", &可变 循环列表);
        检查自环(&自我.别名映射表, "别名", &可变 循环列表);
        // 跨表：关键字阶段替换后的英文值若命中别名表键、且别名替换回原键，
        // 则管线末尾中文残留（别名阶段把关键字阶段的结果又译了回去）
        对于 (键名, 值项) 在 &自我.关键词映射表 {
            如果 键名 != 值项 && 自我.别名映射表.获取(值项).有值且(|反向| 反向 == 键名) {
                循环列表.推入(格式化!("关键字↔别名: {键名} ↔ {值项}"));
            }
        }
        循环列表
    }
}

#[配置(测试)]
模块 单元测试 {
    使用 超级::*;
    使用 标准库::文件系统;

    /// 在临时目录下构造一个完整的语言包目录并返回其路径
    函数 构造语言包(根目录: &标准库::路径模块::路径类型, 目录名: &文本) -> 标准库::路径模块::路径缓冲类型 {
        让 目录 = 根目录.连接(目录名);
        文件系统::递归创建目录(目录.连接("crates")).解包();
        文件系统::写入(
            目录.连接("keywords.toml"),
            "[\"声明\"]\n\"函数\" = \"fn\"\n\"让\" = \"let\"\n[\"宏\"]\n\"打印行\" = \"println\"\n",
        )
        .解包();
        文件系统::写入(
            目录.连接("module_paths.toml"),
            "[\"模块路径\"]\n\"标准库\" = \"std\"\n",
        )
        .解包();
        文件系统::写入(
            目录.连接("stdlib.toml"),
            "[\"模块路径\"]\n\"文件系统\" = \"std::fs\"\n[\"标识符\"]\n\"字符串\" = \"String\"\n\"新\" = \"new\"\n",
        )
        .解包();
        文件系统::写入(
            目录.连接("crates").连接("web.toml"),
            "[\"模块路径\"]\n\"网络库\" = \"reqwest\"\n[\"标识符\"]\n\"客户端\" = \"Client\"\n",
        )
        .解包();
        目录
    }

    #[测试]
    函数 测试从目录加载完整包() {
        让 临时 = 临时文件::建临时目录().解包();
        让 目录 = 构造语言包(临时.路径模块(), "zh");

        让 管理器 = 映射管理器::自目录加载(&目录).期望("语言包应能完整加载");

        // 关键字映射（keywords.toml 全部节合并）
        断言相等!(管理器.检索("函数"), 有值(&"fn".转字符串()));
        断言相等!(管理器.检索("让"), 有值(&"let".转字符串()));
        // 模块路径映射（module_paths.toml + stdlib.toml 合并）
        断言相等!(
            管理器.模块路径映射表.获取("标准库"),
            有值(&"std".转字符串())
        );
        断言相等!(
            管理器.模块路径映射表.获取("文件系统"),
            有值(&"std::fs".转字符串())
        );
        // 标识符别名映射（stdlib.toml + crates/*.toml 合并）
        断言相等!(管理器.别名映射表.获取("字符串"), 有值(&"String".转字符串()));
        断言相等!(管理器.别名映射表.获取("新"), 有值(&"new".转字符串()));
        断言相等!(管理器.别名映射表.获取("客户端"), 有值(&"Client".转字符串()));
        // 宏集合（仅宏节）
        断言!(管理器.取宏名集().包含("打印行"));
        断言!(!管理器.取宏名集().包含("函数"));
        // 方法位让位词：合成包无「保留字替换值 + 别名表另有有效词条」的冲突词
        断言!(管理器.取方法延迟词().是否为空());
    }

    #[测试]
    函数 测试构建方法位让位词() {
        // 保留字替换值 + 别名表另有不同有效词条 → 让位；
        // 替换值非保留字、别名表无词条、别名词条同为保留字 → 均不让位
        让 关键词映射表 = 哈希映射::从([
            ("枚举".转字符串(), "enum".转字符串()),
            ("函数".转字符串(), "fn".转字符串()),
            ("文件".转字符串(), "file".转字符串()),
            ("让".转字符串(), "let".转字符串()),
            ("类型".转字符串(), "type".转字符串()),
        ]);
        让 别名映射表 = 哈希映射::从([
            ("枚举".转字符串(), "enumerate".转字符串()),
            ("函数".转字符串(), "Fn".转字符串()),
            ("文件".转字符串(), "File".转字符串()),
            ("类型".转字符串(), "enum".转字符串()),
        ]);
        让 词集 = 映射管理器::构建方法位让位词(&关键词映射表, &别名映射表);
        断言相等!(
            词集,
            哈希集合::从(["枚举".转字符串(), "函数".转字符串()])
        );
    }

    #[测试]
    函数 测试从目录加载缺关键字() {
        让 _守卫 = 包::语言::测试语言("zh");
        让 临时 = 临时文件::建临时目录().解包();
        让 错误串 = 映射管理器::自目录加载(临时.路径模块()).取错误值();
        断言!(
            错误串.转字符串().包含("关键字文件不存在"),
            "错误信息应指明缺失文件: {}",
            错误串
        );
    }

    #[测试]
    函数 测试从目录加载非法关键字() {
        让 _守卫 = 包::语言::测试语言("zh");
        让 临时 = 临时文件::建临时目录().解包();
        文件系统::写入(临时.路径模块().连接("keywords.toml"), "这不是合法 TOML [[[").解包();
        让 错误串 = 映射管理器::自目录加载(临时.路径模块()).取错误值();
        断言!(
            错误串.转字符串().包含("解析关键字 TOML 失败"),
            "错误信息应含解析失败: {}",
            错误串
        );
    }

    #[测试]
    函数 测试从目录加载缺可选文件() {
        // 仅有 keywords.toml 时，可选文件缺失不应报错
        让 临时 = 临时文件::建临时目录().解包();
        文件系统::写入(
            临时.路径模块().连接("keywords.toml"),
            "[\"声明\"]\n\"函数\" = \"fn\"\n",
        )
        .解包();
        让 管理器 = 映射管理器::自目录加载(临时.路径模块()).期望("仅有关键字文件也应可加载");
        断言!(管理器.模块路径映射表.是否为空());
        断言!(管理器.别名映射表.是否为空());
    }

    #[测试]
    函数 测试从内置加载标准库合并() {
        让 关键字数据 = "[\"声明\"]\n\"函数\" = \"fn\"\n";
        让 模块路径数据 = "[\"模块路径\"]\n\"标准库\" = \"std\"\n";
        让 标准库数据 =
            "[\"模块路径\"]\n\"文件系统\" = \"std::fs\"\n[\"标识符\"]\n\"字符串\" = \"String\"\n";
        让 第三方数据 = [("web.toml", "[\"标识符\"]\n\"客户端\" = \"Client\"\n")];

        让 管理器 =
            映射管理器::自内置加载(关键字数据, 模块路径数据, 标准库数据, &第三方数据)
                .期望("内置数据应能加载");

        断言相等!(管理器.检索("函数"), 有值(&"fn".转字符串()));
        断言相等!(
            管理器.模块路径映射表.获取("标准库"),
            有值(&"std".转字符串())
        );
        断言相等!(
            管理器.模块路径映射表.获取("文件系统"),
            有值(&"std::fs".转字符串())
        );
        断言相等!(管理器.别名映射表.获取("字符串"), 有值(&"String".转字符串()));
        断言相等!(管理器.别名映射表.获取("客户端"), 有值(&"Client".转字符串()));
    }

    #[测试]
    函数 测试从内置加载非法标准库() {
        让 _守卫 = 包::语言::测试语言("zh");
        让 关键字数据 = "[\"声明\"]\n";
        让 模块路径数据 = "[\"模块路径\"]\n";
        让 错误串 =
            映射管理器::自内置加载(关键字数据, 模块路径数据, "非法内容", &[]).取错误值();
        断言!(
            错误串.转字符串().包含("解析内置标准库 TOML 失败"),
            "错误信息应含解析失败: {}",
            错误串
        );
    }

    #[测试]
    函数 测试从文件加载委托目录() {
        让 临时 = 临时文件::建临时目录().解包();
        让 目录 = 构造语言包(临时.路径模块(), "zh");
        让 管理器 =
            映射管理器::自文件加载(&目录.连接("keywords.toml")).期望("委托加载应成功");
        断言相等!(管理器.检索("函数"), 有值(&"fn".转字符串()));
    }

    #[测试]
    函数 测试合并节报告非法内容() {
        让 可变 模块路径映射表 = 哈希映射::新建();
        让 可变 别名映射表 = 哈希映射::新建();
        // 非法 TOML 不应 崩溃，但必须报告错误（不再静默忽略，防止映射丢失）
        让 错误串 = 合并模块路径与标识符节("[[[", &可变 模块路径映射表, &可变 别名映射表)
            .期望错误("非法 TOML 应返回错误");
        断言!(!错误串.转字符串().是否为空());
        断言!(模块路径映射表.是否为空());
        断言!(别名映射表.是否为空());
        // 合法内容正常合并
        合并模块路径与标识符节(
            "[\"模块路径\"]\n\"文件系统\" = \"std::fs\"\n[\"标识符\"]\n\"字符串\" = \"String\"\n",
            &可变 模块路径映射表,
            &可变 别名映射表,
        )
        .期望("合法 TOML 应合并成功");
        断言相等!(
            模块路径映射表.获取("文件系统"),
            有值(&"std::fs".转字符串())
        );
        断言相等!(别名映射表.获取("字符串"), 有值(&"String".转字符串()));
    }

    #[测试]
    函数 测试获取节映射与查询() {
        让 临时 = 临时文件::建临时目录().解包();
        让 目录 = 构造语言包(临时.路径模块(), "zh");
        让 管理器 = 映射管理器::自目录加载(&目录).解包();

        让 声明节 = 管理器.取节映射("声明").期望("声明节应存在");
        断言相等!(声明节.获取("函数"), 有值(&"fn".转字符串()));
        断言相等!(管理器.取节映射("不存在的节"), 无);
        断言相等!(管理器.检索("不存在的关键字"), 无);
    }

    /// 循环引用检测：关键字表内部互指
    #[测试]
    函数 测试查找映射循环关键字自环() {
        让 管理器 = 映射管理器::自扁平映射新建(
            哈希映射::从([
                ("函数".转字符串(), "fn".转字符串()),
                ("方法".转字符串(), "函数".转字符串()),
                ("函数".转字符串(), "方法".转字符串()), // 后写覆盖：函数→方法
            ]),
            哈希映射::新建(),
            哈希映射::新建(),
        );
        让 循环列表 = 管理器.查找映射环();
        断言!(
            循环列表.迭代().任意(|项| 项.包含("方法 ↔ 函数")),
            "应检测到关键字互指循环：{循环列表:?}"
        );
    }

    /// 循环引用检测：别名表内部互指
    #[测试]
    函数 测试查找映射循环别名自环() {
        让 管理器 = 映射管理器::自扁平映射新建(
            哈希映射::新建(),
            哈希映射::新建(),
            哈希映射::从([
                ("甲".转字符串(), "乙".转字符串()),
                ("乙".转字符串(), "甲".转字符串()),
            ]),
        );
        让 循环列表 = 管理器.查找映射环();
        断言!(
            循环列表
                .迭代()
                .任意(|项| 项.包含("别名") && 项.包含("甲 ↔ 乙")),
            "应检测到别名互指循环：{循环列表:?}"
        );
    }

    /// 循环引用检测：关键字↔别名跨表互指（管线末尾中文残留）
    #[测试]
    函数 测试查找映射循环跨表() {
        让 管理器 = 映射管理器::自扁平映射新建(
            哈希映射::从([("甲".转字符串(), "乙".转字符串())]),
            哈希映射::新建(),
            哈希映射::从([("乙".转字符串(), "甲".转字符串())]),
        );
        让 循环列表 = 管理器.查找映射环();
        断言!(
            循环列表
                .迭代()
                .任意(|项| 项.包含("关键字↔别名") && 项.包含("甲 ↔ 乙")),
            "应检测到跨表互指循环：{循环列表:?}"
        );
    }

    /// 正常映射表（含同值不同键、自映射豁免）不产生循环报告
    #[测试]
    函数 测试查找映射循环干净表() {
        让 管理器 = 映射管理器::自扁平映射新建(
            哈希映射::从([
                ("函数".转字符串(), "fn".转字符串()),
                ("让".转字符串(), "let".转字符串()),
            ]),
            哈希映射::新建(),
            哈希映射::从([("字符串".转字符串(), "String".转字符串())]),
        );
        断言!(管理器.查找映射环().是否为空());
    }
}
