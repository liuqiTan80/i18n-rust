//! 全局语言与界面消息模块【zh 自举·批次1】
//! 本文件是源真相：由引导 rzc 转译为 语言.rs 后交 cargo 编译。
//! 再生成方式见 tools/zh-selfhost/regen.sh；请勿手改同目录下的 语言.rs。
//!
//! 引擎内所有用户可见消息（错误、诊断、日志、分类名等）经此模块
//! 按全局语言代码输出，彻底消除硬编码中文。
//!
//! - 语言由 CLI / LSP 启动时通过 [`设定语言`] 指定，默认 `zh`；
//! - 消息模板来自各语言包 `ui.toml` 的 `["界面消息"]` 节，编译期嵌入，
//!   运行期惰性解析（每语言一次），占位符 `{}` 按出现顺序替换；
//! - 缺失键依次回退：当前语言表 → 中文表 → 键名本身。
//!
//! 注：本模块是全项目公共底座，其导出 API（t/f/设定语言/当前语言/
//! builtin_* 等）被 engine/cli/lsp 数百处按名字调用，且与 build.rs 生成的
//! `BUILTIN_FILES`/`ui_table_for` 构成契约，故公开名保持英文（跨 包 稳定 ABI，
//! 属 rzc 官方支持的英文透传）；内部实现、私有函数、局部变量、测试均已中文化。

使用 标准库::集合::哈希映射;
使用 标准库::同步::{互斥锁, 互斥守卫};
// 注：`互斥守卫` 必须从 use 导入后以裸名用于类型位——若写成 `标准库::同步::互斥守卫`
// 全路径，类型位置的 `同步` 会被同形词条解析成 标准库::Sync（大写，Sync auto-trait），
// 产生非法路径；use 语句位置的 `同步` 才正确解析为 标准库::同步模块。

/// 全局语言代码（默认 zh，由 CLI/LSP 启动时设置；可重复设置以便测试恢复）
静态 当前语言存储: 互斥锁<字符串> = 互斥锁::新建(字符串::新建());

/// 获取语言锁；投毒时恢复而非 崩溃（锁内无关键不变量，
/// 仅存语言代码字符串，崩溃 传播会拖垮整个诊断输出链路）
函数 取语言锁() -> 互斥守卫<'static, 字符串> {
    当前语言存储
        .加锁()
        .解包或用否则(|投毒| 投毒.取内层())
}

#[配置(测试)]
/// 测试级互斥锁：串行化所有修改全局语言或断言语言相关文本的测试，
/// 防止 test_set_language_de 等并行执行时把 CURRENT_LANG 污染为其他语言
公开(包) 静态 语言测试锁: 互斥锁<()> = 互斥锁::新建(());

/// 设置全局语言代码
公开 函数 设定语言(代码: &文本) {
    *取语言锁() = 代码.转字符串();
}

/// RAII 语言作用域守卫：构造时设置语言，drop 时恢复进入前的值
///
/// 用于测试与临时切换场景，消除手工 `设定语言` + 末尾恢复
/// 的遗忘风险（忘记恢复会在并行测试间污染全局语言，是历史
/// flaky 的根因类别）。注意：守卫只保证恢复，不保证串行化；
/// 测试中仍应配合 [`语言测试锁`] 持锁使用。
公开 结构体 语言守卫 {
    先前: 字符串,
}

实现 语言守卫 {
    /// 切换到指定语言，记录进入前的语言供 drop 时恢复
    公开 函数 进入守卫(代码: &文本) -> 自身 {
        让 可变 语言守卫 = 取语言锁();
        让 先前 = 语言守卫.克隆();
        *语言守卫 = 代码.转字符串();
        自身 { 先前 }
    }
}

实现 可丢弃 对于 语言守卫 {
    函数 丢弃(&可变 自我) {
        // 内存::取值 避免在 drop 中克隆；恢复后 previous 置空不再使用
        *取语言锁() = 标准库::内存::取值(&可变 自我.先前);
    }
}

/// 便捷入口：`let _g = 语言::附带语言("ru");` 作用域内生效，离开自动恢复
公开 函数 附带语言(代码: &文本) -> 语言守卫 {
    语言守卫::进入守卫(代码)
}

/// 测试语言守卫：持 [`语言测试锁`] 串行化并切换到指定语言，
/// drop 时先恢复原语言后释放锁（字段声明顺序决定 drop 顺序，
/// 断言 崩溃 也不会泄漏语言或锁）。
///
/// 加锁抗毒化：即使先前有测试持锁 崩溃 导致锁中毒，也接管继续
/// 执行，避免一次偶发断言失败沿锁毒化放大为整批测试连环失败。
/// 所有修改或断言全局语言的测试应统一使用本守卫。
#[配置(测试)]
公开(包) 结构体 语言测试守卫 {
    _语言守卫: 语言守卫,
    _锁: 互斥守卫<'static, ()>,
}

/// 测试入口：`let _g = 语言::测试语言("zh");` 串行化 + 语言钉住，离开自动恢复
#[配置(测试)]
公开(包) 函数 测试语言(代码: &文本) -> 语言测试守卫 {
    让 锁 = 语言测试锁
        .加锁()
        .解包或用否则(标准库::同步模块::中毒错误::取内层);
    语言测试守卫 {
        _语言守卫: 语言守卫::进入守卫(代码),
        _锁: 锁,
    }
}

/// 当前全局语言代码（未设置时为 zh）
公开 函数 当前语言() -> 字符串 {
    让 语言守卫 = 取语言锁();
    如果 语言守卫.是否为空() {
        "zh".转字符串()
    } 否则 {
        语言守卫.克隆()
    }
}

/// 解析 ui.toml 内容为消息表（键 → 模板）
///
/// 函数名 `解析界面表` 是 build.rs 代码生成器契约符号——生成的
/// `builtin_generated.rs` 按英文名调用它初始化各语言消息表，故不可中文化。
///
/// 使用自有 字符串值 存储而非 `&'static str`：每语言表仅解析一次，
/// `Box::leak` 会永久泄漏全部消息文本，无必要。
函数 解析界面表(内容: &文本) -> 哈希映射<字符串, 字符串> {
    让 可变 消息表 = 哈希映射::新建();
    如果让 成功(解析值) = TOML处理::解析字符串::<TOML处理::JSON值>(内容)
        && 让 有值(表) = 解析值.截取("界面消息").而后映射(|值| 值.作为表格())
    {
        对于 (键, 值项) 在 表 {
            如果让 有值(消息内容) = 值项.作为字符串() {
                消息表.插入(键.克隆(), 消息内容.转字符串());
            }
        }
    }
    消息表
}

// build.rs 扫描 lang-packs/ 自动生成的内嵌清单（勿手工编辑）：
// - BUILTIN_FILES：(语言代码, 相对路径, 内容) 全量清单
// - UI_TABLE_*：每语言 ui.toml 消息表静态实例 + ui_table_for 路由
// 新增语言包文件无需修改任何 Rust 代码，重新编译即自动纳入。
包含文件!(拼接!(编译环境宏!("OUT_DIR"), "/builtin_generated.rs"));

/// 按语言代码取内置语言包文件的编译期内容（供 CLI / LSP 嵌入回退数据）
///
/// `file` 为语言包目录内的相对路径，如 `"keywords.toml"`、
/// `"crates/序列化.toml"`；未知语言或文件返回 `无`。
/// 清单由 build.rs 扫描 lang-packs/ 自动生成，覆盖全部语言与文件。
公开 函数 内置文件(语言代码: &文本, 文件名: &文本) -> 选项<&'static 文本> {
    BUILTIN_FILES
        .迭代器()
        .查找(|(语言位, 文件位, _)| *语言位 == 语言代码 && *文件位 == 文件名)
        .映射(|(_, _, 内容)| *内容)
}

/// 列出某语言的全部内嵌语言包文件（相对路径 → 内容）
///
/// 供 CLI / LSP 在无语言包目录时物化完整内置包：与磁盘语言包
/// 完全同源（关键字/宏/别名全量），避免硬编码旧表随语言包演进
/// 而残缺（如缺宏表、缺新关键字）导致转译不完整。
公开 函数 内置语言文件(语言代码: &文本) -> 向量<(&'static 文本, &'static 文本)> {
    BUILTIN_FILES
        .迭代器()
        .过滤(|(语言位, _, _)| *语言位 == 语言代码)
        .映射(|(_, 文件位, 内容位)| (*文件位, *内容位))
        .收集()
}

/// 按语言代码取消息表（未知语言回退中文表）；路由由 build.rs 生成
函数 取消息表(代码: &文本) -> &'static 哈希映射<字符串, 字符串> {
    ui_table_for(代码)
}

/// 内置语言包代码列表（从 lang-packs/ 目录自动生成，单一事实源）
///
/// 由 build.rs 扫描目录生成 [`BUILTIN_FILES`] 后在此去重排序；
/// 新增/删除语言包无需修改任何 Rust 代码，重新编译即自动纳入。
/// CLI / LSP 的语言清单（rzc lang、扩展名推断、系统语言检测）均以本函数为源。
公开 函数 内置语言代码() -> 向量<&'static 文本> {
    让 可变 代码列表: 向量<&'static 文本> = BUILTIN_FILES.迭代器().映射(|(语言位, _, _)| *语言位).收集();
    代码列表.不稳定排序();
    代码列表.去重();
    代码列表
}

/// 判断语言代码是否使用西里尔字母文字系统
///
/// 覆盖俄语 (ru)、乌克兰语 (uk)、白俄罗斯语、保加利亚语 (bg)、
/// 塞尔维亚语 (sr)、马其顿语等使用西里尔字母的语言。
/// 供 Unicode 混淆检测判断形似拉丁字母的西里尔字符是否为合法字符。
公开 函数 使用西里尔文字(语言代码: &文本) -> 布尔 {
    模式匹配!(语言代码, "ru" | "uk" | "bg" | "sr" | "mk" | "be")
}

/// 判断语言代码是否有对应的内置语言包
公开 函数 拥有所属语言(代码: &文本) -> 布尔 {
    BUILTIN_FILES.迭代器().任意(|(语言位, _, _)| *语言位 == 代码)
}

/// 内置语言包扩展名列表（来自各语言包 lang_info.toml 的 `"扩展名"` 字段）
///
/// 与 [`内置语言代码`] 同源（代码与扩展名一一对应），
/// 供 CLI / LSP 在缺省时推断方言文件扩展名，避免在各 包 中
/// 手工维护扩展名清单（历史上曾与语言包目录漂移）。
公开 函数 内置语言扩展() -> 向量<字符串> {
    内置语言代码()
        .转迭代()
        .过滤映射(语言包扩展名)
        .收集()
}

/// 解析语言包 lang_info.toml 的扩展名字段
函数 语言包扩展名(语言代码: &文本) -> 选项<字符串> {
    让 内容 = 内置文件(语言代码, "lang_info.toml")?;
    让 解析值: TOML处理::JSON值 = TOML处理::解析字符串(内容).转选项()?;
    解析值
        .截取("语言包")?
        .截取("扩展名")?
        .作为字符串()
        .映射(字符串::从)
}

/// 取指定语言的消息模板；缺失时回退中文表，再缺失回退键名本身
函数 取消息于(代码: &文本, 键: &文本) -> 字符串 {
    如果 代码 != "zh"
        && 让 有值(消息内容) = 取消息表(代码).截取(键)
    {
        返回 消息内容.转字符串();
    }
    ui_table_for("zh")
        .截取(键)
        .映射(|串| 串.转字符串())
        .解包或用否则(|| 键.转字符串())
}

/// 取当前语言的消息模板；缺失时回退中文表，再缺失回退键名本身
公开 函数 查句(键: &文本) -> 字符串 {
    取消息于(&当前语言(), 键)
}

/// 按指定语言取消息模板并替换 `{}` 占位符（纯函数，测试与内部使用）
函数 格式化消息于(代码: &文本, 键: &文本, 参数列表: &[&文本]) -> 字符串 {
    替换占位符(&取消息于(代码, 键), 参数列表)
}

/// 取消息模板并替换 `{}` 占位符（按出现顺序）
公开 函数 查译(键: &文本, 参数列表: &[&文本]) -> 字符串 {
    格式化消息于(&当前语言(), 键, 参数列表)
}

/// 按出现顺序把 `{}` 替换为参数；参数多于占位符时忽略多余参数，
/// 参数不足时保留未替换的 `{}`（模板兜底，避免 崩溃）。
函数 替换占位符(模板: &文本, 参数列表: &[&文本]) -> 字符串 {
    让 可变 结果串 = 字符串::带容量(模板.长度());
    让 可变 剩余 = 模板;
    对于 参数 在 参数列表 {
        匹配 剩余.查找("{}") {
            有值(起始位) => {
                结果串.推入字符串(&剩余[..起始位]);
                结果串.推入字符串(参数);
                剩余 = &剩余[起始位 + 2..];
            }
            无 => {
                // 占位符已耗尽：剩余模板原样保留
                结果串.推入字符串(剩余);
                返回 结果串;
            }
        }
    }
    结果串.推入字符串(剩余);
    结果串
}

#[配置(测试)]
模块 单元测试 {
    使用 超级::*;

    #[测试]
    函数 默认语言为中文() {
        让 _守卫 = 测试语言("zh");
        断言相等!(当前语言(), "zh");
        断言相等!(取消息于("zh", "err_line_col"), "第 {} 行第 {} 列");
        断言相等!(取消息于("zh", "cli_about"), "多语言 Rust 教学方言编译器");
    }

    #[测试]
    函数 设置语言为德语() {
        让 _守卫 = 测试语言("de");
        断言相等!(当前语言(), "de");
        // 纯函数按语言取模板，不受全局状态干扰
        断言相等!(取消息于("de", "err_line_col"), "Zeile {}, Spalte {}");
        断言相等!(格式化消息于("de", "err_line_col", &["1", "2"]), "Zeile 1, Spalte 2");
    }

    #[测试]
    函数 语言守卫恢复先前值() {
        让 _守卫 = 测试语言("zh");
        {
            让 _语言 = 附带语言("ru");
            断言相等!(当前语言(), "ru");
            // 嵌套守卫逐层恢复
            让 _内层 = 附带语言("de");
            断言相等!(当前语言(), "de");
        }
        断言相等!(当前语言(), "zh");
    }

    #[测试]
    函数 回退链路() {
        让 _守卫 = 测试语言("de");
        // unicode_name_* 已同步到全部语言包（英文 Unicode 标准名），直接命中德语表
        断言相等!(
            取消息于("de", "unicode_name_200B"),
            "\u{200b} (Zero Width Space)"
        );
        // 完全缺失的键回退键名
        断言相等!(取消息于("de", "no_such_key"), "no_such_key");
    }

    #[测试]
    函数 所有语言含公共键() {
        // 语言集合来自 lang-packs 目录（单一事实源），随语言包增删自动适应
        让 代码 = 内置语言代码();
        断言!(代码.长度() >= 10, "内置语言包数量异常: {}", 代码.长度());
        对于 语言 在 代码 {
            让 表 = 取消息表(语言);
            对于 键 在 ["err_line_col", "diag_kind_error", "mapping_cat_keywords"] {
                断言!(表.包含键(键), "{语言} 缺少 {键}");
            }
        }
    }

    #[测试]
    函数 内置语言单一事实源() {
        // 代码列表与扩展名一一对应，且每语言都有 lang_info.toml 元数据
        让 代码 = 内置语言代码();
        让 扩展名 = 内置语言扩展();
        断言相等!(代码.长度(), 扩展名.长度());
        对于 语言 在 &代码 {
            断言!(拥有所属语言(语言), "{语言} 应被识别为内置语言");
        }
        // 扩展名去重（任一语言有且仅有一个扩展名）
        让 可变 已排序 = 扩展名.克隆值();
        已排序.排序();
        已排序.去重();
        断言相等!(已排序.长度(), 扩展名.长度());
    }

    #[测试]
    函数 按序替换占位符() {
        断言相等!(替换占位符("已导出到 {}", &["a.rs"]), "已导出到 a.rs");
        断言相等!(
            替换占位符("项目根: {}，错误: {}", &["/p", "boom"]),
            "项目根: /p，错误: boom"
        );
        断言相等!(替换占位符("只有 {}", &["a", "b"]), "只有 a");
        断言相等!(替换占位符("{} 和 {}", &["a"]), "a 和 {}");
    }
}
