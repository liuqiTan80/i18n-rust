//! 转译产物坐标 → 母语源码坐标的列映射
//!
//! 转译是逐令牌的原地替换，不增删换行，因此**行号恒等**；但中英文令牌
//! 长度不同（「让」换出的英文写法是三个字母，「可变」也是三个字母），同一行
//! 内的列号会发生偏移，必须回放替换过程才能还原到母语源码的列。
//!
//! 本模块供命令行使用。**不可与 LSP 侧的列映射混用**：LSP 协议要求 UTF-16
//! 代码单元列（`lsp/src/translation_cache.rs`），而命令行输出面向终端，
//! 采用**字符数**列——与 rustc 的 JSON 诊断里报告起始列的那个字段口径一致。
//! 算法同源，但列口径不同，混用会在非基本多文种平面字符（表情符号等）上产生偏移。
//!
//! 设计（中文原生重构，非英文版的逐句对译）：
//! - **行首分段点不再入库**。英文版每行都要塞一个 `(0, 0)` 哨兵，构建函数的
//!   初始化、跨行时的新建行、回译坐标的循环初值三处重复同一个字面量；
//!   改成"每行只存真正发生长度变化的点"，行首零点由 `回译坐标` 侧的常量给出。
//!   附带收益：`列位点` 不再需要「可复制」「可克隆」「部分相等」「全等」四个
//!   派生特征——原版派生是为了 `point = *p` 这种写法，重构后全程持引用。
//! - **直出判定不用谓词宏**。词形「匹配」是一词多译（分支匹配关键字与
//!   布尔谓词宏各占一支），而语言包没有谓词宏的唯一中文词形；这里改用文本自身
//!   的判据（注释前缀 + 全白，见 `是否直出`），既不碰「匹配」，也不引入「令牌
//!   种类」的变体路径。
//! - **偏移索引改为升序游标归并**。英文版先把编辑表倒进 `哈希映射` 再逐令牌查，
//!   而管线保证「编辑表按母语源偏移升序」（转译产物里那条全管线映射表），
//!   令牌起点又单调递增，因此一个只前进的游标就够了：省掉一次哈希建表与
//!   全部堆分配。代价是把那条**顺序不变量从隐含变成正确性依赖**（见台账）。

使用 包::缓存::源码映射条目;

/// 行内列映射分段点：一次长度变化的替换发生后记录的 (产物列, 母语列)
///
/// 两个分段点之间产物与母语同步增长（未替换文本原样输出），
/// 故段内可直接用 `产物列位 - 母语列位` 的恒定差值换算。
公开 结构体 列位点 {
    /// 转译产物的行内列（从零起算，字符数）
    公开 产物列位: 无符号整数,
    /// 母语源码的行内列（从零起算，字符数）
    公开 母语列位: 无符号整数,
}

/// 行首（零偏移）分段点：查询侧的起点，不参与建表
常量 行首点: 列位点 = 列位点 { 产物列位: 0, 母语列位: 0 };

/// 逐行列映射表：回放转译过程得到，供诊断列号回译使用
公开 结构体 列位映射表 {
    /// `全部行[i]` 为第 i 行（从零起算）的分段点，按 `产物列位` 升序；
    /// 行首零点不入库（由 `行首点` 常量表达）
    全部行: 向量<向量<列位点>>,
}

/// 空白与注释是否不经替换直出：产物与母语在这段文本上逐字符等长
///
/// 判据取自文本本身而非令牌种类枚举：谓词宏与「令牌种类」变体路径
/// 都没有唯一中文词形。分词器产出的令牌里，仅空白段会裁剪为空，
/// 仅注释段会以 `//`、`/*` 开头，故三个前缀/空白判定与原来的三个变体一一对应。
函数 是否直出(片段: &文本) -> 布尔 {
    片段.以开头("//") || 片段.以开头("/*") || 片段.裁剪().是否为空()
}

实现 列位映射表 {
    /// 回放转译过程，构建逐行的列映射
    ///
    /// `母语源` 为母语源码，`管线编辑` 为转译管线的全量编辑表
    /// （转译产物的全管线映射表，**必须按 `源偏移` 升序**——
    /// 游标归并把这条顺序当成前提）。未命中编辑表的令牌视为原样输出。
    公开 函数 回放生成(母语源: &文本, 管线编辑: &[源码映射条目]) -> 自身 {
        让 可变 全部行: 向量<向量<列位点>> = 向量::新建();
        让 可变 当前行: 向量<列位点> = 向量::新建();
        让 可变 母语列: 无符号整数 = 0;
        让 可变 产物列: 无符号整数 = 0;
        让 可变 偏移: 无符号机器整数 = 0;
        让 可变 游标: 无符号机器整数 = 0;

        对于 词元 在 词法解析器::切分令牌(母语源) {
            让 起点 = 偏移;
            让 片段 = &母语源[起点..][..词元.长度];
            偏移 += 词元.长度;

            // 空白与注释原样输出，但可能跨行（块注释、连续换行）：按换行切段，
            // 段与段之间收尾上一行、把行内列归零
            如果 是否直出(片段) {
                让 可变 非首段 = 假;
                对于 段 在 片段.分割('\n') {
                    如果 非首段 {
                        全部行.推入(当前行);
                        当前行 = 向量::新建();
                        母语列 = 0;
                        产物列 = 0;
                    }
                    非首段 = 真;
                    让 段宽 = 段.逐字符().计数() 作为 无符号整数;
                    母语列 += 段宽;
                    产物列 += 段宽;
                }
                继续;
            }

            // 游标只前进：跳过起点已落在本令牌之前的编辑条目
            当 游标 < 管线编辑.长度() && 管线编辑[游标].源偏移 < 起点 {
                游标 += 1;
            }
            让 母语宽 = 片段.逐字符().计数() 作为 无符号整数;
            让 产物宽 = 如果 游标 < 管线编辑.长度()
                && 管线编辑[游标].源偏移 == 起点
            {
                管线编辑[游标].替换文字.逐字符().计数() 作为 无符号整数
            } 否则 {
                母语宽
            };

            母语列 += 母语宽;
            产物列 += 产物宽;

            // 仅长度变化时记录分段点：长度未变则该令牌前后列关系不变
            如果 产物宽 != 母语宽 {
                当前行.推入(列位点 { 产物列位: 产物列, 母语列位: 母语列 });
            }
        }

        全部行.推入(当前行);
        自身 { 全部行 }
    }

    /// 把转译产物坐标（行、列均从一起算）映射回母语源码坐标
    ///
    /// 转译不增删换行，行号恒等返回。
    /// 落在替换区间内的位置按差值近似到最近的中文令牌起点——
    /// 这与 LSP 侧一致，诊断只需指向正确的令牌，无需精确到字符内部。
    ///
    /// 行号越界（映射表行数不足）时原样返回，不臆造坐标。
    公开 函数 回译坐标(&自我, 行号: 无符号整数, 列位: 无符号整数) -> (无符号整数, 无符号整数) {
        让 有值(行点们) = 自我.全部行.获取(行号.饱和减(1) 作为 无符号机器整数) 否则 {
            返回 (行号, 列位);
        };
        让 目标 = 列位.饱和减(1);
        // 分段点按产物列位升序，因此「产物列位 <= 目标」的点恰好构成一个前缀：
        // 前缀长度减一即所求；一个都不满足时退回行首零点
        让 前缀长 = 行点们
            .迭代()
            .过滤(|候选| 候选.产物列位 <= 目标)
            .计数();
        让 点 = 如果 前缀长 > 0 { &行点们[前缀长 - 1] } 否则 { &行首点 };
        让 差值 = 点.产物列位 作为 整数 - 点.母语列位 作为 整数;
        (行号, (目标 作为 整数 - 差值).最大(0) 作为 无符号整数 + 1)
    }

    /// 映射表覆盖的行数（供测试与诊断用）
    公开 函数 覆盖行数(&自我) -> 无符号机器整数 {
        自我.全部行.长度()
    }
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    /// 产物 `    let mut 数量 = 10;`，母语 `    让 可变 数量 = 10;`
    ///
    /// 字节偏移：4 个前导空格后「让」占 3 字节（偏移 4），
    /// 再 1 空格后「可变」占 6 字节（偏移 8）。
    函数 示例<'甲>() -> (&'甲 文本, 向量<源码映射条目>) {
        让 编辑 = 向量宏![
            源码映射条目::新建(4, 3, "让", "let"),
            源码映射条目::新建(8, 6, "可变", "mut"),
        ];
        ("    让 可变 数量 = 10;", 编辑)
    }

    #[测试]
    函数 关键字处列位回译() {
        让 (源, 编辑) = 示例();
        让 映射表 = 列位映射表::回放生成(源, &编辑);
        // 产物列 5（从一起算）= 英文「让」写法的首字符 → 母语列 5 = 「让」
        断言相等!(映射表.回译坐标(1, 5), (1, 5));
        // 产物列 9 = 英文「可变」写法的首字符 → 母语列 7 = 「可」
        断言相等!(映射表.回译坐标(1, 9), (1, 7));
        // 产物列 13 = 「数」 → 母语列 10 = 「数」（未被替换，但受前面两个替换影响）
        断言相等!(映射表.回译坐标(1, 13), (1, 10));
        // 产物列 16 = `=` → 母语列 13 = `=`
        断言相等!(映射表.回译坐标(1, 16), (1, 13));
    }

    /// 前导空格未被替换，列号应恒等
    #[测试]
    函数 首个替换之前的列位恒等() {
        让 (源, 编辑) = 示例();
        让 映射表 = 列位映射表::回放生成(源, &编辑);
        断言相等!(映射表.回译坐标(1, 1), (1, 1));
        断言相等!(映射表.回译坐标(1, 4), (1, 4));
    }

    /// 空编辑表 → 恒等映射（转译未改动任何令牌时不应漂移）
    #[测试]
    函数 无编辑时全列恒等() {
        让 映射表 = 列位映射表::回放生成("    让 数量 = 1;", &[]);
        对于 列号 在 1..=15 {
            断言相等!(映射表.回译坐标(1, 列号 作为 无符号整数), (1, 列号 作为 无符号整数));
        }
    }

    /// 多行：行号恒等，且每行的列差独立累积（不跨行污染）
    #[测试]
    函数 多行各自独立() {
        // 字节偏移：第 1 行「让 x = 1;」占 0..9（「让」3 字节 + 7 个 ASCII），
        // `\n` 在偏移 10，故第 2 行「让」在 11、「可变」在 15
        让 编辑 = 向量宏![
            源码映射条目::新建(0, 3, "让", "let"),
            源码映射条目::新建(11, 3, "让", "let"),
            源码映射条目::新建(15, 6, "可变", "mut"),
        ];
        让 映射表 = 列位映射表::回放生成("让 x = 1;\n让 可变 y = 2;", &编辑);
        断言相等!(映射表.覆盖行数(), 2);

        // 第 1 行：`let x = 1;` 列 5 = `x` → 母语列 3 = `x`
        断言相等!(映射表.回译坐标(1, 5), (1, 3));
        // 第 2 行：`let mut y = 2;` 列 9 = `y` → 母语列 6 = `y`
        断言相等!(映射表.回译坐标(2, 9), (2, 6));
    }

    /// 行号越界时原样返回，不臆造坐标
    #[测试]
    函数 行号越界原样透传() {
        让 (源, 编辑) = 示例();
        让 映射表 = 列位映射表::回放生成(源, &编辑);
        断言相等!(映射表.回译坐标(99, 7), (99, 7));
    }

    /// 列号为 0（防御：上游给出非法坐标）不应下溢恐慌
    #[测试]
    函数 列位为零不下溢() {
        让 (源, 编辑) = 示例();
        让 映射表 = 列位映射表::回放生成(源, &编辑);
        断言相等!(映射表.回译坐标(1, 0), (1, 1));
    }

    /// 跨行注释：换行后的行内列必须从零重算（重构改走按换行切段的路径）
    ///
    /// 英文版逐字符推进这段列号，却没有一条测试覆盖"注释跨行"；
    /// 这里把行边界当成显式契约钉住。
    #[测试]
    函数 块注释跨行后列位归零() {
        // 字节布局：`/* 说明 */` 占 0..12（斜杠 2 + 空格 1 +「说明」6 + 空格 1 + 星斜 2），
        // `\n` 在偏移 12，故第 2 行的「让」在偏移 13
        让 编辑 = 向量宏![源码映射条目::新建(13, 3, "让", "let")];
        让 映射表 = 列位映射表::回放生成("/* 说明 */\n让 x = 1;", &编辑);
        断言相等!(映射表.覆盖行数(), 2);
        // 产物第 2 行 `let x = 1;` 列 5 = `x` → 母语列 3
        断言相等!(映射表.回译坐标(2, 5), (2, 3));
    }

    /// 同一偏移上的多条编辑：取第一条（游标语义，固定下来防行为漂移）
    ///
    /// 英文版的 `哈希映射` 倒表会让**后写覆盖前写**，与这里的取首条不同；
    /// 管线本不该在同偏移放两条编辑，此测试只为把可预期行为钉死。
    #[测试]
    函数 同偏移多条编辑取第一条() {
        让 编辑 = 向量宏![
            源码映射条目::新建(0, 3, "让", "let"),
            源码映射条目::新建(0, 3, "让", "lethan"),
        ];
        让 映射表 = 列位映射表::回放生成("让 x = 1;", &编辑);
        // 取首条即按三字母的英文写法推进：产物列 5 回译到母语列 3
        // （若按哈希映射的后写覆盖取那条六字母的替换文字，产物列推进 6，列 5 落在点前 → 恒等返回 (1, 5)）
        断言相等!(映射表.回译坐标(1, 5), (1, 3));
    }

    /// 等长替换不产生分段点：列关系在该令牌前后不变
    #[测试]
    函数 等长替换不留分段点() {
        // 「让」占一个字符：换成三字母的英文写法会留点，换成单字母的写法则等长
        让 编辑 = 向量宏![源码映射条目::新建(0, 3, "让", "y")];
        让 映射表 = 列位映射表::回放生成("让 x = 1;", &编辑);
        断言相等!(映射表.全部行[0].长度(), 0);
        断言相等!(映射表.回译坐标(1, 5), (1, 5));
    }
}
