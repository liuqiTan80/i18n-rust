//! 母语编程指南渲染（`rzc cheat` / `rzc guide` / `rzc init --ai` 共用）
//!
//! 把「词条表渲染」从命令行下沉到引擎后，`rzc guide` 与 `rzc init --ai` 复用同一
//! 数据源与表格版式：语言包词条一旦更新，三条出口同步生效，不会出现
//! 指南与 `rzc cheat` 输出漂移。
//!
//! 文本模板取自各语言包 `ui.toml` 的 `["界面消息"]` 节（`guide_*` 键），
//! 调用方须先 [`crate::语言::设定语言`]，与错误/诊断输出同一约定。
//! 词条表本体（分类/表头/危险等级标签/内容）与 `rzc cheat` 一致——
//! 附录A、项目说明文档均以该版式为基准。
//!
//! 本模块的两条纪律（都是重构后才立得住的）：
//!
//! - **版式只有一处实现**：markdown 表体由 [`渲染分类表`] 独任，`rzc cheat --markdown`
//!   与 `rzc guide` 都调它，差别只在标题的井号数。此前两处各写
//!   一遍同样的表头与行格式，靠注释口头承诺「版式完全一致」——一个以「避免
//!   漂移」为由下沉到引擎的模块，自己留着两处会漂移的副本。
//! - **行序稳定可复现**：每个分类内按母语词形的码位序排列。原实现沿用
//!   `哈希映射` 迭代序，实测 `rzc cheat zh` 两次运行相差 2900+ 行（排序后
//!   才零差异），于是 `rzc init --ai` / `rzc relocalize` 写出的 AGENTS.md
//!   每次都全表重排，给读者仓库制造无谓的 `git diff`。现改用
//!   [`std::collections::BTreeMap`] 归集，键序即输出序，无需再排序。

使用 包::映射管理器::映射管理器;
使用 标准库::集合::{哈希映射, 有序映射};

/// 词条表分类标题（双语固定，与历史 `rzc cheat` 输出一致）
常量 标题关键字: &文本 = "Keywords / 关键字";
常量 标题模块路径: &文本 = "Module paths / 模块路径";
常量 标题别名: &文本 = "Aliases / 别名";
常量 标题派生: &文本 = "Derives / 派生特征";

/// 词条表的一行：一条母语词条、它的英文名、危险等级标签与备注
///
/// 原先是四元组 `(String, String, String, String)`，调用点靠位置取值
/// （`(native, en, level, note)`），顺序写错编译器无法发现。
结构体 词条行 {
    母语: 字符串,
    英文名: 字符串,
    危险标签: 字符串,
    备注: 字符串,
}

/// 词条表的一个分类：标题与该标题下的全部行（行序已稳定）
结构体 词条分类<'a> {
    标题: &'a 文本,
    词条们: 向量<词条行>,
}

/// 取全量词条表：过滤恒等条目（母语 == 英文）后按分类返回行
///
/// 分类顺序固定为「关键字 → 模块路径 → 别名 → 派生特征」；同一分类内的行
/// 按母语词形的码位序排列（靠有序映射归集，见模块头说明）。
函数 词条分类表(管理器: &映射管理器) -> 向量<词条分类<'_>> {
    让 四张表: [(&文本, &哈希映射<字符串, 字符串>); 4] = [
        (标题关键字, 管理器.取关键词表()),
        (标题模块路径, 管理器.取模块路径表()),
        (标题别名, 管理器.取别名表()),
        (标题派生, 管理器.取派生特征表()),
    ];
    四张表
        .消费迭代()
        .变换(|(标题, 表)| {
            // 键是母语词形：迭代即码位序，同时天然去掉同偏移的重复项
            让 可变 归集: 有序映射<字符串, 词条行> = 有序映射::新建();
            对于 (母语, 英文) 在 表.迭代() {
                如果 母语 == 英文 {
                    继续;
                }
                让 危险 = 管理器.取危险详情(母语);
                归集.插入(
                    母语.克隆值(),
                    词条行 {
                        母语: 母语.克隆值(),
                        英文名: 英文.克隆值(),
                        危险标签: 危险.等级.标签().转字符串(),
                        备注: 危险.备注,
                    },
                );
            }
            // 有序映射的取全部值按键升序交出所有权，消费掉映射即可，不必再排序
            词条分类 { 标题, 词条们: 归集.取全部值().收集() }
        })
        .收集()
}

/// markdown 表格单元转义：竖线与换行会破坏表格结构
函数 转义单元(内容: &文本) -> 字符串 {
    内容.替换('|', "\\|").替换(['\n', '\r'], " ")
}

/// 危险等级图例（markdown 版式，逐字节对齐原 `rzc cheat --markdown` 输出）
函数 危险等级图例() -> 字符串 {
    让 可变 出 = 字符串::新建();
    出.推入字符串("> **危险等级图例**：\n");
    出.推入字符串(
        "> - `纯安全`：只在受保护位置（声明位/方法调用位/use 路径段）替换，不改写自定义标识符；\n",
    );
    出.推入字符串("> - `会改写标识符`：词法层任意位置替换，同名自定义标识符也会被改写；\n");
    出.推入字符串(
        "> - `会 panic`：运行时可能 panic，默认请选安全同义条目，仅调用处显式选择时使用；\n",
    );
    出.推入字符串("> - 同一词条同时涉及多种风险时以 `+` 连接，并在「备注」列说明。\n\n");
    出
}

/// 渲染单个分类的 markdown 表：标题行 + 表头 + 行集合 + 表后空行
///
/// `井号` 决定标题层级——`rzc cheat --markdown` 用 `##`（表格直接贴一级
/// 标题之下），[`渲染母语指南`] 用 `###`（表格挂在「词条表」小节之下）。
/// 两个出口共用本函数，表头与行格式因此不可能各写一遍再漂移。
/// 空分类返回空串，调用方无需跳过。
函数 渲染分类表(分类: &词条分类<'_>, 语言码: &文本, 井号: &文本) -> 字符串 {
    如果 分类.词条们.是否为空() {
        返回 字符串::新建();
    }
    让 可变 出 = 字符串::新建();
    出.推入字符串(&格式化!("{井号} {}\n\n", 分类.标题));
    出.推入字符串(&格式化!("| {语言码} | Rust | 危险等级 | 备注 |\n|---|---|---|---|\n"));
    对于 项 在 &分类.词条们 {
        出.推入字符串(&格式化!(
            "| {} | `{}` | {} | {} |\n",
            项.母语,
            项.英文名,
            项.危险标签,
            转义单元(&项.备注)
        ));
    }
    出.推入('\n');
    出
}

/// 渲染单个分类的终端版式：母语词形按最宽者左对齐
函数 渲染终端分类(分类: &词条分类<'_>) -> 字符串 {
    如果 分类.词条们.是否为空() {
        返回 字符串::新建();
    }
    让 宽度 = 分类.词条们
        .迭代()
        .变换(|项| 项.母语.逐字符().计数())
        .最大()
        .取值或(0);
    让 可变 出 = 格式化!("── {} ──\n", 分类.标题);
    对于 项 在 &分类.词条们 {
        让 补空 = 宽度 - 项.母语.逐字符().计数();
        让 备注段 = 如果 项.备注.是否为空() {
            字符串::新建()
        } 否则 {
            格式化!("  // {}", 项.备注)
        };
        出.推入字符串(&格式化!(
            "  {}{}  {}  [{}]{}\n",
            项.母语,
            " ".重复(补空),
            项.英文名,
            项.危险标签,
            备注段
        ));
    }
    出.推入('\n');
    出
}

/// 渲染 `rzc cheat` 完整输出（markdown 与终端两种版式）
///
/// 与下沉前的 CLI 实现内容一致（分类/版式/条目相同），同一分类内的行序
/// 由稳定排序取代原来的 `哈希映射` 迭代序；`语言码` 只影响标题与表头列名。
公开 函数 渲染速查表(管理器: &映射管理器, 语言码: &文本, 是否标记: 布尔) -> 字符串 {
    让 分类们 = 词条分类表(管理器);
    让 总条数: 无符号机器整数 = 分类们.迭代().变换(|分| 分.词条们.长度()).求和();
    让 可变 出 = 字符串::新建();
    如果 总条数 == 0 {
        // 恒等语言（如英文语言码）：整表映射到自身，没有可速查的内容。下面三行
        // 英文是本模块唯一不进 ui.toml 的文案——它刻意不随界面语言切换：
        // 读者既然在用恒等语言，要的就是「照常写英文 Rust」这句本字。
        出.推入字符串(&格式化!("rzc cheat — {语言码} ↔ Rust\n\n"));
        出.推入字符串("This language pack maps every identifier to itself (identity mapping).\n");
        出.推入字符串("No cheat sheet is needed — write Rust as usual.\n");
        返回 出;
    }
    如果 是否标记 {
        出.推入字符串(&格式化!("# rzc cheat — {语言码} ↔ Rust ({总条数})\n\n"));
        出.推入字符串(&危险等级图例());
        对于 分类 在 &分类们 {
            出.推入字符串(&渲染分类表(分类, 语言码, "##"));
        }
        出.推入字符串(&格式化!("> Generated by `rzc cheat {语言码} --markdown`.\n"));
    } 否则 {
        出.推入字符串(&格式化!("rzc cheat — {语言码} ↔ Rust（共 {总条数} 条）\n\n"));
        出.推入字符串(
            "危险等级：纯安全 = 受保护位置替换｜会改写标识符 = 任意位置替换（同名标识符会被改写）｜会 panic = 运行时可能 panic（仅显式选择）\n\n",
        );
        对于 分类 在 &分类们 {
            出.推入字符串(&渲染终端分类(分类));
        }
    }
    出
}

/// 渲染 markdown 词条表本体（危险等级图例 + 全部分类表，不含标题行）
///
/// 供 [`渲染母语指南`] 组装：指南自身有一级标题，此处只出图例与表格，
/// 版式与 `rzc cheat --markdown` 完全一致（同一函数，只差井号数）。
公开 函数 渲染词条表(管理器: &映射管理器, 语言码: &文本) -> 字符串 {
    渲染分类表本体(&词条分类表(管理器), 语言码)
}

/// 指南正文里的词条表：图例 + 各分类（`###` 层级）
///
/// [`渲染词条表`] 与 [`渲染母语指南`] 共用的本体；指南已经取过一次表，
/// 故本函数直接吃分类集合，不再重复加载。
函数 渲染分类表本体(分类们: &[词条分类<'_>], 语言码: &文本) -> 字符串 {
    让 可变 出 = 危险等级图例();
    对于 分类 在 分类们 {
        出.推入字符串(&渲染分类表(分类, 语言码, "###"));
    }
    出
}

/// 渲染面向学习者与人工智能助手的母语编程指南（markdown）
///
/// 结构：标题 → 引言语 → 书写规则（标识符/保留字转义/标点/危险等级/工作流/实测坑/待译清单）
/// → 入口示例（语言包 `template_main`）→ 全量词条表 → 尾注。
/// 全部文案来自 `ui.toml` 的 `guide_*` 键，随 `设定语言` 切换。
公开 函数 渲染母语指南(管理器: &映射管理器, 语言码: &文本) -> 字符串 {
    使用 包::语言::{t 作为 消息, f 作为 带参消息};
    让 分类们 = 词条分类表(管理器);
    让 总条数: 无符号机器整数 = 分类们.迭代().变换(|分| 分.词条们.长度()).求和();
    让 可变 出 = 字符串::新建();
    出.推入字符串(&格式化!("{}\n\n", 带参消息("guide_title", &[语言码])));
    出.推入字符串(&格式化!("{}\n\n", 带参消息("guide_intro", &[语言码])));
    出.推入字符串(&格式化!("{}\n", 消息("guide_rules_head")));
    // 不带占位符的规则条目按此顺序成组输出；工作流那条带参，单独走
    对于 键 在 [
        "guide_rule_keywords",
        "guide_rule_ident",
        "guide_rule_raw_ident",
        "guide_rule_punct",
        "guide_rule_danger",
    ] {
        出.推入字符串(&格式化!("{}\n", 消息(键)));
    }
    // 工作流规则含 `{}` 占位（入口文件扩展名 = 语言码），须带参渲染
    出.推入字符串(&格式化!("{}\n", 带参消息("guide_rule_workflow", &[语言码])));
    // 实测坑（三引号多行字符串 / 取父路径返回借用）：来自真实项目踩坑，
    // 写进指南让人工智能助手少绕弯路；词条补齐母语支持后可删除本条规则
    出.推入字符串(&格式化!("{}\n", 消息("guide_rule_pitfalls")));
    出.推入字符串(&格式化!("{}\n", 消息("guide_rule_gaps")));
    出.推入('\n');
    出.推入字符串(&格式化!("{}\n\n", 消息("guide_example_head")));
    出.推入字符串("```rust\n");
    出.推入字符串(消息("template_main").裁剪右侧());
    出.推入字符串("\n```\n\n");
    出.推入字符串(&格式化!(
        "{}\n\n",
        带参消息("guide_table_head", &[&总条数.转字符串()])
    ));
    // 词条表本体与 `rzc cheat --markdown` 同一份实现，只差标题井号数
    出.推入字符串(&渲染分类表本体(&分类们, 语言码));
    出.推入字符串(&格式化!("{}\n", 消息("guide_footer")));
    出
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    /// 造一个只含几条已知词条的管理器：测试不依赖真实语言包的内容
    函数 样本管理器() -> 映射管理器 {
        让 可变 关键词: 哈希映射<字符串, 字符串> = 哈希映射::新建();
        关键词.插入("乙词".转字符串(), "beta".转字符串());
        关键词.插入("甲词".转字符串(), "alpha".转字符串());
        关键词.插入("恒等".转字符串(), "恒等".转字符串());
        让 可变 别名: 哈希映射<字符串, 字符串> = 哈希映射::新建();
        别名.插入("取值".转字符串(), "unwrap".转字符串());
        映射管理器::从扁表构造(关键词, 哈希映射::新建(), 别名)
    }

    /// 直接造分类集合，用于只测版式而不经过取表逻辑
    ///
    /// 生命周期写成不约束的 `'甲` 而非「常驻」写法：生命周期位不吃关键字表，
    /// 「静态」在那儿不会被换出（台账 F16），而方言源码区不允许留英文；
    /// 标题取的都是 `&'static 文本` 常量，收缩到任意 `'甲` 由协变自动完成。
    函数 样本分类们<'甲>() -> 向量<词条分类<'甲>> {
        向量![
            词条分类 {
                标题: 标题关键字,
                词条们: 向量![
                    词条行 {
                        母语: "乙词".转字符串(),
                        英文名: "beta".转字符串(),
                        危险标签: "纯安全".转字符串(),
                        备注: "带 | 竖线\n与换行".转字符串(),
                    },
                    词条行 {
                        母语: "甲词".转字符串(),
                        英文名: "alpha".转字符串(),
                        危险标签: "会 panic".转字符串(),
                        备注: 字符串::新建(),
                    },
                ],
            },
            词条分类 {
                标题: 标题别名,
                词条们: 向量::新建(),
            },
        ]
    }

    #[测试]
    函数 行序按母语词形码位稳定() {
        让 管理器 = 样本管理器();
        让 分类们 = 词条分类表(&管理器);
        断言(分类们.长度() == 4, "四张表都该出一个分类");
        让 关键行 = &分类们[0].词条们;
        // 插入序是 乙→甲；`乙`(U+4E59) 码位小于 `甲`(U+7532)，故稳定序把 乙 排前
        断言(关键行.长度() == 2, "恒等词条须被过滤");
        断言(关键行[0].母语 == "乙词" && 关键行[1].母语 == "甲词", "行序须按码位而非插入序");
        断言(关键行[0].英文名 == "beta", "具名字段须与母语同行取对");
    }

    #[测试]
    函数 危险等级随词条来源判定() {
        让 管理器 = 样本管理器();
        让 分类们 = 词条分类表(&管理器);
        // 关键字表词条：词法层无位置保护 → 会改写标识符
        断言(分类们[0].词条们[0].危险标签 == "会改写标识符");
        // 别名表词条映射到「取成功值」：命中一定会恐慌的目标
        断言(分类们[2].词条们[0].危险标签 == "会 panic");
        断言(分类们[1].词条们.是否为空() && 分类们[3].词条们.是否为空());
    }

    #[测试]
    函数 同一输入渲染两次逐字节一致() {
        // 旧实现沿用哈希映射迭代序，这条测试会时好时坏；有序归集后应恒等
        让 标记 = 渲染速查表(&样本管理器(), "zh", 真);
        断言(渲染速查表(&样本管理器(), "zh", 真) == 标记);
        让 终端 = 渲染速查表(&样本管理器(), "zh", 假);
        断言(渲染速查表(&样本管理器(), "zh", 假) == 终端);
    }

    #[测试]
    函数 转义竖线与换行() {
        断言(转义单元("a|b") == "a\\|b");
        断言(转义单元("a\nb\rc") == "a b c");
    }

    #[测试]
    函数 空分类不出版面() {
        让 分类们 = 样本分类们();
        断言(渲染分类表(&分类们[1], "zh", "##").是否为空());
        断言(渲染终端分类(&分类们[1]).是否为空());
    }

    #[测试]
    函数 两个出口的表体只差标题层级() {
        让 分类们 = 样本分类们();
        让 甲 = 渲染分类表(&分类们[0], "zh", "##");
        让 乙 = 渲染分类表(&分类们[0], "zh", "###");
        断言(甲.以开头("## Keywords / 关键字\n\n"));
        断言(乙.以开头("### Keywords / 关键字\n\n"));
        让 去标题 = |首行: &文本| -> 字符串 {
            首行.分割一次('\n').取值或(("", "")).1.转字符串()
        };
        断言(去标题(&甲) == 去标题(&乙), "表头与行格式须逐字节相同");
        断言(甲.包含("| 甲词 | `alpha` | 会 panic |  |\n"));
        断言(甲.包含("| 乙词 | `beta` | 纯安全 | 带 \\| 竖线 与换行 |\n"));
    }

    #[测试]
    函数 终端版式按最宽词形对齐() {
        让 出 = 渲染终端分类(&样本分类们()[0]);
        断言(出.包含("── Keywords / 关键字 ──\n"));
        // 两条词形都是 2 字符 → 补空为 0，英文名紧跟两格空格
        断言(出.包含("  乙词  beta  [纯安全]  // 带 | 竖线\n与换行\n"));
        断言(出.包含("  甲词  alpha  [会 panic]\n"));
        断言(出.以结尾("\n\n") || 出.以结尾("panic]\n\n"), "分类后须留一个空行");
    }

    #[测试]
    函数 恒等语言只出三行提示() {
        让 管理器 = 映射管理器::从扁表构造(
            哈希映射::新建(),
            哈希映射::新建(),
            哈希映射::新建(),
        );
        对于 是否标记 在 [假, 真] {
            让 出 = 渲染速查表(&管理器, "en", 是否标记);
            断言(出.包含("rzc cheat — en ↔ Rust\n\n"));
            断言(出.包含("identity mapping"));
            断言(出.包含("write Rust as usual"));
            断言(!出.包含("危险等级"), "恒等语言不该出图例");
        }
    }

    #[测试]
    函数 图例与表头文案保持原样() {
        让 图例 = 危险等级图例();
        断言(图例.以开头("> **危险等级图例**：\n"));
        断言(图例.以结尾("并在「备注」列说明。\n\n"));
        让 表 = 渲染分类表(&样本分类们()[0], "ja", "##");
        断言(表.包含("| ja | Rust | 危险等级 | 备注 |\n|---|---|---|---|\n"));
    }

    #[测试]
    函数 指南正文按语言包键组装() {
        使用 包::语言::{当前语言, 设定语言};
        // 界面语言是进程级全局态：先存后复原，免得与并行用例互相干扰
        让 原语言 = 当前语言();
        设定语言("zh");
        让 出 = 渲染母语指南(&样本管理器(), "zh");
        设定语言(&原语言);
        断言(出.包含("```rust\n"), "入口示例须带 rust 围栏");
        断言(出.包含("### Keywords / 关键字"), "词条表须以三级标题挂在指南下");
        断言(出.以结尾("\n"), "指南须以换行收尾");
    }
}
