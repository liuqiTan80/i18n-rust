    }

    #[测试]
    函数 测试零宽字符告警不阻断() {
        让 映射管理器 = 建管理器();
        让 可变 缓存表 = 新缓存();
        // 源码含零宽空格（token 之间，Rust 视为空白），翻译应正常完成
        让 源码 = "函数 主函数() {\u{200B} 让 x = 1; }";
        让 翻译结果 = 源码转译(源码, &映射管理器, &可变 缓存表);
        断言!(翻译结果.是否为成功(), "零宽字符不应阻断翻译：{:?}", 翻译结果);
        断言!(翻译结果.解包().包含("fn 主函数()"));
    }

    // ===== 全管线编辑地图（管线映射）测试 =====

    /// 把编辑地图应用到源文本（按 源偏移 拼接 replacement），
    /// 是"地图与真实输出一致"的权威校验——任何阶段改规则却不同步地图都会使此测试失败。
    函数 应用管线地图(源码: &文本, 地图: &[缓存::源映射条目]) -> 字符串 {
        让 可变 拼接结果 = 字符串::新建();
        让 可变 位置 = 0usize;
        对于 编辑 在 地图 {
            拼接结果.推入字符串(&源码[位置..编辑.源偏移]);
            拼接结果.推入字符串(&编辑.替换文本);
            位置 = 编辑.源偏移 + 编辑.字节长度;
        }
        拼接结果.推入字符串(&源码[位置..]);
        拼接结果
    }

    /// 完整管线（词法 + use 路径 + 包:: 前缀 + 别名）下，
    /// 地图回放结果必须与真实输出逐字符一致
