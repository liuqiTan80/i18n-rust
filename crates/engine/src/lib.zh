//! i18n-rust 核心引擎
//! 提供多语言 Rust 方言的词法处理、映射管理、诊断翻译、增量缓存、安全检测等功能

#[路径属性 = "别名.rs"]
公开 模块 别名;
#[路径属性 = "诊断/mod.rs"]
公开 模块 诊断;
#[路径属性 = "导出冲突提示.rs"]
公开 模块 导出冲突提示;
#[路径属性 = "全角标点.rs"]
公开 模块 全角标点;
#[路径属性 = "日志.rs"]
公开 模块 日志;
#[路径属性 = "模块路径.rs"]
公开 模块 模块路径;
#[路径属性 = "产物布局.rs"]
公开 模块 产物布局;
#[路径属性 = "混淆检测.rs"]
公开 模块 混淆检测;
#[路径属性 = "列位映射.rs"]
公开 模块 列位映射;
#[路径属性 = "反译重生.rs"]
公开 模块 反译重生;
#[路径属性 = "名字缓存.rs"]
公开 模块 名字缓存;
#[路径属性 = "工具链.rs"]
公开 模块 工具链;
#[路径属性 = "指南.rs"]
公开 模块 指南;
#[路径属性 = "故障.rs"]
公开 模块 故障;
#[路径属性 = "映射源.rs"]
公开 模块 映射源;
#[路径属性 = "映射管理器.rs"]
公开 模块 映射管理器;
#[路径属性 = "校验.rs"]
公开 模块 校验;
#[路径属性 = "界面消息.rs"]
公开 模块 界面消息;
#[路径属性 = "缓存.rs"]
公开 模块 缓存;
#[路径属性 = "词法器.rs"]
公开 模块 词法器;
#[路径属性 = "语言.rs"]
公开 模块 语言;

使用 标准库::借入::借或拥有;
使用 标准库::集合::哈希集合;
使用 标准库::时间::瞬时;

/// 生产级翻译入口：完整转译管线（词法转译 → 模块路径替换 → 别名替换）
///
/// 流程：
/// 1. 查询增量缓存（内容哈希 + 语境指纹），命中直接复用翻译结果与源映射；
/// 2. 未命中时先执行 Unicode 混淆安全检查（零宽/双向/同形字符），再执行转译；
/// 3. 转译结果写入缓存供后续复用。
///
/// 与命令行工具的管线顺序保持一致；日志级别由 `日志::初始化()` 读取
/// 环境变量（调试/信息/警告/错误）控制。
公开 函数 转译源文本(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
    缓存实例: &可变 缓存::转译缓存,
) -> 结果<字符串, 故障::转译故障> {
    成功(转译源文本并取映射(源文本, 管理器, 缓存实例)?.输出)
}

/// 同 [`转译源文本`]，同时返回源映射（被替换标识符的源偏移与翻译前后文本）
公开 函数 转译源文本并取映射(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
    缓存实例: &可变 缓存::转译缓存,
) -> 结果<缓存::转译输出, 故障::转译故障> {
    带项目转译源文本(源文本, 管理器, 缓存实例, 无)
}

/// 同 [`转译源文本并取映射`]，附项目级声明上下文（跨文件声明豁免）
///
/// 缓存语境指纹并入项目上下文指纹（[`别名::项目上下文::指纹`]）：
/// 项目声明集合变化时相关缓存自动失效，无需语言包版本变化触发。
///
/// 教学告警与缓存状态无关：命中缓存只复用**转译产物**，源码里的魔法数字、全角
/// 标点、Unicode 混淆字符还在原地，每次调用都照旧提示。旧实现把告警挂在转译
/// 闭包里（只有未命中才跑），实测同一份含魔法数字的 `main.zh` 连跑两次
/// `rzc check`：第一次出「[教学提示] 第 5 行第 12 列：魔法数字「5」」，第二次一条
/// 告警都没有——学习者会读成「提示消失＝问题已修」。
公开 函数 带项目转译源文本(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
    缓存实例: &可变 缓存::转译缓存,
    项目: 选项<&别名::项目上下文>,
) -> 结果<缓存::转译输出, 故障::转译故障> {
    带缓存转译实现(源文本, 管理器, 缓存实例, 项目, 真)
}

/// 同 [`带项目转译源文本`]，但不输出教学告警
///
/// 供调用方自行负责告警与文件归属的场景使用（命令行多文件项目按文件名前缀输出，
/// 见 [`输出教学告警`]）：除告警外，产物与缓存行为逐字一致。
公开 函数 静默带项目转译源文本(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
    缓存实例: &可变 缓存::转译缓存,
    项目: 选项<&别名::项目上下文>,
) -> 结果<缓存::转译输出, 故障::转译故障> {
    带缓存转译实现(源文本, 管理器, 缓存实例, 项目, 假)
}

/// 带缓存转译入口的唯一实现：`输出开关` 控制本入口是否输出教学告警
函数 带缓存转译实现(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
    缓存实例: &可变 缓存::转译缓存,
    项目: 选项<&别名::项目上下文>,
    输出开关: 布尔,
) -> 结果<缓存::转译输出, 故障::转译故障> {
    日志::初始化();
    让 开始 = 瞬时::现在();
    包::信息日志!(
        "transpile_engine",
        "{}",
        语言::取带参消息("log_transpile_start", &[&源文本.元素数().转字符串()])
    );

    让 语境指纹 = 缓存::转译缓存::组合指纹(
        管理器.取语境指纹(),
        项目.映射(别名::项目上下文::指纹),
    );

    // 闭包内保持静默：把告警挂在闭包里，等于把它绑死在「缓存未命中」这个条件上
    让 输出产物 = 缓存实例.取或转译(源文本, 语境指纹, || {
        成功(转译管线实现(源文本, 管理器, 无, 项目, 假))
    })?;
    输出教学诊断(源文本, 管理器, 输出开关);

    让 已用 = 格式化!("{:?}", 开始.经过());
    包::信息日志!(
        "transpile_engine",
        "{}",
        语言::取带参消息(
            "log_transpile_done",
            &[
                &源文本.元素数().转字符串(),
                &输出产物.输出.元素数().转字符串(),
                &已用,
            ]
        )
    );
    成功(输出产物)
}

/// 无缓存的完整转译管线：Unicode 混淆检查 → 词法转译 → 模块路径替换 → 别名替换
///
/// 命令行 / 语言服务器等短命进程可直接复用此管线，无需维护增量缓存；
/// Unicode 告警经日志（警告级）输出，不阻断转译。
/// 返回转译结果与源映射（被替换标识符的源偏移与翻译前后文本）。
公开 函数 转译管线(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
) -> 缓存::转译输出 {
    转译管线实现(源文本, 管理器, 无, 无, 真)
}

/// 静默转译管线：不输出教学告警（Unicode 混淆/全角标点/教学提示）
///
/// 供调用方自行负责教学告警输出的场景使用：
/// - “事后重放”（如诊断列映射重建）：此前已对同一源码执行过完整管线
///   （写盘转译）并输出过教学告警，重放只为取 `流程映射`；
/// - 调用方需要带文件归属输出告警（如命令行多文件项目按文件名前缀输出）。
///
/// 除教学告警外，输出与 [`转译管线`] 完全一致。
公开 函数 静默转译管线(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
) -> 缓存::转译输出 {
    转译管线实现(源文本, 管理器, 无, 无, 假)
}

/// 同 [`静默转译管线`]，附项目级声明上下文（跨文件声明豁免）
///
/// 命令行多文件项目中项目内文件与诊断重放的转译入口：项目上下文由调用方
/// 预先收集（见 [`别名::项目上下文::从源集合`]），与入口文件共享。
公开 函数 静默带项目转译管线(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
    项目: 选项<&别名::项目上下文>,
) -> 缓存::转译输出 {
    转译管线实现(源文本, 管理器, 无, 项目, 假)
}

/// 同 [`转译管线`]，附项目级声明上下文（跨文件声明豁免）
///
/// 供无缓存场景的调用方使用；带缓存的入口见 [`带项目转译源文本`]。
公开 函数 带项目转译管线(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
    项目: 选项<&别名::项目上下文>,
) -> 缓存::转译输出 {
    转译管线实现(源文本, 管理器, 无, 项目, 真)
}

/// 同 [`转译管线`]，支持语言服务器虚拟项目的 `crate::` 前缀重写
///
/// `模块名集` 为有值时，在模块路径替换后、别名替换前，为已知模块路径段
/// 添加 `crate::` 前缀（跨文件引用，见 [`模块路径::带映射限定模块路径`]）。
/// 命令行等非虚拟项目场景传无保持原有行为。
///
/// 返回的 `流程映射` 以母语源偏移升序记录全部替换（替换文字为最终输出文本），
/// 是列映射等消费方的唯一规则来源——消费方无需复刻任何转译判定。
公开 函数 带映射转译管线(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
    模块名集: 选项<&哈希集合<字符串>>,
) -> 缓存::转译输出 {
    转译管线实现(源文本, 管理器, 模块名集, 无, 真)
}

/// 同 [`带映射转译管线`]，附项目级声明上下文（语言服务器虚拟项目）
///
/// 语言服务器跨文件场景与命令行同源：项目上下文（模块名与声明名）与 `crate::`
/// 前缀重写共同保证跨文件引用的成员在调用侧与声明侧行为一致。
公开 函数 带映射与项目转译管线(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
    模块名集: 选项<&哈希集合<字符串>>,
    项目: 选项<&别名::项目上下文>,
) -> 缓存::转译输出 {
    转译管线实现(源文本, 管理器, 模块名集, 项目, 真)
}

/// 同 [`带映射与项目转译管线`]，项目上下文由调用方在词法
/// 阶段后补全（单趟：本文件声明不再单独预扫）
///
/// 语言服务器每次按键都要重建项目上下文：本文件内容已变，声明名按内容哈希缓存
/// 必然失效，而 [`带映射与项目转译管线`] 要求先有完整上下文
/// 才能转译——调用方只能先跑一整趟 `别名::收集源声明`
///（内部含完整词法转译）取本文件声明，随后管线里的词法阶段再跑一遍。
///
/// 本入口把词法阶段提到回调之前执行，本文件声明从词法产物顺带收集，回调
/// 只需合并其他文件的缓存声明。输出与「预扫声明 → 建上下文 → 完整管线」
/// 逐字节一致（项目上下文按构造相同），另返回本文件声明与所用上下文，
/// 供调用方缓存与变更判定。
公开 函数 延迟项目转译管线<建项目闭包>(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
    模块名集: 选项<&哈希集合<字符串>>,
    建项目: 建项目闭包,
) -> (
    缓存::转译输出,
    别名::已声明名集合,
    别名::项目上下文,
)
哪里
    建项目闭包: 一次函数(&别名::已声明名集合) -> 别名::项目上下文,
{
    延迟项目实现(源文本, 管理器, 模块名集, 建项目, 真)
}

/// 同 [`延迟项目转译管线`]，但不输出教学告警
///
/// 供调用方自行负责教学告警输出的场景使用（语言服务器把教学提示作为诊断发布，
/// 转译时的日志告警只是重复刷屏）：除告警外输出完全一致。
公开 函数 静默延迟项目转译管线<建项目闭包>(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
    模块名集: 选项<&哈希集合<字符串>>,
    建项目: 建项目闭包,
) -> (
    缓存::转译输出,
    别名::已声明名集合,
    别名::项目上下文,
)
哪里
    建项目闭包: 一次函数(&别名::已声明名集合) -> 别名::项目上下文,
{
    延迟项目实现(源文本, 管理器, 模块名集, 建项目, 假)
}

/// [`延迟项目转译管线`] 的唯一实现
函数 延迟项目实现<建项目闭包>(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
    模块名集: 选项<&哈希集合<字符串>>,
    建项目: 建项目闭包,
    输出教学告警开关: 布尔,
) -> (
    缓存::转译输出,
    别名::已声明名集合,
    别名::项目上下文,
)
哪里
    建项目闭包: 一次函数(&别名::已声明名集合) -> 别名::项目上下文,
{
    输出教学诊断(源文本, 管理器, 输出教学告警开关);
    让 (词法, 输入令牌) = 词法阶段转译(源文本, 管理器);
    // 词法产物要分词一次才收得了声明（建项目上下文的前置）；使用路径阶段
    // 恰好也在这份文本上跑，于是这份令牌流一路交给后续阶段复用。
    // 它不必重新分词：词法阶段自己那份输入令牌流按本阶段编辑表推进就是它
    让 词法令牌流 = 派生词法令牌(&输入令牌, &词法);
    // 词法产物上收集本文件声明：与 `别名::收集源声明` 同源
    // （后者正是「词法转译 + 收集」），仅少一次重复的转译
    让 已声明 = 别名::在文本中收集声明名(&词法.输出, 管理器.取别名表(), &词法令牌流);
    让 项目 = 建项目(&已声明);
    让 输出产物 = 词法后转译(
        源文本,
        管理器,
        模块名集,
        有值(&项目),
        有值(词法复用 {
            已声明: 有值(&已声明),
            令牌们: &词法令牌流,
        }),
        词法,
    );
    (输出产物, 已声明, 项目)
}

/// 同 [`带映射与项目转译管线`]，但不输出教学告警
///
/// 与 [`静默转译管线`] 同口径：除教学告警外输出完全一致。
公开 函数 静默带映射与项目转译管线(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
    模块名集: 选项<&哈希集合<字符串>>,
    项目: 选项<&别名::项目上下文>,
) -> 缓存::转译输出 {
    转译管线实现(源文本, 管理器, 模块名集, 项目, 假)
}

/// 转译管线的唯一实现：`输出教学告警开关` 控制教学告警日志的开关
函数 转译管线实现(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
    模块名集: 选项<&哈希集合<字符串>>,
    项目: 选项<&别名::项目上下文>,
    输出教学告警开关: 布尔,
) -> 缓存::转译输出 {
    输出教学诊断(源文本, 管理器, 输出教学告警开关);
    让 (词法, 输入令牌) = 词法阶段转译(源文本, 管理器);
    // 词法产物的令牌流由词法阶段自己那份派生（见 [`派生词法令牌`]），
    // 交给使用路径与别名两个阶段共用：预计算入口（命令行整棵编译）同样只付
    // 一整趟分词。声明名不在本入口预算（调用方已带项目上下文），传 `无`。
    让 词法令牌流 = 派生词法令牌(&输入令牌, &词法);
    词法后转译(
        源文本,
        管理器,
        模块名集,
        项目,
        有值(词法复用 {
            已声明: 无,
            令牌们: &词法令牌流,
        }),
        词法,
    )
}

/// 教学告警（Unicode 混淆 / 全角标点 / 教学提示）：仅告警不阻断
///
/// `标签` 为有值时每条告警带文件归属前缀（`标签：正文`）：多文件项目里裸
/// 行列定位不到具体文件，按文件输出的调用方（命令行）传自己的显示名；无是管线
/// 内部出口（入口文件语境，裸行列即命令传入的那个文件）。
///
/// 本函数是教学扫描集合的**唯一**事实来源：调用方不要再各自拼一遍扫描器。历史
/// 上命令行侧那份少调了英文回落与保留字撞名两类，入口文件会提示而兄弟文件不会，
/// 同一份代码换条路径就漏报（见 `检查全部教学字符`）。
公开 函数 输出教学告警(
    源文本: &文本, 管理器: &映射管理器::映射管理器, 标签: 选项<&文本>
) {
    // 归属前缀只在有标签时拼一次：无为原样，不额外分配
    让 带归属 = |文本值: 字符串| 如果让 有值(名字) = 标签 {
        格式化!("{名字}：{文本值}")
    } 否则 {
        文本值
    };
    // 词法处理前的 Unicode 混淆安全检查（零宽/双向/同形字符，仅告警）
    对于 告警 在 混淆检测::检查混淆(源文本) {
        包::警告日志!("unicode_confusion", "{}", 带归属(告警.展示行()));
    }
    // 全角标点教学检查（中文输入法常见错误：代码位置的全角标点，仅告警不阻断）；
    // 字符串/注释内的全角标点合法，由扫描器自动跳过
    //
    // 以下四个扫描器共用同一份字符切片：源码只物化一次，避免各扫一遍
    让 字符们: 向量<字符> = 源文本.逐字符().收集();
    对于 告警 在 全角标点::检测全角标点字符(&字符们) {
        包::警告日志!("fullwidth", "{}", 带归属(告警.展示行()));
    }
    // 教学提示（初学者代码风格提示，仅告警不阻断）：未标注类型/魔法数字/嵌套过深/易混方法名。
    // 命令行 `--no-lint` 可关闭（校验::设教学告警启用），
    // 供项目开发（非教学）场景静默刷屏提示
    如果 校验::教学告警已启用() {
        // 一把算全部教学提示：共用同一份字符切片，英文回落（母语词条却写成
        // `函数`/`向量`/`.收集()` 等）与保留字撞名（`函数 匹配` → `fn match`）
        // 在同一次遍历里判定，见 `校验::检查全部教学`；易混词表的分桶索引
        // 由管理器缓存（每语言包一次，不是每文件一次）
        对于 告警 在 校验::检查全部教学字符(
            &字符们,
            校验::词形索引来源::共享(管理器.取校验分桶()),
            管理器.取歧义构造器(),
            管理器.取英文回落(),
            管理器.取关键词表(),
        ) {
            包::警告日志!("lint", "{}", 带归属(告警.生成说明()));
        }
    }
}

/// 管线内部出口：`输出开关` 控制是否输出（不带文件归属）
函数 输出教学诊断(源文本: &文本, 管理器: &映射管理器::映射管理器, 输出开关: 布尔) {
    如果 输出开关 {
        输出教学告警(源文本, 管理器, 无);
    }
}

/// 词法阶段（关键字/宏/派生/让位词映射）
///
/// 另返回本阶段自己分好的输入令牌流（它本来就要分一次）：词法产物的
/// 令牌流可据此派生，管线不必再对输出整份重新分词。
函数 词法阶段转译(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
) -> (词法器::分词结果, 向量<词法解析器::词法令牌>) {
    词法器::分词转译并取令牌(
        源文本,
        管理器.取关键词表(),
        管理器.取宏表(),
        管理器.取派生特征表(),
        管理器.取让位词(),
        管理器.取方法让位词(),
        管理器.取别名表(),
    )
}

/// 词法产物的分词结果（各阶段共用一份令牌流时的载体）
///
/// 分词口径与各阶段自己收集的完全一致（`向量::带容量(长度 / 4 + 8)` + `切分令牌`）。
函数 收集令牌(源文本: &文本) -> 向量<词法解析器::词法令牌> {
    让 可变 令牌们: 向量<词法解析器::词法令牌> =
        向量::带容量(源文本.元素数() / 4 + 8);
    令牌们.扩展(词法解析器::切分令牌(源文本));
    令牌们
}

/// 按某阶段的编辑表把令牌流推进到该阶段输出的坐标
///
/// 编辑都是**整段覆盖若干相邻令牌** 的替换（词法阶段改标识符令牌、使用路径
/// 改 `模块词` 整个令牌、数字后缀黏连时一条编辑跨两个令牌），`令牌类别` 序列
/// 只取决于替换文本。因此「把被覆盖的令牌换成替换值自己的令牌」就得到
/// 该阶段输出的令牌流，不必把整份文件重新分词（359 / 2000 行样例分别
/// 实测 189 / 421 微秒）。替换值本身仍要分词（它可能含 `::`，如 `标准集合` →
/// `std::collections`，也可能含补出来的 `!`，如 `打印行` → `println!`），但每处
/// 只有几个令牌，且替换值原样占据原文置，前后邻接关系不变，所以单独分词与
/// 整份分词的结果同构（该假设由单测、语料差分测试与调试构建下的自检守住）。
///
/// 编辑起点不在令牌边界、终点落进令牌内部、或编辑表没走完时返回 `无`：
/// 调用方退回现场分词，宁慢不错。`源码映射条目` 按匹配位置升序发出，故与
/// 令牌同序遍历一次即可。
函数 重基准令牌(
    基点: &[词法解析器::词法令牌],
    编辑们: &[缓存::源码映射条目],
) -> 选项<向量<词法解析器::词法令牌>> {
    让 可变 输出流: 向量<词法解析器::词法令牌> = 向量::带容量(基点.元素数());
    让 可变 下标 = 0;
    让 可变 偏移 = 0;
    让 可变 下一个编辑 = 0;
    当 下标 < 基点.元素数() {
        让 令牌 = &基点[下标];
        // 编辑起点落在本令牌内部（如数字字面量的后缀被单独改写：`1024整数`
        // 是一个字面量令牌，后缀 `整数` 是其尾部字节）：整段对齐前提已破，
        // 立刻放弃派生，不要跑完全流才发现。
        如果让 有值(编辑条) = 编辑们.获取(下一个编辑)
            && 编辑条.源偏移 < 偏移
        {
            返回 无;
        }
        如果让 有值(编辑条) = 编辑们.获取(下一个编辑)
            && 编辑条.源偏移 == 偏移
        {
            // 同一起点的编辑必然从本令牌起整段覆盖：往后吃满 `长度`
            让 终点 = 偏移 + 编辑条.源码长度;
            让 可变 覆盖下标 = 下标;
            让 可变 游标偏移 = 偏移;
            当 游标偏移 < 终点 {
                让 跨项 = 基点.获取(覆盖下标)?;
                游标偏移 += 跨项.元素数;
                覆盖下标 += 1;
            }
            如果 游标偏移 != 终点 {
                返回 无;
            }
            让 替换文本 = 编辑条.替换文字.文本切片();
            让 起始长度 = 输出流.元素数();
            对于 片段 在 词法解析器::切分令牌(替换文本) {
                输出流.推(词法解析器::词法令牌 {
                    令牌类别: 片段.令牌类别,
                    元素数: 片段.元素数,
                });
            }
            // 空替换（把令牌抹成空白）无从对齐，退回现场分词
            如果 输出流.元素数() == 起始长度 {
                返回 无;
            }
            下一个编辑 += 1;
            下标 = 覆盖下标;
            偏移 = 游标偏移;
        } 否则 {
            输出流.推(词法解析器::词法令牌 {
                令牌类别: 令牌.令牌类别,
                元素数: 令牌.元素数,
            });
            偏移 += 令牌.元素数;
            下标 += 1;
        }
    }
    (下一个编辑 == 编辑们.元素数()).然后有值(输出流)
}

/// 由词法阶段的输入令牌流派生 `词法.输出` 的令牌流
///
/// 派生只在编辑与令牌边界对齐时成立（见 [`重基准令牌`]）；对不齐时退回
/// 现场分词。调试构建下额外把派生结果与整份重新分词逐令牌对比，不一致
/// 即崩——那意味着某个替换值与相邻字符合并成了不同的令牌序列（宁可开发期
/// 吵，也不让错位的偏移表静默流入产物）。
函数 派生词法令牌(
    输入令牌: &[词法解析器::词法令牌],
    词法: &词法器::分词结果,
) -> 向量<词法解析器::词法令牌> {
    让 派生结果 = 重基准令牌(输入令牌, &词法.最终编辑表);
    #[配置(调试自检)]
    如果让 有值(令牌们) = &派生结果 {
        让 现分 = 收集令牌(&词法.输出);
        断言!(
            令牌们
                .迭代()
                .拉链(&现分)
                .全部(|(甲项, 乙项)| 甲项.令牌类别 == 乙项.令牌类别 && 甲项.元素数 == 乙项.元素数)
                && 令牌们.元素数() == 现分.元素数(),
            "词法令牌派生与重新分词不一致：派生 {} 个令牌 / 重分 {} 个令牌",
            令牌们.元素数(),
            现分.元素数()
        );
    }
    派生结果.解包或用否则(|| 收集令牌(&词法.输出))
}

/// 延迟入口与预计算入口在词法产物上已经算好的成果，交给后续阶段复用
///
/// 两者都以 `词法.输出` 为输入：那份分词流（使用路径阶段直接借用，别名阶段
/// 借用由它再派生的一份）与声明名（只有延迟入口会先收集，它必须先把声明
/// 汇总成项目上下文才能继续；预计算入口的上下文由调用方备好，声明名由别名
/// 阶段自己现场收集）。缺哪个就由哪个阶段自己补上。
结构体 词法复用<'甲> {
    已声明: 选项<&'甲 别名::已声明名集合>,
    令牌们: &'甲 [词法解析器::词法令牌],
}

/// 词法之后的管线：使用路径替换 → `crate::` 前缀 → 别名替换 → 编辑表合并
///
/// `复用` 为词法产物上已算好的声明名与令牌流（延迟项目上下文入口必然
/// 先算过）：传入时使用路径阶段与别名阶段都跳过重复的分词/状态机；`无`
/// 时由各阶段自行完成。两条路径输出逐字节一致（见 `tests/alias_declared_
/// reuse.rs` 与 `模块路径` 的差分测试）。
函数 词法后转译(
    源文本: &文本,
    管理器: &映射管理器::映射管理器,
    模块名集: 选项<&哈希集合<字符串>>,
    项目: 选项<&别名::项目上下文>,
    复用: 选项<词法复用<'_>>,
    词法: 词法器::分词结果,
) -> 缓存::转译输出 {
    // 阶段 2：使用语句路径替换
    //
    // 各阶段输出用借或拥有串起来：阶段未启用时直接借用上一阶段输出，不再整份
    // 克隆——早先三个阶段各克隆一次全文（2000 行文件即三次全文拷贝）
    让 词法输出 = 词法.输出;
    // 调用方已分好词时直接借用那份令牌流
    让 复用令牌 = 复用.作为引用方法().映射(|复用项| 复用项.令牌们);
    让 (路径输出, 路径编辑): (借或拥有<'_, 文本>, 向量<缓存::源码映射条目>) = 如果 管理器
        .模块路径表
        .是否为空()
    {
        (借或拥有::借用的(词法输出.作为文本切片()), 向量::新建())
    } 否则 {
        让 替换产物 = 如果让 有值(令牌们) = 复用令牌 {
            模块路径::带令牌替换模块路径(
                &词法输出,
                管理器.取模块路径表(),
                令牌们,
            )
        } 否则 {
            模块路径::带映射替换模块路径(&词法输出, 管理器.取模块路径表())
        };
        (借或拥有::拥有的(替换产物.输出文本), 替换产物.编辑表)
    };
    // 阶段 3（可选）：`crate::` 前缀重写（语言服务器虚拟项目跨文件引用）；
    // 项目项名集合供通配导入场景的遮蔽豁免（无项目上下文时传空集）
    让 (限定输出, 限定编辑): (借或拥有<'_, 文本>, 向量<缓存::源码映射条目>) =
        如果让 有值(名字集) = 模块名集 && !名字集.是否为空() {
            让 空条目集 = 哈希集合::新建();
            让 项目条目名 = 项目.映射(|项目引用| &项目引用.条目集).解包或用(&空条目集);
            让 限定产物 =
                模块路径::带映射限定模块路径(路径输出.作为引用方法(), 名字集, 项目条目名);
            (借或拥有::拥有的(限定产物.输出文本), 限定产物.编辑表)
        } 否则 {
            (借或拥有::借用的(路径输出.作为引用方法()), 向量::新建())
        };
    // 阶段 4 的输入是 `限定输出`：它的令牌流可由词法产物那份派生——使用路径
    // 替换只改标识符令牌的长度，`crate::` 前缀阶段真插入过文本时无从派生
    //（令牌数量变了），退回现场分词。
    让 重基准令牌流;
    让 别名令牌: 选项<&[词法解析器::词法令牌]> = 如果让 有值(基点) = 复用令牌 {
        如果 限定编辑.是否为空() && 路径编辑.是否为空() {
            有值(基点)
        } 否则 如果 限定编辑.是否为空() {
            重基准令牌流 = 重基准令牌(基点, &路径编辑);
            重基准令牌流.作为解引用()
        } 否则 {
            无
        }
    } 否则 {
        无
    };
    // 阶段 4：标识符别名替换（声明位保护 + 项目级声明上下文）；
    // 附模块路径表：使用之外的路径根位模块词（`异步运行时::睡眠`、
    // `#[异步运行时::主函数]`）在别名阶段回退模块路径表完成转译
    让 (别名输出, 别名编辑): (借或拥有<'_, 文本>, 向量<缓存::源码映射条目>) =
        如果 管理器.标识符别名.是否为空() && 管理器.模块路径表.是否为空() {
            (借或拥有::借用的(限定输出.作为引用方法()), 向量::新建())
        } 否则 {
            让 别名产物 = 别名::复用替换别名(
                限定输出.作为引用方法(),
                管理器.取别名表(),
                管理器.取模块路径表(),
                项目,
                复用.作为引用方法().而后映射(|复用项| 复用项.已声明),
                别名令牌,
            );
            (借或拥有::拥有的(别名产物.输出文本), 别名产物.编辑表)
        };

    // 组合各阶段编辑表为母语源坐标的全管线地图（替换文字取最终输出文本）
    // 词法阶段编辑按所有权传入：它们已是母语源坐标，无需夹边界时可原样移动
    让 后续编辑: 向量<&[缓存::源码映射条目]> = 向量![&路径编辑, &限定编辑, &别名编辑];
    让 流程映射 = 组合流程映射(源文本, 词法.最终编辑表, &后续编辑);

    缓存::转译输出::带完整映射(别名输出.转所有权(), 词法.源映射, 流程映射)
}

/// 合并各阶段编辑表为母语源坐标的最终编辑地图
///
/// `词法编辑`（词法阶段）的编辑已直接以母语源偏移记录，且按所有权传入；
/// `后续编辑` 中的各阶段编辑以各自输入文本偏移记录，需经逆映射链换算回母语源
/// 偏移。`原文 / 长度` 一律以母语源文本为准（后续阶段替换的令牌未被
/// 前置阶段改写，长度一致）。
/// 同一源偏移出现多条编辑时保留最后阶段（后写覆盖先写，按阶段顺序稳定排序）。
函数 组合流程映射(
    源文本: &文本,
    词法编辑: 向量<缓存::源码映射条目>,
    后续编辑: &[&[缓存::源码映射条目]],
) -> 向量<缓存::源码映射条目> {
    // 先为后续阶段算好母语源偏移（逆映射要读前面的全部阶段，含词法阶段；
    // 算完后词法编辑才可被移动消费）
    //
    // 换算走 [`逆映射游标`] 而非逐条从头扫描：某阶段的编辑按输入偏移升序，
    // 而逆映射单调（替换区间内一律返回令牌起点），故一条查询的答案不会小于
    // 前一条——游标只前进不回退，整段换算从 O(该阶段编辑数 × 前置阶段编辑数)
    // 降到 O(两者之和)。逐条重扫在大文件上是实测的平方项：2246 行、别名密集
    //（词法 2528 条 + 别名 1683 条）的语料冷转译 37.4 毫秒，同规模只改关键字的
    // 语料 3.26 毫秒；行数翻倍时间 ×3.9。与旧实现逐偏移等价
    //（见 `逆映射游标与朴素一致`）。
    让 可变 后续偏移: 向量<向量<无符号机器整数>> = 向量::带容量(后续编辑.元素数());
    对于 (阶段下标, 编辑们) 在 后续编辑.迭代().枚举() {
        让 可变 偏移们 = 向量::带容量(编辑们.元素数());
        如果 编辑们.是否为空() {
            后续偏移.推(偏移们);
            继续;
        }
        // 换算链：先夹更后的阶段（后写覆盖先写，逆序回溯），最后夹词法阶段
        让 可变 换算链: 向量<逆映射游标<'_>> = 后续编辑[..阶段下标]
            .迭代()
            .逆序()
            .复制()
            .映射(逆映射游标::新建)
            .收集();
        让 可变 词法游标 = 逆映射游标::新建(&词法编辑);
        对于 编辑条 在 编辑们.迭代() {
            让 可变 换算偏移 = 编辑条.源偏移;
            对于 映射游标 在 &可变 换算链 {
                换算偏移 = 映射游标.映射偏移(换算偏移);
            }
            偏移们.推(词法游标.映射偏移(换算偏移));
        }
        后续偏移.推(偏移们);
    }

    让 总数 = 词法编辑.元素数() + 后续编辑.迭代().映射(|编辑们| 编辑们.元素数()).求和::<无符号机器整数>();
    让 可变 合并结果: 向量<缓存::源码映射条目> = 向量::带容量(总数);
    // 词法阶段：坐标已就位，边界无需调整时直接移动条目（每条省下两次文本
    // 拷贝——359 行样例 456 条编辑，这张表是管线里最大的一份）
    对于 编辑条 在 词法编辑 {
        让 终点 = 编辑条.源偏移 + 编辑条.源码长度;
        让 边界无需调整 = 终点 <= 源文本.元素数()
            && 源文本.是字符边界(编辑条.源偏移)
            && 源文本.是字符边界(终点)
            && &源文本[编辑条.源偏移..终点] == 编辑条.原文.文本切片();
        如果 边界无需调整 {
            合并结果.推(编辑条);
            继续;
        }
        让 (起, 终) = 夹取字符边界(源文本, 编辑条.源偏移, 编辑条.源码长度);
        合并结果.推(缓存::源码映射条目::新建(
            编辑条.源偏移,
            编辑条.源码长度,
            &源文本[起..终],
            编辑条.替换文字.文本切片(),
        ));
    }

    对于 (阶段下标, 编辑们) 在 后续编辑.迭代().枚举() {
        对于 (编辑条, &母语偏移) 在 编辑们.迭代().拉链(后续偏移[阶段下标].迭代()) {
            // 原文 / 长度以母语源文本为准。
            // 注意：后续阶段的 `编辑条.源码长度` 处于该阶段输入坐标，未必等于母语源坐标长度；
            // 这里把起止偏移都夹到母语源文本的合法字符边界，避免多字节字符（如日本語の
            // メソッド名 `から`）切片越界引发崩溃。转译输出本身不受影响。
            让 (起, 终) = 夹取字符边界(源文本, 母语偏移, 编辑条.源码长度);
            合并结果.推(缓存::源码映射条目::新建(
                母语偏移,
                编辑条.源码长度,
                &源文本[起..终],
                编辑条.替换文字.文本切片(),
            ));
        }
    }
    // 稳定排序：同偏移多条编辑时，阶段靠后的保持在后（最终消费取后者）
    合并结果.按键排序(|编辑条| 编辑条.源偏移);
    // 同偏移去重：保留最后一条（阶段靠后的替换即为最终输出文本）
    让 可变 去重表: 向量<缓存::源码映射条目> = 向量::带容量(合并结果.元素数());
    对于 编辑条 在 合并结果 {
        如果让 有值(末项) = 去重表.可变末尾()
            && 末项.源偏移 == 编辑条.源偏移
        {
            *末项 = 编辑条;
        } 否则 {
            去重表.推(编辑条);
        }
    }
    去重表
}

/// 把编辑区间夹到母语源文本的合法字符边界
///
/// 返回 `(起, 终)`：`起` 向后推进到字符边界、`终` 向前回退到字符边界
/// （不越过 `起`），两者都不超文本长度。后续阶段的 `长度` 处于该阶段坐标，
/// 未必对齐母语源的字符边界（如日本語のメソッド名 `から`），直接切片会崩溃。
函数 夹取字符边界(
    源文本: &文本, 偏移: 无符号机器整数, 长度值: 无符号机器整数
) -> (无符号机器整数, 无符号机器整数) {
    让 源长 = 源文本.元素数();
    让 可变 起 = 偏移.最小值(源长);
    当 起 < 源长 && !源文本.是字符边界(起) {
        起 += 1;
    }
    让 可变 终 = (偏移 + 长度值).最小值(源长);
    当 终 > 起 && !源文本.是字符边界(终) {
        终 -= 1;
    }
    (起, 终)
}

/// 逆映射：把"上一阶段输出坐标"的偏移映射回"上一阶段输入坐标"
///
/// `编辑们` 按输入偏移升序、互不重叠（每个被替换令牌一条）。
/// 落在替换区间内的偏移返回令牌起点（令牌级边界近似——列映射在
/// 令牌起点记录分段点，区间内位置近似映射到起点即可）。
///
/// **仅供测试参照**：生产路径按升序批量查询，用 [`逆映射游标`] 保住游标，
/// 不必每次从表头重扫（后者是实测的平方项）。保留这份朴素实现就是为了
/// 能对着一模一样的语义做差分（`逆映射游标与朴素一致`）。
#[配置(测试)]
函数 反查映射偏移(编辑们: &[缓存::源码映射条目], 输出偏移: 无符号机器整数) -> 无符号机器整数 {
    让 可变 输入游标 = 0;
    让 可变 输出游标 = 0;
    对于 编辑条 在 编辑们 {
        让 间隔 = 编辑条.源偏移 - 输入游标; // 输入侧未替换区间
        如果 输出偏移 <= 输出游标 + 间隔 {
            返回 输入游标 + (输出偏移 - 输出游标);
        }
        输出游标 += 间隔;
        如果 输出偏移 < 输出游标 + 编辑条.替换文字.元素数() {
            返回 编辑条.源偏移; // 替换区间内：令牌起点近似
        }
        输出游标 += 编辑条.替换文字.元素数();
        输入游标 = 编辑条.源偏移 + 编辑条.源码长度;
    }
    输入游标 + (输出偏移 - 输出游标)
}

/// 逆映射游标：对**非递减**的查询偏移序列，只前进一趟就把全部答案换算完
///
/// 与 [`反查映射偏移`]（逐条从头扫描）逐偏移等价，但省掉重复扫描：整段
/// 查询 O(编辑数 + 查询数) 而不是 O(编辑数 × 查询数）。前提由调用方保证：
/// 各阶段编辑表按输入偏移升序，且映射本身单调（区间内一律返回令牌起点，
/// 不会把后面的查询映到比前面的答案更小的偏移）。调试构建下断言序列确实
/// 非递减——前提破了就是错乱偏移流进产物，宁可在开发期吵。
公开(包) 结构体 逆映射游标<'甲> {
    /// 前置阶段的编辑表（按输入偏移升序、互不重叠）
    编辑们: &'甲 [缓存::源码映射条目],
    /// 下一个尚未跨过的编辑
    下标: 无符号机器整数,
    /// `编辑们[下标]` 起点两侧的偏移：输入侧与输出侧
    输入偏移: 无符号机器整数,
    输出偏移: 无符号机器整数,
    /// 上一次查询的偏移（非递减前提的自检）
    最后查询: 无符号机器整数,
}

实现<'甲> 逆映射游标<'甲> {
    /// 新游标：停在文本起点，尚未消费任何编辑
    公开(包) 函数 新建(编辑们: &'甲 [缓存::源码映射条目]) -> 自身 {
        自身 {
            编辑们,
            下标: 0,
            输入偏移: 0,
            输出偏移: 0,
            最后查询: 0,
        }
    }

    /// 查询一个输出侧偏移对应的输入侧偏移（查询序列必须非递减）
    公开(包) 函数 映射偏移(&可变 自我, 当前偏移: 无符号机器整数) -> 无符号机器整数 {
        断言!(
            当前偏移 >= 自我.最后查询,
            "逆映射游标的查询偏移必须非递减：本次 {当前偏移} < 上次 {}",
            自我.最后查询
        );
        自我.最后查询 = 当前偏移;
        当 自我.下标 < 自我.编辑们.元素数() {
            让 编辑条 = &自我.编辑们[自我.下标];
            // 未替换区间 [输入偏移, 编辑条.源偏移)：输出侧等长、逐字节对应
            让 间隔终点 = 自我.输出偏移 + (编辑条.源偏移 - 自我.输入偏移);
            如果 当前偏移 <= 间隔终点 {
                返回 自我.输入偏移 + (当前偏移 - 自我.输出偏移);
            }
            // 替换区间内：一律映到令牌起点（与旧实现同一近似）；
            // 游标不前进——后续查询可能还落在同一条替换里
            如果 当前偏移 < 间隔终点 + 编辑条.替换文字.元素数() {
                返回 编辑条.源偏移;
            }
            // 整条跨过，游标推进到下一条编辑之前
            自我.输出偏移 = 间隔终点 + 编辑条.替换文字.元素数();
            自我.输入偏移 = 编辑条.源偏移 + 编辑条.源码长度;
            自我.下标 += 1;
        }
        // 表已走完：尾部未替换区间逐字节对应
        自我.输入偏移 + (当前偏移 - 自我.输出偏移)
    }
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    函数 建测试管理器() -> 映射管理器::映射管理器 {
        让 关键字文本 = r#"
["声明"]
"函数" = "fn"
"让" = "let"
"枚举" = "enum"
["类型"]
"整数" = "i32"
["宏"]
"打印行" = "println"
"文件" = "file"
["标准库成员"]
"迭代" = "iter"
"#;
        让 模块路径文本 = r#"
["模块路径"]
"标准集合" = "std::collections"
"#;
        让 标准库文本 = r#"
["模块路径"]
"线程" = "std::thread"
["标识符"]
"字符串" = "String"
"枚举" = "enumerate"
"#;
        让 三方数据 = [(
            "测试库.toml",
            r#"
["模块路径"]
"网络库" = "netlib"
["标识符"]
"服务器" = "Server"
"#,
        )];
        映射管理器::映射管理器::从内置载入(
            关键字文本,
            模块路径文本,
            标准库文本,
            &三方数据,
        )
        .期望("创建测试管理器失败")
    }

    /// `重基准令牌` 派生出的令牌流必须与对阶段输出重新分词的结果逐项相同
    ///
    /// 派生只改被替换令牌的长度（编辑整令牌对齐、替换值是单个标识符）。
    /// 这里用真实模块路径替换产生编辑，再把派生结果与 `切分令牌(输出)` 对拍：
    /// `令牌类别` 与 `元素数` 任一不同都说明同构假设不成立。
    #[测试]
    函数 重基准令牌与现分词一致() {
        让 管理器 = 建测试管理器();
        让 路径映射 = 管理器.取模块路径表();
        对于 源码样例 在 [
            "使用 标准集合::哈希映射;\n",
            "使用 标准集合 :: 哈希映射;\n",
            "使用 线程::生成;\n使用 标准集合::双向队列;\n",
            "使用 网络库 as 网络;\nfn f() { 标准集合::新建(); }\n",
            "// 使用 标准集合::哈希映射;\nfn f() {}\n",
            "fn f() { let x = 1; }\n",
            "",
        ] {
            让 基点 = 收集令牌(源码样例);
            让 阶段产物 = 模块路径::带映射替换模块路径(源码样例, 路径映射);
            让 有值(派生结果) = 重基准令牌(&基点, &阶段产物.编辑表) 否则 {
                恐慌!("{源码样例:?}: 单个标识符替换应能派生令牌流");
            };
            让 现分 = 收集令牌(&阶段产物.输出文本);
            断言相等!(派生结果.元素数(), 现分.元素数(), "{源码样例:?}: 令牌数不一致");
            对于 (下标, (甲项, 乙项)) 在 派生结果.迭代().拉链(&现分).枚举() {
                断言相等!(甲项.令牌类别, 乙项.令牌类别, "{源码样例:?}: 第 {下标} 个令牌的类别");
                断言相等!(甲项.元素数, 乙项.元素数, "{源码样例:?}: 第 {下标} 个令牌的长度");
            }
        }
    }

    /// 替换值含 `::` 时派生会把替换值再分词，得到的仍是同构的令牌流
    #[测试]
    函数 重基准令牌拆分多令牌替换() {
        让 源码样例 = "标准集合::哈希映射;";
        让 基点 = 收集令牌(源码样例);
        让 编辑们 = 向量![缓存::源码映射条目::新建(
            0,
            "标准集合".元素数(),
            "标准集合",
            "std::collections",
        )];
        让 派生结果 = 重基准令牌(&基点, &编辑们).期望("应能派生");
        让 现分 = 收集令牌("std::collections::哈希映射;");
        断言相等!(派生结果.元素数(), 现分.元素数(), "令牌数应与重新分词一致");
        对于 (下标, (甲项, 乙项)) 在 派生结果.迭代().拉链(&现分).枚举() {
            断言相等!(甲项.令牌类别, 乙项.令牌类别, "第 {下标} 个令牌的类别");
            断言相等!(甲项.元素数, 乙项.元素数, "第 {下标} 个令牌的长度");
        }
    }

    /// 编辑未落在令牌边界时派生失败（不能默默错位）
    #[测试]
    函数 重基准令牌拒绝错位编辑() {
        让 源码样例 = "标准集合::哈希映射;";
        让 基点 = 收集令牌(源码样例);
        // 令牌起点：0 / 12 / 13 / 14 / 26；其余偏移都落在某个令牌内部
        对于 偏移值 在 [1, 3, 15, 20, 25] {
            让 编辑们 = 向量![缓存::源码映射条目::新建(偏移值, 1, "x", "y")];
            断言!(
                重基准令牌(&基点, &编辑们).是否为无(),
                "偏移 {偏移值} 不在令牌边界，应拒绝"
            );
        }
    }

    /// 一条编辑跨过多个令牌时同样可派生（被覆盖的令牌整段消失）
    ///
    /// 词法阶段的数字后缀黏连（`1024整数`）就是这么一条编辑；这里用
    /// `标准集合::` → `std::`（标识符 + 两个冒号）固定该形态。
    #[测试]
    函数 重基准令牌跨多令牌编辑() {
        让 源码样例 = "标准集合::哈希映射;";
        让 基点 = 收集令牌(源码样例);
        让 编辑们 = 向量![缓存::源码映射条目::新建(
            0,
            "标准集合::".元素数(),
            "标准集合::",
            "std::",
        )];
        让 派生结果 = 重基准令牌(&基点, &编辑们).期望("跨令牌编辑应能派生");
        让 现分 = 收集令牌("std::哈希映射;");
        断言相等!(派生结果.元素数(), 现分.元素数(), "令牌数应与重新分词一致");
        对于 (下标, (甲项, 乙项)) 在 派生结果.迭代().拉链(&现分).枚举() {
            断言相等!(甲项.令牌类别, 乙项.令牌类别, "第 {下标} 个令牌的类别");
            断言相等!(甲项.元素数, 乙项.元素数, "第 {下标} 个令牌的长度");
        }
    }

    /// 词法产物的令牌流可由「词法阶段输入令牌 + 词法编辑表」派生
    ///
    /// 管线里最贵的一趟重复分词就在这一句上（2000 行样例实测 421 微秒），所以
    /// 同构假设必须直接锁住：逐形态比 `派生词法令牌` 与 `切分令牌(输出)`。
    /// 形态涵盖宏补 `!`、`!` 邻接、数字后缀黏连、生命周期、字面量、跨行注释、
    /// 使用路径与表达式里的模块词、空文件。
    #[测试]
    函数 派生词法令牌与现分词一致() {
        让 管理器 = 建测试管理器();
        对于 源码样例 在 [
            "打印行!(\"x\");\n",
            "打印行(\"x\");\n",
            "如果 标志 != 打印行(1) {}\n",
            "让 a = 文件!(1); 让 b = 文件(2);\n",
            "函数 f<'a>(x: &'a 整数) -> 整数 { *x }\n",
            "让 c = '中'; 让 b = b'x'; 让 s = \"含 打印行 的串\"; 让 r = r#\"原始\"#;\n",
            "/* 块\n注释 */ 让 x = 打印行(1);\n",
            "使用 标准集合::哈希映射;\n让 m = 标准集合::新建();\n",
            "标准集合::哈希映射::新建();\n",
            "函数 主函数() { 让 可变 数量: 整数 = 5; }\n",
            "枚举 E { A, B }\n",
            "让 x = 1..=2; 让 y = -1;\n",
            "让 r#函数 = 1;\n",
            "// 只有注释\n",
            "",
        ] {
            让 (词法, 输入令牌) = 词法阶段转译(源码样例, &管理器);
            // 派生必须真的成立（否则本测试只是「退回现场分词」的同义反复）
            断言!(
                重基准令牌(&输入令牌, &词法.最终编辑表).是否为有值(),
                "{源码样例:?}: 未能由输入令牌派生"
            );
            让 派生结果 = 派生词法令牌(&输入令牌, &词法);
            让 现分 = 收集令牌(&词法.输出);
            断言相等!(派生结果.元素数(), 现分.元素数(), "{源码样例:?}: 令牌数不一致");
            对于 (下标, (甲项, 乙项)) 在 派生结果.迭代().拉链(&现分).枚举() {
                断言相等!(甲项.令牌类别, 乙项.令牌类别, "{源码样例:?}: 第 {下标} 个令牌的类别");
                断言相等!(甲项.元素数, 乙项.元素数, "{源码样例:?}: 第 {下标} 个令牌的长度");
            }
        }
    }

    /// 真中文语言包（而非上面那份小映射表）：替换点越密，派生越容易暴露问题
    函数 建中文管理器() -> 映射管理器::映射管理器 {
        使用 标准库::条目路径::路径类型;

        映射管理器::映射管理器::从目录载入(
            &路径类型::新建(编译环境!("CARGO_MANIFEST_DIR")).连接("lang-packs/zh"),
        )
        .期望("加载 zh 语言包失败")
    }

    /// 后缀与数字黏连时不派生（编辑落在令牌内部），但退回路径仍须同构
    #[测试]
    函数 派生词法令牌部分编辑退回() {
        让 管理器 = 建中文管理器();
        对于 源码样例 在 [
            "让 n = 1024整数;\n",
            "让 n = 1024无符号机器整数;\n",
            "让 x = 3整数;\n",
        ] {
            让 (词法, 输入令牌) = 词法阶段转译(源码样例, &管理器);
            断言!(
                重基准令牌(&输入令牌, &词法.最终编辑表).是否为无(),
                "{源码样例:?}: 编辑落在令牌内部，应拒绝派生"
            );
            让 派生结果 = 派生词法令牌(&输入令牌, &词法);
            让 现分 = 收集令牌(&词法.输出);
            断言相等!(派生结果.元素数(), 现分.元素数(), "{源码样例:?}: 退回路径令牌数");
            对于 (下标, (甲项, 乙项)) 在 派生结果.迭代().拉链(&现分).枚举() {
                断言相等!(甲项.令牌类别, 乙项.令牌类别, "{源码样例:?}: 退回路径第 {下标} 个令牌的类别");
                断言相等!(甲项.元素数, 乙项.元素数, "{源码样例:?}: 退回路径第 {下标} 个令牌的长度");
            }
        }
    }

    /// 真实语料上派生与重新分词同构（中文教程全部代码块）
    ///
    /// 单测的十几份形态只能算抽样；这一条把仓库里的方言语料全部跑一遍：
    /// 任何教程块里出现「派生与重新分词不同构」都会在这里反出来（调试构建
    /// 下的管线自检也会反，但只在真的跑过那条管线时）。派生不成立（退回
    /// 现场分词）不算错，只统计不崩。
    #[测试]
    函数 派生词法令牌教程语料一致() {
        使用 标准库::文件系统;
        使用 标准库::条目路径::路径类型;

        让 语料目录 =
            路径类型::新建(编译环境!("CARGO_MANIFEST_DIR")).连接("../../tutorials");
        // 语料目录缺席分两种，必须区分对待：旧写法不分青红皂白 `返回`，而这一返回
        // 正好在 `已检查 > 400` 的语料下限断言之前（实测把目录指向不存在的名字：
        // 用例 0.00 秒绿色通过，真实跑是 0.12 秒）——也就是说本用例唯一的名值守门人
        // 被它自己绕过了。仓库布局的判据是工作区根清单在不在：在，则教程目录
        // 缺席只能是路径写错或检出不全，必须判红；不在（发布包/独立包）才是真的跳过。
        如果 !语料目录.是否为目录() {
            让 根清单 = 路径类型::新建(编译环境!("CARGO_MANIFEST_DIR")).连接("../../Cargo.toml");
            断言!(
                !根清单.是否为文件(),
                "教程语料目录缺失：{}（工作区布局下它必须存在，否则本用例等于没跑）",
                语料目录.展示()
            );
            返回; // 非仓库布局（如发布包）里没教程目录，不阻断测试
        }
        让 目录项们 = 文件系统::读取目录(&语料目录).期望("教程目录存在但读不了");
        让 管理器 = 建中文管理器();
        让 可变 已检查 = 0;
        让 可变 已拒绝 = 0;
        对于 目录项值 在 目录项们.展平() {
            让 文件路径 = 目录项值.条目路径();
            如果 文件路径.扩展名().而后映射(|扩展值| 扩展值.取字符串引用()) != 有值("md") {
                继续;
            }
            让 成功(文本值) = 文件系统::读取全部字符串(&文件路径) 否则 {
                继续;
            };
            对于 代码块 在 取标记代码块(&文本值) {
                让 (词法, 输入令牌) = 词法阶段转译(&代码块, &管理器);
                已检查 += 1;
                如果 重基准令牌(&输入令牌, &词法.最终编辑表).是否为无() {
                    已拒绝 += 1;
                }
                让 派生结果 = 派生词法令牌(&输入令牌, &词法);
                让 现分 = 收集令牌(&词法.输出);
                断言相等!(
                    派生结果.元素数(),
                    现分.元素数(),
                    "{:?} 的块：令牌数不一致",
                    文件路径.文件名()
                );
                对于 (下标, (甲项, 乙项)) 在 派生结果.迭代().拉链(&现分).枚举() {
                    断言相等!(
                        甲项.令牌类别,
                        乙项.令牌类别,
                        "{:?} 的块：第 {下标} 个令牌的类别",
                        文件路径.文件名()
                    );
                    断言相等!(
                        甲项.元素数,
                        乙项.元素数,
                        "{:?} 的块：第 {下标} 个令牌的长度",
                        文件路径.文件名()
                    );
                }
            }
        }
        断言!(
            已检查 > 400,
            "语料过少（{已检查} 块），检查教程目录/解析是否失效"
        );
        // 后缀黏连等形态只能退回现场分词；占比不应过半，否则本优化失效
        断言!(已拒绝 * 2 < 已检查, "派生失败过多：{已拒绝}/{已检查}");
    }

    /// 提取标记围栏代码块（标记为 rust、中文或裸反引号）
    函数 取标记代码块(文本值: &文本) -> 向量<字符串> {
        让 可变 结果块们 = 向量::新建();
        让 可变 当前块: 选项<字符串> = 无;
        对于 行文本 在 文本值.逐行() {
            让 裁剪行 = 行文本.裁剪左侧();
            如果让 有值(剩余) = 裁剪行.去前缀("```") {
                如果让 有值(缓冲) = 当前块.取() {
                    如果 !缓冲.以开头('\u{0}') {
                        结果块们.推(缓冲);
                    }
                    当前块 = 无;
                } 否则 {
                    让 语言名 = 剩余.裁剪();
                    如果 模式匹配!(语言名, "" | "rust" | "zh" | "rust,zh" | "zh,rust") {
                        让 新缓冲 = 字符串::新建();
                        当前块 = 有值(新缓冲);
                    } 否则 {
                        // 非代码块（bash/text/…）：置无但仍需闭合，
                        // 用一个永不出发的占位块标记跳过
                        当前块 = 有值("\u{0}".转字符串());
                    }
                }
            } 否则 如果让 有值(缓冲) = 当前块.作为可变引用方法()
                && !缓冲.以开头('\u{0}')
            {
                缓冲.推入字符串(行文本);
                缓冲.推('\n');
            }
        }
        结果块们
    }

    函数 建新缓存() -> 缓存::转译缓存 {
        // 静音走一次性写入且持级别锁：旧写法每次建缓存都裸写全局级别，等于给
        // 所有「断言级别」的用例埋了个不持锁的竞争者（撑开窗口实测 12/12 轮红）。
        日志::测试静音();
        缓存::转译缓存::默认容量()
    }

    #[测试]
    函数 完整管线与增量缓存() {
        让 管理器 = 建测试管理器();
        让 可变 缓存实例 = 建新缓存();
        让 源文本 = "函数 主函数() { 让 数量: 整数 = 5; 打印行(\"你好\") }";

        让 第一次 = 转译源文本(源文本, &管理器, &可变 缓存实例).期望("翻译失败");
        让 第二次 = 转译源文本(源文本, &管理器, &可变 缓存实例).期望("翻译失败");

        // 输出一致且包含各阶段替换结果（词法 + 模块路径 + 别名）
        断言相等!(第一次, 第二次);
        断言!(
            第一次.包含("fn 主函数() { let 数量: i32 = 5; println!(\"你好\") }"),
            "实际输出：{}",
            第一次
        );

        // 第二次调用命中缓存：条数 1、未命中 1 次、命中 1 次
        断言相等!(缓存实例.当前条目数(), 1);
        断言相等!(缓存实例.未命中次数(), 1);
        断言相等!(缓存实例.命中次数(), 1);
        断言相等!(缓存实例.命中率(), 0.5);
    }

    #[测试]
    函数 内容变化触发重译() {
        让 管理器 = 建测试管理器();
        让 可变 缓存实例 = 建新缓存();

        转译源文本("函数 主函数() { 让 x = 1; }", &管理器, &可变 缓存实例).期望("翻译失败");
        转译源文本("函数 主函数() { 让 x = 2; }", &管理器, &可变 缓存实例).期望("翻译失败");

        断言相等!(缓存实例.当前条目数(), 2);
        断言相等!(缓存实例.未命中次数(), 2);
    }

    #[测试]
    函数 管线方法位让位保留字() {
        // 方法位让位（`枚举` 的词法值是保留关键字，直译出 `.enum()` 非法，
        // 别名表给出的 `.enumerate()` 才是合法产物）：
        // 完整管线产出 `.iter().enumerate()`（此前为 `.iter().enum()` 编译失败）
        让 管理器 = 建测试管理器();
        让 可变 缓存实例 = 建新缓存();
        让 源文本 = "函数 主函数() { 让 n = 甲.迭代().枚举(); }";
        让 输出产物 = 转译源文本(源文本, &管理器, &可变 缓存实例).期望("翻译失败");
        断言!(输出产物.包含(".iter().enumerate()"), "实际输出：{}", 输出产物);

        // 替换值非保留字的词不受让位影响：`.文件()` 照旧 `.file()`（宏节词表）
        让 可变 缓存实例 = 建新缓存();
        让 输出产物 = 转译源文本("函数 主函数() { 让 f = 甲.文件(); }", &管理器, &可变 缓存实例)
            .期望("翻译失败");
        断言!(输出产物.包含(".file()"), "实际输出：{}", 输出产物);
    }

    #[测试]
    函数 带映射转译记录关键字替换() {
        让 管理器 = 建测试管理器();
        让 可变 缓存实例 = 建新缓存();
        让 源文本 = "函数 主函数() { 让 x = 1; }";

        让 输出产物 = 转译源文本并取映射(源文本, &管理器, &可变 缓存实例).期望("翻译失败");

        // 函数 与 让 被替换，主函数 保持原样不产生映射
        让 函数映射条目 = 输出产物
            .源映射
            .迭代()
            .查找(|映射条目| 映射条目.原文 == "函数")
            .期望("应有 函数 映射");
        断言相等!(函数映射条目.替换文字, "fn");
        断言相等!(
            &源文本[函数映射条目.源偏移..函数映射条目.源偏移 + 函数映射条目.源码长度],
            "函数"
        );

        让 让映射条目 = 输出产物
            .源映射
            .迭代()
            .查找(|映射条目| 映射条目.原文 == "让")
            .期望("应有 让 映射");
        断言相等!(让映射条目.替换文字, "let");
        断言!(!输出产物.源映射.迭代().任意(|映射条目| 映射条目.原文 == "主函数"));
    }

    #[测试]
    函数 语言包更新使缓存失效() {
        让 管理器 = 建测试管理器();
        让 可变 缓存实例 = 建新缓存();
        让 源文本 = "函数 主函数() { 让 x = 1; }";

        转译源文本(源文本, &管理器, &可变 缓存实例).期望("翻译失败");
        // 语言包变化（新增 可变 到 可变引用 映射）→ 语境指纹变化 → 缓存失效重新翻译
        让 新管理器 = 映射管理器::映射管理器::从内置载入(
            r#"
["声明"]
"函数" = "fn"
"让" = "let"
"可变" = "mut"
"#,
            "[\"模块路径\"]\n",
            "[\"模块路径\"]\n[\"标识符\"]\n",
            &[],
        )
        .期望("创建新管理器失败");
        转译源文本(源文本, &新管理器, &可变 缓存实例).期望("翻译失败");

        // 同内容哈希 → 覆盖原条目（条数不变）；语境变化 → 未命中计数增加
        断言相等!(缓存实例.当前条目数(), 1);
        断言相等!(缓存实例.未命中次数(), 2);
        // 新映射生效：可变 到 可变引用
        让 结果值 = 转译源文本("函数 主函数() { 让 可变 x = 1; }", &新管理器, &可变 缓存实例)
            .期望("翻译失败");
        断言!(结果值.包含("let mut x"));
    }

    #[测试]
    函数 零宽字符告警不阻断() {
        让 管理器 = 建测试管理器();
        让 可变 缓存实例 = 建新缓存();
        // 源码含零宽空格（令牌之间，Rust 视为空白），翻译应正常完成
        让 源文本 = "函数 主函数() {\u{200B} 让 x = 1; }";
        让 结果值 = 转译源文本(源文本, &管理器, &可变 缓存实例);
        断言!(结果值.是否为成功(), "零宽字符不应阻断翻译：{:?}", 结果值);
        断言!(结果值.解包().包含("fn 主函数()"));
    }

    // ===== 全管线编辑地图（流程映射）测试 =====

    /// 把编辑地图应用到源文本（按 源偏移 拼接替换文字），
    /// 是"地图与真实输出一致"的权威校验——任何阶段改规则却不同步地图都会使此测试失败。
    函数 应用流程映射(源文本: &文本, 地图: &[缓存::源码映射条目]) -> 字符串 {
        让 可变 回放文本 = 字符串::新建();
        让 可变 位置值 = 0;
        对于 编辑条 在 地图 {
            回放文本.推入字符串(&源文本[位置值..编辑条.源偏移]);
            回放文本.推入字符串(&编辑条.替换文字);
            位置值 = 编辑条.源偏移 + 编辑条.源码长度;
        }
        回放文本.推入字符串(&源文本[位置值..]);
        回放文本
    }

    /// 完整管线（词法 + 使用路径 + 包前缀 + 别名）下，
    /// 地图回放结果必须与真实输出逐字符一致
    #[测试]
    函数 流程映射回放等于输出() {
        让 管理器 = 建测试管理器();
        让 模块名集 = 哈希集合::从(["辅助".转字符串()]);
        让 源文本 = "使用 标准集合::哈希映射;\n\
                      函数 主函数() {\n\
                      \x20   辅助::辅助函数();\n\
                      \x20   让 数量: 整数 = 5;\n\
                      \x20   打印行(\"你好\");\n\
                      }";
        让 输出产物 = 带映射转译管线(源文本, &管理器, 有值(&模块名集));
        断言!(输出产物.输出.包含("crate::辅助::辅助函数()"));
        让 回放文本 = 应用流程映射(源文本, &输出产物.流程映射);
        断言相等!(
            回放文本, 输出产物.输出,
            "流程映射回放必须与真实输出一致\n实际输出：{}\n回放输出：{}",
            输出产物.输出, 回放文本
        );
    }

    /// 不带模块名集（命令行场景）时地图同样与输出一致
    #[测试]
    函数 流程映射无前缀回放一致() {
        让 管理器 = 建测试管理器();
        让 源文本 = "函数 主函数() { 让 数量: 整数 = 5; 打印行(\"你好\") }";
        让 输出产物 = 带映射转译管线(源文本, &管理器, 无);
        让 回放文本 = 应用流程映射(源文本, &输出产物.流程映射);
        断言相等!(回放文本, 输出产物.输出);
    }

    /// 静默重放与常规管线输出逐项一致：仅跳过教学告警，不得改变任何转译结果
    ///
    /// 诊断列映射重建走 `静默转译管线` 重放，若重放规则与写盘
    /// 转译（`转译管线`）有任何差异，列号回译就会错位。
    #[测试]
    函数 静默管线与常规一致() {
        让 管理器 = 建测试管理器();
        让 源文本 = "函数 主函数() {\n    让 数量: 整数 = 42;\n    打印行(\"你好\");\n}";
        让 常规产物 = 转译管线(源文本, &管理器);
        让 静默产物 = 静默转译管线(源文本, &管理器);
        断言相等!(常规产物.输出, 静默产物.输出, "静默重放的转译输出必须一致");
        断言相等!(
            常规产物.流程映射, 静默产物.流程映射,
            "静默重放的管线地图必须一致"
        );
    }

    /// 游标版逆映射与朴素版逐偏移等价：多种表形态 × 全量偏移查询 × 阶段链
    ///
    /// 生产路径按升序批量查询（见 `组合流程映射`），游标只前进不回退；
    /// 朴素版每次从表头重扫。两者必须逐偏移给出同一答案——偏移换算错了，
    /// 全管线地图就错位，列映射回译跟着错。形态覆盖：空表、首条从 0 起、
    /// 替换变长/变短/等长/清空、相邻无缝隙，以及表尾之后的越界查询。
    #[测试]
    函数 逆映射游标与朴素一致() {
        函数 表(条目列: &[(无符号机器整数, 无符号机器整数, &文本, &文本)]) -> 向量<缓存::源码映射条目> {
            条目列
                .迭代()
                .映射(|(源偏移值, 长度值, 原文本, 替换文本)| {
                    缓存::源码映射条目::新建(*源偏移值, *长度值, 原文本, 替换文本)
                })
                .收集()
        }
        让 形态: 向量<向量<缓存::源码映射条目>> = 向量![
            表(&[]),
            表(&[(0, 6, "函数", "fn")]),
            表(&[
                (3, 6, "函数", "fn"),
                (20, 3, "让", "let"),
                (40, 9, "整数", "i32"),
            ]),
            表(&[
                (0, 6, "打印行", ""),
                (10, 3, "甲", "乙丙丁"),
                (14, 2, "等", "等"),
            ]),
            表(&[(5, 2, "aa", "bb"), (7, 2, "cc", "dd")]),
        ];
        对于 编辑表 在 &形态 {
            // 查到表尾之后一大截：尾部未替换区间的换算也要对齐
            让 上界 = 编辑表
                .最后一个()
                .映射(|编辑条| 编辑条.源偏移 + 编辑条.替换文字.元素数() + 32)
                .解包或用(64);
            让 朴素: 向量<无符号机器整数> = (0..=上界)
                .映射(|偏移值| 反查映射偏移(编辑表, 偏移值))
                .收集();
            让 可变 映射游标 = 逆映射游标::新建(编辑表);
            对于 (偏移值, 期望值) 在 朴素.迭代().枚举() {
                断言相等!(
                    *期望值,
                    映射游标.映射偏移(偏移值),
                    "偏移 {偏移值} 的换算不一致（表：{编辑表:?}）"
                );
            }
        }

        // 随机表形状：固定种子线性同余造 200 张表，条数、间隔（含 0，即相邻无缝隙）、
        // 原文长度（含 0，即同偏移并列）与替换长度（含 0，即整段删除）全部随机。
        // 上面手写的形态容易漏边角，随机铺开才能把差分覆盖面拉开；不变量与
        // 生产一致：按输入偏移升序且互不重叠（下一条偏移 ≥ 上一条偏移 + 上一条长度）。
        让 可变 种子: 无符号长整数 = 0x9E37_79B9_7F4A_7C15;
        让 可变 随机 = 移动 || -> 无符号机器整数 {
            种子 = 种子
                .溢出乘(6_364_136_223_846_793_005)
                .溢出加(1_442_695_040_888_963_407);
            (种子 >> 33) 作为 无符号机器整数
        };
        对于 轮 在 0..200 {
            让 可变 编辑表 = 向量::新建();
            让 可变 偏移值 = 随机() % 4;
            对于 _ 在 0..(随机() % 8 + 1) {
                让 原文长度 = 随机() % 4;
                让 替换长度 = 随机() % 4;
                编辑表.推(缓存::源码映射条目::新建(
                    偏移值,
                    原文长度,
                    // ASCII：让 `长度` 字段就是字节长度，与 `原文长度` 自洽
                    &"x".重复(原文长度),
                    &"y".重复(替换长度),
                ));
                偏移值 += 原文长度 + 随机() % 5;
            }
            // 查询上界：整表走完得到的输出侧末尾再往后一截（尾部未替换区间）
            让 上界 = 偏移值 + 16;
            让 朴素: 向量<无符号机器整数> = (0..=上界)
                .映射(|偏移值| 反查映射偏移(&编辑表, 偏移值))
                .收集();
            让 可变 映射游标 = 逆映射游标::新建(&编辑表);
            对于 (偏移值, 期望值) 在 朴素.迭代().枚举() {
                断言相等!(
                    *期望值,
                    映射游标.映射偏移(偏移值),
                    "第 {轮} 轮随机表：偏移 {偏移值} 的换算不一致（表：{编辑表:?}）"
                );
            }
        }

        // 阶段链：上一环的答案作为下一环的查询（对应 `组合流程映射` 里
        // 「先夹更后阶段、再夹词法阶段」的串联），逐环同样必须等价
        让 甲表 = 表(&[(0, 6, "使用", "use"), (12, 6, "标准库", "std")]);
        让 乙表 = 表(&[(2, 3, "向量", "Vec"), (9, 2, "映射", "Map")]);
        让 可变 游标甲 = 逆映射游标::新建(&甲表);
        让 可变 游标乙 = 逆映射游标::新建(&乙表);
        对于 偏移值 在 0..=120 {
            让 期望值 = 反查映射偏移(&甲表, 反查映射偏移(&乙表, 偏移值));
            让 中间值 = 游标乙.映射偏移(偏移值);
            断言相等!(
                期望值,
                游标甲.映射偏移(中间值),
                "阶段链偏移 {偏移值} 的换算不一致（乙给出 {中间值}）"
            );
        }
    }

    /// 真实语言包 + 别名密集多阶段源：全管线地图回放仍须逐字等于输出
    ///
    /// 手工小表测不到「词法上千条 × 别名/`crate::` 前缀阶段数百条」的换算链，
    /// 而这条链正是 `组合流程映射` 里游标推进的地方；前提破了（游标
    /// 乱序、单调性假设不成立）就直接反映为回放错位，不靠人工比对也能接住。
    #[测试]
    函数 流程映射别名密集语料回放() {
        让 管理器 = 建中文管理器();
        让 可变 源文本 =
            字符串::从("使用 标准库::向量::向量;\n使用 标准库::映射::映射;\n\n模块 辅助;\n\n");
        对于 序号 在 0..120 {
            源文本.推入字符串(&格式化!(
                "函数 函数_{序号}(项: 向量<字符串>, 表: 映射<字符串, 整数>) -> 整数 {{\n\
                 \x20   让 个数 = 项.长度();\n\
                 \x20   项.推送(\"新项\");\n\
                 \x20   让 合计 = 项.迭代().计数();\n\
                 \x20   表.插入(\"键{序号}\", 合计);\n\
                 \x20   返回 辅助::查询(表, 个数) + 项.长度();\n\
                 }}\n\n"
            ));
        }
        让 模块名集: 哈希集合<字符串> = ["辅助".转字符串()].转迭代().收集();
        // 静默入口：本用例只关心偏移换算，不要被上千条教学告警埋掉失败输出
        让 输出产物 = 静默带映射与项目转译管线(
            &源文本,
            &管理器,
            有值(&模块名集),
            无,
        );
        // 三道阶段的编辑都进了地图：条目数远超小表，才有资格作为游标的回归样本
        断言!(
            输出产物.流程映射.元素数() > 1000,
            "别名密集语料的地图条目应上千：{}",
            输出产物.流程映射.元素数()
        );
        断言!(
            输出产物.输出.包含("crate::辅助::query"),
            "语料应确实走通 `crate::` 前缀阶段：{}",
            &输出产物.输出[..输出产物.输出.元素数().最小值(400)]
        );
        让 回放文本 = 应用流程映射(&源文本, &输出产物.流程映射);
        断言相等!(
            回放文本, 输出产物.输出,
            "地图回放必须逐字等于输出（偏移换算错位即在此暴露）"
        );
    }

    /// 宏自动补的 `!` 计入替换文字；模块路径段条目为 `crate::辅助`
    #[测试]
    函数 流程映射记录宏惊叹号与前缀() {
        让 管理器 = 建测试管理器();
        让 模块名集 = 哈希集合::从(["辅助".转字符串()]);
        让 源文本 = "函数 主函数() {\n    辅助::辅助函数();\n    打印行(\"你好\");\n}";
        让 输出产物 = 带映射转译管线(源文本, &管理器, 有值(&模块名集));

        让 宏条目 = 输出产物
            .流程映射
            .迭代()
            .查找(|映射条目| 映射条目.原文 == "打印行")
            .期望("应有宏条目");
        断言相等!(宏条目.替换文字, "println!");
        让 限定条目 = 输出产物
            .流程映射
            .迭代()
            .查找(|映射条目| 映射条目.原文 == "辅助")
            .期望("应有模块路径条目");
        断言相等!(限定条目.替换文字, "crate::辅助");
    }

    /// 使用语句路径段经模块路径阶段替换、末段经别名阶段替换（语言服务器之前缺失的环节）
    #[测试]
    函数 流程映射使用语句模块路径与别名() {
        让 管理器 = 映射管理器::映射管理器::从内置载入(
            r#"
["声明"]
"函数" = "fn"
"让" = "let"
"使用" = "use"
["宏"]
"打印行" = "println"
"#,
            r#"
["模块路径"]
"标准集合" = "std::collections"
"#,
            r#"
["标识符"]
"哈希映射" = "HashMap"
"字符串" = "String"
"#,
            &[],
        )
        .期望("创建管理器失败");
        让 源文本 = "使用 标准集合::哈希映射;\n函数 主函数() {\n    让 s: 字符串 = 哈希映射::新建();\n    打印行(\"你好\");\n}";
        让 输出产物 = 带映射转译管线(源文本, &管理器, 无);
        断言!(
            输出产物.输出.包含("use std::collections::HashMap;"),
            "使用语句路径与末段都应被替换：{}",
            输出产物.输出
        );
        断言相等!(
            应用流程映射(源文本, &输出产物.流程映射),
            输出产物.输出
        );
    }

    /// 属性测试：正向转译 → 反向转译应精确还原母语源（回译不变量）
    ///
    /// 约束：测试源避开模块路径（反向转译无模块路径表，`网络库::服务器` 之类
    /// 无法还原）；宏调用写带感叹号形式（正向自动补的 `!` 反向原样保留，
    /// 源写 `打印行(` 会还原成 `打印行!(` 造成差异）。
    #[测试]
    函数 往返保持母语源() {
        让 管理器 = 建测试管理器();
        让 源文本 = "函数 主函数() {\n    让 数量: 整数 = 5;\n    让 文本: 字符串 = \"世界\";\n    打印行!(\"你好\");\n}";
        让 输出产物 = 转译管线(源文本, &管理器);
        断言!(
            输出产物.输出.包含("fn 主函数()") && 输出产物.输出.包含("println!"),
            "正向转译应产出英文：{}",
            输出产物.输出
        );

        // 合并关键字 + 宏 + 别名三类映射并反转（英文 → 中文），与正向管线互为逆
        让 可变 反查表 = 标准库::集合::哈希映射::新建();
        对于 (母语词, 英文词) 在 管理器.取关键词表() {
            反查表.置入(英文词.克隆值(), 母语词.克隆值());
        }
        对于 (母语词, 英文词) 在 管理器.取宏表() {
            反查表.置入(英文词.克隆值(), 母语词.克隆值());
        }
        对于 (母语词, 英文词) 在 管理器.取别名表() {
            反查表.置入(英文词.克隆值(), 母语词.克隆值());
        }

        让 回译文本 = 词法器::反译(
            &输出产物.输出,
            &反查表,
            &哈希集合::新建(),
            &哈希集合::新建(),
        );
        断言相等!(回译文本, 源文本, "回译应精确还原母语源");
    }

    /// 属性测试：英文输出再经转译管线应保持不变（幂等不变量）
    ///
    /// 若映射表中混入英文键、或宏感叹号自动补逻辑对英文输出不幂等，
    /// 连续转译会持续改变文本，本测试守护管线的收敛性。
    #[测试]
    函数 再次转译幂等() {
        让 管理器 = 建测试管理器();
        让 源文本 = "函数 主函数() {\n    让 数量: 整数 = 5;\n    打印行!(\"你好\");\n}";
        让 英文产物 = 转译管线(源文本, &管理器).输出;
        让 再译产物 = 转译管线(&英文产物, &管理器).输出;
        断言相等!(英文产物, 再译产物, "对英文输出再转译应保持不变");
    }

    /// 属性测试：全部内置语言包的映射表不得含循环引用
    ///
    /// 循环（A→B 且 B→A）会使正向/反向转译来回抖动，属语言包配置错误；
    /// 本测试加载全部内置语言包，守护新增条目时不会引入互指。
    #[测试]
    函数 全部内置语言包无循环映射() {
        让 语言代码们 = 语言::内置语言代码();
        断言!(语言代码们.元素数() >= 9, "应覆盖全部内置语言：{语言代码们:?}");
        对于 语言代码 在 语言代码们 {
            让 语言包文件们 = 语言::内置语言包文件(语言代码);
            让 取内容 = |名称: &文本| {
                语言包文件们
                    .迭代()
                    .查找(|(名字项, _)| *名字项 == 名称)
                    .映射(|(_, 内容项)| *内容项)
                    .解包或用("")
            };
            让 关键字内容 = 取内容("keywords.toml");
            断言!(!关键字内容.是否为空(), "{语言代码} 语言包缺少 keywords.toml");
            让 三方数据: 向量<(&文本, &文本)> = 语言包文件们
                .迭代()
                .过滤(|(名字项, _)| 名字项.以开头("crates/"))
                .映射(|(名字项, 内容项)| (*名字项, *内容项))
                .收集();
            让 管理器 = 映射管理器::映射管理器::从内置载入(
                关键字内容,
                取内容("module_paths.toml"),
                取内容("stdlib.toml"),
                &三方数据,
            )
            .期望("语言包应能解析");
            让 循环项 = 管理器.查循环();
            断言!(循环项.是否为空(), "{语言代码} 语言包存在循环映射：{循环项:?}");
        }
    }

    /// 门禁：内置语言包的「方法位让位」词在完整管线中必须落到别名层词条
    ///
    /// 词法替换值为保留关键字的词（`枚举` 对应保留关键字）在方法位直译非法
    /// （`.枚举()` → `.enum()`）；让位机制应将其保留给别名阶段
    /// （`.enumerate()`）。本测试对每个语言包在每个让位词上验证管线闭环，
    /// 不硬编码具体词汇——新增语言包自动纳入守护。
    #[测试]
    函数 内置语言包方法让位词落到别名阶段() {
        对于 语言代码 在 语言::内置语言代码() {
            让 语言包文件们 = 语言::内置语言包文件(语言代码);
            让 取内容 = |名称: &文本| {
                语言包文件们
                    .迭代()
                    .查找(|(名字项, _)| *名字项 == 名称)
                    .映射(|(_, 内容项)| *内容项)
                    .解包或用("")
            };
            让 三方数据: 向量<(&文本, &文本)> = 语言包文件们
                .迭代()
                .过滤(|(名字项, _)| 名字项.以开头("crates/"))
                .映射(|(名字项, 内容项)| (*名字项, *内容项))
                .收集();
            让 管理器 = 映射管理器::映射管理器::从内置载入(
                取内容("keywords.toml"),
                取内容("module_paths.toml"),
                取内容("stdlib.toml"),
                &三方数据,
            )
            .期望("语言包应能解析");

            让 可变 缓存实例 = 建新缓存();
            对于 词语 在 管理器.取方法让位词() {
                让 目标词 = 管理器.取别名表().获取(词语).期望("让位词应有别名词条");
                让 源文本 = 格式化!("函数 主函数() {{ 让 x = 甲.{}(); }}", 词语);
                让 输出产物 = 转译源文本(&源文本, &管理器, &可变 缓存实例).期望("翻译失败");
                断言!(
                    输出产物.包含(&格式化!(".{}()", 目标词)),
                    "{语言代码}: `.{}()` 应经让位落到别名词条 `.{}()`，实际输出：{}",
                    词语,
                    目标词,
                    输出产物
                );
            }
        }
    }

    /// 门禁：附录C《常见错误信息字典》收录的错误码，在全部内置语言包中
    /// 都必须有教学提示（errors.toml 的 "教学提示" 字段）
    ///
    /// 附录C 是教程侧的高频错误清单，与教程章节同步维护；
    /// 教学提示缺失会让新手在常见错误上得不到母语指引，
    /// 因此该清单与语言包的覆盖关系由测试守护（附录C 新增错误码时同步更新本清单）。
    #[测试]
    函数 附录错误码教学提示齐全() {
        // 与 tutorials/附录C：常见错误信息字典.md 的 `### E0xxx` 标题同步维护
        让 附录错误码: &[&文本] = &[
            "E0004", "E0063", "E0072", "E0106", "E0204", "E0261", "E0277", "E0308", "E0382",
            "E0405", "E0425", "E0432", "E0502", "E0507", "E0508", "E0531", "E0573", "E0596",
            "E0597", "E0599", "E0603",
        ];
        让 语言代码们 = 语言::内置语言代码();
        断言!(语言代码们.元素数() >= 9, "应覆盖全部内置语言：{语言代码们:?}");
        对于 语言代码 在 语言代码们 {
            让 语言包文件们 = 语言::内置语言包文件(语言代码);
            让 错误表文本 = 语言包文件们
                .迭代()
                .查找(|(名字项, _)| *名字项 == "errors.toml")
                .映射(|(_, 内容项)| *内容项)
                .期望("{语言代码} 语言包缺少 errors.toml");
            让 管理器 = 诊断::错误消息管理器::从字符串载入(错误表文本)
                .期望("errors.toml 应能解析");
            对于 错误码 在 附录错误码 {
                让 翻译条目 = 管理器
                    .翻译表
                    .获取(*错误码)
                    .解包或用否则(|| {
                        恐慌!("{语言代码} 语言包缺少附录C 错误码 [{错误码}] 的教学提示")
                    });
                断言!(
                    翻译条目.教学提示.是否为有值(),
                    "{语言代码} 语言包的 [{错误码}] 缺少教学提示（附录C 已收录）"
                );
            }
        }
    }
}
