        让 新管理器 = 映射管理::映射管理器::自内置加载(
            r#"
["声明"]
"函数" = "fn"
"让" = "let"
"可变" = "mut"
"#,
            "[\"模块路径\"]\n",
            "[\"模块路径\"]\n[\"标识符\"]\n",
