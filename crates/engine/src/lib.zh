        );

        让 让映射 = 产出
            .源映射
            .迭代()
            .查找(|标记项| 标记项.原文 == "让")
            .期望("应有 让 映射");
        断言相等!(让映射.替换文本, "let");
        断言!(!产出.源映射.迭代().任意(|标记项| 标记项.原文 == "主函数"));
    }

    #[测试]
    函数 测试语言包更新使缓存失效() {
        让 映射管理器 = 建管理器();
