        .期望("创建新管理器失败");
        源码转译(源码, &新管理器, &可变 缓存表).期望("翻译失败");

        // 同内容哈希 → 覆盖原条目（条数不变）；语境变化 → 未命中计数增加
        断言相等!(缓存表.条目数目(), 1);
        断言相等!(缓存表.缺失数目(), 2);
