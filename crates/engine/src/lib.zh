                      }";
        让 产出 = 转译管线并映射(源码, &映射管理器, 有值(&模块名集));
        断言!(产出.产出.包含("crate::辅助::辅助函数()"));
        让 重建 = 应用管线地图(源码, &产出.管线映射);
        断言相等!(
            重建, 产出.产出,
            "pipeline_map 回放必须与真实输出一致\n实际输出：{}\n回放输出：{}",
            产出.产出, 重建
        );
    }

    /// 不带 module_names（CLI 场景）时地图同样与输出一致
