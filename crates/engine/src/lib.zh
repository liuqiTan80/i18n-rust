        让 源码 = "函数 主函数() {\n    让 数量: 整数 = 42;\n    打印行(\"你好\");\n}";
        让 常规 = 转译管线(源码, &映射管理器);
        让 静默 = 转译管线静默(源码, &映射管理器);
        断言相等!(常规.产出, 静默.产出, "静默重放的转译输出必须一致");
        断言相等!(
            常规.管线映射, 静默.管线映射,
            "静默重放的管线地图必须一致"
        );
    }

    /// 宏自动补的 `!` 计入 replacement；模块路径段条目为 `包::辅助`
    #[测试]
    函数 测试管线地图记录宏叹号与前缀() {
        让 映射管理器 = 建管理器();
        让 模块名集 = 哈希集合::从(["辅助".转字符串()]);
        让 源码 = "函数 主函数() {\n    辅助::辅助函数();\n    打印行(\"你好\");\n}";
        让 产出 = 转译管线并映射(源码, &映射管理器, 有值(&模块名集));

        让 宏条目 = 产出
            .管线映射
            .迭代()
            .查找(|错误值| 错误值.原文 == "打印行")
            .期望("应有宏条目");
        断言相等!(宏条目.替换文本, "println!");
        让 前缀条目 = 产出
            .管线映射
            .迭代()
            .查找(|错误值| 错误值.原文 == "辅助")
            .期望("应有模块路径条目");
        断言相等!(前缀条目.替换文本, "crate::辅助");
    }

    /// use 语句路径段经模块路径阶段替换、末段经别名阶段替换（LSP 之前缺失的环节）
    #[测试]
    函数 测试管线地图使用语句路径与别名() {
        让 映射管理器 = 映射管理::映射管理器::自内置加载(
            r#"
["声明"]
"函数" = "fn"
"让" = "let"
"使用" = "use"
["宏"]
"打印行" = "println"
"#,
            r#"
["模块路径"]
"标准集合" = "std::collections"
"#,
            r#"
["标识符"]
"哈希映射" = "HashMap"
"字符串" = "String"
"#,
            &[],
        )
        .期望("创建管理器失败");
        让 源码 = "使用 标准集合::哈希映射;\n函数 主函数() {\n    让 s: 字符串 = 哈希映射::新建();\n    打印行(\"你好\");\n}";
        让 产出 = 转译管线并映射(源码, &映射管理器, 无);
        断言!(
            产出.产出.包含("use std::collections::HashMap;"),
            "use 语句路径与末段都应被替换：{}",
            产出.产出
        );
        断言相等!(
            应用管线地图(源码, &产出.管线映射),
            产出.产出
        );
    }

    /// 属性测试：正向转译 → 反向转译应精确还原母语源（回译不变量）
    ///
    /// 约束：测试源避开模块路径（反向转译无模块路径表，`网络库::服务器` 之类
    /// 无法还原）；宏调用写带感叹号形式（正向自动补的 `!` 反向原样保留，
    /// 源写 `打印行(` 会还原成 `打印行!(` 造成差异）。
    #[测试]
    函数 测试属性回译不变量() {
        让 映射管理器 = 建管理器();
        让 源码 = "函数 主函数() {\n    让 数量: 整数 = 5;\n    让 文本: 字符串 = \"世界\";\n    打印行!(\"你好\");\n}";
        让 产出 = 转译管线(源码, &映射管理器);
        断言!(
            产出.产出.包含("fn 主函数()") && 产出.产出.包含("println!"),
            "正向转译应产出英文：{}",
            产出.产出
        );

        // 合并关键字 + 宏 + 别名三类映射并反转（英文 → 中文），与正向管线互为逆
        让 可变 反向映射表 = 哈希映射::新建();
        对于 (母语, 英文) 在 映射管理器.取关键词映射表() {
            反向映射表.插入(英文.克隆值(), 母语.克隆值());
        }
        对于 (母语, 英文) 在 映射管理器.取宏映射表() {
            反向映射表.插入(英文.克隆值(), 母语.克隆值());
        }
        对于 (母语, 英文) 在 映射管理器.取别名映射表() {
            反向映射表.插入(英文.克隆值(), 母语.克隆值());
        }

        让 还原 = 词法::逆向转译(
            &产出.产出,
            &反向映射表,
            &哈希集合::新建(),
            &哈希集合::新建(),
        );
        断言相等!(还原, 源码, "回译应精确还原母语源");
    }

    /// 属性测试：英文输出再经转译管线应保持不变（幂等不变量）
    ///
    /// 若映射表中混入英文键、或宏感叹号自动补逻辑对英文输出不幂等，
    /// 连续转译会持续改变文本，本测试守护管线的收敛性。
    #[测试]
    函数 测试属性再转译幂等() {
        让 映射管理器 = 建管理器();
        让 源码 = "函数 主函数() {\n    让 数量: 整数 = 5;\n    打印行!(\"你好\");\n}";
        让 英文 = 转译管线(源码, &映射管理器).产出;
        让 再次 = 转译管线(&英文, &映射管理器).产出;
        断言相等!(英文, 再次, "对英文输出再转译应保持不变");
    }

    /// 属性测试：全部内置语言包的映射表不得含循环引用
    ///
    /// 循环（A→B 且 B→A）会使正向/反向转译来回抖动，属语言包配置错误；
    /// 本测试加载全部内置语言包，守护新增条目时不会引入互指。
    #[测试]
    函数 测试全部内置语言包无映射循环() {
        让 语言码列表 = 语言::内置语言代码();
        断言!(语言码列表.元素数() >= 9, "应覆盖全部内置语言：{语言码列表:?}");
        对于 语码 在 语言码列表 {
            让 文件集 = 语言::内置语言文件(语码);
            让 取文件 = |名称: &文本| {
                文件集
                    .迭代()
                    .查找(|(数量, _)| *数量 == 名称)
                    .变换(|(_, 字符值)| *字符值)
                    .解包或用("")
            };
            让 关键词 = 取文件("keywords.toml");
            断言!(!关键词.是否为空(), "{语码} 语言包缺少 keywords.toml");
            让 三方: 向量<(&文本, &文本)> = 文件集
                .迭代()
                .过滤(|(数量, _)| 数量.以开头("crates/"))
                .变换(|(数量, 字符值)| (*数量, *字符值))
                .收集();
            让 映射管理器 = 映射管理::映射管理器::自内置加载(
                关键词,
                取文件("module_paths.toml"),
                取文件("stdlib.toml"),
                &三方,
            )
            .期望("语言包应能解析");
            让 映射循环 = 映射管理器.查找映射环();
            断言!(映射循环.是否为空(), "{语码} 语言包存在循环映射：{映射循环:?}");
        }
    }

    /// 门禁：内置语言包的「方法位让位」词在完整管线中必须落到别名层词条
    ///
    /// 词法替换值为保留关键字的词（`枚举`→enum）在方法位直译非法
    /// （`.枚举()` → `.enum()`）；让位机制应将其保留给别名阶段
    /// （`.枚举()`）。本测试对每个语言包在每个让位词上验证管线闭环，
    /// 不硬编码具体词汇——新增语言包自动纳入守护。
    #[测试]
    函数 测试内置语言包方法位让位词达别名阶段() {
        对于 语码 在 语言::内置语言代码() {
            让 文件集 = 语言::内置语言文件(语码);
            让 取文件 = |名称: &文本| {
                文件集
                    .迭代()
                    .查找(|(数量, _)| *数量 == 名称)
                    .变换(|(_, 字符值)| *字符值)
                    .解包或用("")
            };
            让 三方: 向量<(&文本, &文本)> = 文件集
                .迭代()
                .过滤(|(数量, _)| 数量.以开头("crates/"))
                .变换(|(数量, 字符值)| (*数量, *字符值))
                .收集();
            让 映射管理器 = 映射管理::映射管理器::自内置加载(
                取文件("keywords.toml"),
                取文件("module_paths.toml"),
                取文件("stdlib.toml"),
                &三方,
            )
            .期望("语言包应能解析");

            让 可变 缓存表 = 新缓存();
            对于 让位词 在 映射管理器.取方法延迟词() {
                让 目标词 = 映射管理器
                    .取别名映射表()
                    .获取(让位词)
                    .期望("让位词应有别名词条");
                让 源码 = 格式化!("函数 主函数() {{ 让 x = 甲.{}(); }}", 让位词);
                让 产出 = 源码转译(&源码, &映射管理器, &可变 缓存表).期望("翻译失败");
                断言!(
                    产出.包含(&格式化!(".{}()", 目标词)),
                    "{语码}: `.{}()` 应经让位落到别名词条 `.{}`()`，实际输出：{}",
                    让位词,
                    目标词,
                    产出
                );
            }
        }
    }

    /// 门禁：附录C《常见错误信息字典》收录的错误码，在全部内置语言包中
    /// 都必须有教学提示（errors.toml 的 "教学提示" 字段）
    ///
    /// 附录C 是教程侧的高频错误清单，与教程章节同步维护；
    /// 教学提示缺失会让新手在常见错误上得不到母语指引，
    /// 因此该清单与语言包的覆盖关系由测试守护（附录C 新增错误码时同步更新本清单）。
    #[测试]
    函数 测试附录错误码全语言包有教学提示() {
        // 与 tutorials/附录C：常见错误信息字典.md 的 `### E0xxx` 标题同步维护
        让 附录码集: &[&文本] = &[
            "E0004", "E0063", "E0072", "E0106", "E0204", "E0261", "E0277", "E0308", "E0382",
            "E0405", "E0425", "E0432", "E0502", "E0507", "E0508", "E0531", "E0573", "E0596",
            "E0597", "E0599", "E0603",
        ];
        让 语言码列表 = 语言::内置语言代码();
        断言!(语言码列表.元素数() >= 9, "应覆盖全部内置语言：{语言码列表:?}");
        对于 语码 在 语言码列表 {
            让 文件集 = 语言::内置语言文件(语码);
            让 错误文本 = 文件集
                .迭代()
                .查找(|(数量, _)| *数量 == "errors.toml")
                .变换(|(_, 字符值)| *字符值)
                .期望("{语码} 语言包缺少 errors.toml");
            让 管理器 = 诊断::错误翻译管理器::从字符串载入(错误文本)
                .期望("errors.toml 应能解析");
            对于 错误码 在 附录码集 {
                让 条目 = 管理器
                    .错误码表
                    .获取(*错误码)
                    .解包或用否则(|| {
                        崩溃!("{语码} 语言包缺少附录C 错误码 [{错误码}] 的教学提示")
                    });
                断言!(
                    条目.教学提示.是否为有值(),
                    "{语码} 语言包的 [{错误码}] 缺少教学提示（附录C 已收录）"
                );
            }
        }
    }
}


