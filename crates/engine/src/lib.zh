//! i18n-rust 核心引擎
//! 提供多语言 Rust 方言的词法处理、映射管理、诊断翻译、增量缓存、安全检测等功能

#[路径模块 = "别名替换.rs"]
公开 模块 别名替换;
#[路径模块 = "缓存.rs"]
公开 模块 缓存;
#[路径模块 = "诊断/诊断.rs"]
公开 模块 诊断;
#[路径模块 = "词法.rs"]
公开 模块 词法;
#[路径模块 = "教学检查.rs"]
公开 模块 教学检查;
#[路径模块 = "映射管理.rs"]
公开 模块 映射管理;
#[路径模块 = "映射源.rs"]
公开 模块 映射源;
#[路径模块 = "模块路径.rs"]
公开 模块 模块路径;
#[路径模块 = "全角标点.rs"]
公开 模块 全角标点;
#[路径模块 = "列映射.rs"]
公开 模块 列映射;
#[路径模块 = "工具链.rs"]
公开 模块 工具链;
#[路径模块 = "日志.rs"]
公开 模块 日志;
#[路径模块 = "混淆字符.rs"]
公开 模块 混淆字符;
#[路径模块 = "语言.rs"]
公开 模块 语言;
#[路径模块 = "错误类型.rs"]
公开 模块 错误类型;
// 把转译错误重导出到 包 根，供 .zh 侧以 `包::转译错误` 引用——
// 第三方 包 映射表（crates/salvo.toml）把词「错误类型」全局劫持为
// `错误特征`，故 .zh 无法安全写出模块路径 `错误类型::`（会被转成 `错误特征::`）；
// 而 `转译错误` 一词未被劫持，可安全透传，绕过该冲突。
// 同理把加载层的 `加载错误`/`加载目标` 重导出到 包 根，供 .zh 侧以
// `包::{加载目标, 加载错误}` 引用（这两个复合词未被劫持，可安全透传）。
公开 使用 错误类型::{加载目标, 加载错误, 转译错误};
// 日志模块的两个词撞第三方日志词表（crates/日志.toml：`日志`→log、
// `初始化`→init、`日志级别`→Level）：`日志::` 作为本文件声明的模块，
// 路径根位按本地项遮蔽豁免可安全透传；`::` 后的段位无声明可豁免、
// 会被替换出生态名（use 路径同样遭模块路径阶段替换，无法经别名绕开）。
// 故改经 日志.zh 内的未劫持复合别名转发入口：`日志::引擎日志启用()` / `日志::静默日志()`。

使用 标准库::集合::哈希集合;
使用 标准库::时间模块::瞬时;

/// 生产级翻译入口：完整转译管线（词法转译 → 模块路径替换 → 别名替换）
///
/// 流程：
/// 1. 查询增量缓存（内容哈希 + 语境指纹），命中直接复用翻译结果与源映射；
/// 2. 未命中时先执行 Unicode 混淆安全检查（零宽/双向/同形字符），再执行转译；
/// 3. 转译结果写入缓存供后续复用。
///
/// 与命令行工具的管线顺序保持一致；日志级别由 `日志::初始化()` 读取
/// `RZ_LOG` 环境变量（debug/info/warn/错误模块）控制。
公开 函数 源码转译(
    源码: &文本,
    映射管理器: &映射管理::映射管理器,
    缓存表: &可变 缓存::转译缓存,
) -> 结果<字符串, 包::转译错误> {
    成功(源码转译并映射(源码, 映射管理器, 缓存表)?.产出)
}

/// 同 [`源码转译`]，同时返回源映射（被替换标识符的源偏移与翻译前后文本）
公开 函数 源码转译并映射(
    源码: &文本,
    映射管理器: &映射管理::映射管理器,
    缓存表: &可变 缓存::转译缓存,
) -> 结果<缓存::转译产出, 包::转译错误> {
    源码转译并项目(源码, 映射管理器, 缓存表, 无)
}

/// 同 [`源码转译并映射`]，附项目级声明上下文（跨文件声明豁免）
///
/// 缓存语境指纹并入项目上下文指纹（[`别名替换::项目上下文::计算指纹`]）：
/// 项目声明集合变化时相关缓存自动失效，无需语言包版本变化触发。
公开 函数 源码转译并项目(
    源码: &文本,
    映射管理器: &映射管理::映射管理器,
    缓存表: &可变 缓存::转译缓存,
    项目上下文: 选项<&别名替换::项目上下文>,
) -> 结果<缓存::转译产出, 包::转译错误> {
    日志::引擎日志启用();
    让 起始 = 瞬时::现在();
    包::信息日志!(
        "transpile_engine",
        "{}",
        包::语言::查译("log_transpile_start", &[&源码.元素数().转字符串()])
    );

    让 语境指纹 = 缓存::转译缓存::合并语境指纹(
        映射管理器.语境指纹(),
        项目上下文.变换(别名替换::项目上下文::计算指纹),
    );

    让 产出 = 缓存表.检索或转译(源码, 语境指纹, || {
        成功(管线内部执行(
            源码, 映射管理器, 无, 项目上下文, 真,
        ))
    })?;

    让 耗时 = 格式化!("{:?}", 起始.经过());
    包::信息日志!(
        "transpile_engine",
        "{}",
        包::语言::查译(
            "log_transpile_done",
            &[
                &源码.元素数().转字符串(),
                &产出.产出.元素数().转字符串(),
                &耗时,
            ]
        )
    );
    成功(产出)
}

/// 无缓存的完整转译管线：Unicode 混淆检查 → 词法转译 → 模块路径替换 → 别名替换
///
/// CLI / LSP 等短命进程可直接复用此管线，无需维护增量缓存；
/// Unicode 告警经日志（warn 级）输出，不阻断转译。
/// 返回转译结果与源映射（被替换标识符的源偏移与翻译前后文本）。
公开 函数 转译管线(
    源码: &文本,
    映射管理器: &映射管理::映射管理器,
) -> 缓存::转译产出 {
    管线内部执行(源码, 映射管理器, 无, 无, 真)
}

/// 静默转译管线：不输出教学告警（Unicode 混淆/全角标点/lint）
///
/// 供调用方自行负责教学告警输出的场景使用：
/// - “事后重放”（如诊断列映射重建）：此前已对同一源码执行过完整管线
///   （写盘转译）并输出过教学告警，重放只为取 `管线映射`；
/// - 调用方需要带文件归属输出告警（如 CLI 多文件项目按文件名前缀输出）。
///
/// 除教学告警外，输出与 [`转译管线`] 完全一致。
公开 函数 转译管线静默(
    源码: &文本,
    映射管理器: &映射管理::映射管理器,
) -> 缓存::转译产出 {
    管线内部执行(源码, 映射管理器, 无, 无, 假)
}

/// 同 [`转译管线静默`]，附项目级声明上下文（跨文件声明豁免）
///
/// CLI 多文件项目中项目内文件与诊断重放的转译入口：项目上下文由调用方
/// 预先收集（见 [`别名替换::项目上下文::自源文件新建`]），与入口文件共享。
公开 函数 转译管线静默并项目(
    源码: &文本,
    映射管理器: &映射管理::映射管理器,
    项目上下文: 选项<&别名替换::项目上下文>,
) -> 缓存::转译产出 {
    管线内部执行(源码, 映射管理器, 无, 项目上下文, 假)
}

/// 同 [`转译管线`]，附项目级声明上下文（跨文件声明豁免）
///
/// 供无缓存场景的调用方使用；带缓存的入口见 [`源码转译并项目`]。
公开 函数 转译管线并项目(
    源码: &文本,
    映射管理器: &映射管理::映射管理器,
    项目上下文: 选项<&别名替换::项目上下文>,
) -> 缓存::转译产出 {
    管线内部执行(源码, 映射管理器, 无, 项目上下文, 真)
}

/// 同 [`转译管线`]，支持 LSP 虚拟项目的 `包::` 前缀重写
///
/// `module_names` 为 有值 时，在模块路径替换后、别名替换前，为已知模块路径段
/// 添加 `包::` 前缀（跨文件引用，见 [`模块路径::模块路径限定并映射`]）。
/// CLI 等非虚拟项目场景传 无 保持原有行为。
///
/// 返回的 `管线映射` 以母语源偏移升序记录全部替换（replacement 为最终输出文本），
/// 是列映射等消费方的唯一规则来源——消费方无需复刻任何转译判定。
公开 函数 转译管线并映射(
    源码: &文本,
    映射管理器: &映射管理::映射管理器,
    模块名集: 选项<&哈希集合<字符串>>,
) -> 缓存::转译产出 {
    管线内部执行(源码, 映射管理器, 模块名集, 无, 真)
}

/// 同 [`转译管线并映射`]，附项目级声明上下文（LSP 虚拟项目）
///
/// LSP 跨文件场景与 CLI 同源：项目上下文（模块名与声明名）与 `包::`
/// 前缀重写共同保证跨文件引用的成员在调用侧与声明侧行为一致。
公开 函数 转译管线并映射并项目(
    源码: &文本,
    映射管理器: &映射管理::映射管理器,
    模块名集: 选项<&哈希集合<字符串>>,
    项目上下文: 选项<&别名替换::项目上下文>,
) -> 缓存::转译产出 {
    管线内部执行(源码, 映射管理器, 模块名集, 项目上下文, 真)
}

/// 转译管线的唯一实现：`发出教学告警` 控制教学告警日志的开关
函数 管线内部执行(
    源码: &文本,
    映射管理器: &映射管理::映射管理器,
    模块名集: 选项<&哈希集合<字符串>>,
    项目上下文: 选项<&别名替换::项目上下文>,
    发出教学告警: 布尔,
) -> 缓存::转译产出 {
    如果 发出教学告警 {
        // 词法处理前的 Unicode 混淆安全检查（零宽/双向/同形字符，仅告警）
        对于 混淆警告 在 混淆字符::检查混淆字符(源码) {
            包::警告日志!("unicode_confusion", "{}", 混淆警告.格式化输出());
        }
        // 全角标点教学检查（中文输入法常见错误：代码位置的全角标点，仅告警不阻断）；
        // 字符串/注释内的全角标点合法，由扫描器自动跳过
        对于 标点警告 在 全角标点::查找全角标点(源码) {
            包::警告日志!("fullwidth", "{}", 标点警告.格式化输出());
        }
        // 教学 lint（初学者代码风格提示，仅告警不阻断）：未标注类型/魔法数字/嵌套过深/易混方法名。
        // CLI `--no-lint` 可关闭（教学检查::设定教学检查开关），
        // 供项目开发（非教学）场景静默刷屏提示
        如果 教学检查::教学检查开关() {
            对于 风格警告 在 教学检查::执行教学检查并词表(
                源码,
                映射管理器.取教学检查词(),
                &映射管理器.歧义构造词集(),
            ) {
                包::警告日志!("lint", "{}", 风格警告.格式化提示());
            }
        }
    }

    让 宏映射表 = 映射管理器.取宏映射表();
    让 派生映射表 = 映射管理器.取派生映射表();
    让 词法 = 词法::词法转译并映射(
        源码,
        映射管理器.取关键词映射表(),
        宏映射表,
        派生映射表,
        映射管理器.取使用延迟词(),
        映射管理器.取方法延迟词(),
        映射管理器.取别名映射表(),
    );

    // 阶段 2：use 语句路径替换
    让 模块路径结果 = 如果 映射管理器.模块路径映射表.是否为空() {
        模块路径::替换结果 {
            产出: 词法.产出.克隆值(),
            编辑表: 向量::新建(),
        }
    } 否则 {
        模块路径::模块路径替换并映射(&词法.产出, 映射管理器.取模块路径映射表())
    };
    // 阶段 3（可选）：`包::` 前缀重写（LSP 虚拟项目跨文件引用）；
    // 项目项名集合供 glob 导入场景的遮蔽豁免（无项目上下文时传空集）
    让 前缀结果 = 如果 让 有值(名字集) = 模块名集
        && !名字集.是否为空()
    {
        让 空项集 = 哈希集合::新建();
        让 项名集 = 项目上下文.变换(|前索引| &前索引.项名集).解包或用(&空项集);
        模块路径::模块路径限定并映射(&模块路径结果.产出, 名字集, 项名集)
    } 否则 {
        模块路径::替换结果 {
            产出: 模块路径结果.产出.克隆值(),
            编辑表: 向量::新建(),
        }
    };
    // 阶段 4：标识符别名替换（声明位保护 + 项目级声明上下文）；
    // 附模块路径表：use 之外的路径根位模块词（`异步运行时::睡眠`、
    // `#[异步运行时::主函数]`）在别名阶段回退模块路径表完成转译
    让 别名结果 = 如果 映射管理器.别名映射表.是否为空() && 映射管理器.模块路径映射表.是否为空() {
        别名替换::替换结果 {
            产出: 前缀结果.产出.克隆值(),
            编辑表: 向量::新建(),
        }
    } 否则 {
        别名替换::替换别名并上下文并模块路径(
            &前缀结果.产出,
            映射管理器.取别名映射表(),
            映射管理器.取模块路径映射表(),
            项目上下文,
        )
    };

    // 组合各阶段编辑表为母语源坐标的全管线地图（replacement 取最终输出文本）
    让 阶段表: 向量<&[缓存::源映射条目]> =
        向量![&词法.最终编辑表, &模块路径结果.编辑表, &前缀结果.编辑表, &别名结果.编辑表];
    让 管线地图 = 组合管线地图(源码, &阶段表);

    缓存::转译产出::附带全映射(别名结果.产出, 词法.源映射, 管线地图)
}

/// 合并各阶段编辑表为母语源坐标的最终编辑地图
///
/// `stages[0]`（词法）的编辑已直接以母语源偏移记录；后续阶段的编辑以各自
/// 输入文本偏移记录，需经逆映射链换算回母语源偏移。`original/length`
/// 一律以母语源文本为准（后续阶段替换的 token 未被前置阶段改写，长度一致）。
/// 同一源偏移出现多条编辑时保留最后阶段（后写覆盖先写，按阶段顺序稳定排序）。
函数 组合管线地图(
    源码: &文本,
    阶段表: &[&[缓存::源映射条目]],
) -> 向量<缓存::源映射条目> {
    让 可变 合并结果: 向量<缓存::源映射条目> = 向量::新建();
    对于 (阶段号, 编辑集) 在 阶段表.迭代().枚举() {
        对于 编辑 在 编辑集.迭代() {
            让 母语偏移 = 如果 阶段号 == 0 {
                编辑.源偏移
            } 否则 {
                // 逆映射链：从 stage_idx-1 阶段往回推到母语源坐标
                让 可变 偏移 = 编辑.源偏移;
                对于 前置 在 阶段表[..阶段号].迭代().逆序() {
                    偏移 = 逆映射偏移(前置, 偏移);
                }
                偏移
            };
            // original/length 以母语源文本为准。
            // 注意：非第 0 阶段的 错误值.字节长度 处于该阶段输入坐标，未必等于母语源坐标长度；
            // 这里把起止偏移都夹到母语源文本的合法字符边界，避免多字节字符（如日本語の
            // メソッド名 `から`）切片越界引发 崩溃。transpile 输出本身不受影响。
            让 源长 = 源码.元素数();
            让 起点原始 = 母语偏移.最小值(源长);
            让 终点原始 = (母语偏移 + 编辑.字节长度).最小值(源长);
            让 起点 = {
                让 可变 字符串项 = 起点原始;
                当 字符串项 < 源长 && !源码.是字符边界(字符串项) {
                    字符串项 += 1;
                }
                字符串项
            };
            让 可变 终点 = 终点原始;
            当 终点 > 起点 && !源码.是字符边界(终点) {
                终点 -= 1;
            }
            让 原文 = &源码[起点..终点];
            合并结果.推入(缓存::源映射条目::新建条目(
                母语偏移,
                编辑.字节长度,
                原文,
                &编辑.替换文本,
            ));
        }
    }
    // 稳定排序：同偏移多条编辑时，阶段靠后的保持在后（最终消费取后者）
    合并结果.按键排序(|编辑| 编辑.源偏移);
    // 同偏移去重：保留最后一条（阶段靠后的替换即为最终输出文本）
    让 可变 无重复结果: 向量<缓存::源映射条目> = 向量::带容量(合并结果.元素数());
    对于 编辑 在 合并结果 {
        如果 让 有值(末条) = 无重复结果.最后一个_mut()
            && 末条.源偏移 == 编辑.源偏移
        {
            *末条 = 编辑;
        } 否则 {
            无重复结果.推入(编辑);
        }
    }
    无重复结果
}

/// 逆映射：把"上一阶段输出坐标"的偏移映射回"上一阶段输入坐标"
///
/// edits 按 input_offset 升序、互不重叠（每个被替换 token 一条）。
/// 落在替换区间内的偏移返回 token 起点（token 级边界近似——列映射在
/// token 起点记录分段点，区间内位置近似映射到起点即可）。
函数 逆映射偏移(编辑集: &[缓存::源映射条目], 输出偏移: 无符号机器整数) -> 无符号机器整数 {
    让 可变 输入游标 = 0usize;
    让 可变 输出游标 = 0usize;
    对于 编辑 在 编辑集 {
        让 间隙 = 编辑.源偏移 - 输入游标; // 输入侧未替换区间
        如果 输出偏移 <= 输出游标 + 间隙 {
            返回 输入游标 + (输出偏移 - 输出游标);
        }
        输出游标 += 间隙;
        如果 输出偏移 < 输出游标 + 编辑.替换文本.元素数() {
            返回 编辑.源偏移; // 替换区间内：token 起点近似
        }
        输出游标 += 编辑.替换文本.元素数();
        输入游标 = 编辑.源偏移 + 编辑.字节长度;
    }
    输入游标 + (输出偏移 - 输出游标)
}

#[配置(测试)]
模块 单元测试 {
    使用 超级::*;
    使用 标准库::集合::哈希映射;

    函数 建管理器() -> 映射管理::映射管理器 {
        让 关键词文本 = r#"
["声明"]
"函数" = "fn"
"让" = "let"
"枚举" = "enum"
["类型"]
"整数" = "i32"
["宏"]
"打印行" = "println"
"文件" = "file"
["标准库成员"]
"迭代" = "iter"
"#;
        让 模块路径文本 = r#"
["模块路径"]
"标准集合" = "std::collections"
"#;
        让 标准库文本 = r#"
["模块路径"]
"线程" = "std::thread"
["标识符"]
"字符串" = "String"
"枚举" = "enumerate"
"#;
        让 三方数据 = [(
            "测试库.toml",
            r#"
["模块路径"]
"网络库" = "netlib"
["标识符"]
"服务器" = "Server"
"#,
        )];
        映射管理::映射管理器::自内置加载(
            关键词文本,
            模块路径文本,
            标准库文本,
            &三方数据,
        )
        .期望("创建测试管理器失败")
    }

    函数 新缓存() -> 缓存::转译缓存 {
        // 测试中抑制日志输出（默认级别为警告，信息级会被过滤）
        日志::静默日志();
        缓存::转译缓存::默认容量新建()
    }

    #[测试]
    函数 测试完整管线与增量缓存() {
        让 映射管理器 = 建管理器();
        让 可变 缓存表 = 新缓存();
        让 源码 = "函数 主函数() { 让 数量: 整数 = 5; 打印行(\"你好\") }";

        让 首次 = 源码转译(源码, &映射管理器, &可变 缓存表).期望("翻译失败");
        让 二次 = 源码转译(源码, &映射管理器, &可变 缓存表).期望("翻译失败");

        // 输出一致且包含各阶段替换结果（词法 + 模块路径 + 别名）
        断言相等!(首次, 二次);
        断言!(
            首次.包含("fn 主函数() { let 数量: i32 = 5; println!(\"你好\") }"),
            "实际输出：{}",
            首次
        );

        // 第二次调用命中缓存：条数 1、未命中 1 次、命中 1 次
        断言相等!(缓存表.条目数目(), 1);
        断言相等!(缓存表.缺失数目(), 1);
        断言相等!(缓存表.命中数目(), 1);
        断言相等!(缓存表.命中率数值(), 0.5);
    }

    #[测试]
