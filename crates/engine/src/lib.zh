        源码转译("函数 主函数() { 让 x = 1; }", &映射管理器, &可变 缓存表).期望("翻译失败");
        源码转译("函数 主函数() { 让 x = 2; }", &映射管理器, &可变 缓存表).期望("翻译失败");

