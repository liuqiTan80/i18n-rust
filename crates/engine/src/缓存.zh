//! 翻译缓存模块【zh 自举·批次1】
//! 本文件是源真相：由引导 rzc 转译为 缓存.rs 后交 cargo 编译。
//! 再生成方式见 tools/zh-selfhost/regen.sh；请勿手改同目录下的 缓存.rs。
//!
//! 基于内容哈希的增量翻译缓存。
//! 内容未变化且语言包映射未变化时直接复用翻译结果，避免重复翻译；
//! 同时缓存源映射（被替换标识符的源偏移与替换文本），供 LSP/调试使用。
//!
//! 注：模块路径保持英文 `cache`（被 engine/cli/lsp 61 处 `缓存::` 按名调用，
//! 属跨 包 稳定 ABI）；公开类型/方法/字段（源映射条目/转译产出/
//! 转译缓存 及 源偏移/original/output/源映射/管线映射 等）
//! 同为 LSP 依赖的数据契约，保持英文。`serde`/`JSON序列化`/`标准库::文件系统`/`标准库::输入输出`/
//! `临时文件`/`路径类型`/`无符号机器整数`/`浮点数`/`消费闭包特征` 及无干净词条的方法链（转为字节/
//! 溢出乘/推入尾部/弹出头部/获取可变/移除/清空/获取并修改/加载/取条目 链/
//! 连接/排序/而后映射/带容量 等）按英文透传（rzc 合法特性）；
//! 内部类型、私有方法、局部变量、控制流与测试均已中文化。

使用 包::转译错误;
使用 序列化::{可反序列化, 可序列化};
使用 标准库::集合::{哈希映射, 哈希集合, 双向队列};
使用 标准库::路径::{路径类型, 路径缓冲};
使用 标准库::同步::原子::{内存顺序, 原子u64};

/// 源映射条目：输入文本中一个被替换的标识符 token
///
/// 记录输入侧信息（字节偏移、长度）与翻译前后文本；
/// 不提供目标偏移——完整管线后续的模块路径替换/别名替换会改变输出偏移，
/// 输入侧信息始终保持精确。
/// 语义按使用场景分两级：
/// - 词法阶段 `源映射`：偏移为母语源坐标，replacement 为词法阶段文本；
/// - 全管线 `管线映射`：偏移为母语源坐标，replacement 为**最终输出文本**；
/// - 各中间阶段 `_with_map` 的 edits：偏移为该阶段输入文本坐标。
#[派生(调试, 克隆, 部分相等, 相等, 可序列化, 可反序列化)]
公开 结构体 源映射条目 {
    /// 源文件中的字节偏移（token 起点）
    公开 源偏移: 无符号机器整数,
    /// token 字节长度
    公开 字节长度: 无符号机器整数,
    /// 源 token 文本（如 `函数`）
    公开 原文: 字符串,
    /// 翻译后文本（如 `fn`）
    公开 替换文本: 字符串,
}

实现 源映射条目 {
    公开 函数 新建条目(源偏移: 无符号机器整数, 字节长度: 无符号机器整数, 原文: &文本, 替换文本: &文本) -> 自身 {
        自身 {
            源偏移,
            字节长度,
            原文: 原文.转字符串(),
            替换文本: 替换文本.转字符串(),
        }
    }
}

/// 翻译产物：翻译后的代码、词法阶段源映射与全管线编辑地图
#[派生(调试, 克隆, 部分相等, 可序列化, 可反序列化)]
公开 结构体 转译产出 {
    /// 翻译后的代码文本
    公开 产出: 字符串,
    /// 词法阶段源映射（向后兼容：仅含词法阶段的替换，replacement 为词法阶段文本）
    公开 源映射: 向量<源映射条目>,
    /// 全管线编辑地图：以母语源偏移升序记录，replacement 为**最终输出文本**
    ///（宏调用自动补充的 `!` 已计入 replacement）。
    /// 列映射等消费方只需回放此表，无需复刻任何转译规则。
    公开 管线映射: 向量<源映射条目>,
}

实现 转译产出 {
    /// 仅创建输出（无源映射）
    公开 函数 新建产出(产出: 字符串) -> 自身 {
        自身 {
            产出,
            源映射: 向量::新建(),
            管线映射: 向量::新建(),
        }
    }

    /// 创建输出并附带词法阶段源映射
    公开 函数 附带源映射(产出: 字符串, 源映射: 向量<源映射条目>) -> 自身 {
        自身 {
            产出,
            源映射,
            管线映射: 向量::新建(),
        }
    }

    /// 创建输出并附带词法阶段源映射与全管线编辑地图
    公开 函数 附带全映射(
        产出: 字符串,
        源映射: 向量<源映射条目>,
        管线映射: 向量<源映射条目>,
    ) -> 自身 {
        自身 {
            产出,
            源映射,
            管线映射,
        }
    }
}

/// 缓存条目：内容哈希 → 条目
#[派生(调试, 克隆)]
结构体 缓存条目 {
    /// 源内容字节长度（哈希冲突时的廉价校验）
    内容长度: 无符号机器整数,
    /// 翻译语境指纹（语言包映射内容变化时指纹变化，缓存自动失效）
    语境指纹: 无符号长整数,
    /// 缓存的翻译产物
    产物: 转译产出,
}

/// 基于内容哈希的 LRU 翻译缓存
///
/// - 键：内容 FNV-1a 64 位哈希（附长度校验，降低冲突风险）
/// - 值：翻译产物（输出 + 源映射）
/// - 语境指纹：关键字/模块路径/标识符别名映射内容的哈希，
///   语言包更新后旧缓存自动失效，保证翻译结果与映射一致
/// - 淘汰策略：LRU（最近最少使用），容量可配置
///
/// 统计计数用 [`原子u64`]，类型满足 `Send + Sync`，
/// 可置于 `Mutex`/`RwLock` 后在多线程间共享（如并行转译项目文件）。
公开 结构体 转译缓存 {
    条目表: 哈希映射<无符号长整数, 缓存条目>,
    /// LRU 顺序：队首最旧、队尾最新；每个条目附带代际计数器，
    /// `标记命中` 递增代际并在队尾添加新条目，旧代际条目在淘汰时惰性跳过
    访问队列: 双向队列<(无符号长整数, 无符号长整数)>,
    /// 每个哈希的当前代际：与队列条目的代际匹配时为有效条目
    代际表: 哈希映射<无符号长整数, 无符号长整数>,
    容量: 无符号机器整数,
    命中计数: 原子u64,
    未命中计数: 原子u64,
    /// 磁盘持久化路径：有值 时由 [`转译缓存::flush`] 原子写盘
    ///（跨进程复用：CLI 短命进程把上次运行的翻译结果留给下次）
    持久化路径: 选项<路径缓冲>,
    /// 待写盘标记：变更后置位，[`转译缓存::flush`] 成功写盘后清除。
    ///
    /// 不每次变更都写盘的原因：`save` 会把**整个**缓存序列化为 JSON，
    /// 批量转译 N 个文件（各自 miss 后插入）会产生 N 次全量写，
    /// 且这些写发生在调用方持有缓存的临界区内，把并行转译串行化。
    /// 改为累积变更、批量一次写盘（进程退出由 `Drop` 兜底，不丢数据）。
    待写盘: 布尔,
}

/// 退出兜底：保证累积的未写盘变更不丢失（正常路径无需显式 `flush`）
实现 可丢弃 对于 转译缓存 {
    函数 丢弃(&可变 自我) {
        自我.刷盘();
    }
}

/// 磁盘持久化文件格式（版本不匹配/解析失败时静默丢弃，回退内存缓存）
#[派生(可序列化, 可反序列化)]
结构体 持久化缓存文件 {
    /// 格式版本：结构变更时递增，旧版本文件直接丢弃
    格式版本: 无符号整数,
    /// LRU 顺序（旧→新）；加载时按序重建代际队列
    条目列表: 向量<持久化条目>,
}

/// 磁盘上的单个缓存条目（结构与内存条目对应）
#[派生(可序列化, 可反序列化)]
结构体 持久化条目 {
    哈希值: 无符号长整数,
    内容长度: 无符号机器整数,
    语境指纹: 无符号长整数,
    产物: 转译产出,
}

/// 当前持久化格式版本
常量 持久化格式版本: 无符号整数 = 1;

/// 持久化缓存的默认容量（磁盘缓存面向多项目，比内存默认稍大）
常量 持久化容量: 无符号机器整数 = 512;

实现 转译缓存 {
    /// 新建缓存（容量至少为 1）
    公开 函数 新建缓存(容量: 无符号机器整数) -> 自身 {
        自身 {
            条目表: 哈希映射::新建(),
            访问队列: 双向队列::新建(),
            代际表: 哈希映射::新建(),
            容量: 容量.最大值(1),
            命中计数: 原子u64::新建(0),
            未命中计数: 原子u64::新建(0),
            持久化路径: 无,
            待写盘: 假,
        }
    }

    /// 默认容量：256 个文件条目
    公开 函数 默认容量新建() -> 自身 {
        自身::新建缓存(256)
    }

    /// 带磁盘持久化的缓存：从 `路径模块` 加载既有条目（尽力而为：文件不存在、
    /// 版本不匹配、JSON 损坏时静默回退为空缓存），此后变更累积、由
    /// [`自身::flush`] 批量写盘（进程退出由 `Drop` 兜底）。
    ///
    /// 跨进程增量复用场景（如 CLI 每次运行都是新进程）：上次运行转译过的
    /// 文件内容未变时直接命中，省去整条转译管线（Unicode/全角/lint 检查 + 词法）。
    公开 函数 启用持久化(磁盘路径: &路径类型) -> 自身 {
        让 可变 缓存 = 自身::新建缓存(持久化容量);
        如果让 成功(字节串) = 标准库::文件系统::读取(磁盘路径)
            && 让 成功(磁盘文件) = JSON序列化::从切片构造::<持久化缓存文件>(&字节串)
        {
            如果 磁盘文件.格式版本 == 持久化格式版本 {
                缓存.重建自磁盘(磁盘文件.条目列表);
            } 否则 {
                // 版本不匹配或结构损坏：丢弃旧文件（下次插入时重建）
                包::警告日志!(
                    "translation_cache",
                    "{}（{}）",
                    包::语言::查句("log_cache_disk_discard"),
                    磁盘路径.展示()
                );
            }
        }
        // 文件不存在：首次使用，属正常路径，保持空缓存
        缓存.持久化路径 = 有值(磁盘路径.转路径缓冲());
        缓存
    }

    /// 默认位置的持久化缓存：`~/.rz/cache/transpile-v1.json`
    ///（与工具链/语言包同根，见 [`包::工具链::安装根目录`]）
    公开 函数 持久默认项() -> 自身 {
        让 磁盘路径 = 包::工具链::安装根目录()
            .连接("cache")
            .连接("transpile-v1.json");
        自身::启用持久化(&磁盘路径)
    }

    /// 显式写盘（幂等；无持久化路径时为空操作）
    公开 函数 存盘(&自我, 磁盘路径: &路径类型) -> 标准库::输入输出::IO结果<()> {
        让 磁盘文件 = 持久化缓存文件 {
            格式版本: 持久化格式版本,
            条目列表: 自我.导出条目(),
        };
        让 字节串 = JSON序列化::到向量(&磁盘文件)?;
        // 父目录可能不存在（首次运行 ~/.rz/cache/ 未创建）：先建目录再写
        如果让 有值(上级目录) = 磁盘路径.父目录() {
            标准库::文件系统::递归创建目录(上级目录)?;
        }
        // 原子写：临时文件 + 重命名，避免进程中断留下半截 JSON
        让 临时 = 磁盘路径.设扩展名("json.tmp");
        标准库::文件系统::写入(&临时, &字节串)?;
        标准库::文件系统::重命名(&临时, 磁盘路径)?;
        成功(())
    }

    /// 批量写盘：有待写变更且绑定了持久化路径时写盘一次（幂等，无变更时空操作）。
    ///
    /// 批量转译场景应在全部文件处理完后调用一次（而非每个文件一次）：
    /// [`自身::save`] 会序列化整个缓存，逐次写盘会把并行转译串行化。
    /// 进程退出时由 `Drop` 兜底调用，正常路径无需显式调用。
    公开 函数 刷盘(&可变 自我) {
        如果 !自我.待写盘 {
            返回;
        }
        让 有值(磁盘路径) = 自我.持久化路径.克隆() 否则 {
            // 无持久化路径：变更无需落盘，标记清零避免无谓重试
            自我.待写盘 = 假;
            返回;
        };
        匹配 自我.存盘(&磁盘路径) {
            成功(()) => 自我.待写盘 = 假,
            // 写失败：保留 待写盘 以便后续（含 Drop）重试；缓存丢失可接受，不阻断转译
            错误(错误值) => 包::警告日志!(
                "translation_cache",
                "{}（{}）",
                包::语言::查句("log_cache_disk_save_failed"),
                错误值
            ),
        }
    }

    /// 从磁盘条目重建内存 LRU 结构（条目按旧→新顺序导入，代际队列保持一致）
    函数 重建自磁盘(&可变 自我, 磁盘条目: 向量<持久化条目>) {
        对于 条目项 在 磁盘条目 {
            让 哈希值 = 条目项.哈希值;
            让 代际 = 自我.代际表.条目(哈希值).或插入(0);
            自我.访问队列.推入尾部((哈希值, *代际));
            自我.条目表.插入(
                哈希值,
                缓存条目 {
                    内容长度: 条目项.内容长度,
                    语境指纹: 条目项.语境指纹,
                    产物: 条目项.产物,
                },
            );
        }
        包::信息日志!(
            "translation_cache",
            "{}",
            包::语言::查译("log_cache_disk_loaded", &[&自我.条目表.长度().转字符串()])
        );
    }

    /// 按 LRU 顺序（旧→新）导出全部有效条目
    函数 导出条目(&自我) -> 向量<持久化条目> {
        让 可变 列表 = 向量::带容量(自我.条目表.长度());
        对于 (哈希值, 代际) 在 &自我.访问队列 {
            如果 自我.代际表.截取(哈希值) != 有值(代际) {
                继续; // 过时代际条目：惰性跳过
            }
            如果让 有值(条目项) = 自我.条目表.截取(哈希值) {
                列表.推入(持久化条目 {
                    哈希值: *哈希值,
                    内容长度: 条目项.内容长度,
                    语境指纹: 条目项.语境指纹,
                    产物: 条目项.产物.克隆(),
                });
            }
        }
        列表
    }

    /// FNV-1a 64 位哈希（无第三方依赖，速度快，适合缓存键）
    公开 函数 计算内容哈希(内容: &文本) -> 无符号长整数 {
        让 可变 哈希值 = 0xcbf29ce484222325u64;
        对于 字节值 在 内容.转为字节() {
            哈希值 ^= *字节值 作为 无符号长整数;
            哈希值 = 哈希值.溢出乘(0x100000001b3);
        }
        哈希值
    }

    /// 生成翻译语境指纹：任一映射表内容变化或引擎源码变化时指纹变化
    ///
    /// 基于排序后的键值对拼接哈希，与映射表的插入顺序无关。
    ///
    /// 四张表全部参与：关键字、模块路径、别名、派生特征。
    /// 派生特征表由 `映射管理器` 从「派生特征」节单独存放（不并入
    /// 关键词映射表，避免与方法名别名冲突），若漏算会导致只改派生表时
    /// 指纹不变、缓存返回旧转译产物。
    /// 另混入引擎源码指纹（build.rs 对 src/ 全量生成）：缓存不仅须跟随
    /// 语言包映射变化，也须跟随转译算法变化——否则升级 rzc 后（算法修复/
    /// 调整），源文件未变时旧缓存仍命中、修复不生效（真实事故：别名替换
    /// 细则修复后，旧转译产物继续被复用）。
    公开 函数 生成语境指纹(
        关键字表: &哈希映射<字符串, 字符串>,
        模块路径表: &哈希映射<字符串, 字符串>,
        别名表: &哈希映射<字符串, 字符串>,
        派生表: &哈希映射<字符串, 字符串>,
    ) -> 无符号长整数 {
        让 可变 配对: 向量<字符串> = 向量::新建();
        // 引擎源码指纹：转译算法自身的身份，算法代码变化即失效全部缓存
        配对.推入(格式化!(
            "engine-source:{:#x}",
            包::语言::ENGINE_SOURCE_FINGERPRINT
        ));
        对于 映射表 在 [关键字表, 模块路径表, 别名表, 派生表] {
            对于 (键名, 值项) 在 映射表 {
                // 长度前缀 + NUL 定界：键/值中出现任意字符（含 `=`、`\0`）
                // 都不会产生歧义（`"a=b"/"c"` 与 `"a"/"b=c"` 若用 `=`
                // 拼接会生成相同指纹，缓存语境误判为未变化）
                配对.推入(格式化!("{}:{}\0{}", 键名.长度(), 键名, 值项));
            }
        }
        配对.排序();
        自身::计算内容哈希(&配对.连接("\n"))
    }

    /// 组合语言包语境指纹与项目上下文指纹为最终缓存指纹
    ///
    /// 不用异或：异或满足交换律（`(测试甲, 测试乙)` 与 `(测试乙, 测试甲)` 不可区分），且
    /// `无` 与「项目指纹恰为 0」的组合结果相同，会把「无项目上下文」与
    /// 「项目上下文指纹为 0」混为一谈而错误复用缓存。此处对 `无`/`有值`
    /// 使用显式标签，并用无歧义定界拼接后走稳定哈希（FNV-1a，跨进程一致，
    /// 与 [`自身::生成语境指纹`] 同一算法，便于磁盘缓存比对）。
    公开 函数 合并语境指纹(管理器指纹: 无符号长整数, 项目指纹: 选项<无符号长整数>) -> 无符号长整数 {
        让 项目段 = 匹配 项目指纹 {
            有值(指纹值) => 格式化!("project:{指纹值:#x}"),
            无 => "project:none".转字符串(),
        };
        自身::计算内容哈希(&格式化!("{管理器指纹:#x}\n{项目段}"))
    }

    /// 查询缓存（计数命中/未命中；不更新 LRU 顺序）
    ///
    /// 命中条件：内容哈希一致、内容长度一致、语境指纹一致。
    公开 函数 检索(&自我, 内容: &文本, 语境指纹: 无符号长整数) -> 选项<&转译产出> {
        让 哈希值 = 自身::计算内容哈希(内容);
        匹配 自我.条目表.截取(&哈希值) {
            有值(条目项)
                如果 条目项.内容长度 == 内容.长度()
                    && 条目项.语境指纹 == 语境指纹 =>
            {
                自我.命中计数.获取并修改(1, 内存顺序::松弛序);
                有值(&条目项.产物)
            }
            _ => {
                自我.未命中计数.获取并修改(1, 内存顺序::松弛序);
                无
            }
        }
    }

    /// 插入缓存条目（同哈希存在时覆盖并视为最近使用；超容量淘汰最旧条目）
    公开 函数 写入缓存(&可变 自我, 内容: &文本, 语境指纹: 无符号长整数, 产物: 转译产出) {
        让 哈希值 = 自身::计算内容哈希(内容);
        自我.插入预计算(哈希值, 内容.长度(), 语境指纹, 产物);
    }

    /// 获取或翻译：命中则直接返回缓存产物，未命中则执行翻译闭包并写入缓存
    ///
    /// 翻译闭包返回 `IO结果`，失败时错误透传、不写入缓存。
    公开 函数 检索或转译<闭包类型>(
        &可变 自我,
        内容: &文本,
        语境指纹: 无符号长整数,
        转译闭包: 闭包类型,
    ) -> 结果<转译产出, 转译错误>
    哪里
        闭包类型: 消费闭包特征() -> 结果<转译产出, 转译错误>,
    {
        // 预计算哈希一次（旧实现 miss 路径计算两次）
        让 哈希值 = 自身::计算内容哈希(内容);
        // 内联查询逻辑，避免 `检索()` 重复计算哈希
        让 缓存命中 = 匹配 自我.条目表.截取(&哈希值) {
            有值(条目项)
                如果 条目项.内容长度 == 内容.长度()
                    && 条目项.语境指纹 == 语境指纹 =>
            {
                自我.命中计数.获取并修改(1, 内存顺序::松弛序);
                有值(条目项.产物.克隆())
            }
            _ => {
                自我.未命中计数.获取并修改(1, 内存顺序::松弛序);
                无
            }
        };
        如果让 有值(产物) = 缓存命中 {
            包::信息日志!(
                "translation_cache",
                "{}",
                包::语言::查译(
                    "log_cache_hit",
                    &[&内容.长度().转字符串(), &语境指纹.转字符串()]
                )
            );
            自我.标记命中(哈希值);
            返回 成功(产物);
        }
        包::信息日志!(
            "translation_cache",
            "{}",
            包::语言::查译(
                "log_cache_miss",
                &[&内容.长度().转字符串(), &语境指纹.转字符串()]
            )
        );
        让 产物 = 转译闭包()?;
        自我.插入预计算(哈希值, 内容.长度(), 语境指纹, 产物.克隆());
        成功(产物)
    }

    /// 清空全部条目（统计计数保留；绑定持久化路径时同步清空磁盘文件）
    公开 函数 清空记录(&可变 自我) {
        自我.条目表.清空();
        自我.访问队列.清空();
        自我.代际表.清空();
        // 清空是显式破坏性操作，立即落盘（不等批量写盘）
        自我.待写盘 = 真;
        自我.刷盘();
    }

    /// 当前缓存条目数
    公开 函数 条目数目(&自我) -> 无符号机器整数 {
        自我.条目表.长度()
    }

    /// 缓存容量值
    公开 函数 容量数值(&自我) -> 无符号机器整数 {
        自我.容量
    }

    /// 累计命中次数
    公开 函数 命中数目(&自我) -> 无符号长整数 {
        自我.命中计数.加载(内存顺序::松弛序)
    }

    /// 累计未命中次数
    公开 函数 缺失数目(&自我) -> 无符号长整数 {
        自我.未命中计数.加载(内存顺序::松弛序)
    }

    /// 命中率（0.0 ~ 1.0；无查询记录时为 0.0）
    公开 函数 命中率数值(&自我) -> 浮点数 {
        让 命中读数 = 自我.命中计数.加载(内存顺序::松弛序);
        让 总数 = 命中读数 + 自我.未命中计数.加载(内存顺序::松弛序);
        如果 总数 == 0 {
            0.0
        } 否则 {
            命中读数 作为 浮点数 / 总数 作为 浮点数
        }
    }

    // ===== 内部实现 =====

    函数 插入预计算(
        &可变 自我,
        哈希值: 无符号长整数,
        内容长度: 无符号机器整数,
        语境指纹: 无符号长整数,
        产物: 转译产出,
    ) {
        如果让 有值(条目项) = 自我.条目表.获取可变(&哈希值) {
            // 同内容（含语境变化）覆盖，保持 LRU 位置为最新
            条目项.内容长度 = 内容长度;
            条目项.语境指纹 = 语境指纹;
            条目项.产物 = 产物;
            自我.标记命中(哈希值);
            // 覆盖也是内容变更：置脏（此前该路径不回写磁盘，磁盘副本会残留旧产物）
            自我.待写盘 = 真;
            返回;
        }
        自我.条目表.插入(
            哈希值,
            缓存条目 {
                内容长度,
                语境指纹,
                产物,
            },
        );
        让 代际 = 自我.代际表.条目(哈希值).或插入(0);
        自我.访问队列.推入尾部((哈希值, *代际));
        // 淘汰最旧有效条目（跳过代际不匹配的过时条目）
        当 自我.条目表.长度() > 自我.容量 {
            当让 有值((队首哈希, 队首代际)) = 自我.访问队列.弹出头部() {
                如果 自我.代际表.截取(&队首哈希) == 有值(&队首代际) {
                    // 代际匹配：这是有效条目，执行淘汰
                    自我.代际表.移除(&队首哈希);
                    自我.条目表.移除(&队首哈希);
                    包::调试日志!(
                        "translation_cache",
                        "{}",
                        包::语言::查译("log_cache_evict", &[&队首哈希.转字符串()])
                    );
                    中断;
                }
                // 代际不匹配：过时条目，惰性跳过
            }
        }
        // 标记待写盘：实际写盘由 `刷盘()` 批量执行（详见 `待写盘` 字段说明）
        自我.待写盘 = 真;
    }

    /// O(1) LRU 命中更新：递增代际并在队尾添加新条目，
    /// 旧代际条目留在队列中，淘汰时因代际不匹配被惰性跳过；
    /// 队列膨胀超过阈值（容量 4 倍，最少 64）时压缩，
    /// 防止长期运行（如 LSP 会话）下过时条目无限累积
    函数 标记命中(&可变 自我, 哈希值: 无符号长整数) {
        让 代际 = 自我.代际表.条目(哈希值).或插入(0);
        *代际 += 1;
        自我.访问队列.推入尾部((哈希值, *代际));
        如果 自我.访问队列.长度() > 自我.容量.饱和乘(4).最大值(64) {
            自我.压缩队列();
        }
    }

    /// 压缩 LRU 队列：从队尾（最新）向队首扫描，每个哈希只保留
    /// 最后一次访问的有效条目，其余过时条目全部移除
    ///（压缩后队列长度 ≤ 缓存条目数 ≤ 容量，淘汰逻辑照常工作）
    函数 压缩队列(&可变 自我) {
        让 可变 已见 = 哈希集合::新建();
        让 可变 压缩: 双向队列<(无符号长整数, 无符号长整数)> = 双向队列::带容量(自我.条目表.长度());
        对于 &(哈希值, 代际) 在 自我.访问队列.迭代器().逆序() {
            如果 已见.插入(哈希值) && 自我.代际表.截取(&哈希值) == 有值(&代际) {
                压缩.推入头部((哈希值, 代际));
            }
        }
        自我.访问队列 = 压缩;
    }
}

#[配置(测试)]
模块 单元测试 {
    使用 超级::*;

    函数 样本指纹() -> 无符号长整数 {
        转译缓存::计算内容哈希("测试语境")
    }

    函数 样本产物(后缀: &文本) -> 转译产出 {
        转译产出::新建产出(格式化!("翻译输出{}", 后缀))
    }

    #[测试]
    函数 内容哈希确定且可区分() {
        让 哈希1 = 转译缓存::计算内容哈希("函数 主函数() {}");
        让 哈希2 = 转译缓存::计算内容哈希("函数 主函数() {}");
        断言相等!(哈希1, 哈希2);
        断言不等!(
            哈希1,
            转译缓存::计算内容哈希("函数 主函数() { }")
        );
        断言不等!(转译缓存::计算内容哈希(""), 哈希1);
    }

    /// 组合指纹：`无` 与 `有值(0)` 必须区分（异或会把二者混为一谈）
    #[测试]
    函数 组合指纹区分无项目与零() {
        让 语言包 = 样本指纹();
        让 无项目 = 转译缓存::合并语境指纹(语言包, 无);
        让 零指纹项目 = 转译缓存::合并语境指纹(语言包, 有值(0));
        断言不等!(无项目, 零指纹项目, "无项目上下文不应与指纹为 0 的项目同键");
    }

    /// 组合指纹：区分不同项目上下文，且对同一输入稳定
    #[测试]
    函数 组合指纹区分项目() {
        让 语言包 = 样本指纹();
        让 甲 = 转译缓存::合并语境指纹(语言包, 有值(1));
        让 乙 = 转译缓存::合并语境指纹(语言包, 有值(2));
        断言不等!(甲, 乙);
        断言相等!(甲, 转译缓存::合并语境指纹(语言包, 有值(1)));
    }

    #[测试]
    函数 语境指纹与映射顺序无关() {
        让 测试甲 = 哈希映射::从([
            ("函数".转字符串(), "fn".转字符串()),
            ("让".转字符串(), "let".转字符串()),
        ]);
        让 测试乙 = 哈希映射::从([
            ("让".转字符串(), "let".转字符串()),
            ("函数".转字符串(), "fn".转字符串()),
        ]);
        让 空表 = 哈希映射::新建();
        断言相等!(
            转译缓存::生成语境指纹(&测试甲, &空表, &空表, &空表),
            转译缓存::生成语境指纹(&测试乙, &空表, &空表, &空表)
        );
        让 字符值 = 哈希映射::从([
            ("函数".转字符串(), "fn".转字符串()),
            ("让".转字符串(), "let".转字符串()),
            ("可变".转字符串(), "mut".转字符串()),
        ]);
        断言不等!(
            转译缓存::生成语境指纹(&测试甲, &空表, &空表, &空表),
            转译缓存::生成语境指纹(&字符值, &空表, &空表, &空表)
        );
    }

    /// 语境指纹须覆盖派生特征表
    ///
    /// 回归：指纹曾只算关键字 / 模块路径 / 别名三表，而「派生特征」节由
    /// `映射管理器` 单独存放（不并入 关键词映射表，避免与方法名别名冲突）。
    /// 只改派生表时指纹不变，缓存会返回旧转译产物。
    #[测试]
    函数 语境指纹覆盖派生表() {
        让 关键字 = 哈希映射::从([("函数".转字符串(), "fn".转字符串())]);
        让 空表 = 哈希映射::新建();
        让 派生甲 = 哈希映射::从([("克隆".转字符串(), "Clone".转字符串())]);
        让 派生乙 = 哈希映射::从([("克隆".转字符串(), "Debug".转字符串())]);

        // 仅派生表内容不同 → 指纹必须不同，否则缓存不会失效
        断言不等!(
            转译缓存::生成语境指纹(&关键字, &空表, &空表, &派生甲),
            转译缓存::生成语境指纹(&关键字, &空表, &空表, &派生乙)
        );
        // 派生表内容相同（与插入顺序无关）→ 指纹一致
        让 派生丙 = 哈希映射::从([("克隆".转字符串(), "Clone".转字符串())]);
        断言相等!(
            转译缓存::生成语境指纹(&关键字, &空表, &空表, &派生甲),
            转译缓存::生成语境指纹(&关键字, &空表, &空表, &派生丙)
        );
    }

    #[测试]
    函数 命中与未命中() {
        让 可变 缓存 = 转译缓存::新建缓存(8);
        让 指纹 = 样本指纹();
        让 内容 = "函数 主函数() {}";

        断言!(缓存.检索(内容, 指纹).是否为无());
        缓存.写入缓存(内容, 指纹, 样本产物("甲"));
        断言相等!(缓存.检索(内容, 指纹).解包().产出, "翻译输出甲");
        断言相等!(缓存.条目数目(), 1);
        断言相等!(缓存.命中数目(), 1);
        断言相等!(缓存.缺失数目(), 1);
        断言相等!(缓存.命中率数值(), 0.5);
    }

    #[测试]
    函数 内容变化导致未命中() {
        让 可变 缓存 = 转译缓存::新建缓存(8);
        让 指纹 = 样本指纹();
        缓存.写入缓存("函数 主函数() {}", 指纹, 样本产物("甲"));
        断言!(缓存.检索("函数 主函数() { 让 x = 1; }", 指纹).是否为无());
        断言相等!(缓存.条目数目(), 1);
        断言相等!(缓存.缺失数目(), 1);
    }

    #[测试]
    函数 语境变化使缓存失效() {
        让 可变 缓存 = 转译缓存::新建缓存(8);
        让 指纹1 = 转译缓存::计算内容哈希("语言包版本 1");
        让 指纹2 = 转译缓存::计算内容哈希("语言包版本 2");
        缓存.写入缓存("函数 主函数() {}", 指纹1, 样本产物("旧"));
        断言!(缓存.检索("函数 主函数() {}", 指纹2).是否为无());
        缓存.写入缓存("函数 主函数() {}", 指纹2, 样本产物("新"));
        断言相等!(
            缓存.检索("函数 主函数() {}", 指纹2).解包().产出,
            "翻译输出新"
        );
    }

    #[测试]
    函数 容量淘汰最旧() {
        让 可变 缓存 = 转译缓存::新建缓存(2);
        让 指纹 = 样本指纹();
        缓存.写入缓存("内容甲", 指纹, 样本产物("甲"));
        缓存.写入缓存("内容乙", 指纹, 样本产物("乙"));
        缓存.写入缓存("内容丙", 指纹, 样本产物("丙"));
        断言相等!(缓存.条目数目(), 2);
        断言!(缓存.检索("内容甲", 指纹).是否为无());
        断言!(缓存.检索("内容乙", 指纹).是否为有值());
        断言!(缓存.检索("内容丙", 指纹).是否为有值());
    }

    /// 大量命中后 LRU 队列必须压缩，不能随命中次数无限增长
    ///（长期运行如 LSP 会话下，过时条目累积是内存泄漏）
    #[测试]
    函数 大量命中后队列压缩() {
        让 可变 缓存 = 转译缓存::新建缓存(2);
        让 指纹 = 样本指纹();
        缓存.写入缓存("内容甲", 指纹, 样本产物("甲"));
        缓存.写入缓存("内容乙", 指纹, 样本产物("乙"));
        // 命中 100 次：队列越过压缩阈值（容量 4 倍、最少 64）后必须压缩回有界；
        // 无压缩机制时 100 次命中会积累到 102 条
        对于 _ 在 0..100 {
            缓存
                .检索或转译("内容甲", 指纹, || 成功(样本产物("甲")))
                .期望("翻译失败");
        }
        断言!(缓存.访问队列.长度() <= 64, "队列未压缩: {}", 缓存.访问队列.长度());
        // 压缩不影响 LRU 淘汰语义：再插入第三个条目，最旧的乙被淘汰
        缓存.写入缓存("内容丙", 指纹, 样本产物("丙"));
        断言!(缓存.检索("内容甲", 指纹).是否为有值());
        断言!(缓存.检索("内容乙", 指纹).是否为无());
        断言!(缓存.检索("内容丙", 指纹).是否为有值());
    }

    /// 键/值含 `=` 时指纹不得碰撞（旧实现用 `=` 拼接会产生歧义）
    #[测试]
    函数 指纹无分隔符碰撞() {
        让 空表 = 哈希映射::新建();
        让 测试甲 = 哈希映射::从([("a=b".转字符串(), "c".转字符串())]);
        让 测试乙 = 哈希映射::从([("a".转字符串(), "b=c".转字符串())]);
        断言不等!(
            转译缓存::生成语境指纹(&测试甲, &空表, &空表, &空表),
            转译缓存::生成语境指纹(&测试乙, &空表, &空表, &空表)
        );
    }

    #[测试]
    函数 命中刷新淘汰顺序() {
        让 可变 缓存 = 转译缓存::新建缓存(2);
        让 指纹 = 样本指纹();
        缓存.写入缓存("内容甲", 指纹, 样本产物("甲"));
        缓存.写入缓存("内容乙", 指纹, 样本产物("乙"));
        让 返回值 = 缓存
            .检索或转译("内容甲", 指纹, || 成功(样本产物("甲")))
            .期望("翻译失败");
        断言相等!(返回值.产出, "翻译输出甲");
        缓存.写入缓存("内容丙", 指纹, 样本产物("丙"));
        断言!(缓存.检索("内容甲", 指纹).是否为有值());
        断言!(缓存.检索("内容乙", 指纹).是否为无());
        断言!(缓存.检索("内容丙", 指纹).是否为有值());
    }

    #[测试]
    函数 获取或翻译闭包执行次数() {
        让 可变 缓存 = 转译缓存::默认容量新建();
        让 指纹 = 样本指纹();
        让 内容 = "函数 主函数() {}";
        让 可变 执行次数 = 0;

        让 第一次 = 缓存
            .检索或转译(内容, 指纹, || {
                执行次数 += 1;
                成功(样本产物("甲"))
            })
            .期望("翻译失败");
        断言相等!(第一次.产出, "翻译输出甲");
        断言相等!(执行次数, 1);

        让 第二次 = 缓存
            .检索或转译(内容, 指纹, || {
                执行次数 += 1;
                成功(样本产物("乙"))
            })
            .期望("翻译失败");
        断言相等!(第二次.产出, "翻译输出甲");
        断言相等!(执行次数, 1);
        断言相等!(缓存.命中数目(), 1);
        断言相等!(缓存.缺失数目(), 1);
    }

    #[测试]
    函数 获取或翻译错误透传() {
        让 可变 缓存 = 转译缓存::默认容量新建();
        让 指纹 = 样本指纹();
        让 内容 = "函数 主函数() {}";

        让 返回值 = 缓存.检索或转译(内容, 指纹, || {
            错误(转译错误::输入无效 {
                错误原因: "模拟失败".转字符串(),
            })
        });
        断言!(模式匹配!(返回值, 错误(转译错误::输入无效 { .. })));
        断言相等!(缓存.条目数目(), 0);
    }

    #[测试]
    函数 源映射条目() {
        让 条目项 = 源映射条目::新建条目(0, 6, "函数", "fn");
        断言相等!(条目项.源偏移, 0);
        断言相等!(条目项.字节长度, 6);
        断言相等!(条目项.原文, "函数");
        断言相等!(条目项.替换文本, "fn");
    }

    #[测试]
    函数 清空与统计() {
        让 可变 缓存 = 转译缓存::新建缓存(4);
        让 指纹 = 样本指纹();
        缓存.写入缓存("内容甲", 指纹, 样本产物("甲"));
        缓存.写入缓存("内容乙", 指纹, 样本产物("乙"));
        断言相等!(缓存.条目数目(), 2);
        缓存.清空记录();
        断言相等!(缓存.条目数目(), 0);
        断言相等!(缓存.容量数值(), 4);
        断言相等!(缓存.命中率数值(), 0.0);
    }

    #[测试]
    函数 容量至少为一() {
        让 缓存 = 转译缓存::新建缓存(0);
        断言相等!(缓存.容量数值(), 1);
    }

    // ===== 磁盘持久化 =====

    #[测试]
    函数 持久化往返() {
        让 目录 = 临时文件::建临时目录().期望("创建临时目录失败");
        让 磁盘路径 = 目录.路径模块().连接("transpile.json");
        让 指纹 = 样本指纹();

        // 第一次：插入只累积变更，写盘延迟到 flush（或进程退出时 Drop 兜底）
        {
            让 可变 缓存 = 转译缓存::启用持久化(&磁盘路径);
            缓存.写入缓存("函数 主函数() {}", 指纹, 样本产物("甲"));
            断言!(
                !磁盘路径.存在(),
                "插入不应立即写盘：批量转译下逐次全量写会把并行转译串行化"
            );
            缓存.刷盘();
            断言!(磁盘路径.存在(), "flush 后应落盘");
        }
        // 第二次（模拟新进程）：从磁盘加载，可直接命中
        {
            让 缓存 = 转译缓存::启用持久化(&磁盘路径);
            让 命中项 = 缓存.检索("函数 主函数() {}", 指纹);
            断言相等!(命中项.映射(|选项值| 选项值.产出.作为字符串()), 有值("翻译输出甲"));
            断言相等!(缓存.条目数目(), 1);
        }
    }

    #[测试]
    函数 持久化带完整地图() {
        让 目录 = 临时文件::建临时目录().期望("创建临时目录失败");
        让 磁盘路径 = 目录.路径模块().连接("transpile.json");
        让 指纹 = 样本指纹();
        让 产物 = 转译产出::附带全映射(
            "fn 主函数() {}".转字符串(),
            向量![源映射条目::新建条目(0, 6, "函数", "fn")],
            向量![源映射条目::新建条目(0, 6, "函数", "fn")],
        );
        {
            让 可变 缓存 = 转译缓存::启用持久化(&磁盘路径);
            缓存.写入缓存("函数 主函数() {}", 指纹, 产物);
        }
        让 缓存 = 转译缓存::启用持久化(&磁盘路径);
        让 命中项 = 缓存.检索("函数 主函数() {}", 指纹).期望("应命中");
        断言相等!(命中项.产出, "fn 主函数() {}");
        断言相等!(
            命中项.源映射,
            向量![源映射条目::新建条目(0, 6, "函数", "fn")]
        );
        断言相等!(命中项.管线映射.长度(), 1);
    }

    #[测试]
    函数 持久化版本不匹配丢弃() {
        让 目录 = 临时文件::建临时目录().期望("创建临时目录失败");
        让 磁盘路径 = 目录.路径模块().连接("transpile.json");
        标准库::文件系统::写入(&磁盘路径, r#"{"version": 999, "entries": []}"#).期望("写入旧版本文件");
        让 缓存 = 转译缓存::启用持久化(&磁盘路径);
        断言相等!(缓存.条目数目(), 0, "版本不匹配应丢弃");
    }

    #[测试]
    函数 持久化损坏文件丢弃() {
        让 目录 = 临时文件::建临时目录().期望("创建临时目录失败");
        让 磁盘路径 = 目录.路径模块().连接("transpile.json");
        标准库::文件系统::写入(&磁盘路径, "这不是 JSON{{{ 内容").期望("写入损坏文件");
        让 缓存 = 转译缓存::启用持久化(&磁盘路径);
        断言相等!(缓存.条目数目(), 0, "损坏文件应丢弃");
    }

    #[测试]
    函数 持久化清空写空文件() {
        让 目录 = 临时文件::建临时目录().期望("创建临时目录失败");
        让 磁盘路径 = 目录.路径模块().连接("transpile.json");
        让 指纹 = 样本指纹();
        {
            让 可变 缓存 = 转译缓存::启用持久化(&磁盘路径);
            缓存.写入缓存("内容甲", 指纹, 样本产物("甲"));
            缓存.清空记录();
        }
        让 缓存 = 转译缓存::启用持久化(&磁盘路径);
        断言相等!(缓存.条目数目(), 0, "清空后磁盘文件应同步为空");
    }

    #[测试]
    函数 持久化导出保留有效条目() {
        让 目录 = 临时文件::建临时目录().期望("创建临时目录失败");
        让 磁盘路径 = 目录.路径模块().连接("transpile.json");
        让 指纹 = 样本指纹();
        {
            // 容量 2：插入 3 条，最旧一条被淘汰
            让 可变 缓存 = 转译缓存::启用持久化(&磁盘路径);
            缓存.容量 = 2;
            缓存.写入缓存("内容甲", 指纹, 样本产物("甲"));
            缓存.写入缓存("内容乙", 指纹, 样本产物("乙"));
            缓存.写入缓存("内容丙", 指纹, 样本产物("丙"));
            断言相等!(缓存.条目数目(), 2);
        }
        让 缓存 = 转译缓存::启用持久化(&磁盘路径);
        断言相等!(缓存.条目数目(), 2, "淘汰后的有效条目应完整持久化");
        断言!(缓存.检索("内容乙", 指纹).是否为有值());
        断言!(缓存.检索("内容丙", 指纹).是否为有值());
        断言!(缓存.检索("内容甲", 指纹).是否为无(), "被淘汰条目不应复活");
    }

    /// 批量转译：N 次插入只在 flush 时写盘一次，且全部落盘
    ///
    /// 回归：此前每次 插入 都会把整个缓存序列化写盘（N 文件 → N 次全量写，
    /// 且发生在调用方持锁期间），是批量转译的主要 I/O 开销来源。
    #[测试]
    函数 持久化批量写盘直到刷盘() {
        让 目录 = 临时文件::建临时目录().期望("创建临时目录失败");
        让 磁盘路径 = 目录.路径模块().连接("transpile.json");
        让 指纹 = 样本指纹();
        让 可变 缓存 = 转译缓存::启用持久化(&磁盘路径);
        对于 名 在 ["甲", "乙", "丙", "丁"] {
            缓存.写入缓存(&格式化!("内容{名}"), 指纹, 样本产物(名));
            断言!(!磁盘路径.存在(), "flush 前不应有任何写盘");
        }
        断言相等!(缓存.条目数目(), 4);
        缓存.刷盘();
        让 重载 = 转译缓存::启用持久化(&磁盘路径);
        断言相等!(重载.条目数目(), 4, "一次 flush 应写入全部累积条目");
        // 幂等：无新变更时再 flush 不产生写盘（文件 mtime 不变）
        让 修改前 = 标准库::文件系统::取元数据(&磁盘路径).而后映射(|标记项| 标记项.修改时间()).转选项();
        缓存.刷盘();
        让 修改后 = 标准库::文件系统::取元数据(&磁盘路径).而后映射(|标记项| 标记项.修改时间()).转选项();
        断言相等!(修改前, 修改后, "无变更时 flush 应为空操作");
    }
}
