//! 轻量结构化日志系统，支持 `RZ_LOG=debug` 等环境变量控制等级（调试/信息/警告/错误）。
//! 输出格式：`[时间戳] [等级] [模块名] 消息`（时间戳为世界时，无第三方依赖）。
//! 提供 `调试日志!`、`信息日志!`、`警告日志!`、`错误日志!` 四个宏供其他模块使用。

使用 标准库::同步::{一次性, 原子::{原子布尔, 原子u8, 内存顺序}};
使用 标准库::时间::{系统时间, UNIX纪元};
#[配置(测试)]
使用 标准库::同步::{互斥锁, 互斥守卫};

/// 日志等级（按严重程度递增，序数值用于比较过滤）
#[布局(字节)]
#[派生(调试, 克隆, 可复制, 部分相等, 全等, 部分排序, 排序)]
公开 枚举 日志等级 {
    /// 调试等级：开发阶段详细信息
    调试级 = 0,
    /// 信息等级：正常流程关键节点
    信息级 = 1,
    /// 警告等级：潜在问题但不影响运行
    警告级 = 2,
    /// 错误等级：需要关注的异常情况
    错误级 = 3,
}

实现 日志等级 {
    /// 从环境变量取值解析等级（大小写不敏感，警告另接受 `warn | warning` 全称拼写）
    公开 函数 解析环境(输入文本: &文本) -> 选项<日志等级> {
        匹配 输入文本.裁剪().转ASCII小写().作为文本切片() {
            "debug" => 有值(自身::调试级),
            "info" => 有值(自身::信息级),
            "warn" | "warning" => 有值(自身::警告级),
            "error" => 有值(自身::错误级),
            _ => 无,
        }
    }

    /// 返回当前语言下的显示文字
    公开 函数 显示文字(&自我) -> 字符串 {
        让 映射键 = 匹配 自我 {
            自身::调试级 => "log_level_debug",
            自身::信息级 => "log_level_info",
            自身::警告级 => "log_level_warn",
            自身::错误级 => "log_level_error",
        };
        包::语言::取消息(映射键)
    }

    /// 从序数还原日志等级（用于从原子u8 读取）
    函数 从序号还原(序数: 无符号微整数) -> 日志等级 {
        匹配 序数 {
            0 => 自身::调试级,
            1 => 自身::信息级,
            3 => 自身::错误级,
            _ => 自身::警告级,
        }
    }
}

/// 默认等级的序数（警告）：`等级存储` 静态量的初值，无环境变量时生效。
///
/// 写成字面量而不是 `自身::警告级 作为 字节` 是有意的——这样「初值 ↔ 枚举序数」的一致性
/// 才需要被测试钉住：枚举变体一旦重排（调试级/信息级/警告级/错误级 的序数值变了），
/// 默认等级会静默漂移成「调试」或「错误」，而 `默认等级为警告测试` 会红。
常量 默认等级序数: 无符号微整数 = 2;
/// 当前生效的日志等级（默认警告：静默但保留关键输出）
静态 等级存储: 原子u8 = 原子u8::新建(默认等级序数);
/// 是否已从环境变量初始化（幂等标记）
静态 已初始化: 一次性 = 一次性::新建();
/// 是否已被程序化设置（置位后环境变量不再覆盖，保证程序化优先级更高）
静态 等级已程序化: 原子布尔 = 原子布尔::新建(假);

/// 从环境变量初始化日志等级（幂等，仅首次生效）
///
/// 示例：`RZ_LOG=debug rzc run 文件.zh` 启用全部日志；`RZ_LOG=error` 仅输出错误。
/// 若等级已被 `设置等级` 程序化设置，则环境变量不覆盖。
/// `初始化()` 的取舍：程序化设置优先于环境变量
///
/// 判定本体单独拆出来是为了能直接断言——`初始化()` 本体的一次性全进程只生效一次，
/// 用例若不是第一个调它的，断言就只是在验证「已经没人能改了」，而不是这条规则。
函数 环境应覆盖(程序化已设置: 布尔) -> 布尔 {
    !程序化已设置
}

公开 函数 初始化() {
    已初始化.调用一次(|| {
        如果 !环境应覆盖(等级已程序化.加载(内存顺序::松弛序)) {
            返回;
        }
        如果让 成功(读取值) = 标准库::环境::环境变量("RZ_LOG") {
            如果让 有值(等级) = 日志等级::解析环境(&读取值) {
                等级存储.存值(等级 作为 无符号微整数, 内存顺序::松弛序);
            }
        }
    });
}

/// 程序化设置日志等级（优先级高于环境变量，测试与嵌入场景使用）
公开 函数 设置等级(等级: 日志等级) {
    等级已程序化.存值(真, 内存顺序::松弛序);
    等级存储.存值(等级 作为 无符号微整数, 内存顺序::松弛序);
}

/// 返回当前生效的日志等级
公开 函数 当前等级() -> 日志等级 {
    日志等级::从序号还原(等级存储.加载(内存顺序::松弛序))
}

/// 判断指定等级是否应输出（等级 >= 当前等级时才输出）
公开 函数 启用判定(等级: 日志等级) -> 布尔 {
    等级 >= 当前等级()
}

/// 测试专用的日志等级守卫（纪律与 `语言::钉住语言` 一致）
///
/// 等级是进程全局（`等级存储`），而标准测试框架用多线程并发跑用例：任何
/// 「改等级」或「断言等级」的用例都必须持 `测试等级` 返回的守卫，
/// 否则两侧互相翻转全局值，随机红（实测：把断言用例的窗口撑开 150 毫秒，
/// 与逐个建缓存就写一次等级的旧做法并发跑，12/12 轮全红）。
/// 离开作用域时恢复进入前的等级，避免把状态留给后续用例。
#[配置(测试)]
公开(包) 结构体 级别测试守卫<'甲> {
    先前: 日志等级,
    _锁: 互斥守卫<'甲, ()>,
}

#[配置(测试)]
实现<'甲> 可丢弃 对于 级别测试守卫<'甲> {
    函数 丢弃(&可变 自我) {
        设置等级(自我.先前);
    }
}

/// 串行化「改等级 / 断言等级」的用例；毒化由持锁方恐慌造成，状态仍可继续用
#[配置(测试)]
静态 等级测试锁: 互斥锁<()> = 互斥锁::新建(());

#[配置(测试)]
函数 等级锁<'甲>() -> 互斥守卫<'甲, ()> {
    等级测试锁
        .加锁()
        .解包或用否则(|中毒守卫| 中毒守卫.取内层())
}

/// 把等级钉到 `等级` 并持锁到返回的守卫离开作用域，之后恢复原值
#[配置(测试)]
公开(包) 函数 测试等级<'甲>(等级: 日志等级) -> 级别测试守卫<'甲> {
    测试静音();
    让 锁 = 等级锁();
    让 先前 = 当前等级();
    设置等级(等级);
    级别测试守卫 {
        先前,
        _锁: 锁,
    }
}

/// 需要安静日志的用例（构造缓存等）走这里：全进程只把等级压到错误一次
///
/// 旧做法是在共享辅助函数里每次调用都 `设置等级(错误级)`——那是个不持锁的
/// 环境写侧，任何断言等级的用例都在与它赛跑（实测撑开窗口后 12/12 轮红）。
/// 收敛成一次性写入，且这一次写入必须在持锁下进行，才与 `测试等级` 互斥。
///
/// 用 `尝试加锁` 而不是阻塞式抢锁：拿不到锁说明有「断言等级」的用例正处在窗口
/// 里，那就跳过（本函数每个建缓存的用例都会再走一遍，下一次照样能落地）。这样
/// 既不会与它互翻全局值，也不可能自锁——持守卫的用例里再调建缓存只是
/// 这次不静音，不会像阻塞式抢锁那样把标准库的非可重入互斥锁变成死锁。
#[配置(测试)]
公开(包) 函数 测试静音() {
    静态 已静音: 原子布尔 = 原子布尔::新建(假);
    如果 已静音.加载(内存顺序::松弛序) {
        返回; // 已静音：热路径上只是读一个原子量
    }
    让 尝试结果 = 等级测试锁.尝试加锁();
    如果让 成功(_守卫) = 尝试结果 {
        已静音.存值(真, 内存顺序::松弛序);
        设置等级(日志等级::错误级);
    }
}

/// 生成一条日志行文本（不包含等级判断，供测试与复用）
公开 函数 格式化日志行(等级: 日志等级, 模块名: &文本, 日志消息: &文本) -> 字符串 {
    格式化!(
        "[{}] [{}] [{}] {}",
        当前时间戳(),
        等级.显示文字(),
        模块名,
        日志消息
    )
}

/// 写入一条日志到标准错误（等级不足时直接返回）
公开 函数 写日志(等级: 日志等级, 模块名: &文本, 日志消息: &文本) {
    如果 !启用判定(等级) {
        返回;
    }
    错误打印行!("{}", 格式化日志行(等级, 模块名, 日志消息));
}

// ============================================================
// 时间戳（世界时，手写日历转换，避免引入第三方日历库依赖）
// ============================================================

/// 返回当前世界时间戳，格式「年-月-日 时:分:秒」
函数 当前时间戳() -> 字符串 {
    让 秒数 = 系统时间::现在()
        .自纪元(UNIX纪元)
        .变换(|秒差| 秒差.总秒数())
        .取值或(0);
    让 (年, 月, 日, 时, 分钟, 秒) = 分解时间(秒数);
    格式化!("{年:04}-{月:02}-{日:02} {时:02}:{分钟:02}:{秒:02}")
}

/// 将纪元秒数分解为 (年, 月, 日, 时, 分, 秒)（世界时）
/// 使用公历日数分解算法，无第三方依赖
函数 分解时间(总秒: 无符号长整数) -> (长整数, 无符号整数, 无符号整数, 无符号整数, 无符号整数, 无符号整数) {
    让 天数 = (总秒 / 86_400) 作为 长整数;
    让 日内秒 = 总秒 % 86_400;

    让 基准日 = 天数 + 719_468;
    让 纪元号 = 基准日.欧几里得除(146_097);
    让 年内日 = 基准日 - 纪元号 * 146_097;
    让 年偏移 =
        (年内日 - 年内日 / 1_460 + 年内日 / 36_524 - 年内日 / 146_096) / 365;
    让 年 = 年偏移 + 纪元号 * 400;
    让 年内天 = 年内日 - (365 * 年偏移 + 年偏移 / 4 - 年偏移 / 100);
    让 月偏移 = (5 * 年内天 + 2) / 153;
    让 日 = (年内天 - (153 * 月偏移 + 2) / 5 + 1) 作为 无符号整数;
    让 月 = (月偏移 + 如果 月偏移 < 10 { 3 } 否则 { -9 }) 作为 无符号整数;
    让 年 = 如果 月 <= 2 { 年 + 1 } 否则 { 年 };

    (
        年,
        月,
        日,
        (日内秒 / 3600) 作为 无符号整数,
        ((日内秒 % 3600) / 60) 作为 无符号整数,
        (日内秒 % 60) 作为 无符号整数,
    )
}

// ============================================================
// 日志宏（调用前先判断等级，避免无谓的格式化开销）
// ============================================================

/// 输出调试级日志：`调试日志!("模块名", "消息 {}", 变量)`
#[宏导出]
宏规则! 调试日志 {
    ($目标:表达式, $($参元:元语法记号)*) => {{
        如果 $包::日志::启用判定($包::日志::日志等级::调试级) {
            $包::日志::写日志($包::日志::日志等级::调试级, $目标, &格式化!($($参元)*));
        }
    }};
}

/// 输出信息级日志：`信息日志!("模块名", "消息 {}", 变量)`
#[宏导出]
宏规则! 信息日志 {
    ($目标:表达式, $($参元:元语法记号)*) => {{
        如果 $包::日志::启用判定($包::日志::日志等级::信息级) {
            $包::日志::写日志($包::日志::日志等级::信息级, $目标, &格式化!($($参元)*));
        }
    }};
}

/// 输出警告级日志：`警告日志!("模块名", "消息 {}", 变量)`
#[宏导出]
宏规则! 警告日志 {
    ($目标:表达式, $($参元:元语法记号)*) => {{
        如果 $包::日志::启用判定($包::日志::日志等级::警告级) {
            $包::日志::写日志($包::日志::日志等级::警告级, $目标, &格式化!($($参元)*));
        }
    }};
}

/// 输出错误级日志：`错误日志!("模块名", "消息 {}", 变量)`
#[宏导出]
宏规则! 错误日志 {
    ($目标:表达式, $($参元:元语法记号)*) => {{
        如果 $包::日志::启用判定($包::日志::日志等级::错误级) {
            $包::日志::写日志($包::日志::日志等级::错误级, $目标, &格式化!($($参元)*));
        }
    }};
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    #[测试]
    函数 等级解析测试() {
        断言相等!(日志等级::解析环境("debug"), 有值(日志等级::调试级));
        断言相等!(日志等级::解析环境("INFO"), 有值(日志等级::信息级));
        断言相等!(日志等级::解析环境("warn"), 有值(日志等级::警告级));
        断言相等!(日志等级::解析环境("warning"), 有值(日志等级::警告级));
        断言相等!(日志等级::解析环境("error"), 有值(日志等级::错误级));
        断言相等!(日志等级::解析环境("verbose"), 无);
        断言相等!(日志等级::解析环境(""), 无);
    }

    #[测试]
    函数 默认等级为警告测试() {
        // 约定：无环境变量时默认「警告」——教学级(信息)静默、警告与错误保留。
        // 旧实现只有一句取当前等级、没有任何断言，把初值改成别的
        // 数也照样全绿（变异实测），所以这里钉的是三方一致：初值常量 ↔ 枚举序数 ↔
        // 从序号还原。
        断言相等!(
            默认等级序数,
            日志等级::警告级 作为 无符号微整数,
            "默认等级初值与警告的序数脱钩了"
        );
        对于 等级 在 [
            日志等级::调试级,
            日志等级::信息级,
            日志等级::警告级,
            日志等级::错误级,
        ] {
            断言相等!(
                日志等级::从序号还原(等级 作为 无符号微整数),
                等级,
                "{等级:?} 序数往返"
            );
        }
        断言相等!(
            日志等级::从序号还原(7),
            日志等级::警告级,
            "未知序数须兜底为警告（保守：不放大也不静默）"
        );
    }

    #[测试]
    函数 启用判定按等级过滤测试() {
        // 等级是进程全局：改 + 断言必须持守卫，否则与并发用例互翻（见 级别测试守卫）
        让 _等级 = 测试等级(日志等级::警告级);
        断言!(!启用判定(日志等级::调试级));
        断言!(!启用判定(日志等级::信息级));
        断言!(启用判定(日志等级::警告级));
        断言!(启用判定(日志等级::错误级));
    }

    #[测试]
    函数 分解时间纪元测试() {
        断言相等!(分解时间(0), (1970, 1, 1, 0, 0, 0));
    }

    #[测试]
    函数 分解时间已知日期测试() {
        // 2026-01-01 与 2026-08-13 零时的纪元秒
        断言相等!(分解时间(1_767_225_600), (2026, 1, 1, 0, 0, 0));
        断言相等!(分解时间(1_786_579_200), (2026, 8, 13, 0, 0, 0));
    }

    #[测试]
    函数 分解时间时分秒测试() {
        // 1970-01-01 十二时三十四分五十六秒 = 45296 秒
        断言相等!(分解时间(45_296), (1970, 1, 1, 12, 34, 56));
        // 闰年 2024-02-29（2024-01-01 = 1704067200，加 59 天）
        断言相等!(
            分解时间(1_704_067_200 + 59 * 86_400),
            (2024, 2, 29, 0, 0, 0)
        );
    }

    #[测试]
    函数 格式化日志行结构测试() {
        // 等级文字走全局语言（`显示文字` → `语言::取消息`）：断言中文
        // 「信息」就得持语言守卫，否则会与切语言的用例竞争——它把等级换成
        // 别的语言文字，本用例随机红（实测：工作区并行跑发行版全量时会咬）。
        让 _语言 = 包::语言::钉住语言("zh");
        让 文本行 = 格式化日志行(日志等级::信息级, "test_module", "test message 42");
        // 形如「[时间戳] [信息] [模块名] 消息」，本例的消息段为固定文本
        断言!(文本行.以开头('['));
        断言!(文本行.包含("] [信息] [test_module] test message 42"));
        // 时间戳年份段
        让 年份段 = &文本行[1..5];
        断言!(年份段.逐字符().全部(|每字符| 每字符.是数字字符()));
        断言!(文本行.包含("-"));
    }

    #[测试]
    函数 低等级不输出测试() {
        // 等级设为错误时，信息级写入不应恐慌（被过滤，无输出）
        让 _等级 = 测试等级(日志等级::错误级);
        写日志(日志等级::信息级, "test_module", "不应输出");
        信息日志!("test_module", "宏调用不应恐慌 {}", 1);
        调试日志!("test_module", "调试消息");
        断言!(启用判定(日志等级::错误级));
    }

    #[测试]
    函数 宏在启用等级工作测试() {
        // 调试级下四个宏都应放行；宏本身不恐慌只是下限，等级判定才是可断言的行为
        让 _等级 = 测试等级(日志等级::调试级);
        断言!(启用判定(日志等级::调试级));
        断言!(启用判定(日志等级::信息级));
        断言!(启用判定(日志等级::警告级));
        断言!(启用判定(日志等级::错误级));
        调试日志!("test_module", "调试 {}", "内容");
        信息日志!("test_module", "信息 {}", 42);
        警告日志!("test_module", "警告");
        错误日志!("test_module", "错误");
    }

    #[测试]
    函数 程序化设置不被初始化覆盖测试() {
        // 程序化设置后，`初始化()`（读环境变量）不得覆盖——契约：程序化优先级更高
        让 _等级 = 测试等级(日志等级::错误级);
        断言!(等级已程序化.加载(内存顺序::松弛序));
        初始化();
        断言相等!(当前等级(), 日志等级::错误级);
        // 规则本体走纯函数断言：上面的 `初始化()` 受一次性约束，若不是本进程第一个
        // 调用它的用例，「没被覆盖」可能只是时序巧合，这里把判定逻辑单独钉死。
        断言!(!环境应覆盖(真), "已程序化设置时环境变量不得覆盖");
        断言!(环境应覆盖(假), "未程序化设置时环境变量应生效");
    }
}
