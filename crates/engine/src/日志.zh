//! 日志模块【zh 自举·批次1】
//! 本文件是源真相：由引导 rzc 转译为 日志.rs 后交 cargo 编译。
//! 再生成方式见 tools/zh-selfhost/regen.sh；请勿手改同目录下的 日志.rs。
//!
//! 轻量结构化日志系统，支持 RZ_LOG 环境变量控制级别（debug/info/warn/错误模块）。
//! 输出格式：`[时间戳] [级别] [模块名] 消息`（时间戳为 UTC，无第三方依赖）。
//! 提供 调试日志!、信息日志!、警告日志!、错误日志! 四个宏供其他模块使用。
//!
//! 注：`调用一次`、`作为字符串`、`欧几里得除`、`宏导出` 与宏内部的
//! `$包`、`tt` 暂无中文词条/为 Rust 宏专有语法，按英文原样书写；
//! `"debug"`、`"log_level_*"` 等字符串是与语言包对齐的数据键，保持原文。

使用 标准库::同步::一次性;
使用 标准库::同步::原子::{内存顺序, 原子布尔, 原子u8};

/// 日志级别（按严重程度递增，序数值用于比较过滤）
#[布局(字节)]
#[派生(调试, 克隆, 复制, 部分相等, 相等, 部分排序, 排序)]
公开 枚举 日志级别 {
    /// 调试级别：开发阶段详细信息
    调试级别 = 0,
    /// 信息级别：正常流程关键节点
    信息级别 = 1,
    /// 警告级别：潜在问题但不影响运行
    警告级别 = 2,
    /// 错误级别：需要关注的异常情况
    错误级别 = 3,
}

实现 日志级别 {
    /// 从 RZ_LOG 环境变量取值解析（大小写不敏感，支持 warning 别名）
    公开 函数 解析环境值(文本内容: &文本) -> 选项<日志级别> {
        匹配 文本内容.裁剪().转ASCII小写().作为字符串() {
            "debug" => 有值(自身::调试级别),
            "info" => 有值(自身::信息级别),
            "warn" | "warning" => 有值(自身::警告级别),
            "error" => 有值(自身::错误级别),
            _ => 无,
        }
    }

    /// 返回当前语言下的显示文字
    公开 函数 显示文字(&自我) -> 字符串 {
        让 键 = 匹配 自我 {
            自身::调试级别 => "log_level_debug",
            自身::信息级别 => "log_level_info",
            自身::警告级别 => "log_level_warn",
            自身::错误级别 => "log_level_error",
        };
        包::语言::查句(键)
    }

    /// 从序号还原日志级别（用于从 AtomicU8 读取）
    函数 从序号还原(序号: 字节) -> 日志级别 {
        匹配 序号 {
            0 => 自身::调试级别,
            1 => 自身::信息级别,
            3 => 自身::错误级别,
            _ => 自身::警告级别,
        }
    }
}

/// 当前生效的日志级别（默认警告：静默但保留关键输出）
静态 级别存储: 原子u8 = 原子u8::新建(2);
/// 是否已从环境变量初始化（幂等标记）
静态 已初始化: 一次性 = 一次性::新建();
/// 是否已被程序化设置（置位后 RZ_LOG 不再覆盖，保证程序化优先级更高）
静态 已程序化设置: 原子布尔 = 原子布尔::新建(假);

/// 从 RZ_LOG 环境变量初始化日志级别（幂等，仅首次生效）
///
/// 示例：`RZ_LOG=debug rzc run file.zh` 启用全部日志；
/// `RZ_LOG=错误模块` 仅输出错误。
/// 若级别已被 [`set_log_level`] 程序化设置，则环境变量不覆盖。
公开 函数 初始化() {
    已初始化.调用一次(|| {
        如果 已程序化设置.加载(内存顺序::松弛序) {
            返回;
        }
        如果让 成功(值) = 标准库::环境::环境变量("RZ_LOG")
            && 让 有值(级别) = 日志级别::解析环境值(&值)
        {
            级别存储.存值(级别 作为 字节, 内存顺序::松弛序);
        }
    });
}

/// 程序化设置日志级别（优先级高于 RZ_LOG，测试与嵌入场景使用）
公开 函数 设置日志级别(级别: 日志级别) {
    已程序化设置.存值(真, 内存顺序::松弛序);
    级别存储.存值(级别 作为 字节, 内存顺序::松弛序);
}

// 以下两个转发供其他 .zh 模块调用：`初始化`/`日志级别` 两词撞第三方
// 日志词表（crates/日志.toml：`初始化`→init、`日志级别`→Level），
// 他文件引用时不在声明位也无法被本地项遮蔽，会被替换出生态名；
// 本模块内声明位/同名项豁免生效，复合别名名未被劫持，可安全透传。

/// [`初始化`] 的未劫持别名入口（供 .zh 消费方使用）
公开 函数 引擎日志启用() {
    初始化();
}

/// 静默日志输出（仅保留错误级，供测试抑制刷屏；等价
/// `设置日志级别(日志级别::错误级别)` 的未劫持别名入口）
公开 函数 静默日志() {
    设置日志级别(日志级别::错误级别);
}

/// 返回当前生效的日志级别
公开 函数 当前级别() -> 日志级别 {
    日志级别::从序号还原(级别存储.加载(内存顺序::松弛序))
}

/// 判断指定级别是否应输出（级别 >= 当前级别时才输出）
公开 函数 是否启用(级别: 日志级别) -> 布尔 {
    级别 >= 当前级别()
}

/// 生成一条日志行文本（不包含级别判断，供测试与复用）
公开 函数 格式化日志行(级别: 日志级别, 模块名: &文本, 消息内容: &文本) -> 字符串 {
    格式化!(
        "[{}] [{}] [{}] {}",
        当前时间戳(),
        级别.显示文字(),
        模块名,
        消息内容
    )
}

/// 写入一条日志到 stderr（级别不足时直接返回）
公开 函数 写入日志(级别: 日志级别, 模块名: &文本, 消息内容: &文本) {
    如果 !是否启用(级别) {
        返回;
    }
    错误打印行!("{}", 格式化日志行(级别, 模块名, 消息内容));
}

// ============================================================
// 时间戳（UTC，手写日历转换，避免引入 chrono 依赖）
// ============================================================

/// 返回当前 UTC 时间戳，格式 `YYYY-MM-DD HH:MM:SS`
函数 当前时间戳() -> 字符串 {
    // `标准库::时间模块` 整段英文透传：模块词 时间 会被误映射（chrono 词条 NaiveTime），
    // 历元 含下划线不可改写（否则拆成 UNIX + 错误词条）
    让 秒数 = 标准库::时间模块::系统时间::现在()
        .自纪元(标准库::时间模块::历元)
        .映射(|间隔| 间隔.总秒数())
        .取值或(0);
    让 (年, 月, 日, 时, 分, 秒) = 分解时间(秒数);
    格式化!("{:04}-{:02}-{:02} {:02}:{:02}:{:02}", 年, 月, 日, 时, 分, 秒)
}

/// 将 Unix 秒数分解为 (年, 月, 日, 时, 分, 秒)（UTC）
/// 使用 Howard Hinnant 的 civil_from_days 算法，无第三方依赖
函数 分解时间(总秒数: 无符号长整数) -> (长整数, 无符号整数, 无符号整数, 无符号整数, 无符号整数, 无符号整数) {
    让 日数 = (总秒数 / 86_400) 作为 长整数;
    让 当日秒 = 总秒数 % 86_400;

    让 序日 = 日数 + 719_468;
    让 纪元 = 序日.欧几里得除(146_097);
    让 纪元内日 = 序日 - 纪元 * 146_097;
    让 年偏移 =
        (纪元内日 - 纪元内日 / 1_460 + 纪元内日 / 36_524 - 纪元内日 / 146_096) / 365;
    让 年 = 年偏移 + 纪元 * 400;
    让 年内日 = 纪元内日 - (365 * 年偏移 + 年偏移 / 4 - 年偏移 / 100);
    让 月偏移 = (5 * 年内日 + 2) / 153;
    让 日 = (年内日 - (153 * 月偏移 + 2) / 5 + 1) 作为 无符号整数;
    让 月 = (月偏移 + 如果 月偏移 < 10 { 3 } 否则 { -9 }) 作为 无符号整数;
    让 年 = 如果 月 <= 2 { 年 + 1 } 否则 { 年 };

    (
        年,
        月,
        日,
        (当日秒 / 3600) 作为 无符号整数,
        ((当日秒 % 3600) / 60) 作为 无符号整数,
        (当日秒 % 60) 作为 无符号整数,
    )
}

// ============================================================
// 日志宏（调用前先判断级别，避免无谓的 format! 开销）
// ============================================================

/// 输出调试级日志：`调试日志!("模块名", "消息 {}", 变量)`
#[宏导出]
宏规则! 调试日志 {
    ($目标模块:表达式, $($消息内容:tt)*) => {{
        如果 $包::日志::是否启用($包::日志::日志级别::调试级别) {
            $包::日志::写入日志(
                $包::日志::日志级别::调试级别,
                $目标模块,
                &格式化!($($消息内容)*),
            );
        }
    }};
}

/// 输出信息级日志：`信息日志!("模块名", "消息 {}", 变量)`
#[宏导出]
宏规则! 信息日志 {
    ($目标模块:表达式, $($消息内容:tt)*) => {{
        如果 $包::日志::是否启用($包::日志::日志级别::信息级别) {
            $包::日志::写入日志(
                $包::日志::日志级别::信息级别,
                $目标模块,
                &格式化!($($消息内容)*),
            );
        }
    }};
}

/// 输出警告级日志：`警告日志!("模块名", "消息 {}", 变量)`
#[宏导出]
宏规则! 警告日志 {
    ($目标模块:表达式, $($消息内容:tt)*) => {{
        如果 $包::日志::是否启用($包::日志::日志级别::警告级别) {
            $包::日志::写入日志(
                $包::日志::日志级别::警告级别,
                $目标模块,
                &格式化!($($消息内容)*),
            );
        }
    }};
}

/// 输出错误级日志：`错误日志!("模块名", "消息 {}", 变量)`
#[宏导出]
宏规则! 错误日志 {
    ($目标模块:表达式, $($消息内容:tt)*) => {{
        如果 $包::日志::是否启用($包::日志::日志级别::错误级别) {
            $包::日志::写入日志(
                $包::日志::日志级别::错误级别,
                $目标模块,
                &格式化!($($消息内容)*),
            );
        }
    }};
}

#[配置(测试)]
模块 单元测试 {
    使用 超级::*;

    #[测试]
    函数 级别解析() {
        断言相等!(日志级别::解析环境值("debug"), 有值(日志级别::调试级别));
        断言相等!(日志级别::解析环境值("INFO"), 有值(日志级别::信息级别));
        断言相等!(日志级别::解析环境值("warn"), 有值(日志级别::警告级别));
        断言相等!(日志级别::解析环境值("warning"), 有值(日志级别::警告级别));
        断言相等!(日志级别::解析环境值("error"), 有值(日志级别::错误级别));
        断言相等!(日志级别::解析环境值("verbose"), 无);
        断言相等!(日志级别::解析环境值(""), 无);
    }

    #[测试]
    函数 默认级别为警告() {
        // 默认级别：警告（无 RZ_LOG 时静默但保留关键输出）
        // 注意：此测试依赖全局状态，可能受其他测试影响
        让 _ = 当前级别();
    }

    #[测试]
    函数 是否启用按级别过滤() {
        设置日志级别(日志级别::警告级别);
        断言!(!是否启用(日志级别::调试级别));
        断言!(!是否启用(日志级别::信息级别));
        断言!(是否启用(日志级别::警告级别));
        断言!(是否启用(日志级别::错误级别));
    }

    #[测试]
    函数 分解时间纪元起点() {
        断言相等!(分解时间(0), (1970, 1, 1, 0, 0, 0));
    }

    #[测试]
    函数 分解时间已知日期() {
        // 2026-01-01T00:00:00Z 与 2026-08-13T00:00:00Z 的 Unix 秒
        断言相等!(分解时间(1_767_225_600), (2026, 1, 1, 0, 0, 0));
        断言相等!(分解时间(1_786_579_200), (2026, 8, 13, 0, 0, 0));
    }

    #[测试]
    函数 分解时间含时分秒() {
        // 1970-01-01T12:34:56Z = 45296 秒
        断言相等!(分解时间(45_296), (1970, 1, 1, 12, 34, 56));
        // 闰年 2024-02-29（2024-01-01 = 1704067200，+59 天）
        断言相等!(
            分解时间(1_704_067_200 + 59 * 86_400),
            (2024, 2, 29, 0, 0, 0)
        );
    }

    #[测试]
    函数 日志行格式() {
        让 文本行 = 格式化日志行(日志级别::信息级别, "test_module", "test message 42");
        // 格式：[YYYY-MM-DD HH:MM:SS] [信息] [test_module] test message 42
        // 注：变量不可命名为 行（词条 行→line），改用复合名 文本行
        断言!(文本行.以开头('['));
        断言!(文本行.包含("] [信息] [test_module] test message 42"));
        // 时间戳年份段
        让 年段 = &文本行[1..5];
        断言!(年段.逐字符().全部(|字符位| 字符位.是数字字符()));
        断言!(文本行.包含("-"));
    }

    #[测试]
    函数 低于级别不输出() {
        // 级别设为错误时，信息级写入不应 崩溃（被过滤，无输出）
        设置日志级别(日志级别::错误级别);
        写入日志(日志级别::信息级别, "test_module", "不应输出");
        信息日志!("test_module", "宏调用不应 panic {}", 1);
        调试日志!("test_module", "调试消息");
        断言!(是否启用(日志级别::错误级别));
    }

    #[测试]
    函数 宏在启用级别可用() {
        设置日志级别(日志级别::调试级别);
        调试日志!("test_module", "调试 {}", "内容");
        信息日志!("test_module", "信息 {}", 42);
        警告日志!("test_module", "警告");
        错误日志!("test_module", "错误");
    }

    #[测试]
    函数 程序化设置不被初始化覆盖() {
        // 程序化设置后，初始化()（读 RZ_LOG）不得覆盖——契约：程序化优先级更高
        设置日志级别(日志级别::错误级别);
        初始化();
        断言相等!(当前级别(), 日志级别::错误级别);
    }
}
