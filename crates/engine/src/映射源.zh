//! 映射源模块【zh 自举·批次1】
//! 本文件是源真相：由引导 rzc 转译为 映射源.rs 后交 cargo 编译。
//! 再生成方式见 tools/zh-selfhost/regen.sh；请勿手改同目录下的 映射源.rs。
//!
//! 从 TOML 文件加载映射表。
//! 提供映射数据的加载和管理，支持按类别组织：
//! - 关键字映射（词法处理阶段）
//! - 标准库映射（语义处理阶段）
//! - 第三方库映射（按需加载，来自 crates/ 子目录）
//!
//! 注：模块路径保持英文 `mapping_source`（被 engine/cli/lsp 按名调用，属跨 包
//! 稳定 ABI）；公开类型/函数/方法/枚举变体（节表/映射类别/映射加载器
//! 及 解析配置节/摊平节表/合并模块路径与标识符节/
//! 加载关键词映射/加载标准库映射/加载全部映射/
//! 创建内置关键词映射 等）同为跨 包 数据契约，保持英文。
//! `toml::JSON值`/`toml::解析字符串`/`toml::反序列化模块::错误特征`/`标准库::文件系统`/`标准库::外部接口模块::操作系统串`/
//! `编码库::*`/`临时文件`/`作为引用`/`路径类型`/`路径缓冲类型`(路径缓冲)/`无符号机器整数` 及无干净
//! 词条或易撞词典的方法链（取全部键/迭代/变换/收集/克隆副本/排序/扩展/取条目/
//! 或用缺省/或用插入/而后映射/过滤/解包*/期望/包含/是否为空/
//! 是否为无/是否为成功/是否为错误/连接/存在/是否为目录/展示/文件名干/设扩展名/
//! 作为系统串/作为引用方法/转路径缓冲/取字符串引用/转为字节/解码/转所有权/
//! 转有损字符串/转为/读取目录/读取字符串/写入/递归创建目录 等）
//! 按英文透传（rzc 合法特性）；内部私有函数、局部变量、控制流、类型别名与
//! 测试均已中文化。加载层的 `加载错误`/`加载目标` 经 lib.rs 重导出到 包 根，
//! 以 `包::{加载目标, 加载错误}` 引用（第三方 salvo 表把「错误类型」劫持为 `错误特征`，
//! 无法安全写出模块路径 `错误类型::`）。

使用 标准库::集合::哈希映射;
使用 标准库::路径::{路径类型, 路径缓冲};
使用 包::{加载目标, 加载错误};

/// 节（section）组织的映射表：节名 → (母语词 → 英文)
公开 类型 节表 = 哈希映射<字符串, 哈希映射<字符串, 字符串>>;

/// 解析 TOML 内容为“节 → (母语词 → 英文)”二级表（两个加载器共用的单一解析实现）
///
/// 非表节与非字符串条目记录警告后跳过（数据格式错误不再完全静默，
/// RZ_LOG=warn 时可见）；返回原始 toml 错误，
/// 由调用方按场景本地化错误消息（文件/内置/路径等键不同）。
公开 函数 解析配置节(内容: &文本) -> 结果<节表, TOML处理::反序列化模块::错误特征> {
    让 顶层值: TOML处理::JSON值 = TOML处理::解析字符串(内容)?;
    让 可变 节表 = 哈希映射::新建();
    如果让 toml::JSON值::表格(顶层表) = 顶层值 {
        对于 (子节名, 子节值) 在 顶层表 {
            如果让 toml::JSON值::表格(子节映射) = 子节值 {
                让 可变 子项表 = 哈希映射::新建();
                对于 (母语词, 英文值) 在 子节映射 {
                    如果让 toml::JSON值::字符串值(英文词) = 英文值 {
                        子项表.插入(母语词, 英文词);
                    } 否则 {
                        包::警告日志!(
                            "映射源",
                            "节 [{}] 条目 {} 的值不是字符串，已跳过",
                            子节名,
                            母语词
                        );
                    }
                }
                如果 !子项表.是否为空() {
                    节表.插入(子节名, 子项表);
                }
            } 否则 {
                包::警告日志!("映射源", "节 [{}] 不是表结构，已跳过", 子节名);
            }
        }
    }
    成功(节表)
}

/// 把节表扁平化为单一映射：按节名升序合并，同名键冲突时胜出者确定
/// （HashMap 遍历顺序随机会导致多次加载结果不一致）
公开 函数 摊平节表(节表: &节表) -> 哈希映射<字符串, 字符串> {
    让 可变 合并结果 = 哈希映射::新建();
    让 可变 子节名列表: 向量<&字符串> = 节表.取全部键().收集();
    子节名列表.排序();
    对于 子节名 在 子节名列表 {
        对于 (母语词, 英文词) 在 &节表[子节名] {
            合并结果.插入(母语词.克隆(), 英文词.克隆());
        }
    }
    合并结果
}

/// 解析“模块路径 + 标识符”两节格式的 TOML（stdlib.toml 与 crates/*.toml 通用）
///
/// - `["模块路径"]` 节 → 合并到模块路径映射（如 `"线程" = "std::thread"`）
/// - `["标识符"]` 节 → 合并到标识符别名映射（如 `"字符串" = "String"`）
///
/// 返回原始 toml 错误，由调用方结合文件路径/数据源上下文转为 [`加载错误`]。
公开 函数 合并模块路径与标识符节(
    内容: &文本,
    模块路径表: &可变 哈希映射<字符串, 字符串>,
    别名表: &可变 哈希映射<字符串, 字符串>,
) -> 结果<(), TOML处理::反序列化模块::错误特征> {
    让 节表 = 解析配置节(内容)?;
    如果让 有值(条目项) = 节表.截取("模块路径") {
        模块路径表.扩展(条目项.迭代().变换(|(键名, 值项)| (键名.克隆(), 值项.克隆())));
    }
    如果让 有值(条目项) = 节表.截取("标识符") {
        别名表.扩展(条目项.迭代().变换(|(键名, 值项)| (键名.克隆(), 值项.克隆())));
    }
    成功(())
}

/// 把文件名字节转成 UTF-8 字符串（作为映射分类键）
///
/// - 本身是 UTF-8 时直接返回；
/// - 非 UTF-8 字节按常见 CJK 编码依次尝试解码（GB18030 → Shift_JIS → Big5 →
///   EUC-KR → EUC-JP），首个解码无错误者即为转码结果，
///   把“非 UTF-8 文件名”真正转成 UTF-8（而非丢弃字节）；
/// - 所有编码都失败时回退 lossy 转写（保留可显示部分，不 崩溃）。
///
/// 平台差异：只有 Unix 允许文件名是任意字节，因此才需要字节级转码；
/// Windows 的文件名在系统层面就是 UTF-16，正常文件名（含中文/日文等）
/// `取字符串引用()` 总能成功，不会进入转码分支，也不会被误判成 GBK 乱码；
/// 唯一极端情况是文件名字含孤立代理码元（正常工具造不出来），
/// 此时回退为明确的替换符 `` 而非错误解码。
函数 解码系统名(待解码: &标准库::外部接口模块::操作系统串) -> 字符串 {
    如果让 有值(可读文本) = 待解码.取字符串引用() {
        返回 可读文本.转字符串();
    }
    // Unix 下可取原始字节逐编码尝试；其他平台（Windows 等）直接走 lossy 兜底
    #[配置(Unix系统)]
    {
        使用 标准库::操作系统模块::Unix系统::外部接口模块::操作系统串扩展;
        让 原始字节 = 待解码.转为字节();
        // 按 CJK 使用频度排序：中文 GB18030（覆盖 GBK/GB2312）优先，日文 Shift_JIS 次之。
        // 注：部分字节序列在多种编码下都能无错误解码，顺序只是概率取舍，
        // 无法在没有额外元数据时做到 100% 正确。
        对于 编码项 在 [
            编码库::GB18030,
            编码库::SHIFT_JIS,
            编码库::BIG5,
            编码库::EUC_KR,
            编码库::EUC_JP,
        ] {
            让 (解码文本, _, 解码有错) = 编码项.解码(原始字节);
            如果 !解码有错 {
                返回 解码文本.转所有权();
            }
        }
    }
    待解码.转有损字符串().转所有权()
}

/// 映射表分类
#[派生(调试, 克隆, 复制, 部分相等, 相等, 哈希)]
公开 枚举 映射类别 {
    /// 关键字（词法处理阶段）
    关键词表项,
    /// 标准库（语义处理阶段）
    标准库表项,
    /// 第三方库（按需加载）
    三方库表项,
}

实现 映射类别 {
    /// 获取分类对应的默认文件名
    公开 函数 默认文件名(&自我) -> &'static 文本 {
        匹配 自我 {
            映射类别::关键词表项 => "keywords.toml",
            映射类别::标准库表项 => "stdlib.toml",
            映射类别::三方库表项 => "crates.toml",
        }
    }

    /// 获取分类的显示名称（随当前语言变化）
    公开 函数 显示名称(&自我) -> 字符串 {
        让 键名 = 匹配 自我 {
            映射类别::关键词表项 => "mapping_cat_keywords",
            映射类别::标准库表项 => "mapping_cat_stdlib",
            映射类别::三方库表项 => "mapping_cat_third_party",
        };
        包::语言::查句(键名)
    }
}

/// 映射表加载器 - 从 TOML 文件加载映射数据
///
/// 从语言包目录中按分类加载映射表，支持关键字/标准库单文件加载
/// 以及第三方库目录（crates/）下多文件合并加载。
#[派生(调试, 克隆)]
公开 结构体 映射加载器 {
    /// 语言包根目录
    根目录: 路径缓冲,
    /// 已加载的映射表（按分类和子分类组织）
    映射表: 哈希映射<映射类别, 哈希映射<字符串, 哈希映射<字符串, 字符串>>>,
}

实现 映射加载器 {
    /// 创建新的加载器
    公开 函数 新建加载器<路径参: 作为引用<路径类型>>(语言包路径: 路径参) -> 自身 {
        让 根目录 = 语言包路径.作为引用方法().转路径缓冲();
        自身 {
            根目录,
            映射表: 哈希映射::新建(),
        }
    }

    /// 加载指定分类的映射表
    公开 函数 加载类别(&可变 自我, 分类: 映射类别) -> 结果<(), 加载错误> {
        // 第三方库是目录，包含多个文件
        如果 分类 == 映射类别::三方库表项 {
            返回 自我.加载第三方库目录();
        }

        让 磁盘路径 = 自我.根目录.连接(分类.默认文件名());

        如果 !磁盘路径.存在() {
            返回 错误(加载错误::新建文件缺失(
                加载目标::映射表,
                格式化!("{:?}", 磁盘路径),
            ));
        }

        让 内容 = 标准库::文件系统::读取字符串(&磁盘路径).映射错误(|错误值| {
            加载错误::新建读取失败(加载目标::映射表, 无, 错误值.转字符串())
        })?;

        让 分类映射 = 解析配置节(&内容).映射错误(|错误值| {
            加载错误::新建解析失败(加载目标::映射表, 无, 错误值.转字符串())
        })?;
        自我.映射表.插入(分类, 分类映射);
        成功(())
    }

    /// 加载第三方库目录（crates/）下的所有 TOML 文件
    函数 加载第三方库目录(&可变 自我) -> 结果<(), 加载错误> {
        让 目录路径 = 自我.根目录.连接("crates");

        如果 !目录路径.存在() {
            // 目录不存在，静默返回
            返回 成功(());
        }

        让 可变 合并表 = 哈希映射::新建();

        // 遍历目录中的所有 .toml 文件（按文件名排序，读取目录 顺序未定义，
        // 排序后合并结果与 映射管理器::自目录加载 保持一致且确定）；
        // 读取目录 或条目读取失败必须报错（不能静默吞掉，否则映射整体丢失）
        让 可变 配置表路径列表: 向量<路径缓冲> = 标准库::文件系统::读取目录(&目录路径)
            .映射错误(|错误值| 加载错误::目录读取失败 {
                详情: 错误值.转字符串(),
            })?
            .收集::<结果<向量<_>, _>>()
            .映射错误(|错误值| 加载错误::目录读取失败 {
                详情: 错误值.转字符串(),
            })?
            .转迭代()
            .变换(|项| 项.路径模块())
            .过滤(|前索引| 前索引.取扩展名().而后映射(|字符串项| 字符串项.取字符串引用()) == 有值("toml"))
            .收集();
        配置表路径列表.排序();

        对于 磁盘路径 在 配置表路径列表 {
            // 获取文件名（不含扩展名）作为分类标识；
            // 非 UTF-8 文件名按常见编码转码为 UTF-8（解码系统名），
            // 避免多个文件碰撞合并或分类键变为替换符
            让 基名 = 磁盘路径
                .文件名干()
                .变换(解码系统名)
                .解包或用否则(|| 解码系统名(磁盘路径.作为系统串()));

            让 内容 = 标准库::文件系统::读取字符串(&磁盘路径).映射错误(|错误值| {
                加载错误::新建读取失败(
                    加载目标::第三方库,
                    有值(格式化!("{:?}", 磁盘路径)),
                    错误值.转字符串(),
                )
            })?;

            // 将文件中的映射合并，加上文件分类前缀
            让 节表 = 解析配置节(&内容).映射错误(|错误值| {
                加载错误::新建解析失败(
                    加载目标::第三方库,
                    有值(格式化!("{:?}", 磁盘路径)),
                    错误值.转字符串(),
                )
            })?;
            // 节名排序后合并，保证 "文件名/子分类" 键的插入顺序确定
            让 可变 子节名列表: 向量<&字符串> = 节表.取全部键().收集();
            子节名列表.排序();
            对于 子节名 在 子节名列表 {
                让 分类键 = 格式化!("{}/{}", 基名, 子节名);
                合并表.插入(分类键, 节表[子节名].克隆());
            }
        }

        自我.映射表
            .插入(映射类别::三方库表项, 合并表);
        成功(())
    }

    /// 加载所有默认映射表
    公开 函数 加载全部(&可变 自我) -> 结果<(), 加载错误> {
        自我.加载类别(映射类别::关键词表项)?;
        // 标准库可选：缺失时静默跳过（与 映射管理器::自目录加载 行为一致），
        // 存在但加载失败时必须报错
        如果 自我.根目录.连接("stdlib.toml").存在() {
            自我.加载类别(映射类别::标准库表项)?;
        }
        // module_paths.toml（可选）：模块路径映射并入标准库分类的 ["模块路径"] 子节。
        // 在 stdlib 之后合并且仅补充缺失键，保证 stdlib 的同名映射优先
        // （与 映射管理器 的 module_paths 先、stdlib 后的覆盖顺序语义一致）
        让 模块路径磁盘项 = 自我.根目录.连接("module_paths.toml");
        如果 模块路径磁盘项.存在() {
            让 内容 = 标准库::文件系统::读取字符串(&模块路径磁盘项).映射错误(|错误值| {
                加载错误::新建读取失败(
                    加载目标::模块路径表,
                    有值(模块路径磁盘项.展示().转字符串()),
                    错误值.转字符串(),
                )
            })?;
            让 节表 = 解析配置节(&内容).映射错误(|错误值| {
                加载错误::新建解析失败(加载目标::模块路径表, 无, 错误值.转字符串())
            })?;
            如果让 有值(条目项) = 节表.截取("模块路径") {
                让 标准库映射 = 自我.映射表.取条目(映射类别::标准库表项).或用缺省();
                让 模块路径子节 = 标准库映射.取条目("模块路径".转字符串()).或用缺省();
                对于 (键名, 值项) 在 条目项 {
                    模块路径子节.取条目(键名.克隆()).或用插入(|| 值项.克隆());
                }
            }
        }
        // 第三方库可选：目录不存在时静默跳过，存在但加载失败时必须报错
        // （否则映射静默丢失，用户看到的是未翻译的标识符而非错误提示）
        如果 自我.根目录.连接("crates").是否为目录() {
            自我.加载类别(映射类别::三方库表项)?;
        }
        成功(())
    }

    /// 获取指定分类的完整映射表（扁平化合并所有子分类）
    ///
    /// 子分类按名称排序后合并，保证同名键冲突时的胜出者确定
    /// （HashMap 遍历顺序随机会导致多次加载结果不一致）
    公开 函数 取分类映射(&自我, 分类: 映射类别) -> 哈希映射<字符串, 字符串> {
        自我.映射表
            .截取(&分类)
            .变换(摊平节表)
            .取值或默认()
    }

    /// 获取指定分类和子分类的映射表
    公开 函数 取子映射(
        &自我,
        分类: 映射类别,
        子分类: &文本,
    ) -> 选项<&哈希映射<字符串, 字符串>> {
        自我.映射表
            .截取(&分类)
            .而后映射(|分类映射| 分类映射.截取(子分类))
    }

    /// 查询单个映射条目（按子分类名升序查找，同名键命中顺序确定）
    公开 函数 检索(&自我, 分类: 映射类别, 母语词: &文本) -> 选项<字符串> {
        如果让 有值(分类映射) = 自我.映射表.截取(&分类) {
            让 可变 子节名列表: 向量<&字符串> = 分类映射.取全部键().收集();
            子节名列表.排序();
            对于 子节名 在 子节名列表 {
                如果让 有值(英文词) = 分类映射[子节名].截取(母语词) {
                    返回 有值(英文词.克隆());
                }
            }
        }
        无
    }

    /// 反向查询（从英文查中文；按子分类名升序遍历，结果确定）
    公开 函数 逆向检索(&自我, 分类: 映射类别, 英文词: &文本) -> 选项<字符串> {
        如果让 有值(分类映射) = 自我.映射表.截取(&分类) {
            让 可变 子节名列表: 向量<&字符串> = 分类映射.取全部键().收集();
            子节名列表.排序();
            对于 子节名 在 子节名列表 {
                对于 (母语词, 值项) 在 &分类映射[子节名] {
                    如果 值项 == 英文词 {
                        返回 有值(母语词.克隆());
                    }
                }
            }
        }
        无
    }

    /// 获取所有子分类名称（排序后返回，输出确定）
    公开 函数 取子分类(&自我, 分类: 映射类别) -> 向量<字符串> {
        让 可变 子节名列表 = 自我
            .映射表
            .截取(&分类)
            .变换(|子表| 子表.取全部键().克隆副本().收集::<向量<_>>())
            .取值或默认();
        子节名列表.排序();
        子节名列表
    }

    /// 统计映射条目数（扁平化后）
    公开 函数 条目数量(&自我, 分类: 映射类别) -> 无符号机器整数 {
        自我.取分类映射(分类).长度()
    }
}

/// 便捷函数：加载关键字映射
公开 函数 加载关键词映射<路径参: 作为引用<路径类型>>(
    语言包路径: 路径参,
) -> 结果<哈希映射<字符串, 字符串>, 加载错误> {
    让 可变 加载器 = 映射加载器::新建加载器(语言包路径);
    加载器.加载类别(映射类别::关键词表项)?;
    成功(加载器.取分类映射(映射类别::关键词表项))
}

/// 便捷函数：加载标准库映射
公开 函数 加载标准库映射<路径参: 作为引用<路径类型>>(
    语言包路径: 路径参,
) -> 结果<哈希映射<字符串, 字符串>, 加载错误> {
    让 可变 加载器 = 映射加载器::新建加载器(语言包路径);
    加载器.加载类别(映射类别::标准库表项)?;
    成功(加载器.取分类映射(映射类别::标准库表项))
}

/// 便捷函数：加载所有映射
公开 函数 加载全部映射<路径参: 作为引用<路径类型>>(
    语言包路径: 路径参,
) -> 结果<哈希映射<映射类别, 哈希映射<字符串, 字符串>>, 加载错误> {
    让 可变 加载器 = 映射加载器::新建加载器(语言包路径);
    加载器.加载全部()?;

    让 可变 全表 = 哈希映射::新建();
    全表.插入(
        映射类别::关键词表项,
        加载器.取分类映射(映射类别::关键词表项),
    );
    全表.插入(
        映射类别::标准库表项,
        加载器.取分类映射(映射类别::标准库表项),
    );
    全表.插入(
        映射类别::三方库表项,
        加载器.取分类映射(映射类别::三方库表项),
    );

    成功(全表)
}

/// 创建默认的关键字映射（内置备用）
///
/// 当语言包文件不可用时，使用此内置映射作为回退，
/// 覆盖 Rust 基础语法关键字、类型、错误处理、异步等常用构造。
公开 函数 创建内置关键词映射() -> 哈希映射<字符串, 字符串> {
    让 可变 映射表 = 哈希映射::新建();

    // 声明关键字
    映射表.插入("函数".转为(), "fn".转为());
    映射表.插入("变量".转为(), "let".转为());
    映射表.插入("可变".转为(), "mut".转为());
    映射表.插入("常量".转为(), "const".转为());
    映射表.插入("结构体".转为(), "struct".转为());
    映射表.插入("枚举".转为(), "enum".转为());
    映射表.插入("实现".转为(), "impl".转为());
    映射表.插入("特征".转为(), "trait".转为());
    映射表.插入("类型".转为(), "type".转为());
    映射表.插入("模块".转为(), "mod".转为());
    映射表.插入("公开".转为(), "pub".转为());
    映射表.插入("使用".转为(), "use".转为());
    映射表.插入("作为".转为(), "as".转为());
    映射表.插入("包".转为(), "crate".转为());
    映射表.插入("超级".转为(), "super".转为());
    映射表.插入("外部".转为(), "extern".转为());
    映射表.插入("静态".转为(), "static".转为());

    // 控制流
    映射表.插入("如果".转为(), "if".转为());
    映射表.插入("否则".转为(), "else".转为());
    映射表.插入("匹配".转为(), "match".转为());
    映射表.插入("循环".转为(), "loop".转为());
    映射表.插入("当".转为(), "while".转为());
    映射表.插入("对于".转为(), "for".转为());
    映射表.插入("在".转为(), "in".转为());
    映射表.插入("中断".转为(), "break".转为());
    映射表.插入("继续".转为(), "continue".转为());
    映射表.插入("返回".转为(), "return".转为());

    // 基本类型
    映射表.插入("整数".转为(), "i32".转为());
    映射表.插入("长整数".转为(), "i64".转为());
    映射表.插入("浮点数".转为(), "f64".转为());
    映射表.插入("单精度浮点数".转为(), "f32".转为());
    映射表.插入("文本".转为(), "str".转为());
    映射表.插入("布尔".转为(), "bool".转为());
    映射表.插入("字符".转为(), "char".转为());
    映射表.插入("字节".转为(), "u8".转为());

    // 特殊值
    映射表.插入("真".转为(), "true".转为());
    映射表.插入("假".转为(), "false".转为());
    映射表.插入("空".转为(), "()".转为());
    映射表.插入("自我".转为(), "self".转为());
    映射表.插入("自身".转为(), "Self".转为());

    // 错误处理
    映射表.插入("结果".转为(), "Result".转为());
    映射表.插入("选项".转为(), "Option".转为());
    映射表.插入("有值".转为(), "Some".转为());
    映射表.插入("无".转为(), "None".转为());
    映射表.插入("成功".转为(), "Ok".转为());
    映射表.插入("错误".转为(), "Err".转为());

    // 内存
    映射表.插入("引用".转为(), "&".转为());
    映射表.插入("解引用".转为(), "*".转为());
    映射表.插入("移动".转为(), "move".转为());
    映射表.插入("盒子".转为(), "Box".转为());

    // 异步
    映射表.插入("异步".转为(), "async".转为());
    映射表.插入("等待".转为(), "await".转为());
    映射表.插入("不安全".转为(), "unsafe".转为());
    映射表.插入("动态".转为(), "dyn".转为());

    映射表
}

#[配置(测试)]
模块 单元测试 {
    使用 超级::*;

    #[测试]
    函数 测试加载关键字映射() {
        // 独立临时目录：固定路径会在并行测试/多次运行间交叉污染
        让 临时 = 临时文件::建临时目录().解包();
        让 临时路径 = 临时.路径模块();

        // 写入测试映射表
        让 测试内容 = r#"
["声明"]
"函数" = "fn"
"变量" = "let"

["控制流"]
"如果" = "if"
"否则" = "else"
"#;
        标准库::文件系统::写入(临时路径.连接("keywords.toml"), 测试内容).解包();

        // 测试加载
        让 可变 加载器 = 映射加载器::新建加载器(临时路径);
        断言!(加载器.加载类别(映射类别::关键词表项).是否为成功());

        // 测试查询
        断言相等!(
            加载器.检索(映射类别::关键词表项, "函数"),
            有值("fn".转字符串())
        );
        断言相等!(
            加载器.检索(映射类别::关键词表项, "如果"),
            有值("if".转字符串())
        );
        断言相等!(加载器.检索(映射类别::关键词表项, "不存在"), 无);

        // 测试反向查询
        断言相等!(
            加载器.逆向检索(映射类别::关键词表项, "fn"),
            有值("函数".转字符串())
        );

        // 测试子分类
        让 子节列表 = 加载器.取子分类(映射类别::关键词表项);
        断言!(子节列表.包含(&"声明".转字符串()));
        断言!(子节列表.包含(&"控制流".转字符串()));

        // 测试条目数
        断言相等!(加载器.条目数量(映射类别::关键词表项), 4);
    }

    #[测试]
    函数 测试获取扁平化映射() {
        让 临时 = 临时文件::建临时目录().解包();
        让 临时路径 = 临时.路径模块();

        让 测试内容 = r#"
["分类A"]
"甲" = "alpha"
"乙" = "beta"

["分类B"]
"丙" = "gamma"
"#;
        标准库::文件系统::写入(临时路径.连接("stdlib.toml"), 测试内容).解包();

        让 可变 加载器 = 映射加载器::新建加载器(临时路径);
        加载器.加载类别(映射类别::标准库表项).解包();

        让 映射结果 = 加载器.取分类映射(映射类别::标准库表项);
        断言相等!(映射结果.长度(), 3);
        断言相等!(映射结果.截取("甲"), 有值(&"alpha".转字符串()));
        断言相等!(映射结果.截取("丙"), 有值(&"gamma".转字符串()));
        // 子分类名排序后返回，输出确定
        断言相等!(
            加载器.取子分类(映射类别::标准库表项),
            向量宏!["分类A", "分类B"]
        );
    }

    #[测试]
    函数 测试内置关键字映射() {
        让 映射表 = 创建内置关键词映射();

        断言相等!(映射表.截取("函数"), 有值(&"fn".转字符串()));
        断言相等!(映射表.截取("如果"), 有值(&"if".转字符串()));
        断言相等!(映射表.截取("整数"), 有值(&"i32".转字符串()));
        断言!(映射表.长度() > 30);
    }

    /// 加载全部 把 module_paths.toml 并入标准库分类的 ["模块路径"] 子节，
    /// 且同名键 stdlib 优先（与 映射管理器::自目录加载 的覆盖顺序语义一致）
    #[测试]
    函数 测试全量加载并入模块路径且标准库优先() {
        让 临时 = 临时文件::建临时目录().解包();
        让 临时路径 = 临时.路径模块();

        标准库::文件系统::写入(
            临时路径.连接("keywords.toml"),
            "[\"声明\"]\n\"函数\" = \"fn\"\n",
        )
        .解包();
        // stdlib 与 module_paths 含同名键，stdlib 必须优先
        标准库::文件系统::写入(
            临时路径.连接("stdlib.toml"),
            "[\"模块路径\"]\n\"标准库\" = \"std\"\n\"文件系统\" = \"std::fs\"\n",
        )
        .解包();
        标准库::文件系统::写入(
            临时路径.连接("module_paths.toml"),
            "[\"模块路径\"]\n\"文件系统\" = \"fs\"\n\"字符串\" = \"string\"\n",
        )
        .解包();

        让 可变 加载器 = 映射加载器::新建加载器(临时路径);
        加载器.加载全部().解包();

        让 模块路径子节 = 加载器
            .取子映射(映射类别::标准库表项, "模块路径")
            .解包();
        // module_paths 的独有键并入标准库分类
        断言相等!(模块路径子节.截取("字符串"), 有值(&"string".转字符串()));
        // 同名键 stdlib 优先（module_paths 仅补充缺失键）
        断言相等!(模块路径子节.截取("文件系统"), 有值(&"std::fs".转字符串()));
    }

    /// 仅 keywords.toml 时 加载全部 不应报错（stdlib/module_paths/crates 均可选）
    #[测试]
    函数 测试全量加载标准库可选() {
        让 临时 = 临时文件::建临时目录().解包();
        让 临时路径 = 临时.路径模块();
        标准库::文件系统::写入(
            临时路径.连接("keywords.toml"),
            "[\"声明\"]\n\"函数\" = \"fn\"\n",
        )
        .解包();

        让 可变 加载器 = 映射加载器::新建加载器(临时路径);
        加载器.加载全部().解包();
        断言相等!(
            加载器.检索(映射类别::关键词表项, "函数"),
            有值("fn".转字符串())
        );
    }

    /// 非 UTF-8（GBK 编码）的文件名被正确转码为 UTF-8 分类键，
    /// 而不是被 lossy 替换或与其它文件碰撞
    #[测试]
    #[配置(Unix系统)]
    函数 测试非utf8文件名转码为utf8() {
        使用 标准库::操作系统模块::Unix系统::外部接口模块::操作系统字符串扩展;

        让 临时 = 临时文件::建临时目录().解包();
        让 临时路径 = 临时.路径模块();
        让 库目录 = 临时路径.连接("crates");
        标准库::文件系统::递归创建目录(&库目录).解包();
        // keywords.toml 为必需文件
        标准库::文件系统::写入(
            临时路径.连接("keywords.toml"),
            "[\"声明\"]\n\"函数\" = \"fn\"\n",
        )
        .解包();

        // “序列化”的 GBK 字节：序=d0f2 列=c1d0 化=bbaf
        让 编码名 = 标准库::外部接口模块::操作系统字符串::从向量构造(向量宏![0xD0, 0xF2, 0xC1, 0xD0, 0xBB, 0xAF]);
        让 磁盘路径 = 库目录.连接(编码名).设扩展名("toml");
        标准库::文件系统::写入(&磁盘路径, "[\"标识符\"]\n\"服务器\" = \"Server\"\n").解包();

        // 前置断言：该文件名的字节确实不是合法 UTF-8
        断言!(磁盘路径.取文件名().解包().取字符串引用().是否为无());

        让 可变 加载器 = 映射加载器::新建加载器(临时路径);
        加载器.加载全部().解包();

        // 分类键应为转码后的“序列化/标识符”（GB18030 解码），映射可正常查询
        让 子节 = 加载器
            .取子映射(映射类别::三方库表项, "序列化/标识符")
            .解包();
        断言相等!(子节.截取("服务器"), 有值(&"Server".转字符串()));
    }

    /// 加载错误分类：文件缺失 / TOML 解析失败；第三方目录不存在静默成功
    #[测试]
    函数 测试加载器错误分支() {
        让 临时 = 临时文件::建临时目录().解包();
        让 可变 加载器 = 映射加载器::新建加载器(临时.路径模块());
        // 空目录加载关键字：FileMissing
        断言!(模式匹配!(
            加载器.加载类别(映射类别::关键词表项),
            错误(加载错误::文件缺失 { .. })
        ));
        // crates/ 目录不存在：静默 成功
        加载器.加载类别(映射类别::三方库表项).解包();
        断言相等!(加载器.条目数量(映射类别::三方库表项), 0);
        // 未加载的分类查询全为 无 / 空
        断言相等!(
            加载器.取子分类(映射类别::标准库表项),
            新建向量::<字符串>::新建()
        );
        断言!(
            加载器
                .取子映射(映射类别::标准库表项, "标识符")
                .是否为无()
        );
        断言相等!(加载器.检索(映射类别::标准库表项, "x"), 无);
        断言相等!(加载器.逆向检索(映射类别::标准库表项, "x"), 无);

        // 损坏 TOML：ParseFailed
        标准库::文件系统::写入(
            临时.路径模块().连接("keywords.toml"),
            "[\"声明\"]\n\"a\"=\"1\"\n\"a\"=\"2\"\n",
        )
        .解包();
        断言!(模式匹配!(
            加载器.加载类别(映射类别::关键词表项),
            错误(加载错误::解析失败 { .. })
        ));
        // 解析配置节 直接校验同样报错
        断言!(解析配置节("not = = toml").是否为错误());
    }

    /// 第三方目录：多文件、多子节按 `文件名/节名` 归类，非 toml 忽略，
    /// 扁平化查询/反查可用
    #[测试]
    函数 测试加载第三方多文件() {
        让 临时 = 临时文件::建临时目录().解包();
        让 目录 = 临时.路径模块();
        标准库::文件系统::写入(目录.连接("keywords.toml"), "[\"声明\"]\n\"函数\" = \"fn\"\n").解包();
        让 库目录 = 目录.连接("crates");
        标准库::文件系统::递归创建目录(&库目录).解包();
        标准库::文件系统::写入(
            库目录.连接("serde.toml"),
            "[\"模块路径\"]\n\"序列化\" = \"serde\"\n[\"标识符\"]\n\"序列\" = \"Serialize\"\n",
        )
        .解包();
        标准库::文件系统::写入(
            库目录.连接("tokio.toml"),
            "[\"模块路径\"]\n\"异步\" = \"tokio\"\n",
        )
        .解包();
        // 非 toml 文件必须忽略
        标准库::文件系统::写入(库目录.连接("README.md"), "ignore me").解包();

        让 可变 加载器 = 映射加载器::新建加载器(目录);
        加载器.加载类别(映射类别::三方库表项).解包();

        让 可变 子节列表 = 加载器.取子分类(映射类别::三方库表项);
        子节列表.排序();
        断言相等!(
            子节列表,
            向量宏![
                "serde/标识符".转字符串(),
                "serde/模块路径".转字符串(),
                "tokio/模块路径".转字符串(),
            ]
        );
        断言相等!(
            加载器.检索(映射类别::三方库表项, "序列"),
            有值("Serialize".转字符串())
        );
        断言相等!(
            加载器.逆向检索(映射类别::三方库表项, "tokio"),
            有值("异步".转字符串())
        );
        // 扁平化后共 3 条
        断言相等!(加载器.条目数量(映射类别::三方库表项), 3);
    }

    /// 加载全部 全量链路：stdlib 存在则加载；module_paths 仅补充 stdlib
    /// 缺失的键（stdlib 优先）；crates 目录一并加载；
    /// 加载全部映射 便捷函数返回三个分类
    #[测试]
    函数 测试全量加载并入模块路径优先级() {
        让 临时 = 临时文件::建临时目录().解包();
        让 目录 = 临时.路径模块();
        标准库::文件系统::写入(目录.连接("keywords.toml"), "[\"声明\"]\n\"函数\" = \"fn\"\n").解包();
        标准库::文件系统::写入(
            目录.连接("stdlib.toml"),
            "[\"标识符\"]\n\"字符串\" = \"String\"\n[\"模块路径\"]\n\"格式化\" = \"fmt\"\n",
        )
        .解包();
        // module_paths：与 stdlib 同键（stdlib 胜）+ 独有键（补入）
        标准库::文件系统::写入(
            目录.连接("module_paths.toml"),
            "[\"模块路径\"]\n\"格式化\" = \"SHOULD_NOT_WIN\"\n\"输入输出\" = \"io\"\n",
        )
        .解包();
        让 库目录 = 目录.连接("crates");
        标准库::文件系统::递归创建目录(&库目录).解包();
        标准库::文件系统::写入(
            库目录.连接("serde.toml"),
            "[\"标识符\"]\n\"序列\" = \"Serialize\"\n",
        )
        .解包();

        让 全表 = 加载全部映射(目录).期望("全量加载应成功");
        断言相等!(全表.长度(), 3, "三个分类都应存在");
        让 可变 加载器 = 映射加载器::新建加载器(目录);
        加载器.加载全部().解包();
        让 模块路径子节 = 加载器
            .取子映射(映射类别::标准库表项, "模块路径")
            .解包();
        断言相等!(
            模块路径子节.截取("格式化"),
            有值(&"fmt".转字符串()),
            "stdlib 同键优先"
        );
        断言相等!(模块路径子节.截取("输入输出"), 有值(&"io".转字符串()), "独有键应补入");
        断言相等!(
            加载器.检索(映射类别::标准库表项, "字符串"),
            有值("String".转字符串())
        );
        断言相等!(加载器.条目数量(映射类别::三方库表项), 1);

        // 便捷函数
        断言相等!(
            加载标准库映射(目录).解包().截取("字符串"),
            有值(&"String".转字符串())
        );
    }

    /// 分类元信息：默认文件名稳定，显示名非空且随分类变化
    #[测试]
    函数 测试分类元信息() {
        断言相等!(
            映射类别::关键词表项.默认文件名(),
            "keywords.toml"
        );
        断言相等!(映射类别::标准库表项.默认文件名(), "stdlib.toml");
        断言相等!(
            映射类别::三方库表项.默认文件名(),
            "crates.toml"
        );
        让 名字列表 = [
            映射类别::关键词表项.显示名称(),
            映射类别::标准库表项.显示名称(),
            映射类别::三方库表项.显示名称(),
        ];
        对于 显示名 在 &名字列表 {
            断言!(!显示名.是否为空());
        }
        断言不等!(名字列表[0], 名字列表[2]);
        // UTF-8 文件名走快速路径原样返回
        让 待解码 = 标准库::外部接口模块::操作系统串::新建("普通名字");
        断言相等!(解码系统名(待解码), "普通名字");
    }
}
