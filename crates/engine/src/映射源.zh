//! 映射源模块 - 从 TOML 文件载入映射表
//!
//! 提供映射数据的载入和管理，支持按类别组织：
//! - 关键字映射（词法处理阶段）
//! - 标准库映射（语义处理阶段）
//! - 第三方库映射（按需载入，来自第三方库子目录）

使用 标准库::集合::哈希映射;
使用 标准库::文件系统;
使用 标准库::路径::{路径类型, 路径缓冲};
使用 标准库::格式化模块::格式化参数;

使用 包::故障::{载入故障, 载入目标};

/// 节组织的映射表：节名 → (母语词 → 英文)
公开 类型 节表 = 哈希映射<字符串, 哈希映射<字符串, 字符串>>;

/// 按**书写序**组织的映射表：[(节名, [(母语词, 英文)])]
///
/// 与 [`节表`] 的唯一区别是保留 TOML 里的先后（哈希映射会把它抹掉）：
/// 诊断反查表要靠这个顺序在同一英文值的多个母语同义词里选主词条，
/// 见 [`解析有序映射节`]。
公开 类型 有序节序列 = 向量<(字符串, 向量<(字符串, 字符串)>)>;

/// 危险等级元数据节：词条 → 会恐慌 / 会改写 / 纯安全（不参与转译映射）
公开 常量 危险等级节: &文本 = "危险等级";
/// 危险备注元数据节：词条 → 人类可读的风险说明（不参与转译映射）
公开 常量 危险备注节: &文本 = "危险备注";

/// 元数据节不进入关键字/别名映射（否则 `"取列" = "会恐慌"` 会被当成词条）
公开 函数 是否元数据节(节名参数: &文本) -> 布尔 {
    节名参数 == 危险等级节 || 节名参数 == 危险备注节
}

/// 词条危险等级：两类风险可同时存在，均为假即「纯安全」
///
/// - 会恐慌：映射目标在运行时可能崩溃（越界、类型不符、解包、期望等）；
/// - 会改写：词法层任意位置替换，同名自定义标识符也会被改写（关键字/宏类词条）。
#[派生(调试, 克隆, 可复制, 部分相等, 全等, 默认, 哈希)]
公开 结构体 危险等级 {
    /// 会恐慌
    公开 会恐慌: 布尔,
    /// 会改写标识符
    公开 会改写: 布尔,
}

实现 危险等级 {
    /// 纯安全
    公开 常量 全安全: 自身 = 自身 {
        会恐慌: 假,
        会改写: 假,
    };
    /// 会恐慌
    公开 常量 必恐慌: 自身 = 自身 {
        会恐慌: 真,
        会改写: 假,
    };
    /// 会改写标识符
    公开 常量 必改写: 自身 = 自身 {
        会恐慌: 假,
        会改写: 真,
    };
    /// 两种风险并存
    公开 常量 恐慌加改写: 自身 = 自身 {
        会恐慌: 真,
        会改写: 真,
    };

    /// 解析标注值：`会恐慌` / `会改写` / `纯安全`，多风险用 `+`（也接受 `,` `|`）连接
    公开 函数 解析等级(标注文本: &文本) -> 选项<自身> {
        让 可变 等级值 = 自身::全安全;
        对于 片段 在 标注文本.分割(['+', ',', '|']).变换(文本::裁剪) {
            如果 片段.是否为空() {
                继续;
            }
            匹配 片段 {
                "panic" => 等级值.会恐慌 = 真,
                "rewrite" => 等级值.会改写 = 真,
                "safe" => {}
                _ => 返回 无,
            }
        }
        有值(等级值)
    }

    /// 是否纯安全
    公开 函数 是安全(自我) -> 布尔 {
        自我 == 自身::全安全
    }

    /// 稳定标识（Markdown/校验输出用）
    公开 函数 代号(自我) -> 静态字符串引用 {
        匹配 (自我.会恐慌, 自我.会改写) {
            (假, 假) => "safe",
            (真, 假) => "panic",
            (假, 真) => "rewrite",
            (真, 真) => "panic+rewrite",
        }
    }

    /// 词条表显示标签（与表头图例一致）
    公开 函数 标签(自我) -> 静态字符串引用 {
        匹配 (自我.会恐慌, 自我.会改写) {
            (假, 假) => "纯安全",
            (真, 假) => "会 panic",
            (假, 真) => "会改写标识符",
            (真, 真) => "会 panic + 会改写标识符",
        }
    }
}

/// 词条危险信息：等级 + 可选备注（多风险时必须写明）
#[派生(调试, 克隆, 部分相等, 全等, 默认)]
公开 结构体 危险详情 {
    /// 危险等级
    公开 等级: 危险等级,
    /// 备注（空串表示无额外说明）
    公开 备注: 字符串,
}

/// 命中即视为一定会恐慌的映射目标（与接收者无关，如选项/结果的解包）
///
/// 获取 / 移除 / 插入等是否恐慌取决于接收者类型，不在此自动判定，
/// 须由映射表在 `["危险等级"]` 中显式标注（见 docs/third-party-mapping.md）。
公开 常量 恒恐慌目标表: &[&文本] = &[
    "unwrap",
    "expect",
    "unwrap_err",
    "expect_err",
    "get_unwrap",
    "get_ref_unwrap",
    "panic",
    "todo",
    "unimplemented",
    "unreachable",
];

/// 映射目标是否属于「一定恐慌」集合
公开 函数 恒恐慌目标(编译目标: &文本) -> 布尔 {
    恒恐慌目标表.包含(&编译目标)
}

/// 从已解析的节表中提取危险元数据（`["危险等级"]` + `["危险备注"]`）
///
/// 非法等级值按「会恐慌」处理并记录警告：宁可高估风险，也不能把
/// 会恐慌的词条静默标成纯安全。
公开 函数 危险从节表(节表值: &节表) -> 哈希映射<字符串, 危险详情> {
    让 可变 危险表映射: 哈希映射<字符串, 危险详情> = 哈希映射::新建();
    如果让 有值(等级表) = 节表值.获取(危险等级节) {
        对于 (词条名, 原始文本) 在 等级表 {
            让 等级值 = 匹配 危险等级::解析等级(原始文本) {
                有值(已解析等级) => 已解析等级,
                无 => {
                    包::警告日志!(
                        "映射源",
                        "危险等级 [{}] 的值 {:?} 无法识别，按会恐慌处理",
                        词条名,
                        原始文本
                    );
                    危险等级::必恐慌
                }
            };
            危险表映射.取条目(词条名.克隆值()).或用缺省().等级 = 等级值;
        }
    }
    如果让 有值(备注表) = 节表值.获取(危险备注节) {
        对于 (词条名, 备注内容) 在 备注表 {
            危险表映射.取条目(词条名.克隆值()).或用缺省().备注 = 备注内容.克隆值();
        }
    }
    危险表映射
}

/// 解析 TOML 内容中的危险元数据（供载入器与校验工具共用）
公开 函数 解析危险节表(内容文本: &文本) -> 结果<哈希映射<字符串, 危险详情>, TOML处理::反序列化模块::错误特征> {
    让 节表值 = 解析映射节(内容文本)?;
    成功(危险从节表(&节表值))
}

/// 按**书写顺序**解析「节 → 条目」清单（用向量而非哈希映射）
///
/// 这是映射源 TOML 的唯一解析实现：[`解析映射节`] 就是把这里的结果
/// 收敛成哈希映射（一个文件只解析一遍，不拿顺序的消费者也不会多付代价）。
/// 顺序保得住的原因：自定义访问器直接接收序列化框架按文档顺序投递的键值对，
/// 不把它们塞进哈希映射就丢不了序。注意 TOML 1.x 起默认表按键排序（0.8 走
/// TOML 编辑后端天然保序），故工作区层启用了保序特性，
/// 让 `toml::Value::Table` 同样保持书写序——两条通道顺序因此一致。
/// 诊断反查表需要在「同一英文值有多个母语同义词」时选出唯一胜出者，依据
/// 正是书写序（先写的是主词条，见诊断反查表构建处）。
///
/// 跳过口径与既有实现一致：非表节、非字符串条目记告警后跳过（`RZ_LOG=warn`
/// 可见），只有 TOML 本身语法非法才报错（由调用方按场景本地化错误消息）。
公开 函数 解析有序映射节(内容文本: &文本) -> 结果<有序节序列, TOML处理::反序列化模块::错误特征> {
    让 文档: 有序文档 = TOML处理::解析字符串(内容文本)?;
    成功(文档
        .0
        .消费迭代()
        .过滤映射(|(节名, 节体值)| 匹配 节体值 {
            有序节体::非表 => {
                包::警告日志!("映射源", "节 [{}] 不是表结构，已跳过", 节名);
                无
            }
            有序节体::条目表(条目集) => {
                让 可变 保留集: 向量<(字符串, 字符串)> = 向量::新建();
                对于 (母语词, 条目值) 在 条目集 {
                    匹配 条目值 {
                        TOML处理::TOML值::字符串值(英文值) => 保留集.推((母语词, 英文值)),
                        _ => 包::警告日志!(
                            "映射源",
                            "节 [{}] 条目 {} 的值不是字符串，已跳过",
                            节名,
                            母语词
                        ),
                    }
                }
                (!保留集.是否为空()).然后有值((节名, 保留集))
            }
        })
        .收集())
}

/// 文档本体：顶层一定是表（TOML 文档），收下的节按书写序排列
结构体 有序文档(向量<(字符串, 有序节体)>);

/// 节内容：表 → 按书写序的 `(母语词, 值)`；其他形态 → 记为「不是表结构」
枚举 有序节体 {
    条目表(向量<(字符串, TOML处理::TOML值)>),
    非表,
}

实现<'甲> 序列化属性::可反序列化<'甲> 对于 有序文档 {
    函数 反序列化<反序列化目标: 序列化属性::反序列化器<'甲>>(反序列化输入: 反序列化目标) -> 结果<自身, 反序列化目标::错误特征> {
        使用 序列化属性::反序列化模块::访问器;

        结构体 文档访问器;
        实现<'甲> 访问器<'甲> 对于 文档访问器 {
            类型 JSON值 = 有序文档;
            函数 期待格式(&自我, 格式器: &可变 格式化参数<'_>) -> 标准库::格式化模块::结果 {
                格式器.写入字符串("映射表节")
            }
            函数 访问映射<映射类型: 序列化属性::反序列化模块::映射访问<'甲>>(
                自我,
                可变 访问源: 映射类型,
            ) -> 结果<有序文档, 映射类型::错误特征> {
                让 可变 节集 = 向量::新建();
                当让 有值(节名) = 访问源.下一键::<字符串>()? {
                    节集.推((节名, 访问源.下一值::<有序节体>()?));
                }
                成功(有序文档(节集))
            }
        }

        反序列化输入.反序列化映射(文档访问器)
    }
}

实现<'甲> 序列化属性::可反序列化<'甲> 对于 有序节体 {
    函数 反序列化<反序列化目标: 序列化属性::反序列化器<'甲>>(反序列化输入: 反序列化目标) -> 结果<自身, 反序列化目标::错误特征> {
        使用 序列化属性::反序列化模块::访问器;

        /// 表按书写序收下条目；非表形态（字符串/整数/布尔/数组等）一律记为
        /// 「不是表结构」，由上层告警跳过（这些方法若不实现，序列化框架默认会
        /// 把它们当成类型错误，把「跳过」变成「整个文件解析失败」）
        结构体 节体访问器;
        实现<'甲> 访问器<'甲> 对于 节体访问器 {
            类型 JSON值 = 有序节体;
            函数 期待格式(&自我, 格式器: &可变 格式化参数<'_>) -> 标准库::格式化模块::结果 {
                格式器.写入字符串("母语词 = \"英文原名\" 形式的条目表")
            }
            函数 访问映射<映射类型: 序列化属性::反序列化模块::映射访问<'甲>>(
                自我,
                可变 访问源: 映射类型,
            ) -> 结果<有序节体, 映射类型::错误特征> {
                让 可变 条目集 = 向量::新建();
                当让 有值(母语词) = 访问源.下一键::<字符串>()? {
                    // 叶子值走 TOML 值类型：任何 TOML 类型都不会因此报错
                    条目集.推((母语词, 访问源.下一值::<TOML处理::TOML值>()?));
                }
                成功(有序节体::条目表(条目集))
            }
            函数 访问文本<错误类型: 序列化属性::反序列化模块::错误特征>(自我, _值: &文本) -> 结果<有序节体, 错误类型> {
                成功(有序节体::非表)
            }
            函数 访问布尔<错误类型: 序列化属性::反序列化模块::错误特征>(自我, _值: 布尔) -> 结果<有序节体, 错误类型> {
                成功(有序节体::非表)
            }
            函数 访问长整数<错误类型: 序列化属性::反序列化模块::错误特征>(自我, _值: 长整数) -> 结果<有序节体, 错误类型> {
                成功(有序节体::非表)
            }
            函数 访问无符号长整数<错误类型: 序列化属性::反序列化模块::错误特征>(自我, _值: 无符号长整数) -> 结果<有序节体, 错误类型> {
                成功(有序节体::非表)
            }
            函数 访问浮点数<错误类型: 序列化属性::反序列化模块::错误特征>(自我, _值: 浮点数) -> 结果<有序节体, 错误类型> {
                成功(有序节体::非表)
            }
            函数 访问单元<错误类型: 序列化属性::反序列化模块::错误特征>(自我) -> 结果<有序节体, 错误类型> {
                成功(有序节体::非表)
            }
            函数 访问序列<序列类型: 序列化属性::反序列化模块::序列访问<'甲>>(
                自我,
                可变 序列源: 序列类型,
            ) -> 结果<有序节体, 序列类型::错误特征> {
                当 序列源.下一元素::<序列化属性::反序列化模块::忽略任意>()?.是否为有值() {}
                成功(有序节体::非表)
            }
        }

        反序列化输入.反序列化任意(节体访问器)
    }
}

/// 从有序视图（[`已解析文档::有序视图`]）里取一节的有序条目（不存在则空）
公开 函数 有序节条目<'甲>(
    有序视图值: &'甲 有序节序列,
    节名参数: &文本,
) -> &'甲 [(字符串, 字符串)] {
    有序视图值
        .迭代()
        .查找(|(节名, _)| 节名 == 节名参数)
        .变换(|(_, 条目集)| 条目集.切片())
        .取值或默认()
}

/// 是否「母语键」（含非 ASCII 字符）
///
/// `"format" = "fmt"` 这类纯英文修正项不能进诊断反查表（否则译文里会
/// 出现英文值），模块路径与标识符表里混有它们。
公开 函数 是母语词条(键名参数: &文本) -> 布尔 {
    !键名参数.逐字符()
        .全部(|字符值| 字符值.是ASCII字母数字() || 字符值 == '_' || 字符值 == '-')
}

/// 单个映射源文件的**一次解析**结果（载入器专用）
///
/// 载入一个语言包时，同一份 TOML 往往同时需要三种视图：正向映射用的哈希映射
/// 节表、诊断反查候选用的书写序条目、危险元数据。逐条调用
/// [`解析映射节`] / [`解析有序映射节`] /
/// [`解析危险节表`] 会把同一个文件解析三遍（中文语言包 26 个文件，
/// 载入耗时接近翻倍），因此这里解析一次、按需取视图。几个旧函数签名不变，
/// 仍供只要一种视图的调用方（命令行校验工具等）使用。
#[派生(调试, 克隆)]
公开 结构体 已解析文档 {
    有序节: 有序节序列,
}

实现 已解析文档 {
    /// 解析整个文件（与 [`解析有序映射节`] 同口径：只有 TOML
    /// 本身语法非法才报错，非表节与非字符串条目告警后跳过）
    公开 函数 解析文档(内容文本: &文本) -> 结果<自身, TOML处理::反序列化模块::错误特征> {
        成功(自身 {
            有序节: 解析有序映射节(内容文本)?,
        })
    }

    /// 按书写序排列的「节 → 条目」清单
    公开 函数 有序视图(&自我) -> &有序节序列 {
        &自我.有序节
    }

    /// 取一节的有序条目（不存在则为空）
    公开 函数 节条目们(&自我, 节名参数: &文本) -> &[(字符串, 字符串)] {
        有序节条目(&自我.有序节, 节名参数)
    }

    /// 收敛为「节 → (母语词 → 英文)」哈希映射（等价于 [`解析映射节`]）
    公开 函数 节表(&自我) -> 节表 {
        自我.有序节
            .迭代()
            .变换(|(节名, 条目集)| (节名.克隆值(), 条目集.迭代().克隆副本().收集()))
            .收集()
    }

    /// 危险元数据（`["危险等级"]` / `["危险备注"]` 两节，等价于
    /// [`解析危险节表`]；语法已在本文件解析成功，这里不会再失败）
    公开 函数 危险表(&自我) -> 哈希映射<字符串, 危险详情> {
        危险从节表(&自我.节表())
    }

    /// 把 `["模块路径"]` / `["标识符"]` 两节并入两张正向映射表（等价于
    /// [`合并模块路径与标识符节`]，但不重复解析）
    公开 函数 合并模块路径与标识符(
        &自我,
        模块路径映射: &可变 哈希映射<字符串, 字符串>,
        别名映射: &可变 哈希映射<字符串, 字符串>,
    ) {
        模块路径映射.扩展(自我.节条目们("模块路径").迭代().克隆副本());
        别名映射.扩展(自我.节条目们("标识符").迭代().克隆副本());
    }
}

/// 解析 TOML 内容为“节 → (母语词 → 英文)”二级表（两个载入器共用的单一解析实现）
///
/// 本函数是 [`解析有序映射节`] 的收敛视图（同一遍解析，只是丢掉
/// 顺序），跳过口径与告警文案也完全由那边负责。
公开 函数 解析映射节(内容文本: &文本) -> 结果<节表, TOML处理::反序列化模块::错误特征> {
    成功(解析有序映射节(内容文本)?
        .消费迭代()
        .变换(|(节名, 条目集)| (节名, 条目集.消费迭代().收集()))
        .收集())
}

/// 把节表扁平化为单一映射：按节名升序合并，同名键冲突时胜出者确定
/// （哈希映射遍历顺序随机会导致多次载入结果不一致）
公开 函数 摊平节表(节表值: &节表) -> 哈希映射<字符串, 字符串> {
    让 可变 结果表 = 哈希映射::新建();
    让 可变 名称表: 向量<&字符串> = 节表值
        .取全部键()
        .日志过滤器(|节名| !是否元数据节(节名))
        .收集();
    名称表.排序();
    对于 节名 在 名称表 {
        对于 (母语词, 英文名) 在 &节表值[节名] {
            结果表.置入(母语词.克隆值(), 英文名.克隆值());
        }
    }
    结果表
}

/// 解析“模块路径 + 标识符”两节格式的 TOML（stdlib.toml 与 crates/*.toml 通用）
///
/// - `["模块路径"]` 节 → 合并到模块路径映射（如 `"线程" = "std::thread"`）
/// - `["标识符"]` 节 → 合并到标识符别名映射（如 `"字符串" = "String"`）
///
/// 返回原始 TOML 错误，由调用方结合文件路径/数据源上下文转为 [`载入故障`]。
公开 函数 合并模块路径与标识符节(
    内容文本: &文本,
    模块路径映射: &可变 哈希映射<字符串, 字符串>,
    别名映射: &可变 哈希映射<字符串, 字符串>,
) -> 结果<(), TOML处理::反序列化模块::错误特征> {
    让 节表值 = 解析映射节(内容文本)?;
    如果让 有值(条目集) = 节表值.获取("模块路径") {
        模块路径映射.扩展(条目集.迭代().变换(|(键项, 值项)| (键项.克隆值(), 值项.克隆值())));
    }
    如果让 有值(条目集) = 节表值.获取("标识符") {
        别名映射.扩展(条目集.迭代().变换(|(键项, 值项)| (键项.克隆值(), 值项.克隆值())));
    }
    成功(())
}

/// 把文件名字节转成 UTF-8 字符串（作为映射分类键）
///
/// - 本身是 UTF-8 时直接返回；
/// - 非 UTF-8 字节按常见 CJK 编码依次尝试解码（国标编码 → 日文位移编码 → 大五码 →
///   韩文编码 → 日文扩展编码），首个解码无错误者即为转码结果，
///   把“非 UTF-8 文件名”真正转成 UTF-8（而非丢弃字节）；
/// - 所有编码都失败时回退有损转写（保留可显示部分，不会崩溃）。
///
/// 平台差异：只有 Unix 允许文件名是任意字节，因此才需要字节级转码；
/// Windows 的文件名在系统层面就是 UTF-16，正常文件名（含中文/日文等）
/// `to_str()` 总能成功，不会进入转码分支，也不会被误判成国标编码乱码；
/// 唯一极端情况是文件名字含孤立代理码元（正常工具造不出来），
/// 此时回退为明确的替换符 `�` 而非错误解码。
函数 解码系统文件名(文件名词: &标准库::外部接口模块::操作系统串) -> 字符串 {
    如果让 有值(文本视图) = 文件名词.取字符串引用() {
        返回 文本视图.转字符串();
    }
    // Unix 下可取原始字节逐编码尝试；其他平台（Windows 等）直接走有损兜底
    #[配置(Unix系统)]
    {
        使用 标准库::操作系统模块::Unix系统::外部接口模块::操作系统串扩展;
        让 字节数据 = 文件名词.转为字节();
        // 按 CJK 使用频度排序：中文国标编码（覆盖国标扩展）优先，日文位移编码次之。
        // 注：部分字节序列在多种编码下都能无错误解码，顺序只是概率取舍，
        // 无法在没有额外元数据时做到 100% 正确。
        对于 编码项 在 [
            编码库::国标18030,
            编码库::日文位移编码,
            编码库::大五码,
            编码库::韩文编码,
            编码库::日文扩展编码,
        ] {
            让 (解码结果, _, 有错误) = 编码项.解码(字节数据);
            如果 !有错误 {
                返回 解码结果.转所有权();
            }
        }
    }
    文件名词.转有损字符串().转所有权()
}

/// 映射表分类
#[派生(调试, 克隆, 可复制, 部分相等, 全等, 哈希)]
公开 枚举 映射类别 {
    /// 关键字（词法处理阶段）
    关键字类,
    /// 标准库（语义处理阶段）
    标准库类,
    /// 第三方库（按需载入）
    三方库类,
}

实现 映射类别 {
    /// 获取分类对应的默认文件名
    公开 函数 默认文件名(&自我) -> 静态字符串引用 {
        匹配 自我 {
            映射类别::关键字类 => "keywords.toml",
            映射类别::标准库类 => "stdlib.toml",
            映射类别::三方库类 => "crates.toml",
        }
    }

    /// 获取分类的显示名称（随当前语言变化）
    公开 函数 显示名(&自我) -> 字符串 {
        让 消息键 = 匹配 自我 {
            映射类别::关键字类 => "mapping_cat_keywords",
            映射类别::标准库类 => "mapping_cat_stdlib",
            映射类别::三方库类 => "mapping_cat_third_party",
        };
        包::语言::取消息(消息键)
    }
}

/// 映射表载入器 - 从 TOML 文件载入映射数据
///
/// 从语言包目录中按分类载入映射表，支持关键字/标准库单文件载入
/// 以及第三方库目录下多文件合并载入。
#[派生(调试, 克隆)]
公开 结构体 映射载入器 {
    /// 语言包根目录
    根目录: 路径缓冲,
    /// 已载入的映射表（按分类和子分类组织）
    映射表们: 哈希映射<映射类别, 哈希映射<字符串, 哈希映射<字符串, 字符串>>>,
}

实现 映射载入器 {
    /// 创建新的载入器
    公开 函数 新建<路径参数: 作为引用<路径类型>>(语言包路径: 路径参数) -> 自身 {
        让 根目录 = 语言包路径.作为引用方法().转路径缓冲();
        自身 {
            根目录,
            映射表们: 哈希映射::新建(),
        }
    }

    /// 载入指定分类的映射表
    公开 函数 载入(&可变 自我, 类别: 映射类别) -> 结果<(), 载入故障> {
        // 第三方库是目录，包含多个文件
        如果 类别 == 映射类别::三方库类 {
            返回 自我.载入第三方目录();
        }

        让 文件路径 = 自我.根目录.连接(类别.默认文件名());

        如果 !文件路径.存在() {
            返回 错误(载入故障::文件缺失 {
                目标: 载入目标::映射表,
                文件路径: 格式化!("{:?}", 文件路径),
            });
        }

        让 内容文本 = 文件系统::读取全部字符串(&文件路径).映射错误(|坏| 载入故障::读取失败 {
            目标: 载入目标::映射表,
            文件路径: 无,
            详情: 坏.转字符串(),
        })?;

        让 类别映射 =
            解析映射节(&内容文本).映射错误(|坏| 载入故障::解析失败 {
                目标: 载入目标::映射表,
                文件路径: 无,
                详情: 坏.转字符串(),
            })?;
        自我.映射表们.置入(类别, 类别映射);
        成功(())
    }

    /// 载入第三方库目录下的所有 TOML 文件
    函数 载入第三方目录(&可变 自我) -> 结果<(), 载入故障> {
        让 目录路径 = 自我.根目录.连接("crates");

        如果 !目录路径.存在() {
            // 目录不存在，静默返回
            返回 成功(());
        }

        让 可变 合并表 = 哈希映射::新建();

        // 遍历目录中的所有 .toml 文件（按文件名排序，读取目录顺序未定义，
        // 排序后合并结果与 映射管理器::从目录载入 保持一致且确定）；
        // 读取目录或条目读取失败必须报错（不能静默吞掉，否则映射整体丢失）
        让 可变 映射文件表: 向量<路径缓冲> = 文件系统::读取目录(&目录路径)
            .映射错误(|坏| 载入故障::目录读取失败 {
                详情: 坏.转字符串(),
            })?
            .收集::<结果<向量<_>, _>>()
            .映射错误(|坏| 载入故障::目录读取失败 {
                详情: 坏.转字符串(),
            })?
            .消费迭代()
            .变换(|条目结果| 条目结果.条目路径())
            .日志过滤器(|路径项| 路径项.取扩展名().而后映射(|后缀| 后缀.取字符串引用()) == 有值("toml"))
            .收集();
        映射文件表.排序();

        对于 文件路径 在 映射文件表 {
            // 获取文件名（不含扩展名）作为分类标识；
            // 非 UTF-8 文件名按常见编码转码为 UTF-8（解码系统文件名），
            // 避免多个文件碰撞合并或分类键变为替换符
            让 分类名 = 文件路径
                .文件名干()
                .变换(解码系统文件名)
                .解包或用否则(|| 解码系统文件名(文件路径.作为系统串()));

            让 内容文本 = 文件系统::读取全部字符串(&文件路径).映射错误(|坏| 载入故障::读取失败 {
                目标: 载入目标::第三方库,
                文件路径: 有值(格式化!("{:?}", 文件路径)),
                详情: 坏.转字符串(),
            })?;

            // 将文件中的映射合并，加上文件分类前缀
            让 节表值 =
                解析映射节(&内容文本).映射错误(|坏| 载入故障::解析失败 {
                    目标: 载入目标::第三方库,
                    文件路径: 有值(格式化!("{:?}", 文件路径)),
                    详情: 坏.转字符串(),
                })?;
            // 节名排序后合并，保证 "文件名/子分类" 键的插入顺序确定
            让 可变 子节名表: 向量<&字符串> = 节表值.取全部键().收集();
            子节名表.排序();
            对于 子节名 在 子节名表 {
                让 类别键 = 格式化!("{}/{}", 分类名, 子节名);
                合并表.置入(类别键, 节表值[子节名].克隆值());
            }
        }

        自我.映射表们
            .置入(映射类别::三方库类, 合并表);
        成功(())
    }

    /// 载入所有默认映射表
    公开 函数 载入全部(&可变 自我) -> 结果<(), 载入故障> {
        自我.载入(映射类别::关键字类)?;
        // 标准库可选：缺失时静默跳过（与 映射管理器::从目录载入 行为一致），
        // 存在但载入失败时必须报错
        如果 自我.根目录.连接("stdlib.toml").存在() {
            自我.载入(映射类别::标准库类)?;
        }
        // module_paths.toml（可选）：模块路径映射并入标准库分类的 ["模块路径"] 子节。
        // 在标准库之后合并且仅补充缺失键，保证标准库的同名映射优先
        // （与 映射管理器 的 module_paths.toml 先、标准库后的覆盖顺序语义一致）
        让 模块路径文件 = 自我.根目录.连接("module_paths.toml");
        如果 模块路径文件.存在() {
            让 内容文本 =
                文件系统::读取全部字符串(&模块路径文件).映射错误(|坏| 载入故障::读取失败 {
                    目标: 载入目标::模块路径表,
                    文件路径: 有值(模块路径文件.展示().转字符串()),
                    详情: 坏.转字符串(),
                })?;
            让 节表值 =
                解析映射节(&内容文本).映射错误(|坏| 载入故障::解析失败 {
                    目标: 载入目标::模块路径表,
                    文件路径: 无,
                    详情: 坏.转字符串(),
                })?;
            如果让 有值(条目集) = 节表值.获取("模块路径") {
                让 标准库表 = 自我.映射表们.取条目(映射类别::标准库类).或用缺省();
                让 模块路径节 = 标准库表.取条目("模块路径".转字符串()).或用缺省();
                对于 (键项, 值项) 在 条目集 {
                    模块路径节.取条目(键项.克隆值()).或用插入(|| 值项.克隆值());
                }
            }
        }
        // 第三方库可选：目录不存在时静默跳过，存在但载入失败时必须报错
        // （否则映射静默丢失，用户看到的是未翻译的标识符而非错误提示）
        如果 自我.根目录.连接("crates").是否为目录() {
            自我.载入(映射类别::三方库类)?;
        }
        成功(())
    }

    /// 获取指定分类的完整映射表（扁平化合并所有子分类）
    ///
    /// 子分类按名称排序后合并，保证同名键冲突时的胜出者确定
    /// （哈希映射遍历顺序随机会导致多次载入结果不一致）
    公开 函数 取映射(&自我, 类别: 映射类别) -> 哈希映射<字符串, 字符串> {
        自我.映射表们
            .获取(&类别)
            .变换(摊平节表)
            .取值或默认()
    }

    /// 获取指定分类和子分类的映射表
    公开 函数 取子映射(
        &自我,
        类别: 映射类别,
        子类别参数: &文本,
    ) -> 选项<&哈希映射<字符串, 字符串>> {
        自我.映射表们
            .获取(&类别)
            .而后映射(|类别表| 类别表.获取(子类别参数))
    }

    /// 查询单个映射条目（按子分类名升序查找，同名键命中顺序确定）
    公开 函数 查询(&自我, 类别: 映射类别, 母语词条: &文本) -> 选项<字符串> {
        如果让 有值(类别表) = 自我.映射表们.获取(&类别) {
            让 可变 名称表: 向量<&字符串> = 类别表.取全部键().收集();
            名称表.排序();
            对于 子节名 在 名称表 {
                如果让 有值(英文名) = 类别表[子节名].获取(母语词条) {
                    返回 有值(英文名.克隆值());
                }
            }
        }
        无
    }

    /// 反向查询（从英文查中文；按子分类名升序遍历，结果确定）
    公开 函数 反查(&自我, 类别: 映射类别, 英文值: &文本) -> 选项<字符串> {
        如果让 有值(类别表) = 自我.映射表们.获取(&类别) {
            让 可变 名称表: 向量<&字符串> = 类别表.取全部键().收集();
            名称表.排序();
            对于 子节名 在 名称表 {
                对于 (母语项, 英文项) 在 &类别表[子节名] {
                    如果 英文项 == 英文值 {
                        返回 有值(母语项.克隆值());
                    }
                }
            }
        }
        无
    }

    /// 获取所有子分类名称（排序后返回，输出确定）
    公开 函数 取子类别(&自我, 类别: 映射类别) -> 向量<字符串> {
        让 可变 名称表 = 自我
            .映射表们
            .获取(&类别)
            .变换(|类别表| 类别表.取全部键().克隆副本().收集::<向量<_>>())
            .取值或默认();
        名称表.排序();
        名称表
    }

    /// 统计映射条目数（扁平化后）
    公开 函数 条目数(&自我, 类别: 映射类别) -> 无符号机器整数 {
        自我.取映射(类别).元素数()
    }
}

/// 便捷函数：载入关键字映射
公开 函数 载入关键字映射<路径参数: 作为引用<路径类型>>(
    语言包路径: 路径参数,
) -> 结果<哈希映射<字符串, 字符串>, 载入故障> {
    让 可变 载入器 = 映射载入器::新建(语言包路径);
    载入器.载入(映射类别::关键字类)?;
    成功(载入器.取映射(映射类别::关键字类))
}

/// 便捷函数：载入标准库映射
公开 函数 载入标准库映射<路径参数: 作为引用<路径类型>>(
    语言包路径: 路径参数,
) -> 结果<哈希映射<字符串, 字符串>, 载入故障> {
    让 可变 载入器 = 映射载入器::新建(语言包路径);
    载入器.载入(映射类别::标准库类)?;
    成功(载入器.取映射(映射类别::标准库类))
}

/// 便捷函数：载入所有映射
公开 函数 载入全部映射<路径参数: 作为引用<路径类型>>(
    语言包路径: 路径参数,
) -> 结果<哈希映射<映射类别, 哈希映射<字符串, 字符串>>, 载入故障> {
    让 可变 载入器 = 映射载入器::新建(语言包路径);
    载入器.载入全部()?;

    让 可变 结果表 = 哈希映射::新建();
    结果表.置入(
        映射类别::关键字类,
        载入器.取映射(映射类别::关键字类),
    );
    结果表.置入(
        映射类别::标准库类,
        载入器.取映射(映射类别::标准库类),
    );
    结果表.置入(
        映射类别::三方库类,
        载入器.取映射(映射类别::三方库类),
    );

    成功(结果表)
}

/// 创建默认的关键字映射（内置备用）
///
/// 当语言包文件不可用时，使用此内置映射作为回退，
/// 覆盖 Rust 基础语法关键字、类型、错误处理、异步等常用构造。
公开 函数 创建内置关键字映射() -> 哈希映射<字符串, 字符串> {
    让 可变 内置表 = 哈希映射::新建();

    // 声明关键字
    内置表.置入("函数".转为(), "fn".转为());
    内置表.置入("变量".转为(), "let".转为());
    内置表.置入("可变".转为(), "mut".转为());
    内置表.置入("常量".转为(), "const".转为());
    内置表.置入("结构体".转为(), "struct".转为());
    内置表.置入("枚举".转为(), "enum".转为());
    内置表.置入("实现".转为(), "impl".转为());
    内置表.置入("特征".转为(), "trait".转为());
    内置表.置入("类型".转为(), "type".转为());
    内置表.置入("模块".转为(), "mod".转为());
    内置表.置入("公开".转为(), "pub".转为());
    内置表.置入("使用".转为(), "use".转为());
    内置表.置入("作为".转为(), "as".转为());
    内置表.置入("包".转为(), "crate".转为());
    内置表.置入("超级".转为(), "super".转为());
    内置表.置入("外部".转为(), "extern".转为());
    内置表.置入("静态".转为(), "static".转为());

    // 控制流
    内置表.置入("如果".转为(), "if".转为());
    内置表.置入("否则".转为(), "else".转为());
    内置表.置入("匹配".转为(), "match".转为());
    内置表.置入("循环".转为(), "loop".转为());
    内置表.置入("当".转为(), "while".转为());
    内置表.置入("对于".转为(), "for".转为());
    内置表.置入("在".转为(), "in".转为());
    内置表.置入("中断".转为(), "break".转为());
    内置表.置入("继续".转为(), "continue".转为());
    内置表.置入("返回".转为(), "return".转为());

    // 基本类型
    内置表.置入("整数".转为(), "i32".转为());
    内置表.置入("长整数".转为(), "i64".转为());
    内置表.置入("浮点数".转为(), "f64".转为());
    内置表.置入("单精度浮点数".转为(), "f32".转为());
    内置表.置入("文本".转为(), "str".转为());
    内置表.置入("布尔".转为(), "bool".转为());
    内置表.置入("字符".转为(), "char".转为());
    内置表.置入("字节".转为(), "u8".转为());

    // 特殊值
    内置表.置入("真".转为(), "true".转为());
    内置表.置入("假".转为(), "false".转为());
    内置表.置入("空".转为(), "()".转为());
    内置表.置入("自我".转为(), "self".转为());
    内置表.置入("自身".转为(), "Self".转为());

    // 错误处理
    内置表.置入("结果".转为(), "Result".转为());
    内置表.置入("选项".转为(), "Option".转为());
    内置表.置入("有值".转为(), "Some".转为());
    内置表.置入("无".转为(), "None".转为());
    内置表.置入("成功".转为(), "Ok".转为());
    内置表.置入("错误".转为(), "Err".转为());

    // 内存
    内置表.置入("引用".转为(), "&".转为());
    内置表.置入("解引用".转为(), "*".转为());
    内置表.置入("移动".转为(), "move".转为());
    内置表.置入("盒子".转为(), "Box".转为());

    // 异步
    内置表.置入("异步".转为(), "async".转为());
    内置表.置入("等待".转为(), "await".转为());
    内置表.置入("不安全".转为(), "unsafe".转为());
    内置表.置入("动态".转为(), "dyn".转为());

    内置表
}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;

    #[测试]
    函数 载入关键字映射用例() {
        // 独立临时目录：固定路径会在并行测试/多次运行间交叉污染
        让 临时对象 = 临时文件::建临时目录().取成功值();
        让 临时目录 = 临时对象.条目路径();

        // 写入测试映射表
        让 测试内容 = r#"
["声明"]
"函数" = "fn"
"变量" = "let"

["控制流"]
"如果" = "if"
"否则" = "else"
"#;
        文件系统::写入(临时目录.连接("keywords.toml"), 测试内容).取成功值();

        // 测试载入
        让 可变 载入器 = 映射载入器::新建(临时目录);
        断言!(载入器.载入(映射类别::关键字类).是否为成功());

        // 测试查询
        断言相等!(
            载入器.查询(映射类别::关键字类, "函数"),
            有值("fn".转字符串())
        );
        断言相等!(
            载入器.查询(映射类别::关键字类, "如果"),
            有值("if".转字符串())
        );
        断言相等!(载入器.查询(映射类别::关键字类, "不存在"), 无);

        // 测试反向查询
        断言相等!(
            载入器.反查(映射类别::关键字类, "fn"),
            有值("函数".转字符串())
        );

        // 测试子分类
        让 子类别表 = 载入器.取子类别(映射类别::关键字类);
        断言!(子类别表.包含(&"声明".转字符串()));
        断言!(子类别表.包含(&"控制流".转字符串()));

        // 测试条目数
        断言相等!(载入器.条目数(映射类别::关键字类), 4);
    }

    #[测试]
    函数 取扁平映射用例() {
        让 临时对象 = 临时文件::建临时目录().取成功值();
        让 临时目录 = 临时对象.条目路径();

        让 测试内容 = r#"
["分类A"]
"甲" = "alpha"
"乙" = "beta"

["分类B"]
"丙" = "gamma"
"#;
        文件系统::写入(临时目录.连接("stdlib.toml"), 测试内容).取成功值();

        让 可变 载入器 = 映射载入器::新建(临时目录);
        载入器.载入(映射类别::标准库类).取成功值();

        让 映射表 = 载入器.取映射(映射类别::标准库类);
        断言相等!(映射表.元素数(), 3);
        断言相等!(映射表.获取("甲"), 有值(&"alpha".转字符串()));
        断言相等!(映射表.获取("丙"), 有值(&"gamma".转字符串()));
        // 子分类名排序后返回，输出确定
        断言相等!(
            载入器.取子类别(映射类别::标准库类),
            向量!["分类A", "分类B"]
        );
    }

    #[测试]
    函数 内置关键字映射用例() {
        让 内置表 = 创建内置关键字映射();

        断言相等!(内置表.获取("函数"), 有值(&"fn".转字符串()));
        断言相等!(内置表.获取("如果"), 有值(&"if".转字符串()));
        断言相等!(内置表.获取("整数"), 有值(&"i32".转字符串()));
        断言!(内置表.元素数() > 30);
    }

    /// 载入全部把 module_paths.toml 并入标准库分类的 ["模块路径"] 子节，
    /// 且同名键标准库映射优先（与 映射管理器::从目录载入 的覆盖顺序语义一致）
    #[测试]
    函数 载入全部合并模块路径且标准库优先() {
        让 临时对象 = 临时文件::建临时目录().取成功值();
        让 临时目录 = 临时对象.条目路径();

        文件系统::写入(
            临时目录.连接("keywords.toml"),
            "[\"声明\"]\n\"函数\" = \"fn\"\n",
        )
        .取成功值();
        // 标准库映射与模块路径文件含同名键，标准库映射必须优先
        文件系统::写入(
            临时目录.连接("stdlib.toml"),
            "[\"模块路径\"]\n\"标准库\" = \"std\"\n\"文件系统\" = \"std::fs\"\n",
        )
        .取成功值();
        文件系统::写入(
            临时目录.连接("module_paths.toml"),
            "[\"模块路径\"]\n\"文件系统\" = \"fs\"\n\"字符串\" = \"string\"\n",
        )
        .取成功值();

        让 可变 载入器 = 映射载入器::新建(临时目录);
        载入器.载入全部().取成功值();

        让 模块路径表 = 载入器
            .取子映射(映射类别::标准库类, "模块路径")
            .取成功值();
        // 模块路径文件的独有键并入标准库分类
        断言相等!(模块路径表.获取("字符串"), 有值(&"string".转字符串()));
        // 同名键标准库映射优先（模块路径文件仅补充缺失键）
        断言相等!(模块路径表.获取("文件系统"), 有值(&"std::fs".转字符串()));
    }

    /// 仅 keywords.toml 时载入全部不应报错（标准库/模块路径/三方库均可选）
    #[测试]
    函数 载入全部时标准库可选() {
        让 临时对象 = 临时文件::建临时目录().取成功值();
        让 临时目录 = 临时对象.条目路径();
        文件系统::写入(
            临时目录.连接("keywords.toml"),
            "[\"声明\"]\n\"函数\" = \"fn\"\n",
        )
        .取成功值();

        让 可变 载入器 = 映射载入器::新建(临时目录);
        载入器.载入全部().取成功值();
        断言相等!(
            载入器.查询(映射类别::关键字类, "函数"),
            有值("fn".转字符串())
        );
    }

    /// 非标准编码（国标编码）的文件名被正确转码为 UTF-8 分类键，
    /// 而不是被有损替换或与其它文件碰撞
    #[测试]
    #[配置(Unix系统)]
    函数 非标准编码文件名转码用例() {
        使用 标准库::操作系统模块::Unix系统::外部接口模块::操作系统字符串扩展;

        让 临时对象 = 临时文件::建临时目录().取成功值();
        让 临时目录 = 临时对象.条目路径();
        让 第三方目录 = 临时目录.连接("crates");
        文件系统::创建所有目录(&第三方目录).取成功值();
        // keywords.toml 为必需文件
        文件系统::写入(
            临时目录.连接("keywords.toml"),
            "[\"声明\"]\n\"函数\" = \"fn\"\n",
        )
        .取成功值();

        // “序列化”三字的国标编码字节（见下方字节向量）
        让 国标文件名 = 标准库::外部接口模块::操作系统字符串::从向量构造(向量![0xD0, 0xF2, 0xC1, 0xD0, 0xBB, 0xAF]);
        让 文件路径 = 第三方目录.连接(国标文件名).设扩展名("toml");
        文件系统::写入(&文件路径, "[\"标识符\"]\n\"服务器\" = \"Server\"\n").取成功值();

        // 前置断言：该文件名的字节确实不是合法 UTF-8
        断言!(文件路径.取文件名().取成功值().取字符串引用().是否为无());

        让 可变 载入器 = 映射载入器::新建(临时目录);
        载入器.载入全部().取成功值();

        // 分类键应为转码后的“序列化/标识符”（国标 18030 解码），映射可正常查询
        让 子映射表 = 载入器
            .取子映射(映射类别::三方库类, "序列化/标识符")
            .取成功值();
        断言相等!(子映射表.获取("服务器"), 有值(&"Server".转字符串()));
    }

    /// 载入错误分类：文件缺失 / TOML 解析失败；第三方目录不存在静默成功
    #[测试]
    函数 载入器错误分支用例() {
        让 临时对象 = 临时文件::建临时目录().取成功值();
        让 可变 载入器 = 映射载入器::新建(临时对象.条目路径());
        // 空目录载入关键字：文件缺失
        断言!(模式匹配!(
            载入器.载入(映射类别::关键字类),
            错误(载入故障::文件缺失 { .. })
        ));
        // 第三方目录不存在：静默成功
        载入器.载入(映射类别::三方库类).取成功值();
        断言相等!(载入器.条目数(映射类别::三方库类), 0);
        // 未载入的分类查询全为无 / 空
        断言相等!(
            载入器.取子类别(映射类别::标准库类),
            向量::<字符串>::新建()
        );
        断言!(
            载入器
                .取子映射(映射类别::标准库类, "标识符")
                .是否为无()
        );
        断言相等!(载入器.查询(映射类别::标准库类, "x"), 无);
        断言相等!(载入器.反查(映射类别::标准库类, "x"), 无);

        // 损坏 TOML：解析失败
        文件系统::写入(
            临时对象.条目路径().连接("keywords.toml"),
            "[\"声明\"]\n\"a\"=\"1\"\n\"a\"=\"2\"\n",
        )
        .取成功值();
        断言!(模式匹配!(
            载入器.载入(映射类别::关键字类),
            错误(载入故障::解析失败 { .. })
        ));
        // 解析映射节直接校验同样报错
        断言!(解析映射节("not = = toml").是否为错误());
    }

    /// 第三方目录：多文件、多子节按 `文件名/节名` 归类，非 TOML 忽略，
    /// 扁平化查询/反查可用
    #[测试]
    函数 载入三方库多文件用例() {
        让 临时对象 = 临时文件::建临时目录().取成功值();
        让 目录 = 临时对象.条目路径();
        文件系统::写入(目录.连接("keywords.toml"), "[\"声明\"]\n\"函数\" = \"fn\"\n").取成功值();
        让 第三方目录 = 目录.连接("crates");
        文件系统::创建所有目录(&第三方目录).取成功值();
        文件系统::写入(
            第三方目录.连接("serde.toml"),
            "[\"模块路径\"]\n\"序列化\" = \"serde\"\n[\"标识符\"]\n\"序列\" = \"Serialize\"\n",
        )
        .取成功值();
        文件系统::写入(
            第三方目录.连接("tokio.toml"),
            "[\"模块路径\"]\n\"异步\" = \"tokio\"\n",
        )
        .取成功值();
        // 非 TOML 文件必须忽略
        文件系统::写入(第三方目录.连接("README.md"), "ignore me").取成功值();

        让 可变 载入器 = 映射载入器::新建(目录);
        载入器.载入(映射类别::三方库类).取成功值();

        让 可变 子类别表 = 载入器.取子类别(映射类别::三方库类);
        子类别表.排序();
        断言相等!(
            子类别表,
            向量![
                "serde/标识符".转字符串(),
                "serde/模块路径".转字符串(),
                "tokio/模块路径".转字符串(),
            ]
        );
        断言相等!(
            载入器.查询(映射类别::三方库类, "序列"),
            有值("Serialize".转字符串())
        );
        断言相等!(
            载入器.反查(映射类别::三方库类, "tokio"),
            有值("异步".转字符串())
        );
        // 扁平化后共 3 条
        断言相等!(载入器.条目数(映射类别::三方库类), 3);
    }

    /// 载入全部全量链路：标准库存在则载入；模块路径文件仅补充标准库映射
    /// 缺失的键（标准库优先）；三方库目录一并载入；
    /// 载入全部映射便捷函数返回三个分类
    #[测试]
    函数 载入全部合并模块路径优先用例() {
        让 临时对象 = 临时文件::建临时目录().取成功值();
        让 目录 = 临时对象.条目路径();
        文件系统::写入(目录.连接("keywords.toml"), "[\"声明\"]\n\"函数\" = \"fn\"\n").取成功值();
        文件系统::写入(
            目录.连接("stdlib.toml"),
            "[\"标识符\"]\n\"字符串\" = \"String\"\n[\"模块路径\"]\n\"格式化\" = \"fmt\"\n",
        )
        .取成功值();
        // 模块路径文件：与标准库映射同键（标准库映射胜）+ 独有键（补入）
        文件系统::写入(
            目录.连接("module_paths.toml"),
            "[\"模块路径\"]\n\"格式化\" = \"SHOULD_NOT_WIN\"\n\"输入输出\" = \"io\"\n",
        )
        .取成功值();
        让 第三方目录 = 目录.连接("crates");
        文件系统::创建所有目录(&第三方目录).取成功值();
        文件系统::写入(
            第三方目录.连接("serde.toml"),
            "[\"标识符\"]\n\"序列\" = \"Serialize\"\n",
        )
        .取成功值();

        让 全部表 = 载入全部映射(目录).期望("全量载入应成功");
        断言相等!(全部表.元素数(), 3, "三个分类都应存在");
        让 可变 载入器 = 映射载入器::新建(目录);
        载入器.载入全部().取成功值();
        让 模块路径表 = 载入器
            .取子映射(映射类别::标准库类, "模块路径")
            .取成功值();
        断言相等!(
            模块路径表.获取("格式化"),
            有值(&"fmt".转字符串()),
            "标准库映射同键优先"
        );
        断言相等!(模块路径表.获取("输入输出"), 有值(&"io".转字符串()), "独有键应补入");
        断言相等!(
            载入器.查询(映射类别::标准库类, "字符串"),
            有值("String".转字符串())
        );
        断言相等!(载入器.条目数(映射类别::三方库类), 1);

        // 便捷函数
        断言相等!(
            载入标准库映射(目录).取成功值().获取("字符串"),
            有值(&"String".转字符串())
        );
    }

    /// 分类元信息：默认文件名稳定，显示名非空且随分类变化
    #[测试]
    函数 分类元信息用例() {
        断言相等!(
            映射类别::关键字类.默认文件名(),
            "keywords.toml"
        );
        断言相等!(映射类别::标准库类.默认文件名(), "stdlib.toml");
        断言相等!(
            映射类别::三方库类.默认文件名(),
            "crates.toml"
        );
        让 名称表 = [
            映射类别::关键字类.显示名(),
            映射类别::标准库类.显示名(),
            映射类别::三方库类.显示名(),
        ];
        对于 名项 在 &名称表 {
            断言!(!名项.是否为空());
        }
        断言不等!(名称表[0], 名称表[2]);
        // UTF-8 文件名走快速路径原样返回
        让 普通名字 = 标准库::外部接口模块::操作系统串::新建("普通名字");
        断言相等!(解码系统文件名(普通名字), "普通名字");
    }

    /// 语言包目录下的映射源文件（根目录 *.toml + crates/*.toml）
    函数 语言包映射文件(目录: &路径类型) -> 向量<路径缓冲> {
        让 可变 文件表: 向量<路径缓冲> = 文件系统::读取目录(目录)
            .期望("语言包目录应可读")
            .变换(|条目结果| 条目结果.取成功值().条目路径())
            .日志过滤器(|路径项| 路径项.取扩展名().而后映射(|后缀| 后缀.取字符串引用()) == 有值("toml"))
            .收集();
        让 第三方目录 = 目录.连接("crates");
        如果 第三方目录.是否为目录() {
            文件表.扩展(
                文件系统::读取目录(&第三方目录)
                    .取成功值()
                    .变换(|条目结果| 条目结果.取成功值().条目路径())
                    .日志过滤器(|路径项| 路径项.取扩展名().而后映射(|后缀| 后缀.取字符串引用()) == 有值("toml")),
            );
        }
        文件表.排序();
        文件表
    }

    /// 一次解析得到的多种视图，必须与「各调一次独立解析」完全一致
    ///
    /// 载入器为了拿到书写序改用 [`已解析文档`]，正向映射与危险元数据的
    /// 口径不能被这次改动带偏，因此逐文件比对两条路径的结果。
    #[测试]
    函数 解析文档视图与独立函数一致用例() {
        让 清单目录 = 路径类型::新建(编译环境宏!("CARGO_MANIFEST_DIR"));
        让 可变 已检查数 = 0;
        对于 语言码 在 ["zh", "ja", "ar"] {
            对于 文件项 在 语言包映射文件(&清单目录.连接(格式化!("lang-packs/{}", 语言码))) {
                让 内容文本 = 文件系统::读取全部字符串(&文件项).取成功值();
                让 文档 = 已解析文档::解析文档(&内容文本).取成功值();
                让 标记名 = 文件项.展示().转字符串();
                断言相等!(
                    文档.节表(),
                    解析映射节(&内容文本).取成功值(),
                     "{} 节表不一致",
                    标记名
                );
                断言相等!(
                    文档.危险表(),
                    解析危险节表(&内容文本).取成功值(),
                    "{} 危险元数据不一致",
                    标记名
                );

                让 可变 模块路径表 = 哈希映射::新建();
                让 可变 标识符表 = 哈希映射::新建();
                文档.合并模块路径与标识符(&可变 模块路径表, &可变 标识符表);
                让 可变 模块路径参照表 = 哈希映射::新建();
                让 可变 标识符参照表 = 哈希映射::新建();
                合并模块路径与标识符节(&内容文本, &可变 模块路径参照表, &可变 标识符参照表).取成功值();
                断言相等!(模块路径表, 模块路径参照表, "{} 模块路径不一致", 标记名);
                断言相等!(标识符表, 标识符参照表, "{} 标识符不一致", 标记名);
                已检查数 += 1;
            }
        }
        断言!(已检查数 >= 15, "应比对足够多的语言包文件，实际 {} 个", 已检查数);
    }

    /// 非表节、非字符串条目、空节：两条路径都按同一口径跳过
    #[测试]
    函数 解析文档跳过非字符串条目用例() {
        让 刁钻内容 = "\"顶层标量\" = \"不是表\"\n[\"标识符\"]\n\"字符串\" = \"String\"\n\"数字\" = 42\n\"数组\" = [1, 2]\n[\"空节\"]\n";
        让 文档 = 已解析文档::解析文档(刁钻内容).取成功值();
        断言相等!(文档.节表(), 解析映射节(刁钻内容).取成功值());
        断言相等!(
            文档.节表()
                .获取("标识符")
                .取成功值()
                .获取("字符串")
                .变换(字符串::作为字符串),
            有值("String")
        );
        // 跳过的条目不会进表，也不会让整份文件解析失败
        断言!(!文档.节表().包含键("顶层标量"));
        断言!(!文档.节表().包含键("空节"));
        断言相等!(文档.节条目们("标识符").元素数(), 1, "只收字符串值的条目");
        断言!(解析危险节表(刁钻内容).是否为成功());
    }
}
