    #[测试]
    函数 测试派生参数用派生映射() {
        // 派生属性内的特征名走派生特征映射（`克隆` → `Clone` 大写）
        让 可变 映射表 = 建测试映射();
        映射表.插入("派生".转字符串(), "derive".转字符串());
        让 可变 派生表 = 哈希映射::新建();
        派生表.插入("克隆".转字符串(), "Clone".转字符串());
        派生表.插入("调试".转字符串(), "Debug".转字符串());
        让 空表 = 哈希映射::新建();
        让 源码 = "#[派生(克隆, 调试)]\n结构体 点 {";
        让 期望串 = "#[derive(Clone, Debug)]\n结构体 点 {";
        断言相等!(
            词法转译并宏映射(源码, &映射表, &空表, &派生表),
            期望串
        );
        // 方法调用 `值.克隆()` 不受派生映射影响（无上下文匹配，走关键字表）
        让 源码二 = "值.克隆();";
        断言相等!(
            词法转译并宏映射(源码二, &映射表, &空表, &派生表),
            "值.克隆();"
        );
    }

