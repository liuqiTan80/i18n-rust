//! 词法处理模块 - 将母语源码根据关键字映射转译为标准 Rust 源码
//!
//! 基于 词法解析器 的 token 级转译，保证注释与字符串字面量内容不被误改。
//! 支持宏感叹号自动补充、原始标识符（r#）处理、反向转译（Rust → 母语）。

使用 包::缓存::源映射条目;
使用 词法解析器::{令牌种类, 切分令牌};
使用 标准库::集合::{哈希映射, 哈希集合};

/// 转译结果：标准 Rust 输出、词法阶段源映射与全管线编辑表
#[派生(调试, 克隆)]
公开 结构体 词法产出 {
    /// 转译后的代码文本
    公开 产出: 字符串,
    /// 词法阶段源映射条目列表（记录被替换的标识符，replacement 不含补的 `!`）
    公开 源映射: 向量<源映射条目>,
    /// 全管线编辑表：与 源映射 同偏移，但 replacement 为**最终输出文本**
    ///（宏调用自动补充的 `!` 已计入 replacement），供全管线编辑地图组合使用
    公开 最终编辑表: 向量<源映射条目>,
}

/// 将母语 Rust 源代码转换为标准 Rust 源代码字符串
///
/// 参数：
///   源码: 母语源代码（如 .zh 文件内容）
///   关键词映射表: 母语关键字到英文关键字的映射表
/// 返回：标准 Rust 源代码
公开 函数 词法转译(源码: &文本, 关键字映射表: &哈希映射<字符串, 字符串>) -> 字符串 {
    让 空映射 = 哈希映射::新建();
    词法转译并宏映射(源码, 关键字映射表, &空映射, &哈希映射::新建())
}

/// 将母语 Rust 源代码转换为标准 Rust 源代码字符串（支持宏感叹号自动补充）
///
/// 参数：
///   源码: 母语源代码（如 .zh 文件内容）
///   关键词映射表: 母语关键字到英文关键字的映射表
///   宏名集: 所有中文宏名的集合（不含感叹号），用于自动补充 `!`
/// 返回：标准 Rust 源代码
///
/// 注意：宏名的英文替换优先使用宏映射（见 [`词法转译并宏映射`]）；
/// 本函数以 关键词映射表 兜底（宏名在 关键词映射表 中被类型节覆盖时值可能不准，
/// 如 `向量` 在类型节映射为 `新建向量`、在宏节映射为 `向量宏`）。
公开 函数 词法转译并宏(
    源码: &文本,
    关键字映射表: &哈希映射<字符串, 字符串>,
    宏名集: &哈希集合<字符串>,
) -> 字符串 {
    让 宏映射表: 哈希映射<字符串, 字符串> = 宏名集
        .迭代()
        .变换(|名字| {
            (
                名字.克隆值(),
                关键字映射表
                    .获取(名字)
                    .克隆副本()
                    .解包或用否则(|| 名字.克隆值()),
            )
        })
        .收集();
    词法转译并映射(
        源码,
        关键字映射表,
        &宏映射表,
        &哈希映射::新建(),
        &哈希集合::新建(),
        &哈希集合::新建(),
        &哈希映射::新建(),
    )
    .产出
}

/// 同 [`词法转译并宏`]，但宏名英文替换来自宏映射表
/// （宏名 → 英文宏名，如 `向量` → `向量宏`），可避免宏名在类型节与宏节
/// 重复时被类型值覆盖（如 `向量` 类型节为 `新建向量`、宏节为 `向量宏`）。
公开 函数 词法转译并宏映射(
    源码: &文本,
    关键字映射表: &哈希映射<字符串, 字符串>,
    宏映射表: &哈希映射<字符串, 字符串>,
    派生映射表: &哈希映射<字符串, 字符串>,
) -> 字符串 {
    词法转译并映射(
        源码,
        关键字映射表,
        宏映射表,
        派生映射表,
        &哈希集合::新建(),
        &哈希集合::新建(),
        &哈希映射::新建(),
    )
    .产出
}

/// 同 [`词法转译并宏`]，同时产出源映射（被替换标识符的源偏移与翻译前后文本）
///
/// 源映射在标识符实际被替换时记录；宏感叹号自动补充不产生映射条目。
///
/// `使用段让位词`：use 语句内的让位词集合（模块路径/别名映射键，见
/// [`包::映射管理::映射管理器::取使用延迟词`]）。
/// use 段内命中该集合的词跳过关键字/宏替换，原样保留给后续阶段处理。
///
/// `方法位让位词`：方法位让位词集合（见
/// [`包::映射管理::映射管理器::取方法延迟词`]）——
/// 词法替换值是保留关键字的词（`枚举`→enum）在方法位（前面是 `.`）原样
/// 保留：`.枚举()` 直译会成非法的 `.enum()`，让位后由别名阶段替换为
/// `.枚举()`。
///
/// `字面量后缀表`：数字字面量后缀的兜底查表（标准库标识符映射，见
/// [`包::映射管理::映射管理器::取别名映射表`]）——标准库层
/// 数值类型词（如 `无符号机器整数` = 无符号机器整数）不在 关键词映射表，黏连数字后
/// 同样需要拆分替换。
公开 函数 词法转译并映射(
    源码: &文本,
    关键字映射表: &哈希映射<字符串, 字符串>,
    宏映射表: &哈希映射<字符串, 字符串>,
    派生映射表: &哈希映射<字符串, 字符串>,
    使用段让位词: &哈希集合<字符串>,
    方法位让位词: &哈希集合<字符串>,
    字面量后缀表: &哈希映射<字符串, 字符串>,
) -> 词法产出 {
    // 收集所有 token 以便前瞻/后顾
    让 令牌流: 向量<_> = 切分令牌(源码).收集();
    // 预计算每个 token 的文本（派生属性上下文回溯需要前一个标识符的内容）
    让 令牌文本: 向量<&文本> = {
        让 可变 偏移 = 0;
        令牌流
            .迭代()
            .变换(|令牌项| {
                让 字符串项 = &源码[偏移..偏移 + 令牌项.元素数];
                偏移 += 令牌项.元素数;
                字符串项
            })
            .收集()
    };
    让 可变 产出 = 字符串::新建();
    让 可变 当前偏移 = 0;
    让 可变 源映射 = 向量::新建();
    // 全管线编辑表：replacement 为最终输出文本（宏补的 `!` 计入），与 源映射 同偏移
    让 可变 最终编辑表 = 向量::新建();
    // 派生参数态：`#[派生(` 之后的参数（直到 `)`）内的标识符
    // 优先查派生特征映射（`克隆` → `Clone`），避免与方法名别名（小写 克隆值）冲突
    让 可变 派生参数态 = 假;
    // use 语句态：use 段内的路径段命中"让位词"（模块路径/别名映射键）时
    // 跳过关键字/宏替换，交由后续模块路径与别名阶段按标准库语义替换——
    // 同名词在宏表与标准库表重复时 use 段内标准库优先（`文件`=file/File，
    // `使用 标准库::文件系统::文件` 必须产出 `use 标准库::文件系统::File` 而非小写 file）
    让 可变 使用语句态 = 假;

    对于 下标 在 0..令牌流.元素数() {
        让 令牌 = &令牌流[下标];
        让 令牌长度 = 令牌.元素数 作为 无符号机器整数;
        让 文本段 = &源码[当前偏移..当前偏移 + 令牌长度];

        匹配 令牌.令牌类别 {
            令牌种类::标识符记号 | 令牌种类::原始标识符 => {
                让 裸名 = 文本段.去前缀("r#").解包或用(文本段);

                // 宏调用上下文优先：宏名后跟 `!` 或 `(/[/{`（且前面不是 `::`）时，
                // 使用宏映射替换为英文宏名并确保感叹号，避免宏名在类型节与宏节
                // 重复时被类型值覆盖（如 `向量` 类型节为 `新建向量`、宏节为 `向量宏`）。
                // 方法调用位（前面是 `.`）不适用：宏不经 `.` 访问，
                // `.格式化(` 是方法调用，不补 `!`（后续走关键字映射 → `.格式化提示(`）
                让 可变 已处理 = 假;
                如果 宏映射表.包含键(裸名)
                    && !前接双冒号(&令牌流, 下标)
                    && !前接点号(&令牌流, 下标)
                    && !是否为属性名(&令牌流, 下标)
                    && !(使用语句态 && 使用段让位词.包含(裸名))
                    && 让 有值(后继形态) = 查找后继非空白形态(&令牌流, 下标 + 1)
                {
                    让 是否叹号 = 模式匹配!(后继形态, 令牌种类::非号);
                    如果 是否开括号(后继形态) || 是否叹号 {
                        让 英文宏名 = 宏映射表.获取(裸名).克隆副本().解包或用否则(|| {
                            关键字映射表
                                .获取(裸名)
                                .克隆副本()
                                .解包或用否则(|| 文本段.转字符串())
                        });
                        让 最终文本 = 如果 文本段.以开头("r#") && !英文宏名.以开头("r#") {
                            格式化!("r#{}", 英文宏名)
                        } 否则 {
                            英文宏名
                        };
                        如果 最终文本 != 文本段 {
                            源映射.推入(源映射条目::新建条目(
                                当前偏移,
                                令牌长度,
                                文本段,
                                &最终文本,
                            ));
                        }
                        // 最终输出文本（含自动补充的 `!`）：
                        // 与 源映射 语义不同——replacement 即输出原文，供列映射回放
                        让 追加文本 = 如果 是否开括号(后继形态) {
                            格式化!("{}!", 最终文本)
                        } 否则 {
                            最终文本.克隆值()
                        };
                        如果 追加文本 != 文本段 {
                            最终编辑表.推入(源映射条目::新建条目(
                                当前偏移,
                                令牌长度,
                                文本段,
                                &追加文本,
                            ));
                        }
                        产出.推入字符串(&最终文本);
                        // 后跟开括号但无 `!` 时自动补 `!`
                        如果 是否开括号(后继形态) {
                            产出.推入('!');
                        }
                        已处理 = 真;
                    }
                }

                如果 !已处理 {
                    // 派生参数态内：优先查派生特征映射（如 `克隆` → `Clone`）
                    让 派生替换 = 如果 派生参数态 {
                        派生映射表.获取(裸名).克隆副本()
                    } 否则 {
                        无
                    };
                    让 替换值 = 如果 使用语句态 && 使用段让位词.包含(裸名) {
                        // use 段让位：保持原文，由模块路径/别名阶段替换
                        文本段.转字符串()
                    } 否则 如果 方法位让位词.包含(裸名)
                        && 前接点号(&令牌流, 下标)
                    {
                        // 方法位让位：替换值是保留关键字，直译非法（`.枚举()` →
                        // `.enum()`）；保持原文由别名阶段替换为有效词条（枚举）
                        文本段.转字符串()
                    } 否则 如果 让 有值(英文值) = 派生替换 {
                        英文值
                    } 否则 如果 让 有值(内层) = 文本段.去前缀("r#") {
                        关键字映射表
                            .获取(内层)
                            .变换(|英文词| 格式化!("r#{}", 英文词))
                            .解包或用否则(|| 文本段.转字符串())
                    } 否则 {
                        关键字映射表
                            .获取(文本段)
                            .克隆副本()
                            .解包或用否则(|| 文本段.转字符串())
                    };

                    // `宏规则`（macro_rules）声明形式：后跟宏名时必须带 `!`，
                    // 如 `宏规则 创建向量 { ... }` → `macro_rules! 创建向量 { ... }`
                    让 宏声明 = 替换值 == "macro_rules"
                        && 模式匹配!(
                            查找后继非空白形态(&令牌流, 下标 + 1),
                            有值(令牌种类::标识符记号)
                        );
                    让 最终替换 = 如果 宏声明 {
                        "macro_rules!"
                    } 否则 {
                        替换值.作为字符串()
                    };

                    // 记录实际发生替换的标识符映射
                    如果 最终替换 != 文本段 {
                        源映射.推入(源映射条目::新建条目(
                            当前偏移,
                            令牌长度,
                            文本段,
                            最终替换,
                        ));
                        最终编辑表.推入(源映射条目::新建条目(
                            当前偏移,
                            令牌长度,
                            文本段,
                            最终替换,
                        ));
                    }
                    产出.推入字符串(最终替换);
                }
                // use 语句态推进：本语言 use 关键字词形开启让位态，由 `;` 结束。
                // 词形经关键字映射反查（zh/ja `使用`、es/pt `usar`、ru `используй`
                // 等全部本地词形），不硬编码字面 `use`/`使用`——历史实现只识别
                // 这两种，其余语言 use 段让位态从未开启，冲突词（如 es `formato`
                // 宏 format 与模块 fmt 同名）被词法替换后残留英文宏名 `format::`
                如果 文本段 == "use" || 关键字映射表.获取(文本段).有值且(|值项| 值项 == "use") {
                    使用语句态 = 真;
                }
            }
            令牌种类::开圆括号 => {
                // 派生属性：`派生`（转译为 derive）后跟 `(` 进入参数态
                如果 !派生参数态
                    && 前一标识符是否(&令牌流, &令牌文本, 下标, 关键字映射表, "derive")
                {
                    派生参数态 = 真;
                }
                产出.推入字符串(文本段);
            }
            令牌种类::闭圆括号 => {
                // 离开派生参数态
                派生参数态 = 假;
                产出.推入字符串(文本段);
            }
            // use 语句以分号结束，退出让位态
            令牌种类::分号 => {
                使用语句态 = 假;
                产出.推入字符串(文本段);
            }
            // 数字字面量：数字与中文类型"黏连"（`0无符号微整数`）时，
            // 词法解析器 把整串（含 Unicode 后缀）切为单个 字面量记号 token，
            // 后缀是完整映射词（keywords 表或标准库表：`无符号微整数` → 无符号微整数、
            // `无符号机器整数` → 无符号机器整数）时替换后缀（产出 `0u8`/`0usize`）；
            // 未命中保持原样（编译错误交由编译器报告）
            令牌种类::字面量记号 { suffix_start, .. } => {
                让 后缀 = &文本段[suffix_start..];
                如果 !后缀.是否为空()
                    && !后缀.是否为ASCII()
                    && 让 有值(英文值) = 关键字映射表
                        .获取(后缀)
                        .或用否则(|| 字面量后缀表.获取(后缀))
                {
                    让 数字串 = &文本段[..suffix_start];
                    让 替换后 = 格式化!("{}{}", 数字串, 英文值);
                    让 编辑条目 = 源映射条目::新建条目(
                        当前偏移 + suffix_start,
                        后缀.元素数(),
                        后缀,
                        英文值,
                    );
                    源映射.推入(编辑条目.克隆值());
                    最终编辑表.推入(编辑条目);
                    产出.推入字符串(&替换后);
                } 否则 {
                    产出.推入字符串(文本段);
                }
            }
            // 其他所有 token 直接原样输出
            _ => 产出.推入字符串(文本段),
        }
        当前偏移 += 令牌长度;
    }

    词法产出 {
        产出,
        源映射,
        最终编辑表,
    }
}

/// 查找从指定位置开始的第一个非空白 token 的 令牌类别
函数 查找后继非空白形态(令牌流: &[词法解析器::词法令牌], 起点下标: 无符号机器整数) -> 选项<令牌种类> {
    对于 令牌 在 &令牌流[起点下标..] {
        如果 !是否为空白符(令牌.令牌类别) {
            返回 有值(令牌.令牌类别);
        }
    }
    无
}

/// 判断当前位置之前的第一个非空白标识符（经关键字映射后）是否等于指定英文值
///
/// 用于识别派生属性：`#[派生(...)]` 中 `派生` 的映射值为 `derive`。
函数 前一标识符是否(
    令牌流: &[词法解析器::词法令牌],
    令牌文本: &[&文本],
    当前位置: 无符号机器整数,
    关键字映射表: &哈希映射<字符串, 字符串>,
    英文值: &文本,
) -> 布尔 {
    让 可变 内索引 = 当前位置;
    当 内索引 > 0 {
        内索引 -= 1;
        让 形态 = 令牌流[内索引].令牌类别;
        如果 是否为空白符(形态) {
            继续;
        }
        如果 模式匹配!(形态, 令牌种类::标识符记号 | 令牌种类::原始标识符) {
            让 名字 = 令牌文本[内索引].去前缀("r#").解包或用(令牌文本[内索引]);
            返回 关键字映射表
                .获取(名字)
                .变换(|值项| 值项 == 英文值)
                .解包或用(假);
        }
        返回 假;
    }
    假
}

/// 将标准 Rust 源码反向转译为母语源码
///
/// 参数：
///   源码: 标准 Rust 源代码（如 rustfmt 格式化后的虚拟 .rs 内容）
///   反向映射: 英文关键字到母语关键字的映射表（由正向映射反转得到）
///   模块名集: 当前已打开 .zh 文件的模块名集合。
///              代理为跨文件引用插入的 `包::` 前缀在此被删除，
///              还原为母语中的裸路径（`辅助::`），与正向翻译的
///              `模块路径替换` 互为逆操作。
/// 返回：母语源代码
///
/// 以 token 为单位匹配，天然避免子串误替换
/// （如 `i32` 不会被更短的 `i3` 错误替换），
/// 注释与字符串字面量内容保持原样，与正向翻译一一对应。
///
/// `代理前缀序号集` 为代理（LSP 虚拟项目）添加的 `包::` 前缀在英文
/// 输出中的非空白 token 序号（见 [`补包标记下标`]）：仅删除这些
/// 位置的前缀；用户显式书写的 `包::`（不在集合中）原样保留，反向转译
/// 不再无差别删除，避免还原后代码丢失用户手写前缀。
公开 函数 逆向转译(
    源码: &文本,
    反向映射: &哈希映射<字符串, 字符串>,
    模块名集: &哈希集合<字符串>,
    代理前缀序号集: &哈希集合<无符号机器整数>,
) -> 字符串 {
    // 收集 (token 种类, 文本) 对以便前瞻/后顾
    让 令牌流: 向量<(令牌种类, &文本)> = {
        让 可变 列表 = 向量::新建();
        让 可变 偏移 = 0;
        对于 令牌 在 切分令牌(源码) {
            列表.推入((令牌.令牌类别, &源码[偏移..偏移 + 令牌.元素数]));
            偏移 += 令牌.元素数;
        }
        列表
    };
    // 预处理：每个 token 的非空白序号（rustfmt 等空白变化不影响序号，
    // 序号与 [`补包标记下标`] 的计数口径一致）
    让 可变 非空白序号表 = 向量::带容量(令牌流.元素数());
    让 可变 非空白计数 = 0usize;
    对于 (形态, _) 在 &令牌流 {
        非空白序号表.推入(非空白计数);
        如果 !是否为空白符(*形态) {
            非空白计数 += 1;
        }
    }
    让 可变 输出文本 = 字符串::带容量(源码.元素数());
    让 可变 跳过令牌数 = 0usize; // 删除 包:: 前缀 / macro_rules! 感叹号时跳过的 token 数

    对于 下标 在 0..令牌流.元素数() {
        如果 跳过令牌数 > 0 {
            跳过令牌数 -= 1;
            继续;
        }
        让 (令牌, 文本段) = &令牌流[下标];
        匹配 令牌 {
            令牌种类::标识符记号 | 令牌种类::原始标识符 => {
                让 裸名 = 如果 让 有值(内层) = 文本段.去前缀("r#") {
                    内层
                } 否则 {
                    文本段
                };
                // 代理为跨文件引用插入的 `包::` 前缀：仅当序号命中
                // 正向翻译记录（代理前缀序号集）时才整体删除；
                // 用户手写的 `包::` 不在记录中，原样保留
                // （跳过数含中间空白，兼容 `包 :: 模块` 等带空格写法）
                如果 裸名 == "crate"
                    && 代理前缀序号集.包含(&非空白序号表[下标])
                    && 让 有值(跳过数) = 包前缀跳过数(&令牌流, 下标, 模块名集)
                {
                    跳过令牌数 = 跳过数;
                    继续;
                }
                // `macro_rules! 名称` 声明形式反向转译为 `宏规则 名称`（省略感叹号）
                如果 裸名 == "macro_rules"
                    && 让 有值(跳过数) = 感叹后缀跳过数(&令牌流, 下标)
                {
                    跳过令牌数 = 跳过数;
                }
                让 母语名 = 反向映射
                    .获取(裸名)
                    .变换(|字符串项| 字符串项.作为字符串())
                    .解包或用(裸名);
                如果 文本段.以开头("r#") && !母语名.以开头("r#") {
                    输出文本.推入字符串("r#");
                }
                输出文本.推入字符串(母语名);
            }
            _ => 输出文本.推入字符串(文本段),
        }
    }
    输出文本
}

/// 计算全管线编辑地图中“代理添加的 `包::` 前缀”在英文输出中的非空白 token 序号
///
/// 输入为最终英文输出文本与其全管线编辑地图（replacement 为最终输出文本）。
/// 净长度增量线性累积后，把 replacement 以 `包::` 开头的条目（仅来自 LSP
/// 虚拟项目的跨文件引用前缀重写，用户手写前缀不产生编辑条目）的母语源偏移
/// 换算为英文输出偏移，再转为非空白 token 序号。
///
/// rustfmt 格式化不改变非空白 token 序列（只改变空白），序号在格式化前后
/// 保持一致，供 [`逆向转译`] 对格式化后的文本精确删除前缀。
公开 函数 补包标记下标(
    英文内容: &文本,
    管线映射表: &[源映射条目],
) -> 哈希集合<无符号机器整数> {
    // 1. 英文输出偏移 = 母语源偏移 + 之前全部条目的净长度增量
    //（编辑地图以母语源偏移升序记录且条目互不重叠，线性累积即可）
    让 可变 英文偏移集 = 哈希集合::新建();
    让 可变 增量 = 0i64;
    对于 错误值 在 管线映射表 {
        如果 错误值.替换文本.以开头("crate::") {
            英文偏移集.插入((错误值.源偏移 作为 长整数 + 增量) 作为 无符号机器整数);
        }
        增量 += 错误值.替换文本.元素数() 作为 长整数 - 错误值.字节长度 作为 长整数;
    }
    如果 英文偏移集.是否为空() {
        返回 哈希集合::新建();
    }
    // 2. 偏移 → 非空白 token 序号（与 [`逆向转译`] 计数口径一致）
    让 可变 序号集 = 哈希集合::新建();
    让 可变 偏移 = 0usize;
    让 可变 非空白计数 = 0usize;
    对于 令牌 在 切分令牌(英文内容) {
        如果 !是否为空白符(令牌.令牌类别) {
            如果 英文偏移集.包含(&偏移) {
                序号集.插入(非空白计数);
            }
            非空白计数 += 1;
        }
        偏移 += 令牌.元素数;
    }
    序号集
}

/// `包::模块名` 前缀成立时，返回 `包` 之后需跳过的 token 数（空白 + 两个冒号）；
/// 不成立（冒号不足/后非已知模块名）返回 无
函数 包前缀跳过数(
    令牌流: &[(令牌种类, &文本)],
    当前位置: 无符号机器整数,
    模块名集: &哈希集合<字符串>,
) -> 选项<无符号机器整数> {
    让 可变 序号 = 当前位置 + 1;
    让 可变 跳过数 = 0usize;
    让 可变 冒号数 = 0usize;
    当 序号 < 令牌流.元素数() {
        让 (形态, 文本段) = 令牌流[序号];
        如果 是否为空白符(形态) {
            跳过数 += 1;
            序号 += 1;
            继续;
        }
        如果 冒号数 < 2 && 模式匹配!(形态, 令牌种类::冒号) {
            冒号数 += 1;
            跳过数 += 1;
            序号 += 1;
            继续;
        }
        // 两个冒号后的第一个非空白 token 必须是已知模块名才视为代理插入的前缀
        如果 冒号数 == 2 && 模式匹配!(形态, 令牌种类::标识符记号) && 模块名集.包含(文本段) {
            返回 有值(跳过数);
        }
        返回 无;
    }
    无
}

/// `macro_rules` 后跟感叹号（可隔空白）时，返回需跳过的 token 数（空白 + 感叹号）
函数 感叹后缀跳过数(令牌流: &[(令牌种类, &文本)], 当前位置: 无符号机器整数) -> 选项<无符号机器整数> {
    让 可变 跳过数 = 0usize;
    对于 (形态, _) 在 &令牌流[当前位置 + 1..] {
        如果 是否为空白符(*形态) {
            跳过数 += 1;
            继续;
        }
        返回 如果 模式匹配!(形态, 令牌种类::非号) {
            有值(跳过数 + 1)
        } 否则 {
            无
        };
    }
    无
}

/// 判断 token 是否为空白
函数 是否为空白符(形态: 令牌种类) -> 布尔 {
    模式匹配!(
        形态,
        令牌种类::空白符 | 令牌种类::行评论 | 令牌种类::块评论 { .. }
    )
}

/// 判断 token 是否为开括号（( [ {）
函数 是否开括号(形态: 令牌种类) -> 布尔 {
    模式匹配!(
        形态,
        令牌种类::开圆括号 | 令牌种类::开方括号 | 令牌种类::开大括号
    )
}

/// 检查指定位置之前的非空白 token 是否构成 ::（双冒号）
函数 前接双冒号(令牌流: &[词法解析器::词法令牌], 当前位置: 无符号机器整数) -> 布尔 {
    // 从当前位置往前找，跳过空白，找前两个非空白 token
    让 可变 前一形态 = 无;
    让 可变 前二形态 = 无;

    让 可变 内索引 = 当前位置;
    当 内索引 > 0 {
        内索引 -= 1;
        如果 !是否为空白符(令牌流[内索引].令牌类别) {
            如果 前一形态.是否为无() {
                前一形态 = 有值(令牌流[内索引].令牌类别);
            } 否则 如果 前二形态.是否为无() {
                前二形态 = 有值(令牌流[内索引].令牌类别);
                中断;
            }
        }
    }

    // 前一个和前两个都是冒号 → 前面是 ::
    模式匹配!(前一形态, 有值(令牌种类::冒号)) && 模式匹配!(前二形态, 有值(令牌种类::冒号))
}

/// 判断指定位置的标识符前是否为 `.`（方法调用/字段访问位）
///
/// 宏不能经 `.` 访问，`标识符(...)` 前是 `.` 时必为方法调用：
/// `.格式化(...)` 不应按宏补 `!`（否则生成 `.format!(...)`，方法调用
/// 语法非法）。修复「宏映射词在方法调用位被追补感叹号」的行为。
函数 前接点号(令牌流: &[词法解析器::词法令牌], 当前位置: 无符号机器整数) -> 布尔 {
    让 可变 内索引 = 当前位置;
    当 内索引 > 0 {
        内索引 -= 1;
        如果 !是否为空白符(令牌流[内索引].令牌类别) {
            返回 模式匹配!(令牌流[内索引].令牌类别, 令牌种类::圆点);
        }
    }
    假
}

/// 判断指定位置的标识符是否为属性名（紧跟在 `#[` 或 `#![` 之后的标识符）
///
/// 属性名不应触发宏感叹号自动补充：`#[配置(测试)]` 中的 `配置` 是属性
/// （对应 `cfg`），而非宏调用，若误补 `!` 会生成非法的 `#[cfg!(test)]`。
函数 是否为属性名(令牌流: &[词法解析器::词法令牌], 当前位置: 无符号机器整数) -> 布尔 {
    // 往前收集最多三个非空白 token（最近的在前）
    让 可变 前序: 向量<令牌种类> = 向量::新建();
    让 可变 内索引 = 当前位置;
    当 内索引 > 0 && 前序.元素数() < 3 {
        内索引 -= 1;
        如果 !是否为空白符(令牌流[内索引].令牌类别) {
            前序.推入(令牌流[内索引].令牌类别);
        }
    }

    // `#[标识符`：最近的 token 是 `[`，再前一个是 `#`
    // `#![标识符`：最近的 token 是 `[`，再前两个是 `!` 与 `#`
    模式匹配!(
        前序.切片(),
        [令牌种类::开方括号, 令牌种类::井号码, ..]
    ) || 模式匹配!(
        前序.切片(),
        [令牌种类::开方括号, 令牌种类::非号, 令牌种类::井号码]
    )
}

#[配置(测试)]
模块 单元测试 {
    使用 超级::*;
    使用 标准库::集合::哈希映射;
    使用 标准库::集合::哈希集合;

    函数 建测试映射() -> 哈希映射<字符串, 字符串> {
        哈希映射::从([
            ("函数".转字符串(), "fn".转字符串()),
            ("让".转字符串(), "let".转字符串()),
            ("可变".转字符串(), "mut".转字符串()),
            ("如果".转字符串(), "if".转字符串()),
            ("否则".转字符串(), "else".转字符串()),
            ("打印行".转字符串(), "println".转字符串()),
            ("打印".转字符串(), "print".转字符串()),
            ("格式化".转字符串(), "format".转字符串()),
            ("断言".转字符串(), "assert".转字符串()),
            ("断言相等".转字符串(), "assert_eq".转字符串()),
            ("向量".转字符串(), "vec".转字符串()),
        ])
    }

    函数 建宏映射() -> 哈希映射<字符串, 字符串> {
        哈希映射::从([
            ("打印行".转字符串(), "println".转字符串()),
            ("打印".转字符串(), "print".转字符串()),
            ("格式化".转字符串(), "format".转字符串()),
            ("断言".转字符串(), "assert".转字符串()),
            ("断言相等".转字符串(), "assert_eq".转字符串()),
            ("向量".转字符串(), "vec".转字符串()),
        ])
    }

    #[测试]
    函数 测试简单替换() {
        让 映射表 = 建测试映射();
        让 源码 = "让 可变 x = 5;";
        让 期望串 = "let mut x = 5;";
        断言相等!(词法转译(源码, &映射表), 期望串);
    }

    #[测试]
    函数 测试未映射标识符保留() {
        让 映射表 = 建测试映射();
        让 源码 = "让 变量名 = 42;";
        让 期望串 = "let 变量名 = 42;";
        断言相等!(词法转译(源码, &映射表), 期望串);
    }

    #[测试]
    函数 测试注释与字符串保留() {
        让 映射表 = 建测试映射();
        让 源码 = "// 这是注释 函数\n让 s = \"这是字符串 函数\";";
        让 期望串 = "// 这是注释 函数\nlet s = \"这是字符串 函数\";";
        断言相等!(词法转译(源码, &映射表), 期望串);
    }

    #[测试]
    函数 测试原始标识符处理() {
        // 原始标识符用于保留关键字（如 match 是 Rust 保留字）
        让 可变 映射表 = 建测试映射();
        映射表.插入("匹配".转字符串(), "match".转字符串());
        让 源码 = "让 r#匹配 = 1;";
        让 期望串 = "let r#match = 1;";
        断言相等!(词法转译(源码, &映射表), 期望串);
    }

    #[测试]
    函数 测试未映射标识符原样() {
        让 映射表 = 建测试映射();
        让 源码 = "函数 主函数() { }";
        让 期望串 = "fn 主函数() { }";
        断言相等!(词法转译(源码, &映射表), 期望串);
    }

    // ===== 宏感叹号自动补充测试 =====

    #[测试]
    函数 测试宏自动补叹号() {
        让 映射表 = 建测试映射();
        让 宏表 = 建宏映射();
        让 源码 = "打印行(\"你好\")";
        让 期望串 = "println!(\"你好\")";
        断言相等!(
            词法转译并宏映射(源码, &映射表, &宏表, &哈希映射::新建()),
            期望串
        );
    }

    #[测试]
    函数 测试宏已有叹号不重复() {
        让 映射表 = 建测试映射();
        让 宏表 = 建宏映射();
        让 源码 = "打印行!(\"你好\")";
        让 期望串 = "println!(\"你好\")";
        断言相等!(
            词法转译并宏映射(源码, &映射表, &宏表, &哈希映射::新建()),
            期望串
        );
    }

    #[测试]
    函数 测试整程序宏自动补叹号() {
        让 映射表 = 建测试映射();
        让 宏表 = 建宏映射();
        让 源码 = "函数 主函数() { 打印行(\"你好\") }";
        // 注意：主函数 不在映射中，所以保持原样
        // 但 函数 → fn，打印行 → println!
        让 实测 = 词法转译并宏映射(源码, &映射表, &宏表, &哈希映射::新建());
        断言!(实测.包含("fn"));
        断言!(实测.包含("println!(\"你好\")"));
    }

    #[测试]
    函数 测试普通函数调用不加叹号() {
        让 映射表 = 建测试映射();
        让 宏表 = 建宏映射();
        // "从" 不在宏集合中，不应被加 !
        让 源码 = "字符串::从(\"x\")";
        让 期望串 = "字符串::从(\"x\")";
        断言相等!(
            词法转译并宏映射(源码, &映射表, &宏表, &哈希映射::新建()),
            期望串
        );
    }

    #[测试]
    函数 测试属性名不补叹号() {
        让 可变 映射表 = 建测试映射();
        让 宏表 = 建宏映射();
        // 属性上下文中的宏名（如 配置→cfg、断言）不应被补 !
        映射表.插入("配置".转字符串(), "cfg".转字符串());
        让 源码 = "#[配置(测试)]\n#[断言]";
        让 期望串 = "#[cfg(测试)]\n#[assert]";
        断言相等!(
            词法转译并宏映射(源码, &映射表, &宏表, &哈希映射::新建()),
            期望串
        );
    }

    #[测试]
    函数 测试内部属性名不补叹号() {
        让 可变 映射表 = 建测试映射();
        让 宏表 = 建宏映射();
