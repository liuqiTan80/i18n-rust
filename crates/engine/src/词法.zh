        让 反向表 = 哈希映射::从([
            ("fn".转字符串(), "函数".转字符串()),
            ("let".转字符串(), "让".转字符串()),
        ]);
        让 空集 = 哈希集合::新建();
        让 源码 = "// fn 是关键字\nlet s = \"let\";\nlet 计数 = fn_value;";
        让 期望串 = "// fn 是关键字\n让 s = \"let\";\n让 计数 = fn_value;";
        断言相等!(
            逆向转译(源码, &反向表, &空集, &哈希集合::新建()),
            期望串
        );
    }

    #[测试]
    函数 测试反向转译长词优先() {
        // token 级匹配：i32 与 i3x 是完整 token，互不干扰（无子串误替换）
        让 反向表 = 哈希映射::从([
            ("i32".转字符串(), "整数".转字符串()),
            ("i3".转字符串(), "三".转字符串()),
        ]);
        让 空集 = 哈希集合::新建();
        让 源码 = "let a: i32 = 1; let b: i3x = 2; let c = i3;";
        // let 不在反向表中保持原样；i32→整数、i3→三，i3x 是完整 token 不受影响
        让 期望串 = "let a: 整数 = 1; let b: i3x = 2; let c = 三;";
        断言相等!(
            逆向转译(源码, &反向表, &空集, &哈希集合::新建()),
            期望串
        );
    }

