    // ===== 反向转译测试 =====

    函数 建反向映射(正向表: &哈希映射<字符串, 字符串>) -> 哈希映射<字符串, 字符串> {
        正向表
            .迭代()
            .变换(|(次索引, 值项)| (值项.克隆值(), 次索引.克隆值()))
            .收集()
    }

    #[测试]
    函数 测试反向转译基础() {
        // 关键字、类型名、宏名均被还原为母语，宏感叹号保留
        让 正向表 = 哈希映射::从([
            ("函数".转字符串(), "fn".转字符串()),
            ("主函数".转字符串(), "main".转字符串()),
            ("让".转字符串(), "let".转字符串()),
            ("可变".转字符串(), "mut".转字符串()),
            ("整数".转字符串(), "i32".转字符串()),
            ("打印行".转字符串(), "println".转字符串()),
        ]);
        让 反向表 = 建反向映射(&正向表);
        让 空集 = 哈希集合::新建();
        让 源码 = "fn main() { let mut x: i32 = 5; println!(\"你好\"); }";
        让 期望串 = "函数 主函数() { 让 可变 x: 整数 = 5; 打印行!(\"你好\"); }";
        断言相等!(
            逆向转译(源码, &反向表, &空集, &哈希集合::新建()),
            期望串
        );
    }

    #[测试]
    函数 测试反向转译保留注释字符串自定义标识符() {
