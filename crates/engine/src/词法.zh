    // ===== 源映射测试 =====

    #[测试]
    函数 测试带映射转译输出一致() {
        让 映射表 = 建测试映射();
        让 宏表 = 建宏映射();
        让 源码 = "函数 主函数() { 让 x = 5; 打印行(\"你好\") }";
        让 转译产出 = 词法转译并映射(
            源码,
            &映射表,
            &宏表,
            &哈希映射::新建(),
            &哈希集合::新建(),
            &哈希集合::新建(),
            &哈希映射::新建(),
        );
        断言相等!(
            转译产出.产出,
            词法转译并宏映射(源码, &映射表, &宏表, &哈希映射::新建())
        );
    }

    #[测试]
    函数 测试带映射转译记录关键字替换() {
        让 映射表 = 建测试映射();
        让 宏表 = 建宏映射();
        让 源码 = "函数 主函数() { 让 x = 5; 打印行(\"你好\") }";
        让 转译产出 = 词法转译并映射(
            源码,
            &映射表,
            &宏表,
            &哈希映射::新建(),
            &哈希集合::新建(),
            &哈希集合::新建(),
            &哈希映射::新建(),
        );

        // 函数/让/打印行 被替换，主函数 未命中映射不记录
        让 函数条目 = 转译产出
            .源映射
            .迭代()
            .查找(|标记项| 标记项.原文 == "函数")
            .期望("应有 函数 映射");
        断言相等!(函数条目.替换文本, "fn");
        断言相等!(
            &源码[函数条目.源偏移..函数条目.源偏移 + 函数条目.字节长度],
            "函数"
        );

        让 让条目 = 转译产出
            .源映射
            .迭代()
            .查找(|标记项| 标记项.原文 == "让")
            .期望("应有 让 映射");
        断言相等!(让条目.替换文本, "let");
        断言相等!(
            &源码[让条目.源偏移..让条目.源偏移 + 让条目.字节长度],
            "让"
        );

        // 宏名映射记录翻译文本（println），感叹号补充不产生额外条目
        让 打印行条目 = 转译产出
            .源映射
            .迭代()
            .查找(|标记项| 标记项.原文 == "打印行")
            .期望("应有 打印行 映射");
        断言相等!(打印行条目.替换文本, "println");

        断言!(!转译产出.源映射.迭代().任意(|标记项| 标记项.原文 == "主函数"));
    }

