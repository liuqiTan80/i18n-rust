    #[测试]
    函数 测试反向转译模块前缀() {
        让 正向表 = 哈希映射::从([
            ("函数".转字符串(), "fn".转字符串()),
            ("包".转字符串(), "crate".转字符串()),
        ]);
        让 反向表 = 建反向映射(&正向表);
        让 模块集 = 哈希集合::从(["辅助".转字符串()]);
        // 序号命中正向记录（代理添加的 包::）：整体删除，还原为裸路径
        让 已加集 = 哈希集合::从([5usize]);
        断言相等!(
            逆向转译(
                "fn main() { crate::辅助::辅助函数(); }",
                &反向表,
                &模块集,
                &已加集
            ),
            "函数 main() { 辅助::辅助函数(); }"
        );
        // 序号未命中（用户手写的 包::，非代理添加）：前缀保留不误删
        断言相等!(
            逆向转译(
                "fn main() { crate::辅助::辅助函数(); }",
                &反向表,
                &模块集,
                &哈希集合::新建()
            ),
            "函数 main() { 包::辅助::辅助函数(); }"
        );
        // 后跟非模块名时还原为 包::（不受序号影响）
        断言相等!(
            逆向转译("fn main() { crate::外部函数(); }", &反向表, &模块集, &已加集),
            "函数 main() { 包::外部函数(); }"
        );
    }

    #[测试]
    函数 测试反向转译原始标识符() {
        让 反向表 = 哈希映射::从([
            ("let".转字符串(), "让".转字符串()),
            ("match".转字符串(), "匹配".转字符串()),
        ]);
        让 空集 = 哈希集合::新建();
        断言相等!(
            逆向转译("let r#match = 1;", &反向表, &空集, &哈希集合::新建()),
            "让 r#匹配 = 1;"
        );
    }

    #[测试]
    函数 测试反向转译包前缀带空白() {
        // 包 与 :: 之间存在空白时前缀仍应被完整删除（不能残留孤立冒号）
        让 反向表 = 哈希映射::从([("fn".转字符串(), "函数".转字符串())]);
        让 模块集 = 哈希集合::从(["辅助".转字符串()]);
        让 已加集 = 哈希集合::从([5usize]);
        断言相等!(
            逆向转译(
                "fn f() { crate :: 辅助::辅助函数(); }",
                &反向表,
                &模块集,
                &已加集
            ),
            "函数 f() { 辅助::辅助函数(); }"
        );
    }

    #[测试]
    函数 测试反向转译宏规则带空白叹号() {
        // macro_rules 与 ! 之间存在空白时感叹号仍应被省略
        让 反向表 = 哈希映射::从([("macro_rules".转字符串(), "宏规则".转字符串())]);
        让 空集 = 哈希集合::新建();
        断言相等!(
            逆向转译(
                "macro_rules ! 创建向量 { () => { } }",
                &反向表,
                &空集,
                &哈希集合::新建()
            ),
            "宏规则 创建向量 { () => { } }"
        );
    }

    /// use 段让位：`文件` 同时在宏表（file）与让位集合（标准库 File）中时，
    /// use 段内跳过词法替换（交后续模块路径/别名阶段处理）；
    /// 普通代码位置的 `文件!` 宏调用照常替换
    #[测试]
    函数 测试使用段让位冲突词() {
        让 映射表 = 哈希映射::从([
            ("使用".转字符串(), "use".转字符串()),
            ("文件".转字符串(), "file".转字符串()),
        ]);
        让 让位集 = 哈希集合::从(["文件".转字符串()]);
        让 输出串 = 词法转译并映射(
            "使用 标准库::文件系统::文件 as 库文件;\n文件!()",
            &映射表,
            &哈希映射::新建(),
            &哈希映射::新建(),
            &让位集,
            &哈希集合::新建(),
            &哈希映射::新建(),
        )
        .产出;
        断言相等!(输出串, "use 标准库::文件系统::文件 as 库文件;\nfile!()");
        // 对照组：无让位集合时 use 段内照旧替换（旧行为，验证让位集合确为开关）
        让 无让位输出 = 词法转译并映射(
            "使用 标准库::文件系统::文件 as 库文件;",
            &映射表,
            &哈希映射::新建(),
            &哈希映射::新建(),
            &哈希集合::新建(),
            &哈希集合::新建(),
            &哈希映射::新建(),
        )
        .产出;
        断言相等!(无让位输出, "use 标准库::文件系统::file as 库文件;");
    }

    /// use 段让位（本地化 use 词形）：非 `use`/`使用` 词形的语言（如 es `usar`）
    /// 也需开启让位态——词形经关键字映射反查（历史硬编码只识别 `use`/`使用`，
    /// es 等语言 use 段的冲突词被词法替换后残留 `format::`，模块路径阶段无法修复）
    #[测试]
    函数 测试使用段让位本地化使用词形() {
        让 映射表 = 哈希映射::从([
            ("usar".转字符串(), "use".转字符串()),
            ("formato".转字符串(), "format".转字符串()),
        ]);
        让 让位集 = 哈希集合::从(["formato".转字符串()]);
        让 输出串 = 词法转译并映射(
            "usar estandar::formato::Mostrar;",
            &映射表,
            &哈希映射::新建(),
            &哈希映射::新建(),
            &让位集,
            &哈希集合::新建(),
            &哈希映射::新建(),
        )
        .产出;
        // `usar` 照常译为 use；`formato` 让位保留（交模块路径阶段替换为 fmt）
        断言相等!(输出串, "use estandar::formato::Mostrar;");
    }

    /// 方法位让位：词法替换值是保留关键字的词（`枚举`→enum）在 `.` 后
    /// 原样保留（交别名阶段替成 枚举）；未命中让位集合时照旧替换
    #[测试]
    函数 测试方法位让位冲突词() {
        让 映射表 = 哈希映射::从([
            ("让".转字符串(), "let".转字符串()),
            ("迭代".转字符串(), "iter".转字符串()),
            ("枚举".转字符串(), "enum".转字符串()),
        ]);
        让 方法让位集 = 哈希集合::从(["枚举".转字符串()]);
        让 输出串 = 词法转译并映射(
            "让 n = 列.迭代().枚举();",
            &映射表,
            &哈希映射::新建(),
            &哈希映射::新建(),
            &哈希集合::新建(),
            &方法让位集,
            &哈希映射::新建(),
        )
        .产出;
        断言相等!(输出串, "let n = 列.iter().枚举();");
        // 对照组：无让位集合时方法位照旧替换（旧行为，验证让位集合确为开关）
        让 无让位输出 = 词法转译并映射(
            "让 n = 列.迭代().枚举();",
            &映射表,
            &哈希映射::新建(),
            &哈希映射::新建(),
            &哈希集合::新建(),
            &哈希集合::新建(),
            &哈希映射::新建(),
        )
        .产出;
        断言相等!(无让位输出, "let n = 列.iter().enum();");
    }

    /// 数字与中文类型黏连（`0无符号微整数`）：词法解析器 视为单个
    /// 字面量记号 token，后缀命中映射表时替换（→ `0u8`）；未命中/ASCII 后缀原样
    #[测试]
    函数 测试数字字面量中文后缀() {
        让 映射表 = 哈希映射::从([("无符号微整数".转字符串(), "u8".转字符串())]);
        让 空表 = 哈希映射::新建();
        // 后缀命中：替换为英文数值类型，并记录编辑条目（仅后缀部分）
        让 转译产出 = 词法转译并映射(
            "vec![0无符号微整数; 16]",
            &映射表,
            &空表,
            &空表,
            &哈希集合::新建(),
            &哈希集合::新建(),
            &空表,
        );
        断言相等!(转译产出.产出, "vec![0u8; 16]");
        断言相等!(转译产出.源映射.元素数(), 1);
        断言相等!(转译产出.源映射[0].原文, "无符号微整数");
        断言相等!(转译产出.源映射[0].替换文本, "u8");
        // 后缀未命中：原样保留（编译错误交给编译器）
        让 输出串 = 词法转译并映射(
            "let x = 0未知词;",
            &映射表,
            &空表,
            &空表,
            &哈希集合::新建(),
            &哈希集合::新建(),
            &空表,
        )
        .产出;
        断言相等!(输出串, "let x = 0未知词;");
        // ASCII 后缀不受影响
        让 输出串 = 词法转译并映射(
            "let x = 0u8;",
            &映射表,
            &空表,
            &空表,
            &哈希集合::新建(),
            &哈希集合::新建(),
            &空表,
        )
        .产出;
        断言相等!(输出串, "let x = 0u8;");
    }

    /// 标准库层数值类型词（`无符号机器整数` = 无符号机器整数，不在 关键词映射表）
    /// 黏连数字后由兜底表拆分：`0无符号机器整数` → `0usize`；
    /// 两表同词冲突时 关键词映射表 优先
    #[测试]
    函数 测试数字字面量后缀兜底标准库表() {
        让 空表 = 哈希映射::新建();
        让 标准库表 = 哈希映射::从([("无符号机器整数".转字符串(), "usize".转字符串())]);
        让 转译产出 = 词法转译并映射(
            "let x = 0无符号机器整数;",
            &空表,
            &空表,
            &空表,
            &哈希集合::新建(),
            &哈希集合::新建(),
            &标准库表,
        );
        断言相等!(转译产出.产出, "let x = 0usize;");
        断言相等!(转译产出.源映射.元素数(), 1);
        断言相等!(转译产出.源映射[0].原文, "无符号机器整数");
        断言相等!(转译产出.源映射[0].替换文本, "usize");
        // 两表同词冲突：关键词映射表 优先（匹配其它阶段的查找次序）
        让 映射表 = 哈希映射::从([("微整数".转字符串(), "u8".转字符串())]);
        让 兜底表 = 哈希映射::从([("微整数".转字符串(), "usize".转字符串())]);
        让 输出串 = 词法转译并映射(
            "0微整数",
            &映射表,
            &空表,
            &空表,
            &哈希集合::新建(),
            &哈希集合::新建(),
            &兜底表,
        )
        .产出;
        断言相等!(输出串, "0u8");
    }
}
