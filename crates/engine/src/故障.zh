//! 故障类型：转译期与载入期的两张错误面（`error.rs` 的中文原生重构）
//!
//! 动手前先记下原版三处结构缺陷，重构就是照着它们下的刀：
//!
//! - **同一张「目标 → 消息键」表被抄了三遍，其中两遍各带一个 `_ =>` 兜底**。
//!   「文件缺失」只在关键字目标上换键、「读取失败」把标准库、第三方、三个内置
//!   目标全塞进同一条兜底。新增一个「载入目标」变体时，编译器只逼「解析失败」
//!   补分支，另两处静默套用兜底消息——同一数据源的「读取失败」与「解析失败」
//!   从此口径分叉，且没人会收到提示。重构后压成一张 `(目标 × 失败种类)` 穷尽表
//!   [`载入目标::消息方案`]，漏写格子直接编译不过。
//! - **「克隆路径再取默认值」在三处分支里各写一遍**。收成一处
//!   [`载入故障::路径展示`]，「内置表没有路径」这个事实只表达一次。
//! - **「映射缺失」与「不支持的构造」各占两条匹配臂**，两条只差
//!   一个消息键。合并成「按有无位置选键」的单条臂，臂数从 9 降到 7。
//!
//! 消息模板的占位符个数本来就随目标变化（`无法读取关键字文件: {}` 不吃路径，
//! `读取映射表 {} 失败: {}` 吃），所以穷尽表的格子同时给出**键与填充形状**，
//! 由 [`载入故障::消息`] 单点组装；这也让消息文本第一次可以脱离
//! 「可显示」直接取用（[`载入故障::消息`]、[`转译故障::消息`]）。
//!
//! 行为等价凭证：`母语测试::载入消息穷尽表` 把 9 目标 × 3 类失败 + 目录读取
//! 共 28 格消息逐字钉住，`转译消息全变体` 钉住 7 臂 9 组；右列取值全部来自
//! 重构前实跑取证（`.rz/probe9-matrix.txt`，占位文本固定为路径 `P`、详情 `D`），
//! 本模块不允许改字面。
//!
//! 方言写法上的三条硬约束（否则产物非法，见 docs/zh-findings.md）：
//!
//! - 属性位写 `#[派生(部分相等)]` 才换出「部分相等」那个派生特征——词形「相等」
//!   与「全等」在派生位都换出「全等」一支（「相等」只有落在标准库表里才是
//!   「部分相等」），写错得到的是重复的派生；
//! - 特征方法名写 `格式化方法`（换出平台要求的三个字母短名），接收者参数写
//!   `&可变 格式化参数<'_> `；方法名写「显示」会被换成同名的「可显示」类型，
//!   特征方法名就成了类型名；
//! - 词形「结果」同时对应成功结果与格式化结果两个类型，所以格式化侧那个一律
//!   写全路径 `标准库::格式化模块::结果`，不把短名使用进来顶掉成功结果。

使用 标准库::格式化模块::{可显示, 格式化参数};
使用 包::语言::{f 作为 带参消息};

/// 出错位置（1 起行/列，与 rustc 诊断的约定一致）
#[派生(调试, 克隆, 可复制, 部分相等, 全等)]
公开 结构体 源码位置 {
    /// 行号（从 1 开始）
    公开 行号: 无符号机器整数,
    /// 列号（从 1 开始）
    公开 列号: 无符号机器整数,
}

实现 源码位置 {
    /// 创建一个出错位置
    公开 函数 定点(行号: 无符号机器整数, 列号: 无符号机器整数) -> 自身 {
        自身 { 行号, 列号 }
    }

    /// 当前语言下的位置描述，如 `第 3 行第 5 列`
    公开 函数 描述(&自我) -> 字符串 {
        带参消息("err_line_col", &[&自我.行号.转字符串(), &自我.列号.转字符串()])
    }
}

/// 消息模板的占位符形状：决定实参个数与顺序
///
/// 原版把这件事藏在每条分支的写入宏实参里，改一个键要人工数占位符。
公开 枚举 填充形状 {
    /// 只填详情
    仅详情,
    /// 只填文件路径
    仅路径,
    /// 先文件路径再详情
    路径与详情,
}

实现 填充形状 {
    /// 是否要填文件路径
    函数 要路径(&自我) -> 布尔 {
        匹配 *自我 {
            填充形状::仅详情 => 假,
            填充形状::仅路径 => 真,
            填充形状::路径与详情 => 真,
        }
    }

    /// 是否要填详情
    函数 要详情(&自我) -> 布尔 {
        匹配 *自我 {
            填充形状::仅详情 => 真,
            填充形状::仅路径 => 假,
            填充形状::路径与详情 => 真,
        }
    }
}

/// 转译过程中的统一故障
///
/// 每个变体携带足够上下文（位置、名称、原因），[`转译故障::消息`] 与
/// 「可显示」输出可直接展示给用户的本地化消息。
#[派生(调试, 克隆, 部分相等)]
公开 枚举 转译故障 {
    /// 输入源码无效（空文件、非法编码等）
    输入无效 { 原因: 字符串 },
    /// 词法层面的故障（令牌无法识别等）
    词法故障 { 发生位置: 源码位置, 详情: 字符串 },
    /// 关键字/标识符映射缺失（找不到对应翻译）
    映射缺失 { 名称: 字符串, 发生位置: 选项<源码位置> },
    /// 检测到可疑 Unicode 混淆字符（零宽/双向/同形）
    混淆字符 { 发生位置: 源码位置, 涉事字符: 字符, 详情: 字符串 },
    /// 翻译缓存不可用（容量或状态异常）
    缓存不可用 { 原因: 字符串 },
    /// 暂不支持的语法构造
    不支持构造 { 构造: 字符串, 发生位置: 选项<源码位置> },
    /// 其他未分类故障
    其他故障 { 原因: 字符串 },
}

实现 转译故障 {
    /// 本地化消息文本
    ///
    /// 「有位置/无位置」在原版是两条臂，现在一条臂里按位置有无选键。
    公开 函数 消息(&自我) -> 字符串 {
        匹配 自我 {
            转译故障::输入无效 { 原因 } => 带参消息("err_input_invalid", &[原因]),
            转译故障::词法故障 { 发生位置, 详情 } => {
                带参消息("err_lex_error", &[&发生位置.描述(), 详情])
            }
            转译故障::映射缺失 { 名称, 发生位置 } => 匹配 发生位置 {
                有值(点) => 带参消息("err_mapping_missing_at", &[&点.描述(), 名称]),
                无 => 带参消息("err_mapping_missing", &[名称]),
            },
            转译故障::混淆字符 { 发生位置, 涉事字符, 详情 } => {
                // 码位先补零成 4 位十六进制，再作为单个占位符填进模板
                让 码位文字 = 格式化!("{:04X}", *涉事字符 作为 无符号整数);
                带参消息("err_confusion_char", &[&发生位置.描述(), &码位文字, 详情])
            }
            转译故障::缓存不可用 { 原因 } => 带参消息("err_cache_unavailable", &[原因]),
            转译故障::不支持构造 { 构造, 发生位置 } => 匹配 发生位置 {
                有值(点) => 带参消息("err_unsupported_at", &[&点.描述(), 构造]),
                无 => 带参消息("err_unsupported", &[构造]),
            },
            // 唯一不过模板的分支：调用方已经给出成品句子，原样透出
            转译故障::其他故障 { 原因 } => 原因.克隆值(),
        }
    }
}

实现 可显示 对于 转译故障 {
    函数 格式化方法(&自我, 参数: &可变 格式化参数<'_> ) -> 标准库::格式化模块::结果 {
        参数.写入字符串(&自我.消息())
    }
}

实现 标准库::错误模块::错误特征 对于 转译故障 {}

/// 出错数据源的种类（失败发生在哪一环）
公开 枚举 载入种类 {
    /// 必需文件不存在
    文件缺失,
    /// 读盘输入输出失败
    读取失败,
    /// TOML 解析失败
    解析失败,
}

/// 载入错误的目标数据源（选择本地化消息模板用）
#[派生(调试, 克隆, 可复制, 部分相等, 全等)]
公开 枚举 载入目标 {
    /// keywords.toml
    关键字表,
    /// module_paths.toml
    模块路径表,
    /// stdlib.toml
    标准库表,
    /// crates/*.toml 第三方库文件
    第三方库,
    /// 通用映射文件（单文件加载器）
    映射表,
    /// 内置关键字数据（编译期嵌入）
    内置关键字表,
    /// 内置模块路径数据（编译期嵌入）
    内置模块路径表,
    /// 内置标准库数据（编译期嵌入）
    内置标准库表,
    /// errors.toml 错误消息翻译表（诊断翻译层）
    错误消息表,
}

实现 载入目标 {
    /// 目标 × 失败种类 → (ui.toml 消息键, 占位符形状)
    ///
    /// 穷尽匹配是这次重构的全部动机：原版 `文件缺失`/`读取失败` 两条分支各带
    /// 一个 `_ =>` 兜底，新增目标只会静默落进兜底格子。表格化后，格子内容照抄
    /// 重构前实跑取值，一个字的差异都会撞红 `母语测试::载入消息穷尽表`。
    函数 消息方案(&自我, 种类: 载入种类) -> (字符串, 填充形状) {
        使用 载入种类::{文件缺失, 读取失败, 解析失败};
        使用 填充形状::{仅路径, 仅详情, 路径与详情};
        让 格子 = 匹配 (自我, 种类) {
            // 关键字表：三类失败各有专属键
            (载入目标::关键字表, 文件缺失) => ("load_keywords_missing", 仅路径),
            (载入目标::关键字表, 读取失败) => ("load_read_keywords_failed", 仅详情),
            (载入目标::关键字表, 解析失败) => ("load_parse_keywords_failed", 仅详情),
            // 模块路径表：缺失走通用键，读取/解析有专属键
            (载入目标::模块路径表, 文件缺失) => ("load_map_file_missing", 仅路径),
            (载入目标::模块路径表, 读取失败) => ("load_read_module_paths_failed", 仅详情),
            (载入目标::模块路径表, 解析失败) => ("load_parse_module_paths_failed", 仅详情),
            // 标准库与第三方库同属映射表族，消息带路径
            (载入目标::标准库表, 文件缺失) => ("load_map_file_missing", 仅路径),
            (载入目标::标准库表, 读取失败) => ("load_read_map_path_failed", 路径与详情),
            (载入目标::标准库表, 解析失败) => ("load_parse_map_path_failed", 路径与详情),
            (载入目标::第三方库, 文件缺失) => ("load_map_file_missing", 仅路径),
            (载入目标::第三方库, 读取失败) => ("load_read_map_path_failed", 路径与详情),
            (载入目标::第三方库, 解析失败) => ("load_parse_map_path_failed", 路径与详情),
            // 单文件加载器：消息不带路径
            (载入目标::映射表, 文件缺失) => ("load_map_file_missing", 仅路径),
            (载入目标::映射表, 读取失败) => ("load_read_map_failed", 仅详情),
            (载入目标::映射表, 解析失败) => ("load_parse_map_failed", 仅详情),
            // 内置数据本没有路径，也没有读盘这一步：解析失败有专属键，
            // 读取失败则沿用带路径的通用键（路径位填空）——重构前就是这个行为，
            // 原版的 `_ =>` 把它藏成了「新增内置目标自动继承」，现在摊开在表里。
            (载入目标::内置关键字表, 文件缺失) => ("load_map_file_missing", 仅路径),
            (载入目标::内置关键字表, 读取失败) => ("load_read_map_path_failed", 路径与详情),
            (载入目标::内置关键字表, 解析失败) => ("load_parse_builtin_keywords_failed", 仅详情),
            (载入目标::内置模块路径表, 文件缺失) => ("load_map_file_missing", 仅路径),
            (载入目标::内置模块路径表, 读取失败) => ("load_read_map_path_failed", 路径与详情),
            (载入目标::内置模块路径表, 解析失败) => ("load_parse_builtin_paths_failed", 仅详情),
            (载入目标::内置标准库表, 文件缺失) => ("load_map_file_missing", 仅路径),
            (载入目标::内置标准库表, 读取失败) => ("load_read_map_path_failed", 路径与详情),
            (载入目标::内置标准库表, 解析失败) => ("load_parse_builtin_stdlib_failed", 仅详情),
            // 错误消息表走诊断层原有的错误类键名（带路径的只读取一类）
            (载入目标::错误消息表, 文件缺失) => ("load_map_file_missing", 仅路径),
            (载入目标::错误消息表, 读取失败) => ("err_read_error_messages", 路径与详情),
            (载入目标::错误消息表, 解析失败) => ("err_parse_error_messages", 仅详情),
        };
        (格子.0.转字符串(), 格子.1)
    }
}

/// 语言包/映射表加载层的统一故障类型
///
/// 取代加载层旧有的 `结果<_, 字符串>`：变体携带结构化上下文（目标/路径/原因），
/// 调用方可按变体分类处理（文件缺失走回退链、解析失败直接终止）；「可显示」
/// 输出与旧字符串消息一致的本地化文本（复用同一批 ui.toml 键），消息不漂移。
#[派生(调试, 克隆, 部分相等, 全等)]
公开 枚举 载入故障 {
    /// 必需文件缺失（如 keywords.toml 不存在）
    文件缺失 { 目标: 载入目标, 文件路径: 字符串 },
    /// 读取文件输入输出失败
    读取失败 {
        目标: 载入目标,
        文件路径: 选项<字符串>,
        详情: 字符串,
    },
    /// TOML 解析失败
    解析失败 {
        目标: 载入目标,
        文件路径: 选项<字符串>,
        详情: 字符串,
    },
    /// 第三方库目录读取失败
    目录读取失败 { 详情: 字符串 },
}

实现 载入故障 {
    /// 展示用文件路径文本：没有路径的数据源（内置表）得到空串
    ///
    /// 原版在三个写入分支里各写一遍「克隆后取默认值」。
    函数 路径展示(&自我) -> 字符串 {
        匹配 自我 {
            载入故障::文件缺失 { 文件路径, .. } => 文件路径.克隆值(),
            载入故障::读取失败 { 文件路径, .. } => 文件路径.克隆值().取值或默认(),
            载入故障::解析失败 { 文件路径, .. } => 文件路径.克隆值().取值或默认(),
            载入故障::目录读取失败 { .. } => 字符串::新建(),
        }
    }

    /// 展示用详情文本：`文件缺失` 没有详情，得到空串
    函数 详情展示(&自我) -> 字符串 {
        匹配 自我 {
            载入故障::文件缺失 { .. } => 字符串::新建(),
            载入故障::目录读取失败 { 详情 } => 详情.克隆值(),
            载入故障::读取失败 { 详情, .. } => 详情.克隆值(),
            载入故障::解析失败 { 详情, .. } => 详情.克隆值(),
        }
    }

    /// 本条故障的消息键与占位符形状
    函数 方案(&自我) -> (字符串, 填充形状) {
        匹配 自我 {
            载入故障::文件缺失 { 目标, .. } => 目标.消息方案(载入种类::文件缺失),
            载入故障::读取失败 { 目标, .. } => 目标.消息方案(载入种类::读取失败),
            载入故障::解析失败 { 目标, .. } => 目标.消息方案(载入种类::解析失败),
            // 目录读取失败没有目标维度，单独一格
            载入故障::目录读取失败 { .. } => {
                ("load_read_dir_failed".转字符串(), 填充形状::仅详情)
            }
        }
    }

    /// 本地化消息文本
    ///
    /// 「可显示」只负责把它写进格式化器；调用方要纯文本时不必再转字符串。
    公开 函数 消息(&自我) -> 字符串 {
        让 (键名, 形状) = 自我.方案();
        让 路径文字 = 自我.路径展示();
        让 详情文字 = 自我.详情展示();
        让 可变 填充: 向量<&文本> = 向量::新建();
        如果 形状.要路径() {
            填充.推入(路径文字.作为字符串());
        }
        如果 形状.要详情() {
            填充.推入(详情文字.作为字符串());
        }
        带参消息(&键名, &填充)
    }
}

实现 可显示 对于 载入故障 {
    函数 格式化方法(&自我, 参数: &可变 格式化参数<'_> ) -> 标准库::格式化模块::结果 {
        参数.写入字符串(&自我.消息())
    }
}

实现 标准库::错误模块::错误特征 对于 载入故障 {}

#[配置(测试)]
模块 母语测试 {
    使用 超级::*;
    使用 包::语言;

    // 本模块消息按当前语言取模板，断言前需钉住中文语言码并串行化
    函数 中文护() -> 语言::语言测试护 {
        语言::钉住语言("zh")
    }

    /// 占位文本：路径固定 `P`、详情固定 `D`，与重构前取证脚本一致
    函数 三件套(目标: 载入目标) -> (载入故障, 载入故障, 载入故障, 载入故障, 载入故障) {
        (
            载入故障::文件缺失 { 目标, 文件路径: "P".转字符串() },
            载入故障::读取失败 { 目标, 文件路径: 有值("P".转字符串()), 详情: "D".转字符串() },
            载入故障::读取失败 { 目标, 文件路径: 无, 详情: "D".转字符串() },
            载入故障::解析失败 { 目标, 文件路径: 有值("P".转字符串()), 详情: "D".转字符串() },
            载入故障::解析失败 { 目标, 文件路径: 无, 详情: "D".转字符串() },
        )
    }

    /// 28 格消息逐字等于重构前实跑取证（`.rz/probe9-matrix.txt`）
    #[测试]
    函数 载入消息穷尽表() {
        让 _护 = 中文护();
        让 目标们: [(载入目标, &文本); 9] = [
            (载入目标::关键字表, "关键字表"),
            (载入目标::模块路径表, "模块路径表"),
            (载入目标::标准库表, "标准库表"),
            (载入目标::第三方库, "第三方库"),
            (载入目标::映射表, "映射表"),
            (载入目标::内置关键字表, "内置关键字表"),
            (载入目标::内置模块路径表, "内置模块路径表"),
            (载入目标::内置标准库表, "内置标准库表"),
            (载入目标::错误消息表, "错误消息表"),
        ];
        // (缺失, 读取带路径, 读取无路径, 解析带路径, 解析无路径)
        让 期望: [(&文本, &文本, &文本, &文本, &文本, &文本); 9] = [
            ("关键字表", "关键字文件不存在: P", "无法读取关键字文件: D", "无法读取关键字文件: D", "解析关键字 TOML 失败: D", "解析关键字 TOML 失败: D"),
            ("模块路径表", "映射表文件不存在: P", "无法读取模块路径文件: D", "无法读取模块路径文件: D", "解析模块路径 TOML 失败: D", "解析模块路径 TOML 失败: D"),
            ("标准库表", "映射表文件不存在: P", "读取映射表 P 失败: D", "读取映射表  失败: D", "解析映射表 P 失败: D", "解析映射表  失败: D"),
            ("第三方库", "映射表文件不存在: P", "读取映射表 P 失败: D", "读取映射表  失败: D", "解析映射表 P 失败: D", "解析映射表  失败: D"),
            ("映射表", "映射表文件不存在: P", "读取映射表失败: D", "读取映射表失败: D", "解析映射表失败: D", "解析映射表失败: D"),
            ("内置关键字表", "映射表文件不存在: P", "读取映射表 P 失败: D", "读取映射表  失败: D", "解析内置关键字 TOML 失败: D", "解析内置关键字 TOML 失败: D"),
            ("内置模块路径表", "映射表文件不存在: P", "读取映射表 P 失败: D", "读取映射表  失败: D", "解析内置模块路径 TOML 失败: D", "解析内置模块路径 TOML 失败: D"),
            ("内置标准库表", "映射表文件不存在: P", "读取映射表 P 失败: D", "读取映射表  失败: D", "解析内置标准库 TOML 失败: D", "解析内置标准库 TOML 失败: D"),
            ("错误消息表", "映射表文件不存在: P", "无法读取错误消息文件 P: D", "无法读取错误消息文件 : D", "解析错误消息 TOML 失败: D", "解析错误消息 TOML 失败: D"),
        ];
        对于 序号 在 0..9 {
            让 (目标, 名) = 目标们[序号];
            让 样本行 = 期望[序号];
            让 (缺失, 读取有, 读取无, 解析有, 解析无) = 三件套(目标);
            断言相等!(缺失.消息(), 样本行.1, "{名} 文件缺失");
            断言相等!(读取有.消息(), 样本行.2, "{名} 读取失败(有路径)");
            断言相等!(读取无.消息(), 样本行.3, "{名} 读取失败(无路径)");
            断言相等!(解析有.消息(), 样本行.4, "{名} 解析失败(有路径)");
            断言相等!(解析无.消息(), 样本行.5, "{名} 解析失败(无路径)");
            // 无路径的数据源不该有读盘失败：兜底格子会带出「路径位空白」的
            // 旧行为，这里钉住它，将来要改必须先改测试（而不是静默改消息）。
            断言相等!(读取无.转字符串(), 样本行.3);
        }
        断言相等!(
            载入故障::目录读取失败 { 详情: "D".转字符串() }.消息(),
            "读取第三方库目录失败: D"
        );
    }

    /// 7 臂 9 组消息逐字等于重构前取证，且 `消息()` 与「可显示」恒等
    #[测试]
    函数 转译消息全变体() {
        让 _护 = 中文护();
        让 用例: [(转译故障, &文本); 9] = [
            (转译故障::输入无效 { 原因: "R".转字符串() }, "输入无效：R"),
            (
                转译故障::词法故障 { 发生位置: 源码位置::定点(2, 10), 详情: "D".转字符串() },
                "词法错误（第 2 行第 10 列）：D",
            ),
            (
                转译故障::映射缺失 { 名称: "N".转字符串(), 发生位置: 有值(源码位置::定点(1, 1)) },
                "映射缺失（第 1 行第 1 列）：找不到 `N` 的翻译映射",
            ),
            (
                转译故障::映射缺失 { 名称: "N".转字符串(), 发生位置: 无 },
                "映射缺失：找不到 `N` 的翻译映射",
            ),
            (
                转译故障::混淆字符 {
                    发生位置: 源码位置::定点(1, 4),
                    涉事字符: '\u{200B}',
                    详情: "D".转字符串(),
                },
                "检测到可疑 Unicode 字符（第 1 行第 4 列）：U+200B（D）",
            ),
            (转译故障::缓存不可用 { 原因: "R".转字符串() }, "翻译缓存不可用：R"),
            (
                转译故障::不支持构造 { 构造: "C".转字符串(), 发生位置: 有值(源码位置::定点(7, 8)) },
                "暂不支持的语法构造（第 7 行第 8 列）：`C`",
            ),
            (
                转译故障::不支持构造 { 构造: "C".转字符串(), 发生位置: 无 },
                "暂不支持的语法构造：`C`",
            ),
            (转译故障::其他故障 { 原因: "R".转字符串() }, "R"),
        ];
        对于 (样例, 期望) 在 用例 {
            断言相等!(样例.消息(), *期望);
            断言相等!(样例.转字符串(), *期望, "消息() 必须与 Display 逐字一致");
        }
    }

    #[测试]
    函数 位置描述() {
        让 _护 = 中文护();
        断言相等!(源码位置::定点(3, 5).描述(), "第 3 行第 5 列");
    }

    /// 码位补零宽度：不足 4 位补零，超过 4 位不截断
    #[测试]
    函数 混淆字符码位宽度() {
        让 _护 = 中文护();
        让 码位: [(字符, &文本); 4] = [
            ('\u{200B}', "200B"),
            ('\u{A}', "000A"),
            ('\u{1F600}', "1F600"),
            ('\u{10FFFF}', "10FFFF"),
        ];
        对于 (字, 期望) 在 码位 {
            让 样例 = 转译故障::混淆字符 {
                发生位置: 源码位置::定点(1, 1),
                涉事字符: 字,
                详情: "D".转字符串(),
            };
            断言!(样例.消息().包含(期望), "{:?} 应含码位 {}: {}", 字, 期望, 样例.消息());
        }
    }

    /// 可向上转型为装箱的动态错误特征对象，供第三方错误链库使用
    #[测试]
    函数 标准错误特征可用() {
        让 _护 = 中文护();
        让 样例: 盒子<动态 标准库::错误模块::错误特征> = 盒子::新建(
            转译故障::其他故障 { 原因: "未知故障".转字符串() },
        );
        断言相等!(样例.转字符串(), "未知故障");
    }

    /// 枚举化后消息与旧字符串错误一致（复用同一批 ui.toml 键），且可按变体分类
    #[测试]
    函数 载入消息与旧键一致() {
        让 _护 = 中文护();
        让 缺失 = 载入故障::文件缺失 { 目标: 载入目标::关键字表, 文件路径: "/lp/keywords.toml".转字符串() };
        断言!(缺失.消息().包含("关键字文件不存在"));
        让 解析 = 载入故障::解析失败 {
            目标: 载入目标::内置标准库表,
            文件路径: 无,
            详情: "expected value".转字符串(),
        };
        断言相等!(解析.消息(), "解析内置标准库 TOML 失败: expected value");
        让 第三方 = 载入故障::解析失败 {
            目标: 载入目标::第三方库,
            文件路径: 有值("\"crates/web.toml\"".转字符串()),
            详情: "bad".转字符串(),
        };
        断言相等!(第三方.消息(), "解析映射表 \"crates/web.toml\" 失败: bad");
        // 程序化分类：文件缺失可回退，解析失败应终止
        匹配 缺失 {
            载入故障::文件缺失 { .. } => {},
            _ => 不可达!("文件缺失必须落在文件缺失变体"),
        }
    }

    /// `路径展示`/`详情展示` 是消息组装的唯一取数口，缺侧留空串
    #[测试]
    函数 展示取数口() {
        让 _护 = 中文护();
        让 缺失 = 载入故障::文件缺失 { 目标: 载入目标::映射表, 文件路径: "a.toml".转字符串() };
        断言相等!(缺失.路径展示(), "a.toml");
        断言相等!(缺失.详情展示(), "");
        让 读取 = 载入故障::读取失败 {
            目标: 载入目标::映射表,
            文件路径: 无,
            详情: "boom".转字符串(),
        };
        断言相等!(读取.路径展示(), "");
        断言相等!(读取.详情展示(), "boom");
        让 目录 = 载入故障::目录读取失败 { 详情: "op".转字符串() };
        断言相等!(目录.路径展示(), "");
        断言相等!(目录.详情展示(), "op");
    }
}
