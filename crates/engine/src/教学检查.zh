//! 教学 lint 模块
//! 针对 Rust 初学者的启发式代码风格提示（教学价值驱动）：
//! 与编译器错误不同，这些提示不阻断编译，只在代码位置出现常见
//! 教学问题时给出建设性建议。规则刻意保守，避免噪音——教学工具的
//! 提示必须每条都有价值：
//! - 未标注类型：仅在类型**无法靠初始化式自行推导**的歧义形态提示
//!   （`让 横坐标 = 向量::新建();`、`让 横坐标 = 迭代器.收集();`）——这类位置
//!   rustc 迟早要求 E0282 注解，提前给出建设性建议；字面量、普通函数/
//!   方法调用、结构体/元组/数组、路径与块表达式的类型均可自行推导，
//!   提示「显式写出类型」无解且成噪音，不报告
//! - 魔法数字：非平凡数字字面量（命名常量教学）
//! - 嵌套过深：代码行缩进过深（重构教学，每文件仅首个）
//! - 易混方法名：方法调用位未命中映射表且与表内词近似的长中文串
//!   （如 `.拉平()` 应为 `.展平()`，编辑距离 ≤1 才提示以降噪）
//!
//! 行注释含「教学忽略」时整行跳过（教师可标注故意不修的示例）：
//! `让 横坐标 = 5;  // 教学忽略` 不产生任何教学警告。
//!
//! 扫描器与 fullwidth 模块同构：状态机跳过字符串/字符/原始字符串与
//! 注释，仅在代码位置判定，避免把字符串内容误判为代码问题。

使用 标准库::集合::哈希集合;
使用 标准库::同步模块::原子::{原子布尔, 内存序};

/// 教学 lint 全局开关（默认开启，进程级）
///
/// 项目开发（非教学）场景下，初学者代码风格提示会在每次转译时刷屏；
/// CLI `--no-lint` 置为关闭（见 [`设定教学检查开关`]）。
/// 仅影响教学 lint 输出，Unicode 混杂/全角标点告警不受影响；
/// 与日志级别（logger）同为进程级配置。
静态 教学提示开关: 原子布尔 = 原子布尔::新建(真);

/// 设置教学 lint 开关（进程级；测试与嵌入场景使用）
公开 函数 设定教学检查开关(启用值: 布尔) {
    教学提示开关.存值(启用值, 内存序::松弛序);
}

/// 查询教学 lint 开关（输出方：转译管线/CLI 逐文件告警均据此静默）
公开 函数 教学检查开关() -> 布尔 {
    教学提示开关.加载(内存序::松弛序)
}

/// 教学 lint 规则种类
#[派生(调试, 克隆, 可复制, 部分相等, 等号码)]
公开 枚举 检查种类 {
    /// `让` 绑定缺少类型注解
    未标注类型,
    /// 非平凡数字字面量（建议命名常量）
    魔法数字,
    /// 代码行嵌套过深（建议拆分函数）
    嵌套过深,
    /// 方法调用位的长中文串未命中映射表且与表内词近似（疑似笔误）
    易混方法名,
}

/// 单个教学 lint 警告：位置（1 起行/列）+ 规则 + 相关文本
#[派生(调试, 克隆, 部分相等)]
公开 结构体 检查警告 {
    /// 行号（从 1 开始）
    公开 行号: 无符号机器整数,
    /// 列号（从 1 开始，按字符计数）
    公开 列号: 无符号机器整数,
    /// 规则种类
    公开 种类: 检查种类,
    /// 相关文本（魔法数字原文、方法名等；其他规则为空串）
    公开 相关文本: 字符串,
    /// 补充文本（易混词提示的候选词等；其他规则为空串）
    公开 补充文本: 字符串,
}

实现 检查警告 {
    /// 格式化为单行提示文本，模板随当前语言变化
    公开 函数 格式化提示(&自我) -> 字符串 {
        匹配 自我.种类 {
            检查种类::未标注类型 => 包::语言::查译(
                "lint_untyped_let",
                &[&自我.行号.转字符串(), &自我.列号.转字符串()],
            ),
            检查种类::魔法数字 => 包::语言::查译(
                "lint_magic_number",
                &[&自我.行号.转字符串(), &自我.列号.转字符串(), &自我.相关文本],
            ),
            检查种类::嵌套过深 => {
                包::语言::查译("lint_deep_indent", &[&自我.行号.转字符串(), &自我.相关文本])
            }
            检查种类::易混方法名 => 包::语言::查译(
                "lint_confusable_method",
                &[
                    &自我.行号.转字符串(),
                    &自我.列号.转字符串(),
                    &自我.相关文本,
                    &自我.补充文本,
                ],
            ),
        }
    }
}

/// 进行中的 `让` 绑定扫描（等待语句结束判定是否有类型注解）
结构体 让扫描状态 {
    行号: 无符号机器整数,
    列号: 无符号机器整数,
    /// 已见到 `=`（其后出现的 `:` 是路径分隔符而非类型注解）
    已见等号: 布尔,
    /// 已见到 `:`（类型注解）
    已注解: 布尔,
    /// `=` 之后的初始化式原文（到 `;`/`{`/`}` 为止；用于判定类型能否
    /// 自行推导，仅在无注解时参与判定）
    初始化式: 字符串,
}

/// 类型推导歧义构造器的英文被调名（无映射表时的兜底集合）
常量 英文歧义构造器: &[&文本] = &["new", "default"];

/// 对源码执行教学 lint（无已知词表：不做易混方法名提示），返回全部警告（升序）
///
/// 兼容入口；需要易混方法名提示（方法调用位未命中映射表）时用
/// [`执行教学检查并词表`] 并传入映射表键集合。
公开 函数 执行教学检查(源码: &文本) -> 向量<检查警告> {
    让 歧义词集: 哈希集合<字符串> = 英文歧义构造器
        .迭代()
        .变换(|字符串项| 字符串项.转字符串())
        .收集();
    执行教学检查并词表(源码, &哈希集合::新建(), &歧义词集)
}

/// 对源码执行教学 lint，返回全部警告（升序）
///
/// `known_words`：全部映射表键的集合（关键字/宏/派生/模块路径/别名）。
/// 方法调用位出现未命中词表的长中文串（≥2 字）且与表内词近似
/// （编辑距离 ≤1）时提示疑似笔误——未命中词会被原样保留，错误在
/// 产物侧才爆发（如 `.拉平()` 应为 `.展平()`）。
///
/// `ambiguous_constructors`：类型推导歧义构造器的被调名集合（含英文
/// `新建`/`缺省` 及其各方言映射词，如「新建」「缺省」），由
/// `映射管理器::歧义构造词集` 提供；仅这些关联构造
/// 的无 turbofish 调用与无 turbofish 的 `.收集()` 才触发未标注类型提示。
///
/// 仅报告代码位置的问题；字符串/注释内的同名文本被状态机跳过。
公开 函数 执行教学检查并词表(
    源码: &文本,
    已知词表: &哈希集合<字符串>,
    歧义构造器集: &哈希集合<字符串>,
) -> 向量<检查警告> {
    让 字符序列: 向量<字符> = 源码.逐字符().收集();
    让 可变 警告表 = 向量::新建();
    让 可变 行号 = 1usize;
    让 可变 列号 = 1usize;
    // 字面量状态：0 = 代码位置；1 = 双引号串 2 = 字符 3 = 原始串
    让 可变 字面量态: 无符号微整数 = 0;
    让 可变 原始井数 = 0usize;
    让 可变 上一字 = '\0';
    // 行首缩进追踪（仅代码行累计，用于嵌套深度提示）
    让 可变 行缩进 = 0usize;
    让 可变 在行首 = 真;
    让 可变 首非空是注释 = 假;
    让 可变 深层已报 = 假;
    // 未标注类型扫描状态
    让 可变 让扫描: 选项<让扫描状态> = 无;
    // 行注释含「教学忽略」的行号：整行跳过教学警告（教师标注故意不修的示例）
    让 可变 忽略行集: 哈希集合<无符号机器整数> = 哈希集合::新建();

    让 可变 下标 = 0usize;
    当 下标 < 字符序列.元素数() {
        让 本字符 = 字符序列[下标];
        // 行首缩进累计（独立于字面量状态：多行字符串内部行由 literal
        // 分支吞掉，不会走到这里；行首仅代码位置才累计）
        如果 在行首 && 字面量态 == 0 {
            匹配 本字符 {
                ' ' => {
                    行缩进 += 1;
                    下标 += 1;
                    列号 += 1;
                    继续;
                }
                '\t' => {
                    行缩进 += 4;
                    下标 += 1;
                    列号 += 1;
                    继续;
                }
                '\n' => {
                    // 空行/纯空白行的换行：须与主循环的换行处理一致（行号 +1、列复位），
                    // 否则空行不计行，其后所有警告位置整体前移（回归：第 5 行的 `让`
                    // 因上方两个空行被报成第 3 行）
                    行号 += 1;
                    列号 = 1;
                    行缩进 = 0;
                    在行首 = 真;
                    首非空是注释 = 假;
                    上一字 = '\0';
                    下标 += 1;
                    继续;
                }
                '/' 如果 !首非空是注释
                    && 下标 + 1 < 字符序列.元素数()
                    && (字符序列[下标 + 1] == '/' || 字符序列[下标 + 1] == '*') =>
                {
                    // 注释行：不参与嵌套深度提示
                    首非空是注释 = 真;
                    在行首 = 假;
                }
                _ => {
                    // 首个非空白字符（非注释）：代码行，判定嵌套深度
                    如果 行缩进 >= 嵌套深度阈值 && !深层已报 {
                        深层已报 = 真;
                        警告表.推入(检查警告 {
                            行号,
                            列号: 行缩进 + 1,
                            种类: 检查种类::嵌套过深,
                            相关文本: 行缩进.转字符串(),
                            补充文本: 字符串::新建(),
                        });
                    }
                    在行首 = 假;
                }
            }
        }
        如果 本字符 == '\n' {
            行号 += 1;
            列号 = 1;
            行缩进 = 0;
            在行首 = 真;
            首非空是注释 = 假;
            上一字 = '\0';
            如果 字面量态 == 2 || 字面量态 == 3 {
                // 防御：字符/原始串内出现未闭合引号时在行尾强制退出，
                // 避免状态污染后续行（编译器本就会报错，此处只为正确判定）
                字面量态 = 0;
            }
            下标 += 1;
            继续;
        }
        匹配 字面量态 {
            1 | 2 => {
                // 字符串/字符字面量：转义跳过下一字符，闭合引号退出
                如果 本字符 == '\\' {
                    下标 += 2;
                    列号 += 1;
                    继续;
                }
                让 结束引号 = 如果 字面量态 == 1 { '"' } 否则 { '\'' };
                如果 本字符 == 结束引号 {
                    字面量态 = 0;
                }
            }
            3 => {
                // 原始字符串 r#"..."#：遇 " 后跟等量 #（或行尾/EOF）退出
                如果 本字符 == '"' {
                    让 井号数 = 字符序列[下标 + 1..].迭代().取前(|字符值| **字符值 == '#').计数();
                    如果 井号数 >= 原始井数 {
                        字面量态 = 0;
                        原始井数 = 0;
                    }
                }
            }
            _ => 匹配 本字符 {
                '"' => 字面量态 = 1,
                '\'' => 字面量态 = 2,
                // 行注释：吞到行尾（\n 留给主循环统一处理）
                '/' 如果 上一字 == '/' => {
                    让 注释起始 = 下标;
                    列号 -= 1;
                    当 下标 < 字符序列.元素数() && 字符序列[下标] != '\n' {
                        下标 += 1;
                        列号 += 1;
                    }
                    // 注释含「教学忽略」：整行跳过教学警告
                    让 注释文: 字符串 = 字符序列[注释起始..下标].迭代().收集();
                    如果 注释文.包含(教学忽略标记) {
                        忽略行集.插入(行号);
                    }
                    上一字 = '\0';
                    继续;
                }
                // 块注释（不处理嵌套，够用）
                '*' 如果 上一字 == '/' => {
                    列号 -= 1;
                    当 下标 < 字符序列.元素数() {
                        让 次字符 = 字符序列[下标];
                        下标 += 1;
                        如果 次字符 == '\n' {
                            行号 += 1;
                            列号 = 1;
                        } 否则 如果 次字符 == '*' && 下标 < 字符序列.元素数() && 字符序列[下标] == '/' {
                            下标 += 1;
                            列号 += 2;
                            中断;
                        } 否则 {
                            列号 += 1;
                        }
                    }
                    上一字 = '\0';
                    继续;
                }
                // 原始字符串前缀 r#"..."#（r 或 br 后跟 " 或 #）
                'r' | 'b' 如果 是原始前缀(上一字) => {
                    让 可变 新井数 = 0usize;
                    让 可变 内索引 = 下标 + 1;
                    当 内索引 < 字符序列.元素数() && 字符序列[内索引] == '#' {
                        新井数 += 1;
                        内索引 += 1;
                    }
                    如果 内索引 < 字符序列.元素数() && 字符序列[内索引] == '"' {
                        原始井数 = 新井数;
                        字面量态 = 3;
                        下标 = 内索引 + 1;
                        列号 += 1 + 新井数 + 1;
                        继续;
                    }
                }
                // `让` 关键字：简单标识符绑定时开始未标注类型扫描（前后均须
                // 有标识符边界）；模式解构绑定（元组/结构体/数组/枚举解构、
                // 让-否则、let 链）不做提示——教学示例均以不标注形式书写，
                // 且无法自然标注类型（须标注整个模式），提示无解成噪音
                '让' 如果 是标识符边界(上一字)
                    && (下标 + 1 >= 字符序列.元素数() || 是标识符边界(字符序列[下标 + 1])) =>
                {
                    // 前一个 let 未闭合（上一语句缺分号）：先收尾
                    收尾让扫描(&可变 让扫描, &可变 警告表, 歧义构造器集);
                    如果 是简单让绑定(&字符序列, 下标 + 1) {
                        让扫描 = 有值(让扫描状态 {
                            行号,
                            列号,
                            已见等号: 假,
                            已注解: 假,
                            初始化式: 字符串::新建(),
                        });
                    }
                }
                // 数字字面量（前一字不是标识符字符时才是独立字面量）
                字 如果 字.是数字字符() && 是标识符边界(上一字) => {
                    下标 = 扫描数字(&字符序列, 下标, 本字符, &可变 警告表, 行号, 列号, 上一字);
                    继续;
                }
                // 方法调用位的长中文串（如 `.拉平()`）：未命中映射表且与
                // 表内词近似时提示疑似笔误——未命中词会被原样保留，错误在
                // 产物侧才爆发（#14）。仅调用位（后随 `(`）判定以降噪；
                // `..` 范围与浮点（前一字为 `.`/数字）不启动扫描。
                '.' 如果 上一字 != '.' && !上一字.是数字字符() => {
                    如果 让 有值(名字) = 扫描方法名(&字符序列, 下标)
                        && 让 有值(候选词) = 易混候选(&名字, 已知词表)
                    {
                        警告表.推入(检查警告 {
                            行号,
                            列号: 列号 + 1,
                            种类: 检查种类::易混方法名,
                            相关文本: 名字,
                            补充文本: 候选词.转字符串(),
                        });
                    }
                }
                _ => {}
            },
        }
        // let 扫描推进：仅在代码位置处理语句内符号
        如果 让 有值(扫描) = 让扫描.作为可变引用方法() {
            匹配 本字符 {
                ':' 如果 !扫描.已见等号 => 扫描.已注解 = 真,
                '=' => 扫描.已见等号 = 真,
                ';' | '{' | '}' => {
                    收尾让扫描(&可变 让扫描, &可变 警告表, 歧义构造器集)
                }
                _ 如果 扫描.已见等号 => 扫描.初始化式.推入(本字符),
                _ => {}
            }
        }
        下标 += 1;
        列号 += 1;
        如果 本字符 != ' ' && 本字符 != '\t' && 字面量态 == 0 {
            上一字 = 本字符;
        }
    }
    收尾让扫描(&可变 让扫描, &可变 警告表, 歧义构造器集);
    // 过滤被「教学忽略」标记的行（三种规则统一按行过滤）
    警告表.保留(|警告项| !忽略行集.包含(&警告项.行号));
    警告表
}

/// 教学忽略标记：行注释含此文本时该行跳过全部教学警告
公开 常量 教学忽略标记: &文本 = "教学忽略";

/// 嵌套深度阈值：前导缩进 ≥ 此空格数时提示（24 = 6 层，4 空格一层）
常量 嵌套深度阈值: 无符号机器整数 = 24;

/// 判定字符是否可作为标识符边界（非字母/数字/下划线即边界）
函数 是标识符边界(字: 字符) -> 布尔 {
    !(字.是否为字母数字() || 字 == '_')
}

/// 判定前一字符是否可作为原始字符串前缀（r#/br#：前一字为行首/空白/运算符）
函数 是原始前缀(前一: 字符) -> 布尔 {
    前一 == '\0' || 前一.是否为空白() || "([{<,;:!?&|=+-*/%^".包含(前一)
}

/// 判定 `让` 后的绑定是否为简单标识符绑定（`名字` / `可变 名字`）
///
/// `从` 为「让」之后的下标。仅简单绑定参与「未标注类型」提示；
/// 模式解构绑定（`(甲, 乙)`、`点 { 横坐标, 纵坐标 }`、`[首, 次]`、`有值(数)`、
/// `枚举::变体(数)` 等）返回 false——这类绑定须标注整个模式的类型
/// （远超初学者范围），教程示例均不标注，提示无解且成噪音。
///
/// 无法归类的形态（如语法错误、注释紧跟）一律返回 false（宁缺毋滥）。
函数 是简单让绑定(字符序列: &[字符], 起始下标: 无符号机器整数) -> 布尔 {
    让 可变 内索引 = 起始下标;
    // 跳过空白（含换行：多行布局不影响绑定判定）
    当 内索引 < 字符序列.元素数() && 字符序列[内索引].是否为空白() {
        内索引 += 1;
    }
    // 可选「可变」前缀（`让 可变 名字 = …`；须为独立词）
    如果 以独立词开始(字符序列, 内索引, "可变") {
        内索引 += "可变".逐字符().计数();
        当 内索引 < 字符序列.元素数() && 字符序列[内索引].是否为空白() {
            内索引 += 1;
        }
    }
    // 绑定首字符须为标识符字符：`(`/`[`/`{` 等模式起始一律排除
    如果 内索引 >= 字符序列.元素数() || !(字符序列[内索引].是否为字母数字() || 字符序列[内索引] == '_') {
        返回 假;
    }
    // 收集标识符（到名字结束），再跳过名字与后续符号之间的空白
    让 可变 次索引 = 内索引;
    当 次索引 < 字符序列.元素数() && (字符序列[次索引].是否为字母数字() || 字符序列[次索引] == '_') {
        次索引 += 1;
    }
    当 次索引 < 字符序列.元素数() && 字符序列[次索引].是否为空白() {
        次索引 += 1;
    }
    匹配 字符序列.获取(次索引) {
        // `名字 = …` / `名字;`（语法错，交给编译器）：简单绑定
        有值('=' | ';') => 真,
        // 单个 `:` 是类型标注（`名字: 类型 = …`）；`::` 是路径
        // （`枚举::变体(数)` 模式）——后者非简单绑定
        有值(':') => !模式匹配!(字符序列.获取(次索引 + 1), 有值(':')),
        // `名字(` / `名字 {` 等模式、行尾、无法归类的形态：不提示
        _ => 假,
    }
}

/// 判断 `逐字符[内索引..]` 是否以独立词 `word` 开头（词后不能紧跟标识符续字符）
函数 以独立词开始(字符序列: &[字符], 内索引: 无符号机器整数, 词项: &文本) -> 布尔 {
    让 词: 向量<字符> = 词项.逐字符().收集();
    如果 内索引 + 词.元素数() > 字符序列.元素数() || 字符序列[内索引..内索引 + 词.元素数()] != 词[..] {
        返回 假;
    }
    !模式匹配!(字符序列.获取(内索引 + 词.元素数()), 有值(字) 如果 字.是否为字母数字() || *字 == '_')
}

/// 收尾进行中的 `让` 扫描：无类型注解且初始化式类型无法自行推导时报告
函数 收尾让扫描(
    让扫描: &可变 选项<让扫描状态>,
    警告表: &可变 向量<检查警告>,
    歧义构造器集: &哈希集合<字符串>,
) {
    如果 让 有值(扫描) = 让扫描.取值()
        && !扫描.已注解
        && 初始化式需注解(&扫描.初始化式, 歧义构造器集)
    {
        警告表.推入(检查警告 {
            行号: 扫描.行号,
            列号: 扫描.列号,
            种类: 检查种类::未标注类型,
            相关文本: 字符串::新建(),
            补充文本: 字符串::新建(),
        });
    }
}

/// 判定初始化式是否属于「类型无法自行推导、需要显式注解」的歧义形态
///
/// Rust 的局部变量类型绝大多数可由初始化式推导（字面量、普通函数/方法
/// 调用、宏、结构体/元组/数组、路径引用、块与控制流表达式）；仅少数
/// 构造的结果类型依赖使用处，rustc 会以 E0282（type annotations needed）
/// 要求注解。教学提示只在这些位置才有建设性：
/// - 无 turbofish 的歧义关联构造器：`X::新建()`、`X::缺省()`
///   （`X` 是任意路径段，含方言写法 `向量::新建()`——翻译后判定）；
/// - 无 turbofish 的 `.收集()` 收集（目标集合类型未知）。
///
/// 纯词法启发式（与扫描器同构，不做语法分析）；无法归类时保守不报告，
/// 真歧义自有 rustc E0282 兜底。
函数 初始化式需注解(初始化式: &文本, 歧义构造器集: &哈希集合<字符串>) -> 布尔 {
    让 错误值 = 初始化式.裁剪();
    如果 错误值.是否为空() {
        返回 假;
    }
    // 去空白紧致形式（允许跨行/任意空格布局）
    让 紧致式: 字符串 = 错误值.逐字符().过滤(|字符值| !字符值.是否为空白()).收集();
    // turbofish `::<类型>` 已显式给出类型，不再歧义
    如果 紧致式.包含("::<") {
        返回 假;
    }
    // .收集()（含方法链前缀）：目标集合类型未知
    如果 紧致式.以结尾(".collect()") {
        返回 真;
    }
    // 首个调用的被调名：取第一个 '(' 前的标识符末段
    // 宏调用（'(' 紧邻 '!'，如 向量宏![]/println!()）跳过
    让 有值(开括号) = 紧致式.查找('(') 否则 {
        返回 假;
    };
    如果 开括号 > 0 && 紧致式.转为字节()[开括号 - 1] == b'!' {
        返回 假;
    }
    让 前文 = &紧致式[..开括号];
    // 路径末段（:: 之后），否则整段即被调名
    让 叶名 = 前文.逆分割("::").下一个().解包或用(前文);
    // 仅关联函数（路径含 ::）的歧义构造器提示；集合含英文 新建/缺省
    // 与其各方言映射词（如「新建」「缺省」）；裸调用 `新建()` 不提示
    前文.包含("::") && 歧义构造器集.包含(叶名)
}

/// 数字字面量扫描：返回结束位置（i 应前进到的下标）
///
/// 跳过 0x/0b/0o 前缀字面量；解析十进制（含小数点/科学计数法/下划线），
/// 值属于平凡集合（0/1/2 及其负数）时不报告。
函数 扫描数字(
    字符序列: &[字符],
    起始下标: 无符号机器整数,
    首字符: 字符,
    警告表: &可变 向量<检查警告>,
    行号: 无符号机器整数,
    列号: 无符号机器整数,
    上一字: 字符,
) -> 无符号机器整数 {
    让 可变 下标 = 起始下标;
    // 0x/0b/0o 前缀：跳过整个字面量（教学场景罕见，不提示）
    如果 首字符 == '0' && 下标 + 1 < 字符序列.元素数() && 模式匹配!(字符序列[下标 + 1], 'x' | 'b' | 'o') {
        下标 += 2;
        当 下标 < 字符序列.元素数() && (字符序列[下标].是ASCII字母数字() || 字符序列[下标] == '_') {
            下标 += 1;
        }
        返回 下标;
    }
    让 数字起始 = 下标;
    // 整数部分：[0-9_]+
    当 下标 < 字符序列.元素数() && (字符序列[下标].是数字字符() || 字符序列[下标] == '_') {
        下标 += 1;
    }
    // 小数部分：. + [0-9_]+
    如果 下标 + 1 < 字符序列.元素数() && 字符序列[下标] == '.' && 字符序列[下标 + 1].是数字字符() {
        下标 += 1;
        当 下标 < 字符序列.元素数() && (字符序列[下标].是数字字符() || 字符序列[下标] == '_') {
            下标 += 1;
        }
    }
    // 科学计数法：[eE][+-]?[0-9_]+
    如果 下标 < 字符序列.元素数() && 模式匹配!(字符序列[下标], 'e' | 'E') {
        让 可变 内索引 = 下标 + 1;
        如果 内索引 < 字符序列.元素数() && 模式匹配!(字符序列[内索引], '+' | '-') {
            内索引 += 1;
        }
        如果 内索引 < 字符序列.元素数() && 字符序列[内索引].是数字字符() {
            下标 = 内索引;
            当 下标 < 字符序列.元素数() && (字符序列[下标].是数字字符() || 字符序列[下标] == '_') {
                下标 += 1;
            }
        }
    }
    // 后随标识符字符（如 `42abc`）：非法代码，交给编译器，不提示
    如果 下标 < 字符序列.元素数() && 是标识符续字(字符序列[下标]) {
        返回 下标;
    }
    让 数字文本: 字符串 = 字符序列[数字起始..下标].迭代().收集();
    // 平凡值排除：0/1/2（含浮点形式）与前导负号（-1/-2 等常见常量）
    让 清洗后: 字符串 = 数字文本.逐字符().过滤(|字符值| *字符值 != '_').收集();
    让 属平凡 = 清洗后
        .解析为::<浮点数>()
        .成功且(|值项| 值项 == 0.0 || 值项 == 1.0 || 值项 == 2.0);
    如果 属平凡 || 上一字 == '-' {
        返回 下标;
    }
    警告表.推入(检查警告 {
        行号,
        列号,
        种类: 检查种类::魔法数字,
        相关文本: 数字文本,
        补充文本: 字符串::新建(),
    });
    下标
}

/// 标识符续字符（数字后跟这些字符视为同一标识符）
函数 是标识符续字(字: 字符) -> 布尔 {
    字.是否为字母数字() || 字 == '_'
}

/// 判定字符是否属于 CJK 统一表意文字（基本区 + 扩展 A）
函数 是中日韩(字: 字符) -> 布尔 {
    模式匹配!(字, '\u{4E00}'..='\u{9FFF}' | '\u{3400}'..='\u{4DBF}')
}

/// 前瞻扫描 `.` 后的方法名：收集连续 CJK 字符（如 `拉平`），
/// 名字与 `(` 之间允许空格/tab；只有最终跟 `(`（调用位）才返回名字。
/// 名字含 ASCII/假名等其他字符（如 `拉平_所有`、字段访问）时不判定。
函数 扫描方法名(字符序列: &[字符], 点下标: 无符号机器整数) -> 选项<字符串> {
    让 可变 内索引 = 点下标 + 1;
    让 可变 名字 = 字符串::新建();
    当 内索引 < 字符序列.元素数() && 是中日韩(字符序列[内索引]) {
        名字.推入(字符序列[内索引]);
        内索引 += 1;
    }
    如果 名字.是否为空() {
        返回 无;
    }
    让 可变 次索引 = 内索引;
    当 次索引 < 字符序列.元素数() && (字符序列[次索引] == ' ' || 字符序列[次索引] == '\t') {
        次索引 += 1;
    }
    如果 次索引 < 字符序列.元素数() && 字符序列[次索引] == '(' {
        有值(名字)
    } 否则 {
        无
    }
}

/// 在已知词表中寻找与未命中方法名编辑距离 ≤1 的候选（按字典序取
/// 首个，结果确定）；名字本身在表中或过短（单字）时不提示。
函数 易混候选<'a>(名字: &文本, 已知: &'a 哈希集合<字符串>) -> 选项<&'a 文本> {
    如果 名字.逐字符().计数() < 2 || 已知.包含(名字) {
        返回 无;
    }
    让 可变 候选集: 向量<&文本> = 已知
        .迭代()
        .过滤(|词项| 编辑距一(名字, 词项))
        .变换(字符串::作为字符串)
        .收集();
    候选集.不稳定排序();
    候选集.第一个().复制值()
}

/// 编辑距离 ≤1 的近似判定（等长时恰有一处不同；差一字时短词是长词
/// 删去一个字符的结果），用于易混词候选筛选。
函数 编辑距一(测试甲: &文本, 测试乙: &文本) -> 布尔 {
    让 甲字序列: 向量<字符> = 测试甲.逐字符().收集();
    让 乙字序列: 向量<字符> = 测试乙.逐字符().收集();
    匹配 甲字序列.元素数().绝对差(乙字序列.元素数()) {
        0 => 甲字序列.迭代().拉链(&乙字序列).过滤(|(横坐标, 纵坐标)| 横坐标 != 纵坐标).计数() == 1,
        1 => {
            让 (短名, 长名) = 如果 甲字序列.元素数() < 乙字序列.元素数() {
                (&甲字序列, &乙字序列)
            } 否则 {
                (&乙字序列, &甲字序列)
            };
            让 可变 已跳过 = 假;
            让 可变 短指 = 0usize;
            让 可变 长指 = 0usize;
            当 短指 < 短名.元素数() {
                如果 短名[短指] == 长名[长指] {
                    短指 += 1;
                    长指 += 1;
                } 否则 如果 已跳过 {
                    返回 假;
                } 否则 {
                    已跳过 = 真;
                    长指 += 1;
                }
            }
            真
        }
        _ => 假,
    }
}

#[配置(测试)]
模块 单元测试 {
    使用 超级::*;

    /// 测试用歧义构造器词集（模拟语言包：新建→新建、缺省→缺省）
    函数 方言歧义词() -> 哈希集合<字符串> {
        [
            "new".转字符串(),
            "default".转字符串(),
            "新建".转字符串(),
            "缺省".转字符串(),
        ]
        .转迭代()
        .收集()
    }

    #[测试]
    函数 测试检出未标注让() {
        // 类型无法自行推导的关联构造器调用才提示（普通字面量不再触发）
        让 源码 = "函数 主函数() {\n    让 x = 向量::新建();\n}";
        让 警告表 = 执行教学检查并词表(源码, &哈希集合::新建(), &方言歧义词());
        断言相等!(警告表.元素数(), 1, "{警告表:?}");
        断言相等!(警告表[0].种类, 检查种类::未标注类型);
        断言相等!(警告表[0].行号, 2);
        断言相等!(警告表[0].列号, 5);
    }

    /// 类型可自行推导的初始化式一律不报（用户反馈：自动推导时提示成噪音）
    #[测试]
    函数 测试可推导初始化式不提示() {
        让 用例 = [
            "函数 主函数() {\n    让 x = 1;\n}",                 // 整数字面量
            "函数 主函数() {\n    让 s = \"你好\";\n}",          // 字符串
            "函数 主函数() {\n    让 b = 真;\n}",                // 布尔
            "函数 主函数() {\n    让 y = x + 1;\n}",             // 运算
            "函数 主函数() {\n    让 n = 加一(1);\n}",           // 普通函数调用
            "函数 主函数() {\n    让 n = 项.长度();\n}",         // 方法调用
            "函数 主函数() {\n    让 v = 向量![1, 2];\n}",       // 宏
            "函数 主函数() {\n    让 p = 点 { x: 1, y: 2 };\n}", // 结构体字面量
            "函数 主函数() {\n    让 t = (1, 2);\n}",            // 元组
            "函数 主函数() {\n    让 a = [1, 2];\n}",            // 数组
            "函数 主函数() {\n    让 r = serde_json::from_str(\"{}\");\n}", // 普通关联函数
            "函数 主函数() {\n    让 x = 常量名;\n}",            // 路径/常量
            "函数 主函数() {\n    让 v = 向量::新建::<i32>();\n}", // turbofish 已给类型
            "函数 主函数() {\n    让 v: 整数 = 向量::新建();\n}", // 已注解
        ];
        对于 源码 在 用例 {
            让 警告表 = 执行教学检查并词表(源码, &哈希集合::新建(), &方言歧义词());
            断言!(
                !警告表.迭代().任意(|警告项| 警告项.种类 == 检查种类::未标注类型),
                "可推导初始化式不应提示: {源码}\n{警告表:?}"
            );
        }
    }

    /// 真正歧义（rustc 也会 E0282）的形态：无 turbofish 的 新建/缺省
    /// 关联构造（含各方言词）与 .收集()
    #[测试]
    函数 测试歧义初始化式应提示() {
        让 用例 = [
            "函数 主函数() {\n    让 x = Vec::new();\n}",
            "函数 主函数() {\n    让 x = 向量::新建();\n}",
            "函数 主函数() {\n    让 x = Default::default();\n}",
            "函数 主函数() {\n    让 x = 缺省值::缺省();\n}",
            "函数 主函数() {\n    让 x = (0..10).collect();\n}",
            "函数 主函数() {\n    让 x = 项们.迭代().collect();\n}",
        ];
        对于 源码 在 用例 {
            让 警告表 = 执行教学检查并词表(源码, &哈希集合::新建(), &方言歧义词());
            断言!(
                警告表.迭代().任意(|警告项| 警告项.种类 == 检查种类::未标注类型),
                "歧义初始化式应提示: {源码}\n{警告表:?}"
            );
        }
    }

    /// 模式解构绑定不做「未标注类型」提示（元组/结构体/数组/可变元组）：
    /// 这类绑定须标注整个模式的类型（教学示例均不标注），提示无解且成
    /// 噪音（回归：教程第四/十一章解构写法被误报）
    #[测试]
    函数 测试模式解构不提示() {
        让 用例 = [
            "函数 主函数() {\n    让 (甲, 乙) = (1, 2);\n}",
            "函数 主函数() {\n    让 点 { x, y } = 某点;\n}",
            "函数 主函数() {\n    让 [首, 次] = 列表;\n}",
            "函数 主函数() {\n    让 可变 (丙, 丁) = (1, 2);\n}",
        ];
        对于 源码 在 用例 {
            让 警告表 = 执行教学检查(源码);
            断言!(
                !警告表.迭代().任意(|警告项| 警告项.种类 == 检查种类::未标注类型),
                "模式解构不应提示未标注类型: {源码}\n{警告表:?}"
            );
        }
    }

    /// 让-否则（let-else）与 let 链中的模式绑定同样不提示；
    /// `枚举::变体(数)` 限定路径模式（`::` 非类型标注）也不提示
    #[测试]
    函数 测试让否则链与路径模式不提示() {
        让 用例 = [
            "函数 主函数() {\n    让 有值(数) = 输入 否则 {\n        返回;\n    };\n}",
            "函数 主函数() {\n    如果让 有值(a) = 有值(1) && 让 有值(b) = 有值(2) {\n        打印行!(\"{}\", a);\n    }\n}",
            "函数 主函数() {\n    让 选项::有值(数) = 输入;\n}",
        ];
        对于 源码 在 用例 {
            让 警告表 = 执行教学检查(源码);
            断言!(
                !警告表.迭代().任意(|警告项| 警告项.种类 == 检查种类::未标注类型),
                "模式绑定不应提示未标注类型: {源码}\n{警告表:?}"
            );
        }
    }

    /// 歧义构造器绑定（含「可变」前缀）照常提示；
    /// 显式标注（含「可变」）豁免；字面量绑定不提示
    #[测试]
    函数 测试简单绑定仍提示() {
        让 源码 = 拼接!(
            "函数 主函数() {\n",
            "    让 x = 向量::新建();\n",
            "    让 可变 y = 向量::新建();\n",
            "    让 x2: 整数 = 1;\n",
            "    让 可变 y2: 整数 = 1;\n",
            "    让 z = 1;\n",
            "}"
        );
        让 警告表 = 执行教学检查并词表(源码, &哈希集合::新建(), &方言歧义词());
        让 未标注表: 向量<_> = 警告表
            .迭代()
            .过滤(|警告项| 警告项.种类 == 检查种类::未标注类型)
            .收集();
        断言相等!(未标注表.元素数(), 2, "{警告表:?}");
        断言相等!(未标注表[0].行号, 2);
        断言相等!(未标注表[1].行号, 3);
    }

    /// 空行/纯空白行计入行号：警告位置不得因空行而前移
    ///（回归：第 5 行的 `让` 因两个空行被报成第 3 行）
    #[测试]
    函数 测试空行计入行号() {
        让 警告表 = 执行教学检查("// 注释\n\n// 注释\n   \n让 x = Foo::new();");
        断言相等!(警告表.元素数(), 1, "{警告表:?}");
        断言相等!(警告表[0].种类, 检查种类::未标注类型);
        断言相等!(警告表[0].行号, 5);
        断言相等!(警告表[0].列号, 1);
    }

    #[测试]
    函数 测试已注解让无误() {
        让 警告表 = 执行教学检查("函数 主函数() {\n    让 x: 整数 = 5;\n}");
        断言!(
            !警告表.迭代().任意(|警告项| 警告项.种类 == 检查种类::未标注类型),
            "{警告表:?}"
        );
    }

    /// 路径分隔符 `::` 出现在 `=` 之后时不是类型注解；
    /// 方言构造器词（新建）经歧义词集识别后仍应提示
    #[测试]
    函数 测试等号后路径分隔符非注解() {
        让 警告表 = 执行教学检查并词表(
            "函数 主函数() {\n    让 x = 向量::新建();\n}",
            &哈希集合::新建(),
            &方言歧义词(),
        );
        断言!(
            警告表.迭代().任意(|警告项| 警告项.种类 == 检查种类::未标注类型),
            "{警告表:?}"
        );
    }

    /// 字符串/注释内的 `让` 与分号不参与判定
    #[测试]
    函数 测试字符串与注释被忽略() {
        让 源码 = "函数 主函数() {\n    // 让 y = 1; 注释里的代码\n    让 s = \"让 z = 2;\";\n}";
        让 警告表 = 执行教学检查(源码);
        断言!(
            !警告表
                .迭代()
                .任意(|警告项| 警告项.种类 == 检查种类::未标注类型 && 警告项.行号 == 2),
            "{警告表:?}"
        );
    }

    #[测试]
    函数 测试魔法数字报告() {
        让 警告表 = 执行教学检查("函数 主函数() {\n    让 数量: 整数 = 42;\n}");
        断言相等!(警告表.元素数(), 1, "{警告表:?}");
        断言相等!(警告表[0].种类, 检查种类::魔法数字);
        断言相等!(警告表[0].相关文本, "42");
        断言相等!(警告表[0].行号, 2);
    }

    /// 「教学忽略」标记行：三种规则均不报告（教师标注故意不修的示例）
    #[测试]
    函数 测试忽略标记跳过整行() {
        让 源码 = 拼接!(
            "函数 主函数() {\n",
            "    让 x = 向量::新建();  // 教学忽略\n",
            "    让 数量: 整数 = 42;  // 教学忽略：这行也跳过\n",
            "    让 y = (0..1).collect();\n",
            "}"
        );
        让 警告表 = 执行教学检查并词表(源码, &哈希集合::新建(), &方言歧义词());
        断言!(
            !警告表.迭代().任意(|警告项| 警告项.行号 == 2 || 警告项.行号 == 3),
            "标记行不应有警告: {警告表:?}"
        );
        // 未标记行照常报告
        断言!(
            警告表
                .迭代()
                .任意(|警告项| 警告项.行号 == 4 && 警告项.种类 == 检查种类::未标注类型),
            "{警告表:?}"
        );
    }

    /// 字符串里的「教学忽略」文本不生效（仅在代码行注释中识别）
    #[测试]
    函数 测试串内忽略标记不生效() {
        让 源码 = "函数 主函数() {\n    让 x = Foo::new(\"教学忽略\");\n}";
        让 警告表 = 执行教学检查(源码);
        断言!(
            警告表
                .迭代()
                .任意(|警告项| 警告项.行号 == 2 && 警告项.种类 == 检查种类::未标注类型),
            "{警告表:?}"
        );
    }

    #[测试]
    函数 测试平凡数字不提示() {
        // 0/1/2、负的 1/2、标识符内数字、字符串内数字均不提示
        让 源码 = "函数 主函数() {\n    让 a = 0;\n    让 b = 1;\n    让 c = -2;\n    让 d = 数量2;\n    让 e = \"3\";\n}";
        让 警告表 = 执行教学检查(源码);
        断言!(
            !警告表.迭代().任意(|警告项| 警告项.种类 == 检查种类::魔法数字),
            "{警告表:?}"
        );
    }

    #[测试]
    函数 测试十六进制与下划线字面量() {
        让 警告表 = 执行教学检查("函数 主函数() {\n    让 a = 0xFF;\n    让 b = 1_000;\n}");
        让 魔法表: 向量<_> = 警告表
            .迭代()
            .过滤(|警告项| 警告项.种类 == 检查种类::魔法数字)
            .变换(|警告项| 警告项.相关文本.克隆值())
            .收集();
        断言相等!(魔法表, 向量宏!["1_000".转字符串()], "{警告表:?}");
    }

    #[测试]
    函数 测试浮点字面量报告() {
        让 警告表 = 执行教学检查("函数 主函数() {\n    让 比例: 浮点数 = 0.5;\n}");
        断言相等!(警告表.元素数(), 1, "{警告表:?}");
        断言相等!(警告表[0].种类, 检查种类::魔法数字);
        断言相等!(警告表[0].相关文本, "0.5");
    }

    /// #14：方法调用位未命中映射表且与表内词编辑距离 ≤1 → 提示疑似笔误
    #[测试]
    函数 测试易混方法名提示() {
        让 已知词: 哈希集合<字符串> = ["展平".转字符串(), "长度".转字符串()]
            .转迭代()
            .收集();
        让 源码 = "函数 主函数() {\n    让 x = 项们.拉平();\n}";
        让 警告表 = 执行教学检查并词表(源码, &已知词, &方言歧义词());
        让 提示表: 向量<_> = 警告表
            .迭代()
            .过滤(|警告项| 警告项.种类 == 检查种类::易混方法名)
            .收集();
        断言相等!(提示表.元素数(), 1, "{警告表:?}");
        断言相等!(提示表[0].相关文本, "拉平");
        断言相等!(提示表[0].补充文本, "展平");
        断言相等!(提示表[0].行号, 2);
        断言相等!(提示表[0].列号, 14);
    }

    /// 差一字的短名（长词删一字符的结果）也提示
    #[测试]
    函数 测试易混方法名差一字() {
        让 已知词: 哈希集合<字符串> = ["打印行".转字符串()].转迭代().收集();
        让 源码 = "函数 主函数() {\n    项们.打印();\n}";
        让 警告表 = 执行教学检查并词表(源码, &已知词, &方言歧义词());
        让 提示表: 向量<_> = 警告表
            .迭代()
            .过滤(|警告项| 警告项.种类 == 检查种类::易混方法名)
            .收集();
        断言相等!(提示表.元素数(), 1, "{警告表:?}");
        断言相等!(提示表[0].相关文本, "打印");
        断言相等!(提示表[0].补充文本, "打印行");
    }

    /// 降噪边界：表内词/远距离词/单字名/字段访问/字符串/注释/范围与浮点不提示
    #[测试]
    函数 测试易混方法名反例() {
        让 已知词: 哈希集合<字符串> = ["展平".转字符串()].转迭代().收集();
        让 用例 = [
            // 表内词
            "函数 主函数() {\n    让 x = 项们.展平();\n}",
            // 远距离词（编辑距离 >1）
            "函数 主函数() {\n    让 x = 项们.翻江倒海();\n}",
            // 单字方法名
            "函数 主函数() {\n    让 x = 项们.拉();\n}",
            // 字段访问（无括号）
            "函数 主函数() {\n    让 x = 项们.拉平;\n}",
            // 字符串内
            "函数 主函数() {\n    让 s = \"项.拉平()\";\n}",
            // 注释内
            "函数 主函数() {\n    // 项.拉平()\n}",
            // 范围语法 `..`
            "函数 主函数() {\n    循环 i 于 0..10 {}\n}",
            // 浮点字面量
            "函数 主函数() {\n    让 f: 浮点数 = 1.5;\n}",
        ];
        对于 源码 在 用例 {
            让 警告表 = 执行教学检查并词表(源码, &已知词, &方言歧义词());
            断言!(
                !警告表
                    .迭代()
                    .任意(|警告项| 警告项.种类 == 检查种类::易混方法名),
                "不应提示: {源码}\n{警告表:?}"
            );
        }
    }

    /// 名字与 `(` 间隔空白仍判定；带 `_` 的复合名不判定（降噪边界）
    #[测试]
    函数 测试易混方法名间隔与复合() {
        让 已知词: 哈希集合<字符串> = ["展平".转字符串()].转迭代().收集();
        让 源码 = "函数 主函数() {\n    让 x = 项们.拉平 ();\n}";
        让 警告表 = 执行教学检查并词表(源码, &已知词, &方言歧义词());
        断言!(
            警告表
                .迭代()
                .任意(|警告项| 警告项.种类 == 检查种类::易混方法名),
            "{警告表:?}"
        );
        让 源码 = "函数 主函数() {\n    让 x = 项们.拉平_所有();\n}";
        让 警告表 = 执行教学检查并词表(源码, &已知词, &方言歧义词());
        断言!(
            !警告表
                .迭代()
                .任意(|警告项| 警告项.种类 == 检查种类::易混方法名),
            "{警告表:?}"
        );
    }

    /// 兼容入口（无词表）不做易混方法名提示
    #[测试]
    函数 测试兼容入口易混静默() {
        让 警告表 = 执行教学检查("函数 主函数() {\n    让 x = 项们.拉平();\n}");
        断言!(
            !警告表
                .迭代()
                .任意(|警告项| 警告项.种类 == 检查种类::易混方法名),
            "{警告表:?}"
        );
    }

    #[测试]
    函数 测试深嵌套仅报一次() {
        // 两处深层嵌套：仅首个报告（避免刷屏）；缩进逐层递增
        让 可变 源码 = 字符串::从("函数 主函数() {\n");
        对于 层级 在 1..=7 {
            源码.推入字符串(&"    ".重复(层级));
            源码.推入字符串("if 真 {\n");
        }
        源码.推入字符串(&"    ".重复(8));
        源码.推入字符串("让 x = 1;\n");
        对于 层级 在 (1..=7).逆序() {
            源码.推入字符串(&"    ".重复(层级));
            源码.推入字符串("}\n");
        }
        源码.推入字符串("    if 真 {\n        如果 真 {\n            循环 {\n");
        源码.推入字符串(&"    ".重复(5));
        源码.推入字符串("让 y = 1;\n");
        源码.推入字符串("            }\n        }\n    }\n}\n");
        让 警告表 = 执行教学检查(&源码);
        让 深层表: 向量<_> = 警告表
            .迭代()
            .过滤(|警告项| 警告项.种类 == 检查种类::嵌套过深)
            .收集();
        断言相等!(深层表.元素数(), 1, "{警告表:?}");
        // 第 7 层 if（第 7 行）缩进已达 24 空格阈值，是首个触发点
        断言相等!(深层表[0].行号, 7);
    }

    #[测试]
    函数 测试注释行不算深嵌套() {
        让 源码 = "函数 主函数() {\n                        // 长缩进的注释行\n    让 x = 1;\n}";
        让 警告表 = 执行教学检查(源码);
        断言!(
            !警告表.迭代().任意(|警告项| 警告项.种类 == 检查种类::嵌套过深),
            "{警告表:?}"
        );
    }
}
