使用 引擎库::映射管理器::映射管理器;
使用 引擎库::语言;

函数 主函数() {
    让 关键词源码 = 语言::内置文件("zh", "keywords.toml").取成功值();
    打印行!(
        "内置 keywords.toml 包含 哪里: {}",
        关键词源码.包含("哪里")
    );
    让 管理器 = 映射管理器::从内置载入(
        关键词源码,
        语言::内置文件("zh", "module_paths.toml").取成功值(),
        语言::内置文件("zh", "stdlib.toml").取成功值(),
        &[],
    )
    .取成功值();
    让 关键词表 = 管理器.取关键词表();
    打印行!("keyword_map 长度: {}", 关键词表.令牌长度());
    打印行!("哪里 => {:?}", 关键词表.GET方法("哪里"));
    打印行!("函数 => {:?}", 关键词表.GET方法("函数"));
    让 源码 = "函数 主函数() { 让 甲 = 5; }";
    让 输出 = 引擎库::词法器::基础转译(源码, 关键词表);
    打印行!("转译: {}", 输出);
}
