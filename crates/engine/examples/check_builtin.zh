使用 i18n_rust_engine::映射管理::映射管理器;
使用 i18n_rust_engine::语言;

函数 main() {
    让 关键词文本 = 语言::内置文件("zh", "keywords.toml").unwrap();
    println!(
        "内置 keywords.toml 包含 哪里: {}",
        关键词文本.contains("哪里")
    );
    让 管理器 = 映射管理器::自内置加载(
        关键词文本,
        语言::内置文件("zh", "module_paths.toml").unwrap(),
        语言::内置文件("zh", "stdlib.toml").unwrap(),
        &[],
    )
    .unwrap();
    让 关键词映射表 = 管理器.取关键词映射表();
    println!("keyword_map 长度: {}", 关键词映射表.len());
    println!("哪里 => {:?}", 关键词映射表.get("哪里"));
    println!("函数 => {:?}", 关键词映射表.get("函数"));
    让 源串 = "函数 主函数() { 让 甲 = 5; }";
    让 转译串 = i18n_rust_engine::词法::词法转译(源串, 关键词映射表);
    println!("转译: {}", 转译串);
}
