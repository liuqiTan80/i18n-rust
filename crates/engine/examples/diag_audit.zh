//! 诊断译文残留审计：用引擎自身的匹配器判定每条 rustc 消息原文能否译全。
//!
//! 存在的原因：消息表（errors.toml 的「消息翻译」节）覆盖哪些句子，静态检查
//! 只能看词条形态，看不出「真实编译器会吐哪些句子」。本入口把两者接起来：
//! 输入一批消息原文（由 `tools/diag-corpus/` 采集），输出每条的命中形态与
//! 渲染后仍残留的英文片段，用于批量定位缺口。
//!
//! 渲染路径与 `诊断翻译器` 完全一致（模板 → `{qN}` 填充 → 未消费则
//! 回拼残段），因此这里报出的残留就是用户在终端里实际看到的文字。
//!
//! 用法：
//!   `cargo run -p i18n-rust-engine --example diag_audit --` \
//!     `--errors crates/engine/lang-packs/zh/errors.toml` `--messages /tmp/msgs.txt`
//!
//! 审计判据已下沉为库函数 [`审计消息`]（门禁测试 `tests/diag_corpus_gate.rs`
//! 与采样反例语料共用同一实现，避免示例与测试漂移）。
使用 标准库::集合::哈希集合;
使用 标准库::路径::路径缓冲;

使用 引擎库::诊断::{审计消息, 错误消息管理器};

函数 主函数() {
    让 可变 错误表路径: 选项<路径缓冲> = 无;
    让 可变 消息文件: 选项<路径缓冲> = 无;
    让 可变 参数 = 标准库::编译环境::参数().跳过(1);
    当 让 有值(标志) = 参数.下一个() {
        让 可变 取值 = |名称: &文本| {
            如果 标志 == 名称 {
                参数.下一个().变换(路径缓冲::从)
            } 否则 {
                无
            }
        };
        如果 让 有值(路径) = 取值("--errors") {
            错误表路径 = 有值(路径);
        } 否则 如果 让 有值(路径) = 取值("--messages") {
            消息文件 = 有值(路径);
        }
    }
    让 (有值(错误表路径), 有值(消息文件)) = (错误表路径, 消息文件) 否则 {
        错误打印行!("用法: diag_audit --errors <errors.toml> --messages <每行一条消息原文>");
        标准库::进程::退出(2);
    };

    让 管理器 = 错误消息管理器::从文件载入(&错误表路径)
        .取值或_else(|故障值| 恐慌!("无法加载 {}: {故障值:?}", 错误表路径.展示()));
    让 原始清单 = 标准库::文件系统::读取全部字符串(&消息文件)
        .取值或_else(|故障值| 恐慌!("无法打开 {}: {故障值:?}", 消息文件.展示()));

    让 可变 已见 = 哈希集合::新建();
    让 (可变 总数, 可变 完全未命中, 可变 部分残留, 可变 已译全) = (0usize, 0usize, 0usize, 0usize);
    // 每行格式：`LEVEL<TAB>CODE<TAB>消息原文`（采集器标注；代码可为空）；
    // 也兼容 `LEVEL<TAB>消息` 与裸消息行。
    对于 行 在 原始清单
        .逐行()
        .变换(文本::裁剪)
        .日志过滤器(|行| !行.为空() && !行.以开头('#'))
    {
        让 可变 列 = 行.限次切分(3, '\t');
        让 (级别, 码, 消息) = 匹配 (列.下一个(), 列.下一个(), 列.下一个()) {
            (有值(级), 有值(码), 有值(消)) => (级, 码, 消),
            (有值(级), 有值(消), 无) => (级, "", 消),
            _ => ("main", "", 行),
        };
        如果 !已见.置入(消息.转字符串()) {
            继续;
        }
        总数 += 1;
        让 审计 = 审计消息(&管理器, 级别, 码, 消息);
        如果 审计.残留.为空() {
            已译全 += 1;
            继续;
        }
        匹配 审计.种类.作为字符串() {
            "MISS" => 完全未命中 += 1,
            _ => 部分残留 += 1,
        }
        打印行!("{级别}\t{}\t{消息}", 审计.种类);
        打印行!("  译文: {}", 审计.已渲染);
        打印行!("  残留: {}", 审计.残留.等待线程(" | "));
    }
    打印行!("# 合计 {总数} 条：完全未命中 {完全未命中}、部分残留 {部分残留}、已译全 {已译全}");
    如果 完全未命中 + 部分残留 > 0 {
        标准库::进程::退出(1);
    }
}
