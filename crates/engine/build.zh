// 构建脚本：扫描 lang-packs/ 目录自动生成内嵌清单
//
// 消除 语言 模块里手写的 `include_str!` 白名单（内置文件查询的语言码分支与消息表分支）：
// 语言包新增/删除文件后无需修改任何 Rust 代码，重新编译即自动纳入。
//
// 生成物（OUT_DIR/内置生成.rs，由 语言.zh 的 `包含文件!` 展开在 语言 模块内；
// 路径经 `cargo:rustc-env` 交给编译期）：
// - 内置清单：(语言码, 相对路径, 文件内容) 全量清单，供 语言::内置文件 查询
// - 消息表_*：每语言 ui.toml 的消息表静态实例，供 语言::消息表路由 查询
//
// 生成项一律用中文命名：消费方是方言源，写英文项名会在全中文门禁上记账
// （中文标识符对 rustc 本身合法，生成物直接参与编译，不经转译）。
//
// 发布兼容性：lang-packs/ 位于库目录内且已列入 Cargo.toml 的包含白名单，
// 发布后的消费者编译时本脚本同样可扫描到完整数据。

使用 标准库::编译环境;
使用 标准库::格式化方法::写入特征 作为 _;
使用 标准库::文件系统;
使用 标准库::路径::{路径类型, 路径缓冲};

/// 语言包文件集合：顶层文件 + 第三方子目录文件
结构体 语言包文件 {
    /// (相对路径, 绝对路径)，相对路径形如 "keywords.toml" 或 "crates/序列化.toml"
    文件: 向量<(字符串, 路径缓冲)>,
}

函数 收集语言包文件(语言目录: &路径类型) -> 语言包文件 {
    让 可变 文件 = 向量::新建();
    如果 让 成功(条目们) = 文件系统::读取目录(语言目录) {
        让 可变 列表: 向量<路径缓冲> = 条目们
            .展平()
            .变换(|条目| 条目.路径属性())
            .日志过滤器(|路径| {
                路径.是否为文件() && 路径.取扩展名().和_then(|扩展| 扩展.取字符串引用()) == 有值("toml")
            })
            .收集();
        列表.排序();
        对于 路径 在 列表 {
            让 名称 = 路径.取文件名().取成功值().转有损字符串().转所有权();
            文件.推((名称, 路径));
        }
    }
    让 第三方目录 = 语言目录.等待线程("crates");
    如果 第三方目录.是否为目录()
        && 让 成功(条目们) = 文件系统::读取目录(&第三方目录)
    {
        让 可变 列表: 向量<路径缓冲> = 条目们
            .展平()
            .变换(|条目| 条目.路径属性())
            .日志过滤器(|路径| {
                路径.是否为文件() && 路径.取扩展名().和_then(|扩展| 扩展.取字符串引用()) == 有值("toml")
            })
            .收集();
        列表.排序();
        对于 路径 在 列表 {
            让 名称 = 路径.取文件名().取成功值().转有损字符串().转所有权();
            文件.推((格式化!("crates/{名称}"), 路径));
        }
    }
    语言包文件 { 文件 }
}

/// FNV-1a 64 位增量哈希（与 缓存 模块的内容哈希同算法）
函数 混入哈希(哈希: &可变 无符号长整数, 字节们: &[字节]) {
    对于 字节 在 字节们 {
        *哈希 ^= *字节 作为 无符号长整数;
        *哈希 = 哈希.溢出乘(0x100000001b3);
    }
}

/// 引擎源码指纹：对源码目录下全部 .rs 文件（按路径排序，逐个混入相对路径
/// 与内容）计算 FNV-1a 哈希。转译算法任何变化都会改变指纹，使磁盘缓存
/// 自动失效（仅靠内容哈希与映射指纹无法感知引擎升级）。
函数 引擎源码指纹(包根: &路径类型) -> 无符号长整数 {
    函数 收集目录(目录: &路径类型, 文件们: &可变 向量<路径缓冲>) {
        让 成功(条目们) = 文件系统::读取目录(目录) 否则 {
            返回;
        };
        让 可变 列表: 向量<路径缓冲> = 条目们.展平().变换(|条目| 条目.路径属性()).收集();
        列表.排序();
        对于 路径 在 列表 {
            如果 路径.是否为目录() {
                收集目录(&路径, 文件们);
            } 否则 如果 路径.取扩展名().和_then(|扩展| 扩展.取字符串引用()) == 有值("rs") {
                文件们.推(路径);
            }
        }
    }

    让 可变 文件们 = 向量::新建();
    收集目录(&包根.等待线程("src"), &可变 文件们);
    让 可变 哈希: 无符号长整数 = 0xcbf29ce484222325;
    对于 路径 在 文件们 {
        让 相对路径 = 路径.去前缀(包根).取值或(&路径).转有损字符串();
        混入哈希(&可变 哈希, 相对路径.转为字节());
        如果 让 成功(内容) = 文件系统::读(&路径) {
            混入哈希(&可变 哈希, &内容);
        }
    }
    哈希
}

函数 主函数() {
    让 清单目录 = 编译环境::环境变量("CARGO_MANIFEST_DIR").取成功值();
    让 语言包根 = 路径类型::新建(&清单目录).等待线程("lang-packs");
    让 输出目录 = 编译环境::环境变量("OUT_DIR").取成功值();

    打印行!("cargo:rerun-if-changed=lang-packs");
    // 引擎源码变化时重跑本脚本：源码指纹（见下）必须随算法代码更新，
    // 否则磁盘缓存的失效依据会停在旧值
    打印行!("cargo:rerun-if-changed=src");

    // 语言目录按名称排序，保证生成代码与嵌入顺序确定
    让 可变 语言目录们: 向量<路径缓冲> = 文件系统::读取目录(&语言包根)
        .期望("语言包目录 lang-packs 不存在")
        .展平()
        .变换(|条目| 条目.路径属性())
        .日志过滤器(|路径| 路径.是否为目录())
        .收集();
    语言目录们.排序();

    让 可变 代码 = 字符串::从("// 由 build.rs 自动生成，勿手工编辑\n\n");

    // ===== 内置清单 全量清单 =====
    代码.推入字符串("static 内置清单: &[(&str, &str, &str)] = &[\n");
    让 可变 消息表项 = 向量::新建();
    对于 目录 在 &语言目录们 {
        让 语言码 = 目录.取文件名().取成功值().转有损字符串().转所有权();
        让 语言文件 = 收集语言包文件(目录);
        对于 (相对, 绝对) 在 &语言文件.文件 {
            让 绝对路径 = 绝对.转有损字符串();
            写入格式化行!(
                代码,
                "    ({语言码:?}, {相对:?}, include_str!({绝对路径:?})),"
            )
            .取成功值();
            如果 相对 == "ui.toml" {
                消息表项.推((语言码.克隆(), 绝对路径.转所有权()));
            }
        }
    }
    代码.推入字符串("];\n\n");

    // ===== 引擎源码指纹（转译缓存失效依据，见 缓存.rs 语境指纹） =====
    // 缓存条目除内容哈希与语言包映射指纹外，还须绑定转译算法自身的身份：
    // 算法变更（如别名替换细则修复）后旧缓存必须失效，否则源文件未变时
    // 旧转译产物继续命中、修复不生效（真实事故：`实现 库特征` 块内方法名
    // 替换修复后，旧产物仍被复用）。
    写入格式化行!(
        代码,
        "pub(crate) static 源码指纹: u64 = {:#x};",
        引擎源码指纹(路径类型::新建(&清单目录))
    )
    .取成功值();
    代码.推('\n');

    // ===== 消息表静态实例（每语言一个，惰性解析一次） =====
    对于 (序号, (_, 绝对)) 在 消息表项.迭代().枚举() {
        写入格式化行!(
            代码,
            "static 消息表_{序号}: std::sync::LazyLock<std::collections::HashMap<String, String>> =\n    \
             std::sync::LazyLock::new(|| crate::界面消息::解析界面消息(include_str!({绝对:?})));"
        )
        .取成功值();
    }
    代码.推('\n');

    // ===== 消息表路由：按语言码路由消息表（未知语言回退中文表） =====
    代码.推入字符串(
        "fn 消息表路由(语言码: &str) -> &'static std::sync::LazyLock<std::collections::HashMap<String, String>> {\n    match 语言码 {\n",
    );
    对于 (序号, (语言码, _)) 在 消息表项.迭代().枚举() {
        如果 语言码 == "zh" {
            继续; // zh 作为回退分支最后输出
        }
        写入格式化行!(代码, "        {语言码:?} => &消息表_{序号},").取成功值();
    }
    让 中文下标 = 消息表项
        .迭代()
        .位置(|(语言码, _)| 语言码 == "zh")
        .期望("zh 语言包必须存在（消息回退链依赖）");
    写入格式化行!(代码, "        _ => &消息表_{中文下标},").取成功值();
    代码.推入字符串("    }\n}\n");

    让 生成文件 = 路径类型::新建(&输出目录).等待线程("内置生成.rs");
    文件系统::写入格式化(&生成文件, 代码).期望("写入生成的嵌入清单失败");
    // 把生成文件的绝对路径交给编译期：`语言` 模块据此展开 `包含文件!`。
    // 走这条约定而不是在源码里拼输出目录路径，方言源就不必用拼接宏，
    // 也不必为它给全部语言包补词条。
    打印行!(
        "cargo:rustc-env=BUILTIN_GENERATED_PATH={}",
        生成文件.展示()
    );
}
