// 构建脚本：扫描 lang-packs/ 目录自动生成内嵌清单
//
// 消除 语言.rs 中手写的 include_str! 白名单（builtin_file match 与 ui_table! 宏列表）：
// 语言包新增/删除文件后无需修改任何 Rust 代码，重新编译即自动纳入。
//
// 生成物（OUT_DIR/内置生成.rs，由 语言.rs include! 引入）：
// - 内置文件清单：(语言代码, 相对路径, 文件内容) 全量清单，供 builtin_file 查询
// - 界面消息表_*：每语言 ui.toml 的消息表静态实例，供 界面表路由 查询
//
// 发布兼容性：lang-packs/ 位于 crate 目录内且已列入 Cargo.toml include 白名单，
// crates.io 消费者编译时本脚本同样可扫描到完整数据。

使用 std::env;
使用 std::fmt::Write as _;
使用 std::fs;
使用 std::path::{Path, PathBuf};

/// 语言包文件集合：顶层文件 + crates/ 子目录文件
结构体 语言文件集 {
    /// (相对路径, 绝对路径)，相对路径形如 "keywords.toml" 或 "crates/序列化.toml"
    文件清单: Vec<(字符串, PathBuf)>,
}

函数 收集语言文件(语言目录: &Path) -> 语言文件集 {
    让 可变 文件清单 = Vec::new();
    如果 让 成功(目录项) = fs::read_dir(语言目录) {
        让 可变 名单: Vec<PathBuf> = 目录项
            .flatten()
            .map(|条目项| 条目项.path())
            .filter(|路径项| 路径项.is_file() && 路径项.extension().and_then(|后缀项| 后缀项.to_str()) == 有值("toml"))
            .collect();
        名单.sort();
        对于 路径 in 名单 {
            让 名称 = 路径.file_name().unwrap().to_string_lossy().into_owned();
            文件清单.push((名称, 路径));
        }
    }
    让 三方目录 = 语言目录.join("crates");
    如果 三方目录.is_dir()
        && 让 成功(目录项) = fs::read_dir(&三方目录)
    {
        让 可变 名单: Vec<PathBuf> = 目录项
            .flatten()
            .map(|条目项| 条目项.path())
            .filter(|路径项| 路径项.is_file() && 路径项.extension().and_then(|后缀项| 后缀项.to_str()) == 有值("toml"))
            .collect();
        名单.sort();
        对于 路径 in 名单 {
            让 名称 = 路径.file_name().unwrap().to_string_lossy().into_owned();
            文件清单.push((格式化!("crates/{名称}"), 路径));
        }
    }
    语言文件集 { 文件清单 }
}

/// FNV-1a 64 位增量哈希（与 缓存::计算内容哈希 同算法）
函数 fnv1a混列(哈希: &可变 u64, 字节串: &[u8]) {
    对于 字节项 in 字节串 {
        *哈希 ^= *字节项 as u64;
        *哈希 = 哈希.wrapping_mul(0x100000001b3);
    }
}

/// 引擎源码指纹：对 src/ 下全部 .rs 文件（按路径排序，逐个混入相对路径
/// 与内容）计算 FNV-1a 哈希。转译算法任何变化都会改变指纹，使磁盘缓存
/// 自动失效（仅靠内容哈希与映射指纹无法感知引擎升级）。
函数 引擎源码指纹(包根目录: &Path) -> u64 {
    函数 收集源码文件(目录: &Path, 文件清单: &可变 Vec<PathBuf>) {
        让 成功(目录项) = fs::read_dir(目录) 否则 {
            返回;
        };
        让 可变 名单: Vec<PathBuf> = 目录项.flatten().map(|条目项| 条目项.path()).collect();
        名单.sort();
        对于 路径 in 名单 {
            如果 路径.is_dir() {
                收集源码文件(&路径, 文件清单);
            } 否则 如果 路径.extension().and_then(|后缀项| 后缀项.to_str()) == 有值("rs") {
                文件清单.push(路径);
            }
        }
    }

    让 可变 文件清单 = Vec::new();
    收集源码文件(&包根目录.join("src"), &可变 文件清单);
    让 可变 哈希 = 0xcbf29ce484222325u64;
    对于 路径 in 文件清单 {
        让 相对 = 路径
            .strip_prefix(包根目录)
            .unwrap_or(&路径)
            .to_string_lossy();
        fnv1a混列(&可变 哈希, 相对.as_bytes());
        如果 让 成功(内容) = fs::read(&路径) {
            fnv1a混列(&可变 哈希, &内容);
        }
    }
    哈希
}

函数 main() {
    让 清单目录 = env::var("CARGO_MANIFEST_DIR").unwrap();
    让 语言根 = Path::new(&清单目录).join("lang-packs");
    让 输出目录 = env::var("OUT_DIR").unwrap();

    println!("cargo:rerun-if-changed=lang-packs");
    // 引擎源码变化时重跑本脚本：源码指纹（见下）必须随算法代码更新，
    // 否则磁盘缓存的失效依据会停在旧值
    println!("cargo:rerun-if-changed=src");

    // 语言目录按名称排序，保证生成代码与嵌入顺序确定
    让 可变 语言目录集: Vec<PathBuf> = fs::read_dir(&语言根)
        .expect("语言包目录 lang-packs 不存在")
        .flatten()
        .map(|条目项| 条目项.path())
        .filter(|路径项| 路径项.is_dir())
        .collect();
    语言目录集.sort();

    让 可变 生成文本 = 字符串::from("// 由 build.rs 自动生成，勿手工编辑\n\n");

    // ===== 内置文件清单 全量清单 =====
    生成文本.push_str("static 内置文件清单: &[(&str, &str, &str)] = &[\n");
    让 可变 界面表集 = Vec::new();
    对于 目录 in &语言目录集 {
        让 语言 = 目录.file_name().unwrap().to_string_lossy().into_owned();
        让 语言文件 = 收集语言文件(目录);
        对于 (相对, 绝对路径) in &语言文件.文件清单 {
            让 绝对串 = 绝对路径.to_string_lossy();
            writeln!(生成文本, "    ({语言:?}, {相对:?}, include_str!({绝对串:?})),").unwrap();
            如果 相对 == "ui.toml" {
                界面表集.push((语言.clone(), 绝对串.into_owned()));
            }
        }
    }
    生成文本.push_str("];\n\n");

    // ===== 引擎源码指纹（转译缓存失效依据，见 缓存 语境指纹） =====
    // 缓存条目除内容哈希与语言包映射指纹外，还须绑定转译算法自身的身份：
    // 算法变更（如别名替换细则修复）后旧缓存必须失效，否则源文件未变时
    // 旧转译产物继续命中、修复不生效（真实事故：`实现 库特征` 块内方法名
    // 替换修复后，旧产物仍被复用）。
    writeln!(
        生成文本,
        "pub(crate) static 引擎源码指纹: u64 = {:#x};",
        引擎源码指纹(Path::new(&清单目录))
    )
    .unwrap();
    生成文本.push('\n');

    // ===== UI 消息表静态实例（每语言一个，惰性解析一次） =====
    对于 (序号, (_, 绝对路径)) in 界面表集.iter().enumerate() {
        writeln!(
            生成文本,
            "static 界面消息表_{序号}: std::sync::LazyLock<std::collections::HashMap<String, String>> =\n    \
             std::sync::LazyLock::new(|| 解析界面表(include_str!({绝对路径:?})));"
        )
        .unwrap();
    }
    生成文本.push('\n');

    // ===== 界面表路由：按语言代码路由消息表（未知语言回退 zh） =====
    生成文本.push_str(
        "fn 界面表路由(语言代码: &str) -> &'static std::sync::LazyLock<std::collections::HashMap<String, String>> {\n    match 语言代码 {\n",
    );
    对于 (序号, (语言, _)) in 界面表集.iter().enumerate() {
        如果 语言 == "zh" {
            继续; // zh 作为回退分支最后输出
        }
        writeln!(生成文本, "        {语言:?} => &界面消息表_{序号},").unwrap();
    }
    让 中文下标 = 界面表集
        .iter()
        .position(|(语言, _)| 语言 == "zh")
        .expect("zh 语言包必须存在（消息回退链依赖）");
    writeln!(生成文本, "        _ => &界面消息表_{中文下标},").unwrap();
    生成文本.push_str("    }\n}\n");

    fs::write(Path::new(&输出目录).join("内置生成.rs"), 生成文本)
        .expect("写入生成的嵌入清单失败");
}
