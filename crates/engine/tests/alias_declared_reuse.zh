//! 别名阶段复用声明名的等价性
//!
//! 延迟项目上下文的管线入口（`延迟项目转译管线`）先在
//! **词法产物**上收集本文件声明，才能建项目上下文；别名阶段的输入却是
//! 「词法 → 导入路径替换 → `crate::` 前缀」之后的文本。本条优化把前者的声明
//! 直接借给后者，省掉别名阶段内部那趟「分词 + 声明状态机」。
//!
//! 前提是「两处的声明集合相同」：后续两个阶段只改导入段路径与路径根位前缀，
//! 不动声明关键字与声明位名字。本测试用两条路径的逐字节对比把它钉住：
//! - 阶段级：同一输入上「现场收集」与「复用外部声明」；
//! - 管线级：延迟入口（在词法产物上收集）与预计算入口（别名阶段现场收集），
//!   项目上下文按构造相同，故唯一变量就是声明名的来源。

使用 标准库::集合::哈希集合;
使用 标准库::路径::路径类型;

使用 引擎库::别名::{自我, 项目上下文};
使用 引擎库::映射管理器::映射管理器;
使用 引擎库::缓存::源码映射条目;

函数 中文管理器() -> 映射管理器 {
    让 目录 = 路径::新建(编译环境!("CARGO_MANIFEST_DIR")).等待线程("lang-packs/zh");
    映射管理器::从目录载入(&目录).期望("加载 zh 语言包失败")
}

/// 虚拟项目的模块名集合（`crate::` 前缀阶段用）
函数 模块名集合() -> 哈希集合<字符串> {
    ["工具".转字符串(), "辅助".转字符串()]
        .消费迭代()
        .收集()
}

/// 差分语料：覆盖导入路径、`crate::` 前缀、声明位撞名、库特征实现块、
/// 模式绑定、闭包与遍历绑定、宏调用
常量 语料: &[&文本] = &[
    // ① 导入路径 + 声明位撞名（`盒子` 等名字同时是库类型/构造名）
    "使用 标准库::文件系统::文件;
使用 工具::辅助::计数;
使用 标准库::集合::哈希映射;

结构体 盒子 {
    端口: 整数,
    名称: 字符串,
}

函数 新建(端口: 整数) -> 盒子 {
    盒子 { 端口, 名称: 字符串::新建() }
}
",
    // ② 库特征实现块：块内方法名是库特征方法（`显示`），照常替换
    "结构体 计数器 {
    值: 整数,
}

impl 显示 for 计数器 {
    fn 显示(&self) -> 字符串 {
        格式化!(\"{}\", self.值)
    }
}
",
    // ③ 模式绑定：库成员名 `连接` 被用作绑定名，必须豁免
    "函数 处理(结果: 结果<整数, 字符串>) {
    匹配 结果 {
        成功(连接) => 打印!(\"{连接}\"),
        错误(消息) => 打印!(\"{消息}\"),
    }
}
",
    // ④ 遍历绑定、闭包参数、方法链（`迭代`、`收集` 等库方法名）
    "函数 求和(项: 切片<整数>) -> 整数 {
    让 mut 总计 = 0;
    for 元素 in 项 {
        总计 += 元素;
    }
    让 加倍 = |值| 值 * 2;
    项.迭代().收集::<向量<整数>>()
}
",
    // ⑤ 声明位与库成员名撞名：`长度` 作常量与参数名
    "类型 回调 = fn(整数) -> 整数;

常量 长度: 整数 = 3;

函数 计算(长度: 整数) -> 整数 {
    长度 * 2
}
",
    // ⑥ 路径根位：项目模块名（`crate::` 前缀）+ 模块路径表回退
    "函数 入口() {
    工具::辅助::运行();
    辅助::工具::运行();
    标准库::打印!(\"hi\");
    让 盒 = 盒子::默认();
}
",
    // ⑦ 导入别名：`使用 … 作为` 后是同名声明位（库成员名 `长度`），路径段替换后
    // 仍不得改变声明集合
    "使用 标准库::集合::哈希映射 as 长度;
使用 工具::辅助 as 辅助模块;

函数 统计(数据: 长度<字符串, 整数>) -> 整数 {
    数据.长度()
}
",
];

函数 断言编辑相等(标签: &文本, 甲: &[源码映射条目], 乙: &[源码映射条目]) {
    断言相等!(甲.令牌长度(), 乙.令牌长度(), "{标签}：编辑表条目数不一致");
    对于 (序号, (左, 右)) 在 甲.迭代().拉链(乙).枚举() {
        断言相等!(左.源偏移, 右.源偏移, "{标签}：第 {序号} 条偏移");
        断言相等!(左.源码长度, 右.源码长度, "{标签}：第 {序号} 条长度");
        断言相等!(左.原文, 右.原文, "{标签}：第 {序号} 条原文");
        断言相等!(左.替换文字, 右.替换文字, "{标签}：第 {序号} 条替换文本");
    }
}

/// 阶段级等价：`declared = Some(外部收集)` 与未提供（现场收集）逐字段一致
#[测试]
函数 复用声明与现场收集一致() {
    让 管理器 = 中文管理器();
    让 别名表 = 管理器.取别名表();
    让 模块路径表 = 管理器.取模块路径表();
    让 模块集合 = 模块名集合();
    让 可变 有编辑数 = 0;
    对于 (序号, 源码) 在 语料.迭代().枚举() {
        让 声明 = 别名::收集声明名(源码, 别名表);
        让 项目 = 项目上下文::从声明集合(模块集合.克隆(), [&声明]);
        让 现场 =
            别名::带上下文与模块路径替换别名(源码, 别名表, 模块路径表, 有值(&项目));
        让 复用 =
            别名::按声明替换别名(源码, 别名表, 模块路径表, 有值(&项目), 有值(&声明));
        让 标签 = 格式化!("语料 #{序号}");
        断言相等!(现场.输出文本, 复用.输出文本, "{标签}：译文不一致");
        断言编辑相等(&标签, &现场.编辑表, &复用.编辑表);
        如果 !现场.编辑表.为空() {
            有编辑数 += 1;
        }
    }
    断言相等!(有编辑数, 语料.令牌长度(), "语料应全部含替换候选（避免空跑）");
}

/// 管线级等价：延迟入口（声明取自词法产物）与预计算入口（别名阶段现场收集）
/// 在同一项目上下文下产出完全相同的译文与全管线地图
#[测试]
函数 延迟入口与预计算入口一致() {
    让 管理器 = 中文管理器();
    让 模块集合 = 模块名集合();
    让 可变 有编辑数 = 0;
    对于 (序号, 源码) 在 语料.迭代().枚举() {
        让 声明 = 别名::收集源声明(源码, &管理器);
        让 项目 = 项目上下文::从声明集合(模块集合.克隆(), [&声明]);

        让 预计算 = 引擎库::带映射与项目转译管线(
            源码,
            &管理器,
            有值(&模块集合),
            有值(&项目),
        );
        让 (延迟, 本文件声明, 上下文) = 引擎库::静默延迟项目转译管线(
            源码,
            &管理器,
            有值(&模块集合),
            |本文件| 项目上下文::从声明集合(模块集合.克隆(), [本文件]),
        );

        让 标签 = 格式化!("语料 #{序号}");
        断言相等!(预计算.输出, 延迟.输出, "{标签}：译文不一致");
        断言相等!(上下文.指纹(), 项目.指纹(), "{标签}：项目上下文指纹不一致");
        断言相等!(本文件声明.条目集, 声明.条目集, "{标签}：项名集合不一致");
        断言相等!(本文件声明.变量集, 声明.变量集);
        断言相等!(本文件声明.成员集, 声明.成员集);
        断言相等!(本文件声明.库方法集, 声明.库方法集);
        断言编辑相等(&标签, &预计算.流程映射, &延迟.流程映射);
        如果 !预计算.流程映射.为空() {
            有编辑数 += 1;
        }
    }
    断言相等!(有编辑数, 语料.令牌长度(), "语料应全部产出编辑（避免空跑）");
}
