//! 词法差分测试（声明位启发式的判定基准）
//!
//! 把 `alias.rs`/`校验.rs` 里的"声明位保护"从经验规则升级为带判定基准的规格：
//! 随机生成大体符合语法的母语方言词元流，正向转译后用 Rust 词法器重新
//! 词法化，对源与产物断言四类结构不变量，并对不含模块路径的子集做反译回环。
//!
//! 断言（管线在 `module_names=None` 下运行，故 `crate::` 阶段被跳过，
//! 唯一的受控标点增量是宏自动补的 `!`）：
//! 1. 词元流结构同构：标点/运算符/字面量（除 `!`）的文本序列源与产物一致；
//!    `!` 的净增数恰等于本用例书写时省略感叹号的宏调用数；标识符词元数守恒。
//! 2. 空白不变量：词元间空白段与注释词元在产物中逐一原样保留（管线
//!    只做词元级替换，不增删空白/注释）。
//! 3. 声明位保真（核心）：声明关键字后紧跟的自定义命名（取自别名/标识符词表——
//!    这些词在非声明位会被别名阶段改写）必须在产物中逐字节原样出现，
//!    直接固化"声明位启发式"的契约。
//! 4. 幂等复核：`transpile(output) == output`（英文产物再转译不变）。
//!
//! 反译回环判定基准（独立属性）：对不含模块路径、宏一律带感叹号的生成子集，
//! `反译(output, reverse_map(kw+macro+alias+derive), ∅, ∅)` 还原源。

使用 标准库::集合::哈希映射;

使用 引擎库::带映射转译管线;
使用 引擎库::映射管理器::映射管理器;
使用 引擎库::词法器::反译;
使用 属性测试库::预导入::*;
使用 属性测试库::集合生成模块 作为 属性向量;
使用 词法解析器::{令牌种类, 切分令牌};

/// 别名阶段视为"声明关键字"的英文形式（见 `别名::声明关键字表`）：
/// 其后的首个标识符为用户自定义命名，须受声明位保护。
常量 声明关键字英文: &[&文本] = &[
    "fn", "struct", "enum", "trait", "type", "mod", "let", "const", "static",
];

/// 受控测试语言包：关键字/类型/宏/派生特征/模块路径/标识符别名全覆盖，
/// 且所有替换目标均为单标识符（不含 `::`/`.`/空格），便于结构同构断言。
函数 测试管理器() -> 映射管理器 {
    让 关键词配置 = r#"
["声明"]
"函数" = "fn"
"让" = "let"
"结构体" = "struct"
"枚举体" = "enum"
"特征" = "trait"
"常量" = "const"
"静态" = "static"
"类型别名" = "type"
"模块" = "mod"
"可变" = "mut"
"使用" = "use"
["类型"]
"整数" = "i32"
"布尔" = "bool"
["宏"]
"打印行" = "println"
"向量" = "vec"
["派生特征"]
"调试" = "Debug"
"克隆" = "Clone"
"#;
    让 模块路径配置 = r#"
["模块路径"]
"标准集合" = "std::collections"
"#;
    让 标识符配置 = r#"
["标识符"]
"新建" = "new"
"长度" = "len"
"迭代" = "iter"
"字符串" = "String"
"获取" = "get"
"#;
    映射管理器::从内置载入(关键词配置, 模块路径配置, 标识符配置, &[])
        .期望("加载受控测试语言包失败")
}

/// `en` 是否为合法的单 Rust 标识符（首字母/下划线，余字母数字/下划线）：
/// 只有这样的替换目标才不会引入额外标点，保证结构同构断言成立。
函数 是否为单个标识符(文本: &文本) -> 布尔 {
    让 可变 字符们 = 文本.逐字符();
    匹配 字符们.下一个() {
        有值(字符) 如果 字符.是ASCII字母() || 字符 == '_' => {}
        _ => 返回 假,
    }
    字符们.全部(|字符| 字符.是ASCII字母数字() || 字符 == '_')
}

/// 与反向表生成规则一致：英文 → 母语，同英文键取"排序最小"的母语词，
/// 保证反译候选确定。返回 (英文→母语表, 唯一映射的母语词集合)。
函数 构建反向表与唯一集(
    映射表们: &[&哈希映射<字符串, 字符串>],
) -> (哈希映射<字符串, 字符串>, 标准库::集合::哈希集合<字符串>) {
    让 可变 按英文: 哈希映射<字符串, 向量<字符串>> = 哈希映射::新建();
    对于 映射表 在 映射表们 {
        对于 (原生, 英文) 在 *映射表 {
            如果 原生 == 英文 || !是否为单个标识符(英文) {
                继续;
            }
            按英文.取条目(英文.克隆()).或用缺省().推(原生.克隆());
        }
    }
    让 可变 反向表 = 哈希映射::新建();
    让 可变 唯一集 = 标准库::集合::哈希集合::新建();
    对于 (英文, 可变 原生词们) 在 按英文 {
        原生词们.排序();
        原生词们.去重();
        如果 原生词们.令牌长度() == 1 {
            让 原生 = 原生词们.消费迭代().下一个().期望("非空");
            反向表.置入(英文.克隆(), 原生.克隆());
            唯一集.置入(原生);
        }
    }
    (反向表, 唯一集)
}

/// 词法词元的粗分类
#[派生(部分相等特征, 相等, 调试, 克隆, 复制)]
枚举 分类 {
    空白,
    注释,
    标识符项,
    其他,
}

函数 分类令牌(种类: 令牌种类) -> 分类 {
    匹配 种类 {
        令牌种类::空白符 => 分类::空白,
        令牌种类::行评论 | 令牌种类::块评论 { .. } => 分类::注释,
        令牌种类::标识符记号 | 令牌种类::原始标识符 => 分类::标识符项,
        _ => 分类::其他,
    }
}

/// 词法化为 (分类, 文本) 序列（Rust 词法器的标点均为单词元，`!` 归其他）
函数 词法化(源码: &文本) -> 向量<(分类, 字符串)> {
    让 可变 收集结果 = 向量::新建();
    让 可变 偏移 = 0usize;
    对于 令牌 在 切分令牌(源码) {
        收集结果.推((分类令牌(令牌.令牌类别), 源码[偏移..偏移 + 令牌.令牌长度].转字符串()));
        偏移 += 令牌.令牌长度;
    }
    收集结果
}

/// 取指定分类的文本序列
函数 取文本(令牌们: &[(分类, 字符串)], 类别: 分类) -> 向量<字符串> {
    令牌们
        .迭代()
        .日志过滤器(|(分类, _)| *分类 == 类别)
        .变换(|(_, 文本)| 文本.克隆())
        .收集()
}

/// 取"结构骨架"：其他类词元文本序列，剔除 `!`（宏自动补的感叹号是唯一受控增量）
函数 骨架排除感叹号(令牌们: &[(分类, 字符串)]) -> 向量<字符串> {
    令牌们
        .迭代()
        .日志过滤器(|(分类, 文本)| *分类 == 分类::其他 && 文本 != "!")
        .变换(|(_, 文本)| 文本.克隆())
        .收集()
}

/// 统计 `!` 词元数
函数 统计感叹号(令牌们: &[(分类, 字符串)]) -> 无符号机器整数 {
    令牌们
        .迭代()
        .日志过滤器(|(分类, 文本)| *分类 == 分类::其他 && 文本 == "!")
        .计数()
}

/// 在产物词元流中验证：英文声明关键字之后（跳过空白/注释）的首个标识符
/// 恰为受保护的原生命名（逐字节）。
函数 声明名保留(令牌们: &[(分类, 字符串)], 英文声明: &文本, 原生: &文本) -> 布尔 {
    让 有效令牌: 向量<&(分类, 字符串)> = 令牌们
        .迭代()
        .日志过滤器(|(分类, _)| *分类 == 分类::标识符项 || *分类 == 分类::其他)
        .收集();
    对于 窗口 在 有效令牌.窗口(2) {
        如果 窗口[0].1 == 英文声明 && 窗口[1].1 == 原生 {
            返回 真;
        }
    }
    假
}

/// 生成用的片段指令：种类 选择构造模板，甲/乙 为池内索引（对池长取模）
#[派生(克隆, 复制, 调试)]
结构体 片段 {
    种类: 字节,
    甲: 无符号整数,
    乙: 无符号整数,
}

/// 池：随语言包派生的原生词与固定的自定义命名/字面量/标点/注释
结构体 词池 {
    /// 声明关键字（原生词, 英文）
    声明: 向量<(字符串, 字符串)>,
    /// 别名/标识符原生词（非声明关键字，非模块路径；用于声明位保真与方法调用）
    别名: 向量<字符串>,
    /// 宏原生词
    宏词: 向量<字符串>,
    /// 自定义命名：不与任何映射表的原生键或英文值冲突，逐字节安全
    自定义: 向量<字符串>,
}

常量 字面量表: &[&文本] = &[
    "42",
    "0",
    "3.14",
    "\"字符串内容\"",
    "\"\"",
    "'a'",
    "b'x'",
    "r#\"原始串\"#",
];
常量 注释表: &[&文本] = &["// 行注释", "/* 块注释 */", "// 另一注释"];
常量 标点表: &[&文本] = &[
    ";", ",", "{", "}", "(", ")", "[", "]", "=", "+", "->", "<", ">",
];

实现 词池 {
    函数 新建(映射: &映射管理器) -> 词池 {
        让 关键词表 = 映射.取关键词表();
        让 别名表 = 映射.取别名表();
        让 宏表 = 映射.取宏表();
        让 模块路径表 = 映射.取模块路径表();

        // 反向唯一集：关键词+宏+别名+派生特征（排除模块路径——其英文含 `::` 非单标识符）
        让 (_反向, 唯一集) =
            构建反向表与唯一集(&[关键词表, 宏表, 别名表, 映射.取派生特征表()]);

        // 英文值全集（用于自定义命名排雷：自定义名不得是任何表的英文值，避免反译误改）
        让 可变 英文值集: 标准库::集合::哈希集合<字符串> = 标准库::集合::哈希集合::新建();
        对于 表 在 [关键词表, 宏表, 别名表, 映射.取派生特征表(), 模块路径表] {
            对于 英文 在 表.值() {
                英文值集.置入(英文.克隆());
            }
        }
        让 原生键集: 标准库::集合::哈希集合<&字符串> = 关键词表
            .取全部键()
            .链式(宏表.取全部键())
            .链式(别名表.取全部键())
            .收集();

        让 声明词: 向量<(字符串, 字符串)> = 关键词表
            .迭代()
            .日志过滤器(|(原生, 英文)| {
                声明关键字英文.包含(&英文.作为字符串())
                    && 是否为单个标识符(英文)
                    && 唯一集.包含(*原生)
            })
            .变换(|(原生, 英文)| (原生.克隆(), 英文.克隆()))
            .收集();

        // 别名词：来自标识符别名表，替换目标为单标识符且反向唯一
        让 别名词: 向量<字符串> = 别名表
            .取全部键()
            .日志过滤器(|原生| {
                是否为单个标识符(&别名表[*原生])
                    && 唯一集.包含(*原生)
                    && !声明关键字英文.包含(&别名表[*原生].作为字符串())
            })
            .克隆副本()
            .收集();

        让 宏词: 向量<字符串> = 宏表
            .取全部键()
            .日志过滤器(|原生| 是否为单个标识符(&宏表[*原生]) && 唯一集.包含(*原生))
            .克隆副本()
            .收集();

        // 固定候选自定义命名，过滤任何可能冲突者
        让 自定义名: 向量<字符串> = [
            "甲",
            "乙",
            "数据",
            "项目名",
            "我的变量",
            "辅助函数",
            "绝对值",
        ]
        .迭代()
        .变换(|文本| 文本.转字符串())
        .日志过滤器(|候选| !英文值集.包含(候选) && !原生键集.包含(候选))
        .收集();

        断言!(
            !声明词.为空() && !别名词.为空() && !自定义名.为空(),
            "受控词表不完整：decl={:?} alias={:?} custom={:?}",
            声明词,
            别名词,
            自定义名
        );
        词池 {
            声明: 声明词,
            别名: 别名词,
            宏词,
            自定义: 自定义名,
        }
    }
}

/// 片段模板编号
常量 声明片段: 字节 = 0;
常量 自定义片段: 字节 = 1;
常量 方法片段: 字节 = 2;
常量 宏片段: 字节 = 3;
常量 字面量片段: 字节 = 4;
常量 标点片段: 字节 = 5;
常量 注释片段: 字节 = 6;
常量 路径片段: 字节 = 7;
常量 涡轮鱼片段: 字节 = 8;

/// 渲染片段为源码，同时收集：期望的声明位保真对 (英文声明词, 原生名) 与
/// 期望的宏补感叹号数（省略感叹号书写的宏调用数）。
函数 渲染(
    片段列表: &[片段],
    词池: &词池,
    强制感叹号宏: 布尔,
) -> (字符串, 向量<(字符串, 字符串)>, 无符号机器整数) {
    让 可变 源码 = 字符串::新建();
    让 可变 保留对: 向量<(字符串, 字符串)> = 向量::新建();
    让 可变 期望感叹号 = 0usize;
    // 行注释会吞掉同行其后内容：若上一片段为行注释，则以换行分隔，
    // 保证后续片段仍处于代码位（否则宏 `!` 等替换不生效，破坏判定基准前提）
    让 可变 上一为行注释 = 假;
    对于 (序号, 片) 在 片段列表.迭代().枚举() {
        如果 序号 > 0 {
            源码.推(如果 上一为行注释 { '\n' } 否则 { ' ' });
        }
        上一为行注释 = 假;
        匹配 片.种类 {
            声明片段 => {
                让 (原生声明, 英文声明) = &词池.声明[片.甲 作为 无符号机器整数 % 词池.声明.令牌长度()];
                // 声明名取自别名表（这些词在非声明位会被别名阶段改写）或自定义命名，
                // 二者都应在声明位被逐字节保留
                让 名称 = 如果 片.乙 % 2 == 0 {
                    词池.别名[片.乙 作为 无符号机器整数 % 词池.别名.令牌长度()].克隆()
                } 否则 {
                    词池.自定义[(片.乙 作为 无符号机器整数) % 词池.自定义.令牌长度()].克隆()
                };
                保留对.推((英文声明.克隆(), 名称.克隆()));
                源码.推入字符串(原生声明);
                源码.推(' ');
                源码.推入字符串(&名称);
            }
            自定义片段 => {
                源码.推入字符串(&词池.自定义[片.甲 作为 无符号机器整数 % 词池.自定义.令牌长度()]);
            }
            方法片段 => {
                源码.推入字符串(&词池.自定义[片.甲 作为 无符号机器整数 % 词池.自定义.令牌长度()]);
                源码.推('.');
                源码.推入字符串(&词池.别名[片.乙 作为 无符号机器整数 % 词池.别名.令牌长度()]);
                源码.推入字符串("()");
            }
            宏片段 => {
                让 宏词项 = &词池.宏词[片.甲 作为 无符号机器整数 % 词池.宏词.令牌长度()];
                源码.推入字符串(宏词项);
                让 带感叹号 = 强制感叹号宏 || (片.乙 % 2 == 0);
                如果 带感叹号 {
                    源码.推('!');
                } 否则 {
                    期望感叹号 += 1;
                }
                源码.推入字符串("(\"参数\")");
            }
            字面量片段 => 源码.推入字符串(字面量表[片.甲 作为 无符号机器整数 % 字面量表.令牌长度()]),
            标点片段 => 源码.推入字符串(标点表[片.甲 作为 无符号机器整数 % 标点表.令牌长度()]),
            注释片段 => {
                让 注释 = 注释表[片.甲 作为 无符号机器整数 % 注释表.令牌长度()];
                上一为行注释 = 注释.以开头("//");
                源码.推入字符串(注释);
            }
            路径片段 => {
                源码.推入字符串(&词池.自定义[片.甲 作为 无符号机器整数 % 词池.自定义.令牌长度()]);
                源码.推入字符串("::");
                源码.推入字符串(&词池.自定义[片.乙 作为 无符号机器整数 % 词池.自定义.令牌长度()]);
            }
            涡轮鱼片段 => {
                源码.推入字符串(&词池.自定义[片.甲 作为 无符号机器整数 % 词池.自定义.令牌长度()]);
                源码.推入字符串("::<");
                源码.推入字符串(&词池.自定义[片.乙 作为 无符号机器整数 % 词池.自定义.令牌长度()]);
                源码.推('>');
            }
            _ => {}
        }
    }
    (源码, 保留对, 期望感叹号)
}

函数 片段策略() -> 实现 生成策略<JSON值 = 片段> {
    (0u8..9, 任意::<无符号整数>(), 任意::<无符号整数>()).属性映射(|(种类, 甲, 乙)| 片段 { 种类, 甲, 乙 })
}

属性测试库! {
    #![属性配置函数(属性测试配置::带用例数(512))]

    /// 正向管线的四类结构不变量 + 幂等
    #[测试]
    函数 性质_结构不变量(片段列表 在 属性向量::向量宏(片段策略(), 1..=12)) {
        让 管理器 = 测试管理器();
        让 词池 = 词池::新建(&管理器);
        让 (源码, 保留对, 期望感叹号) = 渲染(&片段列表, &词池, 假);

        让 转译产物 = 带映射转译管线(&源码, &管理器, 无);
        让 输出 = &转译产物.输出;

        让 源令牌 = 词法化(&源码);
        让 输出令牌 = 词法化(输出);

        // 2. 空白不变量：空白段与注释词元逐一原样保留
        属性断言相等!(取文本(&源令牌, 分类::空白), 取文本(&输出令牌, 分类::空白),
            "空白 token 序列应逐字节保留\nsource={:?}\noutput={:?}", 源码, 输出);
        属性断言相等!(取文本(&源令牌, 分类::注释), 取文本(&输出令牌, 分类::注释),
            "注释 token 序列应逐字节保留");

        // 1a. 结构骨架同构：标点/运算符/字面量（除 `!`）文本序列源与产物一致
        属性断言相等!(骨架排除感叹号(&源令牌), 骨架排除感叹号(&输出令牌),
            "除宏 `!` 外标点/字面量应守恒\nsource={:?}", 源码);

        // 1b. `!` 净增恰等于省略感叹号的宏调用数
        让 新增感叹号 = 统计感叹号(&输出令牌).饱和减(统计感叹号(&源令牌));
        属性断言相等!(新增感叹号, 期望感叹号,
            "宏补 `!` 增量应等于省略感叹号的宏调用数\nsource={:?}", 源码);

        // 1c. 标识符词元数守恒（原生词→单标识符英文，1:1；无路径前缀插入）
        属性断言相等!(取文本(&源令牌, 分类::标识符项).令牌长度(), 取文本(&输出令牌, 分类::标识符项).令牌长度(),
            "标识符 token 数应守恒\noutput={:?}", 输出);

        // 3. 声明位保真（核心）
        对于 (英文声明, 名称) 在 &保留对 {
            属性断言!(声明名保留(&输出令牌, 英文声明, 名称),
                "声明位命名 {:?} 应在输出中逐字节保留（位于 {:?} 之后）\noutput={:?}",
                名称, 英文声明, 输出);
        }

        // 4. 幂等复核：英文产物再转译不变
        让 再次 = 带映射转译管线(输出, &管理器, 无).输出;
        属性断言相等!(&再次, 输出, "对输出再转译应保持不变\noutput={:?}", 输出);
    }

    /// 反译回环判定基准：不含模块路径、宏一律带感叹号的子集，反译还原源
    #[测试]
    函数 性质_反译回环(片段列表 在 属性向量::向量宏(片段策略(), 1..=10)) {
        让 管理器 = 测试管理器();
        让 词池 = 词池::新建(&管理器);
        让 (源码, _保留对, _感叹号) = 渲染(&片段列表, &词池, 真);

        让 转译产物 = 带映射转译管线(&源码, &管理器, 无);
        让 输出 = &转译产物.输出;

        // 合并关键字 + 宏 + 别名 + 派生特征并反转（英文 → 母语，排序最小者优先）
        让 (反向表, _唯一集) = 构建反向表与唯一集(&[
            管理器.取关键词表(),
            管理器.取宏表(),
            管理器.取别名表(),
            管理器.取派生特征表(),
        ]);

        让 还原 = 反译(
            输出,
            &反向表,
            &标准库::集合::哈希集合::新建(),
            &标准库::集合::哈希集合::新建(),
        );
        属性断言相等!(&还原, &源码,
            "反译应精确还原母语源\nsource={:?}\noutput={:?}\nrestored={:?}",
            源码, 输出, 还原);
    }
}
