//! 延迟项目上下文入口的等价性（`延迟项目转译管线`）
//!
//! 老路径：先 `收集源声明` 预扫本文件声明 → 合并其他文件声明
//! 建项目上下文 → 跑完整管线（本文件被词法转译两次）。
//! 新路径：管线先做词法阶段，本文件声明从词法产物顺带收集 → 回调合并其他
//! 文件声明 → 继续后续阶段（只转译一次）。
//!
//! 两条路径的项目上下文按构造相同，转译产物必须逐字节一致；本测试把它钉住，
//! 避免「顺带收集」在声明位启发式上与预扫版本漂移。

使用 标准库::集合::哈希集合;
使用 标准库::路径::路径类型;

使用 引擎库::别名::{收集源声明, 项目上下文};
使用 引擎库::映射管理器::映射管理器;

函数 中文管理器() -> 映射管理器 {
    让 目录 = 路径::新建(编译环境!("CARGO_MANIFEST_DIR")).等待线程("lang-packs/zh");
    映射管理器::从目录载入(&目录).期望("加载 zh 语言包失败")
}

/// 甲文件：声明 `新建`（与 `新建` 的别名映射撞名）与结构体字段
常量 甲源码: &文本 = "结构体 平台 {
    端口: 整数,
}

函数 新建(端口: 整数) -> 平台 {
    返回 平台 { 端口 };
}
";

/// 乙文件：跨文件调用甲的成员（应豁免）+ 库 API 调用（应照常替换）
常量 乙源码: &文本 = "函数 启动() {
    让 实例 = 甲::新建(8080);
    让 盒 = 盒子::新建();
    让 值 = 实例.端口;
}
";

函数 模块名集合() -> 哈希集合<字符串> {
    ["甲".转字符串(), "乙".转字符串()].消费迭代().收集()
}

#[测试]
函数 延迟项目与预计算项目一致() {
    让 管理器 = 中文管理器();
    让 模块集合 = 模块名集合();
    让 别名表 = 管理器.取别名表();
    断言!(
        别名表.包含键("新建") && 别名表.包含键("盒子"),
        "测试前提：zh 语言包应含 `新建`/`盒子` 的别名映射"
    );

    // 老路径：先预扫两文件声明，再建上下文
    让 甲声明 = 收集源声明(甲源码, &管理器);
    让 乙声明 = 收集源声明(乙源码, &管理器);
    让 上下文 = 项目上下文::从声明集合(模块集合.克隆(), [&甲声明, &乙声明]);
    让 老产物 = 引擎库::带映射与项目转译管线(
        乙源码,
        &管理器,
        有值(&模块集合),
        有值(&上下文),
    );
    断言!(
        老产物.输出.包含("甲::新建(8080)"),
        "跨文件声明位应与声明侧一致：{}",
        老产物.输出
    );
    断言!(
        老产物.输出.包含("Box::new()"),
        "库 API 路径段照常替换：{}",
        老产物.输出
    );

    // 新路径：本文件声明由词法阶段顺带产出，回调只合并其他文件声明
    让 (新产物, 本文件声明, 新上下文) =
        引擎库::延迟项目转译管线(乙源码, &管理器, 有值(&模块集合), |本文件| {
            项目上下文::从声明集合(模块集合.克隆(), [&甲声明, 本文件])
        });

    断言相等!(新产物.输出, 老产物.输出, "两条路径的译文必须逐字节一致");
    断言相等!(
        新产物.流程映射.令牌长度(),
        老产物.流程映射.令牌长度(),
        "编辑表条目数必须一致"
    );
    断言相等!(
        本文件声明.条目集, 乙声明.条目集,
        "顺带收集的项名必须与预扫一致"
    );
    断言相等!(本文件声明.变量集, 乙声明.变量集);
    断言相等!(本文件声明.成员集, 乙声明.成员集);
    断言相等!(本文件声明.库方法集, 乙声明.库方法集);
    断言相等!(
        新上下文.指纹(),
        上下文.指纹(),
        "两条路径的项目上下文指纹必须一致"
    );
}

/// 静默变体除告警外与标准变体完全一致
#[测试]
函数 静默变体输出一致() {
    让 管理器 = 中文管理器();
    让 模块集合 = 模块名集合();
    让 甲声明 = 收集源声明(甲源码, &管理器);
    让 乙声明 = 收集源声明(乙源码, &管理器);
    让 上下文 = 项目上下文::从声明集合(模块集合.克隆(), [&甲声明, &乙声明]);

    让 带告警 = 引擎库::带映射与项目转译管线(
        乙源码,
        &管理器,
        有值(&模块集合),
        有值(&上下文),
    );
    让 静默 = 引擎库::静默带映射与项目转译管线(
        乙源码,
        &管理器,
        有值(&模块集合),
        有值(&上下文),
    );
    // 整份转译产物比（派生部分相等特征覆盖输出、源映射、流程映射三字段）：
    // 静默入口只关教学告警的日志输出，任何字段有差异都属于实现漂移
    断言相等!(静默, 带告警, "静默变体与带告警变体的转译产物必须逐字段一致");
}
