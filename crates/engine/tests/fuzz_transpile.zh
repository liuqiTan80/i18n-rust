//! 转译管线模糊测试（属性测试）
//!
//! 随机生成方言源码片段（关键字/标识符/数字/字符串/注释/空白/标点的任意
//! 组合，含畸形输入：未闭合字符串、孤立标点、从右到左书写字符等），验证转译管线
//! 的关键不变量：
//! - 永不恐慌（任何输入都必须产出结果）；
//! - 不改变行结构（LSP 行号映射依赖：转译只做词元级替换，不增删换行）；
//! - 源映射条目的偏移/长度全部落在源文本内，且原文与源文本逐字节一致
//!   （LSP 列映射与诊断还原的坐标换算依赖此精确性）；
//! - 流程映射按源偏移严格升序（消费方回放依赖，乱序会破坏列映射）；
//! - 词法阶段的两张编辑表逐条等价（全管线表回放等于输出，词法表只差补的 `!`）；
//! - 幂等：转译输出再次转译保持不变（映射表无英文键、无来回抖动）。

使用 标准库::路径::路径类型;

使用 引擎库::映射管理器::映射管理器;
使用 引擎库::词法器;
使用 引擎库::转译管线;
使用 属性测试库::预导入::*;
使用 属性测试库::集合生成模块 作为 属性向量;

/// 内置 zh 语言包映射管理器（与 CLI 默认一致）
函数 中文管理器() -> 映射管理器 {
    让 目录 = 路径::新建(编译环境!("CARGO_MANIFEST_DIR")).等待线程("lang-packs/zh");
    映射管理器::从目录载入(&目录).期望("加载 zh 语言包失败")
}

/// 方言源码片段策略：方言词表 + 畸形输入的任意组合
///
/// 词表覆盖各转译阶段：词法关键字（函数/让/打印行!/类型）、模块路径
/// （标准库::…）、标识符、字符串（含未闭合）、注释（行/块）、原始字符串、
/// 数字、标点、空白；另混入任意英文片段与任意中文片段（模糊测试词法边界判定
/// 与最长匹配逻辑）。
函数 源码策略() -> 实现 生成策略<JSON值 = 字符串> {
    属性向量::向量宏(
        属性择一![
            恒值策略("函数 ".转字符串()),
            恒值策略("主函数".转字符串()),
            恒值策略("让 ".转字符串()),
            恒值策略("打印行!".转字符串()),
            恒值策略("整数".转字符串()),
            恒值策略("返回 ".转字符串()),
            恒值策略("使用 ".转字符串()),
            恒值策略("标准库::集合::映射".转字符串()),
            恒值策略("变量名".转字符串()),
            恒值策略("\"字符串内容\"".转字符串()),
            恒值策略("\"未闭合字符串".转字符串()),
            恒值策略("// 注释".转字符串()),
            恒值策略("/* 块注释 */".转字符串()),
            恒值策略("r#\"原始\"#".转字符串()),
            恒值策略("42".转字符串()),
            恒值策略(";".转字符串()),
            恒值策略("{".转字符串()),
            恒值策略("}".转字符串()),
            恒值策略("\n".转字符串()),
            恒值策略("\t".转字符串()),
            恒值策略("fn".转字符串()),
            恒值策略("let".转字符串()),
            // 近期边界缺陷对抗词族：通配符/反引号/路径分隔符/空捕获/连续标点
            恒值策略("?".转字符串()),
            恒值策略("??".转字符串()),
            恒值策略("`".转字符串()),
            恒值策略("``".转字符串()),
            恒值策略("::".转字符串()),
            恒值策略("src/子模块/主程序".转字符串()),
            恒值策略("->".转字符串()),
            恒值策略("=>".转字符串()),
            恒值策略("(( ))".转字符串()),
            恒值策略("，；".转字符串()),
            "[a-z]{0,6}".属性映射(字符串::从),
            "[\u{4e00}-\u{9fff}]{0,4}".属性映射(字符串::从),
        ],
        1..150,
    )
    .属性映射(|片段们| 片段们.拼接())
}

/// 「方言词仅出现在串/注释内」的安全容器策略：每个片段整体是一个字符串
/// 字面量或块注释，内含在代码位会被翻译的方言关键词。整段都是字面量/注释
/// 词元，词法层绝不进入替换分支——锁死「串/注释内容不被误改」这一语义核心
/// 不变量（其余模糊测试用例只保证不恐慌 / 行结构 / 坐标 / 幂等，而幂等恰恰
/// 察觉不了「串内被译成英文后二次仍不变」这类语义误改）。
函数 引号方言源码() -> 实现 生成策略<JSON值 = 字符串> {
    让 方言词 = 属性向量::向量宏(
        属性择一![
            恒值策略("函数 ".转字符串()),
            恒值策略("让 ".转字符串()),
            恒值策略("使用 ".转字符串()),
            恒值策略("返回 ".转字符串()),
            恒值策略("类型 ".转字符串()),
            恒值策略("整数".转字符串()),
            恒值策略("布尔".转字符串()),
            恒值策略("标准库::集合::映射".转字符串()),
            恒值策略("打印行".转字符串()),
            恒值策略("声明 ".转字符串()),
            恒值策略("特征 ".转字符串()),
        ],
        1..4,
    );
    让 容器 = 属性择一![
        方言词
            .克隆()
            .属性映射(|词们| 格式化!(r#""{内容}""#, 内容 = 词们.拼接())),
        方言词.属性映射(|词们| 格式化!("/* {内容} */", 内容 = 词们.拼接())),
    ];
    属性向量::向量宏(容器, 1..12).属性映射(|容器列表| 容器列表.等待线程(" "))
}

属性测试库! {
    #![属性配置函数(属性测试配置 {
        // 本地默认 256 用例；CI 全量测试中该文件同样执行（约 3-5 秒）
        用例数: 256,
        ..属性测试配置::缺省()
    })]

    /// 转译不恐慌、行结构不变、源映射边界合法且原文与源一致、流程映射升序
    #[测试]
    函数 模糊_管线保持行号与映射(源码 在 源码策略()) {
        让 管理器 = 中文管理器();
        让 输出 = 转译管线(&源码, &管理器);
        属性断言相等!(
            输出.输出.匹配('\n').计数(),
            源码.匹配('\n').计数(),
            "转译不得改变行结构（LSP 行号映射依赖）"
        );
        对于 条目 在 输出.源映射.迭代().链式(输出.流程映射.迭代()) {
            属性断言!(条目.源偏移 <= 源码.令牌长度(), "源映射偏移越界");
            属性断言!(
                条目.源偏移 + 条目.源码长度 <= 源码.令牌长度(),
                "源映射长度越界"
            );
            属性断言相等!(
                &源码[条目.源偏移..条目.源偏移 + 条目.源码长度],
                &条目.原文,
                "源映射 original 与源文本不一致"
            );
        }
        // 流程映射源偏移严格升序（列映射消费方回放依赖）
        让 可变 上一偏移: 选项<无符号机器整数> = 无;
        对于 条目 在 &输出.流程映射 {
            如果 让 有值(偏移) = 上一偏移 {
                属性断言!(偏移 < 条目.源偏移, "pipeline_map 未按源偏移升序");
            }
            上一偏移 = 有值(条目.源偏移);
        }
    }

    /// 词法阶段两张编辑表逐条等价（复制逻辑的回归锁，口径见 词法器 模块
    /// 的源映射构建逻辑）
    ///
    /// 主循环只收全管线表、词法表循环后由它复制并按下标覆盖补 `!` 的差异条目。
    /// 复制逻辑漏条目、写错替换值、弄丢「词法表不含自动补的 `!`」这一差别，都会
    /// 在随机语料上暴露：① 全管线表回放必须逐字等于词法输出；② 两张表逐条同
    /// 偏移同原文、替换值只可能差一个自动补的 `!`，且不进词法表的条目只能是
    /// 「原文 + `!`」那一种。
    #[测试]
    函数 模糊_词法阶段编辑表同步(源码 在 源码策略()) {
        让 管理器 = 中文管理器();
        让 转译结果 = 词法器::分词转译(
            &源码,
            管理器.取关键词表(),
            管理器.取宏表(),
            管理器.取派生特征表(),
            管理器.取让位词(),
            管理器.取方法让位词(),
            管理器.取别名表(),
        );

        让 可变 回放 = 字符串::新建();
        让 可变 已复制 = 0usize;
        对于 编辑 在 &转译结果.最终编辑表 {
            属性断言!(
                编辑.源偏移 >= 已复制,
                "全管线表必须按偏移升序且不重叠：{编辑:?}"
            );
            回放.推入字符串(&源码[已复制..编辑.源偏移]);
            回放.推入字符串(编辑.替换文字.文本切片());
            已复制 = 编辑.源偏移 + 编辑.源码长度;
        }
        回放.推入字符串(&源码[已复制..]);
        属性断言相等!(回放, 转译结果.输出.克隆(), "全管线表回放必须逐字等于输出");

        让 可变 词法迭代器 = 转译结果.源映射.迭代();
        让 可变 待匹配 = 词法迭代器.下一个();
        对于 编辑 在 &转译结果.最终编辑表 {
            如果 待匹配.有值且(|条目| 条目.源偏移 == 编辑.源偏移) {
                让 条目 = 待匹配.取().期望("上面 is_some 判定的就是这个条目");
                属性断言相等!(条目.源码长度, 编辑.源码长度, "两表条目长度必须一致");
                属性断言相等!(&条目.原文, &编辑.原文, "两表条目原文必须一致");
                让 差异 = 编辑.替换文字.文本切片().去前缀(条目.替换文字.文本切片());
                属性断言!(
                    差异 == 有值("") || 差异 == 有值("!"),
                    "偏移 {}：词法表 {:?} 与全管线表 {:?} 只能差一个补的 `!`",
                    编辑.源偏移,
                    条目.替换文字,
                    编辑.替换文字
                );
                待匹配 = 词法迭代器.下一个();
            } 否则 {
                让 原文 = &源码[编辑.源偏移..编辑.源偏移 + 编辑.源码长度];
                属性断言相等!(
                    编辑.替换文字.文本切片(),
                    格式化!("{原文}!"),
                    "不进词法表的条目只能是「原文只补 `!`」"
                );
            }
        }
        属性断言!(待匹配.是否为无(), "词法表不能有全管线表之外的条目");
    }

    /// 幂等：转译输出再次转译保持不变（映射无抖动）
    #[测试]
    函数 模糊_转译输出幂等(源码 在 源码策略()) {
        让 管理器 = 中文管理器();
        让 一次 = 转译管线(&源码, &管理器).输出;
        让 两次 = 转译管线(&一次, &管理器).输出;
        属性断言相等!(一次, 两次, "转译输出应幂等");
    }

    /// 教学检查（全角标点/教学检查）在任意输入上不恐慌
    #[测试]
    函数 模糊_教学检查不恐慌(源码 在 源码策略()) {
        让 _ = 引擎库::全角标点::检测全角标点(&源码);
        让 _ = 引擎库::校验::检查教学(&源码);
    }

    /// 方言词只要整体处于字符串/块注释内，转译输出必须逐字节不变
    /// （语义核心不变量：串/注释内容不得被转译；弥补幂等断言的盲区）
    #[测试]
    函数 模糊_串与注释内方言词不变(源码 在 引号方言源码()) {
        让 管理器 = 中文管理器();
        让 输出 = 转译管线(&源码, &管理器).输出;
        属性断言相等!(&输出, &源码, "串/注释内的方言词不得被转译");
    }
}

/// 回归（#2）：模块路径词在表达式位生效
///
/// stdlib.toml【标识符】节的安全子集副本让表达式内的完整限定路径
/// （`标准库::输入输出::标准错误`）逐段转译；重名冲突词（路径/时间/
/// 同步/切片/格式化）不在此列，仍走导入别名。
#[测试]
函数 测试_表达式路径内模块路径词() {
    让 管理器 = 中文管理器();
    让 源码 = "函数 主函数() {\n    让 e = 标准库::输入输出::标准错误();\n    让 a = 标准库::进程::参数();\n    让 m = 标准库::集合::哈希映射::新建();\n}";
    让 输出 = 转译管线(源码, &管理器).输出;
    断言!(
        输出.包含("std::io::stderr()"),
        "表达式路径段应逐段转译：{输出}"
    );
    断言!(
        输出.包含("std::process::args()"),
        "进程段应转译：{输出}"
    );
    断言!(
        输出.包含("std::collections::HashMap::new()"),
        "集合段应转译：{输出}"
    );
}

/// 回归（#8）：跨文件声明豁免（项目级声明上下文）
///
/// weix-1 实测场景：`平台Linux.zh` 声明 `pub 函数 新建()`，`平台接口.zh`
/// 调用 `包::平台Linux::Linux内存源::新建()`——单文件声明豁免看不到其他
/// 文件的声明，`新建` 被错误替换（E0599，与声明侧的声明名不一致）。
/// 项目上下文（同名模块 + 声明名）让调用位与声明位保持一致；
/// 库 API 路径段（`盒子::新建` → `Box::new`）不受影响。
#[测试]
函数 测试_项目上下文跨文件声明() {
    让 管理器 = 中文管理器();
    // 定义侧：平台Linux.zh 声明与映射词同名的项目函数
    让 定义源码 = "pub 函数 新建() -> 自我 { 自我 { 状态: 0 } }";
    // 调用侧：其他文件走完整限定路径 + 库 API 路径
    让 调用源码 = "函数 初始化() {\n    让 e = 包::平台Linux::Linux内存源::新建();\n    让 b = 盒子::新建();\n}";

    // 项目扫描：模块名=文件词干，声明名=全部文件汇总；
    // 定义侧声明的 `新建` 须入上下文（否则调用位无豁免）
    让 上下文 = 引擎库::别名::项目上下文::从源集合(
        标准库::集合::哈希集合::从(["平台Linux".转字符串(), "平台接口".转字符串()]),
        [定义源码, 调用源码],
        &管理器,
    );
    断言!(
        上下文.名字集.包含("新建"),
        "项目扫描应收集定义侧声明：{上下文:?}"
    );
    让 输出 = 引擎库::静默带项目转译管线(调用源码, &管理器, 有值(&上下文)).输出;
    断言!(
        输出.包含("crate::平台Linux::Linux内存源::新建()"),
        "跨文件调用位应与声明位一致（新建 不被替换）：{输出}"
    );
    断言!(
        输出.包含("Box::new()"),
        "库 API 路径段照常替换（盒子::新建 → Box::new）：{输出}"
    );
    // 反例：无项目上下文（旧行为）时跨文件调用被错误替换
    让 无上下文输出 = 转译管线(调用源码, &管理器).输出;
    断言!(
        无上下文输出.包含("crate::平台Linux::Linux内存源::new()"),
        "无上下文时保持旧行为：{无上下文输出}"
    );
}

/// 回归：串/行注释/块注释/原始字符串内的方言词一律不被转译，而代码位的
/// 函数关键字照常翻译。独立于属性测试随机用例的确定性锚点，
/// 即使模糊测试配置缩减也始终执行。
#[测试]
函数 测试_串注释原始串内方言词保留() {
    让 管理器 = 中文管理器();
    让 源码 = r##"函数 主函数() {
    // 让 使用 标准库::集合::映射 打印行
    let 名字 = "函数 让 标准库::集合 类型";
    /* 返回 特征 声明 */
    let 原始 = r"串里的 函数 让 不变";
}"##;
    让 输出 = 转译管线(源码, &管理器).输出;
    // 代码位关键词正常翻译
    断言!(输出.包含("fn "), "代码位 函数 应翻译为 fn：{输出}");
    // 串/注释内容逐字节保留
    断言!(
        输出.包含(r#""函数 让 标准库::集合 类型""#),
        "字符串内容须原样：{输出}"
    );
    断言!(
        输出.包含("// 让 使用 标准库::集合::映射 打印行"),
        "行注释须原样：{输出}"
    );
    断言!(
        输出.包含("/* 返回 特征 声明 */"),
        "块注释须原样：{输出}"
    );
    断言!(
        输出.包含(r#"r"串里的 函数 让 不变""#),
        "原始字符串须原样：{输出}"
    );
}

/// 回归（串/注释不变量 与 数字类型后缀状态机的交叉边界）：数字紧跟中文类型名
/// （真实 zh 数据：关键字表 `无符号微整数` 映射到 8 位无符号整数、标准库表 `无符号机器整数` 映射到机器字长无符号整数）
/// 在代码位照常替换，但同形内容整体落在字符串内时必须逐字节不变。后缀替换只认
/// 字面量词元的真实后缀区（字符串的后缀起始位置等于全长、后缀为空），借此
/// 锁死后缀状态机不误伤串内内容——弥补两条数字后缀单测仅用合成映射表、未覆盖此交叉。
#[测试]
函数 测试_串内数字类型后缀保留() {
    让 管理器 = 中文管理器();
    // 代码位：真实 zh 数据下数字+类型名应替换为 0u8 / 0usize
    让 代码源码 = "让 x = 0无符号微整数;\n让 y = 0无符号机器整数;";
    让 代码输出 = 转译管线(代码源码, &管理器).输出;
    断言!(代码输出.包含("0u8"), "代码位应替换为 0u8：{代码输出}");
    断言!(
        代码输出.包含("0usize"),
        "代码位应替换为 0usize：{代码输出}"
    );
    // 串内：同形的数字+类型名必须逐字节保留
    让 串源码 = r#"让 s = "0无符号微整数 0无符号机器整数";"#;
    让 串输出 = 转译管线(串源码, &管理器).输出;
    断言!(
        串输出.包含(r#""0无符号微整数 0无符号机器整数""#),
        "串内数字类型名须原样：{串输出}"
    );
}
