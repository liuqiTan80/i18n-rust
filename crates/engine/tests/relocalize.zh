//! 反译重生引擎级测试：跨母语阅读的可编译保真
//!
//! 固定 zh 样例经「正向转译到标准 Rust → 反译重生到 ja」产出含日文词条的
//! 可编译方言，验证：核心词「主函数」取关键字表词条（`主関数`）而非第三方库
//! 别名（异步运行时的 `メイン関数`）；反译产物可再转译回 `fn main`；往返幂等；纯函数。

使用 标准库::路径::路径类型;

使用 引擎库::反译重生::反译重生;
使用 引擎库::映射管理器::映射管理器;
使用 引擎库::转译管线;

函数 管理器(语言: &文本) -> 映射管理器 {
    让 目录 = 路径::新建(编译环境!("CARGO_MANIFEST_DIR")).等待线程(格式化!("lang-packs/{语言}"));
    映射管理器::从目录载入(&目录).取值或_else(|故障值| 恐慌!("加载 {语言} 语言包失败: {故障值}"))
}

/// zh 样例源码（声明/控制流/宏/字符串，字符串内含词条探针）
常量 中文源码: &文本 = r#"函数 主函数() {
    让 数字 = 42;
    打印行!("答案是 {}", 数字);
    如果 数字 > 10 {
        打印行!("很大 打印行! 不该被改");
    }
    返回 ();
}
"#;

#[测试]
函数 反译重生_中日使用核心主关键字而非库别名() {
    让 中文 = 管理器("zh");
    让 日文 = 管理器("ja");
    让 英文 = 转译管线(中文源码, &中文).输出;
    让 日文源码 = 反译重生(&英文, &日文);
    断言!(日文源码.包含("関数"), "应含 ja `関数`: {日文源码}");
    断言!(日文源码.包含("もし"), "应含 ja `もし`: {日文源码}");
    断言!(
        日文源码.包含("表示行!"),
        "应含 ja `表示行!`: {日文源码}"
    );
    断言!(日文源码.包含("主関数"), "入口应为 `主関数`: {日文源码}");
    断言!(
        !日文源码.包含("メイン関数"),
        "不应把 main 反查为 tokio crate 别名 `メイン関数`: {日文源码}"
    );
    断言!(日文源码.包含("答案是"), "字符串应保持原样: {日文源码}");
}

#[测试]
函数 反译产物回译后英文一致() {
    让 中文 = 管理器("zh");
    让 日文 = 管理器("ja");
    让 英文 = 转译管线(中文源码, &中文).输出;
    让 日文源码 = 反译重生(&英文, &日文);
    让 回译 = 转译管线(&日文源码, &日文).输出;
    断言!(
        回译.包含("fn main"),
        "反译产物应可转译回 `fn main`: {回译}"
    );
    断言!(
        回译.包含("println!"),
        "反译产物应可转译回 `println!`: {回译}"
    );
}

#[测试]
函数 反译重生幂等() {
    让 日文 = 管理器("ja");
    让 中文 = 管理器("zh");
    让 英文 = 转译管线(中文源码, &中文).输出;
    让 首次 = 反译重生(&英文, &日文);
    让 英文再次 = 转译管线(&首次, &日文).输出;
    让 再次 = 反译重生(&英文再次, &日文);
    断言相等!(首次, 再次, "relocalize 经正向/反译往返应幂等");
}

#[测试]
函数 反译重生空输入与标准输入不恐慌() {
    让 日文 = 管理器("ja");
    断言相等!(反译重生("", &日文), "", "空输入应得空输出");
    让 _ = 反译重生("fn main() { let x = std::mem::size_of::<u8>(); }", &日文);
}
