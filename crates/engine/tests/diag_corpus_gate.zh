//! 门禁：诊断实跑反例语料的译文覆盖回归。
//!
//! 背景：消息表（errors.toml 的「消息翻译」节）覆盖哪些句子，静态检查永远看不全
//! ——只有把反例源码喂给真实 rustc 采集消息原文，才知道编译器今天会吐哪些话。
//! 本测试把这套「实跑采样」固化下来：
//!
//! - 语料 `data/diag-corpus.tsv` 由 `tools/diag-corpus/collect.py` 从
//!   `tools/diag-corpus/fixtures/*.rs` 采集生成（每行 `LEVEL\tCODE\t消息原文`）；
//!   rustc 新增/改动消息句子时，重跑采集器刷新语料即可暴露缺口。
//! - 审计判据 [`审计消息`] 与开发期 `diag_audit` 示例同源，渲染路径与
//!   `DiagnosticTranslator` 一致，这里报出的残留即用户在终端实际看到的文字。
//!
//! 只要有人删键、改坏通配段匹配、或补了等于没补（模板回落英文原文），
//! 本测试立刻在 `cargo test --workspace` 里失败，无需再靠手工实跑发现。
//!
//! 例外：`en` 是直通语言（rustc 原文即英文，无「消息翻译」节属预期），跳过。

使用 std::collections::HashSet;

使用 i18n_rust_engine::诊断::{审计消息, 错误翻译管理器};

/// 每行 `LEVEL\tCODE\t消息原文`（CODE 可为空）；裸行按 main/空码处理。
函数 解析语料(原文本: &文本) -> Vec<(字符串, 字符串, 字符串)> {
    让 可变 已见集 = HashSet::new();
    让 可变 条目列表 = Vec::new();
    对于 每行 in 原文本
        .lines()
        .map(文本::trim)
        .filter(|行项| !行项.is_empty() && !行项.starts_with('#'))
    {
        让 可变 分段迭代 = 每行.splitn(3, '\t');
        让 (级别串, 状态码, 消息文本) = 匹配 (分段迭代.next(), 分段迭代.next(), 分段迭代.next()) {
            (有值(甲), 有值(乙), 有值(丙)) => (甲, 乙, 丙),
            (有值(甲), 有值(丙), 无) => (甲, "", 丙),
            _ => ("main", "", 每行),
        };
        // 与 diag_audit 一致：按消息原文去重。
        如果 !已见集.insert(消息文本.to_string()) {
            continue;
        }
        条目列表.push((级别串.to_string(), 状态码.to_string(), 消息文本.to_string()));
    }
    条目列表
}

#[测试]
函数 诊断反例语料在全部内置语言包中译文无残留() {
    让 原文本 = include_str!("data/diag-corpus.tsv");
    让 语料 = 解析语料(原文本);
    断言!(
        语料.len() >= 50,
        "语料过少（{} 条），疑似采集或签入异常",
        语料.len()
    );

    让 可变 失败列表: Vec<字符串> = Vec::new();
    让 可变 已查语言数 = 0usize;
    对于 语言码 in i18n_rust_engine::语言::内置语言代码() {
        如果 语言码 == "en" {
            continue; // 直通语言，rustc 原文即英文，不查消息表
        }
        让 错误表内容 = i18n_rust_engine::语言::内置语言文件(语言码)
            .into_iter()
            .find(|(名, _)| *名 == "errors.toml")
            .map(|(_, 内容)| 内容)
            .unwrap_or_else(|| panic!("{语言码} 语言包缺少 errors.toml"));
        让 管理器 = 错误翻译管理器::从字符串载入(错误表内容)
            .unwrap_or_else(|错误值| panic!("{语言码}/errors.toml 解析失败：{错误值}"));
        已查语言数 += 1;
        对于 (级别串, 状态码, 消息文本) in &语料 {
            让 审计项 = 审计消息(&管理器, 级别串, 状态码, 消息文本);
            如果 !审计项.残留.is_empty() {
                失败列表.push(格式化!(
                    "[{语言码}] {级别串}/{状态码} 形态={} 残留={:?}\n    原文: {消息文本}\n    译文: {}",
                    审计项.种类, 审计项.残留, 审计项.渲染文本
                ));
            }
        }
    }

    断言!(
        已查语言数 >= 9,
        "应审计至少 9 个非 en 内置语言，实际 {已查语言数}"
    );
    断言!(
        失败列表.is_empty(),
        "诊断反例语料存在未译全的句子（{} 处，涉及 {} 个语言）：\n{}",
        失败列表.len(),
        已查语言数,
        失败列表.join("\n")
    );
}
