{
  "主函数": {
    "prefix": "主函数",
    "body": [
      "函数 主函数() {",
      "    $0",
      "}"
    ],
    "description": "main function entry"
  },
  "打印行": {
    "prefix": "打印行",
    "body": [
      "打印行!(${1:msg});"
    ],
    "description": "print a line of text"
  },
  "打印行fmt": {
    "prefix": "打印行fmt",
    "body": [
      "打印行!(\"${1:format}\", ${2:args});"
    ],
    "description": "print formatted text"
  },
  "让": {
    "prefix": "让",
    "body": [
      "让 ${1:name} = ${2:value};"
    ],
    "description": "declare an immutable binding"
  },
  "让可变": {
    "prefix": "让可变",
    "body": [
      "让 可变 ${1:name} = ${2:value};"
    ],
    "description": "declare a mutable binding"
  },
  "如果": {
    "prefix": "如果",
    "body": [
      "如果 ${1:cond} {",
      "    $0",
      "}"
    ],
    "description": "if statement"
  },
  "如果否则": {
    "prefix": "如果否则",
    "body": [
      "如果 ${1:cond} {",
      "    $2",
      "} 否则 {",
      "    $0",
      "}"
    ],
    "description": "if/else statement"
  },
  "对于": {
    "prefix": "对于",
    "body": [
      "对于 ${1:item} 在 ${2:iter} {",
      "    $0",
      "}"
    ],
    "description": "for loop"
  },
  "当": {
    "prefix": "当",
    "body": [
      "当 ${1:cond} {",
      "    $0",
      "}"
    ],
    "description": "while loop"
  },
  "循环": {
    "prefix": "循环",
    "body": [
      "循环 {",
      "    $0",
      "}"
    ],
    "description": "infinite loop"
  },
  "匹配": {
    "prefix": "匹配",
    "body": [
      "匹配 ${1:expr} {",
      "    ${2:pattern} => ${3:result},",
      "    $0",
      "}"
    ],
    "description": "match expression"
  },
  "结构体": {
    "prefix": "结构体",
    "body": [
      "结构体 ${1:Name} {",
      "    ${2:field}: ${3:Type},",
      "    $0",
      "}"
    ],
    "description": "struct definition"
  },
  "枚举": {
    "prefix": "枚举",
    "body": [
      "枚举 ${1:Name} {",
      "    ${2:Variant},",
      "    $0",
      "}"
    ],
    "description": "enum definition"
  },
  "特征": {
    "prefix": "特征",
    "body": [
      "特征 ${1:Name} {",
      "    函数 ${2:method}(${3:args}) -> ${4:Ret};",
      "    $0",
      "}"
    ],
    "description": "trait definition"
  },
  "实现": {
    "prefix": "实现",
    "body": [
      "实现 ${1:Type} {",
      "    函数 ${2:method}(${3:args}) -> ${4:Ret} {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "impl block"
  },
  "向量": {
    "prefix": "向量",
    "body": [
      "向量![${1:elem}]"
    ],
    "description": "create a vector"
  },
  "有值": {
    "prefix": "有值",
    "body": [
      "有值(${1:value})"
    ],
    "description": "Option::Some"
  },
  "无": {
    "prefix": "无",
    "body": [
      "无"
    ],
    "description": "Option::None"
  },
  "成功": {
    "prefix": "成功",
    "body": [
      "成功(${1:value})"
    ],
    "description": "Result::Ok"
  },
  "错误": {
    "prefix": "错误",
    "body": [
      "错误(${1:msg})"
    ],
    "description": "Result::Err"
  }
}
