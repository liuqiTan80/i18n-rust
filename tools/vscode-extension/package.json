{
  "name": "i18n-rust",
  "displayName": "i18n-rust - Write Rust in Any Language",
  "description": "Write Rust code in your native language, with support for syntax highlighting, intelligent code completion, and error hints.",
  "version": "0.9.0",
  "publisher": "i18n-rust",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liuqiTan80/i18n-rust"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Education"
  ],
  "keywords": [
    "rust",
    "chinese",
    "education",
    "i18n",
    "中文"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "onLanguage:rust-zh",
    "onLanguage:rust-ja",
    "onLanguage:rust-de",
    "onLanguage:rust-es",
    "onLanguage:rust-fr",
    "onLanguage:rust-pt",
    "onLanguage:rust-ru",
    "onLanguage:rust-ko",
    "onLanguage:rust-hi",
    "onLanguage:rust-ar",
    "workspaceContains:**/*.zh",
    "workspaceContains:**/*.ja",
    "workspaceContains:**/*.de",
    "workspaceContains:**/*.es",
    "workspaceContains:**/*.fr",
    "workspaceContains:**/*.pt",
    "workspaceContains:**/*.ru",
    "workspaceContains:**/*.ko",
    "workspaceContains:**/*.hi",
    "workspaceContains:**/*.ar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "rust-zh",
        "aliases": [ "%ext_lang_alias_zh_1%", "rust-zh", "%ext_lang_alias_zh_2%" ],
        "extensions": [ ".zh" ],
        "configuration": "./language-configuration.json",
        "icon": { "light": "images/icon.png", "dark": "images/icon.png" }
      },
      {
        "id": "rust-ja",
        "aliases": [ "%ext_lang_alias_ja_1%", "rust-ja" ],
        "extensions": [ ".ja" ],
        "configuration": "./language-configuration.json",
        "icon": { "light": "images/icon.png", "dark": "images/icon.png" }
      },
      {
        "id": "rust-de",
        "aliases": [ "Rust (Deutsch)", "rust-de" ],
        "extensions": [ ".de" ],
        "configuration": "./language-configuration.json",
        "icon": { "light": "images/icon.png", "dark": "images/icon.png" }
      },
      {
        "id": "rust-es",
        "aliases": [ "Rust (Español)", "rust-es" ],
        "extensions": [ ".es" ],
        "configuration": "./language-configuration.json",
        "icon": { "light": "images/icon.png", "dark": "images/icon.png" }
      },
      {
        "id": "rust-fr",
        "aliases": [ "Rust (Français)", "rust-fr" ],
        "extensions": [ ".fr" ],
        "configuration": "./language-configuration.json",
        "icon": { "light": "images/icon.png", "dark": "images/icon.png" }
      },
      {
        "id": "rust-pt",
        "aliases": [ "Rust (Português)", "rust-pt" ],
        "extensions": [ ".pt" ],
        "configuration": "./language-configuration.json",
        "icon": { "light": "images/icon.png", "dark": "images/icon.png" }
      },
      {
        "id": "rust-ru",
        "aliases": [ "Rust (Русский)", "rust-ru" ],
        "extensions": [ ".ru" ],
        "configuration": "./language-configuration.json",
        "icon": { "light": "images/icon.png", "dark": "images/icon.png" }
      },
      {
        "id": "rust-ko",
        "aliases": [ "Rust (한국어)", "rust-ko" ],
        "extensions": [ ".ko" ],
        "configuration": "./language-configuration.json",
        "icon": { "light": "images/icon.png", "dark": "images/icon.png" }
      },
      {
        "id": "rust-hi",
        "aliases": [ "Rust (हिन्दी)", "rust-hi" ],
        "extensions": [ ".hi" ],
        "configuration": "./language-configuration.json",
        "icon": { "light": "images/icon.png", "dark": "images/icon.png" }
      },
      {
        "id": "rust-ar",
        "aliases": [ "Rust (العربية)", "rust-ar" ],
        "extensions": [ ".ar" ],
        "configuration": "./language-configuration.json",
        "icon": { "light": "images/icon.png", "dark": "images/icon.png" }
      }
    ],
    "grammars": [
      { "language": "rust-zh", "scopeName": "source.rust-zh", "path": "./syntaxes/rust-zh.tmLanguage.json" },
      { "language": "rust-ja", "scopeName": "source.rust-ja", "path": "./syntaxes/rust-ja.tmLanguage.json" },
      { "language": "rust-de", "scopeName": "source.rust-de", "path": "./syntaxes/rust-de.tmLanguage.json" },
      { "language": "rust-es", "scopeName": "source.rust-es", "path": "./syntaxes/rust-es.tmLanguage.json" },
      { "language": "rust-fr", "scopeName": "source.rust-fr", "path": "./syntaxes/rust-fr.tmLanguage.json" },
      { "language": "rust-pt", "scopeName": "source.rust-pt", "path": "./syntaxes/rust-pt.tmLanguage.json" },
      { "language": "rust-ru", "scopeName": "source.rust-ru", "path": "./syntaxes/rust-ru.tmLanguage.json" },
      { "language": "rust-ko", "scopeName": "source.rust-ko", "path": "./syntaxes/rust-ko.tmLanguage.json" },
      { "language": "rust-hi", "scopeName": "source.rust-hi", "path": "./syntaxes/rust-hi.tmLanguage.json" },
      { "language": "rust-ar", "scopeName": "source.rust-ar", "path": "./syntaxes/rust-ar.tmLanguage.json" }
    ],
    "commands": [
      {
        "command": "i18n-rust.run",
        "category": "i18n",
        "title": "%ext_cmd_run%",
        "icon": "$(play)"
      },
      {
        "command": "i18n-rust.check",
        "category": "i18n",
        "title": "%ext_cmd_check%",
        "icon": "$(check)"
      },
      {
        "command": "i18n-rust.eject",
        "category": "i18n",
        "title": "%ext_cmd_eject%",
        "icon": "$(export)"
      },
      {
        "command": "i18n-rust.transpilePreview",
        "category": "i18n",
        "title": "%ext_cmd_transpile_preview%",
        "icon": "$(diff)"
      },
      {
        "command": "i18n-rust.selectLanguagePack",
        "category": "i18n",
        "title": "%ext_cmd_select_lang_pack%",
        "icon": "$(globe)"
      },
      {
        "command": "i18n-rust.restartServer",
        "category": "i18n",
        "title": "%ext_cmd_restart_server%",
        "icon": "$(refresh)"
      },
      {
        "command": "i18n-rust.aiChat",
        "category": "i18n",
        "title": "%ext_cmd_ai_chat%",
        "icon": "$(sparkle)"
      },
      {
        "command": "i18n-rust.aiGenerate",
        "category": "i18n",
        "title": "%ext_cmd_ai_generate%",
        "icon": "$(wand)"
      },
      {
        "command": "i18n-rust.aiSelectProvider",
        "category": "i18n",
        "title": "%ext_cmd_ai_select_provider%",
        "icon": "$(account)"
      },
      {
        "command": "i18n-rust.aiListModels",
        "category": "i18n",
        "title": "%ext_cmd_ai_list_models%",
        "icon": "$(list-ordered)"
      },
      {
        "command": "i18n-rust.explainDiagnostic",
        "category": "i18n",
        "title": "%ext_cmd_explain_diagnostic%",
        "icon": "$(lightbulb)"
      },
      {
        "command": "i18n-rust.mappingCheck",
        "category": "i18n",
        "title": "%ext_cmd_mapping_check%"
      },
      {
        "command": "i18n-rust.mappingScaffold",
        "category": "i18n",
        "title": "%ext_cmd_mapping_scaffold%"
      },
      {
        "command": "i18n-rust.langInstall",
        "category": "i18n",
        "title": "%ext_cmd_lang_install%"
      },
      {
        "command": "i18n-rust.cargoAdd",
        "category": "i18n",
        "title": "%ext_cmd_cargo_add%",
        "icon": "$(package)"
      },
      {
        "command": "i18n-rust.toggleGeneratedFiles",
        "category": "i18n",
        "title": "%ext_cmd_toggle_generated_files%",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == rust-zh || resourceLangId == rust-ja || resourceLangId == rust-de || resourceLangId == rust-es || resourceLangId == rust-fr || resourceLangId == rust-pt || resourceLangId == rust-ru || resourceLangId == rust-ko || resourceLangId == rust-hi || resourceLangId == rust-ar",
          "command": "i18n-rust.run",
          "group": "navigation@1"
        },
        {
          "when": "resourceLangId == rust-zh || resourceLangId == rust-ja || resourceLangId == rust-de || resourceLangId == rust-es || resourceLangId == rust-fr || resourceLangId == rust-pt || resourceLangId == rust-ru || resourceLangId == rust-ko || resourceLangId == rust-hi || resourceLangId == rust-ar",
          "command": "i18n-rust.check",
          "group": "navigation@2"
        },
        {
          "when": "resourceLangId == rust-zh || resourceLangId == rust-ja || resourceLangId == rust-de || resourceLangId == rust-es || resourceLangId == rust-fr || resourceLangId == rust-pt || resourceLangId == rust-ru || resourceLangId == rust-ko || resourceLangId == rust-hi || resourceLangId == rust-ar",
          "command": "i18n-rust.transpilePreview",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "when": "resourceLangId == rust-zh || resourceLangId == rust-ja || resourceLangId == rust-de || resourceLangId == rust-es || resourceLangId == rust-fr || resourceLangId == rust-pt || resourceLangId == rust-ru || resourceLangId == rust-ko || resourceLangId == rust-hi || resourceLangId == rust-ar",
          "command": "i18n-rust.run",
          "group": "i18n@1"
        },
        {
          "when": "resourceLangId == rust-zh || resourceLangId == rust-ja || resourceLangId == rust-de || resourceLangId == rust-es || resourceLangId == rust-fr || resourceLangId == rust-pt || resourceLangId == rust-ru || resourceLangId == rust-ko || resourceLangId == rust-hi || resourceLangId == rust-ar",
          "command": "i18n-rust.check",
          "group": "i18n@2"
        },
        {
          "when": "resourceLangId == rust-zh || resourceLangId == rust-ja || resourceLangId == rust-de || resourceLangId == rust-es || resourceLangId == rust-fr || resourceLangId == rust-pt || resourceLangId == rust-ru || resourceLangId == rust-ko || resourceLangId == rust-hi || resourceLangId == rust-ar",
          "command": "i18n-rust.eject",
          "group": "i18n@3"
        },
        {
          "when": "resourceLangId == rust-zh || resourceLangId == rust-ja || resourceLangId == rust-de || resourceLangId == rust-es || resourceLangId == rust-fr || resourceLangId == rust-pt || resourceLangId == rust-ru || resourceLangId == rust-ko || resourceLangId == rust-hi || resourceLangId == rust-ar",
          "command": "i18n-rust.transpilePreview",
          "group": "i18n@3.5"
        },
        {
          "when": "resourceLangId == rust-zh || resourceLangId == rust-ja || resourceLangId == rust-de || resourceLangId == rust-es || resourceLangId == rust-fr || resourceLangId == rust-pt || resourceLangId == rust-ru || resourceLangId == rust-ko || resourceLangId == rust-hi || resourceLangId == rust-ar",
          "command": "i18n-rust.aiChat",
          "group": "i18n@4"
        },
        {
          "when": "resourceLangId == rust-zh || resourceLangId == rust-ja || resourceLangId == rust-de || resourceLangId == rust-es || resourceLangId == rust-fr || resourceLangId == rust-pt || resourceLangId == rust-ru || resourceLangId == rust-ko || resourceLangId == rust-hi || resourceLangId == rust-ar",
          "command": "i18n-rust.explainDiagnostic",
          "group": "i18n@5"
        }
      ]
    },
    "keybindings": [
      {
        "command": "i18n-rust.run",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "resourceLangId == rust-zh || resourceLangId == rust-ja || resourceLangId == rust-de || resourceLangId == rust-es || resourceLangId == rust-fr || resourceLangId == rust-pt || resourceLangId == rust-ru || resourceLangId == rust-ko || resourceLangId == rust-hi || resourceLangId == rust-ar"
      },
      {
        "command": "i18n-rust.check",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "resourceLangId == rust-zh || resourceLangId == rust-ja || resourceLangId == rust-de || resourceLangId == rust-es || resourceLangId == rust-fr || resourceLangId == rust-pt || resourceLangId == rust-ru || resourceLangId == rust-ko || resourceLangId == rust-hi || resourceLangId == rust-ar"
      }
    ],
    "configuration": {
      "title": "i18n-rust",
      "properties": {
        "i18n-rust.serverPath": {
          "type": "string",
          "default": "i18n-rust-lsp",
          "description": "%ext_cfg_server_path%"
        },
        "i18n-rust.rzcPath": {
          "type": "string",
          "default": "rzc",
          "description": "%ext_cfg_rzc_path%"
        },
        "i18n-rust.languagePack": {
          "type": "string",
          "enum": [
            "中文",
            "日本語",
            "Deutsch",
            "Español",
            "Français",
            "Português",
            "Русский",
            "한국어",
            "हिन्दी",
            "العربية"
          ],
          "default": "中文",
          "description": "%ext_cfg_language_pack%"
        },
        "i18n-rust.languagePackPath": {
          "type": "string",
          "default": "",
          "description": "%ext_cfg_language_pack_path%"
        },
        "i18n-rust.autoConvertFullWidthSymbols": {
          "type": "boolean",
          "default": true,
          "description": "%ext_cfg_auto_convert_fullwidth%"
        },
        "i18n-rust.checkUpdates": {
          "type": "boolean",
          "default": true,
          "description": "%ext_cfg_check_updates%"
        },
        "i18n-rust.hideGeneratedFiles": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%ext_cfg_hide_generated%"
        },
        "i18n-rust.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "%ext_cfg_trace_server%"
        },
        "i18n-rust.ai.provider": {
          "type": "string",
          "enum": [
            "openai",
            "deepseek",
            "qwen",
            "glm",
            "ollama",
            "anthropic",
            "gemini",
            "custom"
          ],
          "default": "openai",
          "scope": "application",
          "description": "%ext_cfg_ai_provider%"
        },
        "i18n-rust.ai.apiKey": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%ext_cfg_ai_api_key%",
          "markdownDescription": "%ext_cfg_ai_api_key%",
          "deprecationMessage": "%ext_cfg_ai_api_key_deprecation%"
        },
        "i18n-rust.ai.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%ext_cfg_ai_base_url%"
        },
        "i18n-rust.ai.model": {
          "type": "string",
          "default": "",
          "description": "%ext_cfg_ai_model%"
        },
        "i18n-rust.ai.temperature": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 2,
          "description": "%ext_cfg_ai_temperature%"
        },
        "i18n-rust.ai.maxTokens": {
          "type": "number",
          "default": 2048,
          "minimum": 1,
          "description": "%ext_cfg_ai_max_tokens%"
        },
        "i18n-rust.ai.systemPrompt": {
          "type": "string",
          "default": "",
          "description": "%ext_cfg_ai_system_prompt%",
          "markdownDescription": "%ext_cfg_ai_system_prompt%"
        },
        "i18n-rust.ai.timeout": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "description": "%ext_cfg_ai_timeout%"
        }
      }
    },
    "problemMatchers": [
      {
        "name": "i18n-rust",
        "owner": "i18n-rust",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(error|warning|note):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "snippets": [
      { "language": "rust-zh", "path": "./snippets/rust-zh.json" },
      { "language": "rust-ja", "path": "./snippets/rust-ja.json" },
      { "language": "rust-de", "path": "./snippets/rust-de.json" },
      { "language": "rust-es", "path": "./snippets/rust-es.json" },
      { "language": "rust-fr", "path": "./snippets/rust-fr.json" },
      { "language": "rust-pt", "path": "./snippets/rust-pt.json" },
      { "language": "rust-ru", "path": "./snippets/rust-ru.json" },
      { "language": "rust-ko", "path": "./snippets/rust-ko.json" },
      { "language": "rust-hi", "path": "./snippets/rust-hi.json" },
      { "language": "rust-ar", "path": "./snippets/rust-ar.json" }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run gen:all && npm run esbuild:min",
    "gen:grammars": "node scripts/gen-grammars.mjs",
    "gen:snippets": "node scripts/gen-snippets.mjs",
    "gen:ui": "node scripts/gen-ui-strings.mjs",
    "gen:nls": "node scripts/gen-nls.mjs",
    "gen:all": "npm run gen:grammars && npm run gen:snippets && npm run gen:ui && npm run gen:nls",
    "esbuild": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "esbuild:min": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "build": "npm run gen:all && npm run compile && npm run esbuild",
    "compile": "tsc -p ./",
    "typecheck": "tsc -noEmit -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test out/test/*.test.js",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2",
    "@vscode/vsce": "^2.22.0",
    "vscode-languageclient": "^9.0.1"
  }
}
