{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rust (Português)",
  "scopeName": "source.rust-pt",
  "patterns": [
    {
      "include": "#注释"
    },
    {
      "include": "#字符串"
    },
    {
      "include": "#字符"
    },
    {
      "include": "#数字"
    },
    {
      "include": "#关键字"
    },
    {
      "include": "#类型"
    },
    {
      "include": "#宏"
    },
    {
      "include": "#生命周期"
    },
    {
      "include": "#运算符"
    }
  ],
  "repository": {
    "注释": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rust-pt",
          "match": "//.*$"
        },
        {
          "name": "comment.block.documentation.rust-pt",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#注释"
            }
          ]
        },
        {
          "name": "comment.block.rust-pt",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#注释"
            }
          ]
        }
      ]
    },
    "字符串": {
      "patterns": [
        {
          "name": "string.quoted.double.rust-pt",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rust-pt",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.raw.rust-pt",
          "begin": "r#*\"",
          "end": "\"#*"
        }
      ]
    },
    "字符": {
      "patterns": [
        {
          "name": "string.quoted.single.rust-pt",
          "match": "'[^'\\\\]'|'\\\\.'"
        }
      ]
    },
    "数字": {
      "patterns": [
        {
          "name": "constant.numeric.rust-pt",
          "match": "\\b[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?(f32|f64|i[0-9]+|u[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.rust-pt",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.oct.rust-pt",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.bin.rust-pt",
          "match": "\\b0b[01_]+\\b"
        }
      ]
    },
    "关键字": {
      "patterns": [
        {
          "name": "keyword.control.rust-pt",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(corresponder|while let|continuar|enquanto|retornar|quebrar|if let|senao|laco|para|se|em)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "keyword.declaration.rust-pt",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(implementacao|enumeracao|constante|estrutura|principal|estatico|superior|mutavel|publico|externo|derive|funcao|deixar|modulo|pacote|trait|tipo|usar|como)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "keyword.other.rust-pt",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(referencia_mutavel|desreferencia|referencia|assincrono|inseguro|aguardar|dinamico|mover|caixa|ref)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "constant.language.boolean.rust-pt",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(verdadeiro|falso)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "constant.language.rust-pt",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(vazio|mesmo|Mesmo)(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "类型": {
      "patterns": [
        {
          "name": "storage.type.numeric.rust-pt",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(flutuante_curto|inteiro_longo|inteiro_curto|inteiro_micro|natural_longo|natural_curto|natural_micro|flutuante|inteiro|natural|byte)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "storage.type.rust-pt",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(referencia_cadeia|caractere|resultado|booleano|cadeia|where|texto|vetor|opcao|caixa|mapa)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "constant.other.rust-pt",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(sucesso|nenhum|algum|erro)(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "宏": {
      "patterns": [
        {
          "name": "entity.name.function.macro.rust-pt",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(debug_assert_matches|imprimir_erro_linha|afirmar_diferente|nao_implementado|debug_assert_eq|assert_matches|imprimir_linha|escrever_linha|incluir_cadeia|opcao_ambiente|compile_error|imprimir_erro|afirmar_igual|incluir_bytes|debug_assert|inalcancavel|macro_rules|textualizar|cfg_select|imprimir|pendente|escrever|ambiente|formato|afirmar|incluir|arquivo|panico|coluna|config|macro|vetor|linha)!"
        }
      ]
    },
    "生命周期": {
      "patterns": [
        {
          "name": "storage.modifier.lifetime.rust-pt",
          "match": "'[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "运算符": {
      "patterns": [
        {
          "name": "keyword.operator.rust-pt",
          "match": "(=|\\+|-|\\*|/|%|&&|\\|\\||!|<|>|<=|>=|==|!=|&|\\||\\^|~|<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
        },
        {
          "name": "keyword.operator.arrow.rust-pt",
          "match": "(->|=>)"
        }
      ]
    }
  }
}
