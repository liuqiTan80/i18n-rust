{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rust (Español)",
  "scopeName": "source.rust-es",
  "patterns": [
    {
      "include": "#注释"
    },
    {
      "include": "#字符串"
    },
    {
      "include": "#字符"
    },
    {
      "include": "#数字"
    },
    {
      "include": "#关键字"
    },
    {
      "include": "#类型"
    },
    {
      "include": "#宏"
    },
    {
      "include": "#生命周期"
    },
    {
      "include": "#运算符"
    }
  ],
  "repository": {
    "注释": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rust-es",
          "match": "//.*$"
        },
        {
          "name": "comment.block.documentation.rust-es",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#注释"
            }
          ]
        },
        {
          "name": "comment.block.rust-es",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#注释"
            }
          ]
        }
      ]
    },
    "字符串": {
      "patterns": [
        {
          "name": "string.quoted.double.rust-es",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rust-es",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.raw.rust-es",
          "begin": "r#*\"",
          "end": "\"#*"
        }
      ]
    },
    "字符": {
      "patterns": [
        {
          "name": "string.quoted.single.rust-es",
          "match": "'[^'\\\\]'|'\\\\.'"
        }
      ]
    },
    "数字": {
      "patterns": [
        {
          "name": "constant.numeric.rust-es",
          "match": "\\b[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?(f32|f64|i[0-9]+|u[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.rust-es",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.oct.rust-es",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.bin.rust-es",
          "match": "\\b0b[01_]+\\b"
        }
      ]
    },
    "关键字": {
      "patterns": [
        {
          "name": "keyword.control.rust-es",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(while let|coincidir|continuar|mientras|devolver|if let|romper|bucle|sino|para|si|en)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "keyword.declaration.rust-es",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(implementacion|enumeracion|estructura|constante|principal|estatico|superior|funcion|mutable|publico|paquete|externo|derive|modulo|dejar|rasgo|tipo|usar|como)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "keyword.other.rust-es",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(referencia_mutable|desreferencia|referencia|asincrono|inseguro|dinamico|esperar|mover|caja|ref)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "constant.language.boolean.rust-es",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(verdadero|falso)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "constant.language.rust-es",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(vacio|mismo|Mismo)(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "类型": {
      "patterns": [
        {
          "name": "storage.type.numeric.rust-es",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(flotante_corto|natural_largo|natural_corto|natural_micro|entero_largo|entero_corto|entero_micro|flotante|natural|entero|byte)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "storage.type.rust-es",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(referencia_cadena|resultado|caracter|booleano|cadena|vector|opcion|where|texto|mapa|caja)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "constant.other.rust-es",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(ninguno|alguno|exito|error)(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "宏": {
      "patterns": [
        {
          "name": "entity.name.function.macro.rust-es",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(debug_assert_matches|imprimir_error_linea|afirmar_distinto|debug_assert_eq|no_implementado|assert_matches|imprimir_linea|imprimir_error|escribir_linea|incluir_cadena|opcion_entorno|compile_error|afirmar_igual|incluir_bytes|debug_assert|inalcanzable|macro_rules|textualizar|cfg_select|pendiente|imprimir|escribir|formato|afirmar|incluir|columna|archivo|entorno|panico|vector|config|macro|linea)!"
        }
      ]
    },
    "生命周期": {
      "patterns": [
        {
          "name": "storage.modifier.lifetime.rust-es",
          "match": "'[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "运算符": {
      "patterns": [
        {
          "name": "keyword.operator.rust-es",
          "match": "(=|\\+|-|\\*|/|%|&&|\\|\\||!|<|>|<=|>=|==|!=|&|\\||\\^|~|<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
        },
        {
          "name": "keyword.operator.arrow.rust-es",
          "match": "(->|=>)"
        }
      ]
    }
  }
}
