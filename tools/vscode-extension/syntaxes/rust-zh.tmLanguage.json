{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rust (中文)",
  "scopeName": "source.rust-zh",
  "patterns": [
    {
      "include": "#注释"
    },
    {
      "include": "#字符串"
    },
    {
      "include": "#字符"
    },
    {
      "include": "#数字"
    },
    {
      "include": "#关键字"
    },
    {
      "include": "#类型"
    },
    {
      "include": "#宏"
    },
    {
      "include": "#生命周期"
    },
    {
      "include": "#运算符"
    }
  ],
  "repository": {
    "注释": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rust-zh",
          "match": "//.*$"
        },
        {
          "name": "comment.block.documentation.rust-zh",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#注释"
            }
          ]
        },
        {
          "name": "comment.block.rust-zh",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#注释"
            }
          ]
        }
      ]
    },
    "字符串": {
      "patterns": [
        {
          "name": "string.quoted.double.rust-zh",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rust-zh",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.raw.rust-zh",
          "begin": "r#*\"",
          "end": "\"#*"
        }
      ]
    },
    "字符": {
      "patterns": [
        {
          "name": "string.quoted.single.rust-zh",
          "match": "'[^'\\\\]'|'\\\\.'"
        }
      ]
    },
    "数字": {
      "patterns": [
        {
          "name": "constant.numeric.rust-zh",
          "match": "\\b[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?(f32|f64|i[0-9]+|u[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.rust-zh",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.oct.rust-zh",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.bin.rust-zh",
          "match": "\\b0b[01_]+\\b"
        }
      ]
    },
    "关键字": {
      "patterns": [
        {
          "name": "keyword.control.rust-zh",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(如果让|如果|否则|匹配|循环|当让|对于|中断|继续|返回|当|在)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "keyword.declaration.rust-zh",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(结构体|主函数|函数|可变|常量|静态|枚举|类型|特征|实现|模块|公开|超级|外部|使用|作为|派生|让|包)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "keyword.other.rust-zh",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(可变引用|引用绑定|解引用|不安全|引用|移动|盒子|异步|等待|动态)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "constant.language.boolean.rust-zh",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(真|假)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "constant.language.rust-zh",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(自我|自身|空)(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "类型": {
      "patterns": [
        {
          "name": "storage.type.numeric.rust-zh",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(无符号长整数|无符号短整数|无符号微整数|单精度浮点数|无符号整数|长整数|短整数|微整数|浮点数|整数|字节)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "storage.type.rust-zh",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(字符串引用|哈希映射|字符串|文本|字符|布尔|向量|选项|结果|盒子|哪里)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "constant.other.rust-zh",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(有些|成功|错误|无)(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "宏": {
      "patterns": [
        {
          "name": "entity.name.function.macro.rust-zh",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(调试断言相等|调试断言匹配|写入格式化行|错误打印行|写入格式化|包含字符串|错误打印|断言相等|断言不等|断言匹配|调试断言|配置选择|编译错误|包含文件|包含字节|字符串化|编译环境|选项环境|格式化|打印行|未实现|待完成|不可达|宏规则|打印|断言|恐慌|向量|文件|配置|列|行|宏)!"
        }
      ]
    },
    "生命周期": {
      "patterns": [
        {
          "name": "storage.modifier.lifetime.rust-zh",
          "match": "'[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "运算符": {
      "patterns": [
        {
          "name": "keyword.operator.rust-zh",
          "match": "(=|\\+|-|\\*|/|%|&&|\\|\\||!|<|>|<=|>=|==|!=|&|\\||\\^|~|<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
        },
        {
          "name": "keyword.operator.arrow.rust-zh",
          "match": "(->|=>)"
        }
      ]
    }
  }
}
