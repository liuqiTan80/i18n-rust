{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rust (العربية)",
  "scopeName": "source.rust-ar",
  "patterns": [
    {
      "include": "#注释"
    },
    {
      "include": "#字符串"
    },
    {
      "include": "#字符"
    },
    {
      "include": "#数字"
    },
    {
      "include": "#关键字"
    },
    {
      "include": "#类型"
    },
    {
      "include": "#宏"
    },
    {
      "include": "#生命周期"
    },
    {
      "include": "#运算符"
    }
  ],
  "repository": {
    "注释": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rust-ar",
          "match": "//.*$"
        },
        {
          "name": "comment.block.documentation.rust-ar",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#注释"
            }
          ]
        },
        {
          "name": "comment.block.rust-ar",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#注释"
            }
          ]
        }
      ]
    },
    "字符串": {
      "patterns": [
        {
          "name": "string.quoted.double.rust-ar",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rust-ar",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.raw.rust-ar",
          "begin": "r#*\"",
          "end": "\"#*"
        }
      ]
    },
    "字符": {
      "patterns": [
        {
          "name": "string.quoted.single.rust-ar",
          "match": "'[^'\\\\]'|'\\\\.'"
        }
      ]
    },
    "数字": {
      "patterns": [
        {
          "name": "constant.numeric.rust-ar",
          "match": "\\b[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?(f32|f64|i[0-9]+|u[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.rust-ar",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.oct.rust-ar",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.bin.rust-ar",
          "match": "\\b0b[01_]+\\b"
        }
      ]
    },
    "关键字": {
      "patterns": [
        {
          "name": "keyword.control.rust-ar",
          "match": "\\b(بينما|وإلا|طابق|حلقة|اكسر|تابع|إذا|لكل|أعد|في)\\b"
        },
        {
          "name": "keyword.declaration.rust-ar",
          "match": "\\b(استاتيكي|استخدم|متغير|تعداد|تنفيذ|صندوق|خارجي|رئيسي|دالة|ثابت|هيكل|وحدة|نوع|سمة|عام|فوق|دع|كـ)\\b"
        },
        {
          "name": "keyword.other.rust-ar",
          "match": "\\b(إلغاء_المرجع|مرجع_متغير|غير_متزامن|ديناميكي|غير_آمن|انتظر|مرجع|انقل|علبة)\\b"
        },
        {
          "name": "constant.language.boolean.rust-ar",
          "match": "\\b(حقيقي|خاطئ)\\b"
        },
        {
          "name": "constant.language.rust-ar",
          "match": "\\b(الذات|فارغ|نفسه)\\b"
        }
      ]
    },
    "类型": {
      "patterns": [
        {
          "name": "storage.type.numeric.rust-ar",
          "match": "\\b(طبيعي_طويل|طبيعي_قصير|طبيعي_مصغر|صحيح_طويل|صحيح_قصير|صحيح_مصغر|عائم_قصير|طبيعي|صحيح|عائم|بايت)\\b"
        },
        {
          "name": "storage.type.rust-ar",
          "match": "\\b(مرجع_سلسلة|مصفوفة|منطقي|سلسلة|قاموس|نتيجة|خيار|علبة|حرف|نص)\\b"
        },
        {
          "name": "constant.other.rust-ar",
          "match": "\\b(لا_شيء|نجاح|بعض|خطأ)\\b"
        }
      ]
    },
    "宏": {
      "patterns": [
        {
          "name": "entity.name.function.macro.rust-ar",
          "match": "\\b(لا_يمكن_الوصول|اطبع_خطأ_سطرا|أدرج_بايتات|أكد_اختلاف|اطبع_سطرا|أكد_تساوي|اكتب_سطرا|خيار_بيئة|اطبع_خطأ|غير_منفذ|أدرج_نصا|مصفوفة|لاحقا|إعداد|صيغة|اطبع|اكتب|أدرج|عمود|بيئة|أكد|ذعر|نصي|ملف|سطر)!"
        }
      ]
    },
    "生命周期": {
      "patterns": [
        {
          "name": "storage.modifier.lifetime.rust-ar",
          "match": "'[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "运算符": {
      "patterns": [
        {
          "name": "keyword.operator.rust-ar",
          "match": "(=|\\+|-|\\*|/|%|&&|\\|\\||!|<|>|<=|>=|==|!=|&|\\||\\^|~|<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
        },
        {
          "name": "keyword.operator.arrow.rust-ar",
          "match": "(->|=>)"
        }
      ]
    }
  }
}
