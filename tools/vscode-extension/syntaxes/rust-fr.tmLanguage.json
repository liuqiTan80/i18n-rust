{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rust (Français)",
  "scopeName": "source.rust-fr",
  "patterns": [
    {
      "include": "#注释"
    },
    {
      "include": "#字符串"
    },
    {
      "include": "#字符"
    },
    {
      "include": "#数字"
    },
    {
      "include": "#关键字"
    },
    {
      "include": "#类型"
    },
    {
      "include": "#宏"
    },
    {
      "include": "#生命周期"
    },
    {
      "include": "#运算符"
    }
  ],
  "repository": {
    "注释": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rust-fr",
          "match": "//.*$"
        },
        {
          "name": "comment.block.documentation.rust-fr",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#注释"
            }
          ]
        },
        {
          "name": "comment.block.rust-fr",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#注释"
            }
          ]
        }
      ]
    },
    "字符串": {
      "patterns": [
        {
          "name": "string.quoted.double.rust-fr",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rust-fr",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.raw.rust-fr",
          "begin": "r#*\"",
          "end": "\"#*"
        }
      ]
    },
    "字符": {
      "patterns": [
        {
          "name": "string.quoted.single.rust-fr",
          "match": "'[^'\\\\]'|'\\\\.'"
        }
      ]
    },
    "数字": {
      "patterns": [
        {
          "name": "constant.numeric.rust-fr",
          "match": "\\b[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?(f32|f64|i[0-9]+|u[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.rust-fr",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.oct.rust-fr",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.bin.rust-fr",
          "match": "\\b0b[01_]+\\b"
        }
      ]
    },
    "关键字": {
      "patterns": [
        {
          "name": "keyword.control.rust-fr",
          "match": "\\b(correspondre|continuer|retourner|tant_que|boucle|rompre|sinon|pour|dans|si)\\b"
        },
        {
          "name": "keyword.declaration.rust-fr",
          "match": "\\b(implementation|enumeration|principale|constante|structure|fonction|statique|publique|utiliser|laisser|mutable|externe|module|caisse|trait|super|comme|type)\\b"
        },
        {
          "name": "keyword.other.rust-fr",
          "match": "\\b(reference_mutable|dereference|asynchrone|reference|dangereux|dynamique|deplacer|attendre|boite)\\b"
        },
        {
          "name": "constant.language.boolean.rust-fr",
          "match": "\\b(vrai|faux)\\b"
        },
        {
          "name": "constant.language.rust-fr",
          "match": "\\b(vide|soi|Soi)\\b"
        }
      ]
    },
    "类型": {
      "patterns": [
        {
          "name": "storage.type.numeric.rust-fr",
          "match": "\\b(flottant_court|naturel_court|naturel_micro|entier_court|entier_micro|naturel_long|entier_long|flottant|naturel|entier|octet)\\b"
        },
        {
          "name": "storage.type.rust-fr",
          "match": "\\b(reference_chaine|dictionnaire|caractere|resultat|booleen|vecteur|chaine|option|texte|boite)\\b"
        },
        {
          "name": "constant.other.rust-fr",
          "match": "\\b(certain|succes|erreur|aucun)\\b"
        }
      ]
    },
    "宏": {
      "patterns": [
        {
          "name": "entity.name.function.macro.rust-fr",
          "match": "\\b(afficher_erreur_ligne|option_environnement|affirmer_different|afficher_erreur|afficher_ligne|non_implemente|inclure_chaine|inclure_octets|affirmer_egal|environnement|inaccessible|ecrire_ligne|textualiser|plus_tard|afficher|affirmer|panique|vecteur|inclure|colonne|fichier|format|ecrire|config|ligne)!"
        }
      ]
    },
    "生命周期": {
      "patterns": [
        {
          "name": "storage.modifier.lifetime.rust-fr",
          "match": "'[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "运算符": {
      "patterns": [
        {
          "name": "keyword.operator.rust-fr",
          "match": "(=|\\+|-|\\*|/|%|&&|\\|\\||!|<|>|<=|>=|==|!=|&|\\||\\^|~|<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
        },
        {
          "name": "keyword.operator.arrow.rust-fr",
          "match": "(->|=>)"
        }
      ]
    }
  }
}
