// 模块路径替换：真实后端见 crates/engine/src/module_path.rs，本文件是它的方言改写演示

使用 标准库::集合::哈希映射; // 这一行转译后就是标准库的哈希映射路径
使用 词法解析器::{切分令牌, 令牌种类};

/// 单阶段替换结果：输出与编辑表
结构体 替换结果 {
    输出: 字符串,
    编辑表: 向量<源码映射项>,
}

/// 源码映射项：记录一次替换的位置与前后文本
结构体 源码映射项 {
    来源偏移: 无符号机器整数,
    字节数: 无符号机器整数,
    原文: 字符串,
    译文: 字符串,
}

实现 源码映射项 {
    // 构造方法写中文名：声明位与 `源码映射项::新建` 调用位同属本项目的声明集合，
    // 两侧一起保留中文，产物自洽可编译（不必退回英文原名）
    函数 新建(
        来源偏移: 无符号机器整数,
        字节数: 无符号机器整数,
        原文: 字符串引用,
        译文: 字符串引用,
    ) -> 自身 {
        自身 {
            来源偏移,
            字节数,
            原文: 原文.转字符串(),
            译文: 译文.转字符串(),
        }
    }
}

/// 替换使用语句里的中文模块路径段（真实函数是后端的那张带编辑表版本）
函数 替换模块路径带表(源码文本: 字符串引用, 路径映射表: 哈希映射<字符串, 字符串>) -> 替换结果 {
    如果 路径映射表.是否为空() {
        返回 替换结果 { 输出: 字符串::从(源码文本), 编辑表: 向量::新建() };
    }
    让 令牌们: 向量<_> = 切分令牌(源码文本).收集();
    让 可变 输出 = 字符串::新建();
    让 可变 编辑表 = 向量::新建();
    让 可变 当前偏移 = 0;
    // 使用语句内的路径段才启用模块路径映射；表达式中的
    // `类型::关联函数`（如 引用计数::新建）留给别名映射处理
    让 可变 处于使用语句 = 假;

    对于 令牌 在 令牌们.迭代() {
        让 令牌长 = 令牌.长度;
        让 令牌文本 = &源码文本[当前偏移..当前偏移 + 令牌长];
        匹配 令牌.令牌类别 {
            令牌种类::标识符记号 => {
                // 使用语句内所有路径段（含末段/单段）都查映射：
                // 使用 中不可能出现用户变量，替换安全；
                // 末段若不在路径映射（如 `服务器` 属于标识符别名），
                // 保持原样交给别名替换处理
                如果 处于使用语句 {
                    如果让 有值(英语) = 路径映射表.获取(令牌文本) {
                        编辑表.推入(源码映射项::新建(当前偏移, 令牌长, 令牌文本, 英语));
                        输出.推入字符串(英语);
                    } 否则 {
                        输出.推入字符串(令牌文本);
                    }
                } 否则 {
                    输出.推入字符串(令牌文本);
                }
                // 检测使用语句起点（方言的 `使用` 在词法阶段已换成
                // 英文原名，于是两种写法都能识别）
                如果 令牌文本 == "use" || 令牌文本 == "使用" {
                    处于使用语句 = 真;
                }
            }
            令牌种类::分号 => {
                // 使用语句以分号结束
                处于使用语句 = 假;
                输出.推入字符串(令牌文本);
            }
            _ => 输出.推入字符串(令牌文本),
        }
        当前偏移 += 令牌长;
    }
    替换结果 { 输出, 编辑表 }
}

/// 演示：替换一段包含中英文混用的使用语句
函数 主函数() {
    让 可变 映射表 = 哈希映射::新建();
    映射表.插入(字符串::从("标准集合"), 字符串::从("std::collections"));
    映射表.插入(字符串::从("文件系统"), 字符串::从("std::fs"));
    让 最终结果 = 替换模块路径带表(
        "使用 标准集合::哈希映射; 使用 文件系统;",
        映射表,
    );
    打印行!("{}", 最终结果.输出);
    打印行!("编辑表共 {} 条", 最终结果.编辑表.长度());
    对于 编辑 在 最终结果.编辑表.迭代() {
        打印行!("  [{}..{}] {} → {}", 编辑.来源偏移, 编辑.字节数, 编辑.原文, 编辑.译文);
    }
}
