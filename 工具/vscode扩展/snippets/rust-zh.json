{
  "主函数": {
    "prefix": "主函数",
    "body": [
      "函数 主函数() {",
      "    $0",
      "}"
    ],
    "description": "中文 Rust 主函数入口"
  },
  "打印行": {
    "prefix": "打印行",
    "body": [
      "打印行!(\"${1:消息}\");"
    ],
    "description": "打印一行文本"
  },
  "打印格式化": {
    "prefix": "打印格式化",
    "body": [
      "打印行!(\"${1:格式}\", ${2:参数});"
    ],
    "description": "打印格式化文本"
  },
  "让变量": {
    "prefix": "让",
    "body": [
      "让 ${1:变量名} = ${2:值};"
    ],
    "description": "声明不可变变量"
  },
  "让可变变量": {
    "prefix": "让可变",
    "body": [
      "让 可变 ${1:变量名} = ${2:值};"
    ],
    "description": "声明可变变量"
  },
  "如果表达式": {
    "prefix": "如果",
    "body": [
      "如果 ${1:条件} {",
      "    $0",
      "}"
    ],
    "description": "条件语句"
  },
  "如果否则": {
    "prefix": "如果否则",
    "body": [
      "如果 ${1:条件} {",
      "    $2",
      "} 否则 {",
      "    $0",
      "}"
    ],
    "description": "条件语句带否则分支"
  },
  "对于循环": {
    "prefix": "对于",
    "body": [
      "对于 ${1:元素} 在 ${2:迭代器} {",
      "    $0",
      "}"
    ],
    "description": "对于循环"
  },
  "当循环": {
    "prefix": "当",
    "body": [
      "当 ${1:条件} {",
      "    $0",
      "}"
    ],
    "description": "当循环"
  },
  "循环": {
    "prefix": "循环",
    "body": [
      "循环 {",
      "    $0",
      "}"
    ],
    "description": "无限循环"
  },
  "匹配表达式": {
    "prefix": "匹配",
    "body": [
      "匹配 ${1:表达式} {",
      "    ${2:模式} => ${3:结果},",
      "    $0",
      "}"
    ],
    "description": "匹配表达式"
  },
  "结构体定义": {
    "prefix": "结构体",
    "body": [
      "结构体 ${1:名称} {",
      "    ${2:字段}: ${3:类型},",
      "    $0",
      "}"
    ],
    "description": "结构体定义"
  },
  "枚举定义": {
    "prefix": "枚举",
    "body": [
      "枚举 ${1:名称} {",
      "    ${2:变体},",
      "    $0",
      "}"
    ],
    "description": "枚举定义"
  },
  "特征定义": {
    "prefix": "特征",
    "body": [
      "特征 ${1:名称} {",
      "    函数 ${2:方法名}(${3:参数}) -> ${4:返回类型};",
      "    $0",
      "}"
    ],
    "description": "特征定义"
  },
  "实现块": {
    "prefix": "实现",
    "body": [
      "实现 ${1:类型} {",
      "    函数 ${2:方法名}(${3:参数}) -> ${4:返回类型} {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "实现块"
  },
  "向量创建": {
    "prefix": "向量",
    "body": [
      "向量![${1:元素}]"
    ],
    "description": "创建向量"
  },
  "选项有些": {
    "prefix": "有些",
    "body": [
      "有些(${1:值})"
    ],
    "description": "选项::有些"
  },
  "选项无": {
    "prefix": "无",
    "body": [
      "无"
    ],
    "description": "选项::无"
  },
  "结果成功": {
    "prefix": "成功",
    "body": [
      "成功(${1:值})"
    ],
    "description": "结果::成功"
  },
  "结果错误": {
    "prefix": "错误",
    "body": [
      "错误(${1:错误信息})"
    ],
    "description": "结果::错误"
  }
