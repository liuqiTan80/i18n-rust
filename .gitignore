# Rust 构建产物
/target/

# IDE 配置
.vscode/
.idea/
.qoder/
.workbuddy/
*.swp
*.swo
*~

# 操作系统生成文件
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.rs.tmp
*.lock~

# zh 分支重构草稿（临时 .rs/.zh 工作区，禁止与正式源码混放）
/.zh-tmp/

# zh 分支方言源纪律：同名 .rs 是 .zh 的转译产物，不入库、不与源码同目录混放。
# 构建/测试统一用 scripts/zh-build.sh 在 .zh-build/ 隔离目录生成；
# 本分支（.zh 源）只保留 .zh，产物树在 main（eject 发布分支）检查。
/crates/engine/src/**/*.rs
/crates/cli/src/**/*.rs
/crates/lsp/src/**/*.rs
/crates/engine/tests/**/*.rs
/crates/cli/tests/**/*.rs
/crates/lsp/tests/**/*.rs
/crates/engine/benches/**/*.rs
/crates/lsp/benches/**/*.rs
/crates/engine/examples/**/*.rs
/crates/engine/build.rs
/.zh-build/

# 离线发布包产物
.release-tmp-*/

# VS Code 扩展打包产物（本地编译/打包会重新生成或触碰，勿提交）
tools/vscode-extension/syntaxes/
tools/vscode-extension/out/
tools/vscode-extension/node_modules/
tools/vscode-extension/package-lock.json
/tools/*.vsix

# rzc 运行时产物（语言包缓存、工具链等）
.rz/

# 发布产物目录（CI 产物不应提交进仓库，避免旧产物混入 Release）
/release/
tools/vscode-extension/release/.Trash-*/

# 文档站构建产物（站点装配源见 book/，脚本 tools/build-site.py）
/_site/
/build/site-work/

# Python 字节码缓存
__pycache__/

# 采样/验证逃逸到仓库根的编译器产物
# rustc --crate-type lib 默认把产物写进程 CWD，历史上诊断采样曾在此留下 lib*.rlib
# （tools/diag-corpus/collect.py 已改为 --out-dir 临时目录，此处兜底防再次污染）
/lib*.rlib
/lib*.rmeta
/rlib/
